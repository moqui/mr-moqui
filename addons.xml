<addons>
    <!--
    Components known to work with MR Moqui, for the ./moq component-get, component-set, component-depends, and
    component-create tasks. To add or override repository, component, and component-set elements, and to set the
    default="a,b" components that component-get gets with no names, use a myaddons.xml file (not in git).

    Location urls fill in ${group}, ${name}, ${branch}, ${version}, and ${token} from the component element. The Java
    Moqui form ${component.'@group'} also works, so a Java myaddons.xml can be copied as it is.
    Keep one element per line; ./moq reads these files with sed, not an XML parser.

    The repository a download uses is the component's repository attribute, else default-repository on a root
    element, else github when this repo was cloned by https and github-ssh when by git@ (ssh); -r picks one.
    A component's name is its repository and directory, and its component.xml name. A fork that keeps the upstream
    component.xml name (a repository my-shop with the component shop) has that name in component-name, so a depends-on,
    component-get, or component-set naming it finds it.
    -->

    <repository name="github">
        <location type="current" url="https://github.com/${group}/${name}/archive/${branch}.zip"/>
        <location type="release" url="https://github.com/${group}/${name}/archive/v${version}.zip"/>
        <location type="binary" url="https://github.com/${group}/${name}/releases/download/v${version}/${name}-${version}.zip"/>
        <location type="git" url="https://github.com/${group}/${name}.git"/>
    </repository>
    <repository name="github-ssh">
        <location type="current" url="https://github.com/${group}/${name}/archive/${branch}.zip"/>
        <location type="release" url="https://github.com/${group}/${name}/archive/v${version}.zip"/>
        <location type="binary" url="https://github.com/${group}/${name}/releases/download/v${version}/${name}-${version}.zip"/>
        <location type="git" url="git@github.com:${group}/${name}.git"/>
    </repository>

    <repository name="bitbucket">
        <location type="current" url="https://bitbucket.org/${group}/${name}/get/${branch}.zip"/>
        <location type="release" url="https://bitbucket.org/${group}/${name}/get/v${version}.zip"/>
        <location type="git" url="https://bitbucket.org/${group}/${name}.git"/>
    </repository>
    <repository name="bitbucket-ssh">
        <location type="current" url="https://bitbucket.org/${group}/${name}/get/${branch}.zip"/>
        <location type="release" url="https://bitbucket.org/${group}/${name}/get/v${version}.zip"/>
        <location type="git" url="git@bitbucket.org:${group}/${name}.git"/>
    </repository>
    <repository name="bitbucket-token">
        <location type="git" url="https://x-token-auth:${token}@bitbucket.org/${group}/${name}.git"/>
    </repository>

    <!-- Template for ./moq component-create; still the Java Moqui start component -->
    <component name="start" group="moqui" version="" branch="master"/>

    <!-- Mantle Business Artifacts, the data model and services (no MR Moqui releases yet) -->
    <component name="mr-mantle" group="moqui" version="" branch="master"/>
    <!-- Applications -->
    <component name="mr-marble" group="moqui" version="" branch="master"/>
    <component name="mr-boss" group="moqui" version="" branch="master"/>
    <component name="mr-pass" group="moqui" version="" branch="master"/>
    <!-- Localization -->
    <component name="mr-l10n" group="moqui" version="" branch="master"/>

    <!-- Component Sets -->
    <component-set name="apps" components="mr-marble,mr-boss"/>
</addons>
