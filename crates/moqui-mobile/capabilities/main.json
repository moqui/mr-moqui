{
  "identifier": "main",
  "description": "The app's own pages in the one webview: the shell (moqui-shell) and the server's pages (moqui-app), which Tauri counts as local alike. Local pages only, never the web. The shell's commands check the page themselves (src/host.rs), so a server's page has the sockets, the outbox and the drafts only.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-client-state",
    "allow-client-sign-in",
    "allow-client-send-code",
    "allow-client-sign-out",
    "allow-client-switch-account",
    "allow-client-add-account",
    "allow-client-remove-account",
    "allow-client-open-remote",
    "allow-client-take-open",
    "allow-client-sso-providers",
    "allow-client-sso-start",
    "allow-client-sso-cancel",
    "allow-socket-open",
    "allow-socket-send",
    "allow-socket-close",
    "allow-outbox-add",
    "allow-outbox-list",
    "allow-outbox-kinds",
    "allow-outbox-retry",
    "allow-outbox-discard",
    "allow-outbox-unsent",
    "allow-draft-get",
    "allow-draft-list",
    "allow-draft-put",
    "allow-draft-remove",
    "allow-file-save",
    "allow-scheme-fetch",
    "allow-client-show-shell",
    "allow-open-in-shell",
    "allow-notify",
    "allow-open-external"
  ]
}
