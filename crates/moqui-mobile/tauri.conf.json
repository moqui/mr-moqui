{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MR-Moqui",
  "version": "0.1.0",
  "identifier": "org.moqui.mobile",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "MR Moqui" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../moqui-desktop/icons/32x32.png",
      "../moqui-desktop/icons/128x128.png",
      "../moqui-desktop/icons/128x128@2x.png",
      "../moqui-desktop/icons/icon.icns",
      "../moqui-desktop/icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
