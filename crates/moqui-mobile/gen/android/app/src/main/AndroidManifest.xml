<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The incoming call (MT2, CallManager.kt): the ring's notification (asked at run time on Android 13+, once an
        account is signed in), its full-screen screen over the lock screen (Android 14+ lets the user turn it off: a
        heads-up notification then), the self-managed Telecom call and its phoneCall foreground service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- A call keeps its microphone and camera when the app is left (CallService, plans/Comms-Messaging.md §8.2). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- The screen off at the ear in a voice call (CallAudio's proximity wake lock). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The call's media, in the WebView: asked at the Answer (IncomingCallActivity) or by the page. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- The notification check's one-tap fix (PushCheck.kt, plans/Comms-Messaging.md §7.4 Battery): a messaging app
        whose pushes must arrive asks to be left out of battery optimization, from the user's tap only. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- A network change during a call (Wi-Fi to mobile data, MainActivity's NetworkWatch): the page restarts ICE. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The phone's contacts (PhoneBook.kt, plans/Comms-Messaging.md §9.2): names of outside numbers and the new-chat
        picker's search, read on the phone only; asked at the first search, with the reason. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- a chat location's Use my current location (plans/Comms-Messaging.md §18.3 phase 20): asked at first use by the
         WebView's geolocation prompt (RustWebChromeClient), never in the background -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- No backup, to the cloud or to another device: the app's private files hold each account's store (its mail and
        chat) and the sealed device keys, whose Keystore key would not come along anyway. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.moqui_mobile"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- The WebView sends Google no metrics of this app, even on a phone whose owner allows usage reports
            (SEC-CLI-123). -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <!-- Every configuration change the activity handles itself: one it did not would make it again, and the app's
            one webview and the client go with the activity's end (src/lib.rs; the process ends only when it finishes). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|fontScale|layoutDirection|colorMode|fontWeightAdjustment|navigation|touchscreen|mcc|mnc"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- The server's SSO hand-back (org.moqui.mobile:/sso?code=...&state=..., moqui_client::sso::MOBILE_REDIRECT),
                from the system browser: tao hands the VIEW intent to the app as RunEvent::Opened (src/lib.rs). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.moqui.mobile" android:path="/sso" />
            </intent-filter>
            <!-- A chat notification's tap and its conversation shortcut (org.moqui.mobile:/room?account=&chatRoomId=&eventSeq=,
                ChatNotifications.kt): the room in the shell (src/lib.rs). Not BROWSABLE: no web page opens it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="org.moqui.mobile" android:path="/room" />
            </intent-filter>
            <!-- A chat room's invite link from its join page's "Open in the MR Moqui app" (org.moqui.mobile:/join?host=&token=,
                src/join.rs): the page in the account on that host (src/lib.rs), where the person presses Join. BROWSABLE: a
                web page opens it; it only opens a page. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.moqui.mobile" android:path="/join" />
            </intent-filter>
        </activity>

        <!-- The ring on the screen, over the lock screen; its own task, so it never shows the app's pages. -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:taskAffinity="org.moqui.mobile.ring"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <!-- The self-managed calls, and the calling account the phone's dialer hands numbers to (DialAccount.kt), bound
            by Telecom only. -->
        <service
            android:name=".CallConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera" />
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />
        <!-- A chat notification's Reply, Mark read and Mute 1 hour (ChatActionReceiver.kt) -->
        <receiver
            android:name=".ChatActionReceiver"
            android:exported="false" />
        <!-- UnifiedPush's events: an account's endpoint and its messages (UnifiedPushService.kt; the connector's own
            receiver, exported, hands them over to this, which is not) -->
        <service
            android:name=".UnifiedPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
