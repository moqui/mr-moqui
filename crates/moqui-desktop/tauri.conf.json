{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MR-Moqui",
  "version": "0.1.0",
  "identifier": "org.moqui.desktop",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "MR Moqui on this computer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/main.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mailto", "tel", "sip", "org.moqui.desktop"]
      }
    }
  }
}
