<?xml version="1.0" encoding="UTF-8"?>
<!-- An attachment screen for the mail tests: one body for each mode, from rowName in the context. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <widgets><render-mode>
        <text type="csv"><![CDATA[name,greeting
${rowName ?? 'all'},${name ?? ''}
]]></text>
        <text type="text"><![CDATA[Report ${rowName ?? 'all'}
]]></text>
        <text type="xml"><![CDATA[<report name="${rowName ?? 'all'}"/>
]]></text>
        <text type="html,html-print"><![CDATA[<p>Report ${html(rowName ?? 'all')}</p>
]]></text>
    </render-mode></widgets>
</screen>
