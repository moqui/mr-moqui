<?xml version="1.0" encoding="UTF-8"?>
<!-- A list screen for the xlsx mail test: one form-list over rows from rowName in the context. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <actions>
        <set field="reportList" from="[{month: rowName ?? 'all', amount: 12.5}, {month: 'April', amount: 3}]"/>
    </actions>
    <widgets>
        <form-list name="ReportList" list="reportList">
            <field name="month"><default-field><display/></default-field></field>
            <field name="amount" align="right"><default-field><display format="#,##0.00"/></default-field></field>
        </form-list>
    </widgets>
</screen>
