<widgets>
    <form-list name="Rich" list="rowList" paginate="true" show-csv-button="true" show-md-button="true" show-all-button="true" header-dialog="true" saved-finds="true" select-columns="true" show-text-button="true" show-pdf-button="true" style="wide" focus-field="id">
        <row-actions><set field="extra" value="x"/></row-actions>
        <field name="id"><header-field show-order-by="case-insensitive"><text-find/></header-field><default-field><display/></default-field></field>
        <field name="title" align="center"><header-field container-style="head"><drop-down><option key="A"/></drop-down></header-field>
            <default-field container-style="titled"><text-line/></default-field></field>
        <field name="qty" align="right" hide="hideQty"><default-field><display format="0.0"/></default-field></field>
        <field name="status">
            <conditional-field condition="status == 'X'"><display text="Excluded"/></conditional-field>
            <default-field><display/></default-field>
        </field>
        <field name="link"><default-field title="Open"><link url="open" text="Open ${id}" link-type="anchor"/></default-field></field>
        <field name="rowId"><header-field><hidden/></header-field><default-field><hidden/></default-field></field>
        <field name="act"><default-field title="Do"><submit/></default-field></field>
    </form-list>
    <form-list name="Multi" list="rowList" multi="true" transition="saveAll" paginate="false">
        <field name="id"><default-field><display/></default-field></field>
        <field name="note"><default-field><text-line/></default-field></field>
        <field name="all"><default-field title="Save"><submit/></default-field></field>
    </form-list>
    <form-list name="Edge" list="rowList" skip-form="true" skip-header="true">
        <field name="a"><first-row-field><display text="first"/></first-row-field><default-field><display/></default-field><last-row-field><display text="last"/></last-row-field></field>
    </form-list>
</widgets>
