<screen require-authentication="false">
    <transition name="save"><default-response type="none"/></transition>
    <transition name="find"><default-response type="none"/></transition>
    <transition name="options"><default-response type="none"/></transition>
    <transition name="open"><default-response type="none"/></transition>
    <actions>
        <set field="fv" from="{firstName: 'Ada &lt;L>', email: 'a@b.c', status: 'A', multi: 'A,B', kind: 'Y', flag: 'Y', stamp: ec.l10n.parseTimestamp('2024-03-05 14:07'),
            amount: 1234.5, bio: 'line1\nline2', find: 'ada', range: 4, secret: 'sh', mode: 'z', tail: 'T'}"/>
        <set field="uom" value="USD"/>
        <set field="total" value="12"/>
        <set field="k" value="K1"/>
    </actions>
    <widgets>
        <form-single name="Everything" map="fv" transition="save">
            <field name="firstName"><default-field title="First" container-style="invoice-field"><text-line size="20" maxlength="40"/></default-field></field>
            <field name="ac"><default-field><text-line ac-transition="find" ac-min-length="2" ac-show-value="true"><depends-on field="firstName" parameter="fn"/></text-line></default-field></field>
            <field name="bio"><default-field tooltip="About you" container-style="${fv.mode == 'a' ? 'invoice-active' : 'invoice-idle'}"><text-area rows="4" editor-type="html"/></default-field></field>
            <field name="find"><default-field><text-find default-operator="begins"/></default-field></field>
            <field name="status"><default-field><drop-down allow-empty="true" show-not="true"><option key="A" text="Active"/><option key="${k}"/></drop-down></default-field></field>
            <field name="multi"><default-field><drop-down allow-multiple="true"><option key="A"/><option key="B"/></drop-down></default-field></field>
            <field name="remote"><default-field><drop-down allow-empty="true">
                <dynamic-options transition="options" server-search="true" min-length="2" label-field="text" value-field="id"><depends-on field="status" parameter="st"/></dynamic-options></drop-down></default-field></field>
            <field name="kind"><default-field><radio no-current-selected-key="X"><option key="X"/><option key="Y" text="Why"/></radio></default-field></field>
            <field name="flag"><default-field><check><option key="Y" text="Yes"/></check></default-field></field>
            <field name="stamp"><default-field><date-time/></default-field></field>
            <field name="day"><default-field><date-time type="date"/></default-field></field>
            <field name="at"><default-field><date-time type="time" default-value="12:00"/></default-field></field>
            <field name="between"><default-field><date-find type="date"/></default-field></field>
            <field name="period"><default-field><date-period/></default-field></field>
            <field name="range"><default-field><range-find size="6"/></default-field></field>
            <field name="amount"><default-field><display currency-unit-field="uom"/></default-field></field>
            <field name="shown"><default-field><display text="Total ${total}" also-hidden="false"/></default-field></field>
            <field name="doc"><default-field><file accept="image/*"/></default-field></field>
            <field name="pw"><default-field><password/></default-field></field>
            <field name="clear"><default-field><reset/></default-field></field>
            <field name="secret"><default-field><hidden/></default-field></field>
            <field name="skip"><default-field><ignored/></default-field></field>
            <field name="hid" hide="true"><default-field><display/></default-field></field>
            <field name="mix">
                <conditional-field condition="fv.mode == 'a'"><text-line/></conditional-field>
                <default-field><display text="mode ${fv.mode}"/></default-field>
            </field>
            <field name="go"><default-field title="Go Now"><submit confirmation="Sure?" icon="fa fa-check"/></default-field></field>
            <field name="viaLink"><default-field title="Via"><link url="open" text="Open" link-type="anchor"/></default-field></field>
            <field-layout>
                <field-group title="Names" box="true"><field-ref name="firstName"/><field-ref name="ac"/></field-group>
                <field-accordion id="Acc" active="2">
                    <field-group title="One"><field-ref name="bio"/></field-group>
                    <field-group title="Two"><field-ref name="find"/></field-group>
                </field-accordion>
                <field-row><field-ref name="status"/><field-ref name="multi"/></field-row>
                <field-row-big title="Big"><field-ref name="kind"/><field-ref name="flag"/></field-row-big>
                <field-col-row style="cols">
                    <field-col md="6" label-cols="3"><field-ref name="remote"/></field-col>
                    <field-col md="6"><field-ref name="stamp"/></field-col>
                </field-col-row>
                <fields-not-referenced/>
            </field-layout>
        </form-single>
    </widgets>
</screen>
