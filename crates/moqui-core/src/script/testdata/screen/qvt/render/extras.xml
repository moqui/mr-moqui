<screen require-authentication="false">
    <transition name="save"><default-response type="none"/></transition>
    <transition name="saveAll"><default-response type="none"/></transition>
    <transition name="treeItems"><default-response type="none"/></transition>
    <transition name="formSelectColumns"><default-response type="none"/></transition>
    <transition name="formSaveFind"><default-response type="none"/></transition>
    <transition name="firstRow"><default-response type="none"/></transition>
    <actions>
        <set field="rowList" from="[{id: 'I1', title: 'One', note: 'a'}, {id: 'I2', title: 'Two', note: 'b'}]"/>
        <set field="rowListCount" from="2"/>
        <set field="rowListPageIndex" from="0"/>
        <set field="rowListPageSize" from="20"/>
        <set field="rowListPageMaxIndex" from="0"/>
        <set field="rowListPageRangeLow" from="1"/>
        <set field="rowListPageRangeHigh" from="2"/>
        <set field="entries" from="[{n: 1}, {n: 2}, {n: 3}]"/>
        <set field="fv" from="{pick: 'B', when: 'yes', other: 'x'}"/>
    </actions>
    <widgets>
        <form-list name="Selectable" list="rowList" transition="save" select-columns="true" saved-finds="true" show-text-button="true" show-pdf-button="true" show-page-size="true">
            <row-selection id-field="id" parameter="ids">
                <action>
                    <dialog button-text="Update All" title="Update Selected"/>
                    <form-single name="UpdateSelected" transition="save">
                        <field name="status"><default-field title="Status"><text-line/></default-field></field>
                        <field name="go"><default-field><submit/></default-field></field>
                    </form-single>
                </action>
            </row-selection>
            <field name="id"><header-field show-order-by="case-insensitive"><text-find/></header-field><default-field><display/></default-field></field>
            <field name="title"><default-field><text-line/></default-field></field>
            <field name="note"><first-row-field><text-line/></first-row-field><default-field><display/></default-field><last-row-field><display text="end"/></last-row-field></field>
        </form-list>
        <form-list name="Everyone" list="rowList" multi="true" transition="saveAll" paginate="false">
            <field name="id"><default-field><hidden/></default-field></field>
            <field name="title"><default-field><text-line/></default-field></field>
            <field name="part"><default-field><drop-down><dynamic-options transition="treeItems"><depends-on field="title"/></dynamic-options></drop-down></default-field></field>
            <field name="go"><default-field title="Save All"><submit/></default-field></field>
        </form-list>
        <form-single name="Choices" map="fv" transition="save">
            <field name="pick"><default-field><drop-down allow-multiple="true" show-not="true" submit-on-select="true"><option key="A"/><option key="B"/></drop-down></default-field></field>
            <field name="dep"><default-field><text-line default-transition="treeItems"><depends-on field="pick"/></text-line></default-field></field>
            <field name="who"><default-field><display-entity entity-name="moqui.basic.Enumeration" text="${description}" default-text="nobody"/></default-field></field>
            <field name="shown" ><default-field><text-line/><visible-when field="pick" value="B,C"/></default-field></field>
            <field name="serial"><default-field><text-line/><visible-when field="pick" operator="not-empty"/><require-when field="pick" value="B"/></default-field></field>
            <field name="watch"><default-field><display dynamic-transition="treeItems"><depends-on field="pick" parameter="p"/></display></default-field></field>
            <field name="between"><default-field><date-find type="time"/></default-field></field>
            <field name="note"><default-field><text-area editor-type="md" rows="5"/></default-field></field>
        </form-single>
        <section-iterate name="Rows" list="entries" entry="entry" paginate="true"><widgets><label text="entry ${entry.n}"/></widgets></section-iterate>
        <container-box initial="closed"><box-header title="Closed"/><box-body><label text="inside"/></box-body></container-box>
    </widgets>
</screen>
