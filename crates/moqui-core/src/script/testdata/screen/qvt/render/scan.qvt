<div class="q-my-md"><m-form name="Move" id="Move" action="/move" read-only v-slot:default="formProps" :fields-initial="{'moquiFormName':'Move','locationId':'','assetId':'','assetId_type':'','assetId_scanText':'','scanId':''}"><div class="q-ma-sm"><m-text-line id="Move_locationId" type="text" name="locationId" label="Location" style="width:100%;" v-model="formProps.fields.locationId" :fields="formProps.fields"></m-text-line></div><div class="q-ma-sm"><m-scan-input name="assetId" id="Move_assetId" label="Asset" resolve-url="/scanResolve" :resolve-parameters="{'scanForm':'Move','scanField':'assetId','facilityId':'WH1'}" :depends-on="{'locationId':'locationId'}" allowed-types="asset,lot" placeholder="Scan an asset" v-model="formProps.fields.assetId"></m-scan-input></div></m-form></div>
<div class="q-my-md"><m-form name="Count" id="Count" action="/move" read-only v-slot:default="formProps" :fields-initial="{'moquiFormName':'Count','binId':'','binId_type':'','binId_scanText':'','countScanId':''}"><div class="q-ma-sm"><m-scan-input name="binId" id="Count_binId" label="Bin" resolve-url="/scanResolve" :resolve-parameters="{'scanForm':'Count','scanField':'binId'}" allowed-types="location" scan-id-field="countScanId" :auto-submit="false" confirm v-model="formProps.fields.binId"></m-scan-input></div></m-form></div>
