<section id="Wrap" class="wide"><h4 class="text-inline text-strong">in wrap</h4>
</section>
<m-container-box type="info" title="Boxed Ada"><template v-slot:header></template><template v-slot:toolbar><a href="/add" class="m-link-text">Add</a>
</template><m-box-body height="200"><span class="text-inline">body</span>
</m-box-body></m-container-box>
<div class="row gap"><div class="q-px-xs col-md-6 col-sm-12 col-xs-12"><span class="text-inline">one</span>
</div><div class="q-px-xs col-md-6 col-sm-12 col-xs-12 end"><span class="text-inline">two</span>
</div></div>
<div id="Pan" class="container-panel-outer"><div class="container-panel-header"><span class="text-inline">head</span>
</div><div class="container-panel-middle"><div class="container-panel-left" style="width:120px;"><span class="text-inline">left</span>
</div><div class="container-panel-center-left"><span class="text-inline">center</span>
</div></div></div>
<m-container-dialog id="Dlg" color="primary" width="500" button-text="Open" button-icon="fa fa-plus" title="Open"><span class="text-inline">dialog body</span>
</m-container-dialog>
<m-dynamic-container id="Dyn" url="/load?p=1&amp;_dynamic_container_id=Dyn"></m-dynamic-container>
<m-dynamic-dialog id="DynDlg" url="/edit?id=R7" color="primary" button-text="Edit" title="Edit"></m-dynamic-dialog><q-btn-dropdown dense unelevated no-caps class="m-btn-tonal text-info"><template v-slot:label><i class="fa fa-cog q-icon on-left"></i>Actions</template><q-list><q-item clickable><q-item-section><a href="/one" class="m-link-text">One</a>
</q-item-section></q-item><q-item clickable><q-item-section><a href="/two" data-confirm="Sure?" class="m-link-text">Two</a>
</q-item-section></q-item></q-list></q-btn-dropdown>
<m-tree-top id="Nodes" items="/treeItems" open-path="a/b" :parameters="{'root':'a'}"></m-tree-top>
<m-editable id="Ed" label-type="span" label-value="Ada" url="/save" :url-parameters="{}" parameter-name="name" widget-type="textarea" indicator="Saving" tooltip="Click to edit" cancel="Cancel" submit="Save"></m-editable><a href="/go" target="_blank"><q-btn dense unelevated no-caps class="m-btn-tonal text-positive m-link"><q-tooltip>Go now</q-tooltip><i class="fa fa-go q-icon on-left"></i> Go &amp; see <q-badge class="on-right" transparent>3</q-badge></q-btn></a>
<a href="http://example.com/x" class="m-link-text">Out</a>
<p class="text-inline muted" title="tip">Line Ada</p>
<span class="text-inline">a &lt; b<br>next</span>
<img src="/img.png" alt="Logo" width="20" height="20" class="logo"><i>Ada</i><m-container-dialog id="TipDlg" color="primary" button-text="" button-icon="sym_o_add" title="" tooltip="Add for Ada"><span class="text-inline">tip body</span>
</m-container-dialog>
<m-form action="/save" read-only submit-message="Saved Ada" submit-reload-id="Dyn" submit-hide-id="Dlg"><q-btn dense no-caps type="submit" flat class="m-link m-link-left text-primary">Mark done</q-btn></m-form>
