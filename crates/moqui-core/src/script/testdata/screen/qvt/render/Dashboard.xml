<?xml version="1.0" encoding="UTF-8"?>
<screen require-authentication="false">
    <actions>
        <set field="openCount" from="42"/>
        <set field="lateCount" from="3"/>
        <set field="showHidden" from="false"/>
        <set field="orderStatus" from="'Held'"/>
    </actions>
    <widgets>
        <dashboard id="Counters" min-width="160" style="counters">
            <number-card title="Open orders" value="${openCount}" delta="+3" icon="sym_o_receipt_long" link="Orders?statusId=Open"/>
            <number-card title="Late shipments" value="${lateCount}" delta="+1" delta-good="down" size="lg" link="https://example.com/late"/>
            <number-card title="Hidden" value="0" condition="showHidden"/>
            <number-card id="Revenue" title="Revenue {{x}} &amp; more" value="$1,200" delta="-5%" icon="fa fa-dollar" size="sm" style="wide"/>
            <label text="not a card"/>
        </dashboard>
        <dashboard><number-card title="Plain" value="7"/></dashboard>
        <link url="Orders?statusId=Open&amp;sort=-date" text="All open" link-type="anchor"/>
        <dashboard><number-card title="Held orders" value="1" link="Orders?statusId=${orderStatus}"/></dashboard>
        <link url="${'Orders'}" text="Dynamic orders" link-type="anchor"><parameter name="sort" value="-date"/></link>
        <dashboard id="Featured" min-width="280">
            <nav-card title="Orders" text="Find {{x}} &amp; open orders" icon="sym_o_receipt_long" link="Orders" size="lg">
                <link url="Orders?statusId=Open" text="Open ones"/>
                <link url="Orders?statusId=Held" text="Hidden ones" condition="showHidden"/>
                <link url="https://example.com/help" url-type="plain" text="Help"/>
            </nav-card>
            <nav-card id="Late" title="Late" link="https://example.com/late" style="wide"/>
            <nav-card title="Hidden tile" text="Not shown" link="Orders" condition="showHidden"/>
            <nav-card title="Counted" text="${openCount} open" icon="fa fa-hashtag"/>
        </dashboard>
    </widgets>
</screen>
