<?xml version="1.0" encoding="UTF-8"?>
<screen require-authentication="false">
    <transition name="detail">
        <default-response url="../Detail"><parameter name="fromResponse" value="yes"/></default-response>
    </transition>
    <transition name="acted">
        <actions><set field="x" value="1"/></actions>
        <default-response url="../Detail"/>
    </transition>
    <transition name="detailId">
        <path-parameter name="id"/>
        <default-response url="../Detail"/>
    </transition>
    <transition name="gone"><default-response type="none"/></transition>
    <actions>
        <set field="rowList" from="[{id: 'I1'}]"/>
        <set field="fixUrl" value="/fix/I1"/>
        <script>missingPath = sri.buildUrl('NoSuch').path</script>
    </actions>
    <widgets>
        <form-list name="Rows" list="rowList" skip-form="true" paginate="false">
            <field name="id">
                <default-field>
                    <link text="${id}" url="detail" link-type="anchor"><parameter name="id"/></link>
                </default-field>
            </field>
            <field name="stay">
                <default-field>
                    <link text="Stay" url="detail" link-type="anchor" expand-transition-url="false"><parameter name="id"/></link>
                </default-field>
            </field>
            <field name="acted">
                <default-field>
                    <link text="Acted" url="acted" link-type="anchor"><parameter name="id"/></link>
                </default-field>
            </field>
            <field name="go">
                <default-field>
                    <link text="Go" url="detail" link-type="hidden-form-link"><parameter name="id"/></link>
                </default-field>
            </field>
            <field name="post">
                <default-field>
                    <link text="Post" url="detail" link-type="hidden-form-link" expand-transition-url="false"><parameter name="id"/></link>
                </default-field>
            </field>
            <field name="fix">
                <default-field>
                    <link text="Fix" url="${fixUrl}" url-type="plain" link-type="anchor"/>
                </default-field>
            </field>
        </form-list>
        <link text="By path" url="detailId/I1" link-type="anchor"/>
        <link text="With query" url="detail?id=Q2" link-type="anchor"/>
        <link text="None" url="gone" link-type="anchor"/>
        <link text="Ext" url="https://example.com/x" url-type="screen" link-type="anchor"/>
        <label text="${missingPath}" type="span"/>
    </widgets>
</screen>
