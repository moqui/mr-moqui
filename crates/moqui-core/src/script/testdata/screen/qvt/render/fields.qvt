<div class="q-my-md"><m-form name="Everything" id="Everything" action="/save" read-only v-slot:default="formProps" :fields-initial="{'moquiFormName':'Everything','firstName':'Ada &lt;L&gt;','ac':'','bio':'line1\nline2','find':'ada','find_op':'begins','find_not':'N','find_ic':'Y','status':'A','status_not':'N','multi':['A','B'],'multi_op':'in','remote':null,'kind':'Y','flag':['Y'],'stamp':'2024-03-05 14:07','day':'','at':'12:00','between_from':'','between_thru':'','period_poffset':null,'period_period':null,'period_pdate':null,'period_from':null,'period_thru':null,'range_from':null,'range_thru':null,'amount':'1234.5','amount_display':'$1,234.50','shown_display':'Total 12','secret':'sh','hid':'','hid_display':'','mix':'','mix_display':'mode z'}"><m-container-box type="default" title="Names"><div><div class="q-ma-sm invoice-field"><m-text-line id="Everything_firstName" type="text" name="firstName" label="First" size="20" maxlength="40" v-model="formProps.fields.firstName" :fields="formProps.fields"></m-text-line></div><div class="q-ma-sm"><m-drop-down name="ac" id="Everything_ac" label="Ac" allow-empty server-search server-min-length="2" options-url="/find" :options-parameters="{}" :depends-on="{'fn':'firstName'}" :options="[]" v-model="formProps.fields.ac" :fields="formProps.fields"></m-drop-down></div></div></m-container-box>
<q-list bordered class="rounded-borders q-my-sm"><q-expansion-item dense expand-separator switch-toggle-side header-class="text-weight-medium" group="Acc" label="One"><div class="q-pa-sm"><div class="q-ma-sm invoice-idle"><m-text-area name="bio" id="Everything_bio" label="Bio" editor-type="html" rows="4" style="width:100%;" tooltip="About you" v-model="formProps.fields.bio"></m-text-area></div></div></q-expansion-item>
<q-expansion-item dense expand-separator switch-toggle-side header-class="text-weight-medium" group="Acc" label="Two" default-opened><div class="q-pa-sm"><div class="q-ma-sm"><m-text-find name="find" id="Everything_find" label="Find" size="30" hide-options="false" :fields="formProps.fields"></m-text-find></div></div></q-expansion-item>
</q-list>
<div class="row"><div class="col-xs-12 col-sm-6"><div class="q-ma-sm"><m-drop-down name="status" id="Everything_status" label="Status" allow-empty :options="[{'value':'A','label':'Active'},{'value':'K1','label':'K1'}]" v-model="formProps.fields.status" :fields="formProps.fields"><template v-slot:after><m-check name="status_not" id="Everything_status_not" toggle true-value="Y" false-value="N" single-label="Not" v-model="formProps.fields.status_not"></m-check></template></m-drop-down></div></div><div class="col-xs-12 col-sm-6"><div class="q-ma-sm"><m-drop-down name="multi" id="Everything_multi" label="Multi" multiple :options="[{'value':'A','label':'A'},{'value':'B','label':'B'}]" v-model="formProps.fields.multi" :fields="formProps.fields"></m-drop-down></div></div></div>
<div class="q-my-sm big-row"><div class="big-row-item">Big</div><div class="big-row-item"><m-radio name="kind" id="Everything_kind" label="Kind" :options="[{'value':'X','label':'X'},{'value':'Y','label':'Why'}]" v-model="formProps.fields.kind"></m-radio></div><div class="big-row-item"><m-check name="flag" id="Everything_flag" label="Flag" :options="[{'value':'Y','label':'Yes'}]" v-model="formProps.fields.flag"></m-check></div></div>
<div class="row cols"><div class="col-md-6"><div class="q-ma-sm"><m-drop-down name="remote" id="Everything_remote" label="Remote" class="dynamic-options" allow-empty :options="[]" options-url="/options" value-field="id" label-field="text" :depends-on="{'st':'status'}" :options-parameters="{}" server-search :server-min-length="2" v-model="formProps.fields.remote" :fields="formProps.fields"></m-drop-down></div></div><div class="col-md-6"><div class="q-ma-sm"><m-date-time id="Everything_stamp" name="stamp" label="Stamp" format="YYYY-MM-DD HH:mm" auto-year="true" :minute-step="5" v-model="formProps.fields.stamp"></m-date-time></div></div></div>
<div class="q-ma-sm"><m-date-time id="Everything_day" name="day" type="date" label="Day" format="YYYY-MM-DD" auto-year="true" :minute-step="5" v-model="formProps.fields.day"></m-date-time></div><div class="q-ma-sm"><m-date-time id="Everything_at" name="at" type="time" label="At" format="HH:mm" auto-year="true" :minute-step="5" v-model="formProps.fields.at"></m-date-time></div><div class="q-ma-sm"><span class="form-date-find"><m-date-time id="Everything_between_from" name="between_from" type="date" label="Between From" format="YYYY-MM-DD" v-model="formProps.fields.between_from"></m-date-time></span><span class="form-date-find"><m-date-time id="Everything_between_thru" name="between_thru" type="date" label="Between Thru" format="YYYY-MM-DD" v-model="formProps.fields.between_thru"></m-date-time></span></div><div class="q-ma-sm"><m-date-period name="period" id="Everything_period" allow-empty from-thru-type="date" label="Period" :fields="formProps.fields"></m-date-period></div><div class="q-ma-sm"><m-range-find name="range" id="Everything_range" label="Range" size="6" :fields="formProps.fields"></m-range-find></div><div class="q-ma-sm"><m-display name="amount" id="Everything_amount_display" label="Amount" label-wrapper class="Double currency" v-model="formProps.fields.amount" :display="formProps.fields.amount_display" :fields="formProps.fields"></m-display></div><div class="q-ma-sm"><m-display name="shown" id="Everything_shown_display" label="Shown" label-wrapper class="String" v-model="formProps.fields.shown" :display="formProps.fields.shown_display" :fields="formProps.fields"></m-display></div><div class="q-ma-sm"><m-file name="doc" id="Everything_doc" label="Doc" size="30" accept="image/*" v-model="formProps.fields.doc"></m-file></div><div class="q-ma-sm"><m-text-line id="Everything_pw" type="password" name="pw" label="Pw" size="25" autocomplete="new-password" v-model="formProps.fields.pw"></m-text-line></div><div class="q-ma-sm"><q-btn dense flat no-caps type="reset" name="clear" id="Everything_clear">Clear</q-btn></div><div class="q-ma-sm"><m-display name="mix" id="Everything_mix_display" label="Mix" label-wrapper class="String" v-model="formProps.fields.mix" :display="formProps.fields.mix_display" :fields="formProps.fields"></m-display></div><div class="q-ma-sm"><q-btn dense :outline="!formProps.hasFieldsChanged" :unelevated="formProps.hasFieldsChanged" no-caps type="submit" name="go" value="go" id="Everything_go" color="primary" data-confirm="Sure?"><i class="fa fa-check q-icon on-left"></i>Go Now</q-btn></div><div class="q-ma-sm"><m-field label="Via"><a href="/open" id="Everything_viaLink_open" class="m-link-text">Open</a></m-field></div></m-form></div>
