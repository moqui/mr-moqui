<?xml version="1.0" encoding="UTF-8"?>
<!-- Forms for the render tests: one form-single and one form-list over plain maps. -->
<screen require-authentication="false" default-menu-title="Forms">
    <actions>
        <set field="item" from="{itemId: 'I1', name: 'Widget, &quot;large&quot;', status: 'ACTIVE', flag: 'Y', amount: 1234.5, whenStamp: ec.l10n.parseTimestamp('2024-03-05 14:07')}"/>
        <set field="itemList" from="[{itemId: 'I1', name: 'Widget, &quot;large&quot;', price: 12.5, note: 'first line'},
                {itemId: 'I2', name: 'Gadget', price: 3, note: ''}]"/>
    </actions>
    <widgets>
        <form-single name="ItemForm" map="item">
            <field name="itemId"><default-field><display/></default-field></field>
            <field name="name"><default-field title="Item Name"><text-line size="30"/></default-field></field>
            <field name="status"><default-field>
                <drop-down no-current-selected-key="NONE">
                    <option key="NONE" text="None"/><option key="ACTIVE" text="Active"/>
                </drop-down></default-field></field>
            <field name="flag"><default-field><radio><option key="Y"/><option key="N"/></radio></default-field></field>
            <field name="amount"><default-field><display currency-unit-field="'USD'"/></default-field></field>
            <field name="whenStamp"><default-field><date-time/></default-field></field>
            <field name="secret"><default-field><hidden/></default-field></field>
            <field name="mode">
                <conditional-field condition="item.flag == 'N'"><display text="flag is N"/></conditional-field>
                <default-field><display text="flag is ${item.flag}"/></default-field>
            </field>
            <field name="go"><default-field title="Go"><submit/></default-field></field>
        </form-single>
        <form-list name="ItemList" list="itemList">
            <field name="itemId"><header-field show-order-by="true"><text-find size="10"/></header-field>
                <default-field><display/></default-field></field>
            <field name="name">
                <!-- Exercise a CSV-only empty middle cell without changing the other modes' fixture values. -->
                <conditional-field condition="sri.getRenderMode() == 'csv' &amp;&amp; itemId == 'I2'"><hidden/></conditional-field>
                <default-field><text-line size="30"/></default-field>
            </field>
            <field name="price" align="right"><default-field><display format="#,##0.00"/></default-field></field>
            <field name="note">
                <!-- A conditional field with no matching branch still occupies its CSV column. -->
                <conditional-field condition="sri.getRenderMode() != 'csv' || itemId == 'I1'">
                    <display text="${note}${sri.getRenderMode() == 'csv' ? String.fromCharCode(10) + 'second line' : ''}"/>
                </conditional-field>
            </field>
            <field name="id2"><default-field><hidden/></default-field></field>
            <field name="act"><default-field title="Do"><submit/></default-field></field>
        </form-list>
    </widgets>
</screen>
