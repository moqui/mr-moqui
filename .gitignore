/target

# common runtime additions that are runtime only (don't belong in git)
/runtime/log
/runtime/db
/runtime/tmp
/runtime/txlog
/runtime/.env
/runtime/cert
/runtime/types
/runtime/opensearch*
/runtime/chromium*
/runtime/save
/myaddons.xml
/runtime/install
/runtime/MoquiConf.xml
# ./moq autodoc run at the root
/autodoc
# runtime/components (plans/archive/Components-Dir.md): components.xml and the base set are tracked; the add-on and test
# sets hold components in repositories of their own, beside their READMEs; the framework's own dev components are
# tracked in the dev set, and a user's sit beside them in repositories of their own.
/runtime/components/addon/*
!/runtime/components/addon/README.md
/runtime/components/test/*
!/runtime/components/test/README.md
/runtime/components/dev/*
!/runtime/components/dev/README.md
!/runtime/components/dev/demo/
!/runtime/components/dev/dev-aide/
!/runtime/components/dev/example/
!/runtime/components/dev/template/

# Python HTTP security tests
/runtime/components/base/framework/test/.venv/
**/__pycache__/
.pytest_cache/

# IntelliJ IDEA files
.idea
out
*.ipr
*.iws
*.iml

# Eclipse files (and some general ones also used by Eclipse)
.metadata
bin
tmp
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings
.loadpath

# NetBeans files
nbproject/private
nbbuild
.nb-gradle
nbdist
nbactions.xml
nb-configuration.xml

# VSCode files
.vscode
# Emacs files
.projectile
# Zed IDE
.zed/

# Local agent workspaces
.opencode/
opencode.json
.claude/
.pi/
.codex/
.cursor/
.windsurf/
.cline/
.roo/
.aider/
.grok/

# Env style secrets
.env
.env.*
.env.local

# Version managers (sdkman, mise, asdf)
mise.toml
.tool-versions

# OSX auto files
.DS_Store
.AppleDouble
.LSOverride
._*
# Windows auto files
Thumbs.db
ehthumbs.db
Desktop.ini
# Linux auto files
*~

# The desktop app: its lock file, copied from the repository's by ./moq desktop, and what tauri-build generates
/crates/moqui-desktop/Cargo.lock
/crates/moqui-desktop/gen/
# The mobile app: its lock file, as the desktop app's, and tauri-build's schemas. gen/android is kept, less what its
# own .gitignore files leave out (build outputs and what the Tauri CLI writes on each build).
/crates/moqui-mobile/Cargo.lock
/crates/moqui-mobile/gen/schemas/
# The client glue both apps share: its lock file, for its own cargo test
/crates/moqui-client-tauri/Cargo.lock
# Local screenshots used during UI review; keep evidence outside repository history.
/plans/ui-refinement-evidence/
