/target
# Cargo's output of a crate built on its own (crates/moqui-mobile and crates/moqui-desktop are outside the workspace,
# so cargo there writes crates/<crate>/target), and any other build output directory; the tracked-files test in
# crates/moqui-devkit (tracked_files_tests.rs) refuses them if one is ever added anyway
target/
node_modules/
.gradle/

# common runtime additions that are runtime only (don't belong in git)
/runtime/log
/runtime/db
/runtime/tmp
/runtime/txlog
/runtime/.env
/runtime/cert
/runtime/types
/runtime/opensearch*
/runtime/chromium*
/runtime/save
# exports a user names: a drive's zip (FileServices.export#Drive), a repository (GitServices.export#GitRepository)
/runtime/drive-export
/runtime/git-export
# the Dev AIDE's worktrees for agents' sessions (plans/archive/design-dev-aide.md 21.8)
/runtime/worktrees
/myaddons.xml
/runtime/install
/runtime/MoquiConf.xml
# ./moq autodoc run at the root
/autodoc
# runtime/components (plans/archive/Components-Dir.md): components.xml and the base set are tracked; the add-on and test
# sets hold components in repositories of their own, beside their READMEs; the framework's own dev components are
# tracked in the dev set, and a user's sit beside them in repositories of their own.
/runtime/components/addon/*
!/runtime/components/addon/README.md
/runtime/components/test/*
!/runtime/components/test/README.md
/runtime/components/dev/*
!/runtime/components/dev/README.md
!/runtime/components/dev/demo/
!/runtime/components/dev/dev-aide/
!/runtime/components/dev/example/
!/runtime/components/dev/template/
# The vault's browser module and its stamp (the build record), built on demand by scripts/vault-wasm.sh (./moq build,
# the test tasks; docs/security/Vaults.md, The browser module)
/runtime/components/base/webroot/screen/webroot/js/vault/moqui_vault.wasm
/runtime/components/base/webroot/screen/webroot/js/vault/moqui_vault.wasm.json
/runtime/components/base/webroot/screen/webroot/js/vault/moqui_vault.wasm*.part

# Python HTTP security tests
/runtime/components/base/framework/test/.venv/
**/__pycache__/
.pytest_cache/

# IntelliJ IDEA files
.idea
out
*.ipr
*.iws
*.iml

# Eclipse files (and some general ones also used by Eclipse)
.metadata
bin
tmp
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings
.loadpath

# NetBeans files
nbproject/private
nbbuild
.nb-gradle
nbdist
nbactions.xml
nb-configuration.xml

# VSCode files
.vscode
# Emacs files
.projectile
# Zed IDE
.zed/

# Local agent workspaces
.opencode/
opencode.json
.claude/
.pi/
.codex/
.cursor/
.windsurf/
.cline/
.roo/
.aider/
.grok/

# Env style secrets
.env
.env.*
.env.local

# Version managers (sdkman, mise, asdf)
mise.toml
.tool-versions

# OSX auto files
.DS_Store
.AppleDouble
.LSOverride
._*
# Windows auto files
Thumbs.db
ehthumbs.db
Desktop.ini
# Linux auto files
*~

# The desktop app: its lock file, copied from the repository's by ./moq desktop, and what tauri-build generates
/crates/moqui-desktop/Cargo.lock
/crates/moqui-desktop/gen/
# The mobile app: tauri-build's schemas. gen/android is kept, less what its own .gitignore files leave out (build
# outputs and what the Tauri CLI writes on each build). Its Cargo.lock is committed, as the client glue's is
# (./moq update-app-locks; plans/archive/Security-Review.md SEC-CLI-104).
/crates/moqui-mobile/gen/schemas/
# Local screenshots used during UI review; keep evidence outside repository history.
/plans/ui-refinement-evidence/
# Reviewer reports and prompts of the security review (plans/archive/Security-Review.md); working record, not history.
/plans/security-review-evidence/

# Verified browser output from ./moq build-js
/runtime/components/base/webroot/screen/webroot/libs/*
!/runtime/components/base/webroot/screen/webroot/libs/MANIFEST.json
!/runtime/components/base/webroot/screen/webroot/libs/NOTICES.md
!/runtime/components/base/webroot/screen/webroot/libs/licenses/
/runtime/components/base/webroot/screen/webroot/.libs-*
/.npm-cache/
/runtime/components/base/webroot/build/fonts/selected.txt
