# Run the moqui binary with no container. Unpack an archive (./moq archive) at /opt/moqui so the
# binary's directory is the runtime: /opt/moqui/moqui, components/, and MoquiConf.xml.
# Create the user first: systemd-sysusers systemd/moqui.sysusers
# Then: cp systemd/moqui.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now moqui

[Unit]
Description=MR Moqui
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=moqui
Group=moqui
WorkingDirectory=/opt/moqui
ExecStart=/opt/moqui/moqui
# `systemctl reload moqui` reloads the conf files: what can change live does, the rest is logged as waiting for a
# restart (docs/tools/Component-Deploy.md).
ExecReload=/bin/kill -HUP $MAINPID
# Optional variables that must exist before the process starts (MOQUI_CONF, MOQUI_RUNTIME).
# The binary reads /opt/moqui/.env itself after the conf merge. That file does not select
# MOQUI_CONF, so this is a different file on purpose.
EnvironmentFile=-/etc/moqui/environment
KillMode=mixed
# A server waiting sealed for a passphrase or shares has sent READY=1 with STATUS=sealed, so this does not end it.
TimeoutStartSec=300
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
# No core dumps: an unsealed server holds its root key in memory (plans/Sealed-Secrets.md §3.5).
LimitCORE=0
# /run/moqui, outside the code and data directories, holds the operator socket (moqui.sock): the server starts sealed
# and answers there until `moqui operator unseal` (docs/Run-Deploy.md, Sealed start). The socket itself is mode 0660,
# given to seal@operator-group, so only root and that group reach it.
RuntimeDirectory=moqui
RuntimeDirectoryMode=0755
SupplementaryGroups=moqui-operator
NoNewPrivileges=true
PrivateTmp=true
# The whole file system is read-only to the server but its runtime: the database, logs, certificates, the generated
# secrets in .env, and the components a deploy writes (docs/tools/Component-Deploy.md). The binary and the conf stay
# read-only inside it, whoever owns them, so a compromised server cannot replace what runs at its next start
# (SEC-OUT-13). A path that is not there (the conf of a single-binary install) is skipped.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/moqui /opt/moqui/components
ReadOnlyPaths=/opt/moqui/moqui -/opt/moqui/MoquiConf.xml -/opt/moqui/conf

[Install]
WantedBy=multi-user.target
