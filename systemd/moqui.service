# Run the moqui binary with no container. Unpack an archive (./moq archive) at /opt/moqui so the
# binary's directory is the runtime: /opt/moqui/moqui, base-component/, and MoquiConf.xml.
# Create the user first: systemd-sysusers systemd/moqui.sysusers
# Then: cp systemd/moqui.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now moqui

[Unit]
Description=MR Moqui
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=moqui
Group=moqui
WorkingDirectory=/opt/moqui
ExecStart=/opt/moqui/moqui
# `systemctl reload moqui` reloads the conf files: what can change live does, the rest is logged as waiting for a
# restart (docs/tools/Component-Deploy.md).
ExecReload=/bin/kill -HUP $MAINPID
# Optional variables that must exist before the process starts (MOQUI_CONF, MOQUI_RUNTIME).
# The binary reads /opt/moqui/.env itself after the conf merge. That file does not select
# MOQUI_CONF, so this is a different file on purpose.
EnvironmentFile=-/etc/moqui/environment
KillMode=mixed
TimeoutStartSec=300
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/moqui

[Install]
WantedBy=multi-user.target
