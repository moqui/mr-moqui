            resourceValue="PHOSPHOR"/>
    <moqui.screen.ScreenColorScheme colorSchemeId="PHOSPHOR" screenThemeId="GREEN_SCREEN_QUASAR" sequenceNum="1" description="Phosphor">
        <extraCss><![CDATA[
/* a phosphor tube: the glow of the text and the scan lines in dark mode, inverse video on a filled button, green-bar (or amber-bar)
   paper in light mode; neither the glow nor the lines under reduced motion or more contrast */
body.body--dark { text-shadow:0 0 3px color-mix(in srgb, currentColor 45%, transparent); }
body.body--dark::after { content:""; position:fixed; inset:0; z-index:9000; pointer-events:none;
    background:repeating-linear-gradient(180deg, rgba(0,0,0,.16) 0 1px, transparent 1px 3px); }
body.m-motion-reduce::after { display:none; }
@media (prefers-contrast: more) { body.body--dark { text-shadow:none; } body.body--dark::after { display:none; } }
body.body--dark .q-btn.bg-primary.text-white { color:#021405 !important; text-shadow:none; }
body:not(.body--dark) .q-btn.bg-primary.text-white { color:#f3faf1 !important; }
body:not(.body--dark) .q-page { background-image:repeating-linear-gradient(180deg, rgba(21,122,50,.07) 0 2.25em, transparent 2.25em 4.5em); }
]]></extraCss>
