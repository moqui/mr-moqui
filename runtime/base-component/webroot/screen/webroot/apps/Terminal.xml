<!-- The browser terminal (plans/archive/Screen-TUI-Impl.md 4.4, plans/Terminal-Fancy.md §9.3): the terminal client of `moqui tui`
    and SSH apps, in xterm.js on the /termws socket, as the signed in user, in tabs and splits of sessions that outlive the page.
    The account menu's Terminal UI opens it, for every user, while the host serves the socket (the /termws endpoint of the
    webapp in the conf). Terminal.qvue next to this file is the page. In the terminal client itself it says so.
    Its transitions are JSON over org.moqui.terminal.TerminalServices (TerminalWeb.js): options, sessions, open, rename and
    close; posts need the session's token. They are view actions of this screen, which every user may see: each service
    works on the caller's own sessions and checks what a kind needs itself. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="true" default-menu-title="Terminal UI" default-menu-include="false" render-modes="qvue,tui,html,qvt" server-static="qvue">
    <transition name="options" read-only="true" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/terminal/TerminalWeb.js').execute('web', {verb: 'get#TerminalOptions', names: []})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="sessions" read-only="true" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/terminal/TerminalWeb.js').execute('web', {verb: 'find#TerminalSessions', names: []})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="open" method="post" begin-transaction="false" authz-action="view">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/terminal/TerminalWeb.js').execute('web', {verb: 'open#TerminalSession', names: ['kind', 'profileName', 'directory', 'title', 'cols', 'rows', 'resume', 'ticket']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="confirm" method="post" begin-transaction="false" authz-action="view">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/terminal/TerminalWeb.js').execute('web', {verb: 'confirm#TerminalUser', names: ['password', 'code']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="rename" method="post" begin-transaction="false" authz-action="view">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/terminal/TerminalWeb.js').execute('web', {verb: 'update#TerminalSession', names: ['sessionId', 'title', 'notify']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="close" method="post" begin-transaction="false" authz-action="view">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/terminal/TerminalWeb.js').execute('web', {verb: 'close#TerminalSession', names: ['sessionId']})</script></actions>
        <default-response type="none"/>
    </transition>
    <widgets>
        <render-mode>
            <text type="qvue" location="component://webroot/screen/webroot/apps/Terminal.qvue" template="false"/>
            <text type="tui"><![CDATA[[{"t": "text", "id": "TerminalHere", "text": "This is the terminal already: the browser's Terminal opens these same applications."}]]]></text>
            <text type="html,qvt"><![CDATA[<p>The terminal runs in the applications shell: open <a href="/qapps/Terminal">/qapps/Terminal</a>.</p>]]></text>
        </render-mode>
    </widgets>
</screen>
