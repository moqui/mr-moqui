<!-- The browser terminal (plans/archive/Screen-TUI-Impl.md 4.4): the terminal client of `moqui tui` and SSH apps, in xterm.js on the
    /termws socket, as the signed in user. The account menu's Terminal UI opens it, for every user, while the host serves the
    socket (the /termws endpoint of the webapp in the conf). Terminal.qvue next to this file is the page. In the terminal client itself it says so. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="true" default-menu-title="Terminal UI" default-menu-include="false" render-modes="qvue,tui,html,qvt" server-static="qvue">
    <widgets>
        <render-mode>
            <text type="qvue" location="component://webroot/screen/webroot/apps/Terminal.qvue" template="false"/>
            <text type="tui"><![CDATA[[{"t": "text", "id": "TerminalHere", "text": "This is the terminal already: the browser's Terminal opens these same applications."}]]]></text>
            <text type="html,qvt"><![CDATA[<p>The terminal runs in the applications shell: open <a href="/qapps/Terminal">/qapps/Terminal</a>.</p>]]></text>
        </render-mode>
    </widgets>
</screen>
