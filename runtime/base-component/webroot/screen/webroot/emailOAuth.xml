<!-- The redirect URI of a mail account's sign-in with Google or Microsoft (docs/interfaces/Mail-OAuth.md): the provider sends the
    popup back here with the state and the code (or an error). org.moqui.impl.EmailClientServices.complete#OAuthSignIn
    checks the state against the user's session, exchanges the code and stores the sign-in, and sends the popup's page,
    which tells its opener (this server's own origin only) how it ended. A deployment registers
    {its webroot URL}/emailOAuth/callback at the providers, or sets email_oauth_redirect_uri. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" track-artifact-hit="false" default-menu-include="false">

    <!-- A GET from the provider: no session token (the state is the check), and the user is the session's -->
    <transition name="callback" read-only="true" require-session-token="false" begin-transaction="false">
        <actions><script><![CDATA[
            const params = ec.web.parameters
            const text = (value) => value == null || value === '' ? null : String(value)
            ec.service.sync().name('org.moqui.impl.EmailClientServices.complete#OAuthSignIn').parameters({
                state: text(params.state), code: text(params.code), error: text(params.error),
                errorDescription: text(params.error_description), sendPage: true}).call()
            ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <widgets/>
</screen>
