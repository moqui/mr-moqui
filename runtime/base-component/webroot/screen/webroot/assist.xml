<!-- The Assist drawer's JSON calls (plans/LLM-A2A-Assist.md 4.5 and 4.11; the contract is docs/Assist.md): /assist/<call>,
    for js/WebrootAssist.js. Each transition hands its call to org.moqui.agent.AssistServices.call#Drawer, which reads the
    request's parameters (query, form or JSON body), acts as the current user only (AgentUse; anything of another user's is
    not found) and sends the response itself: 200 with JSON, or the error status with {errorCode, errors, code}. The reads
    are GETs; the writes are POSTs, which present the session token (the X-CSRF-Token header or moquiSessionToken) as every
    transition that runs actions does, and decide takes a decision only from a browser session by its cookie with that token.
    No app's authorization covers these, so the service runs without it, as the shell and chat transitions of webroot.xml
    do. The run's events stream from the host route /assist/runs/{runId}/events. The canvas calls (canvasState, canvasAction,
    canvasAdjust, canvasProblems) and read, the one read proxy of the canvases, are llm/assist/canvas.rs; the calls of
    phase 13.14 (queued, attachments, attachment, transcribe, textAction, memories, memory, skills, skill, events) are
    llm/assist/extras.rs and files.rs. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-include="false">

    <transition name="bootstrap" method="get" read-only="true" begin-transaction="false">
        <actions><script>ec.service.sync().name('org.moqui.agent.AssistServices.call#Drawer').parameter('call', 'bootstrap').disableAuthz().call()</script></actions>
        <default-response type="none"/>
    </transition>
