    <transition name="mentions" method="get" read-only="true" begin-transaction="false">
        <actions><script><![CDATA[
            const params = ec.web.parameters
            if (String(params.kind || '') === 'records') {
                // records come from the palette's sources (the apps' palette-source providers), as the palette shows them
                if (!ec.user.userId) ec.web.sendJsonError(401, 'Authentication required')
                else if (!ec.user.hasPermission('AgentUse')) ec.web.sendJsonError(403, 'this needs the AgentUse permission')
                else {
                    const found = sri.getShellSearch(String(params.q || ''), String(params.groups || ''), String(params.limit || ''))
                    if (found != null) ec.web.sendJsonResponse({kind: 'records', groups: found.groups || []})
                }
            } else {
                ec.service.sync().name('org.moqui.agent.AssistServices.call#Drawer').parameter('call', 'mentions').disableAuthz().call()
            }
            ]]></script></actions>
        <default-response type="none"/>
    </transition>
