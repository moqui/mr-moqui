<!-- Chat devices and keys for the signed-in browser (C7 core; js/WebrootCrypto.js, docs/interfaces/Chat-Keys.md): the
    endpoints the browser's OlmMachine calls, each a transition over org.moqui.impl.ChatKeyServices with Matrix's
    payloads (a JSON body; the answer is the service's out-parameters as JSON, or {errors, reasonCode}):
    /ChatKeys/device (create#ChatDevice), /ChatKeys/devices, /ChatKeys/rename, /ChatKeys/revoke, /ChatKeys/whoami,
    /ChatKeys/upload (keys/upload), /ChatKeys/query (keys/query), /ChatKeys/claim (keys/claim), /ChatKeys/send
    (sendToDevice), /ChatKeys/sync (the to-device part of /sync), /ChatKeys/storeKey (get#ChatDeviceStoreKey),
    /ChatKeys/signingUpload and /ChatKeys/signaturesUpload (cross-signing; the signatures body as the parameter signed),
    and the key backup's /ChatKeys/backupVersionCreate, backupVersion, backupVersionUpdate, backupVersionDelete,
    backupKeysPut, backupKeys and backupKeysDelete. Each works as the session's user only, which the
    services check (a device of another user is "not found"), so authorization is not asked; without a user it is 401.
    Posts need the session's CSRF token. Each runs its service in its own transaction, so a refusal answers as JSON
    ({errors, reasonCode} and the refusal's own fields, such as current_version; ChatKeys.js web). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" track-artifact-hit="false" standalone="true" default-menu-include="false">
    <transition name="device" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'create#ChatDevice', names: ['displayName']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="devices" read-only="true" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'find#ChatDevices', names: ['includeRevoked']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="rename" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'update#ChatDevice', names: ['deviceId', 'displayName']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="revoke" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'revoke#ChatDevice', names: ['deviceId']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="whoami" read-only="true" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'get#ChatKeyIdentity', names: []})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="upload" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'upload#Keys', names: ['deviceId', 'device_keys', 'one_time_keys', 'fallback_keys']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="query" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'query#Keys', names: ['device_keys', 'timeout']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="claim" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'claim#Keys', names: ['one_time_keys', 'timeout']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="send" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'send#ToDevice', names: ['deviceId', 'event_type', 'txn_id', 'messages']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="sync" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'sync#ToDevice', names: ['deviceId', 'since', 'limit', 'deviceListSince']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="storeKey" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'get#ChatDeviceStoreKey', names: ['deviceId']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="signingUpload" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'upload#CrossSigningKeys', names: ['master_key', 'self_signing_key', 'user_signing_key', 'reset']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="signaturesUpload" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'upload#KeySignatures', names: ['signed']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="backupVersionCreate" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'create#KeyBackupVersion', names: ['algorithm', 'auth_data']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="backupVersion" read-only="true" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'get#KeyBackupVersion', names: ['version']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="backupVersionUpdate" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'update#KeyBackupVersion', names: ['version', 'algorithm', 'auth_data']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="backupVersionDelete" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'delete#KeyBackupVersion', names: ['version']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="backupKeysPut" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'store#BackupKeys', names: ['version', 'rooms']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="backupKeys" read-only="true" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'get#BackupKeys', names: ['version', 'roomId', 'sessionId', 'offset']})</script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="backupKeysDelete" method="post" begin-transaction="false">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/ChatKeys.js').execute('web', {verb: 'delete#BackupKeys', names: ['version', 'roomId', 'sessionId']})</script></actions>
        <default-response type="none"/>
    </transition>
    <widgets/>
</screen>
