<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" screen-theme-type-enum-id="STT_INTERNAL" default-menu-title="Applications">
    <!-- NOTE: require-authentication=false is required to allow sub-screens to decide. -->

    <transition name="ScreenTree"><default-response url="../ScreenTree"/></transition>
    <transition name="setPreference">
        <parameter name="preferenceKey"/><parameter name="preferenceValue"/>
        <actions><script><![CDATA[
            if (!ec.user.userId) { ec.web.sendJsonError(401, 'Authentication required') } else {
                ec.user.setPreference(preferenceKey, preferenceValue)
            }
            ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="setPrefGoLast" read-only="true">
        <parameter name="preferenceKey"/><parameter name="preferenceValue"/>
        <actions><script><![CDATA[
            if (!ec.user.userId) { ec.web.sendJsonError(401, 'Authentication required') } else {
                ec.user.setPreference(preferenceKey, preferenceValue)
            }
            ]]></script></actions>
        <default-response type="screen-last"/>
    </transition>
    <transition name="getPreferences" read-only="true">
        <parameter name="keyRegexp"/>
        <actions><script><![CDATA[
            if (!ec.user.userId) { ec.web.sendJsonError(401, 'Authentication required') } else {
                ec.web.sendJsonResponse(ec.user.getPreferences(keyRegexp))
            }
            ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <!-- The messages of a locale for the browser: default, language and locale entries, the more specific winning. -->
    <transition name="l10nCatalog" read-only="true">
        <parameter name="locale"/>
        <actions><script><![CDATA[
            if (!ec.user.userId) { ec.web.sendJsonError(401, 'Authentication required') } else {
                const localeText = String(locale || ec.user.locale || 'en_US').replace('-', '_')
                const messages = {}
                for (const key of ['default', localeText.split('_')[0], localeText]) {
                    const rows = ec.entity.find('moqui.basic.LocalizedMessage').condition('locale', key).disableAuthz().list()
                    for (let i = 0; i < rows.length; i++) { const row = rows.get(i); messages[row.original] = row.localized }
                }
                ec.web.sendJsonResponse({locale: localeText, messages: messages})
            }
            ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="qzSign" read-only="true">
        <parameter name="message"/>
        <actions><script><![CDATA[
            if (!ec.user.userId) { ec.web.sendJsonError(401, 'Authentication required') } else {
                ec.web.sendQzSignedResponse(message)
            }
            ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <subscreens default-item="AppList"/>

    <pre-actions><script><![CDATA[
        // The html client (/js/moqui-html.js and the style sheet) comes from the theme. Tom Select and SortableJS
        // are added to footer_scripts by the widgets that use them.
    ]]></script></pre-actions>

    <widgets>
        <section name="TopNavSection" condition="hideNav != 'true'"><widgets>
            <container id="top">
                <render-mode><text type="html" location="component://webroot/screen/includes/navbar.html.fancy"/></render-mode>
                <subscreens-menu type="popup" id="header-menu" title="Application"/>
            </container>
        </widgets></section>

        <container id="content"><container style="inner">
            <section name="MessagesSection"><widgets>
                <render-mode><text type="html" location="component://webroot/screen/includes/Messages.html.fancy"/></render-mode>
            </widgets></section>

            <subscreens-active/>
        </container></container>

        <section name="BottomNavSection" condition="hideNav != 'true'"><widgets>
            <container id="footer"><render-mode><text type="html"><![CDATA[
                <#assign footerItemList = sri.getThemeValues("STRT_FOOTER_ITEM")>
                <div id="apps-footer-content">
                    <#list footerItemList as footerItem>
                        ${raw(sri.renderInlineText(footerItem))}
                    </#list>
                </div>
            ]]></text></render-mode></container>
        </widgets></section>
    </widgets>
</screen>
