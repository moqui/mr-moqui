<!-- BasicComms, the framework's Comms app (plans/Comms-Framework.md §3): mail settings now, then chat, the Inbox, calls and
    voice, usable with only the framework. Another app mounts these screens under its own root and adds to them through
    screen-extend, its shell-providers' provider hooks, and ext-action and ext-panel (§3.3, §3.4). Authorized for ALL_USERS by
    BASIC_COMMS (data/BasicCommsSetupData.xml). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Comms" menu-image="sym_o_forum" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="BasicComms"/>
    </always-actions>

    <subscreens default-item="Settings" always-use-full-path="true"/>

    <!-- What Comms offers the suite shell: the Settings go-to key. -->
    <shell-providers>
        <keymap><key keys="g m" label="Mail settings" screen="BasicComms/Settings/MailAccounts"/></keymap>
    </shell-providers>

    <widgets><subscreens-panel id="basic-comms-panel" type="popup"/></widgets>
</screen>
