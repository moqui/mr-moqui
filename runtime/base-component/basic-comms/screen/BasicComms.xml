<!-- BasicComms, the framework's Comms app (plans/Comms-Framework.md §3): the Inbox, chat and the mail settings now, then calls
    and voice, usable with only the framework. Another app mounts these screens under its own root and adds to them through
    screen-extend, its shell-providers' provider hooks, and ext-action and ext-panel (§3.3, §3.4). Authorized for ALL_USERS by
    BASIC_COMMS (data/BasicCommsSetupData.xml). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Comms" menu-image="sym_o_forum" menu-image-type="icon">

    <always-actions>
        <set field="appRoot" value="BasicComms"/>
    </always-actions>

    <subscreens default-item="Inbox" always-use-full-path="true"/>

    <!-- What Comms offers the suite shell: an email and a chat message in the + menu, the palette's Messages and Chat rooms (the #
        prefix), the mention and new mail notifications, and go-to keys. -->
    <shell-providers>
        <quick-create kind="email" label="Email" icon="sym_o_mail" screen="BasicComms/Inbox/Compose" sequence="60"/>
        <quick-create kind="chatMessage" label="Chat message" icon="sym_o_chat" screen="BasicComms/Panel/Chat" sequence="70"/>
        <palette-source group="Messages" label="Messages" icon="sym_o_mail" service="org.moqui.comms.InboxServices.search#Messages" sequence="30"/>
        <palette-source group="Rooms" label="Chat rooms" icon="sym_o_chat" prefix="#" service="org.moqui.comms.ChatScreenServices.search#PaletteRooms" sequence="31"/>
        <notification-topic topic="ChatMention"/>
        <notification-topic topic="NewMail"/>
        <keymap>
            <key keys="g i" label="Inbox" screen="BasicComms/Inbox"/>
            <key keys="g c" label="Chat" screen="BasicComms/Chat"/>
            <key keys="g m" label="Mail settings" screen="BasicComms/Settings/MailAccounts"/>
        </keymap>
    </shell-providers>

    <widgets><subscreens-panel id="basic-comms-panel" type="popup"/></widgets>
</screen>
