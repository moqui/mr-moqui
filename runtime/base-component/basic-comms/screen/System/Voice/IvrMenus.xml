<!-- Voice, IVR menus (plans/Comms-Framework.md §5.3, §5.4, §5.5, V5): auto attendant menus, each with its prompt (uploaded WAV or
    Ogg Opus; without one a tone pattern plays), how long it waits for a key and how often it plays again, how many keys it
    takes (more than one: an extension ended by #), its options (a key and where it goes: a user, a ring group, a queue,
    another menu, a voicemail box, an outside number, this menu again or the end), and where no key, a wrong key and its
    closed hours go. Route a number to a menu under Numbers. org.moqui.impl.IvrServices (the VoiceAdmin permission). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="IVR menus" default-menu-index="10">

    <transition-include name="searchTargets" location="component://basic-comms/template/VoiceTransitions.xml"/>
    <transition name="storeMenu">
        <service-call name="org.moqui.impl.IvrServices.store#IvrMenu" in-map="{ivrMenuId:ivrMenuId || null, name:name || '', description:description || '',
                timeoutSeconds:timeoutSeconds || null, maxRetries:maxRetries || null, maxDigits:maxDigits || null, commsScheduleId:commsScheduleId || '',
                invalidTypeEnumId:invalidTarget ? invalidTarget.split(':')[0] : '', invalidId:invalidTarget ? invalidTarget.split(':').slice(1).join(':') : '',
                timeoutTypeEnumId:timeoutTarget ? timeoutTarget.split(':')[0] : '', timeoutId:timeoutTarget ? timeoutTarget.split(':').slice(1).join(':') : '',
                closedTypeEnumId:closedTarget ? closedTarget.split(':')[0] : '', closedId:closedTarget ? closedTarget.split(':').slice(1).join(':') : ''}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Menu saved</message></if></actions>
        <default-response url="."/>
    </transition>
    <transition name="deleteMenu">
        <service-call name="org.moqui.impl.IvrServices.delete#IvrMenu" in-map="{ivrMenuId:ivrMenuId}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Menu removed</message></if></actions>
        <default-response url="."/>
    </transition>
    <transition name="storeOption">
        <service-call name="org.moqui.impl.IvrServices.store#IvrOption" in-map="{ivrMenuId:ivrMenuId, digits:digits || '',
                targetTypeEnumId:targetNumber ? 'CtgNumber' : (target ? target.split(':')[0] : ''),
                targetId:targetNumber ? targetNumber : (target ? target.split(':').slice(1).join(':') : ''), description:description || ''}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Option saved</message></if></actions>
        <default-response url="."/>
    </transition>
    <transition name="deleteOption">
        <service-call name="org.moqui.impl.IvrServices.delete#IvrOption" in-map="{ivrMenuId:ivrMenuId, digits:digits}"/>
        <default-response url="."/>
    </transition>
    <transition name="uploadPrompt">
        <actions><script><![CDATA[
            ec.service.sync().name('org.moqui.impl.IvrServices.store#IvrPrompt').parameters({ivrMenuId: ec.web.parameters.ivrMenuId,
                digits: ec.web.parameters.digits || null, file: ec.web.multiPartParameters.promptFile || null}).call()
            if (!ec.message.hasError()) ec.message.addMessage(ec.l10n.localize('Prompt saved'), 'success')
        ]]></script></actions>
        <default-response url="."/>
    </transition>
    <transition name="removePrompt">
        <service-call name="org.moqui.impl.IvrServices.store#IvrPrompt" in-map="{ivrMenuId:ivrMenuId, digits:digits || null, remove:true}"/>
        <default-response url="."/>
    </transition>

    <actions><script><![CDATA[
        const L = (text) => ec.l10n.localize(text)
        const call = (name, parameters) => ec.service.sync().name(name).parameters(parameters || {}).requireNewTransaction(true).disableAuthz().call() || {}
        const menus = Array.from(call('org.moqui.impl.IvrServices.find#IvrMenus').menuList || [])
        scheduleOptions = Array.from(call('org.moqui.impl.CallHandlingServices.find#CommsSchedules', {shared: true}).scheduleList || [])
            .map((s) => ({key: s.commsScheduleId, text: s.name + (s.timeZone ? ' (' + s.timeZone + ')' : '')}))
        ec.message.clearErrors()
        const targetText = (name, type) => name || (type ? type : L('Nothing set'))
        const encode = (type, id) => type ? type + ':' + (id || '') : null
        menuList = menus.map((m) => Object.assign({}, m, {
            promptText: m.hasPrompt ? L('Uploaded') : L('Tones'),
            keysText: m.maxDigits > 1 ? m.maxDigits + ' ' + L('keys, then #') : L('One key'),
            optionsText: m.optionList.map((o) => o.digits + ': ' + (o.targetName || o.targetTypeEnumId)).join(', ') || L('No options yet'),
            invalidText: m.invalidTypeEnumId ? targetText(m.invalidName, m.invalidTypeEnumId) : L('Play the menu again'),
            timeoutText: m.timeoutTypeEnumId ? targetText(m.timeoutName, m.timeoutTypeEnumId) : L('End the call'),
            closedText: m.commsScheduleId ? (m.scheduleName || '') + ': ' + (m.closedTypeEnumId ? targetText(m.closedName, m.closedTypeEnumId) : L('End the call')) : null,
            numbersText: m.numberList.join(', '),
            invalidTarget: encode(m.invalidTypeEnumId, m.invalidId), timeoutTarget: encode(m.timeoutTypeEnumId === 'CtgNumber' ? null : m.timeoutTypeEnumId, m.timeoutId),
            closedTarget: encode(m.closedTypeEnumId, m.closedId)}))
        optionList = []
        for (const m of menus) for (const o of m.optionList) optionList.push(Object.assign({menuName: m.name, targetText: o.targetName || o.targetTypeEnumId,
            promptText: o.hasPrompt ? L('Uploaded') : ''}, o))
        newMenu = {timeoutSeconds: 5, maxRetries: 2, maxDigits: 1}
    ]]></script></actions>
    <widgets>
        <container style="row items-center q-mb-sm">
            <label type="h6" text="IVR menus" style="q-my-none"/>
            <container style="col"/>
            <container-dialog id="NewMenuDialog" button-text="Add a menu" icon="sym_o_add" width="640" title="Add a menu" type="primary">
                <form-single name="NewMenu" transition="storeMenu" map="newMenu" focus-field="name">
                    <field name="name"><default-field title="Name"><text-line size="30"/></default-field></field>
                    <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                    <field name="timeoutSeconds"><default-field title="Seconds to wait for a key"><text-line size="5"/></default-field></field>
                    <field name="maxRetries"><default-field title="Times it plays again"><text-line size="5"/></default-field></field>
                    <field name="maxDigits"><default-field title="Keys" tooltip="1: one key; more: an extension ended by #"><text-line size="5"/></default-field></field>
                    <field name="timeoutTarget"><default-field title="No key"><drop-down allow-empty="true"><dynamic-options transition="searchTargets" server-search="true" min-length="0"/></drop-down></default-field></field>
                    <field name="invalidTarget"><default-field title="A wrong key" tooltip="Empty: the menu plays again"><drop-down allow-empty="true"><dynamic-options transition="searchTargets" server-search="true" min-length="0"/></drop-down></default-field></field>
                    <field name="commsScheduleId"><default-field title="Hours"><drop-down allow-empty="true"><list-options list="scheduleOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                    <field name="closedTarget"><default-field title="When closed"><drop-down allow-empty="true"><dynamic-options transition="searchTargets" server-search="true" min-length="0"/></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>
        <container-box><box-body-nopad>
            <form-list name="MenuList" list="menuList" skip-form="true" paginate="false">
                <field name="name"><default-field title="Menu"><display style="text-weight-medium"/></default-field></field>
                <field name="optionsText"><default-field title="Options"><display/></default-field></field>
                <field name="keysText"><default-field title="Keys"><display/></default-field></field>
                <field name="timeoutText"><default-field title="No key"><display/></default-field></field>
                <field name="invalidText"><default-field title="A wrong key"><display/></default-field></field>
                <field name="closedText"><default-field title="Closed"><display/></default-field></field>
                <field name="promptText"><default-field title="Prompt"><display/></default-field></field>
                <field name="numbersText"><default-field title="Numbers"><display/></default-field></field>
                <field name="tools" align="right"><default-field title="">
                    <container-dialog id="EditMenuDialog_${ivrMenuId}" button-text="Edit" icon="sym_o_edit" width="640" title="Edit ${name}">
                        <form-single name="EditMenu" transition="storeMenu">
                            <field name="ivrMenuId" from="ivrMenuId"><default-field><hidden/></default-field></field>
                            <field name="name" from="name"><default-field title="Name"><text-line size="30"/></default-field></field>
                            <field name="description" from="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                            <field name="timeoutSeconds" from="timeoutSeconds"><default-field title="Seconds to wait for a key"><text-line size="5"/></default-field></field>
                            <field name="maxRetries" from="maxRetries"><default-field title="Times it plays again"><text-line size="5"/></default-field></field>
                            <field name="maxDigits" from="maxDigits"><default-field title="Keys"><text-line size="5"/></default-field></field>
                            <field name="timeoutTarget" from="timeoutTarget"><default-field title="No key"><drop-down allow-empty="true"><dynamic-options transition="searchTargets" server-search="true" min-length="0"/></drop-down></default-field></field>
                            <field name="invalidTarget" from="invalidTarget"><default-field title="A wrong key"><drop-down allow-empty="true"><dynamic-options transition="searchTargets" server-search="true" min-length="0"/></drop-down></default-field></field>
                            <field name="commsScheduleId" from="commsScheduleId"><default-field title="Hours"><drop-down allow-empty="true"><list-options list="scheduleOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                            <field name="closedTarget" from="closedTarget"><default-field title="When closed"><drop-down allow-empty="true"><dynamic-options transition="searchTargets" server-search="true" min-length="0"/></drop-down></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="AddOptionDialog_${ivrMenuId}" button-text="Add an option" icon="sym_o_dialpad" width="560" title="Add an option to ${name}">
                        <form-single name="AddOption" transition="storeOption">
                            <field name="ivrMenuId" from="ivrMenuId"><default-field><hidden/></default-field></field>
                            <field name="digits"><default-field title="Key" tooltip="0 to 9, * or #; for an extension menu, its digits"><text-line size="10"/></default-field></field>
                            <field name="target"><default-field title="Goes to"><drop-down allow-empty="true"><dynamic-options transition="searchTargets" server-search="true" min-length="0"/></drop-down></default-field></field>
                            <field name="targetNumber"><default-field title="Or an outside number" tooltip="Under the deployment's fraud limits"><text-line size="20"/></default-field></field>
                            <field name="description"><default-field title="Description"><text-line size="30"/></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <container-dialog id="PromptDialog_${ivrMenuId}" button-text="Prompt" icon="sym_o_record_voice_over" width="520" title="The prompt of ${name}">
                        <label type="p" text="A WAV (16-bit PCM) or Ogg Opus file of at most a minute, recorded or made elsewhere; without one the menu plays a tone pattern. Moqui ships no recorded speech." style="m-muted"/>
                        <form-single name="UploadPrompt" transition="uploadPrompt">
                            <field name="ivrMenuId" from="ivrMenuId"><default-field><hidden/></default-field></field>
                            <field name="promptFile"><default-field title="Audio"><file size="30"/></default-field></field>
                            <field name="submitButton"><default-field title="Upload"><submit/></default-field></field>
                        </form-single>
                        <link url="removePrompt" text="Remove the prompt" link-type="hidden-form-link" parameter-map="{ivrMenuId:ivrMenuId}" condition="hasPrompt"/>
                    </container-dialog>
                    <link url="deleteMenu" link-type="hidden-form-link" icon="sym_o_delete" text="" tooltip="Remove" style="m-btn-flat" btn-type="danger"
                            confirmation="Remove the menu ${name} and its options?" parameter-map="{ivrMenuId:ivrMenuId}"/>
                </default-field></field>
                <columns type="mobile">
                    <column><field-ref name="name"/><field-ref name="optionsText"/></column>
                    <column><field-ref name="numbersText"/><field-ref name="tools"/></column>
                </columns>
            </form-list>
            <section name="NoMenus" condition="!menuList.length"><widgets>
                <label type="p" text="No menus yet. Add one and its options, then route a number to it under Numbers." style="m-muted q-pa-sm q-mb-none"/>
            </widgets></section>
        </box-body-nopad></container-box>
        <container-box><box-header title="Options"/><box-body-nopad>
            <form-list name="OptionList" list="optionList" skip-form="true" paginate="false">
                <field name="menuName"><default-field title="Menu"><display/></default-field></field>
                <field name="digits"><default-field title="Key"><display style="text-weight-medium"/></default-field></field>
                <field name="targetText"><default-field title="Goes to"><display/></default-field></field>
                <field name="description"><default-field title="Description"><display/></default-field></field>
                <field name="promptText"><default-field title="Prompt"><display/></default-field></field>
                <field name="tools" align="right"><default-field title="">
                    <container-dialog id="OptionPromptDialog_${ivrMenuId}_${digits}" button-text="Prompt" icon="sym_o_record_voice_over" width="520" title="Before ${digits} goes on">
                        <label type="p" text="Plays as the call goes on (for example, connecting you to sales). A WAV or Ogg Opus file of at most a minute." style="m-muted"/>
                        <form-single name="UploadOptionPrompt" transition="uploadPrompt">
                            <field name="ivrMenuId" from="ivrMenuId"><default-field><hidden/></default-field></field>
                            <field name="digits" from="digits"><default-field><hidden/></default-field></field>
                            <field name="promptFile"><default-field title="Audio"><file size="30"/></default-field></field>
                            <field name="submitButton"><default-field title="Upload"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <link url="deleteOption" link-type="hidden-form-link" icon="sym_o_delete" text="" tooltip="Remove" style="m-btn-flat" btn-type="danger"
                            confirmation="Remove the option ${digits} of ${menuName}?" parameter-map="{ivrMenuId:ivrMenuId, digits:digits}"/>
                </default-field></field>
            </form-list>
        </box-body-nopad></container-box>
    </widgets>
</screen>
