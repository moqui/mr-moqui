<!-- Admin: Voice (plans/Comms-Framework.md §5.5, D-A6): phone calls through SIP trunks, in the tools System app; basic-comms'
    MoquiConf.xml mounts it there, as the demo component changes System's screens. Its tabs: Status (whether phone calls work here,
    the SIP and media servers), Trunks, Numbers, Caller IDs, Fraud (the limits, the users' permissions, blocked sources) and
    Emergency (locations and the readiness checklist). Every read and write goes through org.moqui.impl.VoiceServices, whose
    administration services need the VoiceAdmin permission. These are XML screens, so they render in the terminal (tui) too. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Voice" default-menu-index="20" menu-image="sym_o_call" menu-image-type="icon">
    <subscreens default-item="Status">
        <subscreens-item name="Status" menu-index="1" location="component://basic-comms/screen/System/Voice/Status.xml"/>
        <subscreens-item name="Trunks" menu-index="2" location="component://basic-comms/screen/System/Voice/Trunks.xml"/>
        <subscreens-item name="Numbers" menu-index="3" location="component://basic-comms/screen/System/Voice/Numbers.xml"/>
        <subscreens-item name="CallerIds" menu-index="4" location="component://basic-comms/screen/System/Voice/CallerIds.xml"/>
        <subscreens-item name="Fraud" menu-index="5" location="component://basic-comms/screen/System/Voice/Fraud.xml"/>
        <subscreens-item name="Emergency" menu-index="6" location="component://basic-comms/screen/System/Voice/Emergency.xml"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="VoicePanel" type="tab"/>
    </widgets>
</screen>
