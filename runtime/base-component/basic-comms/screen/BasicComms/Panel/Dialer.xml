<!-- The Dialer tab of the tray panel (plans/Comms-Framework.md §5.5, V3): the theme value STRT_TRAY_DIALER names Comms/Panel/Dialer
    (BOSS) or BasicComms/Panel/Dialer, which the tray loads in its best client mode, qvue. The same component as Calls/Dialer
    (Calls/Dialer.qvue), with its transitions here too (template/DialerTransitions.xml); the terminal twin is DialerTui's. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Dialer" default-menu-include="false" render-modes="vue,qvue,tui" server-static="vue,qvue">

    <transition-include name="dialerData" location="component://basic-comms/template/DialerTransitions.xml"/>
    <transition-include name="dialSearch" location="component://basic-comms/template/DialerTransitions.xml"/>
    <transition-include name="dialNumber" location="component://basic-comms/template/DialerTransitions.xml"/>

    <widgets>
        <render-mode><text type="qvue" location="component://basic-comms/screen/BasicComms/Calls/Dialer.qvue" template="false"/>
            <text type="tui" location="component://basic-comms/screen/BasicComms/Panel/Dialer.tui.json" template="fancy"/></render-mode>
    </widgets>
</screen>
