<!-- Calls, Call (plans/Comms-Framework.md §6.6, mr-boss design-drawers-commons.md §14 Call, W1): the lobby (camera preview,
    microphone and camera pickers, a level meter, Join) and the call view (the grid of participants, the bottom bar: mute,
    camera, leave), with callSessionId. The component is Call.qvue next to this file, a frame around m-call, the shell's
    call component (webroot js/WebrootCall.js), which joins the call over the notification socket and keeps it in the
    LiveCall window when the user goes to another screen. In the terminal a call is not live: CallTui shows its state and
    its people, and Answer, Decline and Leave. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Call" default-menu-include="false" render-modes="vue,qvue,tui" server-static="vue,qvue">

    <parameter name="callSessionId"/>

    <widgets>
        <render-mode><text type="qvue" location="component://basic-comms/screen/BasicComms/Calls/Call.qvue" template="false"/>
            <text type="tui" location="component://basic-comms/screen/BasicComms/Calls/Call.tui.json" template="fancy"/></render-mode>
    </widgets>
</screen>
