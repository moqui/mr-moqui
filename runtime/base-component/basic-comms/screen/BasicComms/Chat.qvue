<!-- Chat (design-drawers-commons.md §13 Chat), the component Chat.xml serves in the qvue render mode: the rail (my status with
    its presets, New direct message, New room, Browse rooms, a find line, the filter chips All, Unread, Mentions, Direct,
    Rooms and Records, the pinned rooms and then the rest by their last message, each with its avatar or presence dot, last
    message, draft pen and unread and mention badges) and the room view (chat-room, below in the script, which the tray's Chat
    tab also shows). The room is in the URL (chatRoomId, eventSeq, thread; dm and recordEntity with recordId to start a direct
    message or open a record's room), read from $root.currentParameters, so a room is a link and Back works; below 1024 px
    the rail is the screen and a room opens over it with a back arrow. The live parts come from the page's chat store
    (moqui.chat.on: events, room changes, read markers, typing), the rest from the JSON transitions of Chat.xml. The Chat key
    scope: Alt+Up and Alt+Down change room, with Shift the unread ones, Esc marks the room read and closes the side pane,
    Shift+Esc marks every room read, Up in an empty composer edits my last message. A message is sent through the chat
    store's outbox (moqui.chat.send), so one sent offline waits in the page and goes when the page is back: its row shows
    Sending, Waiting or Not sent (Retry, Delete), and after a reconnect the room reads what it missed. The side panes:
    a thread, the room's threads, its files, members, pinned messages, search and the record. A message may be a poll
    (/poll or the composer's poll button), a forward (Forward… in its menu: the server quotes it) and has text cards of
    its links (no pictures; its sender removes them). An encrypted room (C7, New room's Encrypted; docs/interfaces/Chat-Keys.md
    "Encrypted rooms") is encrypted and decrypted in this browser (moqui.chat.sealMessage, openEvents, openEvent over
    moqui.crypto): its outbox items and drafts keep no text, its files go up encrypted and show from decrypted blobs, and
    it has no forward, filing, app actions or polls; its header and settings say what it gives up. Brand color names and
    Quasar classes only (style-guide §4.8, §5); the m-* inputs for what is typed. -->
<template><div class="m-chat-root"><div class="m-chat row no-wrap" :style="{height: height + 'px'}">
    <!-- the rail -->
    <div v-show="!stacked || !roomId" class="column no-wrap" :style="stacked ? 'width:100%' : 'width:300px;min-width:300px'">
        <div class="row items-center no-wrap q-px-sm q-pt-sm q-pb-xs">
            <q-btn flat dense no-caps align="left" class="col q-px-xs" :aria-label="t('My status')">
                <div class="row items-center no-wrap full-width" style="min-width:0">
                    <m-avatar :name="me.name || ''" :user-id="me.userId || undefined" size="30px"></m-avatar>
                    <div class="col q-ml-sm text-left" style="min-width:0">
                        <div class="text-subtitle2 ellipsis">{{t('Chat')}}</div>
                        <div class="text-caption m-muted ellipsis">{{myStatusText}}</div>
                    </div>
                    <q-icon name="sym_o_expand_more" size="18px" class="m-muted"></q-icon>
                </div>
                <q-menu anchor="bottom left" self="top left">
                    <q-list dense style="min-width:260px">
                        <q-item v-for="option in statusOptions" :key="option.value" clickable v-close-popup :active="myStatus.status === option.value"
                                @click="setStatus(option.value)">
                            <q-item-section avatar style="min-width:28px"><span class="m-status-dot" :class="'m-presence-' + option.dot"></span></q-item-section>
                            <q-item-section>{{option.label}}</q-item-section>
                        </q-item>
                        <q-separator spaced></q-separator>
                        <q-item-label header class="q-py-xs">{{t('Set a status')}}</q-item-label>
                        <q-item v-for="(preset, index) in prefs.statusPresets || []" :key="'preset' + index" clickable v-close-popup @click="usePreset(preset)">
                            <q-item-section avatar style="min-width:28px"><span>{{preset.emoji || '💬'}}</span></q-item-section>
                            <q-item-section><q-item-label>{{preset.text}}</q-item-label>
                                <q-item-label caption>{{clearLabel(preset.clearAfter)}}</q-item-label></q-item-section>
                        </q-item>
                        <q-item v-if="myStatus.statusText || myStatus.emoji" clickable v-close-popup @click="clearStatus">
                            <q-item-section avatar style="min-width:28px"><q-icon name="sym_o_close" size="18px"></q-icon></q-item-section>
                            <q-item-section>{{t('Clear status')}}</q-item-section>
                        </q-item>
                        <q-separator spaced></q-separator>
                        <q-item clickable v-close-popup @click="go(linkBase.replace(/\/Chat$/, '/Settings/Chat'))">
                            <q-item-section avatar style="min-width:28px"><q-icon name="sym_o_settings" size="18px"></q-icon></q-item-section>
                            <q-item-section>{{t('Chat settings')}}</q-item-section>
                        </q-item>
                    </q-list>
                </q-menu>
            </q-btn>
            <q-btn flat round dense icon="sym_o_edit_square" color="primary" :aria-label="t('New message or room')">
                <q-tooltip>{{t('New message or room')}}</q-tooltip>
                <q-menu anchor="bottom right" self="top right">
                    <q-list dense style="min-width:220px">
                        <q-item clickable v-close-popup @click="openNewDirect()"><q-item-section avatar><q-icon name="sym_o_person_add"></q-icon></q-item-section>
                            <q-item-section>{{t('New direct message')}}</q-item-section></q-item>
                        <q-item clickable v-close-popup @click="openNewRoom()"><q-item-section avatar><q-icon name="sym_o_group_add"></q-icon></q-item-section>
                            <q-item-section>{{t('New room')}}</q-item-section></q-item>
                        <q-item clickable v-close-popup @click="openBrowse()"><q-item-section avatar><q-icon name="sym_o_travel_explore"></q-icon></q-item-section>
                            <q-item-section>{{t('Browse rooms')}}</q-item-section></q-item>
                        <q-separator></q-separator>
                        <q-item clickable v-close-popup @click="markAllRead"><q-item-section avatar><q-icon name="sym_o_done_all"></q-icon></q-item-section>
                            <q-item-section>{{t('Mark all read')}}</q-item-section></q-item>
                    </q-list>
                </q-menu>
            </q-btn>
        </div>
        <div class="q-px-sm q-pb-xs" @keydown.esc="search = ''">
            <m-text-line v-model="search" name="chatRoomSearch" id="ChatRoomSearch" :label="t('Find a room or person')"></m-text-line>
        </div>
        <div class="row q-px-sm q-pb-xs">
            <q-chip v-for="item in filterItems" :key="item.value" dense clickable :outline="filter !== item.value" :color="filter === item.value ? 'primary' : undefined"
                    :text-color="filter === item.value ? 'white' : undefined" class="q-ml-none q-mr-xs q-my-none" :data-filter="item.value" @click="filter = item.value">
                {{item.label}}<span v-if="item.count" class="q-ml-xs text-weight-bold">{{item.count}}</span></q-chip>
        </div>
        <q-separator></q-separator>
        <div class="col scroll" style="min-height:0">
            <div v-if="!loaded" class="q-pa-sm">
                <div v-for="n in 7" :key="n" class="row items-center no-wrap q-py-sm q-gutter-x-sm">
                    <q-skeleton type="QAvatar" size="32px"></q-skeleton>
                    <div class="col"><q-skeleton type="text" width="50%"></q-skeleton><q-skeleton type="text"></q-skeleton></div>
                </div>
            </div>
            <q-list v-else dense>
                <template v-for="group in groups" :key="group.key">
                    <q-item-label v-if="group.label" header class="q-py-xs q-px-md text-caption text-weight-medium">{{group.label}}</q-item-label>
                    <q-item v-for="room in group.rows" :key="room.chatRoomId" clickable :active="room.chatRoomId === roomId" active-class="m-tonal text-primary"
                            class="q-py-xs q-px-sm" :data-room="room.chatRoomId" @click="openRoom(room.chatRoomId)">
                        <q-item-section avatar style="min-width:42px">
                            <m-avatar v-if="room.roomTypeEnumId === 'CrtDirect' && room.otherUserId" :name="room.displayName" :user-id="room.otherUserId" size="32px"></m-avatar>
                            <q-avatar v-else size="32px" rounded class="m-tonal text-primary" :icon="roomIcon(room)"></q-avatar>
                        </q-item-section>
                        <q-item-section style="min-width:0">
                            <q-item-label class="row no-wrap items-center">
                                <span class="ellipsis" :class="countsOf(room).unread || countsOf(room).mentions ? 'text-weight-bold' : ''">{{room.displayName}}</span>
                                <q-icon v-if="room.isPinned" name="sym_o_keep" size="12px" class="m-muted q-ml-xs"></q-icon>
                                <q-icon v-if="room.bridged" :name="room.notConnected ? 'sym_o_link_off' : 'sym_o_hub'" size="12px" class="q-ml-xs"
                                        :class="room.notConnected ? 'text-warning' : 'm-muted'" :data-bridged="room.chatRoomId"><q-tooltip>{{bridgeText(room)}}</q-tooltip></q-icon>
                                <q-space></q-space>
                                <span class="text-caption m-muted text-no-wrap q-ml-xs">{{shortWhen(room.lastMessage ? room.lastMessage.sentDate : room.lastEventDate)}}</span>
                            </q-item-label>
                            <q-item-label caption class="row no-wrap items-center">
                                <q-icon v-if="drafts[room.chatRoomId]" name="sym_o_edit" size="12px" class="text-negative q-mr-xs"><q-tooltip>{{t('Draft')}}</q-tooltip></q-icon>
                                <span class="ellipsis col">{{snippetOf(room)}}</span>
                                <q-icon v-if="room.isMuted || room.notificationLevelEnumId === 'CnlNone'" name="sym_o_notifications_off" size="12px" class="m-muted q-ml-xs"></q-icon>
                                <q-badge v-if="countsOf(room).mentions" color="negative" rounded class="q-ml-xs">@{{countsOf(room).mentions}}</q-badge>
                                <q-badge v-else-if="countsOf(room).unread" :color="room.isMuted || room.notificationLevelEnumId !== 'CnlAll' ? 'grey-6' : 'primary'" rounded
                                        class="q-ml-xs">{{countsOf(room).unread}}</q-badge>
                            </q-item-label>
                        </q-item-section>
                    </q-item>
                </template>
            </q-list>
            <div v-if="loaded && !rooms.length" class="column items-center q-pa-lg text-center">
                <q-icon name="sym_o_forum" size="48px" class="m-muted"></q-icon>
                <div class="text-subtitle2 q-mt-sm">{{t('Start a conversation')}}</div>
                <div class="text-caption m-muted q-mb-md">{{t('Message a colleague, or make a room for a team or a topic.')}}</div>
                <q-btn unelevated no-caps color="primary" icon="sym_o_person_add" :label="t('New direct message')" @click="openNewDirect()"></q-btn>
                <q-btn flat no-caps color="primary" icon="sym_o_travel_explore" :label="t('Browse rooms')" class="q-mt-xs" @click="openBrowse()"></q-btn>
            </div>
            <div v-else-if="loaded && !shownRooms.length" class="q-pa-md text-caption m-muted text-center">
                {{t('No rooms match')}} <a href="#" class="text-primary" @click.prevent="clearFilters">{{t('Clear filters')}}</a>
            </div>
        </div>
    </div>
    <q-separator v-if="!stacked" vertical></q-separator>

    <!-- the room -->
    <div v-show="!stacked || roomId" class="col column no-wrap" style="min-width:0">
        <chat-room v-if="roomId && loaded" :key="roomId" ref="room" :base="base" :room-id="roomId" :me="me" :prefs="prefs" :seq="seq" :thread="thread"
                :can-go-back="stacked" :link-base="linkBase" @back="closeRoom" @thread="setThread" @changed="scheduleRooms" @left="onLeft"
                @open-room="openRoom" @create-from="openQuickCreate" @read="onRoomRead"></chat-room>
        <div v-else class="col column items-center justify-center q-pa-lg text-center m-muted">
            <q-icon name="sym_o_chat" size="56px"></q-icon>
            <div class="text-subtitle1 q-mt-sm">{{t('Pick a conversation')}}</div>
            <div class="text-caption q-mb-md">{{t('Or start a new one: a direct message or a room.')}}</div>
            <div class="row q-gutter-sm justify-center">
                <q-btn unelevated no-caps color="primary" icon="sym_o_person_add" :label="t('New direct message')" @click="openNewDirect()"></q-btn>
                <q-btn unelevated no-caps class="m-btn-tonal" icon="sym_o_group_add" :label="t('New room')" @click="openNewRoom()"></q-btn>
            </div>
        </div>
    </div>
</div>

    <!-- NewDirect: one person, or several for a group message -->
    <m-dialog v-model="newDirect.open" :title="t('New direct message')" width="520">
        <m-drop-down v-model="newDirect.userIds" name="directUserIds" multiple server-search :options-url="url('searchUsers')" :label="t('To')"></m-drop-down>
        <div class="text-caption m-muted q-mt-xs">{{t('One person, or several for a group message. A conversation you already have with them opens again.')}}</div>
        <div class="row q-gutter-sm q-mt-md">
            <q-btn unelevated no-caps color="primary" icon="sym_o_chat" :label="t('Start')" :loading="newDirect.busy" :disable="!newDirect.userIds.length" @click="startDirect"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
        </div>
    </m-dialog>

    <!-- NewRoom: name, topic, private or public, members -->
    <m-dialog v-model="newRoom.open" :title="t('New room')" width="560">
        <q-btn-toggle v-model="newRoom.type" spread dense no-caps unelevated toggle-color="primary" class="q-mb-xs"
                :options="[{label: t('Private'), value: 'private', icon: 'sym_o_lock'}, {label: t('Public'), value: 'public', icon: 'sym_o_tag'}]"></q-btn-toggle>
        <div class="text-caption m-muted q-mb-sm">{{newRoom.type === 'public' ? t('Anyone can find this room, read it and join.') : t('Only the people in it see it; members add others.')}}</div>
        <template v-if="newRoom.type !== 'public'">
            <q-toggle v-model="newRoom.encrypted" name="roomEncrypted" :label="t('Encrypted')" class="m-chat-new-encrypted"></q-toggle>
            <div v-if="newRoom.encrypted" class="text-caption m-muted q-mb-sm">{{t('End-to-end encrypted, for good: only the devices of its members read it. No server search, link previews, agents, polls, bridges, forwards, filing on records or terminal; a new device reads older messages from your key backup.')}}</div>
        </template>
        <m-text-line v-model="newRoom.name" name="roomName" :label="t('Name')" required></m-text-line>
        <m-text-area v-model="newRoom.topic" name="roomTopic" rows="2" :label="t('Topic')" class="q-mt-xs"></m-text-area>
        <m-drop-down v-model="newRoom.userIds" name="roomUserIds" multiple server-search :options-url="url('searchUsers')" :label="t('Members')" class="q-mt-xs"></m-drop-down>
        <div class="row q-gutter-sm q-mt-md">
            <q-btn unelevated no-caps color="primary" icon="sym_o_add" :label="t('Create')" :loading="newRoom.busy" :disable="!String(newRoom.name || '').trim()" @click="createRoom"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
        </div>
    </m-dialog>

    <!-- Browse rooms: the public rooms I am not in, to read or join -->
    <m-dialog v-model="browse.open" :title="t('Browse rooms')" width="620">
        <div class="row no-wrap items-center q-gutter-x-xs" @keydown.enter.prevent="loadBrowse">
            <div class="col"><m-text-line v-model="browse.search" name="browseSearch" :label="t('Find a room')"></m-text-line></div>
            <q-btn flat round dense icon="sym_o_search" :aria-label="t('Search')" @click="loadBrowse"></q-btn>
        </div>
        <q-list dense separator class="q-mt-sm">
            <q-item v-for="room in browse.list" :key="room.chatRoomId" class="q-px-xs">
                <q-item-section avatar><q-avatar size="32px" rounded class="m-tonal text-primary" :icon="roomIcon(room)"></q-avatar></q-item-section>
                <q-item-section><q-item-label class="text-weight-medium">{{room.displayName}}</q-item-label>
                    <q-item-label caption class="ellipsis-2-lines">{{room.topic || (room.record ? room.record.typeLabel + ' ' + room.record.title : t('No topic'))}}</q-item-label></q-item-section>
                <q-item-section side><div class="row no-wrap q-gutter-x-xs">
                    <q-btn flat dense no-caps color="primary" :label="t('View')" @click="viewBrowsed(room)"></q-btn>
                    <q-btn unelevated dense no-caps color="primary" :label="t('Join')" @click="joinBrowsed(room)"></q-btn>
                </div></q-item-section>
            </q-item>
            <q-item v-if="!browse.loading && !browse.list.length"><q-item-section class="m-muted">{{t('No public rooms to join')}}</q-item-section></q-item>
        </q-list>
        <q-inner-loading :showing="browse.loading"></q-inner-loading>
    </m-dialog>
</div></template>

<script>
const t = (text) => (moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text);
const DAY = 86400000;
const GROUP_MILLIS = 5 * 60000;
const EDIT_WINDOW = 24 * 3600000;
const QUICK_REACTIONS = ['👍', '❤️', '😂', '🎉', '👀', '✅'];
const EMOJI = ['😀', '😃', '😄', '😁', '😅', '😂', '🙂', '😉', '😊', '😍', '🤔', '😐', '😴', '😎', '🥳', '😢', '😮', '😬', '🙃', '🤝',
    '👍', '👎', '👏', '🙌', '🙏', '💪', '👀', '🎉', '🔥', '✅', '❌', '⚠️', '❤️', '💡', '📌', '📎', '🚀', '☕', '🍕', '💬'];
const CLEAR_LABELS = { '0': "Don't clear", '30': 'Clears in 30 minutes', '60': 'Clears in an hour', '240': 'Clears in 4 hours', today: 'Clears today', week: 'Clears this week' };
const ROOM_ICONS = { CrtDirect: 'sym_o_group', CrtPrivate: 'sym_o_lock', CrtPublic: 'sym_o_tag', CrtRecord: 'sym_o_description', CrtExternal: 'sym_o_sms' };
const LEVELS = [{ value: 'CnlAll', label: 'All messages', icon: 'sym_o_notifications_active' }, { value: 'CnlMentions', label: 'Mentions only', icon: 'sym_o_alternate_email' },
    { value: 'CnlNone', label: 'Nothing', icon: 'sym_o_notifications_off' }];
// under the storage scope: in the desktop client every server's pages share one origin (MoquiLib scopedKey)
const draftPrefix = () => moqui.scopedKey('boss.chat.draft.');
// the drafts of encrypted rooms: in this page only (C7)
const sealedDrafts = {};
const fill = (text, values) => String(text).replace(/\{(\w+)\}/g, (match, key) => (values[key] == null ? '' : String(values[key])));
const timeText = (millis) => (millis ? new Date(Number(millis)).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' }) : '');
const fullTime = (millis) => (millis ? new Date(Number(millis)).toLocaleString(undefined, { dateStyle: 'full', timeStyle: 'short' }) : '');
const dayLabel = (millis) => {
    const d = new Date(Number(millis));
    const now = new Date();
    if (d.toDateString() === now.toDateString()) return t('Today');
    if (d.toDateString() === new Date(now.getTime() - DAY).toDateString()) return t('Yesterday');
    const opts = { weekday: 'long', month: 'long', day: 'numeric' };
    if (d.getFullYear() !== now.getFullYear()) opts.year = 'numeric';
    return d.toLocaleDateString(undefined, opts);
};
const shortWhen = (millis) => {
    if (!millis) return '';
    const d = new Date(Number(millis));
    const now = new Date();
    if (d.toDateString() === now.toDateString()) return timeText(millis);
    if (now.getTime() - d.getTime() < 6 * DAY) return d.toLocaleDateString(undefined, { weekday: 'short' });
    if (d.getFullYear() === now.getFullYear()) return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
};
const sizeText = (bytes) => {
    const n = Number(bytes || 0);
    if (n < 1024) return n + ' B';
    if (n < 1024 * 1024) return Math.round(n / 1024) + ' KB';
    return (n / 1024 / 1024).toFixed(1) + ' MB';
};
const isImage = (file) => /^image\/(png|jpe?g|gif|webp)$/i.test((file && file.contentType) || '');
const fileIcon = (file) => {
    const type = String((file && file.contentType) || '');
    if (/^image\//.test(type)) return 'sym_o_image';
    if (/pdf/.test(type)) return 'sym_o_picture_as_pdf';
    if (/(sheet|excel|csv)/.test(type)) return 'sym_o_table';
    if (/(word|document|text)/.test(type)) return 'sym_o_description';
    if (/(zip|compressed)/.test(type)) return 'sym_o_folder_zip';
    return 'sym_o_attach_file';
};
// mentions of me read in bold (the rich-text content style tints every mention)
const decorateBody = (html, me) => String(html || '').replace(/<span data-mention-id="([^"]*)"/g,
    (match, id) => '<span class="m-chat-mention' + (id === me ? ' text-weight-bold' : '') + '" data-mention-id="' + id + '"');
const plainOf = (html) => (moqui.richText && moqui.richText.toPlain ? moqui.richText.toPlain(html || '') : String(html || '').replace(/<[^>]*>/g, ' ')).trim();
// a pushed event merged into a timeline list (the page's chat store; nothing without it)
const applyEvent = (list, event, me, threadRoot) => (moqui.chat && moqui.chat.applyEvent ? moqui.chat.applyEvent(list, event, me, threadRoot) : list);
const isEmptyHtml = (html) => (moqui.richText && moqui.richText.isEmpty ? moqui.richText.isEmpty(html || '') : !plainOf(html));
// a membership, system, pin, call or poll event in words, with its icon
const systemText = (event, nameOf) => {
    const content = event.content || {};
    const by = nameOf(content.byUserId || event.senderUserId);
    const who = nameOf(content.userId || content.chatActorId);
    const roles = { CmrOwner: t('an owner'), CmrModerator: t('a moderator'), CmrMember: t('a member'), CmrAgent: t('an agent') };
    if (event.type === 'membership') {
        if (content.action === 'join') return [fill(t('{user} joined'), { user: who }), 'sym_o_login'];
        if (content.action === 'add') return [fill(t('{by} added {user}'), { by, user: who }), 'sym_o_person_add'];
        if (content.action === 'leave') return [fill(t('{user} left'), { user: who }), 'sym_o_logout'];
        if (content.action === 'remove') return [fill(t('{by} took {user} out'), { by, user: who }), 'sym_o_person_remove'];
        if (content.action === 'role') return [fill(t('{by} made {user} {role}'), { by, user: who, role: roles[content.roleEnumId] || content.roleEnumId }), 'sym_o_shield_person'];
        return [fill(t('{by} changed the members'), { by }), 'sym_o_group'];
    }
    if (event.type === 'system') {
        if (content.action === 'created') return [fill(t('{by} created the room'), { by }), 'sym_o_add_circle'];
        if (content.action === 'renamed') return [fill(t('{by} renamed the room to {name}'), { by, name: content.roomName || '' }), 'sym_o_edit'];
        if (content.action === 'topic') return [content.topic ? fill(t('{by} set the topic: {topic}'), { by, topic: content.topic }) : fill(t('{by} cleared the topic'), { by }), 'sym_o_subject'];
        if (content.action === 'archived') return [fill(t('{by} archived the room'), { by }), 'sym_o_archive'];
        if (content.action === 'unarchived') return [fill(t('{by} took the room out of the archive'), { by }), 'sym_o_unarchive'];
        return [fill(t('{by} changed the room'), { by }), 'sym_o_info'];
    }
    if (event.type === 'pin') return [fill(content.pinned ? t('{by} pinned a message') : t('{by} unpinned a message'), { by }), 'sym_o_keep'];
    if (event.type === 'call') return [fill(t('{by} started a call'), { by }), 'sym_o_call'];
    if (event.type === 'poll') return [fill(t('{by} made a poll'), { by }), 'sym_o_ballot'];
    return [by, 'sym_o_info'];
};
const storage = {
    get(key) { try { return window.localStorage.getItem(key); } catch (err) { return null; } },
    set(key, value) { try { if (value) window.localStorage.setItem(key, value); else window.localStorage.removeItem(key); } catch (err) { /* no storage */ } },
    keys(prefix) { const out = []; try { for (let i = 0; i < window.localStorage.length; i++) { const key = window.localStorage.key(i); if (key && key.indexOf(prefix) === 0) out.push(key); } } catch (err) { /* no storage */ } return out; }
};
// a short sound for a new message, at most every two seconds (not under do not disturb: the caller asks moqui.chat.quiet())
let lastChime = 0;
let audio = null;
const chime = () => {
    const now = Date.now();
    if (now - lastChime < 2000) return;
    lastChime = now;
    try {
        const Ctx = window.AudioContext || window.webkitAudioContext;
        if (!Ctx) return;
        audio = audio || new Ctx();
        const osc = audio.createOscillator();
        const gain = audio.createGain();
        osc.type = 'sine';
        osc.frequency.value = 880;
        gain.gain.setValueAtTime(0.0001, audio.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.05, audio.currentTime + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, audio.currentTime + 0.25);
        osc.connect(gain);
        gain.connect(audio.destination);
        osc.start();
        osc.stop(audio.currentTime + 0.3);
    } catch (err) { /* the browser plays nothing before the user's first click */ }
};

// ---- a message of the timeline or of a thread (room is the chat-room component) ----
const messageTemplate = `
<div class="row no-wrap relative-position q-pl-xs q-pr-sm m-chat-msg" :class="item.grouped ? '' : 'q-mt-sm'" :id="room.domId(item.eventSeq, inThread)"
        :data-seq="item.eventSeq" @mouseenter="room.hover(item, inThread)" @mouseleave="room.unhover(item, inThread)" @click="room.tap(item, inThread)">
    <div class="self-stretch" :class="item.highlight ? 'bg-primary' : ''" style="width:3px;margin-right:3px;border-radius:2px"></div>
    <div style="width:40px;min-width:40px" class="q-pr-sm">
        <m-avatar v-if="!item.grouped" :name="item.senderName" :user-id="item.senderUserId || undefined" size="32px" class="q-mt-xs"></m-avatar>
        <div v-else-if="room.isHovered(item, inThread)" class="text-caption m-muted text-right text-no-wrap" style="font-size:10px;line-height:20px">{{item.timeShort}}</div>
    </div>
    <div class="col" style="min-width:0">
        <div v-if="!item.grouped" class="row items-baseline no-wrap">
            <span class="text-weight-medium ellipsis">{{item.senderName}}</span>
            <q-chip v-if="item.event.senderExternal" dense square size="sm" icon="sym_o_hub" class="m-tonal text-info q-my-none q-ml-xs m-chat-external">
                {{item.event.senderExternal.networkName || room.t('Outside')}}</q-chip>
            <span class="text-caption m-muted text-no-wrap q-ml-sm">{{item.timeText}}<q-tooltip>{{item.fullTime}}</q-tooltip></span>
            <q-icon v-if="item.pinned" name="sym_o_keep" size="14px" color="primary" class="q-ml-xs"><q-tooltip>{{room.t('Pinned')}}</q-tooltip></q-icon>
        </div>
        <div v-if="item.replyTo" class="row no-wrap q-my-xs cursor-pointer" @click.stop="room.jumpTo(item.replyTo.eventSeq)">
            <div class="self-stretch bg-grey-5" style="width:3px;border-radius:2px"></div>
            <div class="q-pl-sm text-caption ellipsis-2-lines" style="min-width:0">
                <span class="text-weight-medium">{{(item.replyTo.senderName || room.t('Someone')) + ': '}}</span><span class="m-muted">{{item.replyTo.redacted ? room.t('Message removed') : item.replyTo.snippet}}</span>
            </div>
        </div>
        <div v-if="item.redacted" class="text-body2 m-muted text-italic">{{item.removedLabel || room.t('Message removed')}}</div>
        <div v-else-if="item.undecryptable" class="text-body2 m-muted text-italic m-chat-undecryptable"><q-icon name="sym_o_lock" size="16px" class="q-mr-xs"></q-icon>{{room.t('Encrypted message: this device has no key for it yet. Restore your key backup in Settings, My devices, or keep this page open while another of your devices shares it.')}}</div>
        <template v-else>
            <chat-edit v-if="room.isEditing(item)" :room="room" :item="item"></chat-edit>
            <div v-else-if="item.bodyHtml && !item.poll" class="m-rich-text-content text-body2" style="padding:0;cursor:auto;max-height:none;overflow:visible;overflow-wrap:anywhere"
                    v-html="item.bodyHtml" @click="room.bodyClick($event)"></div>
            <span v-if="item.edited && !room.isEditing(item)" class="text-caption m-muted">{{room.t('(edited)')}}<q-tooltip>{{item.editedText}}</q-tooltip></span>
            <div v-if="item.forwardOf" class="row no-wrap q-mt-xs m-chat-forward" style="max-width:520px">
                <div class="self-stretch bg-grey-5" style="width:3px;border-radius:2px"></div>
                <div class="q-pl-sm" style="min-width:0">
                    <div class="text-caption m-muted"><q-icon name="sym_o_forward" size="14px" class="q-mr-xs"></q-icon>{{room.forwardedText(item.forwardOf)}}</div>
                    <div v-if="item.forwardOf.body" class="m-rich-text-content text-body2" style="padding:0;cursor:auto;max-height:none;overflow:visible;overflow-wrap:anywhere"
                            v-html="item.forwardOf.body" @click="room.bodyClick($event)"></div>
                </div>
            </div>
            <q-card v-if="item.poll" flat bordered class="q-mt-xs q-pa-sm m-chat-poll" style="max-width:440px">
                <div class="row no-wrap items-start text-weight-medium q-mb-xs"><q-icon name="sym_o_ballot" size="18px" class="q-mr-xs text-primary"></q-icon>
                    <span style="overflow-wrap:anywhere">{{item.poll.question}}</span></div>
                <q-item v-for="option in item.poll.options" :key="option.id" dense clickable class="rounded-borders q-px-xs" :disable="!room.canVote(item)"
                        :data-option="option.id" @click.stop="room.vote(item, option)">
                    <q-item-section avatar style="min-width:28px"><q-icon :name="room.optionIcon(item, option)" :color="option.mine ? 'primary' : undefined" size="20px"></q-icon></q-item-section>
                    <q-item-section>
                        <q-item-label style="overflow-wrap:anywhere">{{option.text}}</q-item-label>
                        <q-linear-progress :value="room.optionShare(item, option)" rounded size="6px" :color="option.mine ? 'primary' : 'grey-5'" class="q-mt-xs"></q-linear-progress>
                    </q-item-section>
                    <q-item-section side class="text-caption">{{option.voteCount}}<q-tooltip v-if="option.voterIds && option.voterIds.length">{{room.votersText(option)}}</q-tooltip></q-item-section>
                </q-item>
                <div class="row items-center no-wrap text-caption m-muted q-mt-xs">
                    <span class="ellipsis">{{room.pollFooter(item.poll)}}</span><q-space></q-space>
                    <q-btn v-if="room.canClosePoll(item)" flat dense no-caps size="sm" color="primary" :label="room.t('Close the poll')" @click.stop="room.closePoll(item)"></q-btn>
                </div>
            </q-card>
            <div v-if="item.attachments.length" class="row q-gutter-xs q-mt-none">
                <template v-for="file in item.attachments" :key="file.chatAttachmentId">
                    <img v-if="room.isImage(file)" :src="room.fileUrl(file, true)" :alt="file.fileName" class="rounded-borders cursor-pointer q-mt-xs"
                            style="max-width:min(280px, 100%);max-height:200px" @load="room.imageLoaded()" @click.stop="room.preview(file)">
                    <q-chip v-else dense square clickable :icon="room.fileIcon(file)" class="m-tonal q-ml-none" @click.stop="room.download(file)">
                        <span class="ellipsis" style="max-width:220px">{{file.fileName}}</span><span class="m-muted q-ml-xs">{{room.sizeText(file.fileSize)}}</span>
                        <q-tooltip>{{room.t('Download')}} {{file.fileName}}</q-tooltip></q-chip>
                </template>
            </div>
            <div v-if="item.linkPreviews.length" class="q-mt-xs" style="max-width:440px">
                <q-card v-for="preview in item.linkPreviews" :key="preview.url" flat bordered class="row no-wrap q-pa-sm q-mb-xs m-chat-link-preview">
                    <div class="self-stretch bg-primary q-mr-sm" style="width:3px;border-radius:2px"></div>
                    <div class="col" style="min-width:0">
                        <div v-if="preview.siteName" class="text-caption m-muted ellipsis">{{preview.siteName}}</div>
                        <a :href="preview.url" target="_blank" rel="noopener noreferrer" class="text-primary text-weight-medium ellipsis-2-lines" @click.stop>{{preview.title}}</a>
                        <div v-if="preview.description" class="text-caption ellipsis-3-lines">{{preview.description}}</div>
                    </div>
                    <q-btn v-if="item.mine && room.canPost" flat round dense size="sm" icon="sym_o_close" class="self-start" :aria-label="room.t('Remove preview')"
                            @click.stop="room.removePreviews(item)"><q-tooltip>{{room.t('Remove preview')}}</q-tooltip></q-btn>
                </q-card>
            </div>
            <div v-if="item.records.length" class="q-mt-xs" style="max-width:440px">
                <m-record-card v-for="record in item.records" :key="record.entity + '|' + record.id" :record-entity="record.entity" :record-id="record.id"
                        :card-url="room.url('recordCard')" dense class="q-mb-xs"></m-record-card>
            </div>
            <div v-if="item.reactions.length" class="row items-center q-mt-xs">
                <q-chip v-for="reaction in item.reactions" :key="reaction.key" dense clickable :outline="!reaction.mine" :color="reaction.mine ? 'primary' : undefined"
                        :text-color="reaction.mine ? 'white' : undefined" class="q-ml-none q-mr-xs" :disable="!room.canPost || !room.bridgeCaps.reaction" @click.stop="room.react(item, reaction.key)">
                    {{reaction.key}} {{reaction.count}}<q-tooltip>{{room.reactorsText(reaction)}}</q-tooltip></q-chip>
            </div>
            <div v-if="!inThread && item.threadReplyCount" class="q-mt-xs">
                <a href="#" class="text-primary text-caption text-weight-medium" @click.prevent.stop="room.openThread(item.eventSeq)">{{room.repliesText(item.threadReplyCount)}}</a>
                <span class="text-caption m-muted"> · {{room.t('last reply')}} {{room.shortWhen(item.threadLastDate)}}</span>
            </div>
            <!-- its delivery to the room's bridges: sending, delivered, not delivered (with Send again) or uncertain -->
            <div v-if="item.event.delivery" class="row items-center no-wrap q-mt-xs text-caption m-chat-delivery" :class="room.deliveryClass(item)"
                    :data-delivery="item.event.delivery.state">
                <q-icon :name="room.deliveryIcon(item)" size="14px" class="q-mr-xs"></q-icon>
                <span class="ellipsis">{{room.deliveryText(item)}}</span>
                <q-btn v-if="room.canRetry(item)" flat dense no-caps size="sm" color="primary" class="q-ml-xs" :label="room.t('Send again')"
                        @click.stop="room.retryDelivery(item)"></q-btn>
            </div>
        </template>
        <div v-if="item.readers && item.readers.length" class="row justify-end items-center no-wrap q-mt-xs">
            <m-avatar v-for="reader in item.readers.slice(0, 6)" :key="reader.userId" :name="reader.name" :user-id="reader.userId" size="16px" class="q-ml-xs" tooltip></m-avatar>
            <span v-if="item.readers.length > 6" class="text-caption m-muted q-ml-xs">+{{item.readers.length - 6}}</span>
        </div>
    </div>
    <div v-if="room.showActions(item, inThread)" class="absolute-top-right q-mr-sm" style="top:-14px;z-index:2" @click.stop>
        <q-card flat bordered class="row no-wrap items-center shadow-2">
            <template v-if="room.canPost">
                <template v-if="room.bridgeCaps.reaction">
                    <q-btn v-for="key in room.quickReactions.slice(0, room.compact ? 2 : 3)" :key="key" flat dense size="sm" class="q-px-xs" :label="key"
                            :aria-label="room.t('React with') + ' ' + key" @click="room.react(item, key)"></q-btn>
                    <q-btn flat round dense size="sm" icon="sym_o_add_reaction" :aria-label="room.t('React')"><q-tooltip>{{room.t('React')}}</q-tooltip>
                        <q-menu anchor="bottom right" self="top right"><div class="q-pa-xs row" style="width:236px">
                            <q-btn v-for="key in room.emoji" :key="key" flat dense size="sm" class="q-px-xs" :label="key" v-close-popup @click="room.react(item, key)"></q-btn>
                        </div></q-menu>
                    </q-btn>
                </template>
                <q-btn v-if="!inThread" flat round dense size="sm" icon="sym_o_reply" :aria-label="room.t('Reply')" @click="room.startReply(item)"><q-tooltip>{{room.t('Reply')}}</q-tooltip></q-btn>
                <q-btn v-if="!inThread" flat round dense size="sm" icon="sym_o_forum" :aria-label="room.t('Reply in thread')" @click="room.openThread(item.eventSeq)">
                    <q-tooltip>{{room.t('Reply in thread')}}</q-tooltip></q-btn>
            </template>
            <q-btn flat round dense size="sm" icon="sym_o_more_vert" :aria-label="room.t('More')"><q-tooltip>{{room.t('More')}}</q-tooltip>
                <q-menu anchor="bottom right" self="top right"><q-list dense style="min-width:230px">
                    <q-item v-if="room.canEdit(item)" clickable v-close-popup @click="room.startEdit(item)">
                        <q-item-section avatar><q-icon name="sym_o_edit"></q-icon></q-item-section><q-item-section>{{room.t('Edit')}}</q-item-section></q-item>
                    <q-item v-if="room.canPost" clickable v-close-popup @click="room.pin(item, !item.pinned)">
                        <q-item-section avatar><q-icon name="sym_o_keep"></q-icon></q-item-section>
                        <q-item-section>{{item.pinned ? room.t('Unpin') : room.t('Pin to the room')}}</q-item-section></q-item>
                    <q-item clickable v-close-popup @click="room.copyLink(item)">
                        <q-item-section avatar><q-icon name="sym_o_link"></q-icon></q-item-section><q-item-section>{{room.t('Copy link')}}</q-item-section></q-item>
                    <q-item clickable v-close-popup @click="room.copyText(item)">
                        <q-item-section avatar><q-icon name="sym_o_content_copy"></q-icon></q-item-section><q-item-section>{{room.t('Copy text')}}</q-item-section></q-item>
                    <q-item v-if="room.isMember && !room.sealed" clickable v-close-popup @click="room.openForward(item)">
                        <q-item-section avatar><q-icon name="sym_o_forward"></q-icon></q-item-section><q-item-section>{{room.t('Forward…')}}</q-item-section></q-item>
                    <q-item v-if="room.isMember && !inThread" clickable v-close-popup @click="room.markUnreadFrom(item)">
                        <q-item-section avatar><q-icon name="sym_o_mark_chat_unread"></q-icon></q-item-section><q-item-section>{{room.t('Mark unread from here')}}</q-item-section></q-item>
                    <q-separator></q-separator>
                    <!-- what an app adds to a message (ext-action slot chat-message-actions; IronStone: create a task, request or event) -->
                    <m-ext-actions v-if="!room.sealed" slot="chat-message-actions" :item="{ chatRoomId: room.roomId, eventSeq: item.eventSeq }"></m-ext-actions>
                    <q-item v-if="room.prefs.recordLink && !room.sealed" clickable v-close-popup @click="room.openFileOn(item)">
                        <q-item-section avatar><q-icon name="sym_o_link"></q-icon></q-item-section><q-item-section>{{room.t('File on a record…')}}</q-item-section></q-item>
                    <template v-if="room.canRedact(item)">
                        <q-separator></q-separator>
                        <q-item clickable v-close-popup @click="room.redact(item)">
                            <q-item-section avatar><q-icon name="sym_o_delete" color="negative"></q-icon></q-item-section>
                            <q-item-section class="text-negative">{{room.t('Delete message')}}</q-item-section></q-item>
                    </template>
                </q-list></q-menu>
            </q-btn>
        </q-card>
    </div>
</div>`;

// ---- a message of the outbox, not yet answered: Sending, Waiting, or Not sent with Retry and Delete ----
const pendingTemplate = `
<div class="row no-wrap q-pl-xs q-pr-sm q-mt-sm m-chat-pending" :data-pending="item.status" :data-client-ref="item.clientRef">
    <div style="width:46px;min-width:46px"></div>
    <div class="col text-body2" style="min-width:0">
        <div class="ellipsis-2-lines" :style="item.status === 'failed' ? '' : 'opacity:0.6'">{{item.text}}</div>
        <div class="row items-center no-wrap text-caption" :class="item.status === 'failed' ? 'text-negative' : 'm-muted'">
            <q-spinner v-if="item.status === 'sending'" size="12px" class="q-mr-xs"></q-spinner>
            <q-icon v-else :name="item.status === 'failed' ? 'sym_o_error' : 'sym_o_schedule'" size="14px" class="q-mr-xs"></q-icon>
            <span class="ellipsis">{{room.pendingText(item)}}</span>
            <template v-if="item.status === 'failed'">
                <q-btn v-if="!item.expired" flat dense no-caps size="sm" color="primary" :label="room.t('Retry')" class="q-ml-sm" @click="room.retryPending(item)"></q-btn>
                <q-btn flat dense no-caps size="sm" :label="room.t('Delete')" @click="room.discardPending(item)"></q-btn>
            </template>
        </div>
    </div>
</div>`;
const chatPending = { name: 'ChatPending', props: { item: Object, room: Object }, template: pendingTemplate };

// ---- a message being edited in place: Enter saves (as the composer sends), Esc cancels ----
const editTemplate = `
<div class="q-my-xs" @keydown.esc.stop="room.cancelEdit()">
    <m-rich-text ref="editor" v-model="body" :name="'chatEdit' + item.eventSeq" light rows="1" autofocus :enter="room.prefs.enterSends === false ? 'newline' : 'submit'"
            :mention-url="room.url('mentionUsers')" :mention-parameters="{chatRoomId: room.roomId}" @submit="save"></m-rich-text>
    <div class="row items-center q-gutter-x-sm q-mt-xs">
        <q-btn dense unelevated no-caps color="primary" size="sm" :label="room.t('Save')" :loading="busy" @click="save"></q-btn>
        <q-btn dense flat no-caps size="sm" :label="room.t('Cancel')" @click="room.cancelEdit()"></q-btn>
        <span class="text-caption m-muted">{{room.t('Esc to cancel')}}</span>
    </div>
</div>`;

// ---- the composer of the room or of a thread ----
const composerTemplate = `
<div class="m-chat-composer" @keydown.capture="onKeydown" @paste="onPaste">
    <div v-if="!threadRoot && room.replyTo" class="row items-center no-wrap q-pl-sm q-mb-xs text-caption rounded-borders">
        <div class="self-stretch bg-primary" style="width:3px;border-radius:2px"></div>
        <q-icon name="sym_o_reply" size="16px" class="q-mx-xs text-primary"></q-icon>
        <span class="ellipsis col">{{room.t('Replying to')}} <span class="text-weight-medium">{{room.replyTo.senderName}}</span>: {{room.replyTo.snippet}}</span>
        <q-btn flat round dense size="sm" icon="sym_o_close" :aria-label="room.t('Cancel the reply')" @click="room.cancelReply()"></q-btn>
    </div>
    <div v-if="files.length" class="row q-mb-xs">
        <q-chip v-for="file in files" :key="file.key" dense square removable class="m-tonal q-ml-none q-mr-xs" :icon="file.uploading ? undefined : room.fileIcon(file)"
                @remove="removeFile(file)"><q-spinner v-if="file.uploading" size="14px" class="q-mr-xs"></q-spinner>
            <span class="ellipsis" style="max-width:180px">{{file.fileName}}</span></q-chip>
    </div>
    <m-rich-text ref="editor" v-model="body" :name="'chatBody' + uid" light rows="1" :enter="room.prefs.enterSends === false ? 'newline' : 'submit'"
            :placeholder="placeholder" :mention-url="room.url('mentionUsers')" :mention-parameters="{chatRoomId: room.roomId}" @submit="send"></m-rich-text>
    <div class="row items-center no-wrap q-mt-xs">
        <q-btn flat round dense size="sm" icon="sym_o_attach_file" :aria-label="room.t('Attach files')" :disable="room.offline" @click="pickFiles">
            <q-tooltip>{{room.offline ? room.t('Files go up when you are back online') : room.t('Attach files')}}</q-tooltip></q-btn>
        <q-btn flat round dense size="sm" icon="sym_o_mood" :aria-label="room.t('Emoji')"><q-tooltip>{{room.t('Emoji')}}</q-tooltip>
            <q-menu anchor="top left" self="bottom left"><div class="q-pa-xs row" style="width:236px">
                <q-btn v-for="key in room.emoji" :key="key" flat dense size="sm" class="q-px-xs" :label="key" v-close-popup @click="insert(key)"></q-btn>
            </div></q-menu>
        </q-btn>
        <q-btn flat round dense size="sm" icon="sym_o_alternate_email" :aria-label="room.t('Mention someone')" @click="insert('@')"><q-tooltip>{{room.t('Mention someone')}}</q-tooltip></q-btn>
        <q-btn v-if="!room.sealed" flat round dense size="sm" icon="sym_o_ballot" :aria-label="room.t('Make a poll')" :disable="room.offline" @click="room.openPoll(threadRoot || null, '')">
            <q-tooltip>{{room.t('Make a poll')}}</q-tooltip></q-btn>
        <span class="text-caption m-muted q-ml-sm ellipsis gt-xs" v-if="!room.compact && !threadRoot">{{hint}}</span>
        <q-space></q-space>
        <q-btn dense unelevated no-caps color="primary" icon="sym_o_send" :label="room.compact ? undefined : room.t('Send')" :aria-label="room.t('Send')"
                :disable="!canSend" :loading="sending" @click="send"></q-btn>
    </div>
    <div class="hidden"><m-file ref="picker" v-model="picked" :name="'chatFile' + uid" multiple @update:model-value="onPicked"></m-file></div>
</div>`;

let composerCount = 0;
const chatComposer = {
    name: 'ChatComposer',
    props: { room: Object, threadRoot: [Number, String], placeholder: String },
    data() {
        composerCount += 1;
        return { uid: composerCount, body: '', files: [], picked: null, sending: false, draftTimer: null };
    },
    computed: {
        draftKey() { return draftPrefix() + this.room.roomId + (this.threadRoot ? ':' + this.threadRoot : ''); },
        uploading() { return this.files.some((file) => file.uploading); },
        canSend() { return !this.sending && !this.uploading && (!isEmptyHtml(this.body) || this.files.some((file) => file.chatAttachmentId)); },
        hint() {
            return this.room.prefs.enterSends === false ? t('Ctrl+Enter to send') : t('Enter to send, Shift+Enter for a new line');
        }
    },
    watch: {
        body(value) {
            if (!isEmptyHtml(value)) this.room.typingNow();
            clearTimeout(this.draftTimer);
            this.draftTimer = setTimeout(() => this.saveDraft(), 400);
        }
    },
    methods: {
        t,
        saveDraft() {
            const has = !isEmptyHtml(this.body);
            // an encrypted room's draft stays in this page, never in the browser's storage (C7)
            if (this.room.sealed) { sealedDrafts[this.draftKey] = has ? this.body : null; storage.set(this.draftKey, null); return; }
            storage.set(this.draftKey, has ? this.body : null);
            window.dispatchEvent(new CustomEvent('boss-chat-draft', { detail: { chatRoomId: this.room.roomId } }));
        },
        focus() {
            const editor = this.$refs.editor && this.$refs.editor.editor;
            if (editor) editor.commands.focus('end');
        },
        insert(text) {
            const editor = this.$refs.editor && this.$refs.editor.editor;
            if (editor) editor.chain().focus().insertContent(text).run();
            else this.body = (this.body || '') + text;
        },
        onKeydown(event) {
            if (event.isComposing) return;
            const editorVm = this.$refs.editor;
            const mentionOpen = editorVm && editorVm.mention && editorVm.mention.open;
            if (event.key === 'ArrowUp' && !event.shiftKey && !event.altKey && !event.ctrlKey && !event.metaKey && !mentionOpen && !this.threadRoot
                    && isEmptyHtml(this.body) && !this.files.length) {
                if (this.room.editLast()) { event.preventDefault(); event.stopPropagation(); }
            } else if (event.key === 'Escape' && !mentionOpen) {
                if (!this.threadRoot && this.room.replyTo) { this.room.cancelReply(); event.stopPropagation(); }
            }
        },
        send() {
            if (this.uploading) { moqui.notifyMessages([{ type: 'info', message: t('Wait for the files to finish uploading') }]); return; }
            if (!this.canSend) return;
            const text = plainOf(this.body);
            const command = /^\/(task|request|event|poll)\b\s*([\s\S]*)$/.exec(text);
            if (command && !this.files.length) {
                if (command[1] === 'poll') this.room.openPoll(this.threadRoot || null, command[2].trim());
                else this.room.quickCreateText(command[1], command[2].trim());
                this.clear();
                return;
            }
            const body = this.body;
            const ids = this.files.filter((file) => file.chatAttachmentId).map((file) => file.chatAttachmentId);
            const files = this.files;
            this.sending = true;
            this.clear();
            this.room.sendMessage({ body: isEmptyHtml(body) ? '' : body, attachmentIds: ids, files: files.filter((file) => file.chatAttachmentId),
                threadRoot: this.threadRoot || null }).then(() => {
                this.sending = false;
                this.$nextTick(() => this.focus());
            }, () => {
                // nothing sent: the text and files come back
                this.sending = false;
                this.body = body;
                this.files = files;
            });
        },
        clear() {
            this.body = '';
            this.files = [];
            storage.set(this.draftKey, null);
            sealedDrafts[this.draftKey] = null;
            window.dispatchEvent(new CustomEvent('boss-chat-draft', { detail: { chatRoomId: this.room.roomId } }));
            this.room.typingStop();
        },
        pickFiles() {
            const input = this.$refs.picker && this.$refs.picker.$el && this.$refs.picker.$el.querySelector('input[type=file]');
            if (input) input.click();
        },
        onPicked(files) {
            const list = Array.isArray(files) ? files : (files ? [files] : []);
            this.picked = null;
            if (list.length) this.upload(list);
        },
        onPaste(event) {
            const list = Array.from((event.clipboardData && event.clipboardData.files) || []);
            if (!list.length) return;
            event.preventDefault();
            this.upload(list);
        },
        // each file goes up at once (upload#ChatFiles); the message names them when it is sent. Not offline: a file waits
        // for no one, and the outbox keeps only text
        upload(list) {
            if (this.room.offline) { moqui.notifyMessages([{ type: 'info', message: t('Files go up when you are back online') }]); return; }
            list.forEach((file) => {
                const entry = { key: 'f' + Date.now() + Math.random(), fileName: file.name, contentType: file.type, fileSize: file.size, uploading: true, chatAttachmentId: null };
                this.files.push(entry);
                // an encrypted room's file goes up encrypted, named encrypted; its name, type and key go in the message (C7)
                const sealing = this.room.sealed ? moqui.chat.sealFile(file) : Promise.resolve(null);
                sealing.then((sealed) => {
                    if (sealed) entry.info = sealed.info;
                    const form = new FormData();
                    form.append('chatRoomId', this.room.roomId);
                    form.append('file', sealed ? sealed.blob : file, sealed ? 'encrypted' : file.name);
                    if (moqui.sessionToken) form.append('moquiSessionToken', moqui.sessionToken);
                    return moqui.request(this.room.url('upload'), { method: 'POST', params: form });
                }).then((result) => {
                    const json = result.json || {};
                    const stored = (json.uploadList || [])[0];
                    if (json.messageInfos && json.messageInfos.length) moqui.notifyMessages(json.messageInfos);
                    const index = this.files.indexOf(entry);
                    if (index < 0) return;
                    if (stored) this.files.splice(index, 1, Object.assign({}, entry, stored, this.room.sealed ? { fileName: entry.fileName, contentType: entry.contentType,
                        fileSize: entry.fileSize } : {}, { uploading: false }));
                    else this.files.splice(index, 1);
                }, (err) => {
                    const index = this.files.indexOf(entry);
                    if (index >= 0) this.files.splice(index, 1);
                    moqui.handleAjaxError(err);
                });
            });
        },
        removeFile(file) { this.files = this.files.filter((item) => item !== file); }
    },
    mounted() {
        const saved = this.room.sealed ? sealedDrafts[this.draftKey] : storage.get(this.draftKey);
        if (saved) this.body = saved;
        this.room.registerComposer(this, this.threadRoot);
    },
    beforeUnmount() {
        clearTimeout(this.draftTimer);
        this.saveDraft();
        this.room.unregisterComposer(this, this.threadRoot);
    },
    template: composerTemplate
};

const chatEdit = {
    name: 'ChatEdit',
    props: { room: Object, item: Object },
    data() { return { body: this.room.editing ? this.room.editing.body : '', busy: false }; },
    methods: {
        save() {
            if (this.busy) return;
            if (isEmptyHtml(this.body)) { moqui.notifyMessages([{ type: 'info', message: t('Delete the message to remove its text') }]); return; }
            this.busy = true;
            this.room.saveEdit(this.item, this.body).then(() => { this.busy = false; }, () => { this.busy = false; });
        }
    },
    template: editTemplate
};

const chatMessage = {
    name: 'ChatMessage',
    props: { item: Object, room: Object, inThread: Boolean },
    components: { 'chat-edit': chatEdit },
    template: messageTemplate
};

// ---- the room view: header, timeline, composer and the side pane (thread, members, pinned, search, record); the Chat screen
// and the tray's Chat tab (compact) both show it ----
const roomTemplate = `
<div class="column no-wrap relative-position" style="height:100%;min-height:0" @dragover.prevent="onDragOver" @dragleave.self="dragOver = false" @drop.prevent="onDrop">
    <div class="row items-center no-wrap q-px-sm q-py-xs" style="min-height:52px">
        <q-btn v-if="canGoBack" flat round dense icon="sym_o_arrow_back" :aria-label="t('Back')" class="q-mr-xs" @click="$emit('back')"><q-tooltip>{{t('Back')}}</q-tooltip></q-btn>
        <template v-if="room">
            <m-avatar v-if="isDirect && room.otherUserId" :name="displayName" :user-id="room.otherUserId" size="34px"></m-avatar>
            <q-avatar v-else size="34px" rounded class="m-tonal text-primary" :icon="roomIcon"></q-avatar>
            <div class="col q-ml-sm" style="min-width:0">
                <div class="row items-center no-wrap">
                    <span class="text-subtitle1 text-weight-medium ellipsis" :title="displayName">{{displayName}}</span>
                    <q-icon v-if="member && member.isPinned" name="sym_o_keep" size="14px" class="q-ml-xs m-muted"><q-tooltip>{{t('Pinned to the top of my rooms')}}</q-tooltip></q-icon>
                    <q-icon v-if="member && (member.isMuted || member.notificationLevelEnumId === 'CnlNone')" name="sym_o_notifications_off" size="14px" class="q-ml-xs m-muted">
                        <q-tooltip>{{t('Muted')}}</q-tooltip></q-icon>
                    <q-chip v-if="room.archivedDate" dense square class="m-tonal text-warning q-ml-xs">{{t('Archived')}}</q-chip>
                    <q-chip v-if="sealed" dense square icon="sym_o_lock" class="m-tonal text-positive q-ml-xs m-chat-encrypted">{{t('Encrypted')}}
                        <q-tooltip>{{t('End-to-end encrypted: only the devices of its members read it. Search, link previews, agents, polls, bridges, forwards and filing on records are off here.')}}</q-tooltip></q-chip>
                    <q-chip v-if="room.bridged" dense square icon="sym_o_hub" class="m-tonal text-info q-ml-xs m-chat-bridged">{{bridgeNames}}
                        <q-tooltip>{{bridgeTooltip}}</q-tooltip></q-chip>
                    <q-chip v-if="room.notConnected" dense square icon="sym_o_link_off" class="m-tonal text-warning q-ml-xs m-chat-not-connected">{{t('Not connected')}}
                        <q-tooltip>{{t('Messages stay here and go out once it is back')}}</q-tooltip></q-chip>
                </div>
                <div class="text-caption m-muted ellipsis">
                    <template v-if="isDirect && room.otherUserId"><span class="m-status-dot q-mr-xs" style="width:8px;height:8px" :class="'m-presence-' + (presenceOf(room.otherUserId) || 'offline')"></span>{{presenceText(room.otherUserId)}}</template>
                    <template v-else-if="room.record"><a v-if="room.record.url" href="#" class="text-primary" @click.prevent="go(room.record.url)">{{recordLabel}}</a><span v-else>{{recordLabel}}</span><span v-if="room.topic && room.topic !== recordLabel"> · {{room.topic}}</span></template>
                    <template v-else>{{room.topic || roomKindText}}</template>
                </div>
            </div>
            <div v-if="!isDirect && !narrow" class="row no-wrap items-center cursor-pointer q-mx-xs" @click="openSide('members')">
                <m-avatar v-for="person in members.slice(0, 4)" :key="person.userId || person.chatActorId" :name="person.name" :user-id="person.userId || undefined" size="24px" class="q-ml-xs"></m-avatar>
                <span class="text-caption m-muted q-ml-xs">{{members.length}}</span><q-tooltip>{{t('Members')}}</q-tooltip>
            </div>
            <q-btn v-if="access.canJoin" dense unelevated no-caps color="primary" :label="t('Join')" class="q-mx-xs" @click="join"></q-btn>
            <q-btn v-if="canCall" flat round dense icon="sym_o_call" :aria-label="t('Call')" @click="startCall"><q-tooltip>{{t('Call: everyone in the room rings')}}</q-tooltip></q-btn>
            <q-btn v-if="!narrow" flat round dense icon="sym_o_search" :aria-label="t('Search in the room')" @click="openSide('search')"><q-tooltip>{{t('Search in the room')}}</q-tooltip></q-btn>
            <q-btn v-if="!narrow" flat round dense icon="sym_o_keep" :aria-label="t('Pinned messages')" @click="openSide('pinned')"><q-tooltip>{{t('Pinned messages')}}</q-tooltip></q-btn>
            <q-btn v-if="!narrow" flat round dense icon="sym_o_forum" :aria-label="t('Threads')" @click="openSide('threads')"><q-tooltip>{{t('Threads')}}</q-tooltip></q-btn>
            <q-btn v-if="!narrow" flat round dense icon="sym_o_folder" :aria-label="t('Files')" @click="openSide('files')"><q-tooltip>{{t('Files')}}</q-tooltip></q-btn>
            <q-btn v-if="compact" flat round dense icon="sym_o_open_in_new" :aria-label="t('Open in Chat')" @click="openInChat"><q-tooltip>{{t('Open in Chat')}}</q-tooltip></q-btn>
            <q-btn flat round dense icon="sym_o_more_vert" :aria-label="t('Room')"><q-tooltip>{{t('Room')}}</q-tooltip>
                <q-menu anchor="bottom right" self="top right"><q-list dense style="min-width:250px">
                    <template v-if="isMember">
                        <q-item-label header class="q-py-xs">{{t('Notify me of')}}</q-item-label>
                        <q-item v-for="level in levels" :key="level.value" clickable v-close-popup :active="(member && member.notificationLevelEnumId || 'CnlAll') === level.value" @click="setLevel(level.value)">
                            <q-item-section avatar><q-icon :name="level.icon"></q-icon></q-item-section><q-item-section>{{t(level.label)}}</q-item-section></q-item>
                        <q-item clickable v-close-popup @click="toggleMute">
                            <q-item-section avatar><q-icon :name="member && member.isMuted ? 'sym_o_volume_up' : 'sym_o_volume_off'"></q-icon></q-item-section>
                            <q-item-section>{{member && member.isMuted ? t('Unmute') : t('Mute')}}</q-item-section></q-item>
                        <q-item clickable v-close-popup @click="togglePin">
                            <q-item-section avatar><q-icon name="sym_o_keep"></q-icon></q-item-section>
                            <q-item-section>{{member && member.isPinned ? t('Unpin from my rooms') : t('Pin to the top of my rooms')}}</q-item-section></q-item>
                        <q-item clickable v-close-popup @click="markRead(true)">
                            <q-item-section avatar><q-icon name="sym_o_done_all"></q-icon></q-item-section><q-item-section>{{t('Mark as read')}}</q-item-section></q-item>
                        <q-separator></q-separator>
                    </template>
                    <q-item v-if="!isDirect" clickable v-close-popup @click="openSide('members')">
                        <q-item-section avatar><q-icon name="sym_o_group"></q-icon></q-item-section><q-item-section>{{t('Members')}}</q-item-section></q-item>
                    <q-item v-if="narrow" clickable v-close-popup @click="openSide('pinned')">
                        <q-item-section avatar><q-icon name="sym_o_keep"></q-icon></q-item-section><q-item-section>{{t('Pinned messages')}}</q-item-section></q-item>
                    <q-item v-if="narrow" clickable v-close-popup @click="openSide('search')">
                        <q-item-section avatar><q-icon name="sym_o_search"></q-icon></q-item-section><q-item-section>{{t('Search in the room')}}</q-item-section></q-item>
                    <q-item v-if="narrow" clickable v-close-popup @click="openSide('threads')">
                        <q-item-section avatar><q-icon name="sym_o_forum"></q-icon></q-item-section><q-item-section>{{t('Threads')}}</q-item-section></q-item>
                    <q-item v-if="narrow" clickable v-close-popup @click="openSide('files')">
                        <q-item-section avatar><q-icon name="sym_o_folder"></q-icon></q-item-section><q-item-section>{{t('Files')}}</q-item-section></q-item>
                    <q-item v-if="room.record" clickable v-close-popup @click="openSide('record')">
                        <q-item-section avatar><q-icon :name="room.record.icon || 'sym_o_description'"></q-icon></q-item-section><q-item-section>{{t('The record')}}</q-item-section></q-item>
                    <q-item v-if="canModerate" clickable v-close-popup @click="openSettings">
                        <q-item-section avatar><q-icon name="sym_o_settings"></q-icon></q-item-section><q-item-section>{{t('Room settings')}}</q-item-section></q-item>
                    <template v-if="isMember">
                        <q-separator></q-separator>
                        <q-item clickable v-close-popup @click="leave">
                            <q-item-section avatar><q-icon name="sym_o_logout" color="negative"></q-icon></q-item-section>
                            <q-item-section class="text-negative">{{isDirect ? t('Hide this conversation') : t('Leave the room')}}</q-item-section></q-item>
                    </template>
                </q-list></q-menu>
            </q-btn>
        </template>
    </div>
    <q-separator></q-separator>

    <div class="col row no-wrap" style="min-height:0">
        <!-- the timeline and the composer -->
        <div v-show="!sideOverlay || !side" class="col column no-wrap" style="min-width:0">
            <div v-if="state === 'loading'" class="col q-pa-md">
                <div v-for="n in 6" :key="n" class="row no-wrap q-gutter-x-sm q-mb-md">
                    <q-skeleton type="QAvatar" size="32px"></q-skeleton>
                    <div class="col"><q-skeleton type="text" width="30%"></q-skeleton><q-skeleton type="text"></q-skeleton></div>
                </div>
            </div>
            <div v-else-if="state === 'missing'" class="col column items-center justify-center q-pa-lg text-center m-muted">
                <q-icon name="sym_o_lock" size="48px"></q-icon>
                <div class="text-subtitle2 q-mt-sm">{{t('This conversation is not available')}}</div>
                <div class="text-caption">{{t('It does not exist, or you are not in it.')}}</div>
            </div>
            <template v-else>
                <div class="col relative-position" style="min-height:0">
                    <div ref="scroller" class="absolute-full scroll q-pb-xs" @scroll="onScroll" @wheel.passive="anchor = null" @touchstart.passive="anchor = null">
                        <div v-if="hasMoreBefore" class="text-center q-py-sm">
                            <q-btn flat dense no-caps size="sm" color="primary" :loading="loadingOlder" :label="t('Earlier messages')" @click="loadOlder"></q-btn></div>
                        <div v-else class="q-px-md q-pt-lg q-pb-sm">
                            <m-avatar v-if="isDirect && room.otherUserId" :name="displayName" :user-id="room.otherUserId" size="48px"></m-avatar>
                            <q-avatar v-else size="48px" rounded class="m-tonal text-primary" :icon="roomIcon"></q-avatar>
                            <div class="text-subtitle1 text-weight-medium q-mt-sm">{{displayName}}</div>
                            <div class="text-caption m-muted">{{startText}}</div>
                        </div>
                        <template v-for="item in items" :key="item.key">
                            <div v-if="item.kind === 'day'" class="row items-center no-wrap q-my-sm q-px-sm">
                                <q-separator class="col"></q-separator><span class="text-caption text-weight-medium m-muted q-px-sm">{{item.label}}</span><q-separator class="col"></q-separator></div>
                            <div v-else-if="item.kind === 'unread'" :id="domId('unread', false)" class="row items-center no-wrap q-my-xs q-px-sm text-negative">
                                <q-separator class="col" color="negative"></q-separator><span class="text-caption text-weight-medium q-px-sm">{{t('New messages')}}</span></div>
                            <div v-else-if="item.kind === 'system'" class="text-center text-caption m-muted q-py-xs q-px-md" :class="item.target ? 'cursor-pointer' : ''"
                                    :id="domId(item.eventSeq, false)" @click="item.target ? jumpTo(item.target) : null">
                                <q-icon :name="item.icon" size="14px" class="q-mr-xs"></q-icon>{{item.text}} · {{item.time}}</div>
                            <chat-message v-else :item="item" :room="self"></chat-message>
                        </template>
                        <chat-pending v-for="pending in pendingMain" :key="pending.clientRef" :item="pending" :room="self"></chat-pending>
                    </div>
                    <q-btn v-if="!atBottom || hasMoreAfter" round unelevated size="sm" color="primary" icon="sym_o_arrow_downward" class="absolute"
                            style="right:16px;bottom:10px" :aria-label="t('Jump to the latest')" @click="jumpToLatest">
                        <q-badge v-if="newBelow" floating rounded color="negative">{{newBelow}}</q-badge><q-tooltip>{{t('Jump to the latest')}}</q-tooltip></q-btn>
                    <div v-if="dragOver && canPost" class="absolute-full q-pa-sm" style="z-index:3">
                        <q-card flat bordered class="full-height column items-center justify-center text-primary text-subtitle1" style="border-style:dashed;border-width:2px">
                            <q-icon name="sym_o_upload_file" size="40px"></q-icon>{{t('Drop the files to send them')}}</q-card></div>
                </div>
                <div class="q-px-md text-caption m-muted ellipsis" style="min-height:20px">{{typingText}}</div>
                <div class="q-px-sm q-pb-sm">
                    <q-banner v-if="offline && access.canPost" dense rounded class="text-caption m-tonal q-mb-xs m-chat-offline"><template v-slot:avatar><q-icon name="sym_o_cloud_off" color="warning"></q-icon></template>
                        {{t('You are offline. Messages wait here and go when you are back; files wait for the connection.')}}</q-banner>
                    <q-banner v-if="access.isArchived" dense rounded class="text-caption m-muted"><template v-slot:avatar><q-icon name="sym_o_archive"></q-icon></template>
                        {{t('This room is archived: it is read only.')}}</q-banner>
                    <q-banner v-else-if="access.canJoin" dense rounded class="text-caption"><template v-slot:avatar><q-icon name="sym_o_visibility" color="info"></q-icon></template>
                        {{t('You are reading this room. Join it to post and to hear of its messages.')}}
                        <template v-slot:action><q-btn dense unelevated no-caps color="primary" :label="t('Join')" @click="join"></q-btn></template></q-banner>
                    <chat-composer v-else-if="access.canPost" :room="self" :placeholder="composerPlaceholder"></chat-composer>
                </div>
            </template>
        </div>

        <!-- the side pane: a thread, the members, the pinned messages, search in the room, the record -->
        <q-separator v-if="side && !sideOverlay" vertical></q-separator>
        <div v-if="side" class="column no-wrap" :class="sideOverlay ? 'col' : ''" :style="sideOverlay ? 'min-width:0' : 'width:360px;min-width:360px'">
            <div class="row items-center no-wrap q-px-sm" style="min-height:44px">
                <q-btn v-if="sideOverlay" flat round dense icon="sym_o_arrow_back" :aria-label="t('Back')" @click="closeSide"></q-btn>
                <div class="text-subtitle2 q-ml-xs col ellipsis">{{sideTitle}}</div>
                <q-btn v-if="!sideOverlay" flat round dense icon="sym_o_close" :aria-label="t('Close')" @click="closeSide"><q-tooltip>{{t('Close')}} (Esc)</q-tooltip></q-btn>
            </div>
            <q-separator></q-separator>

            <template v-if="side === 'thread'">
                <div ref="threadScroller" class="col scroll q-pb-sm" style="min-height:0">
                    <q-linear-progress v-if="threadView.loading" indeterminate color="primary"></q-linear-progress>
                    <template v-for="(item, index) in threadItems" :key="item.key">
                        <div v-if="item.kind === 'day'" class="row items-center no-wrap q-my-sm q-px-sm">
                            <q-separator class="col"></q-separator><span class="text-caption m-muted q-px-sm">{{item.label}}</span><q-separator class="col"></q-separator></div>
                        <template v-else-if="item.kind === 'message'">
                            <chat-message :item="item" :room="self" in-thread></chat-message>
                            <div v-if="item.eventSeq === threadView.rootSeq" class="row items-center no-wrap q-my-xs q-px-md text-caption m-muted">
                                <span>{{repliesText(threadItems.filter((row) => row.kind === 'message').length - 1)}}</span><q-separator class="col q-ml-sm"></q-separator></div>
                        </template>
                    </template>
                    <chat-pending v-for="pending in pendingThread" :key="pending.clientRef" :item="pending" :room="self"></chat-pending>
                </div>
                <div v-if="access.canPost" class="q-px-sm q-pb-sm"><chat-composer :room="self" :thread-root="threadView.rootSeq" :placeholder="t('Reply in the thread…')"></chat-composer></div>
            </template>

            <div v-else-if="side === 'threads'" class="col column no-wrap" style="min-height:0">
                <div class="row q-px-sm q-py-xs">
                    <q-chip v-for="chip in threadChips" :key="String(chip.value)" dense clickable :outline="threadsPane.mine !== chip.value" :color="threadsPane.mine === chip.value ? 'primary' : undefined"
                            :text-color="threadsPane.mine === chip.value ? 'white' : undefined" class="q-ml-none q-mr-xs" :data-threads="chip.value ? 'mine' : 'all'"
                            @click="threadsPane.mine = chip.value; loadThreads(false)">{{chip.label}}</q-chip>
                </div>
                <div class="col scroll" style="min-height:0">
                    <q-linear-progress v-if="threadsPane.loading" indeterminate color="primary"></q-linear-progress>
                    <q-list dense separator>
                        <q-item v-for="thread in threadsPane.list" :key="thread.eventSeq" clickable :data-thread="thread.eventSeq" @click="openThread(thread.eventSeq)">
                            <q-item-section avatar top><m-avatar :name="nameOf(thread.senderUserId, thread.senderName)" :user-id="thread.senderUserId || undefined" size="28px"></m-avatar></q-item-section>
                            <q-item-section>
                                <q-item-label class="text-weight-medium">{{nameOf(thread.senderUserId, thread.senderName)}}<span class="text-caption m-muted"> · {{shortWhen(thread.sentDate)}}</span></q-item-label>
                                <q-item-label caption class="ellipsis-2-lines">{{thread.redacted ? t('Message removed') : thread.snippet}}</q-item-label>
                                <q-item-label caption><span class="text-primary text-weight-medium">{{repliesText(thread.threadReplyCount)}}</span> · {{lastReplyText(thread)}}</q-item-label>
                            </q-item-section>
                        </q-item>
                        <q-item v-if="!threadsPane.loading && !threadsPane.list.length"><q-item-section class="m-muted text-caption">{{t('No threads yet. Reply in a thread from a message to start one.')}}</q-item-section></q-item>
                    </q-list>
                    <div v-if="threadsPane.hasMore" class="text-center q-py-sm">
                        <q-btn flat dense no-caps size="sm" color="primary" :label="t('More threads')" :loading="threadsPane.loading" @click="loadThreads(true)"></q-btn></div>
                </div>
            </div>

            <div v-else-if="side === 'files'" class="col column no-wrap" style="min-height:0">
                <div class="row q-px-sm q-py-xs">
                    <q-chip v-for="chip in fileChips" :key="chip.value" dense clickable :outline="filesPane.kind !== chip.value" :color="filesPane.kind === chip.value ? 'primary' : undefined"
                            :text-color="filesPane.kind === chip.value ? 'white' : undefined" class="q-ml-none q-mr-xs" :data-files="chip.value"
                            @click="filesPane.kind = chip.value; loadFiles(false)">{{chip.label}}</q-chip>
                </div>
                <div class="col scroll" style="min-height:0">
                    <q-linear-progress v-if="filesPane.loading" indeterminate color="primary"></q-linear-progress>
                    <div v-if="filesPane.kind === 'images'" class="row q-col-gutter-xs q-pa-xs">
                        <div v-for="file in filesPane.list" :key="file.chatAttachmentId" class="col-4">
                            <q-img :src="fileUrl(file, true)" :ratio="1" class="rounded-borders cursor-pointer" :alt="file.fileName" @click="preview(file)"><q-tooltip>{{file.fileName}}</q-tooltip></q-img>
                        </div>
                    </div>
                    <q-list v-else dense separator>
                        <q-item v-for="file in filesPane.list" :key="file.chatAttachmentId" :data-file="file.chatAttachmentId">
                            <q-item-section avatar>
                                <q-img v-if="isImage(file)" :src="fileUrl(file, true)" :ratio="1" width="40px" class="rounded-borders cursor-pointer" :alt="file.fileName" @click="preview(file)"></q-img>
                                <q-avatar v-else size="40px" rounded class="m-tonal text-primary" :icon="fileIcon(file)"></q-avatar>
                            </q-item-section>
                            <q-item-section style="min-width:0"><q-item-label class="ellipsis">{{file.fileName}}</q-item-label>
                                <q-item-label caption class="ellipsis">{{sizeText(file.fileSize)}} · {{nameOf(file.senderUserId, file.senderName)}} · {{shortWhen(file.sentDate)}}</q-item-label></q-item-section>
                            <q-item-section side><div class="row no-wrap">
                                <q-btn flat round dense size="sm" icon="sym_o_download" :aria-label="t('Download')" @click="download(file)"><q-tooltip>{{t('Download')}}</q-tooltip></q-btn>
                                <q-btn flat round dense size="sm" icon="sym_o_chat" :aria-label="t('Show in chat')" @click="showFileInChat(file)"><q-tooltip>{{t('Show in chat')}}</q-tooltip></q-btn>
                            </div></q-item-section>
                        </q-item>
                    </q-list>
                    <div v-if="!filesPane.loading && !filesPane.list.length" class="q-pa-md m-muted text-caption">
                        {{filesPane.kind === 'images' ? t('No pictures yet.') : t('No files yet. The files sent in the room are listed here.')}}</div>
                    <div v-if="filesPane.next" class="text-center q-py-sm">
                        <q-btn flat dense no-caps size="sm" color="primary" :label="t('More files')" :loading="filesPane.loading" @click="loadFiles(true)"></q-btn></div>
                </div>
            </div>

            <div v-else-if="side === 'members'" class="col scroll" style="min-height:0">
                <div v-if="isMember && !isDirect && !access.isArchived" class="q-pa-sm row no-wrap items-end q-gutter-x-xs">
                    <div class="col"><m-drop-down v-model="addPeople.userIds" name="addUserIds" multiple server-search :options-url="url('searchUsers')" :label="t('Add people')"></m-drop-down></div>
                    <q-btn dense unelevated no-caps color="primary" :label="t('Add')" :loading="addPeople.busy" :disable="!addPeople.userIds.length" @click="addMembers"></q-btn>
                </div>
                <q-list dense>
                    <q-item v-for="person in members" :key="person.userId || person.chatActorId">
                        <q-item-section avatar><m-avatar :name="person.name" :user-id="person.userId || undefined" size="32px"></m-avatar></q-item-section>
                        <q-item-section><q-item-label>{{person.name}}<span v-if="person.userId && person.userId === me.userId" class="m-muted"> ({{t('you')}})</span></q-item-label>
                            <q-item-label caption>{{person.external ? externalText(person) : presenceText(person.userId)}}</q-item-label></q-item-section>
                        <q-item-section side class="row no-wrap items-center">
                            <q-chip v-if="person.external" dense square icon="sym_o_hub" class="m-tonal text-info m-chat-external">{{person.networkName || t('Outside')}}</q-chip>
                            <q-chip v-if="person.roleEnumId === 'CmrOwner' && !isDirect" dense square class="m-tonal">{{t('Owner')}}</q-chip>
                            <q-chip v-else-if="person.roleEnumId === 'CmrModerator'" dense square class="m-tonal text-info">{{t('Moderator')}}</q-chip>
                            <q-btn v-if="canModerate && person.userId !== me.userId && (isOwner || person.roleEnumId !== 'CmrOwner')" flat round dense size="sm" icon="sym_o_more_vert" :aria-label="t('Member')">
                                <q-menu anchor="bottom right" self="top right"><q-list dense style="min-width:200px">
                                    <template v-if="!person.external">
                                        <q-item v-if="person.roleEnumId !== 'CmrModerator'" clickable v-close-popup @click="setRole(person, 'CmrModerator')"><q-item-section>{{t('Make a moderator')}}</q-item-section></q-item>
                                        <q-item v-if="person.roleEnumId !== 'CmrMember'" clickable v-close-popup @click="setRole(person, 'CmrMember')"><q-item-section>{{t('Make a member')}}</q-item-section></q-item>
                                        <q-item v-if="isOwner && person.roleEnumId !== 'CmrOwner'" clickable v-close-popup @click="setRole(person, 'CmrOwner')"><q-item-section>{{t('Make an owner')}}</q-item-section></q-item>
                                        <q-separator></q-separator>
                                    </template>
                                    <q-item clickable v-close-popup @click="removeMember(person)"><q-item-section class="text-negative">{{t('Take out of the room')}}</q-item-section></q-item>
                                </q-list></q-menu>
                            </q-btn>
                        </q-item-section>
                    </q-item>
                </q-list>
            </div>

            <div v-else-if="side === 'pinned'" class="col scroll" style="min-height:0">
                <q-linear-progress v-if="pinned.loading" indeterminate color="primary"></q-linear-progress>
                <q-list dense separator>
                    <q-item v-for="event in pinned.list" :key="event.eventSeq" clickable @click="jumpTo(event.eventSeq)">
                        <q-item-section avatar top><m-avatar :name="nameOf(event.senderUserId, event.senderName)" :user-id="event.senderUserId || undefined" size="28px"></m-avatar></q-item-section>
                        <q-item-section><q-item-label class="text-weight-medium">{{nameOf(event.senderUserId, event.senderName)}}
                                <span class="text-caption m-muted"> · {{shortWhen(event.sentDate)}}</span></q-item-label>
                            <q-item-label caption class="ellipsis-3-lines">{{event.bodyText || filesText(event)}}</q-item-label></q-item-section>
                        <q-item-section v-if="canPost" side top><q-btn flat round dense size="sm" icon="sym_o_keep_off" :aria-label="t('Unpin')" @click.stop="pin({eventSeq: event.eventSeq, event: event}, false)">
                            <q-tooltip>{{t('Unpin')}}</q-tooltip></q-btn></q-item-section>
                    </q-item>
                    <q-item v-if="!pinned.loading && !pinned.list.length"><q-item-section class="m-muted text-caption">{{t('No pinned messages. Pin one from its menu to keep it here.')}}</q-item-section></q-item>
                </q-list>
            </div>

            <div v-else-if="side === 'search'" class="col column no-wrap" style="min-height:0">
                <div class="q-pa-sm row no-wrap items-center" @keydown.enter.prevent="runSearch">
                    <div class="col"><m-text-line v-model="searchPane.text" :name="'roomSearch' + uid" :label="t('Search this room')"></m-text-line></div>
                    <q-btn flat round dense icon="sym_o_search" :aria-label="t('Search')" @click="runSearch"></q-btn>
                </div>
                <div class="col scroll" style="min-height:0">
                    <q-linear-progress v-if="searchPane.loading" indeterminate color="primary"></q-linear-progress>
                    <q-list dense separator>
                        <q-item v-for="hit in searchPane.results" :key="hit.eventSeq" clickable @click="jumpTo(hit.eventSeq)">
                            <q-item-section><q-item-label class="text-weight-medium">{{hit.senderName}} <span class="text-caption m-muted"> · {{shortWhen(hit.sentDate)}}</span></q-item-label>
                                <q-item-label caption class="ellipsis-3-lines">{{hit.snippet}}</q-item-label></q-item-section>
                        </q-item>
                        <q-item v-if="searchPane.searched && !searchPane.loading && !searchPane.results.length"><q-item-section class="m-muted text-caption">{{t('No messages match')}}</q-item-section></q-item>
                    </q-list>
                </div>
            </div>

            <div v-else-if="side === 'record' && room && room.record" class="col scroll q-pa-sm" style="min-height:0">
                <m-record-card :record-entity="room.record.entity" :record-id="room.record.id" :card-url="url('recordCard')"></m-record-card>
                <q-btn v-if="room.record.url" unelevated no-caps color="primary" icon="sym_o_open_in_new" :label="t('Open the record')" class="q-mt-sm" @click="go(room.record.url)"></q-btn>
                <div class="text-caption m-muted q-mt-sm">{{t('Everyone who can see this record can read this room and join it.')}}</div>
            </div>
        </div>
    </div>

    <!-- RoomSettings: name and topic (moderators), who may join and the archive (owners) -->
    <m-dialog v-model="settings.open" :title="t('Room settings')" width="560">
        <m-text-line v-model="settings.roomName" :name="'settingsName' + uid" :label="t('Name')"></m-text-line>
        <m-text-area v-model="settings.topic" :name="'settingsTopic' + uid" rows="2" :label="t('Topic')" class="q-mt-xs"></m-text-area>
        <template v-if="isOwner">
            <m-drop-down v-model="settings.visibility" :name="'settingsVisibility' + uid" :options="visibilityOptions" :label="t('Who may join')" class="q-mt-xs"></m-drop-down>
        </template>
        <div v-if="sealed" class="q-mt-sm q-pa-sm rounded-borders m-tonal text-body2 m-chat-encrypted-note"><q-icon name="sym_o_lock" class="q-mr-xs"></q-icon>{{t('Messages here are end-to-end encrypted, and that cannot be turned off. Only the devices of its members read them; the server keeps ciphertext. So this room has no server search, link previews, agents, polls, bridges, forwards or filing on records, and the terminal cannot read it. A new device reads older messages only from your key backup (Settings, My devices) or from another of your devices.')}}</div>
        <template v-if="sealed">
            <q-toggle v-model="settings.verifiedOnly" :label="t('Messages only to verified devices')" class="q-mt-sm m-chat-room-verified-only"></q-toggle>
            <div class="text-caption m-muted">{{t("Each member's browser encrypts for the devices that were verified (by emoji or QR code, or by their owner's cross-signing) only; a device that is not verified cannot read what follows.")}}</div>
        </template>
        <q-toggle v-model="settings.callE2ee" :label="t('Calls in this room are end-to-end encrypted')" class="q-mt-sm"></q-toggle>
        <div class="text-caption m-muted">{{t('Only the people in a call hear and see it: no recording, captions, phones or guests. This is apart from the encryption of the messages.')}}</div>
        <div class="row q-gutter-sm q-mt-md items-center">
            <q-btn unelevated no-caps color="primary" :label="t('Save')" :loading="settings.busy" @click="saveSettings"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
            <q-space></q-space>
            <q-btn v-if="isOwner" unelevated no-caps class="m-btn-tonal text-negative" :icon="room && room.archivedDate ? 'sym_o_unarchive' : 'sym_o_archive'"
                    :label="room && room.archivedDate ? t('Take out of the archive') : t('Archive the room')" @click="setArchived(!(room && room.archivedDate))"></q-btn>
        </div>
    </m-dialog>

    <!-- LinkToRecord: a message filed on a record, whose Chatter shows it -->
    <m-dialog v-model="fileOn.open" :title="t('File on a record')" width="520">
        <div v-if="fileOn.item" class="text-caption m-muted ellipsis-2-lines q-mb-sm">{{fileOn.item.senderName}}: {{snippetOf(fileOn.item.event)}}</div>
        <m-drop-down v-model="fileOn.value" :name="'fileOnRecord' + uid" server-search :server-min-length="2" :options-url="url('searchRecords')" :label="t('Record by id or name')"></m-drop-down>
        <div class="row q-gutter-sm q-mt-md">
            <q-btn unelevated no-caps color="primary" :label="t('File')" :disable="!fileOn.value" :loading="fileOn.busy" @click="fileOnRecord"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
        </div>
    </m-dialog>

    <!-- a picture, shown here -->
    <m-dialog v-model="previewBox.open" :title="previewBox.name" width="900">
        <div class="text-center"><img v-if="previewBox.src" :src="previewBox.src" :alt="previewBox.name" style="max-width:100%;max-height:70vh"></div>
        <div class="row q-mt-sm"><q-space></q-space>
            <q-btn v-if="previewBox.file && previewBox.file.eventSeq" flat dense no-caps color="primary" icon="sym_o_chat" :label="t('Show in chat')"
                    @click="previewBox.open = false; showFileInChat(previewBox.file)"></q-btn>
            <q-btn flat dense no-caps color="primary" icon="sym_o_download" :label="t('Download')" @click="downloadUrl(previewBox.download, previewBox.name)"></q-btn></div>
    </m-dialog>

    <!-- Forward: a message to another of my rooms, with a comment; the server quotes it -->
    <m-dialog v-model="forward.open" :title="t('Forward')" width="520">
        <div v-if="forward.item" class="row no-wrap q-mb-sm text-caption">
            <div class="self-stretch bg-grey-5" style="width:3px;border-radius:2px"></div>
            <div class="q-pl-sm ellipsis-3-lines"><span class="text-weight-medium">{{forward.item.senderName}}:</span> {{snippetOf(forward.item.event)}}</div>
        </div>
        <m-drop-down v-model="forward.roomId" :name="'forwardRoom' + uid" server-search :server-min-length="0" options-load-init :options-url="url('forwardRooms')"
                :label="t('To')"></m-drop-down>
        <m-text-area v-model="forward.comment" :name="'forwardComment' + uid" rows="2" :label="t('Add a comment (optional)')" class="q-mt-xs"></m-text-area>
        <div class="row q-gutter-sm q-mt-md">
            <q-btn unelevated no-caps color="primary" icon="sym_o_forward" :label="t('Forward')" :disable="!forward.roomId" :loading="forward.busy" @click="sendForward"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
        </div>
    </m-dialog>

    <!-- NewPoll: a question, 2 to 10 options, more than one choice, anonymous, and when it closes -->
    <m-dialog v-model="pollBox.open" :title="t('New poll')" width="520">
        <m-text-line v-model="pollBox.question" :name="'pollQuestion' + uid" :label="t('Question')" required></m-text-line>
        <div v-for="(option, index) in pollBox.options" :key="index" class="row no-wrap items-center q-mt-xs">
            <div class="col"><m-text-line v-model="pollBox.options[index]" :name="'pollOption' + uid + '_' + index" :label="optionLabel(index)"></m-text-line></div>
            <q-btn v-if="pollBox.options.length > 2" flat round dense size="sm" icon="sym_o_close" :aria-label="t('Remove the option')" @click="pollBox.options.splice(index, 1)"></q-btn>
        </div>
        <q-btn v-if="pollBox.options.length < 10" flat dense no-caps color="primary" icon="sym_o_add" :label="t('Add an option')" class="q-mt-xs" @click="pollBox.options.push('')"></q-btn>
        <div class="column q-mt-sm q-gutter-y-xs">
            <m-check v-model="pollBox.multiple" :name="'pollMultiple' + uid" toggle true-value="Y" false-value="N" :single-label="t('People may choose more than one')"></m-check>
            <m-check v-model="pollBox.anonymous" :name="'pollAnonymous' + uid" toggle true-value="Y" false-value="N" :single-label="t('Anonymous: no one sees who voted for what')"></m-check>
        </div>
        <m-date-time v-model="pollBox.closes" :name="'pollCloses' + uid" :label="t('Closes (optional)')" class="q-mt-sm"></m-date-time>
        <div class="row q-gutter-sm q-mt-md">
            <q-btn unelevated no-caps color="primary" icon="sym_o_ballot" :label="t('Post the poll')" :disable="!canMakePoll" :loading="pollBox.busy" @click="createPoll"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" v-close-popup></q-btn>
        </div>
    </m-dialog>
</div>`;

let roomCount = 0;
const chatRoom = {
    name: 'ChatRoom',
    props: { base: String, roomId: String, me: Object, prefs: { type: Object, default: () => ({}) }, seq: [Number, String], thread: [Number, String],
        compact: Boolean, canGoBack: Boolean, linkBase: { type: String, default: '/qapps/BasicComms/Chat' } },
    emits: ['back', 'thread', 'changed', 'left', 'open-room', 'read'],
    components: { 'chat-message': chatMessage, 'chat-composer': chatComposer, 'chat-pending': chatPending },
    data() {
        roomCount += 1;
        return {
            uid: roomCount, state: 'loading', room: null, member: null, access: {}, members: [], names: {},
            events: [], hasMoreBefore: false, hasMoreAfter: false, loadingOlder: false, loadingNewer: false,
            myLastRead: 0, dividerSeq: null, highlightSeq: null, atBottom: true, newBelow: 0, holdRead: false,
            hoverKey: null, tapKey: null, editing: null, replyTo: null, side: null,
            threadView: { rootSeq: null, events: [], loading: false }, pinned: { list: [], loading: false },
            threadsPane: { list: [], loading: false, hasMore: false, mine: false }, filesPane: { list: [], loading: false, next: null, kind: 'all' },
            forward: { open: false, item: null, roomId: null, comment: '', busy: false },
            pollBox: { open: false, threadRoot: null, question: '', options: ['', ''], multiple: 'N', anonymous: 'N', closes: '', busy: false },
            searchPane: { text: '', results: [], loading: false, searched: false }, addPeople: { userIds: [], busy: false },
            settings: { open: false, roomName: '', topic: '', visibility: '', busy: false }, previewBox: { open: false, src: '', name: '', download: '', file: null },
            tick: Date.now(), width: 0, dragOver: false, anchor: null,
            fileOn: { open: false, item: null, value: null, busy: false },
            quickReactions: QUICK_REACTIONS, emoji: EMOJI, levels: LEVELS
        };
    },
    computed: {
        self() { return this; },
        isDirect() { return !!this.room && this.room.roomTypeEnumId === 'CrtDirect'; },
        // an end-to-end encrypted room (C7): its messages are encrypted and decrypted in this browser
        sealed() { return !!this.room && !!this.room.encrypted; },
        // a call from the room, where the server holds calls (config.calls) and the user may post in it
        canCall() { return !!(moqui.call && moqui.config && moqui.config.calls && this.access && this.access.canPost && this.room && !this.room.archivedDate); },
        isMember() { return !!this.access.isMember; },
        canPost() { return !!this.access.canPost; },
        canModerate() { return !!this.access.canModerate; },
        isOwner() { return !!this.access.isOwner; },
        // a bridged room (C1): what its bridges carry (an edit, a delete or a reaction one of them cannot carry is not offered)
        bridgeCaps() { return (this.room && this.room.bridgeCapabilities) || { edit: true, delete: true, reaction: true }; },
        bridgeNames() {
            const names = ((this.room && this.room.bridges) || []).map((bridge) => bridge.networkName || bridge.name).filter((name) => name);
            return Array.from(new Set(names)).join(', ');
        },
        bridgeTooltip() { return fill(t('Messages here also go to {names}'), { names: this.bridgeNames }); },
        displayName() { return this.room ? (this.room.displayName || this.room.roomName || this.room.chatRoomId) : ''; },
        roomIcon() { return this.room ? ((this.room.record && this.room.record.icon) || ROOM_ICONS[this.room.roomTypeEnumId] || 'sym_o_chat') : 'sym_o_chat'; },
        recordLabel() { const record = this.room && this.room.record; return record ? [record.typeLabel, record.title].filter((part) => part).join(' · ') : ''; },
        roomKindText() {
            if (!this.room) return '';
            const type = this.room.roomTypeEnumId;
            if (type === 'CrtPublic') return t('Public room');
            if (type === 'CrtPrivate') return t('Private room');
            if (type === 'CrtRecord') return t('Record room');
            return fill(t('Group message with {count} people'), { count: this.members.length });
        },
        startText() {
            if (!this.room) return '';
            if (this.isDirect) return this.room.otherUserId ? fill(t('This is the start of your conversation with {name}.'), { name: this.displayName })
                : t('This is the start of your group conversation.');
            if (this.room.record) return fill(t('This room is about {record}. Everyone who can see the record can read it.'), { record: this.recordLabel });
            return fill(t('This is the start of {name}.'), { name: this.displayName }) + (this.room.topic ? ' ' + this.room.topic : '');
        },
        narrow() { return this.compact || (this.width > 0 && this.width < 640); },
        sideOverlay() { return this.compact || (this.width > 0 && this.width < 900); },
        sideTitle() {
            return { thread: t('Thread'), members: fill(t('Members ({count})'), { count: this.members.length }), pinned: t('Pinned messages'),
                search: t('Search in the room'), record: t('The record'), threads: t('Threads'), files: t('Files') }[this.side] || '';
        },
        // the browser is offline: sends wait in the outbox, files and polls wait for the connection
        offline() { return !!moqui.chat && moqui.chat.state.online === false; },
        // the outbox's messages of this room and of the open thread (the chat store's state, so they follow other tabs)
        pendingMain() { void (moqui.chat && moqui.chat.state.outbox && moqui.chat.state.sending); return moqui.chat && moqui.chat.pendingIn ? moqui.chat.pendingIn(this.roomId, null) : []; },
        pendingThread() {
            void (moqui.chat && moqui.chat.state.outbox && moqui.chat.state.sending);
            return moqui.chat && moqui.chat.pendingIn && this.threadView.rootSeq != null ? moqui.chat.pendingIn(this.roomId, this.threadView.rootSeq) : [];
        },
        threadChips() { return [{ value: false, label: t('All') }, { value: true, label: t('Mine') }]; },
        fileChips() { return [{ value: 'all', label: t('All') }, { value: 'images', label: t('Pictures') }]; },
        canMakePoll() {
            const options = this.pollBox.options.map((text) => String(text || '').trim()).filter((text) => text);
            return !!String(this.pollBox.question || '').trim() && options.length >= 2 && !this.pollBox.busy;
        },
        composerPlaceholder() { return fill(this.isDirect ? t('Message {name}') : t('Message {name}… @ to mention'), { name: this.displayName }); },
        visibilityOptions() {
            if (this.room && this.room.roomTypeEnumId === 'CrtRecord')
                return [{ value: 'CrvRecord', label: t('Anyone who can see the record') }, { value: 'CrvMembers', label: t('Members only: added by a member') }];
            return [{ value: 'CrvMembers', label: t('Members only: added by a member (private)') }, { value: 'CrvUsers', label: t('Anyone in the organization (public)') }];
        },
        readersBySeq() {
            const out = {};
            if (this.prefs.readReceipts === false || !this.events.length) return out;
            const me = this.me.userId;
            const seqs = this.events.filter((event) => event.type === 'message').map((event) => Number(event.eventSeq));
            for (const person of this.members) {
                if (!person.userId || person.userId === me || person.isAgent) continue;
                const read = Number(person.lastReadEventSeq || 0);
                if (!read) continue;
                let at = null;
                for (const seq of seqs) { if (seq <= read) at = seq; else break; }
                if (at == null) continue;
                (out[at] = out[at] || []).push({ userId: person.userId, name: person.name });
            }
            return out;
        },
        items() { return this.buildItems(this.events, { divider: true, readers: true }); },
        threadItems() { return this.buildItems(this.threadView.events, { divider: false, readers: false }); },
        typingText() {
            void this.tick;
            if (!moqui.chat || this.prefs.typing === false) return '';
            const ids = moqui.chat.typingIn(this.roomId).filter((id) => id !== this.me.userId);
            if (!ids.length) return '';
            const names = ids.map((id) => this.nameOf(id).split(' ')[0]);
            if (names.length === 1) return fill(t('{name} is typing…'), { name: names[0] });
            if (names.length === 2) return fill(t('{a} and {b} are typing…'), { a: names[0], b: names[1] });
            return t('Several people are typing…');
        }
    },
    watch: {
        seq(value) { if (value && this.state === 'ready') this.jumpTo(Number(value)); },
        thread(value) {
            if (this.state !== 'ready') return;
            if (value && Number(value) !== this.threadView.rootSeq) this.openThread(Number(value), true);
            else if (!value && this.side === 'thread') this.side = null;
        }
    },
    methods: {
        t,
        shortWhen,
        sizeText,
        isImage,
        fileIcon,
        url(name) { return this.base + '/' + name; },
        get(name, params) {
            return moqui.request(this.url(name), { params: params || {} }).then((result) => this.openPage(result.json || {}), (err) => { moqui.handleAjaxError(err); throw err; });
        },
        // the encrypted events of an answer (a timeline page, a room view) decrypted in place before they are shown (C7)
        openPage(json) {
            const lists = [json.eventList, json.timeline && json.timeline.eventList].filter((list) => Array.isArray(list) && list.length);
            if (!lists.length || !moqui.chat || !moqui.chat.openEvents) return json;
            const roomId = (json.room && json.room.chatRoomId) || this.roomId;
            return Promise.all(lists.map((list) => moqui.chat.openEvents(roomId, list, (file) => this.sealedUrl(file)))).then(() => json);
        },
        post(name, params) {
            return moqui.request(this.url(name), { method: 'POST', params: params || {} }).then((result) => {
                const json = result.json || {};
                if (json.messageInfos && json.messageInfos.length) moqui.notifyMessages(json.messageInfos, json.errors);
                return json;
            }, (err) => { moqui.handleAjaxError(err); throw err; });
        },
        // the members' userIds, who get an encrypted room's keys
        memberIds() { return this.members.filter((person) => person.userId).map((person) => person.userId); },
        // new room keys came (from a member, or the key backup): the messages that could not be read are tried again
        onRoomKeys() {
            if (!this.sealed || this.state !== 'ready') return;
            const lists = [this.events, this.threadView.events].filter((list) => list.some((item) => item.undecryptable || (item.encryptedReactions || []).length));
            lists.forEach((list) => moqui.chat.openEvents(this.roomId, list.filter((item) => item.undecryptable), (file) => this.sealedUrl(file)));
        },
        // the room's call: a new one rings its members; one going on is joined (the page's call store, WebrootCall.js)
        startCall() {
            if (moqui.call) moqui.call.startCall({ chatRoomId: this.roomId, video: true });
        },
        go(target) { if (target) this.$root.setUrl(target); },
        domId(seq, inThread) { return 'chat-' + this.uid + (inThread ? '-t-' : '-m-') + seq; },
        nameOf(userId, fallback) {
            if (!userId) return fallback || t('Someone');
            if (this.names[userId]) return this.names[userId];
            const person = this.members.find((item) => item.userId === userId);
            return (person && person.name) || fallback || userId;
        },
        mergeNames(map) { if (map) Object.keys(map).forEach((id) => { if (map[id]) this.names[id] = map[id]; }); },
        presenceOf(userId) { return moqui.chat ? moqui.chat.presenceOf(userId) : ''; },
        presenceText(userId) {
            const dot = this.presenceOf(userId) || 'offline';
            const status = moqui.chat ? moqui.chat.statusOf(userId) : null;
            const text = { online: t('Active'), away: t('Away'), dnd: t('Do not disturb'), offline: t('Offline') }[dot] || '';
            return status && status.statusText ? text + ' · ' + (status.emoji ? status.emoji + ' ' : '') + status.statusText : text;
        },
        repliesText(count) { return count === 1 ? t('1 reply') : fill(t('{count} replies'), { count }); },
        filesText(event) { return (event.attachments || []).map((file) => file.fileName).join(', '); },
        reactorsText(reaction) { return (reaction.userIds || []).map((id) => (id === this.me.userId ? t('You') : this.nameOf(id))).join(', '); },
        // the rows shown: day separators, the "new messages" divider, system rows in words and messages grouped by sender
        buildItems(events, opts) {
            const me = this.me.userId;
            const out = [];
            let prev = null;
            let lastDay = null;
            let dividerPlaced = false;
            for (const event of events) {
                const sent = Number(event.sentDate || 0);
                const day = new Date(sent).toDateString();
                if (day !== lastDay) { out.push({ kind: 'day', key: 'd' + event.eventSeq, label: dayLabel(sent) }); lastDay = day; prev = null; }
                if (opts.divider && !dividerPlaced && this.dividerSeq != null && Number(event.eventSeq) > this.dividerSeq && event.type === 'message' && event.senderUserId !== me) {
                    out.push({ kind: 'unread', key: 'unread' });
                    dividerPlaced = true;
                    prev = null;
                }
                if (event.type !== 'message') {
                    const words = systemText(event, (id) => this.nameOf(id));
                    out.push({ kind: 'system', key: 'e' + event.eventSeq, eventSeq: event.eventSeq, text: words[0], icon: words[1], time: timeText(sent),
                        target: event.type === 'pin' && event.content && event.content.pinned ? event.relatesToEventSeq : null });
                    prev = null;
                    continue;
                }
                const grouped = !!prev && (prev.event.senderActorId || prev.senderUserId) === (event.senderActorId || event.senderUserId)
                    && sent - prev.sentDate < GROUP_MILLIS && event.replyToEventSeq == null;
                const item = { kind: 'message', key: 'e' + event.eventSeq, eventSeq: Number(event.eventSeq), event, senderUserId: event.senderUserId,
                    senderName: this.nameOf(event.senderUserId, event.senderName), sentDate: sent, timeText: timeText(sent), timeShort: timeText(sent), fullTime: fullTime(sent),
                    bodyHtml: event.redacted ? null : (event.body ? decorateBody(event.body, me) : null), redacted: !!event.redacted, removedLabel: event.removedLabel,
                    undecryptable: !event.redacted && !!event.undecryptable,
                    edited: !!event.edited, editedText: event.editedDate ? fill(t('Edited {when}'), { when: fullTime(event.editedDate) }) : t('Edited'),
                    attachments: event.attachments || [], records: event.records || [], reactions: event.reactions || [],
                    forwardOf: event.forwardOf || null, poll: event.poll || null, linkPreviews: event.linkPreviews || [],
                    replyTo: event.replyToEventSeq != null ? this.replyOf(event) : null, threadReplyCount: Number(event.threadReplyCount || 0),
                    threadLastDate: event.threadLastDate, pinned: !!event.pinned, grouped, mine: event.senderUserId === me,
                    highlight: this.highlightSeq === Number(event.eventSeq), readers: opts.readers ? (this.readersBySeq[event.eventSeq] || null) : null };
                out.push(item);
                prev = item;
            }
            return out;
        },
        replyOf(event) {
            const loaded = this.events.find((item) => Number(item.eventSeq) === Number(event.replyToEventSeq));
            if (loaded) return { eventSeq: loaded.eventSeq, senderName: this.nameOf(loaded.senderUserId, loaded.senderName), redacted: !!loaded.redacted,
                snippet: this.snippetOf(loaded) };
            if (event.replyTo) return Object.assign({}, event.replyTo, { senderName: this.nameOf(event.replyTo.senderUserId, event.replyTo.senderName) });
            return { eventSeq: event.replyToEventSeq, senderName: null, redacted: false, snippet: t('An earlier message') };
        },
        snippetOf(event) {
            const text = String(event.bodyText || plainOf(event.body) || '').replace(/\s+/g, ' ').trim();
            return (text.length > 100 ? text.slice(0, 99) + '…' : text) || this.filesText(event);
        },

        // ---- loading and paging ----
        load() {
            this.state = 'loading';
            const aroundSeq = this.seq ? Number(this.seq) : null;
            this.get('roomView', { chatRoomId: this.roomId, aroundSeq: aroundSeq || '', limit: 50 }).then((json) => {
                if (!json.room) { this.state = 'missing'; return; }
                this.applyMeta(json);
                const page = json.timeline || {};
                this.mergeNames(page.userNames);
                this.events = page.eventList || [];
                this.hasMoreBefore = !!page.hasMoreBefore;
                this.hasMoreAfter = !!page.hasMoreAfter;
                this.myLastRead = Number((json.member && json.member.lastReadEventSeq) || 0);
                const last = Number(json.room.lastEventSeq || 0);
                this.dividerSeq = this.isMember && this.myLastRead < last && this.events.some((event) => Number(event.eventSeq) > this.myLastRead
                    && event.type === 'message' && event.senderUserId !== this.me.userId) ? this.myLastRead : null;
                this.state = 'ready';
                if (moqui.chat) moqui.chat.openRoom(this.roomId);
                this.opened = true;
                this.$emit('read', this.roomId);
                this.$nextTick(() => {
                    if (aroundSeq) this.scrollToSeq(aroundSeq, true);
                    else if (this.dividerSeq != null) this.scrollToDivider();
                    else this.scrollToBottom();
                    this.maybeMarkRead();
                    if (this.thread) this.openThread(Number(this.thread), true);
                    else if (!this.compact) this.focusComposer();
                });
            }, () => { this.state = 'missing'; });
        },
        applyMeta(json) {
            this.room = json.room;
            this.member = json.member || null;
            this.access = json.access || {};
            this.members = json.memberList || [];
            this.members.forEach((person) => { if (person.name) this.names[person.userId] = person.name; });
            if (moqui.chat) moqui.chat.watchUsers(this.members.map((person) => person.userId));
        },
        reloadMeta() {
            return this.get('room', { chatRoomId: this.roomId }).then((json) => { if (json.room) this.applyMeta(json); }, () => {});
        },
        loadOlder() {
            if (!this.hasMoreBefore || this.loadingOlder || !this.events.length) return;
            this.loadingOlder = true;
            const el = this.$refs.scroller;
            const fromEnd = el ? el.scrollHeight - el.scrollTop : 0;
            this.get('timeline', { chatRoomId: this.roomId, beforeSeq: this.events[0].eventSeq, limit: 50 }).then((page) => {
                this.mergeNames(page.userNames);
                const have = new Set(this.events.map((event) => Number(event.eventSeq)));
                this.events = (page.eventList || []).filter((event) => !have.has(Number(event.eventSeq))).concat(this.events);
                this.hasMoreBefore = !!page.hasMoreBefore;
                this.loadingOlder = false;
                this.$nextTick(() => { if (el) el.scrollTop = el.scrollHeight - fromEnd; });
            }, () => { this.loadingOlder = false; });
        },
        loadNewer() {
            if (!this.hasMoreAfter || this.loadingNewer || !this.events.length) return;
            this.loadingNewer = true;
            this.get('timeline', { chatRoomId: this.roomId, afterSeq: this.events[this.events.length - 1].eventSeq, limit: 50 }).then((page) => {
                this.mergeNames(page.userNames);
                const have = new Set(this.events.map((event) => Number(event.eventSeq)));
                this.events = this.events.concat((page.eventList || []).filter((event) => !have.has(Number(event.eventSeq))));
                this.hasMoreAfter = !!page.hasMoreAfter;
                this.loadingNewer = false;
                if (!this.hasMoreAfter) this.maybeMarkRead();
            }, () => { this.loadingNewer = false; });
        },
        jumpTo(seq) {
            if (!seq) return;
            if (this.sideOverlay && this.side && this.side !== 'thread') this.side = null;
            const loaded = this.events.some((event) => Number(event.eventSeq) === Number(seq));
            if (loaded) { this.$nextTick(() => this.scrollToSeq(Number(seq), true)); return; }
            this.get('timeline', { chatRoomId: this.roomId, aroundSeq: seq, limit: 50 }).then((page) => {
                this.mergeNames(page.userNames);
                this.events = page.eventList || [];
                this.hasMoreBefore = !!page.hasMoreBefore;
                this.hasMoreAfter = !!page.hasMoreAfter;
                this.$nextTick(() => this.scrollToSeq(Number(seq), true));
            }, () => {});
        },
        jumpToLatest() {
            this.newBelow = 0;
            if (!this.hasMoreAfter) { this.scrollToBottom(); this.maybeMarkRead(); return; }
            this.get('timeline', { chatRoomId: this.roomId, limit: 50 }).then((page) => {
                this.mergeNames(page.userNames);
                this.events = page.eventList || [];
                this.hasMoreBefore = !!page.hasMoreBefore;
                this.hasMoreAfter = false;
                this.$nextTick(() => { this.scrollToBottom(); this.maybeMarkRead(); });
            }, () => {});
        },
        scrollToBottom() {
            const el = this.$refs.scroller;
            if (!el) return;
            el.scrollTop = el.scrollHeight;
            this.atBottom = true;
        },
        scrollToDivider(again) {
            if (!again) this.holdAnchor({ kind: 'divider' });
            const el = this.$refs.scroller;
            const divider = document.getElementById(this.domId('unread', false));
            if (!el || !divider) { this.scrollToBottom(); return; }
            el.scrollTop = Math.max(0, divider.offsetTop - el.clientHeight / 3);
            this.onScroll();
        },
        scrollToSeq(seq, highlight, again) {
            if (!again) this.holdAnchor({ kind: 'seq', seq: Number(seq) });
            const node = document.getElementById(this.domId(seq, false));
            if (node && node.scrollIntoView) node.scrollIntoView({ block: 'center' });
            if (highlight) {
                this.highlightSeq = Number(seq);
                clearTimeout(this.highlightTimer);
                this.highlightTimer = setTimeout(() => { this.highlightSeq = null; }, 4000);
            }
            this.onScroll();
        },
        // a picture that loads after the room opened at its divider or at a message keeps that in view; at the bottom, the bottom
        imageLoaded() {
            if (this.anchor && this.anchor.kind === 'divider') this.scrollToDivider(true);
            else if (this.anchor && this.anchor.kind === 'seq') this.scrollToSeq(this.anchor.seq, false, true);
            else if (this.atBottom && !this.hasMoreAfter) this.scrollToBottom();
        },
        holdAnchor(anchor) {
            this.anchor = anchor;
            clearTimeout(this.anchorTimer);
            this.anchorTimer = setTimeout(() => { this.anchor = null; }, 4000);
        },
        onScroll() {
            const el = this.$refs.scroller;
            if (!el) return;
            const fromBottom = el.scrollHeight - el.scrollTop - el.clientHeight;
            this.atBottom = fromBottom < 40;
            if (this.atBottom) { this.newBelow = 0; this.maybeMarkRead(); }
            if (el.scrollTop < 60 && this.hasMoreBefore && !this.loadingOlder) this.loadOlder();
            if (fromBottom < 80 && this.hasMoreAfter && !this.loadingNewer) this.loadNewer();
        },

        // ---- read markers ----
        maybeMarkRead() {
            if (!this.isMember || this.holdRead || this.hasMoreAfter || !this.atBottom || this.state !== 'ready' || !this.room) return;
            if (document.visibilityState && document.visibilityState !== 'visible') return;
            if (Number(this.room.lastEventSeq || 0) <= this.myLastRead) return;
            clearTimeout(this.readTimer);
            this.readTimer = setTimeout(() => this.markRead(false), 600);
        },
        markRead(now) {
            if (!this.isMember) return;
            if (now) this.holdRead = false;
            this.post('markRead', { chatRoomId: this.roomId }).then((json) => {
                if (json.lastReadEventSeq != null) this.myLastRead = Math.max(this.myLastRead, Number(json.lastReadEventSeq));
                if (now) this.dividerSeq = null;
                this.$emit('read', this.roomId);
            }, () => {});
        },
        markUnreadFrom(item) {
            this.post('markRead', { chatRoomId: this.roomId, eventSeq: item.eventSeq, markUnread: 'true' }).then((json) => {
                this.holdRead = true;
                this.myLastRead = Number(json.lastReadEventSeq || 0);
                this.dividerSeq = this.myLastRead;
                moqui.notifyMessages([{ type: 'info', message: t('Marked unread from this message') }]);
            }, () => {});
        },

        // ---- live: the page's chat store ----
        onEvent(payload) {
            const event = payload && payload.event;
            if (!event || payload.chatRoomId !== this.roomId || this.state !== 'ready') return;
            // an encrypted room's event is decrypted first, the events kept in their order (C7); a member who left takes no later key
            if (this.sealed && moqui.chat && moqui.chat.openEvent) {
                if (event.type === 'membership' && event.content && ['leave', 'remove'].includes(event.content.action)) {
                    // out of the members at once, not when the room's meta reloads: a message sent meanwhile shares no key with them
                    const gone = event.content.userId || event.senderUserId;
                    if (gone) this.members = this.members.filter((person) => person.userId !== gone);
                    moqui.crypto.rotateRoom(this.roomId).catch(() => null);
                }
                const copy = Object.assign({}, event);
                this.liveQueue = (this.liveQueue || Promise.resolve()).then(() => moqui.chat.openEvent(this.roomId, copy, (file) => this.sealedUrl(file)))
                    .then(() => this.applyLive(Object.assign({}, payload, { event: copy })), (err) => console.error('An encrypted event was not shown', err));
                return;
            }
            this.applyLive(payload);
        },
        applyLive(payload) {
            const event = payload && payload.event;
            if (!event || payload.chatRoomId !== this.roomId || this.state !== 'ready') return;
            const me = this.me.userId;
            const seq = Number(event.eventSeq);
            if (this.room) this.room.lastEventSeq = Math.max(Number(this.room.lastEventSeq || 0), seq);
            if (event.senderUserId && event.senderName && !this.names[event.senderUserId]) this.names[event.senderUserId] = event.senderName;
            const isRow = ['message', 'membership', 'system', 'pin', 'call', 'poll'].includes(event.type);
            const mainTimeline = event.threadRootEventSeq == null;
            if (this.hasMoreAfter && isRow && mainTimeline) {
                if (event.type === 'pin') {
                    const target = this.events.find((item) => Number(item.eventSeq) === Number(event.relatesToEventSeq));
                    if (target) target.pinned = !!(event.content && event.content.pinned);
                }
                if (event.type === 'message' && event.senderUserId !== me) this.newBelow++;
            } else {
                const wasAtBottom = this.atBottom;
                applyEvent(this.events, event, me);
                if (isRow && mainTimeline) this.$nextTick(() => {
                    if (wasAtBottom || event.senderUserId === me) this.scrollToBottom();
                    else if (event.type === 'message') this.newBelow++;
                });
            }
            if (this.side === 'thread' && this.threadView.rootSeq != null) {
                const before = this.threadView.events.length;
                applyEvent(this.threadView.events, event, me, this.threadView.rootSeq);
                if (this.threadView.events.length !== before) this.$nextTick(() => { const el = this.$refs.threadScroller; if (el) el.scrollTop = el.scrollHeight; });
            }
            if (this.side === 'threads' && (event.threadRootEventSeq != null || event.type === 'redaction')) this.patchThreads(event);
            if (event.type === 'message') {
                const person = this.members.find((item) => item.userId === event.senderUserId);
                // a member who turned read receipts off has no marker to move
                if (person && person.lastReadEventSeq != null) person.lastReadEventSeq = Math.max(Number(person.lastReadEventSeq || 0), seq);
                if (event.senderUserId === me) this.myLastRead = Math.max(this.myLastRead, seq);
                else {
                    this.maybeMarkRead();
                    const mentioned = (event.mentions || []).includes(me);
                    const level = (this.member && this.member.notificationLevelEnumId) || 'CnlAll';
                    const wants = mentioned || (level === 'CnlAll' && !(this.member && this.member.isMuted));
                    if (wants && this.prefs.sounds !== false && !(moqui.chat && moqui.chat.quiet()) && document.visibilityState !== 'visible') chime();
                }
            }
            if (event.type === 'membership' || event.type === 'system') { this.reloadMeta(); this.$emit('changed'); }
            if (this.side === 'pinned' && (event.type === 'pin' || event.type === 'redaction')) this.loadPinned();
        },
        onReadSignal(payload) {
            if (!payload || payload.chatRoomId !== this.roomId) return;
            if (payload.userId && payload.userId !== this.me.userId) {
                const person = this.members.find((item) => item.userId === payload.userId);
                if (person) person.lastReadEventSeq = Number(payload.lastReadEventSeq || 0);
            } else if (payload.lastReadEventSeq != null) this.myLastRead = Math.max(this.myLastRead, Number(payload.lastReadEventSeq));
        },
        onRoomSignal(payload) {
            if (!payload || payload.chatRoomId !== this.roomId) return;
            if (payload.action === 'left') { this.$emit('left', this.roomId); return; }
            this.reloadMeta();
        },
        onVisible() { if (document.visibilityState === 'visible') this.maybeMarkRead(); },
        typingNow() { if (this.prefs.typing !== false && this.canPost && moqui.chat) moqui.chat.typing(this.roomId); },
        typingStop() { if (moqui.chat) moqui.chat.typing(this.roomId, false); },

        // ---- the composers ----
        registerComposer(vm, threadRoot) { (this.composers = this.composers || {})[threadRoot ? 'thread' : 'main'] = vm; },
        unregisterComposer(vm, threadRoot) { const key = threadRoot ? 'thread' : 'main'; if (this.composers && this.composers[key] === vm) this.composers[key] = null; },
        focusComposer() { const vm = this.composers && this.composers.main; if (vm) vm.focus(); },
        // A message goes through the chat store's outbox (moqui.chat.send): kept in the page first, so one sent offline, or
        // one whose answer is lost, goes later and is not sent twice (the server knows its clientRef). Its row is the
        // outbox's until the answer or its push (onSent). Rejects when the outbox cannot keep it; resolves otherwise.
        sendMessage(message) {
            const threadRoot = message.threadRoot ? Number(message.threadRoot) : null;
            const replyTo = threadRoot ? null : this.replyTo;
            const params = { body: message.body || '', replyToEventSeq: replyTo ? replyTo.eventSeq : '', threadRootEventSeq: threadRoot || '',
                chatAttachmentIds: (message.attachmentIds || []).join(',') };
            if (!threadRoot) {
                this.replyTo = null;
                if (!this.hasMoreAfter) this.$nextTick(() => this.scrollToBottom());
            }
            const restore = (err) => { if (replyTo) this.replyTo = replyTo; throw err; };
            // an encrypted room: the message is encrypted before the outbox keeps it, which then holds only ciphertext (C7)
            if (this.sealed) {
                const clientRef = moqui.chat.newClientRef();
                const html = message.body || '';
                return moqui.chat.sealMessage(this.roomId, this.memberIds(), html, message.files || []).then((sealed) => {
                    moqui.chat.sealedTexts[clientRef] = plainOf(html) || t('Files');
                    const sealedParams = { encryptedJson: sealed.encryptedJson, mentionUserIds: sealed.mentionUserIds, replyToEventSeq: params.replyToEventSeq,
                        threadRootEventSeq: params.threadRootEventSeq, chatAttachmentIds: params.chatAttachmentIds };
                    return moqui.chat.send({ clientRef, chatRoomId: this.roomId, url: this.url('send'), params: sealedParams, text: '', sealed: true,
                        threadRootEventSeq: threadRoot, hasFiles: !!(message.attachmentIds || []).length });
                }).then((outcome) => {
                    if (outcome && outcome.failed && outcome.error) moqui.notifyMessages([{ type: 'warning', message: outcome.error }]);
                    return outcome;
                }, (err) => {
                    moqui.notifyMessages([{ type: 'warning', message: (err && (err.errors || err.message)) || t('This message could not be encrypted') }]);
                    return restore(err);
                });
            }
            if (!moqui.chat || !moqui.chat.send) {
                return this.post('send', Object.assign({ chatRoomId: this.roomId }, params)).then((json) => {
                    this.onSent({ chatRoomId: this.roomId, threadRootEventSeq: threadRoot, json });
                    return json;
                }, restore);
            }
            return moqui.chat.send({ chatRoomId: this.roomId, url: this.url('send'), params, text: plainOf(message.body) || t('Files'),
                threadRootEventSeq: threadRoot, hasFiles: !!(message.attachmentIds || []).length }).then((outcome) => {
                if (outcome && outcome.failed && outcome.error) moqui.notifyMessages([{ type: 'warning', message: outcome.error }]);
                return outcome;
            }, (err) => {
                moqui.notifyMessages([{ type: 'warning', message: t('This message cannot wait to be sent: it is too large, or too many wait. Send it when you are back online.') }]);
                return restore(err);
            });
        },
        // a message of this room answered (now, or later from the outbox): in its place, and read
        onSent(payload) {
            const sent = payload && payload.json && payload.json.event;
            if (!sent || payload.chatRoomId !== this.roomId || this.state !== 'ready') return;
            if (this.sealed && sent.encrypted && !payload.opened && moqui.chat.openEvent) {
                const copy = Object.assign({}, sent);
                this.liveQueue = (this.liveQueue || Promise.resolve()).then(() => moqui.chat.openEvent(this.roomId, copy, (file) => this.sealedUrl(file)))
                    .then(() => this.onSent(Object.assign({}, payload, { opened: true, json: Object.assign({}, payload.json, { event: copy }) })));
                return;
            }
            const event = sent;
            const me = this.me.userId;
            const threadRoot = payload.threadRootEventSeq != null ? Number(payload.threadRootEventSeq) : null;
            const seq = Number(event.eventSeq);
            this.myLastRead = Math.max(this.myLastRead, seq);
            if (this.room) this.room.lastEventSeq = Math.max(Number(this.room.lastEventSeq || 0), seq);
            this.dividerSeq = null;
            this.holdRead = false;
            // a thread reply counts on its root through its push only, so it is not counted twice
            if (threadRoot) {
                if (Number(this.threadView.rootSeq) === threadRoot) {
                    applyEvent(this.threadView.events, event, me, threadRoot);
                    this.$nextTick(() => { const el = this.$refs.threadScroller; if (el) el.scrollTop = el.scrollHeight; });
                }
            } else if (this.hasMoreAfter) this.jumpToLatest();
            else {
                applyEvent(this.events, event, me);
                this.$nextTick(() => this.scrollToBottom());
            }
        },
        pendingText(item) {
            if (item.status === 'sending') return t('Sending…');
            if (item.status === 'failed') return item.expired ? t('Not sent: its files are no longer kept') : (item.error ? t('Not sent:') + ' ' + item.error : t('Not sent'));
            if (item.status === 'held') return t('Waiting: sign in again to send it');
            return this.offline ? t('Waiting for the connection') : t('Waiting to send');
        },
        retryPending(item) { if (moqui.chat) moqui.chat.retry(item.clientRef); },
        discardPending(item) {
            this.confirm(t('Delete this message?'), t('It was not sent; it is removed from this page.'), t('Delete'), true).then(() => { if (moqui.chat) moqui.chat.discard(item.clientRef); });
        },
        // a change of a message with no event of its own (link previews, a poll's votes), here and in the open thread
        onUpdate(payload) {
            if (!payload || payload.chatRoomId !== this.roomId || this.state !== 'ready') return;
            this.applyFields(payload.eventSeq, payload.fields);
        },
        applyFields(seq, fields) {
            const payload = { eventSeq: seq, fields };
            const me = this.me.userId;
            if (moqui.chat && moqui.chat.applyUpdate) {
                moqui.chat.applyUpdate(this.events, payload, me);
                moqui.chat.applyUpdate(this.threadView.events, payload, me);
            } else {
                [this.events, this.threadView.events].forEach((list) => {
                    const target = list.find((item) => Number(item.eventSeq) === Number(seq));
                    if (target) Object.assign(target, fields);
                });
            }
        },
        // the socket is back after it was closed: what came meanwhile, after the last event here
        onConnection(payload) {
            if (!payload || !payload.reconnected || this.state !== 'ready') return;
            this.reloadMeta();
            if (this.side === 'thread' && this.threadView.rootSeq != null) this.openThread(this.threadView.rootSeq, true);
            if (this.side === 'threads') this.loadThreads(false);
            if (this.hasMoreAfter || !this.events.length) return;
            const last = this.events.reduce((max, event) => Math.max(max, Number(event.eventSeq)), 0);
            this.get('timeline', { chatRoomId: this.roomId, afterSeq: last, limit: 200 }).then((page) => {
                this.mergeNames(page.userNames);
                const wasAtBottom = this.atBottom;
                const have = new Set(this.events.map((event) => Number(event.eventSeq)));
                const added = (page.eventList || []).filter((event) => !have.has(Number(event.eventSeq)));
                if (added.length) this.events = this.events.concat(added).sort((left, right) => Number(left.eventSeq) - Number(right.eventSeq));
                this.hasMoreAfter = !!page.hasMoreAfter;
                if (wasAtBottom) this.$nextTick(() => { this.scrollToBottom(); this.maybeMarkRead(); });
                else this.newBelow += added.filter((event) => event.type === 'message' && event.senderUserId !== this.me.userId).length;
            }, () => {});
        },
        startReply(item) {
            this.replyTo = { eventSeq: item.eventSeq, senderName: item.senderName, snippet: this.snippetOf(item.event) };
            this.$nextTick(() => this.focusComposer());
        },
        cancelReply() { this.replyTo = null; },
        quickCreateText(kind, text) {
            const query = { kind };
            if (text) query[kind === 'request' ? 'requestName' : 'workEffortName'] = text;
            if (this.room && this.room.record && this.room.record.visible) {
                query.recordEntity = this.room.record.entity;
                query.recordId = this.room.record.id;
                query.recordTitle = this.room.record.title;
            }
            // the shell's quick-create kind of that name, from the apps the user may open
            const found = (this.$root.quickCreateItems || []).find((option) => option.kind === kind);
            if (!found) { moqui.notifyMessages([{ type: 'warning', message: fill(t('Nothing here makes a {kind}'), { kind }) }]); return; }
            delete query.kind;
            this.openQuickCreate(found.url + (found.url.indexOf('?') > 0 ? '&' : '?') + moqui.objToSearch(query), found.label);
        },
        openQuickCreate(url, title) {
            this.$root.quickCreateTitle = title || '';
            this.$root.quickCreateUrl = this.$root.shellLoadPath ? this.$root.shellLoadPath(url) : url.replace(/^\/qapps/, '/apps');
            this.$root.quickCreateShow = true;
        },

        // ---- message actions ----
        hover(item, inThread) { if (!this.isTouch()) this.hoverKey = (inThread ? 't' : 'm') + item.eventSeq; },
        unhover(item, inThread) { const key = (inThread ? 't' : 'm') + item.eventSeq; if (this.hoverKey === key) this.hoverKey = null; },
        isHovered(item, inThread) { return this.hoverKey === (inThread ? 't' : 'm') + item.eventSeq; },
        tap(item, inThread) {
            if (!this.isTouch()) return;
            const key = (inThread ? 't' : 'm') + item.eventSeq;
            this.tapKey = this.tapKey === key ? null : key;
        },
        isTouch() { return !!(this.$q.platform && this.$q.platform.has && this.$q.platform.has.touch) && this.$q.screen.lt.md; },
        showActions(item, inThread) {
            if (item.redacted || this.isEditing(item) || this.state !== 'ready') return false;
            const key = (inThread ? 't' : 'm') + item.eventSeq;
            return this.hoverKey === key || this.tapKey === key;
        },
        canEdit(item) { return item.mine && !item.redacted && !item.poll && this.canPost && Date.now() - item.sentDate < EDIT_WINDOW && this.bridgeCaps.edit; },
        canRedact(item) { return !item.redacted && this.isMember && (item.mine || (this.canModerate && !this.isDirect)) && this.bridgeCaps.delete; },
        externalText(person) { return fill(t('On {network}'), { network: person.networkName || t('another network') }); },
        // ---- a message's delivery to the room's bridges ----
        deliveryNames(item, state) {
            const list = ((item.event.delivery && item.event.delivery.destinations) || []).filter((destination) => !state || destination.state === state);
            return Array.from(new Set(list.map((destination) => destination.networkName || destination.bridgeName).filter((name) => name))).join(', ');
        },
        deliveryText(item) {
            const delivery = item.event.delivery;
            if (!delivery) return '';
            if (delivery.state === 'failed') {
                const failed = delivery.destinations.find((destination) => destination.state === 'failed') || {};
                return fill(t('Not delivered to {names}'), { names: this.deliveryNames(item, 'failed') }) + (failed.error ? ': ' + failed.error : '');
            }
            if (delivery.state === 'uncertain') return fill(t('May not have reached {names}'), { names: this.deliveryNames(item, 'uncertain') });
            if (delivery.state === 'pending') return fill(t('Sending to {names}'), { names: this.deliveryNames(item, 'pending') });
            return fill(t('Delivered to {names}'), { names: this.deliveryNames(item) });
        },
        deliveryIcon(item) {
            const state = item.event.delivery && item.event.delivery.state;
            return { failed: 'sym_o_error', uncertain: 'sym_o_help', pending: 'sym_o_schedule' }[state] || 'sym_o_done_all';
        },
        deliveryClass(item) {
            const state = item.event.delivery && item.event.delivery.state;
            return state === 'failed' ? 'text-negative' : state === 'uncertain' ? 'text-warning' : 'm-muted';
        },
        canRetry(item) { return !!(item.event.delivery && item.event.delivery.retryable) && (item.mine || this.canModerate); },
        retryDelivery(item) {
            const destinations = (item.event.delivery.destinations || []).filter((destination) => destination.retryable);
            Promise.all(destinations.map((destination) => this.post('retryDelivery', { chatBridgeDeliveryId: destination.chatBridgeDeliveryId }))).then((answers) => {
                const refused = answers.find((json) => json && json.error);
                if (refused) { moqui.notifyMessages(null, [refused.error]); return; }
                destinations.forEach((destination) => { destination.state = 'pending'; destination.retryable = false; });
                Object.assign(item.event.delivery, { state: 'pending', retryable: false });
            }, () => {});
        },
        isEditing(item) { return !!this.editing && this.editing.seq === item.eventSeq; },
        startEdit(item) { this.tapKey = null; this.editing = { seq: item.eventSeq, body: item.event.body || '' }; },
        cancelEdit() { this.editing = null; this.$nextTick(() => this.focusComposer()); },
        editLast() {
            const me = this.me.userId;
            for (let i = this.events.length - 1; i >= 0; i--) {
                const event = this.events[i];
                if (event.type !== 'message' || event.senderUserId !== me || event.redacted || event.poll) continue;
                if (Date.now() - Number(event.sentDate || 0) >= EDIT_WINDOW || !this.canPost) return false;
                this.editing = { seq: Number(event.eventSeq), body: event.body || '' };
                this.$nextTick(() => this.scrollToSeq(Number(event.eventSeq), false));
                return true;
            }
            return false;
        },
        saveEdit(item, body) {
            const sent = this.sealed ? moqui.chat.sealMessage(this.roomId, this.memberIds(), body, []).then((sealed) => this.post('edit', { chatRoomId: this.roomId,
                eventSeq: item.eventSeq, encryptedJson: sealed.encryptedJson, mentionUserIds: sealed.mentionUserIds }))
                : this.post('edit', { chatRoomId: this.roomId, eventSeq: item.eventSeq, body });
            return sent.then((json) => (json.event && this.sealed ? moqui.chat.openEvent(this.roomId, json.event).then(() => json) : json)).then((json) => {
                if (json.event) {
                    applyEvent(this.events, json.event, this.me.userId);
                    if (this.threadView.rootSeq != null) applyEvent(this.threadView.events, json.event, this.me.userId, this.threadView.rootSeq);
                }
                this.editing = null;
                this.$nextTick(() => this.focusComposer());
                return json;
            });
        },
        react(item, key) {
            if (!this.canPost) return;
            this.tapKey = null;
            const me = this.me.userId;
            const reactions = item.event.reactions = item.event.reactions || [];
            let entry = reactions.find((reaction) => reaction.key === key);
            const mine = !!entry && entry.mine;
            // shown at once; the push of the reaction (or of its removal) leaves it as it is
            if (mine) {
                entry.userIds = entry.userIds.filter((id) => id !== me);
                entry.count = Math.max(0, entry.count - 1);
                entry.mine = false;
                if (entry.count <= 0) reactions.splice(reactions.indexOf(entry), 1);
            } else {
                if (!entry) { entry = { key, count: 0, userIds: [], mine: false }; reactions.push(entry); }
                if (!entry.userIds.includes(me)) { entry.userIds.push(me); entry.count++; }
                entry.mine = true;
            }
            if (this.sealed) {
                // an encrypted reaction (C7): the key is encrypted; mine is taken back by its own eventSeq
                const taken = mine ? moqui.chat.myReaction(this.roomId, item.eventSeq, key, me) : null;
                if (mine && taken != null) this.post('react', { chatRoomId: this.roomId, eventSeq: item.eventSeq, reactionEventSeq: taken }).catch(() => {});
                else if (!mine) moqui.chat.sealReaction(this.roomId, this.memberIds(), key).then((encryptedJson) => this.post('react', { chatRoomId: this.roomId,
                    eventSeq: item.eventSeq, encryptedJson })).catch(() => {});
                return;
            }
            this.post('react', { chatRoomId: this.roomId, eventSeq: item.eventSeq, key }).catch(() => {});
        },
        pin(item, pinned) {
            this.tapKey = null;
            if (item.event) item.event.pinned = pinned;
            this.post('pin', { chatRoomId: this.roomId, eventSeq: item.eventSeq, pinned: pinned ? 'true' : 'false' }).then(() => {
                moqui.notifyMessages([{ type: 'success', message: pinned ? t('Pinned to the room') : t('Unpinned') }]);
                if (this.side === 'pinned') this.loadPinned();
            }, () => {});
        },
        redact(item) {
            this.confirm(t('Delete the message?'), t('It is removed for everyone; the room shows that a message was removed.'), t('Delete'), true).then(() => {
                this.post('redact', { chatRoomId: this.roomId, eventSeq: item.eventSeq }).then(() => {
                    const event = { type: 'redaction', eventSeq: -1, relatesToEventSeq: item.eventSeq, content: { target: 'message' }, sentDate: Date.now(), threadRootEventSeq: null };
                    if (item.event.threadRootEventSeq == null) applyEvent(this.events, event, this.me.userId);
                    if (this.threadView.rootSeq != null) applyEvent(this.threadView.events, event, this.me.userId, this.threadView.rootSeq);
                }, () => {});
            });
        },
        copyText(item) {
            const text = item.event.bodyText || plainOf(item.event.body);
            if (navigator.clipboard) navigator.clipboard.writeText(text || '').then(() => moqui.notifyMessages([{ type: 'success', message: t('Copied') }]), () => {});
        },
        copyLink(item) {
            const link = window.location.origin + this.linkBase + '?chatRoomId=' + encodeURIComponent(this.roomId) + '&eventSeq=' + item.eventSeq;
            if (navigator.clipboard) navigator.clipboard.writeText(link).then(() => moqui.notifyMessages([{ type: 'success', message: t('Link copied') }]), () => {});
        },
        // the record is made at once and the message filed on it (create#RecordFromChatMessage); the toast opens it
        openFileOn(item) { this.tapKey = null; this.fileOn = { open: true, item, value: null, busy: false }; },
        fileOnRecord() {
            const value = String(this.fileOn.value || '');
            const at = value.indexOf('|');
            if (at <= 0) return;
            this.fileOn.busy = true;
            this.post('fileOnRecord', { chatRoomId: this.roomId, eventSeq: this.fileOn.item.eventSeq, recordEntityName: value.substring(0, at),
                recordId: value.substring(at + 1) }).then(() => { this.fileOn = { open: false, item: null, value: null, busy: false }; },
                () => { this.fileOn.busy = false; });
        },
        // a link in a message: a /qapps one opens in the canvas, any other in a new tab
        bodyClick(event) {
            const link = event.target && event.target.closest ? event.target.closest('a') : null;
            if (!link) return;
            const href = link.getAttribute('href') || '';
            event.preventDefault();
            const origin = window.location.origin;
            const local = href.indexOf(origin + '/qapps') === 0 ? href.slice(origin.length) : href;
            if (local.indexOf('/qapps') === 0) this.$root.setUrl(local);
            else if (/^(https?:|mailto:|tel:)/i.test(href)) window.open(href, '_blank', 'noopener');
        },
        fileUrl(file, inline) {
            if (file && file.sealed) return file.blobUrl || '';
            return this.url('attachment') + '?chatAttachmentId=' + encodeURIComponent(file.chatAttachmentId) + (inline ? '&inline=true' : '');
        },
        // an encrypted room's file is fetched as ciphertext and decrypted here
        sealedUrl(file) { return this.url('attachment') + '?chatAttachmentId=' + encodeURIComponent(file.chatAttachmentId); },
        download(file) {
            if (file && file.sealed) {
                moqui.chat.openFile(this.sealedUrl(file), file, this.roomId).then((url) => this.downloadUrl(url, file.fileName || t('file')),
                    () => moqui.notifyMessages([{ type: 'warning', message: t('This file could not be decrypted') }]));
                return;
            }
            this.downloadUrl(this.fileUrl(file, false), file.fileName);
        },
        downloadUrl(href, name) {
            const a = document.createElement('a');
            a.href = href;
            a.download = name || '';
            document.body.appendChild(a);
            a.click();
            setTimeout(() => document.body.removeChild(a), 0);
        },
        preview(file) {
            if (file && file.sealed) {
                moqui.chat.openFile(this.sealedUrl(file), file, this.roomId).then((url) => { this.previewBox = { open: true, src: url, name: file.fileName, download: url, file }; }, () => {});
                return;
            }
            this.previewBox = { open: true, src: this.fileUrl(file, true), name: file.fileName, download: this.fileUrl(file, false), file };
        },
        // a file of the Files pane in its message: in its thread when it is a reply there
        showFileInChat(file) {
            if (file.threadRootEventSeq != null) this.openThread(Number(file.threadRootEventSeq));
            else this.jumpTo(Number(file.eventSeq));
        },
        onDragOver(event) { if (this.canPost && event.dataTransfer && Array.from(event.dataTransfer.types || []).includes('Files')) this.dragOver = true; },
        onDrop(event) {
            this.dragOver = false;
            const files = Array.from((event.dataTransfer && event.dataTransfer.files) || []);
            const vm = this.side === 'thread' && this.composers && this.composers.thread ? this.composers.thread : this.composers && this.composers.main;
            if (files.length && vm && this.canPost) vm.upload(files);
        },

        // ---- the side pane ----
        openSide(name) {
            if (name === 'thread') return;
            this.side = name;
            if (name === 'pinned') this.loadPinned();
            if (name === 'threads') this.loadThreads(false);
            if (name === 'files') this.loadFiles(false);
            if (name === 'search') this.$nextTick(() => { const input = this.$el.querySelector('input[name="roomSearch' + this.uid + '"]'); if (input) input.focus(); });
        },
        closeSide() {
            if (this.side === 'thread') { this.threadView = { rootSeq: null, events: [], loading: false }; this.$emit('thread', null); }
            this.side = null;
        },
        openThread(seq, fromParent) {
            this.tapKey = null;
            this.side = 'thread';
            this.threadView = { rootSeq: Number(seq), events: [], loading: true };
            if (!fromParent) this.$emit('thread', Number(seq));
            this.get('timeline', { chatRoomId: this.roomId, threadRootEventSeq: seq, limit: 200 }).then((page) => {
                if (this.threadView.rootSeq !== Number(seq)) return;
                this.mergeNames(page.userNames);
                this.threadView.events = page.eventList || [];
                this.threadView.loading = false;
                this.$nextTick(() => {
                    const el = this.$refs.threadScroller;
                    if (el) el.scrollTop = el.scrollHeight;
                    const vm = this.composers && this.composers.thread;
                    if (vm && !this.compact) vm.focus();
                });
            }, () => { this.threadView.loading = false; });
        },
        loadPinned() {
            this.pinned.loading = true;
            this.get('timeline', { chatRoomId: this.roomId, pinnedOnly: 'true', limit: 50 }).then((page) => {
                this.mergeNames(page.userNames);
                this.pinned = { list: page.eventList || [], loading: false };
            }, () => { this.pinned.loading = false; });
        },
        runSearch() {
            const text = String(this.searchPane.text || '').trim();
            if (!text) return;
            this.searchPane.loading = true;
            this.get('search', { searchText: text, chatRoomId: this.roomId }).then((json) => {
                this.searchPane = { text, results: json.eventList || [], loading: false, searched: true };
            }, () => { this.searchPane.loading = false; });
        },
        // ---- the room's threads and files ----
        loadThreads(more) {
            const list = more ? this.threadsPane.list : [];
            const last = list.length ? list[list.length - 1] : null;
            this.threadsPane.loading = true;
            this.get('threads', { chatRoomId: this.roomId, mine: this.threadsPane.mine ? 'true' : 'false', beforeDate: more && last ? last.threadLastDate : '', limit: 20 }).then((json) => {
                this.mergeNames(json.userNames);
                this.threadsPane = Object.assign({}, this.threadsPane, { list: list.concat(json.threadList || []), hasMore: !!json.hasMore, loading: false });
            }, () => { this.threadsPane.loading = false; });
        },
        lastReplyText(thread) {
            const who = thread.threadLastUserId === this.me.userId ? t('you') : this.nameOf(thread.threadLastUserId, thread.threadLastUserName).split(' ')[0];
            return fill(t('last reply {when} by {name}'), { when: shortWhen(thread.threadLastDate), name: who });
        },
        // a pushed reply moves its thread to the top with its new last reply; a thread not listed, or a removed message, reads the list again
        patchThreads(event) {
            const root = event.type === 'message' ? this.threadsPane.list.find((thread) => thread.eventSeq === Number(event.threadRootEventSeq)) : null;
            if (!root) { clearTimeout(this.threadsTimer); this.threadsTimer = setTimeout(() => this.loadThreads(false), 400); return; }
            const text = String(event.bodyText || '').replace(/\s+/g, ' ').trim();
            Object.assign(root, { threadReplyCount: root.threadReplyCount + 1, threadLastDate: event.sentDate, threadLastEventSeq: Number(event.eventSeq),
                threadLastUserId: event.senderUserId, threadLastUserName: event.senderName || null, lastSnippet: text.length > 100 ? text.slice(0, 99) + '…' : text });
            this.threadsPane.list = [root].concat(this.threadsPane.list.filter((thread) => thread !== root));
        },
        loadFiles(more) {
            const list = more ? this.filesPane.list : [];
            this.filesPane.loading = true;
            this.get('files', { chatRoomId: this.roomId, contentTypePrefix: this.filesPane.kind === 'images' ? 'image/' : '',
                beforeEventSeq: more && this.filesPane.next ? this.filesPane.next : '', limit: 30 }).then((json) => {
                this.filesPane = Object.assign({}, this.filesPane, { list: list.concat(json.fileList || []), next: json.nextBeforeEventSeq || null, loading: false });
            }, () => { this.filesPane.loading = false; });
        },

        // ---- forward ----
        forwardedText(forwardOf) {
            return fill(t('Forwarded from {name} · {when}'), { name: this.nameOf(forwardOf.senderUserId, forwardOf.senderName), when: shortWhen(forwardOf.sentDate) });
        },
        openForward(item) { this.tapKey = null; this.forward = { open: true, item, roomId: null, comment: '', busy: false }; },
        sendForward() {
            const target = this.forward.roomId;
            if (!target || !this.forward.item) return;
            const escape = (text) => String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            const comment = String(this.forward.comment || '').trim();
            this.forward.busy = true;
            this.post('send', { chatRoomId: target, body: comment ? '<p>' + escape(comment).replace(/\n/g, '<br>') + '</p>' : '', forwardOfChatRoomId: this.roomId,
                forwardOfEventSeq: this.forward.item.eventSeq, clientRef: moqui.chat && moqui.chat.newClientRef ? moqui.chat.newClientRef() : '' }).then((json) => {
                this.forward = { open: false, item: null, roomId: null, comment: '', busy: false };
                if (json.event) moqui.notifyMessages([{ type: 'success', message: t('Forwarded'), link: this.linkBase + '?chatRoomId=' + encodeURIComponent(target)
                    + '&eventSeq=' + json.eventSeq, linkText: t('Open') }]);
                if (target === this.roomId) this.onSent({ chatRoomId: target, threadRootEventSeq: null, json });
            }, () => { this.forward.busy = false; });
        },

        // ---- polls ----
        openPoll(threadRoot, question) {
            this.pollBox = { open: true, threadRoot: threadRoot || null, question: question || '', options: ['', ''], multiple: 'N', anonymous: 'N', closes: '', busy: false };
        },
        optionLabel(index) { return fill(t('Option {n}'), { n: index + 1 }); },
        createPoll() {
            if (!this.canMakePoll) return;
            const box = this.pollBox;
            const closes = box.closes ? new Date(String(box.closes).replace(' ', 'T')).getTime() : null;
            if (closes != null && !(closes > Date.now())) { moqui.notifyMessages([{ type: 'warning', message: t('A poll closes later than now') }]); return; }
            box.busy = true;
            const threadRoot = box.threadRoot;
            this.post('createPoll', { chatRoomId: this.roomId, question: String(box.question).trim(),
                optionsJson: JSON.stringify(box.options.map((text) => String(text || '').trim()).filter((text) => text)), multiple: box.multiple === 'Y' ? 'true' : 'false',
                anonymous: box.anonymous === 'Y' ? 'true' : 'false', closesDate: closes || '', threadRootEventSeq: threadRoot || '',
                clientRef: moqui.chat && moqui.chat.newClientRef ? moqui.chat.newClientRef() : '' }).then((json) => {
                this.pollBox = Object.assign({}, this.pollBox, { open: false, busy: false });
                this.onSent({ chatRoomId: this.roomId, threadRootEventSeq: threadRoot, json });
                if (json.event && json.event.poll) this.applyFields(json.eventSeq, { poll: json.event.poll });
            }, () => { this.pollBox.busy = false; });
        },
        pollOpen(poll) { return !!poll && !poll.closed && !(poll.closesDate && poll.closesDate <= this.tick); },
        canVote(item) { return this.canPost && this.pollOpen(item.poll); },
        canClosePoll(item) { return this.pollOpen(item.poll) && this.isMember && (item.poll.createdByUserId === this.me.userId || this.canModerate); },
        optionIcon(item, option) {
            if (item.poll.multiple) return option.mine ? 'sym_o_check_box' : 'sym_o_check_box_outline_blank';
            return option.mine ? 'sym_o_radio_button_checked' : 'sym_o_radio_button_unchecked';
        },
        optionShare(item, option) { return Number(option.voteCount || 0) / Math.max(1, Number(item.poll.voterCount || item.poll.totalVotes || 0)); },
        votersText(option) { return (option.voterIds || []).map((id) => (id === this.me.userId ? t('You') : this.nameOf(id))).join(', '); },
        pollFooter(poll) {
            const parts = [poll.voterCount === 1 ? t('1 vote') : fill(t('{count} votes'), { count: poll.voterCount || 0 })];
            if (poll.multiple) parts.push(t('choose any'));
            if (poll.anonymous) parts.push(t('anonymous'));
            if (!this.pollOpen(poll)) parts.push(t('closed'));
            else if (poll.closesDate) parts.push(fill(t('closes {when}'), { when: fullTime(poll.closesDate) }));
            return parts.join(' · ');
        },
        // my vote: one option (again takes it back), or in a poll of several choices this one added or taken out
        vote(item, option) {
            if (!this.canVote(item)) return;
            this.tapKey = null;
            const mine = item.poll.options.filter((other) => other.mine).map((other) => other.id);
            const chosen = item.poll.multiple ? (option.mine ? mine.filter((id) => id !== option.id) : mine.concat([option.id])) : (option.mine ? [] : [option.id]);
            this.post('votePoll', { chatRoomId: this.roomId, eventSeq: item.eventSeq, optionIds: chosen.join(',') }).then((json) => {
                if (json.poll) this.applyFields(item.eventSeq, { poll: json.poll });
            }, () => {});
        },
        closePoll(item) {
            this.confirm(t('Close the poll?'), t('It takes no more votes; the votes stay.'), t('Close'), false).then(() => {
                this.post('closePoll', { chatRoomId: this.roomId, eventSeq: item.eventSeq }).then((json) => {
                    if (json.poll) this.applyFields(item.eventSeq, { poll: json.poll });
                }, () => {});
            });
        },
        // the sender takes the link previews off their message, for good
        removePreviews(item) {
            this.post('removePreviews', { chatRoomId: this.roomId, eventSeq: item.eventSeq }).then(() => this.applyFields(item.eventSeq, { linkPreviews: [] }), () => {});
        },

        addMembers() {
            this.addPeople.busy = true;
            this.post('addMembers', { chatRoomId: this.roomId, userIds: this.addPeople.userIds.join(',') }).then(() => {
                this.addPeople = { userIds: [], busy: false };
                this.reloadMeta();
            }, () => { this.addPeople.busy = false; });
        },
        setRole(person, roleEnumId) { this.post('setRole', { chatRoomId: this.roomId, userId: person.userId, roleEnumId }).then(() => this.reloadMeta(), () => {}); },
        removeMember(person) {
            this.confirm(t('Take out of the room?'), fill(t('{name} no longer sees the room or hears of it.'), { name: person.name }), t('Take out'), true).then(() => {
                const who = person.userId ? { userId: person.userId } : { chatActorId: person.chatActorId };
                this.post('removeMember', Object.assign({ chatRoomId: this.roomId }, who)).then(() => this.reloadMeta(), () => {});
            });
        },

        // ---- my settings in the room, the room's settings ----
        setLevel(level) {
            this.post('setNotification', { chatRoomId: this.roomId, notificationLevelEnumId: level }).then(() => {
                if (this.member) this.member.notificationLevelEnumId = level;
                this.$emit('changed');
            }, () => {});
        },
        toggleMute() {
            const muted = !(this.member && this.member.isMuted);
            this.post('setNotification', { chatRoomId: this.roomId, isMuted: muted ? 'true' : 'false' }).then(() => {
                if (this.member) this.member.isMuted = muted;
                this.$emit('changed');
            }, () => {});
        },
        togglePin() {
            const pinned = !(this.member && this.member.isPinned);
            this.post('setNotification', { chatRoomId: this.roomId, isPinned: pinned ? 'true' : 'false' }).then(() => {
                if (this.member) this.member.isPinned = pinned;
                this.$emit('changed');
            }, () => {});
        },
        join() { this.post('join', { chatRoomId: this.roomId }).then(() => { this.$emit('changed'); this.load(); }, () => {}); },
        leave() {
            const direct = this.isDirect;
            this.confirm(direct ? t('Hide this conversation?') : t('Leave the room?'),
                direct ? t('It comes back with the next message.') : t('You no longer hear of its messages; a public room you can join again.'),
                direct ? t('Hide') : t('Leave'), !direct).then(() => {
                this.post('leave', { chatRoomId: this.roomId }).then(() => this.$emit('left', this.roomId), () => {});
            });
        },
        openSettings() {
            this.settings = { open: true, roomName: this.room.roomName || '', topic: this.room.topic || '', visibility: this.room.visibilityEnumId || '',
                callE2ee: !!this.room.callE2eeRequired, verifiedOnly: !!this.room.verifiedDevicesOnly, busy: false };
        },
        saveSettings() {
            const params = { chatRoomId: this.roomId, roomName: this.settings.roomName, topic: this.settings.topic || '' };
            if (this.isOwner && this.settings.visibility && this.settings.visibility !== this.room.visibilityEnumId) params.visibilityEnumId = this.settings.visibility;
            this.settings.busy = true;
            // the calls' encryption (W8) is its own setting, saved first
            const e2ee = !!this.settings.callE2ee !== !!this.room.callE2eeRequired
                ? this.post('setCallEncryption', { chatRoomId: this.roomId, required: this.settings.callE2ee ? 'true' : 'false' }).then((json) => {
                    if (json.errors) { moqui.notifyMessages([], json.errors); throw json; }
                }) : Promise.resolve();
            // C7 hardening: the room's keys to verified devices only (ChatKeyServices; the browsers read it before the next message)
            const verified = this.sealed && !!this.settings.verifiedOnly !== !!this.room.verifiedDevicesOnly
                ? () => this.post('setVerifiedDevicesOnly', { chatRoomId: this.roomId, verifiedDevicesOnly: this.settings.verifiedOnly ? 'true' : 'false' }).then((json) => {
                    if (json.errors) { moqui.notifyMessages([], json.errors); throw json; }
                    if (moqui.crypto && moqui.crypto.settingsChanged) moqui.crypto.settingsChanged();
                }) : () => null;
            e2ee.then(verified).then(() => this.post('updateRoom', params)).then(() => {
                this.settings = Object.assign({}, this.settings, { open: false, busy: false });
                this.reloadMeta();
                this.$emit('changed');
            }, () => { this.settings.busy = false; });
        },
        setArchived(archived) {
            this.confirm(archived ? t('Archive the room?') : t('Take the room out of the archive?'),
                archived ? t('An archived room is read only and leaves the members\' room lists.') : t('Its members can post again.'),
                archived ? t('Archive') : t('Take out'), archived).then(() => {
                this.post('updateRoom', { chatRoomId: this.roomId, archived: archived ? 'true' : 'false' }).then(() => {
                    this.settings.open = false;
                    this.reloadMeta();
                    this.$emit('changed');
                }, () => {});
            });
        },
        openInChat() { this.$root.setUrl(this.linkBase + '?chatRoomId=' + encodeURIComponent(this.roomId)); },
        // Esc: the edit, then the side pane, then mark the room read
        onEscape() {
            if (this.editing) { this.cancelEdit(); return true; }
            if (this.side) { this.closeSide(); return true; }
            this.markRead(true);
            return true;
        },
        // a confirmation (Quasar's Dialog plugin): resolves on OK; Cancel, Esc or a click outside resolves nothing
        confirm(title, message, okLabel, danger) {
            return new Promise((resolve) => {
                this.$q.dialog({ title, message, ok: { label: okLabel || t('OK'), color: danger ? 'negative' : 'primary', unelevated: true, noCaps: true },
                    cancel: { label: t('Cancel'), flat: true, noCaps: true } }).onOk(() => resolve());
            });
        }
    },
    mounted() {
        this.composers = {};
        this.unsubscribe = [];
        if (moqui.chat) {
            this.unsubscribe.push(moqui.chat.on('event', (payload) => this.onEvent(payload)));
            if (moqui.crypto && moqui.crypto.onRoomKeys) this.unsubscribe.push(moqui.crypto.onRoomKeys(() => this.onRoomKeys()));
            this.unsubscribe.push(moqui.chat.on('read', (payload) => this.onReadSignal(payload)));
            this.unsubscribe.push(moqui.chat.on('room', (payload) => this.onRoomSignal(payload)));
            this.unsubscribe.push(moqui.chat.on('update', (payload) => this.onUpdate(payload)));
            this.unsubscribe.push(moqui.chat.on('sent', (payload) => this.onSent(payload)));
            this.unsubscribe.push(moqui.chat.on('connection', (payload) => this.onConnection(payload)));
        }
        this.onVisibleBound = () => this.onVisible();
        document.addEventListener('visibilitychange', this.onVisibleBound);
        this.ticker = setInterval(() => { this.tick = Date.now(); }, 1000);
        if (window.ResizeObserver) {
            this.resizer = new window.ResizeObserver(() => { if (this.$el && this.$el.clientWidth) this.width = this.$el.clientWidth; });
            this.resizer.observe(this.$el);
        }
        this.width = this.$el.clientWidth || 0;
        this.load();
    },
    beforeUnmount() {
        (this.unsubscribe || []).forEach((off) => off());
        document.removeEventListener('visibilitychange', this.onVisibleBound);
        clearInterval(this.ticker);
        clearTimeout(this.readTimer);
        clearTimeout(this.highlightTimer);
        clearTimeout(this.anchorTimer);
        clearTimeout(this.threadsTimer);
        if (this.resizer) this.resizer.disconnect();
        if (this.opened && moqui.chat) moqui.chat.closeRoom(this.roomId);
        this.typingStop();
    },
    template: roomTemplate
};

module.exports = {
    name: 'Chat',
    components: { 'chat-room': chatRoom },
    data() {
        return {
            loaded: false, height: 600, me: {}, prefs: {}, rooms: [], filter: 'all', search: '', drafts: {}, roomId: null, seq: null, thread: null,
            newDirect: { open: false, userIds: [], busy: false }, newRoom: { open: false, type: 'private', name: '', topic: '', userIds: [], busy: false },
            browse: { open: false, search: '', list: [], loading: false }
        };
    },
    computed: {
        params() { return this.$root.currentParameters || {}; },
        // below 1024 px the rail and the room are one pane (style-guide §3.8)
        stacked() { return this.$q.screen.lt.md; },
        base() { return this.$root.basePath + '/' + this.chatPath(); },
        linkBase() { return this.$root.linkBasePath + '/' + this.chatPath(); },
        myStatus() { return (moqui.chat && moqui.chat.state.me) || {}; },
        statusOptions() {
            return [{ value: 'online', dot: 'online', label: t('Online') }, { value: 'away', dot: 'away', label: t('Away') },
                { value: 'dnd', dot: 'dnd', label: t('Do not disturb') }, { value: 'invisible', dot: 'offline', label: t('Invisible') }];
        },
        myStatusText() {
            const me = this.myStatus;
            const option = this.statusOptions.find((item) => item.value === (me.status || 'online')) || this.statusOptions[0];
            return me.statusText || me.emoji ? ((me.emoji ? me.emoji + ' ' : '') + (me.statusText || '')) : option.label;
        },
        memberRooms() { return this.rooms.filter((room) => room.isMember); },
        filterItems() {
            const unread = this.memberRooms.filter((room) => this.countsOf(room).unread || this.countsOf(room).mentions).length;
            const mentions = this.memberRooms.filter((room) => this.countsOf(room).mentions).length;
            return [{ value: 'all', label: t('All') }, { value: 'unread', label: t('Unread'), count: unread }, { value: 'mentions', label: t('Mentions'), count: mentions },
                { value: 'direct', label: t('Direct') }, { value: 'rooms', label: t('Rooms') }, { value: 'records', label: t('Records') }];
        },
        shownRooms() {
            const text = String(this.search || '').trim().toLowerCase();
            return this.rooms.filter((room) => {
                const counts = this.countsOf(room);
                if (this.filter === 'unread' && !(counts.unread || counts.mentions)) return false;
                if (this.filter === 'mentions' && !counts.mentions) return false;
                if (this.filter === 'direct' && room.roomTypeEnumId !== 'CrtDirect') return false;
                if (this.filter === 'rooms' && !(room.roomTypeEnumId === 'CrtPrivate' || room.roomTypeEnumId === 'CrtPublic')) return false;
                if (this.filter === 'records' && room.roomTypeEnumId !== 'CrtRecord') return false;
                if (text) {
                    const hay = [room.displayName, room.topic, room.record && room.record.title, room.lastMessage && room.lastMessage.snippet].join(' ').toLowerCase();
                    if (hay.indexOf(text) < 0) return false;
                }
                return true;
            });
        },
        groups() {
            const shown = this.shownRooms;
            if (this.filter !== 'all' || String(this.search || '').trim()) return [{ key: 'found', label: null, rows: shown }];
            const pinned = shown.filter((room) => room.isPinned);
            const rest = shown.filter((room) => !room.isPinned);
            const out = [];
            if (pinned.length) out.push({ key: 'pinned', label: t('Pinned'), rows: pinned });
            if (rest.length) out.push({ key: 'recent', label: pinned.length ? t('Recent') : null, rows: rest });
            return out;
        }
    },
    watch: {
        // a room change opens that room; the screen is not remounted for it
        '$root.currentParameters': { handler() { if (this.isCurrent()) this.applyParams(); }, deep: true }
    },
    methods: {
        t,
        shortWhen,
        chatPath() {
            const list = this.$root.currentPathList || [];
            const at = list.indexOf('Chat');
            return at > 0 && list[at - 1] !== 'Panel' ? list.slice(0, at + 1).join('/') : 'Comms/Chat';
        },
        isCurrent() { const list = this.$root.currentPathList || []; return list[list.length - 1] === 'Chat' && list[list.length - 2] !== 'Panel'; },
        url(name) { return this.base + '/' + name; },
        go(target) { if (target) this.$root.setUrl(target); },
        get(name, params) {
            return moqui.request(this.url(name), { params: params || {} }).then((result) => result.json || {}, (err) => { moqui.handleAjaxError(err); throw err; });
        },
        post(name, params) {
            return moqui.request(this.url(name), { method: 'POST', params: params || {} }).then((result) => {
                const json = result.json || {};
                if (json.messageInfos && json.messageInfos.length) moqui.notifyMessages(json.messageInfos, json.errors);
                return json;
            }, (err) => { moqui.handleAjaxError(err); throw err; });
        },
        roomIcon(room) { return (room.record && room.record.icon) || ROOM_ICONS[room.roomTypeEnumId] || 'sym_o_chat'; },
        bridgeText(room) {
            const names = (room.bridgeNetworkNames || []).join(', ');
            return room.notConnected ? fill(t('Not connected to {names}: messages wait here'), { names }) : fill(t('Also on {names}'), { names });
        },
        countsOf(room) {
            if (!room.isMember) return { unread: 0, mentions: 0 };
            if (moqui.chat && moqui.chat.state.unread[room.chatRoomId]) return moqui.chat.unreadOf(moqui.chat.state, room.chatRoomId);
            return { unread: room.unreadCount || 0, mentions: room.mentionCount || 0 };
        },
        snippetOf(room) {
            const last = room.lastMessage;
            if (!room.isMember) return t('Public room: not joined');
            if (!last) return room.topic || t('No messages yet');
            const who = last.senderUserId === this.me.userId ? t('You') : String(last.senderName || '').split(' ')[0];
            const text = last.encrypted ? t('Encrypted message') : last.redacted || !last.snippet ? t('Message removed') : last.snippet;
            return room.roomTypeEnumId === 'CrtDirect' && last.senderUserId !== this.me.userId && room.otherUserId ? text : (who ? who + ': ' : '') + text;
        },
        clearLabel(value) { return t(CLEAR_LABELS[String(value)] || CLEAR_LABELS['0']); },
        clearFilters() { this.filter = 'all'; this.search = ''; },

        // ---- the room in the URL ----
        applyParams() {
            const p = this.params;
            if (p.dm) { this.startDirect(String(p.dm).split(','), true); return; }
            if (p.recordEntity && p.recordId) { this.openRecordRoom(p.recordEntity, p.recordId); return; }
            this.roomId = p.chatRoomId || null;
            this.seq = p.eventSeq ? Number(p.eventSeq) : null;
            this.thread = p.thread ? Number(p.thread) : null;
        },
        openRoom(id) {
            if (!id) return;
            if (id === this.roomId && !this.seq) return;
            this.$root.setUrl(this.linkBase + '?chatRoomId=' + encodeURIComponent(id));
        },
        // the room a dm or record link found, in place of that link in the history
        replaceRoom(id) {
            const target = this.linkBase + (id ? '?chatRoomId=' + encodeURIComponent(id) : '');
            this.$root.setUrl(target, null, null, false);
            try { window.history.replaceState(null, document.title, target); } catch (err) { /* the history stays */ }
        },
        closeRoom() { this.$root.setUrl(this.linkBase); },
        setThread(seq) { this.$root.setParameters({ thread: seq || null }); },
        onLeft(id) { if (this.roomId === id) this.closeRoom(); this.scheduleRooms(); },
        onRoomRead(id) {
            if (moqui.chat) moqui.chat.state.unread[id] = { unread: 0, mentions: 0 };
            const room = this.rooms.find((item) => item.chatRoomId === id);
            if (room) { room.unreadCount = 0; room.mentionCount = 0; }
        },

        // ---- the rooms ----
        loadRooms() {
            return this.get('chatData').then((json) => {
                this.me = json.me || {};
                this.prefs = json.prefs || {};
                this.rooms = json.roomList || [];
                if (moqui.chat) this.rooms.forEach((room) => {
                    if (room.isMember && room.chatRoomId !== this.roomId) moqui.chat.state.unread[room.chatRoomId] = { unread: room.unreadCount || 0, mentions: room.mentionCount || 0 };
                    if (room.otherUserId && room.presence && !moqui.chat.state.presence[room.otherUserId]) moqui.chat.state.presence[room.otherUserId] = { presence: room.presence, at: Date.now() };
                });
                this.loaded = true;
            }, () => { this.loaded = true; });
        },
        scheduleRooms() { clearTimeout(this.roomsTimer); this.roomsTimer = setTimeout(() => this.loadRooms(), 400); },
        sortRooms() {
            this.rooms.sort((left, right) => {
                if (left.isMember !== right.isMember) return left.isMember ? -1 : 1;
                if (left.isPinned !== right.isPinned) return left.isPinned ? -1 : 1;
                return (right.lastEventDate || 0) - (left.lastEventDate || 0);
            });
        },
        // a push of the page's chat store: the room's last message and its place in the rail
        onEvent(payload) {
            const event = payload && payload.event;
            if (!event) return;
            const room = this.rooms.find((item) => item.chatRoomId === payload.chatRoomId);
            if (!room) { this.scheduleRooms(); return; }
            const me = this.me.userId;
            room.lastEventSeq = Math.max(Number(room.lastEventSeq || 0), Number(event.eventSeq));
            if (event.type === 'message' && event.threadRootEventSeq == null) {
                const text = String(event.bodyText || '').replace(/\s+/g, ' ').trim();
                room.lastMessage = { eventSeq: event.eventSeq, senderUserId: event.senderUserId, senderName: event.senderName, sentDate: event.sentDate,
                    snippet: event.encrypted ? null : (text.length > 140 ? text.slice(0, 139) + '…' : text) || (event.attachments || []).map((file) => '📎 ' + file.fileName).join(', '),
                    redacted: false, encrypted: !!event.encrypted };
                room.lastEventDate = event.sentDate;
            } else if (event.type === 'edit' && room.lastMessage && Number(event.editsEventSeq) === Number(room.lastMessage.eventSeq)) {
                room.lastMessage.snippet = String(event.bodyText || '').replace(/\s+/g, ' ').trim();
            } else if (event.type === 'redaction' && room.lastMessage && Number(event.relatesToEventSeq) === Number(room.lastMessage.eventSeq)) {
                this.scheduleRooms();
            }
            if (event.type === 'message' && event.senderUserId !== me && room.chatRoomId !== this.roomId) {
                const mentioned = (event.mentions || []).includes(me);
                const wants = mentioned || ((room.notificationLevelEnumId || 'CnlAll') === 'CnlAll' && !room.isMuted);
                if (wants && this.prefs.sounds !== false && !(moqui.chat && moqui.chat.quiet())) chime();
            }
            this.sortRooms();
        },
        onRoomSignal() { this.scheduleRooms(); },
        onReadSignal(payload) {
            if (!payload || (payload.userId && payload.userId !== this.me.userId)) return;
            if (payload.all) this.rooms.forEach((room) => { room.unreadCount = 0; room.mentionCount = 0; });
            else {
                const room = this.rooms.find((item) => item.chatRoomId === payload.chatRoomId);
                if (room) { room.unreadCount = 0; room.mentionCount = 0; }
            }
        },
        readDrafts() {
            const out = {};
            const prefix = draftPrefix();
            storage.keys(prefix).forEach((key) => { const id = key.slice(prefix.length); if (id.indexOf(':') < 0) out[id] = true; });
            this.drafts = out;
        },
        markAllRead() {
            this.post('markAllRead', {}).then(() => {
                if (moqui.chat) Object.keys(moqui.chat.state.unread).forEach((id) => { moqui.chat.state.unread[id] = { unread: 0, mentions: 0 }; });
                this.rooms.forEach((room) => { room.unreadCount = 0; room.mentionCount = 0; });
            }, () => {});
        },
        moveRoom(step, unreadOnly) {
            const list = this.shownRooms.filter((room) => !unreadOnly || this.countsOf(room).unread || this.countsOf(room).mentions || room.chatRoomId === this.roomId);
            if (!list.length) return false;
            const at = list.findIndex((room) => room.chatRoomId === this.roomId);
            let next = at < 0 ? (step > 0 ? 0 : list.length - 1) : at + step;
            if (unreadOnly && at >= 0) {
                next = -1;
                for (let i = at + step; i >= 0 && i < list.length; i += step) if (list[i].chatRoomId !== this.roomId) { next = i; break; }
            }
            if (next < 0 || next >= list.length) return true;
            this.openRoom(list[next].chatRoomId);
            return true;
        },

        // ---- my status ----
        setStatus(status) { if (moqui.chat) moqui.chat.setStatus({ status }); },
        usePreset(preset) {
            if (!moqui.chat) return;
            const clear = String(preset.clearAfter || '0');
            const params = { statusText: preset.text || '', emoji: preset.emoji || '' };
            if (clear === '0') params.clearAfterMinutes = 0;
            else params.clearAt = /^\d+$/.test(clear) ? Number(clear) : clear;
            moqui.chat.setStatus(params);
        },
        clearStatus() { if (moqui.chat) moqui.chat.setStatus({ clearStatus: true }); },

        // ---- new conversations ----
        openNewDirect() { this.newDirect = { open: true, userIds: [], busy: false }; },
        openNewRoom() { this.newRoom = { open: true, type: 'private', name: '', topic: '', userIds: [], busy: false, encrypted: false }; },
        startDirect(userIds, fromLink) {
            const ids = (userIds || this.newDirect.userIds || []).map((id) => String(id).trim()).filter((id) => id);
            if (!ids.length) return;
            this.newDirect.busy = true;
            this.post('createDirect', { userIds: ids.join(',') }).then((json) => {
                this.newDirect = { open: false, userIds: [], busy: false };
                this.scheduleRooms();
                if (fromLink) this.replaceRoom(json.chatRoomId); else this.openRoom(json.chatRoomId);
            }, () => { this.newDirect.busy = false; if (fromLink) this.replaceRoom(null); });
        },
        createRoom() {
            this.newRoom.busy = true;
            this.post('createRoom', { roomTypeEnumId: this.newRoom.type, roomName: this.newRoom.name, topic: this.newRoom.topic || '',
                memberUserIds: (this.newRoom.userIds || []).join(','), encrypted: this.newRoom.type !== 'public' && this.newRoom.encrypted ? 'true' : 'false' }).then((json) => {
                this.newRoom = { open: false, type: 'private', name: '', topic: '', userIds: [], busy: false, encrypted: false };
                this.scheduleRooms();
                this.openRoom(json.chatRoomId);
            }, () => { this.newRoom.busy = false; });
        },
        openRecordRoom(recordEntity, recordId) {
            this.post('recordRoom', { recordEntity, recordId }).then((json) => {
                this.scheduleRooms();
                this.replaceRoom(json.chatRoomId);
            }, () => this.replaceRoom(null));
        },
        openBrowse() { this.browse = { open: true, search: '', list: [], loading: false }; this.loadBrowse(); },
        loadBrowse() {
            this.browse.loading = true;
            this.get('rooms', { joinableOnly: 'true', searchText: this.browse.search || '' }).then((json) => {
                this.browse.list = json.roomList || [];
                this.browse.loading = false;
            }, () => { this.browse.loading = false; });
        },
        viewBrowsed(room) { this.browse.open = false; this.openRoom(room.chatRoomId); },
        joinBrowsed(room) {
            this.post('join', { chatRoomId: room.chatRoomId }).then(() => {
                this.browse.open = false;
                this.scheduleRooms();
                this.openRoom(room.chatRoomId);
            }, () => {});
        },

        // ---- the page ----
        measure() {
            const box = this.$el && this.$el.querySelector ? this.$el.querySelector('.m-chat') : null;
            if (!box || !box.getBoundingClientRect) return;
            const top = box.getBoundingClientRect().top + (window.scrollY || 0);
            const footer = document.querySelector('.q-footer');
            this.height = Math.max(this.stacked ? 420 : 480, window.innerHeight - top - (footer ? footer.offsetHeight : 0) - 6);
            this.$nextTick(() => {
                const over = document.documentElement.scrollHeight - window.innerHeight;
                if (over > 0 && over < 80 && this.height - over >= (this.stacked ? 420 : 480)) this.height -= over;
            });
        },
        escape() { const room = this.$refs.room; return room ? room.onEscape() : false; },
        registerKeys() {
            if (!moqui.keymap || !moqui.keymap.registerScope) return;
            const key = (keys, label, run, action, when) => ({ keys, label, action: action || keys, when, run: (event) => run(event) !== false });
            this.unregisterKeys = moqui.keymap.registerScope('Chat', [
                key('Alt+Up', t('Previous room'), () => this.moveRoom(-1, false), 'previousRoom'),
                key('Alt+Down', t('Next room'), () => this.moveRoom(1, false), 'nextRoom'),
                key('Alt+Shift+Up', t('Previous unread room'), () => this.moveRoom(-1, true), 'previousUnreadRoom'),
                key('Alt+Shift+Down', t('Next unread room'), () => this.moveRoom(1, true), 'nextUnreadRoom'),
                key('Esc', t('Mark the room read and close the side pane'), () => this.escape(), 'markRoomRead', () => !this.$root.trayOpen && !!this.$refs.room),
                key('Shift+Esc', t('Mark every room read'), () => { this.markAllRead(); return true; }, 'markAllRead')
            ]);
        }
    },
    mounted() {
        this.measure();
        this.onResize = () => this.measure();
        window.addEventListener('resize', this.onResize);
        this.onDraft = () => this.readDrafts();
        window.addEventListener('boss-chat-draft', this.onDraft);
        this.readDrafts();
        this.unsubscribe = [];
        if (moqui.chat) {
            this.unsubscribe.push(moqui.chat.on('event', (payload) => this.onEvent(payload)));
            this.unsubscribe.push(moqui.chat.on('room', (payload) => this.onRoomSignal(payload)));
            this.unsubscribe.push(moqui.chat.on('read', (payload) => this.onReadSignal(payload)));
        }
        this.registerKeys();
        this.loadRooms().then(() => this.$nextTick(() => this.measure()));
        this.applyParams();
        setTimeout(() => this.measure(), 300);
    },
    beforeUnmount() {
        window.removeEventListener('resize', this.onResize);
        window.removeEventListener('boss-chat-draft', this.onDraft);
        (this.unsubscribe || []).forEach((off) => off());
        if (this.unregisterKeys) this.unregisterKeys();
        clearTimeout(this.roomsTimer);
    }
};
</script>
