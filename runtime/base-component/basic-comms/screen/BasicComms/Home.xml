<!-- Comms Home (mr-boss design-drawers-commons.md §12 Home; style-guide §3.1 Landing; plans/archive/Comms-Framework.md D-A4): the
    counters (the unread of each mail account, flagged, snoozed until today, mentions, and mail that could not be sent), each a
    number card into the Inbox view it counts; Needs reply (the mail threads waiting for the user's answer); the chat rooms
    with unread; the shortcuts (Compose, New room, Add a mail account
    until there is one). A mail account whose sign-in or sync failed is named at the top with the way to fix it. The data is
    get#CommsHome through org.moqui.comms.InboxServices.run#Operation (an app's own Home data when it answers the inbox), which
    reads each part on its own: one that fails is left out and said so. An app adds its boxes with a screen-extend into
    HomeMain (before the rooms) and after HomeShortcuts. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Home" default-menu-index="1" menu-image="sym_o_dashboard" menu-image-type="icon">

    <actions>
        <service-call name="org.moqui.comms.InboxServices.run#Operation" in-map="{operation: 'get#CommsHome'}" out-map="homeOut"/>
        <set field="home" from="homeOut?.result || {}"/>
        <!-- the apps' own boxes (home-source providers), after the Home's parts whoever answered them -->
        <service-call name="org.moqui.comms.CommsHomeServices.get#HomeSources" out-map="sourcesOut"/>
        <set field="appLink" from="'/qapps/' + (appRoot || 'BasicComms')"/>
        <script><![CDATA[
            const L = (text) => ec.l10n.localize(text)
            cardList = Array.from(home?.cardList || [])
            needsReplyList = Array.from(home?.needsReplyList || [])
            followUpList = Array.from(home?.followUpList || [])
            meetingList = Array.from(home?.meetingList || [])
            roomList = Array.from(home?.roomList || [])
            hasMailAccount = home?.hasMailAccount === true
            problemAccountList = Array.from(home?.problemAccountList || [])
            failedParts = Array.from(home?.failedParts || []).concat(Array.from(sourcesOut?.failedParts || []))
            sourceCardList = Array.from(sourcesOut?.cardList || [])
            todayLabel = ec.l10n.format(new Date(Number(ec.user.nowTimestamp)), 'EEEE, MMMM d')
            roomList.forEach((room) => { room.countText = room.mentionCount ? ec.resource.expand(room.mentionCount === 1 ? '${n} unread, 1 mention' : '${n} unread, ${m} mentions', '',
                    {n: room.unreadCount, m: room.mentionCount})
                : ec.resource.expand('${n} unread', '', {n: room.unreadCount}) })
        ]]></script>
    </actions>

    <widgets>
        <container style="q-mb-md">
            <label type="h5" text="Comms" style="q-my-none"/>
            <label type="div" text="${todayLabel}" style="text-caption m-muted"/>
        </container>

        <section-iterate name="ProblemAccounts" list="problemAccountList" entry="problem"><widgets>
            <render-mode><text type="qvt"><![CDATA[<q-banner dense rounded class="m-tonal text-negative q-mb-sm"><template v-slot:avatar><q-icon name="sym_o_sync_problem"></q-icon></template>]]></text><text type="tui" template="false">[]</text></render-mode>
            <label type="span" text="${problem.accountName}: ${problem.problemText}; its mail is not syncing.${problem.canManage ? '' : ' Its owner can fix it.'}"/>
            <section name="ProblemFix" condition="problem.canManage"><widgets>
                <render-mode><text type="qvt"><![CDATA[<template v-slot:action>]]></text><text type="tui" template="false">[]</text></render-mode>
                <link url="${problem.link}" url-type="plain" text="Fix" icon="sym_o_key" btn-type="primary"/>
                <render-mode><text type="qvt"><![CDATA[</template>]]></text><text type="tui" template="false">[]</text></render-mode>
            </widgets></section>
            <render-mode><text type="qvt"><![CDATA[</q-banner>]]></text><text type="tui" template="false">[]</text></render-mode>
        </widgets></section-iterate>

        <!-- no mail account yet: the way in -->
        <section name="AddAccount" condition="!hasMailAccount"><widgets>
            <container-box type="info"><box-header title="Read your email here"/><box-body>
                <label type="p" text="Add your email account (Gmail, Outlook.com, Yahoo, iCloud, your own domain) and your mail is here next to your chat."/>
                <link url="${appLink}/Settings/MailAccounts/Add?fresh=Y" url-type="plain" text="Add your email account" icon="sym_o_mail" btn-type="primary"/>
            </box-body></container-box>
        </widgets></section>

        <!-- the counters, each into the Inbox view it counts -->
        <dashboard min-width="170" style="q-mb-md">
            <section-iterate name="Counters" list="cardList" entry="card"><widgets>
                <number-card title="${card.title}" value="${card.value}" icon="${card.icon}" link="${card.link}"/>
            </widgets></section-iterate>
        </dashboard>

        <section name="Failed" condition="failedParts.length"><widgets>
            <label type="p" text="Some parts could not be read just now and are left out." style="text-caption text-warning"/>
        </widgets></section>

        <container-row>
            <row-col md="8" id="HomeMain">
                <!-- the mail waiting for the user's answer; an app's Home answer fills it with its own (IronStone: internal
                    messages too) -->
                <section name="NeedsReplyBox" condition="hasMailAccount || needsReplyList.length"><widgets>
                    <container-box id="HomeNeedsReply"><box-header title="Needs reply"/><box-toolbar>
                        <link url="${appLink}/Inbox" url-type="plain" link-type="anchor" text="Inbox"/>
                    </box-toolbar><box-body-nopad>
                        <form-list name="NeedsReply" list="needsReplyList" skip-form="true" skip-header="true" paginate="false">
                            <field name="subject"><default-field><link url="${link}" url-type="plain" text="${subject}"/></default-field></field>
                            <field name="who"><default-field><display style="text-caption"/></default-field></field>
                            <field name="whenText" align="right"><default-field><display style="text-caption m-muted text-no-wrap"/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="subject"/><field-ref name="who"/></column>
                                <column><field-ref name="whenText"/></column>
                            </columns>
                        </form-list>
                        <section name="NoNeedsReply" condition="!needsReplyList.length"><widgets>
                            <label type="p" text="Nothing waiting for your answer" style="m-muted q-pa-sm q-mb-none"/>
                        </widgets></section>
                    </box-body-nopad></container-box>
                </widgets></section>
                <container-box id="HomeRooms"><box-header title="Rooms with unread"/><box-toolbar>
                    <link url="${appLink}/Chat" url-type="plain" link-type="anchor" text="Chat"/>
                </box-toolbar><box-body-nopad>
                    <form-list name="RoomsUnread" list="roomList" skip-form="true" skip-header="true" paginate="false">
                        <field name="name"><default-field><link url="${link}" url-type="plain" text="${name}"/></default-field></field>
                        <field name="countText" align="right"><default-field><display style="${mentionCount ? 'text-caption text-primary text-weight-medium text-no-wrap' : 'text-caption text-no-wrap'}"/></default-field></field>
                        <columns type="mobile">
                            <column><field-ref name="name"/></column>
                            <column><field-ref name="countText"/></column>
                        </columns>
                    </form-list>
                    <section name="NoRooms" condition="!roomList.length"><widgets>
                        <label type="p" text="Nothing new in your rooms" style="m-muted q-pa-sm q-mb-none"/>
                    </widgets></section>
                </box-body-nopad></container-box>
            </row-col>
            <row-col md="4">
                <container-box id="HomeShortcuts"><box-header title="Shortcuts"/><box-body>
                    <render-mode><text type="qvt"><![CDATA[<div class="row q-gutter-sm">
                        <q-btn unelevated dense no-caps class="m-btn-tonal" icon="sym_o_edit_square" @click="$root.openQuickCreate && $root.openQuickCreate(($root.quickCreateItems || []).find((kind) => kind.kind === 'email'))">]]></text><text type="tui" template="false">[]</text></render-mode>
                    <label type="span" text="Compose" style="q-ml-sm"/>
                    <render-mode><text type="qvt"><![CDATA[</q-btn><q-btn unelevated dense no-caps class="m-btn-tonal" icon="sym_o_add_comment" @click="$root.setUrl('${appLink}/Chat')">]]></text><text type="tui" template="false">[]</text></render-mode>
                    <label type="span" text="New room" style="q-ml-sm"/>
                    <render-mode><text type="qvt"><![CDATA[</q-btn><q-btn v-if="${hasMailAccount ? 'false' : 'true'}" unelevated dense no-caps class="m-btn-tonal" icon="sym_o_add" @click="$root.setUrl('${appLink}/Settings/MailAccounts/Add?fresh=Y')">]]></text><text type="tui" template="false">[]</text></render-mode>
                    <label type="span" text="Add a mail account" style="q-ml-sm"/>
                    <render-mode><text type="qvt"><![CDATA[</q-btn><q-btn unelevated dense no-caps class="m-btn-tonal" icon="sym_o_settings" @click="$root.setUrl('${appLink}/Settings')">]]></text><text type="tui" template="false">[]</text></render-mode>
                    <label type="span" text="Settings" style="q-ml-sm"/>
                    <render-mode><text type="qvt"><![CDATA[</q-btn></div>]]></text><text type="tui" template="false">[]</text></render-mode>
                </box-body></container-box>

                <!-- the boxes of the apps' home-source providers (IronStone: the mailboxes with unread) -->
                <section-iterate name="SourceCards" list="sourceCardList" entry="sourceCard"><widgets>
                    <container-box><box-header title="${sourceCard.title}"/>
                        <box-toolbar><section name="SourceCardLink" condition="sourceCard.link"><widgets>
                            <link url="${sourceCard.link}" url-type="plain" link-type="anchor" text="${sourceCard.linkText || ec.l10n.localize('More')}"/>
                        </widgets></section></box-toolbar>
                        <box-body-nopad>
                        <form-list name="SourceCardRows" list="sourceCard.rowList" skip-form="true" skip-header="true" paginate="false">
                            <field name="title"><default-field><link url="${link || ''}" url-type="plain" text="${title}"/></default-field></field>
                            <field name="countText" align="right"><default-field><display text="${countText || detail || ''}" style="text-caption text-weight-medium text-no-wrap"/></default-field></field>
                        </form-list>
                        <section name="SourceCardEmpty" condition="!sourceCard.rowList.length"><widgets>
                            <label type="p" text="${sourceCard.emptyText || ec.l10n.localize('Nothing new')}" style="m-muted q-pa-sm q-mb-none"/>
                        </widgets></section>
                    </box-body-nopad></container-box>
                </widgets></section-iterate>

            </row-col>
        </container-row>
    </widgets>
</screen>
