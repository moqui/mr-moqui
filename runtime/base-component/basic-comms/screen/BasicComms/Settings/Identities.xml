<!-- Identities and signatures (mr-boss design-drawers-commons.md §17 Identities): per mail account the user may send from, the names
    and addresses it sends as, each with its reply-to, signature (m-rich-text), where the signature goes (below or above the
    quote), whether it goes on replies too, and the default. A manager of the account adds, changes, makes default and deletes
    (org.moqui.comms.MailSettingsServices store#Identity, which cleans the signature as safe HTML, and the framework's identity
    services, which check the permission); a member who only sends sees them. An address added must be one the provider lets
    the account send as (an alias), or the provider rewrites or refuses it. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Identities and signatures" default-menu-index="2" menu-image="sym_o_person" menu-image-type="icon">

    <transition name="storeIdentity">
        <service-call name="org.moqui.comms.MailSettingsServices.store#Identity" in-map="{emailIdentityId:emailIdentityId, emailAccountId:emailAccountId,
                emailAddress:emailAddress, displayName:displayName, replyToAddress:replyToAddress, signatureHtml:signatureHtml,
                signaturePlacementEnumId:signaturePlacementEnumId, useForReplies:(useForReplies == 'Y' ? 'Y' : 'N'), isDefault:isDefault}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Identity saved</message></if></actions>
        <default-response url="."/>
    </transition>
    <transition name="makeDefault">
        <service-call name="org.moqui.impl.EmailClientServices.update#EmailIdentity" in-map="{emailIdentityId:emailIdentityId, isDefault:true}"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteIdentity">
        <service-call name="org.moqui.impl.EmailClientServices.delete#EmailIdentity" in-map="{emailIdentityId:emailIdentityId}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Identity deleted</message></if></actions>
        <default-response url="."/>
    </transition>

    <actions>
        <service-call name="org.moqui.comms.MailSettingsServices.get#IdentitySettings" out-map="identitiesOut"/>
        <script><![CDATA[
            identityAccounts = Array.from(identitiesOut?.accountList || [])
            hasAccounts = identityAccounts.length > 0
        ]]></script>
    </actions>
    <widgets>
        <label type="h5" text="Identities and signatures" style="q-mt-none q-mb-xs"/>
        <label type="p" text="The name and address people see on the mail you send, the address their replies go to, and your signature. Add an address only when your provider lets the account send as it (an alias)." style="m-muted"/>

        <section name="NoAccounts" condition="!hasAccounts"><widgets>
            <container-box type="info"><box-body>
                <label type="p" text="Add a mail account first: its address is your first identity."/>
                <link url="../MailAccounts/Add" text="Add an account" icon="sym_o_add" btn-type="primary" parameter-map="{fresh:'Y'}"/>
            </box-body></container-box>
        </widgets></section>

        <section-iterate name="IdentityAccounts" list="identityAccounts" entry="account"><widgets>
            <container-box><box-header title="${account.accountName}"/>
                <box-toolbar>
                    <container-dialog id="NewIdentityDialog" button-text="Add an identity" icon="sym_o_add" width="640" title="Add an identity to ${account.accountName}"
                            condition="account.canManage">
                        <form-single name="NewIdentity" transition="storeIdentity" focus-field="displayName">
                            <field name="emailAccountId" from="account.emailAccountId"><default-field><hidden/></default-field></field>
                            <field name="displayName" from="ec.user.userAccount?.userFullName || ''"><default-field title="Name"><text-line size="30"/></default-field></field>
                            <field name="emailAddress" from="account.emailAddress"><default-field title="Address"><text-line size="40" input-type="email"/></default-field></field>
                            <field name="replyToAddress"><default-field title="Replies go to" tooltip="Empty: replies come back to the address above"><text-line size="40" input-type="email"/></default-field></field>
                            <field name="signatureHtml"><default-field title="Signature"><text-area rows="4" cols="60" editor-type="rich"/></default-field></field>
                            <field name="signaturePlacementEnumId" from="'EspBelowQuote'"><default-field title="In a reply, the signature goes"><radio no-current-selected-key="EspBelowQuote">
                                <option key="EspBelowQuote" text="Below the quoted message"/><option key="EspAboveQuote" text="Above the quoted message"/></radio></default-field></field>
                            <field name="useForReplies" from="'Y'"><default-field title=""><check><option key="Y" text="Also on replies and forwards"/></check></default-field></field>
                            <field name="isDefault"><default-field title=""><check><option key="Y" text="Make it the default for new mail"/></check></default-field></field>
                            <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                            <field-layout>
                                <field-ref name="emailAccountId"/>
                                <field-row><field-ref name="displayName"/><field-ref name="emailAddress"/></field-row>
                                <field-ref name="replyToAddress"/><field-ref name="signatureHtml"/><field-ref name="signaturePlacementEnumId"/>
                                <field-row><field-ref name="useForReplies"/><field-ref name="isDefault"/></field-row>
                                <field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </container-dialog>
                </box-toolbar>
                <box-body-nopad>
                    <label type="p" text="${account.emailAddress}${account.canManage ? '' : ' · managed by its owner'}" style="text-caption m-muted q-px-sm q-pt-sm q-mb-none"/>
                    <form-list name="IdentityList" list="account.identityRows" skip-form="true" paginate="false">
                        <field name="nameText"><default-field title="Sends as"><display style="text-weight-medium"/></default-field></field>
                        <field name="defaultText"><default-field title=""><display style="text-caption text-primary"/></default-field></field>
                        <field name="replyToAddress"><default-field title="Replies go to"><display style="text-caption"/></default-field></field>
                        <field name="signatureText"><default-field title="Signature"><display style="text-caption m-muted"/></default-field></field>
                        <field name="placementText"><default-field title="In replies"><display style="text-caption"/></default-field></field>
                        <field name="tools" align="right"><conditional-field condition="canManage" title="">
                            <container-dialog id="EditIdentityDialog" button-text="Edit" icon="sym_o_edit" width="640" title="${ec.l10n.localize('Edit')} ${nameText}">
                                <form-single name="EditIdentity" transition="storeIdentity">
                                    <field name="emailIdentityId" from="emailIdentityId"><default-field><hidden/></default-field></field>
                                    <field name="displayName" from="displayName"><default-field title="Name"><text-line size="30"/></default-field></field>
                                    <field name="emailAddress" from="emailAddress"><default-field title="Address"><text-line size="40" input-type="email"/></default-field></field>
                                    <field name="replyToAddress" from="replyToAddress"><default-field title="Replies go to" tooltip="Empty: replies come back to the address above"><text-line size="40" input-type="email"/></default-field></field>
                                    <field name="signatureHtml" from="signatureHtml"><default-field title="Signature"><text-area rows="4" cols="60" editor-type="rich"/></default-field></field>
                                    <field name="signaturePlacementEnumId" from="signaturePlacementEnumId"><default-field title="In a reply, the signature goes"><radio no-current-selected-key="EspBelowQuote">
                                        <option key="EspBelowQuote" text="Below the quoted message"/><option key="EspAboveQuote" text="Above the quoted message"/></radio></default-field></field>
                                    <field name="useForReplies" from="useForReplies"><default-field title=""><check><option key="Y" text="Also on replies and forwards"/></check></default-field></field>
                                    <field name="isDefault" from="isDefault"><default-field title=""><check><option key="Y" text="The default for new mail"/></check></default-field></field>
                                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                                    <field-layout>
                                        <field-ref name="emailIdentityId"/>
                                        <field-row><field-ref name="displayName"/><field-ref name="emailAddress"/></field-row>
                                        <field-ref name="replyToAddress"/><field-ref name="signatureHtml"/><field-ref name="signaturePlacementEnumId"/>
                                        <field-row><field-ref name="useForReplies"/><field-ref name="isDefault"/></field-row>
                                        <field-ref name="submitButton"/>
                                    </field-layout>
                                </form-single>
                            </container-dialog>
                            <link url="makeDefault" link-type="hidden-form-link" text="Make default" condition="isDefault != 'Y'" parameter-map="{emailIdentityId:emailIdentityId}"/>
                            <link url="deleteIdentity" link-type="hidden-form-link" icon="sym_o_delete" text="Delete" tooltip="Delete ${nameText}" style="m-btn-flat" condition="canDelete"
                                    confirmation="Delete the identity ${nameText}? Drafts written as it send as the account's default." parameter-map="{emailIdentityId:emailIdentityId}"/>
                        </conditional-field><default-field title=""><display text=""/></default-field></field>
                        <columns type="mobile">
                            <column><field-ref name="nameText"/><field-ref name="signatureText"/></column>
                            <column><field-ref name="defaultText"/><field-ref name="tools"/></column>
                        </columns>
                    </form-list>
                </box-body-nopad>
            </container-box>
        </widgets></section-iterate>
    </widgets>
</screen>
