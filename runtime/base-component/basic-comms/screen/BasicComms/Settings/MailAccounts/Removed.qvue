<!-- The removed accounts of the account list (Removed.xml): the user's own accounts removed with their mail kept, each with
    its kept mail and "Delete with its mail", which asks first ($q.dialog, Quasar's Dialog plugin) and then deletes it here;
    the list shows nothing once there is none. Brand color names and Quasar classes only (style-guide §4.8, §5). -->
<template><div v-if="list.length" class="m-mail-removed q-mt-md">
    <m-container-box :title="t('Removed accounts')">
        <div class="text-caption m-muted q-mb-xs">{{t('Accounts you removed and whose mail you kept here, for the records it is filed on. They do not sync and are in no list. Nothing on the mail server is touched by deleting them.')}}</div>
        <q-list separator>
            <q-item v-for="account in list" :key="account.emailAccountId" class="q-px-none">
                <q-item-section avatar style="min-width:34px"><q-icon name="sym_o_unsubscribe" class="m-muted"></q-icon></q-item-section>
                <q-item-section>
                    <q-item-label class="text-weight-medium">{{account.accountName}}</q-item-label>
                    <q-item-label v-if="account.emailAddress && account.emailAddress !== account.accountName" caption>{{account.emailAddress}}</q-item-label>
                    <q-item-label caption>{{keptText(account)}}</q-item-label>
                </q-item-section>
                <q-item-section side>
                    <q-btn unelevated dense no-caps class="m-btn-tonal text-negative" icon="sym_o_delete" :label="$q.screen.xs ? undefined : t('Delete with its mail')"
                            :aria-label="t('Delete with its mail')" :loading="busyId === account.emailAccountId" :disable="!!busyId" @click="askDelete(account)"></q-btn>
                </q-item-section>
            </q-item>
        </q-list>
    </m-container-box>
</div></template>

<script>
const t = (text) => (moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text);
const fill = (text, values) => String(text).replace(/\{(\w+)\}/g, (match, key) => (values[key] == null ? '' : String(values[key])));

module.exports = {
    name: 'MailRemovedAccounts',
    inject: { mScreen: { default: null } },
    data() { return { list: [], busyId: null }; },
    computed: {
        base() { return this.mScreen ? this.mScreen.path : this.$root.basePath + '/BasicComms/Settings/MailAccounts/Removed'; }
    },
    methods: {
        t,
        url(name) { return this.base + '/' + name; },
        load() {
            return moqui.request(this.url('removedData'), {}).then((result) => { this.list = (result.json || {}).removedList || []; }, () => { this.list = []; });
        },
        keptText(account) {
            const n = Number(account.keptMessageCount) || 0;
            const kept = n === 1 ? t('1 message kept here') : fill(t('{n} messages kept here'), { n: n.toLocaleString() });
            return account.lastSyncText ? kept + ' · ' + fill(t('last synced {date}'), { date: account.lastSyncText }) : kept;
        },
        askDelete(account) {
            this.$q.dialog({ title: fill(t('Delete {name} and its mail?'), { name: account.accountName }),
                message: t('Its mail here is deleted for good; a message filed on a record is kept there. The mail on the server is not touched.'),
                ok: { label: t('Delete with its mail'), color: 'negative', unelevated: true, noCaps: true },
                cancel: { label: t('Cancel'), flat: true, noCaps: true } }).onOk(() => this.remove(account));
        },
        remove(account) {
            this.busyId = account.emailAccountId;
            moqui.request(this.url('deleteRemoved'), { method: 'POST', params: { emailAccountId: account.emailAccountId } }).then((result) => {
                const json = result.json || {};
                this.busyId = null;
                if (json.messageInfos && json.messageInfos.length) moqui.notifyMessages(json.messageInfos, json.errors || null);
                if (json.errors) { moqui.notifyMessages([], json.errors); return; }
                this.list = this.list.filter((item) => item.emailAccountId !== account.emailAccountId);
            }, (err) => { this.busyId = null; moqui.handleAjaxError(err); });
        }
    },
    mounted() { this.load(); }
};
</script>
