<!-- The mail accounts (mr-boss design-drawers-commons.md §17 MailAccounts, Accounts): the Internal account first, then each account
    the user owns or shares as a card with its status (active, syncing, paused, setup not finished, sign-in failed, sync
    failed, local only), last sync and its error, unread, the servers and members, and what the user may do: Sync now,
    Pause or Resume, Fix (a failed sign-in: the account's page with the password, or the provider's sign-in), Continue setup (a wizard left before its
    end), Settings; while an account syncs its card shows how far it is (the SyncProgress screen, on the emailSyncProgress
    topic). With no mail account yet, a welcome card leads into the wizard. Below, the user's own removed accounts whose mail
    was kept, to delete with their mail (the Removed screen, which asks first). org.moqui.comms.MailSettingsServices
    get#MailAccountList reads them through the framework's access rules; syncNow is the Inbox's sync#UserAccounts. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Accounts" default-menu-index="1" default-menu-include="false">

    <transition name="syncNow">
        <service-call name="org.moqui.comms.MailSettingsServices.sync#UserAccounts" in-map="{emailAccountId:emailAccountId}" out-map="syncOut"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Syncing now; new mail shows in the Inbox as it arrives</message></if></actions>
        <default-response url="."/>
    </transition>
    <transition name="pause">
        <service-call name="org.moqui.comms.MailSettingsServices.set#AccountPaused" in-map="{emailAccountId:emailAccountId, paused:true}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Sync paused</message></if></actions>
        <default-response url="."/>
    </transition>
    <transition name="resume">
        <service-call name="org.moqui.comms.MailSettingsServices.set#AccountPaused" in-map="{emailAccountId:emailAccountId, paused:false}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Sync resumed</message></if></actions>
        <default-response url="."/>
    </transition>

    <actions>
        <service-call name="org.moqui.comms.MailSettingsServices.get#MailAccountList" out-map="listOut"/>
        <script><![CDATA[
            const all = Array.from(listOut?.accountList || [])
            internalAccount = all.find((account) => account.isInternal) || null
            mailAccountList = all.filter((account) => !account.isInternal)
            hasMailAccounts = mailAccountList.length > 0
            problemCount = listOut?.problemCount || 0
            failedCount = Array.from(listOut?.failedParts || []).length
            // the user's own removed accounts with their mail kept: their section only when there is one
            hasRemoved = false
            ec.message.pushErrors()
            try {
                hasRemoved = Array.from(ec.service.sync().name('org.moqui.comms.MailSettingsServices.get#RemovedMailAccounts').call()?.removedList || []).length > 0
                if (ec.message.hasError()) { ec.logger.warn(`Removed mail accounts of ${ec.user.username} not read: ${ec.message.getErrorsString()}`); hasRemoved = false }
            } finally { ec.message.clearErrors(); ec.message.popErrors() }
        ]]></script>
    </actions>
    <widgets>
        <container style="row items-center q-mb-sm">
            <label type="h5" text="Mail accounts" style="q-my-none"/>
            <container style="col"/>
            <link url="../Add" text="Add an account" icon="sym_o_add" btn-type="primary" parameter-map="{fresh:'Y'}"/>
        </container>

        <!-- no mail account yet: what this does, and the way in -->
        <section name="Welcome" condition="!hasMailAccounts"><widgets>
            <container-box type="info"><box-header title="Read and send your email here"/><box-body>
                <label type="p" text="Add your email account and your mail is in the Inbox next to your internal messages: Gmail, Outlook.com, Yahoo, iCloud, Fastmail, your own domain, or any provider with IMAP or POP and SMTP."/>
                <label type="p" text="You need your email address and its password. Gmail and Outlook.com sign in with Google or Microsoft where this server is set up for it; otherwise they, Yahoo, iCloud and Fastmail ask for an app password, which takes a minute to make: the wizard says where." style="m-muted"/>
                <link url="../Add" text="Add your email account" icon="sym_o_mail" btn-type="primary" parameter-map="{fresh:'Y'}"/>
            </box-body></container-box>
        </widgets></section>

        <section name="Problems" condition="problemCount &gt; 1"><widgets>
            <render-mode><text type="qvt"><![CDATA[<q-banner dense rounded class="m-tonal text-negative q-mb-sm"><template v-slot:avatar><q-icon name="sym_o_sync_problem"></q-icon></template>]]></text><text type="tui" template="false">[]</text></render-mode>
            <label type="span" text="${problemCount} accounts need your attention: their mail is not syncing."/>
            <render-mode><text type="qvt"><![CDATA[</q-banner>]]></text><text type="tui" template="false">[]</text></render-mode>
        </widgets></section>
        <section name="Failed" condition="failedCount &gt; 0"><widgets>
            <label type="p" text="Some details of your accounts could not be read just now." style="text-caption text-warning"/>
        </widgets></section>

        <container-row>
            <section-iterate name="AccountCards" list="mailAccountList" entry="account"><widgets>
                <row-col md="6"><container-box type="${account.statusColor == 'negative' ? 'danger' : (account.statusColor == 'warning' ? 'warning' : 'default')}">
                    <box-header title="${account.accountName}"/>
                    <box-toolbar>
                        <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="m-tonal text-${account.statusColor}"><q-spinner v-if="${account.syncing ? 'true' : 'false'}" size="12px" class="q-mr-xs"></q-spinner>]]></text><text type="tui" template="false">[]</text></render-mode>
                        <label type="span" text="${account.statusLabel}"/>
                        <render-mode><text type="qvt"><![CDATA[</q-chip>]]></text><text type="tui" template="false">[]</text></render-mode>
                    </box-toolbar>
                    <box-body>
                        <label type="div" text="${account.emailAddress}" style="text-body2" condition="account.emailAddress != account.accountName"/>
                        <label type="div" text="${account.kindLabel} · ${account.accessText}" style="text-caption m-muted"/>
                        <section name="Problem" condition="account.problemText"><widgets>
                            <label type="p" text="${account.problemText}" style="${account.statusColor == 'negative' ? 'text-negative' : (account.statusColor == 'warning' ? 'text-warning' : 'm-muted')} q-mt-sm q-mb-xs"/>
                        </widgets></section>
                        <section name="SyncError" condition="account.lastSyncError &amp;&amp; account.statusId != 'EasError'"><widgets>
                            <label type="p" text="The last sync said: ${account.lastSyncError}" style="text-caption text-negative q-mb-xs"/>
                        </widgets></section>
                        <container style="row q-col-gutter-sm q-mt-xs">
                            <container style="col-6 col-sm-3"><label type="div" text="Unread" style="text-caption m-muted"/>
                                <label type="div" text="${account.unreadCount != null ? ec.l10n.format(account.unreadCount, '#,##0') : '–'}" style="text-subtitle1"/></container>
                            <container style="col-6 col-sm-3"><label type="div" text="${account.deliveredHere === true ? 'Delivery' : 'Last sync'}" style="text-caption m-muted"/>
                                <label type="div" text="${account.deliveredHere === true ? 'Mail gateway' : (account.lastSyncText || 'Not yet')}" style="text-body2"/></container>
                            <container style="col-6 col-sm-3"><label type="div" text="Folders" style="text-caption m-muted"/>
                                <label type="div" text="${account.folderCount}" style="text-subtitle1"/></container>
                            <container style="col-6 col-sm-3"><label type="div" text="Not sent" style="text-caption m-muted"/>
                                <label type="div" text="${account.outboxErrorCount}" style="${account.outboxErrorCount ? 'text-subtitle1 text-negative' : 'text-subtitle1'}"/></container>
                        </container>
                        <label type="div" text="${account.serverText}" style="text-caption m-muted q-mt-sm ellipsis" condition="account.serverText"/>
                        <label type="div" text="Members: ${account.memberText}" style="text-caption m-muted" condition="account.memberText"/>
                        <label type="div" text="${account.filingText}" style="text-caption m-muted" condition="account.filingText"/>
                        <section name="CardSyncProgress" condition="account.hasServer"><widgets>
                            <dynamic-container id="CardSyncProgress" transition="../SyncProgress">
                                <parameter name="emailAccountId" from="account.emailAccountId"/>
                            </dynamic-container>
                        </widgets></section>
                        <container style="row q-gutter-sm q-mt-sm items-center">
                            <link url="../Account" text="Fix the sign-in" icon="sym_o_key" btn-type="primary" condition="account.canManage &amp;&amp; account.statusId == 'EasAuthFailed'"
                                    parameter-map="{emailAccountId:account.emailAccountId, fix:'Y'}"/>
                            <link url="../Add/Test" text="Continue setup" icon="sym_o_arrow_forward" btn-type="primary" condition="account.setupIncomplete"
                                    parameter-map="{emailAccountId:account.emailAccountId}"/>
                            <link url="syncNow" link-type="hidden-form" text="Sync now" icon="sym_o_sync" condition="account.canSync"
                                    parameter-map="{emailAccountId:account.emailAccountId}"/>
                            <link url="pause" link-type="hidden-form" text="Pause" icon="sym_o_pause" condition="account.canPause &amp;&amp; !account.setupIncomplete"
                                    parameter-map="{emailAccountId:account.emailAccountId}"/>
                            <link url="resume" link-type="hidden-form" text="Resume" icon="sym_o_play_arrow" condition="account.canResume"
                                    parameter-map="{emailAccountId:account.emailAccountId}"/>
                            <link url="../Account" text="${account.canManage ? 'Settings' : 'Details'}" icon="sym_o_settings" parameter-map="{emailAccountId:account.emailAccountId}"/>
                        </container>
                    </box-body>
                </container-box></row-col>
            </widgets></section-iterate>

            <!-- the Internal account: always there, not removable -->
            <section name="Internal" condition="internalAccount"><widgets>
                <row-col md="6"><container-box><box-header title="${internalAccount.accountName}"/>
                    <box-toolbar>
                        <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="m-tonal text-primary">]]></text><text type="tui" template="false">[]</text></render-mode>
                        <label type="span" text="${internalAccount.statusLabel}"/>
                        <render-mode><text type="qvt"><![CDATA[</q-chip>]]></text><text type="tui" template="false">[]</text></render-mode>
                    </box-toolbar>
                    <box-body>
                        <label type="p" text="${internalAccount.accessText}." style="m-muted"/>
                        <container style="row q-gutter-sm">
                            <link url="../../../Inbox" text="Open the Inbox" icon="sym_o_inbox" parameter-map="{view:'internal'}"/>
                        </container>
                    </box-body>
                </container-box></row-col>
            </widgets></section>
        </container-row>

        <section name="RemovedAccounts" condition="hasRemoved"><widgets>
            <dynamic-container id="RemovedMailAccounts" transition="../Removed"/>
        </widgets></section>

        <container style="row q-gutter-sm q-mt-xs">
            <link url="../../Identities" link-type="anchor" text="Identities and signatures"/>
            <link url="../../Rules" link-type="anchor" text="Rules"/>
            <link url="../../OutOfOffice" link-type="anchor" text="Out of office"/>
        </container>
    </widgets>
</screen>
