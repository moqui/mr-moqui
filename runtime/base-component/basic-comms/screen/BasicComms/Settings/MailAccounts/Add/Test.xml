<!-- Add account step 3, the test (mr-boss design-drawers-commons.md §17 AccountTest): signing in to the outgoing and the incoming
    server now (org.moqui.comms.MailSettingsServices.test#MailAccount over org.moqui.impl.EmailClientServices.test#EmailAccount),
    each step with what the server said and, when it failed, what it most likely means and what to try, with the provider's
    help; on success how the server's folders map to Inbox, Sent, Drafts, Spam, Trash and Archive, and Send a test message
    (org.moqui.comms.MailSettingsServices.send#AccountTestMessage: to the account's own address, back in the Inbox with the first
    sync once the wizard ends, as its message says). The test runs each time the
    step shows (Test again reloads it). An account with no incoming server (hosted, or shared and delivered here) is not
    signed in to: the step says the gateway delivers, and Next goes on. Otherwise Next goes on when the test passed, or with
    "Continue anyway" (the account stays as it is and its sync reports the problem). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Test" default-menu-index="3" menu-image="sym_o_network_check" menu-image-type="icon">

    <parameter name="emailAccountId"/>

    <transition name="confirmTest">
        <actions><script><![CDATA[
            if (!emailAccountId) { ec.message.addError(ec.l10n.localize('Connect the account first')); return }
            if (testPassed !== 'Y' && continueAnyway !== 'Y') ec.message.addValidationError(null, 'continueAnyway', null,
                ec.l10n.localize('The test did not pass: go back to fix the settings, or choose Continue anyway'), null)
        ]]></script></actions>
        <default-response url="."><parameter name="emailAccountId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="sendTestMessage">
        <service-call name="org.moqui.comms.MailSettingsServices.send#AccountTestMessage" in-map="{emailAccountId:emailAccountId}" out-map="testMessageOut"/>
        <actions><script>if (!ec.message.hasError() &amp;&amp; testMessageOut?.resultText) ec.message.addMessage(testMessageOut.resultText, testMessageOut.sent ? 'success' : 'danger')</script></actions>
        <default-response url="."><parameter name="emailAccountId"/></default-response>
        <error-response url="."/>
    </transition>

    <actions><script><![CDATA[
        const L = (text) => text.length > 255 ? text : ec.l10n.localize(text)
        hasAccount = false
        testRan = false
        gatewayDelivery = false
        stepRows = []
        folderRows = []
        if (!emailAccountId) return
        const detail = ec.service.sync().name('org.moqui.comms.MailSettingsServices.get#MailAccountDetail').parameter('emailAccountId', emailAccountId).call()
        if (ec.message.hasError() || !detail?.found) { testError = ec.message.hasError() ? ec.message.getErrorsString() : L('Connect the account first'); ec.message.clearErrors(); return }
        if (!detail.server?.storeHost && (detail.account?.accountKindEnumId === 'EakHosted' || detail.account?.isShared === true)) {
            // nothing to sign in to: the gateway delivers (hosted, or shared with no incoming server)
            hasAccount = true
            gatewayDelivery = true
            passed = true
            gatewayAddress = detail.account?.emailAddress || ''
            confirm = {emailAccountId: emailAccountId, testPassed: 'Y', continueAnyway: ''}
            return
        }
        const out = ec.service.sync().name('org.moqui.comms.MailSettingsServices.test#MailAccount').parameter('emailAccountId', emailAccountId).call()
        if (ec.message.hasError()) { testError = ec.message.getErrorsString(); ec.message.clearErrors(); return }
        hasAccount = true
        testRan = true
        passed = out?.success === true
        stepRows = Array.from(out?.stepList || [])
        folderRows = Array.from(out?.folderMap || [])
        adviceText = out?.adviceText || ''
        const provider = out?.provider || null
        helpText = !passed && provider?.helpText ? provider.helpText : null
        helpUrl = !passed && provider?.helpUrl ? provider.helpUrl : null
        helpLinkText = provider?.helpLinkText || L('Where to make it')
        folderCountText = out?.folderCount ? ec.resource.expand('${n} folders on the server', '', {n: out.folderCount}) : ''
        confirm = {emailAccountId: emailAccountId, testPassed: passed ? 'Y' : 'N', continueAnyway: ''}
    ]]></script></actions>
    <widgets>
        <section name="NoAccount" condition="!hasAccount"><widgets>
            <container-box type="warning"><box-body>
                <label type="p" text="${testError || 'Connect the account first.'}" style="q-mb-sm"/>
                <link url="../Connect" text="Connect" icon="sym_o_arrow_back"/>
            </box-body></container-box>
        </widgets></section>
        <section name="Gateway" condition="gatewayDelivery"><widgets>
            <container-box type="success"><box-header title="Delivered here"/><box-body>
                <label type="p" text="Nothing to sign in to. The mail gateway delivers mail for ${gatewayAddress}." style="q-mb-sm"/>
                <label type="p" text="A tag after a plus sign still arrives here: sales+news@example.com goes to sales@example.com." style="m-muted"/>
                <form-single name="AccountGatewayConfirm" transition="confirmTest" map="confirm">
                    <field name="emailAccountId"><default-field><hidden/></default-field></field>
                    <field name="testPassed"><default-field><hidden/></default-field></field>
                    <field name="continueAnyway"><default-field><hidden/></default-field></field>
                </form-single>
            </box-body></container-box>
        </widgets></section>
        <section name="Result" condition="hasAccount &amp;&amp; !gatewayDelivery"><widgets>
            <container-box type="${passed ? 'success' : 'danger'}"><box-header title="${passed ? 'It works' : 'It did not work yet'}"/>
                <box-toolbar>
                    <link url="sendTestMessage" link-type="hidden-form" text="Send a test message" icon="sym_o_send" condition="passed"
                            parameter-map="{emailAccountId:emailAccountId}"/>
                    <link url="." text="Test again" icon="sym_o_refresh" parameter-map="{emailAccountId:emailAccountId}"/>
                </box-toolbar>
                <box-body>
                    <render-mode><text type="qvt"><![CDATA[<q-list dense class="q-mb-sm">]]></text><text type="tui" template="false">[]</text></render-mode>
                    <section-iterate name="TestSteps" list="stepRows" entry="step"><widgets>
                        <render-mode><text type="qvt"><![CDATA[<q-item class="q-px-none"><q-item-section avatar style="min-width:32px"><q-icon name="${step.icon}" color="${step.color}"></q-icon></q-item-section><q-item-section><q-item-label class="text-weight-medium">]]></text><text type="tui" template="false">[]</text></render-mode>
                        <label type="span" text="${step.label}"/>
                        <render-mode><text type="qvt"><![CDATA[</q-item-label><q-item-label caption>]]></text><text type="tui" template="false">[]</text></render-mode>
                        <label type="span" text="${step.message}"/>
                        <render-mode><text type="qvt"><![CDATA[</q-item-label>]]></text><text type="tui" template="false">[]</text></render-mode>
                        <section name="StepHint" condition="step.hint"><widgets>
                            <render-mode><text type="qvt"><![CDATA[<q-item-label class="text-body2 text-negative">]]></text><text type="tui" template="false">[]</text></render-mode>
                            <label type="span" text="${step.hint}"/>
                            <render-mode><text type="qvt"><![CDATA[</q-item-label>]]></text><text type="tui" template="false">[]</text></render-mode>
                        </widgets></section>
                        <render-mode><text type="qvt"><![CDATA[</q-item-section></q-item>]]></text><text type="tui" template="false">[]</text></render-mode>
                    </widgets></section-iterate>
                    <render-mode><text type="qvt"><![CDATA[</q-list>]]></text><text type="tui" template="false">[]</text></render-mode>
                    <label type="p" text="${adviceText}" style="text-weight-medium"/>
                    <section name="Help" condition="helpText"><widgets>
                        <label type="p" text="${helpText}" style="text-body2"/>
                        <section name="HelpLink" condition="helpUrl"><widgets>
                            <render-mode><text type="qvt"><![CDATA[<q-btn unelevated dense no-caps class="m-btn-tonal text-primary q-mb-sm" icon="sym_o_open_in_new" type="a" href="${helpUrl}" target="_blank" rel="noopener noreferrer">]]></text><text type="tui" template="false">[]</text></render-mode>
                            <label type="span" text="${helpLinkText}"/>
                            <render-mode><text type="qvt"><![CDATA[</q-btn>]]></text><text type="tui" template="false">[]</text></render-mode>
                        </widgets></section>
                    </widgets></section>
                    <section name="FixLink" condition="!passed"><widgets>
                        <link url="../Connect" text="Change the password or the server settings" icon="sym_o_edit" parameter-map="{emailAccountId:emailAccountId}"/>
                    </widgets></section>
                    <form-single name="AccountTestConfirm" transition="confirmTest" map="confirm">
                        <field name="emailAccountId"><default-field><hidden/></default-field></field>
                        <field name="testPassed"><default-field><hidden/></default-field></field>
                        <field name="continueAnyway"><conditional-field condition="!passed" title="">
                            <check><option key="Y" text="Continue anyway: the account is added and says what is wrong until it is fixed"/></check></conditional-field>
                            <default-field><hidden/></default-field></field>
                    </form-single>
                </box-body>
            </container-box>
            <section name="Folders" condition="passed &amp;&amp; folderRows.length"><widgets>
                <container-box><box-header title="Folders"/><box-body-nopad>
                    <label type="p" text="How the server's folders show here. ${folderCountText}" style="text-caption m-muted q-pa-sm q-mb-none"/>
                    <form-list name="TestFolderMap" list="folderRows" skip-form="true" skip-header="true" paginate="false">
                        <field name="kindLabel"><default-field title="Here"><display style="text-weight-medium"/></default-field></field>
                        <field name="mappedText"><default-field title="On the server"><display/></default-field></field>
                    </form-list>
                </box-body-nopad></container-box>
            </widgets></section>
        </widgets></section>
    </widgets>
</screen>
