<!-- Add account step 4, options (mr-boss design-drawers-commons.md §17 AccountOptions, §12 the filing policy): the account's name in
    the Inbox, how far back to sync, whether its mail goes on the records of known contacts (a personal account files only
    what its owner links; a shared one every match, said in plain words), whether it is personal or shared (the framework's
    update#EmailAccount rules: shared at any time, personal again only when one person is left on it; the filing follows the
    kind unless chosen), and for a shared account the people who share it and what they may do. Next saves them
    (org.moqui.comms.MailSettingsServices.save#AccountOptions; each member added on its own). The folders the sync maps are shown
    after the test and on the account's page. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Options" default-menu-index="4" menu-image="sym_o_tune" menu-image-type="icon">

    <parameter name="emailAccountId"/>

    <transition name="saveOptions">
        <service-call name="org.moqui.comms.MailSettingsServices.save#AccountOptions" in-map="{emailAccountId:emailAccountId, accountName:accountName,
                syncWindowDays:(syncWindowDays == 'all' ? '' : (syncWindowDays ?? null)), recordFilingEnumId:recordFilingEnumId, memberUserIds:(memberUserIds ?? null),
                memberPermissionEnumId:memberPermissionEnumId, accountKindEnumId:(accountKindEnumId || null)}"/>
        <default-response url="."><parameter name="emailAccountId"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="searchUsers" read-only="true">
        <actions>
            <service-call name="org.moqui.comms.CommsServices.search#Users" in-map="{term:term}" out-map="found"/>
            <script>ec.web.sendJsonResponse(Array.from(found.userList || []).filter((user) =&gt; user.value !== ec.user.userId).map((user) =&gt; ({value: user.value, label: user.label})))</script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions><script><![CDATA[
        hasAccount = false
        memberRows = []
        if (!emailAccountId) return
        const detail = ec.service.sync().name('org.moqui.comms.MailSettingsServices.get#MailAccountDetail').parameter('emailAccountId', emailAccountId).call()
        if (ec.message.hasError() || !detail?.found) { optionsError = ec.message.getErrorsString(); ec.message.clearErrors(); return }
        if (!detail.account?.canManage) { optionsError = ec.l10n.localize('Only a manager of this account changes its options'); return }
        hasAccount = true
        isShared = detail.account.isShared === true
        memberRows = Array.from(detail.memberList || [])
        const saved = detail.options || {}
        options = {emailAccountId: emailAccountId, accountName: saved.accountName || detail.account.emailAddress,
            syncWindowDays: saved.syncWindowDays ? saved.syncWindowDays : 'all', recordFilingEnumId: saved.recordFilingEnumId, memberPermissionEnumId: 'EapSend',
            accountKindEnumId: detail.account.accountKindEnumId}
        const L = (text) => ec.l10n.localize(text)
        kindOptions = [{key: 'EakExternal', text: L('Personal: my own address')}, {key: 'EakShared', text: L('Shared: a team address such as sales@ or support@, read by several people')}]
        if (detail.account.accountKindEnumId === 'EakHosted') kindOptions.unshift({key: 'EakHosted', text: L('Hosted here')})
    ]]></script></actions>
    <widgets>
        <section name="NoAccount" condition="!hasAccount"><widgets>
            <container-box type="warning"><box-body>
                <label type="p" text="${optionsError || 'Connect the account first.'}" style="q-mb-sm"/>
                <link url="../Connect" text="Connect" icon="sym_o_arrow_back"/>
            </box-body></container-box>
        </widgets></section>
        <section name="Options" condition="hasAccount"><widgets>
            <container-box><box-header title="How this account works here"/><box-body>
                <form-single name="AccountOptions" transition="saveOptions" map="options">
                    <field name="emailAccountId"><default-field><hidden/></default-field></field>
                    <field name="accountName"><default-field title="Name in the Inbox" tooltip="Such as Personal, Work or Support"><text-line size="30"/></default-field></field>
                    <field name="syncWindowDays"><default-field title="Bring in mail from"><radio no-current-selected-key="365">
                        <option key="30" text="The last 30 days"/><option key="90" text="The last 3 months"/><option key="365" text="The last year"/>
                        <option key="all" text="All of it (a large mailbox takes a while)"/></radio></default-field></field>
                    <field name="accountKindEnumId"><default-field title="Whose mail is it?"><radio><list-options list="kindOptions" key="${key}" text="${text}"/></radio></default-field></field>
                    <field name="recordFilingEnumId"><default-field title="Put mail on customer and supplier records">
                        <radio no-current-selected-key="ErfLinkedOnly">
                            <option key="ErfLinkedOnly" text="Only what I link: my mail stays private until I link a message to a contact, an order or another record (best for your own mail)"/>
                            <option key="ErfAllMatches" text="Every message with a known contact: mail from or to someone in Contacts goes on their records for the team to see (best for sales@ or support@)"/>
                        </radio></default-field></field>
                    <field name="memberUserIds"><conditional-field condition="isShared" title="Add people who share it">
                        <drop-down allow-multiple="true" allow-empty="true"><dynamic-options transition="searchUsers" server-search="true" min-length="1"/></drop-down></conditional-field>
                        <default-field><ignored/></default-field></field>
                    <field name="memberPermissionEnumId"><conditional-field condition="isShared" title="They may">
                        <radio no-current-selected-key="EapSend"><option key="EapRead" text="Read"/><option key="EapSend" text="Read and send"/>
                            <option key="EapManage" text="Read, send and manage the account"/></radio></conditional-field>
                        <default-field><ignored/></default-field></field>
                </form-single>
            </box-body></container-box>
            <section name="Members" condition="isShared &amp;&amp; memberRows.length"><widgets>
                <container-box><box-header title="Shared with"/><box-body-nopad>
                    <form-list name="WizardMembers" list="memberRows" skip-form="true" skip-header="true" paginate="false">
                        <field name="name"><default-field title="Who"><display/></default-field></field>
                        <field name="permissionText"><default-field title="May"><display style="text-caption"/></default-field></field>
                    </form-list>
                </box-body-nopad></container-box>
            </widgets></section>
        </widgets></section>
    </widgets>
</screen>
