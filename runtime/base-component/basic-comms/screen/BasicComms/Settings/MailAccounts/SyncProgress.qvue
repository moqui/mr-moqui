<!-- The sync progress of one mail account (SyncProgress.xml): its query (mScreen) names the account (emailAccountId). One
    listener per page on the topic emailSyncProgress (notificationClient.registerListener, which returns an unregister
    function). The progress widgets on the page share it, and the last one to leave calls that function, so a gone page
    unsubscribes. Each message
    {emailAccountId, done, folderCount, foldersDone, folderName, folderPath, folderKept, folderFetched, folderToFetch,
    folderPending, fetched, toFetch, pending} shown as "Syncing {folderKept + folderFetched} of {folderKept + folderPending}"
    in the folder, a bar under it, and the end ({done, outcome, message, newCount}) as what came in, with Refresh to show the
    page's counts again. Brand color names and Quasar classes only (style-guide §4.8, §5). -->
<template><div v-if="state" class="m-mail-sync-progress q-my-xs" role="status" aria-live="polite">
    <div class="row items-center no-wrap q-gutter-x-sm">
        <q-spinner v-if="!state.done" size="16px" color="primary"></q-spinner>
        <q-icon v-else :name="state.failed ? 'sym_o_sync_problem' : 'sym_o_check_circle'" :color="state.failed ? 'negative' : 'positive'" size="18px"></q-icon>
        <div class="col ellipsis text-body2" :class="state.failed ? 'text-negative' : ''">{{state.text}}</div>
        <q-btn v-if="state.done" flat dense no-caps color="primary" icon="sym_o_refresh" :label="t('Refresh')" @click="refresh"></q-btn>
    </div>
    <q-linear-progress v-if="!state.done && state.ratio != null" :value="state.ratio" rounded size="4px" color="primary" class="q-mt-xs"></q-linear-progress>
    <div v-if="!state.done && state.caption" class="text-caption m-muted q-mt-xs ellipsis">{{state.caption}}</div>
</div></template>

<script>
const t = (text) => (moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text);
const fill = (text, values) => String(text).replace(/\{(\w+)\}/g, (match, key) => (values[key] == null ? '' : String(values[key])));
const count = (value) => { const n = Number(value) || 0; try { return n.toLocaleString(); } catch (err) { return String(n); } };

// the page's one listener on the topic, shared by the progress components mounted on it
function syncHub(client) {
    const hub = moqui.bossSyncProgress || (moqui.bossSyncProgress = { listeners: new Set(), unregister: null });
    if (client && !hub.unregister) {
        const onProgress = (jsonObj) => {
            let message = jsonObj ? jsonObj.message : null;
            if (typeof message === 'string') { try { message = JSON.parse(message); } catch (err) { message = null; } }
            if (!message || !message.emailAccountId) return;
            hub.listeners.forEach((listener) => { try { listener(message); } catch (err) { console.warn('Sync progress', err); } });
        };
        const stop = client.registerListener('emailSyncProgress', onProgress);
        hub.unregister = typeof stop === 'function' ? stop : function () {
            if (client.unregisterListener) client.unregisterListener('emailSyncProgress', onProgress);
        };
    }
    return hub;
}

module.exports = {
    name: 'MailSyncProgress',
    inject: { mScreen: { default: null } },
    data() { return { state: null, listener: null }; },
    computed: {
        query() { return this.mScreen ? this.mScreen.parameters : {}; },
        accountId() { return this.query.emailAccountId || null; }
    },
    methods: {
        t,
        receive(message) {
            if (!this.accountId || message.emailAccountId !== this.accountId) return;
            if (message.done === true || message.done === 'true') {
                const failed = message.outcome === 'failed' || message.outcome === 'authFailed';
                const newCount = Number(message.newCount) || 0;
                const text = failed ? (message.message || t('The sync did not finish'))
                    : (message.outcome === 'busy' ? t('Another sync of this account is running')
                        : (newCount ? fill(newCount === 1 ? t('Synced: 1 new message') : t('Synced: {n} new messages'), { n: count(newCount) }) : t('Synced: up to date')));
                this.state = { done: true, failed, text, ratio: null, caption: null };
                return;
            }
            const kept = Number(message.folderKept) || 0;
            const fetched = Number(message.folderFetched) || 0;
            const pending = Number(message.folderPending) || 0;
            const folder = message.folderName || message.folderPath || '';
            const total = kept + pending;
            const done = Math.min(kept + fetched, total || kept + fetched);
            const text = total > 0 ? fill(folder ? t('Syncing {done} of {total} in {folder}') : t('Syncing {done} of {total}'), { done: count(done), total: count(total), folder })
                : (folder ? fill(t('Syncing {folder}'), { folder }) : t('Syncing'));
            const folderCount = Number(message.folderCount) || 0;
            const caption = folderCount > 1 ? fill(t('Folder {n} of {count}'), { n: Math.min((Number(message.foldersDone) || 0) + 1, folderCount), count: folderCount }) : null;
            this.state = { done: false, failed: false, text, ratio: total > 0 ? Math.max(0, Math.min(1, done / total)) : null, caption };
        },
        // the page's own counts and status, read again
        refresh() {
            this.state = null;
            if (this.$root.reloadSubscreens) this.$root.reloadSubscreens();
        }
    },
    mounted() {
        const client = this.$root.notificationClient || (moqui.webrootVue ? moqui.webrootVue.notificationClient : null);
        if (!client) return;
        this.listener = (message) => this.receive(message);
        syncHub(client).listeners.add(this.listener);
    },
    beforeUnmount() {
        const hub = moqui.bossSyncProgress;
        if (this.listener && hub) hub.listeners.delete(this.listener);
        this.listener = null;
        if (hub && hub.listeners.size === 0 && hub.unregister) {
            hub.unregister();
            hub.unregister = null;
        }
    }
};
</script>
