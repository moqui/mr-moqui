<!-- Text blocks (mr-boss design-drawers-commons.md §17 TextBlocks): the canned text the composer offers (its Text blocks button, and a
    / and the shortcut at the start of a word): the user's own and those shared with a user group they are in, with a search
    over the name, the shortcut and the text. New and Edit are dialogs with the body in m-rich-text and the group to share
    with (empty: just me); only its owner changes or deletes a block. org.moqui.comms.MailSettingsServices get and store#TextBlock
    (the body cleaned as safe HTML) over the framework's text block services, which check the owner and the group. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Text blocks" default-menu-index="5" menu-image="sym_o_text_snippet" menu-image-type="icon">

    <parameter name="searchText"/>

    <transition name="storeTextBlock">
        <service-call name="org.moqui.comms.MailSettingsServices.store#TextBlock" in-map="{emailTextBlockId:emailTextBlockId, title:title, shortcut:shortcut,
                bodyHtml:bodyHtml, userGroupId:userGroupId}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Text block saved</message></if></actions>
        <default-response url="."/>
    </transition>
    <transition name="deleteTextBlock">
        <service-call name="org.moqui.impl.EmailClientServices.delete#EmailTextBlock" in-map="{emailTextBlockId:emailTextBlockId}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Text block deleted</message></if></actions>
        <default-response url="."/>
    </transition>

    <actions>
        <service-call name="org.moqui.comms.MailSettingsServices.get#TextBlockSettings" in-map="{searchText:searchText}" out-map="blocksOut"/>
        <script><![CDATA[
            textBlocks = Array.from(blocksOut?.textBlockList || [])
            groupOptions = Array.from(blocksOut?.groupOptions || [])
            canShare = groupOptions.length > 0
            searching = !!(searchText && String(searchText).trim())
            search = {searchText: searchText || ''}
        ]]></script>
    </actions>
    <widgets>
        <container style="row items-center q-mb-sm">
            <label type="h5" text="Text blocks" style="q-my-none"/>
            <container style="col"/>
            <container-dialog id="NewTextBlockDialog" button-text="New text block" icon="sym_o_add" width="640" title="New text block">
                <form-single name="NewTextBlock" transition="storeTextBlock" focus-field="title">
                    <field name="title"><default-field title="Name"><text-line size="40"/></default-field></field>
                    <field name="shortcut"><default-field title="Shortcut" tooltip="Type / and the shortcut in a message to put the text in"><text-line size="15"/></default-field></field>
                    <field name="bodyHtml"><default-field title="Text"><text-area rows="6" cols="60" editor-type="rich"/></default-field></field>
                    <field name="userGroupId"><conditional-field condition="canShare" title="Shared with">
                        <drop-down allow-empty="true" no-current-selected-key=""><option key="" text="Just me"/><list-options list="groupOptions" key="${key}" text="${text}"/></drop-down></conditional-field>
                        <default-field><hidden/></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                    <field-layout>
                        <field-row><field-ref name="title"/><field-ref name="shortcut"/></field-row>
                        <field-ref name="bodyHtml"/><field-ref name="userGroupId"/><field-ref name="submitButton"/>
                    </field-layout>
                </form-single>
            </container-dialog>
        </container>
        <label type="p" text="Text you write often (a greeting, directions, an answer to a common question), one click or a / and its shortcut away when you write a message. Share one with a group and its members have it too." style="m-muted"/>

        <form-single name="TextBlockSearch" transition="." map="search">
            <field name="searchText"><default-field title="Search"><text-line size="30"/></default-field></field>
            <field name="searchButton"><default-field title="Find"><submit/></default-field></field>
            <field-layout><field-row-big><field-ref name="searchText"/><field-ref name="searchButton"/></field-row-big></field-layout>
        </form-single>

        <container-box><box-header title="${searching ? 'Text blocks found' : 'Your text blocks'}"/><box-body-nopad>
            <form-list name="TextBlockList" list="textBlocks" skip-form="true" paginate="false">
                <field name="title"><default-field title="Name"><display style="text-weight-medium"/></default-field></field>
                <field name="shortcutText"><default-field title="Shortcut"><display style="text-caption text-primary"/></default-field></field>
                <field name="bodyText"><default-field title="Text"><display style="text-caption m-muted"/></default-field></field>
                <field name="sharedText"><default-field title="Who has it"><display style="text-caption"/></default-field></field>
                <field name="tools" align="right"><conditional-field condition="isOwner" title="">
                    <container-dialog id="EditTextBlockDialog" button-text="Edit" icon="sym_o_edit" width="640" title="${ec.l10n.localize('Edit')} ${title}">
                        <form-single name="EditTextBlock" transition="storeTextBlock">
                            <field name="emailTextBlockId" from="emailTextBlockId"><default-field><hidden/></default-field></field>
                            <field name="title" from="title"><default-field title="Name"><text-line size="40"/></default-field></field>
                            <field name="shortcut" from="shortcut"><default-field title="Shortcut"><text-line size="15"/></default-field></field>
                            <field name="bodyHtml" from="bodyHtml"><default-field title="Text"><text-area rows="6" cols="60" editor-type="rich"/></default-field></field>
                            <field name="userGroupId" from="userGroupId"><conditional-field condition="canShare" title="Shared with">
                                <drop-down allow-empty="true" no-current-selected-key=""><option key="" text="Just me"/><list-options list="groupOptions" key="${key}" text="${text}"/></drop-down></conditional-field>
                                <default-field><hidden/></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                            <field-layout>
                                <field-ref name="emailTextBlockId"/>
                                <field-row><field-ref name="title"/><field-ref name="shortcut"/></field-row>
                                <field-ref name="bodyHtml"/><field-ref name="userGroupId"/><field-ref name="submitButton"/>
                            </field-layout>
                        </form-single>
                    </container-dialog>
                    <link url="deleteTextBlock" link-type="hidden-form-link" icon="sym_o_delete" text="Delete" tooltip="Delete ${title}" style="m-btn-flat"
                            confirmation="Delete the text block ${title}?" parameter-map="{emailTextBlockId:emailTextBlockId}"/>
                </conditional-field><default-field title=""><display text=""/></default-field></field>
                <columns type="mobile">
                    <column><field-ref name="title"/><field-ref name="bodyText"/></column>
                    <column><field-ref name="shortcutText"/><field-ref name="tools"/></column>
                </columns>
            </form-list>
            <section name="NoBlocks" condition="!textBlocks.length"><widgets>
                <label type="p" text="${searching ? 'No text blocks match' : 'No text blocks yet · New text block'}" style="m-muted q-pa-sm q-mb-none"/>
            </widgets></section>
        </box-body-nopad></container-box>
    </widgets>
</screen>
