<!-- The Rules screen (mr-boss design-drawers-commons.md §17 Rules), the component Rules.xml serves in the qvue render mode, over its
    JSON transitions: the user's rules in order (drag a rule, or its up and down buttons; reorderRules), each in words with
    its account and matches, on or off; the editor (a dialog: name, the account or all accounts, all or any of the
    conditions, the conditions and actions as rows, and Test: the conditions as they are now tried on the newest 50 messages
    of a folder, testRule, listing what they match with nothing done to it, each a link to its thread in the Inbox in a new
    tab, so the rule being edited stays); Run now over a folder (all the rules, or one);
    the blocked senders with Unblock and Block an address. Brand color names and Quasar classes only (style-guide §4.8, §5). -->
<template><div class="m-mail-rules">
    <div class="row items-center q-mb-xs">
        <div class="text-h5">{{t('Rules')}}</div>
        <q-space></q-space>
        <q-btn unelevated no-caps color="primary" icon="sym_o_add" :label="t('New rule')" :disable="!manageAccounts.length" @click="openEditor(null)"></q-btn>
    </div>
    <p class="m-muted">{{t('Rules sort your mail on the server as it arrives, before you see it: the mail from your accountant into a folder, newsletters out of the Inbox, an alert flagged. They run in this order; a rule that stops ends the rules for that message.')}}</p>

    <q-banner v-if="loaded && !accounts.length" dense rounded class="m-tonal text-primary q-mb-md">
        {{t('Add a mail account first: rules work on its mail.')}}
        <template v-slot:action><q-btn unelevated dense no-caps color="primary" :label="t('Add an account')" @click="$root.setUrl(addAccountUrl)"></q-btn></template>
    </q-banner>

    <m-container-box :title="t('Your rules')">
        <div v-if="!loaded" class="q-pa-sm"><q-skeleton type="text" width="60%"></q-skeleton><q-skeleton type="text" width="40%"></q-skeleton></div>
        <div v-else-if="!rules.length" class="m-muted q-pa-sm">{{t('No rules yet')}}<span v-if="manageAccounts.length"> · <a href="#" class="text-primary" @click.prevent="openEditor(null)">{{t('New rule')}}</a></span></div>
        <q-list v-else separator>
            <q-item v-for="(rule, index) in rules" :key="rule.emailRuleId" class="q-px-sm" :class="dropAt === index ? 'm-tonal text-primary' : ''"
                    :draggable="rule.canChange !== false" @dragstart="dragStart(index, $event)" @dragover.prevent="dropAt = index" @dragleave="dropAt = dropAt === index ? null : dropAt"
                    @drop.prevent="drop(index)" @dragend="dragEnd">
                <q-item-section v-if="!$q.screen.xs" avatar style="min-width:28px"><q-icon name="sym_o_drag_indicator" class="m-muted cursor-pointer"><q-tooltip>{{t('Drag to change the order')}}</q-tooltip></q-icon></q-item-section>
                <q-item-section>
                    <q-item-label class="text-weight-medium" :class="rule.enabled ? '' : 'm-muted'">{{rule.ruleName}}
                        <q-chip v-if="!rule.enabled" dense square class="m-tonal text-grey-7 q-my-none">{{t('Off')}}</q-chip></q-item-label>
                    <q-item-label caption>{{t('If')}} {{rule.conditionText}}</q-item-label>
                    <q-item-label caption>{{t('Then')}} {{rule.actionText}}</q-item-label>
                    <q-item-label caption class="m-muted">{{rule.accountName}} · {{matchedText(rule.matchedCount)}}</q-item-label>
                    <!-- on a phone the tools go under the rule -->
                    <rule-tools v-if="$q.screen.xs" class="q-mt-xs" :rule="rule" :index="index" :count="rules.length" :busy="busy" @move="move(index, $event)"
                            @toggle="toggle(rule)" @run="runOne(rule)" @edit="openEditor(rule)" @remove="remove(rule)"></rule-tools>
                </q-item-section>
                <q-item-section v-if="!$q.screen.xs" side>
                    <rule-tools :rule="rule" :index="index" :count="rules.length" :busy="busy" @move="move(index, $event)"
                            @toggle="toggle(rule)" @run="runOne(rule)" @edit="openEditor(rule)" @remove="remove(rule)"></rule-tools>
                </q-item-section>
            </q-item>
        </q-list>
    </m-container-box>

    <div class="row q-col-gutter-md">
        <div class="col-12 col-md-6">
            <m-container-box ref="runBox" :title="t('Run rules now')">
                <div class="text-caption m-muted q-mb-sm">{{t('New mail is sorted as it arrives. Run the rules on the mail already in a folder (its newest 2,000 messages).')}}</div>
                <m-drop-down v-model="run.emailFolderId" name="runFolder" :options="runFolderOptions" :label="t('Folder')"></m-drop-down>
                <m-drop-down v-model="run.emailRuleId" name="runRule" :options="runRuleOptions" :label="t('Which rules')" class="q-mt-sm"></m-drop-down>
                <div class="row items-center q-mt-sm q-gutter-sm">
                    <q-btn unelevated dense no-caps class="m-btn-tonal" icon="sym_o_play_arrow" :label="t('Run now')" :loading="run.running" :disable="!run.emailFolderId" @click="runNow"></q-btn>
                    <span v-if="run.resultText" class="text-body2">{{run.resultText}}</span>
                </div>
                <div v-for="error in run.errors" :key="error" class="text-caption text-negative">{{error}}</div>
            </m-container-box>
        </div>
        <div class="col-12 col-md-6">
            <m-container-box :title="t('Blocked senders')">
                <div class="text-caption m-muted q-mb-xs">{{t('Their mail goes straight to Spam. Block a sender from a message in the Inbox, or here.')}}</div>
                <div v-if="loaded && !blocked.length" class="m-muted q-py-xs">{{t('Nobody is blocked')}}</div>
                <q-list dense separator>
                    <q-item v-for="sender in blocked" :key="sender.emailRuleId" class="q-px-none">
                        <q-item-section><q-item-label>{{sender.emailAddress}}</q-item-label>
                            <q-item-label caption>{{sender.accountName}} · {{matchedText(sender.matchedCount)}}</q-item-label></q-item-section>
                        <q-item-section side><q-btn flat dense no-caps color="primary" :label="t('Unblock')" @click="unblock(sender)"></q-btn></q-item-section>
                    </q-item>
                </q-list>
                <div v-if="manageAccounts.length" class="row items-end q-col-gutter-sm q-mt-xs">
                    <div class="col-12 col-sm"><m-text-line v-model="block.emailAddress" name="blockAddress" :label="t('Block an address')"></m-text-line></div>
                    <div v-if="manageAccounts.length > 1" class="col-12 col-sm"><m-drop-down v-model="block.emailAccountId" name="blockAccount" :options="blockAccountOptions" :label="t('In')"></m-drop-down></div>
                    <div class="col-auto"><q-btn unelevated dense no-caps class="m-btn-tonal text-negative" icon="sym_o_block" :label="t('Block')" :disable="!block.emailAddress" @click="blockAddress"></q-btn></div>
                </div>
            </m-container-box>
        </div>
    </div>

    <!-- the rule editor -->
    <m-dialog v-model="editor.open" :title="editor.emailRuleId ? t('Edit the rule') : t('New rule')" width="780">
        <m-text-line v-model="editor.ruleName" name="ruleName" :label="t('Name')"></m-text-line>
        <div class="row q-col-gutter-sm q-mt-xs">
            <div class="col-12 col-sm-6"><m-drop-down v-model="editor.emailAccountId" name="ruleAccount" :options="editorAccountOptions" :label="t('Mail of')" :disable="!!editor.emailRuleId"></m-drop-down></div>
            <div class="col-12 col-sm-6"><m-drop-down v-model="editor.matchAllEnumId" name="ruleMatch" :options="matchOptions" :label="t('When')"></m-drop-down></div>
        </div>

        <div class="text-subtitle2 q-mt-md">{{t('Conditions')}}</div>
        <div v-for="(condition, index) in editor.conditions" :key="'c' + condition.key" class="row q-col-gutter-sm items-center q-mt-none">
            <div class="col-12 col-sm-3"><m-drop-down v-model="condition.field" :name="'conditionField' + index" :options="fieldOptions" @update:model-value="fieldChanged(condition)"></m-drop-down></div>
            <div v-if="condition.field === 'header'" class="col-12 col-sm-2"><m-text-line v-model="condition.header" :name="'conditionHeader' + index" :label="t('Header')"></m-text-line></div>
            <div v-if="condition.field !== 'hasAttachment'" class="col-12 col-sm-3"><m-drop-down v-model="condition.operator" :name="'conditionOperator' + index" :options="operatorOptions(condition.field)"></m-drop-down></div>
            <div class="col">
                <m-drop-down v-if="condition.field === 'hasAttachment'" v-model="condition.value" :name="'conditionValue' + index" :options="attachmentOptions"></m-drop-down>
                <m-text-line v-else v-model="condition.value" :name="'conditionValue' + index" :label="valueLabel(condition)"></m-text-line>
            </div>
            <div class="col-auto"><q-btn flat round dense icon="sym_o_close" :disable="editor.conditions.length === 1" :aria-label="t('Remove')" @click="editor.conditions.splice(index, 1)"></q-btn></div>
        </div>
        <q-btn flat dense no-caps color="primary" icon="sym_o_add" :label="t('Add a condition')" class="q-mt-xs" @click="addCondition"></q-btn>

        <div class="text-subtitle2 q-mt-md">{{t('Actions')}}</div>
        <div v-for="(action, index) in editor.actions" :key="'a' + action.key" class="row q-col-gutter-sm items-center q-mt-none">
            <div class="col-12 col-sm-4"><m-drop-down v-model="action.action" :name="'actionKind' + index" :options="actionOptions" @update:model-value="action.value = ''"></m-drop-down></div>
            <div class="col">
                <m-drop-down v-if="action.action === 'moveToFolder' && editorAccount" v-model="action.value" :name="'actionValue' + index" :options="editorFolderOptions" :label="t('Folder')"></m-drop-down>
                <m-drop-down v-else-if="action.action === 'addLabel' && editorAccount && editorAccount.labelList.length" v-model="action.value" :name="'actionValue' + index"
                        :options="editorLabelOptions" combo :label="t('Label (or a new one)')"></m-drop-down>
                <m-text-line v-else-if="['moveToFolder', 'addLabel', 'forwardTo'].includes(action.action)" v-model="action.value" :name="'actionValue' + index"
                        :label="action.action === 'forwardTo' ? t('To (addresses, with commas)') : (action.action === 'moveToFolder' ? t('Folder name') : t('Label name'))"></m-text-line>
            </div>
            <div class="col-auto"><q-btn flat round dense icon="sym_o_close" :disable="editor.actions.length === 1" :aria-label="t('Remove')" @click="editor.actions.splice(index, 1)"></q-btn></div>
        </div>
        <q-btn flat dense no-caps color="primary" icon="sym_o_add" :label="t('Add an action')" class="q-mt-xs" @click="addAction"></q-btn>

        <m-check v-model="editor.flags" name="ruleFlags" :options="flagOptions" class="q-mt-sm"></m-check>

        <!-- Test: what the conditions as they are now match in a folder's newest mail, with nothing done to it -->
        <q-separator class="q-my-sm"></q-separator>
        <div class="text-subtitle2">{{t('Test')}}</div>
        <div class="text-caption m-muted">{{t('Try the conditions on the newest 50 messages of a folder: the matches are listed, and nothing is done to them.')}}</div>
        <div class="row items-end q-col-gutter-sm q-mt-none">
            <div class="col-12 col-sm"><m-drop-down v-model="editor.testFolderId" name="ruleTestFolder" :options="testFolderOptions" :label="t('Try it on')"></m-drop-down></div>
            <div class="col-auto"><q-btn unelevated dense no-caps class="m-btn-tonal" icon="sym_o_science" :label="t('Test')" :loading="editor.testing"
                    :disable="!editor.testFolderId" @click="testRule"></q-btn></div>
        </div>
        <div v-if="editor.test" class="q-mt-sm m-mail-rule-test">
            <div class="text-body2">{{editor.test.resultText}}</div>
            <q-list v-if="editor.test.matchList.length" dense separator class="q-mt-xs">
                <!-- each match opens its thread in the Inbox, in a new tab so the rule being edited stays -->
                <q-item v-for="match in editor.test.matchList" :key="match.emailMessageId" class="q-px-none" :clickable="!!match.inboxUrl"
                        :tag="match.inboxUrl ? 'a' : 'div'" :href="match.inboxUrl || undefined" :target="match.inboxUrl ? '_blank' : undefined"
                        :rel="match.inboxUrl ? 'noopener' : undefined" :data-thread="match.threadKey || undefined">
                    <q-item-section>
                        <q-item-label class="ellipsis">{{match.subject}}</q-item-label>
                        <q-item-label caption class="ellipsis">{{match.fromText}}</q-item-label>
                    </q-item-section>
                    <q-item-section side top class="text-caption m-muted">{{match.dateText}}</q-item-section>
                    <q-item-section v-if="match.inboxUrl" side><q-icon name="sym_o_open_in_new" size="xs" :aria-label="t('Open in the Inbox')"></q-icon>
                        <q-tooltip>{{t('Open in the Inbox')}}</q-tooltip></q-item-section>
                </q-item>
            </q-list>
        </div>
        <div v-if="editor.testError" class="text-negative text-caption q-mt-xs">{{editor.testError}}</div>

        <div v-if="editor.error" class="text-negative q-mt-sm">{{editor.error}}</div>
        <div class="row q-gutter-sm q-mt-md">
            <q-btn unelevated no-caps color="primary" :label="t('Save')" :loading="editor.saving" @click="saveRule"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" @click="editor.open = false"></q-btn>
        </div>
    </m-dialog>
</div></template>

<script>
const t = (text) => (moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text);
let nextKey = 1;
const blankCondition = () => ({ key: nextKey++, field: 'from', operator: 'contains', value: '', header: '' });
const blankAction = () => ({ key: nextKey++, action: 'moveToFolder', value: '' });

// a rule's buttons: up, down, on or off, run now, edit, delete
const ruleTools = {
    props: { rule: Object, index: Number, count: Number, busy: Boolean },
    emits: ['move', 'toggle', 'run', 'edit', 'remove'],
    methods: { t },
    template: '<div class="row no-wrap items-center">' +
        '<q-btn flat round dense icon="sym_o_arrow_upward" :disable="index === 0 || busy" :aria-label="t(\'Move up\')" @click="$emit(\'move\', -1)"><q-tooltip>{{t(\'Move up\')}}</q-tooltip></q-btn>' +
        '<q-btn flat round dense icon="sym_o_arrow_downward" :disable="index === count - 1 || busy" :aria-label="t(\'Move down\')" @click="$emit(\'move\', 1)"><q-tooltip>{{t(\'Move down\')}}</q-tooltip></q-btn>' +
        '<q-btn flat round dense :icon="rule.enabled ? \'sym_o_toggle_on\' : \'sym_o_toggle_off\'" :color="rule.enabled ? \'primary\' : \'grey-7\'" ' +
            ':aria-label="rule.enabled ? t(\'Turn off\') : t(\'Turn on\')" @click="$emit(\'toggle\')"><q-tooltip>{{rule.enabled ? t(\'Turn off\') : t(\'Turn on\')}}</q-tooltip></q-btn>' +
        '<q-btn flat round dense icon="sym_o_play_arrow" :aria-label="t(\'Run on a folder now\')" @click="$emit(\'run\')"><q-tooltip>{{t(\'Run on a folder now\')}}</q-tooltip></q-btn>' +
        '<q-btn flat round dense icon="sym_o_edit" :aria-label="t(\'Edit\')" @click="$emit(\'edit\')"><q-tooltip>{{t(\'Edit\')}}</q-tooltip></q-btn>' +
        '<q-btn flat round dense icon="sym_o_delete" :aria-label="t(\'Delete\')" @click="$emit(\'remove\')"><q-tooltip>{{t(\'Delete\')}}</q-tooltip></q-btn>' +
    '</div>'
};

module.exports = {
    name: 'MailRules',
    components: { 'rule-tools': ruleTools },
    data() {
        return {
            loaded: false, busy: false, rules: [], blocked: [], accounts: [], dragIndex: null, dropAt: null,
            editor: { open: false, emailRuleId: null, ruleName: '', emailAccountId: '', matchAllEnumId: 'ErmAll', conditions: [], actions: [], flags: ['enabled'], saving: false, error: null,
                testFolderId: null, testing: false, test: null, testError: null },
            run: { emailFolderId: null, emailRuleId: '', running: false, resultText: '', errors: [] },
            block: { emailAddress: '', emailAccountId: null }
        };
    },
    computed: {
        manageAccounts() { return this.accounts.filter((account) => account.canManage); },
        editorAccount() { return this.editor.emailAccountId ? (this.accounts.find((account) => account.emailAccountId === this.editor.emailAccountId) || null) : null; },
        editorAccountOptions() {
            return [{ value: '', label: t('All my accounts') }].concat(this.manageAccounts.map((account) => ({ value: account.emailAccountId, label: account.accountName })));
        },
        editorFolderOptions() { return this.editorAccount ? this.editorAccount.folderList.map((folder) => ({ value: folder.value, label: folder.label })) : []; },
        editorLabelOptions() { return this.editorAccount ? this.editorAccount.labelList.map((label) => ({ value: label.value, label: label.label })) : []; },
        matchOptions() { return [{ value: 'ErmAll', label: t('All of the conditions are true') }, { value: 'ErmAny', label: t('Any of the conditions is true') }]; },
        fieldOptions() {
            return [{ value: 'from', label: t('From') }, { value: 'to', label: t('To') }, { value: 'cc', label: t('Cc') }, { value: 'subject', label: t('Subject') },
                { value: 'body', label: t('The text') }, { value: 'hasAttachment', label: t('A file attached') }, { value: 'listId', label: t('Mailing list') },
                { value: 'size', label: t('Size') }, { value: 'header', label: t('Another header') }];
        },
        attachmentOptions() { return [{ value: 'Y', label: t('Has a file attached') }, { value: 'N', label: t('Has no file attached') }]; },
        actionOptions() {
            return [{ value: 'moveToFolder', label: t('Move to a folder') }, { value: 'addLabel', label: t('Add a label') }, { value: 'markRead', label: t('Mark it read') },
                { value: 'flag', label: t('Flag it') }, { value: 'forwardTo', label: t('Forward it to') }, { value: 'markSpam', label: t('Move it to Spam') },
                { value: 'delete', label: t('Delete it (to Trash)') }, { value: 'stopProcessing', label: t('Stop: no more rules') }];
        },
        flagOptions() { return [{ value: 'enabled', label: t('On') }, { value: 'stopProcessing', label: t('Stop the rules after this one when it matches') }]; },
        runFolderOptions() {
            const list = [];
            for (const account of this.accounts) for (const folder of account.folderList)
                list.push({ value: folder.value, label: (this.accounts.length > 1 ? account.accountName + ' · ' : '') + folder.label });
            return list;
        },
        runRuleOptions() { return [{ value: '', label: t('All the rules that are on') }].concat(this.rules.map((rule) => ({ value: rule.emailRuleId, label: rule.ruleName }))); },
        // the folders a rule is tried on: its account's, or every account's for a rule on all of them
        testFolderOptions() {
            const accounts = this.editorAccount ? [this.editorAccount] : this.accounts;
            const list = [];
            for (const account of accounts) for (const folder of account.folderList)
                list.push({ value: folder.value, label: (accounts.length > 1 ? account.accountName + ' · ' : '') + folder.label });
            return list;
        },
        blockAccountOptions() { return this.manageAccounts.map((account) => ({ value: account.emailAccountId, label: account.accountName })); },
        // Add an account, beside this screen under whichever app mounts Settings (BasicComms or an app's own Comms)
        addAccountUrl() {
            const list = (this.$root.currentPathList || ['BasicComms', 'Settings', 'Rules']).slice(0, -1);
            return this.$root.linkBasePath + '/' + list.concat(['MailAccounts', 'Add']).join('/') + '?fresh=Y';
        }
    },
    watch: {
        // another account for the rule: its Inbox to try it on, and no result of the other one's
        'editor.emailAccountId'() {
            if (!this.editor.open) return;
            this.editor.testFolderId = this.defaultTestFolder();
            this.editor.test = null;
        }
    },
    methods: {
        t,
        url(name) { return this.$root.basePath + '/' + (this.$root.currentPathList || ['BasicComms', 'Settings', 'Rules']).join('/') + '/' + name; },
        request(name, params, method) {
            return moqui.request(this.url(name), { method: method || 'GET', params: params || {} }).then((result) => {
                const json = result.json || {};
                if ((json.messageInfos && json.messageInfos.length) || json.errors) moqui.notifyMessages(json.messageInfos || [], json.errors || null);
                if (json.errors) throw new Error(String(json.errors));
                return json;
            }, (err) => { moqui.handleAjaxError(err); throw err; });
        },
        post(name, params) { return this.request(name, params, 'POST'); },
        load() {
            return this.request('rulesData').then((json) => {
                this.rules = json.ruleList || [];
                this.blocked = json.blockedList || [];
                this.accounts = json.accountList || [];
                if (!this.run.emailFolderId && this.runFolderOptions.length) {
                    const inbox = this.accounts.length ? this.accounts[0].folderList.find((folder) => folder.kind === 'EfkInbox') : null;
                    this.run.emailFolderId = inbox ? inbox.value : this.runFolderOptions[0].value;
                }
                if (!this.block.emailAccountId && this.manageAccounts.length) this.block.emailAccountId = this.manageAccounts[0].emailAccountId;
                this.loaded = true;
            }, () => { this.loaded = true; });
        },
        matchedText(count) { return count === 1 ? t('matched once') : (count ? t('matched') + ' ' + count + ' ' + t('times') : t('not matched yet')); },
        valueLabel(condition) { return condition.field === 'size' ? t('Size, like 500K or 5M') : (condition.operator === 'matches' ? t('Pattern') : t('Text')); },
        operatorOptions(field) {
            if (field === 'size') return [{ value: 'greater', label: t('is larger than') }, { value: 'less', label: t('is smaller than') }];
            return [{ value: 'contains', label: t('contains') }, { value: 'is', label: t('is') }, { value: 'startsWith', label: t('starts with') },
                { value: 'matches', label: t('matches the pattern') }];
        },
        fieldChanged(condition) {
            if (condition.field === 'size') { condition.operator = 'greater'; condition.value = ''; }
            else if (condition.field === 'hasAttachment') { condition.operator = 'is'; condition.value = 'Y'; }
            else if (['greater', 'less', 'is'].includes(condition.operator) && condition.value === 'Y') { condition.operator = 'contains'; condition.value = ''; }
            else if (['greater', 'less'].includes(condition.operator)) condition.operator = 'contains';
        },
        addCondition() { this.editor.conditions.push(blankCondition()); },
        addAction() { this.editor.actions.push(blankAction()); },
        openEditor(rule) {
            const conditions = rule ? (rule.conditionList || []).map((condition) => ({ key: nextKey++, field: condition.field, operator: condition.operator || 'contains',
                value: condition.value == null ? '' : String(condition.value), header: condition.header || '' })) : [blankCondition()];
            const actions = rule ? (rule.actionList || []).map((action) => ({ key: nextKey++, action: action.action, value: action.value == null ? '' : String(action.value) })) : [blankAction()];
            const flags = [];
            if (!rule || rule.enabled) flags.push('enabled');
            if (rule && rule.stopProcessing) flags.push('stopProcessing');
            this.editor = { open: true, emailRuleId: rule ? rule.emailRuleId : null, ruleName: rule ? rule.ruleName : '',
                emailAccountId: rule ? (rule.emailAccountId || '') : (this.manageAccounts.length === 1 ? this.manageAccounts[0].emailAccountId : ''),
                matchAllEnumId: rule ? rule.matchAllEnumId : 'ErmAll', conditions: conditions.length ? conditions : [blankCondition()],
                actions: actions.length ? actions : [blankAction()], flags, saving: false, error: null, testFolderId: null, testing: false, test: null, testError: null };
            this.editor.testFolderId = this.defaultTestFolder();
        },
        // the Inbox of the rule's account, else of the first account
        defaultTestFolder() {
            const accounts = this.editorAccount ? [this.editorAccount] : this.accounts;
            for (const account of accounts) { const inbox = account.folderList.find((folder) => folder.kind === 'EfkInbox'); if (inbox) return inbox.value; }
            return this.testFolderOptions.length ? this.testFolderOptions[0].value : null;
        },
        editorConditions() {
            return this.editor.conditions.map((condition) => {
                const item = { field: condition.field, operator: condition.field === 'hasAttachment' ? 'is' : condition.operator, value: condition.value };
                if (condition.field === 'header') item.header = condition.header;
                return item;
            });
        },
        // the conditions as they are now, on the folder's newest mail: the matches listed, nothing done to them
        testRule() {
            const editor = this.editor;
            if (!editor.testFolderId) return;
            editor.testing = true;
            editor.testError = null;
            moqui.request(this.url('testRule'), { method: 'POST', params: { emailRuleId: editor.emailRuleId || '', emailFolderId: editor.testFolderId,
                conditionsJson: JSON.stringify(this.editorConditions()), matchAllEnumId: editor.matchAllEnumId } }).then((result) => {
                const json = result.json || {};
                editor.testing = false;
                if (json.errors) { editor.test = null; editor.testError = String(json.errors); return; }
                editor.test = { resultText: json.resultText || '', matchList: json.matchList || [] };
            }, (err) => {
                editor.testing = false;
                editor.test = null;
                editor.testError = (err && err.json && err.json.errors) || t('The rule could not be tried');
            });
        },
        saveRule() {
            const editor = this.editor;
            if (!String(editor.ruleName || '').trim()) { editor.error = t('Give the rule a name'); return; }
            const conditions = this.editorConditions();
            const actions = editor.actions.map((action) => (action.value ? { action: action.action, value: action.value } : { action: action.action }));
            editor.saving = true;
            editor.error = null;
            this.post('saveRule', { emailRuleId: editor.emailRuleId || '', ruleName: editor.ruleName, emailAccountId: editor.emailAccountId || '',
                matchAllEnumId: editor.matchAllEnumId, conditionsJson: JSON.stringify(conditions), actionsJson: JSON.stringify(actions),
                enabled: editor.flags.includes('enabled') ? 'Y' : 'N', stopProcessing: editor.flags.includes('stopProcessing') ? 'Y' : 'N' }).then(() => {
                editor.saving = false;
                editor.open = false;
                this.load();
            }, (err) => { editor.saving = false; editor.error = err && err.message ? err.message : t('The rule was not saved'); });
        },
        toggle(rule) {
            const enabled = !rule.enabled;
            this.post('setEnabled', { emailRuleId: rule.emailRuleId, enabled: enabled ? 'Y' : 'N' }).then(() => { rule.enabled = enabled; }, () => {});
        },
        // a confirmation (Quasar's Dialog plugin): resolves on OK
        confirm(title, message, okLabel) {
            return new Promise((resolve) => {
                this.$q.dialog({ title, message, ok: { label: okLabel || t('OK'), color: 'negative', unelevated: true, noCaps: true },
                    cancel: { label: t('Cancel'), flat: true, noCaps: true } }).onOk(() => resolve());
            });
        },
        remove(rule) {
            this.confirm(t('Delete the rule?'), rule.ruleName, t('Delete')).then(() => {
                this.post('deleteRule', { emailRuleId: rule.emailRuleId }).then(() => this.load(), () => {});
            });
        },
        saveOrder() {
            this.busy = true;
            this.post('reorderRules', { emailRuleIdsJson: JSON.stringify(this.rules.map((rule) => rule.emailRuleId)) }).then(() => { this.busy = false; },
                () => { this.busy = false; this.load(); });
        },
        move(index, step) {
            const to = index + step;
            if (to < 0 || to >= this.rules.length) return;
            const list = this.rules.slice();
            const [rule] = list.splice(index, 1);
            list.splice(to, 0, rule);
            this.rules = list;
            this.saveOrder();
        },
        dragStart(index, event) {
            this.dragIndex = index;
            if (event && event.dataTransfer) { event.dataTransfer.effectAllowed = 'move'; event.dataTransfer.setData('text/plain', String(index)); }
        },
        drop(index) {
            const from = this.dragIndex;
            this.dragIndex = null;
            this.dropAt = null;
            if (from == null || from === index) return;
            this.move(from, index - from);
        },
        dragEnd() { this.dragIndex = null; this.dropAt = null; },
        runOne(rule) {
            this.run.emailRuleId = rule.emailRuleId;
            const box = this.$refs.runBox;
            if (box && box.$el && box.$el.scrollIntoView) box.$el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        },
        runNow() {
            this.run.running = true;
            this.run.resultText = '';
            this.run.errors = [];
            this.post('runRules', { emailFolderId: this.run.emailFolderId, emailRuleId: this.run.emailRuleId || '' }).then((json) => {
                this.run.running = false;
                const matched = json.matchedCount || 0;
                this.run.resultText = matched === 0 ? t('No message matched') : (matched === 1 ? t('1 message matched') : matched + ' ' + t('messages matched')) +
                    (json.actionCount ? ' · ' + json.actionCount + ' ' + t('actions done') : '');
                this.run.errors = (json.ruleErrorList || []).map((error) => (error && error.message) || String(error));
                this.load();
            }, () => { this.run.running = false; });
        },
        unblock(sender) {
            this.confirm(t('Unblock the sender?'), sender.emailAddress + ': ' + t('their mail comes to the Inbox again'), t('Unblock')).then(() => {
                this.post('deleteRule', { emailRuleId: sender.emailRuleId }).then(() => this.load(), () => {});
            });
        },
        blockAddress() {
            this.post('blockAddress', { emailAddress: this.block.emailAddress, emailAccountId: this.block.emailAccountId || '' }).then(() => {
                this.block.emailAddress = '';
                this.load();
            }, () => {});
        }
    },
    // a link may open the editor: ?rule=new (with from, subject or listId to start the condition, as the Inbox's "a rule for
    // mail like this" will), or ?rule=<emailRuleId>
    mounted() {
        this.load().then(() => {
            const params = this.$root.currentParameters || {};
            if (!params.rule) return;
            if (params.rule !== 'new') { const rule = this.rules.find((item) => item.emailRuleId === params.rule); if (rule) this.openEditor(rule); return; }
            if (!this.manageAccounts.length) return;
            this.openEditor(null);
            const field = params.from ? 'from' : (params.listId ? 'listId' : (params.subject ? 'subject' : null));
            if (field) Object.assign(this.editor.conditions[0], { field, operator: 'contains', value: String(params[field]) });
            if (params.account && this.manageAccounts.some((account) => account.emailAccountId === params.account)) this.editor.emailAccountId = params.account;
        });
    }
};
</script>
