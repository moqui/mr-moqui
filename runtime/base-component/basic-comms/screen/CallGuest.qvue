<!-- CallGuest (CallGuest.xml), in the public shell: m-call-guest, the call client's guest page (webroot js/WebrootCall.js,
    which the public shell loads for this route), with the link the token check answered ($root.context: its name, its
    owner's name, the policy, video) and the route's path ($root.basePath) its transitions are under. -->
<template><div class="m-call-guest-screen">
    <m-call-guest :base="$root.basePath" :link="$root.context || {}"></m-call-guest>
</div></template>

<script>
module.exports = { name: 'CallGuest' };
</script>
