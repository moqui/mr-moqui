<!-- Voice and Chat Bridges, which this component mounts in System (MoquiConf.xml), in the Integration group of the System
    home's navigation (tools template/HomeParts.xml: a component adds entries to a home's catalog this way). An entry
    whose screen the menu does not show for the user gives no link. -->
<screen-extend>
    <actions-extend when="append">
        <script><![CDATA[
            navCatalog.push({group: ec.l10n.localize('Integration'), path: 'Voice', icon: 'sym_o_call'},
                {group: ec.l10n.localize('Integration'), path: 'ChatBridges', icon: 'sym_o_forum'})
        ]]></script>
    </actions-extend>
</screen-extend>
