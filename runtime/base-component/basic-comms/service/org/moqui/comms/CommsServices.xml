<!-- Screen services of BasicComms that are not about one area (plans/Comms-Framework.md §3.1, D-A3). -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="search" noun="Users">
        <description>The people to share a mail account with, mention or message: active user accounts whose name or username
            has the term, as {id (the userId), value (the same), label}. Leaves out disabled accounts and the system's own
            (an agent's or another account whose username starts with _). Any signed-in user may look people up by name, as
            in a mail client's address book.</description>
        <in-parameters>
            <parameter name="term"/>
            <parameter name="limit" type="Integer" default="10"/>
        </in-parameters>
        <out-parameters><parameter name="userList" type="List"/></out-parameters>
        <actions>
            <!-- the term as text: its % and _ are not wildcards (a search for _agent is not one for any character then agent) -->
            <set field="termText" from="String(term || '').trim().replace(/[\\%_]/g, '\\$&amp;')"/>
            <set field="pageLimit" from="Math.min(Math.max(Number(limit) || 10, 1), 50)"/>
            <entity-find entity-name="moqui.security.UserAccount" list="accountList" limit="${pageLimit}" disable-authz="true">
                <econditions combine="or">
                    <econdition field-name="username" operator="like" value="%${termText}%" ignore-case="true"/>
                    <econdition field-name="userFullName" operator="like" value="%${termText}%" ignore-case="true"/>
                </econditions>
                <econdition field-name="username" operator="not-like" value="\_%"/>
                <econdition field-name="disabled" operator="not-equals" value="Y" or-null="true"/>
                <order-by field-name="^userFullName,^username"/>
                <select-field field-name="userId,username,userFullName"/>
            </entity-find>
            <script><![CDATA[
                userList = Array.from(accountList).map((account) => ({id: account.userId, value: account.userId,
                    label: account.userFullName || account.username}))
            ]]></script>
        </actions>
    </service>
</services>
