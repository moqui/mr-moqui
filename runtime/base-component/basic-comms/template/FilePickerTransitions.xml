<!-- The transitions of the drive picker (plans/Comms-Framework.md §7.4 DP): Compose's Attach from Files and the Inbox's Save to
    Files include them (transition-include), each one by name. pickerData: the drives and the recent files, or with checkOnly
    whether the user has a drive at all (the screens leave the buttons out when not); pickerFolder: a folder; pickerSearch: files
    by name. Every read goes through org.moqui.comms.FilePickerServices and so FileServices' drive access. An app may replace
    one with a screen-extend transition of its name (IronStone's pickerFolder names the records drive's folders by record). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <transition name="pickerData" method="get" read-only="true">
        <actions><script><![CDATA[
            const out = ec.service.sync().name('org.moqui.comms.FilePickerServices.get#PickerData').parameter('includeRecent', String(checkOnly) !== 'true')
                    .requireNewTransaction(true).call()
            ec.web.sendJsonResponse(ec.message.hasError() ? {hasDrive: false} : {hasDrive: out.hasDrive, personalDriveId: out.personalDriveId,
                driveList: out.driveList, recentList: out.recentList})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="pickerFolder" method="get" read-only="true">
        <actions><script><![CDATA[
            const out = ec.service.sync().name('org.moqui.comms.FilePickerServices.list#PickerFolder').parameters({driveId: driveId || '', path: path || ''})
                    .requireNewTransaction(true).call()
            ec.web.sendJsonResponse(ec.message.hasError() ? {} : {fileList: out.fileList, breadcrumbList: out.breadcrumbList, canWrite: out.canWrite})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="pickerSearch" method="get" read-only="true">
        <actions><script><![CDATA[
            const out = ec.service.sync().name('org.moqui.comms.FilePickerServices.find#PickerFiles').parameters({text: text || '', limit: 50})
                    .requireNewTransaction(true).call()
            ec.web.sendJsonResponse(ec.message.hasError() ? {} : {fileList: out.fileList})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>
</screen>
