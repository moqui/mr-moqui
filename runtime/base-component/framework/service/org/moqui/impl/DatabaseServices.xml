<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <!-- The Tools app's database administration (plans/Tools-Database.md), in crates/moqui-tools; the entities are in
        framework/entity/DatabaseEntities.xml. A service that works on a database takes db: group:<groupName> for an
        entity group's database (empty is the default group), or ext:<connectionId> for a moqui.database.DatabaseConnection,
        which is refused with "Not available" on a production instance or without the DATABASE_EXTERNAL permission. No
        Java counterpart. -->
    <service verb="get" noun="Capabilities" type="rust" location="moqui_tools::service::get_capabilities"
            transaction="ignore">
        <description>What the database db allows the Tools screens, and why the rest is not available ("needs the
            pg_monitor role", "pg_stat_statements is not loaded"), probed once and kept five minutes; refresh probes again.
            features maps each of statementStats, activity, cancel, terminate, lockWaits, tableSizes, bloatExact,
            indexUsage, indexOnline, fkLightLock, maintenance, integrity, settings, settingsEdit and backups to available
            and reason (why not, or what limits it). backend is embedded-postgres, postgres, mysql or mariadb. available is
            false, with reason, when the database did not answer.</description>
        <in-parameters>
            <parameter name="db"/>
            <parameter name="refresh" type="Boolean" default-value="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="db"/>
            <parameter name="available" type="Boolean"/>
            <parameter name="reason"/>
            <parameter name="backend"/>
            <parameter name="version"/>
            <parameter name="databaseName"/>
            <parameter name="userName"/>
            <parameter name="startTime"/>
            <parameter name="uptimeSeconds" type="Long"/>
            <parameter name="databaseSize" type="Long"/>
            <parameter name="features" type="Map"/>
        </out-parameters>
    </service>
</services>
