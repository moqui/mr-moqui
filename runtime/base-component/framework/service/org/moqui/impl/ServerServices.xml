<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="get" noun="VisitClientIpData" authenticate="anonymous-all">
        <description>Gets data from freegeoip.net for client IP address and populates in Visit record</description>
        <in-parameters><parameter name="visitId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="clientIpPostalCode"/><parameter name="clientIpCity"/><parameter name="clientIpMetroCode"/>
            <parameter name="clientIpRegionCode"/><parameter name="clientIpRegionName"/><parameter name="clientIpStateProvGeoId"/>
            <parameter name="clientIpCountryGeoId"/><parameter name="clientIpLatitude"/><parameter name="clientIpLongitude"/>
            <parameter name="clientIpTimeZone"/>
        </out-parameters>
        <actions>
            <!-- freegeoip.net now always returns a 403 error, disable until another solution found:
{
  "0": "#################################################################################################################################",
  "1": "#                                                                                                                               #",
  "2": "# IMPORTANT - PLEASE UPDATE YOUR API ENDPOINT                                                                                   #",
  "3": "#                                                                                                                               #",
  "4": "# This API endpoint is deprecated and has now been shut down. To keep using the freegeoip API, please update your integration   #",
  "5": "# to use the new ipstack API endpoint, designed as a simple drop-in replacement.                                                #",
  "6": "# You will be required to create an account at https://ipstack.com and obtain an API access key.                                #",
  "7": "#                                                                                                                               #",
  "8": "# For more information on how to upgrade please visit our Github Tutorial at: https://github.com/apilayer/freegeoip#readme      #",
  "9": "#                                                                                                                               #",
  "a": "#################################################################################################################################"
}
            -->
            <return message="Geo IP lookup disabled"/>

            <entity-find-one entity-name="moqui.server.Visit" value-field="visit"/>
            <!-- don't lock the Visit, ie no for-update="true" just in case this takes a long time to run -->
            <if condition="visit == null"><return message="No visit found with ID ${visitId}"/></if>
            <if condition="!visit.clientIpAddress"><return message="Visit with ID ${visitId} has no clientIpAddress"/></if>

            <if condition="!visit.clientIpAddress.includes('.')"><return message="IP address not a IPv4 address"/></if>
            <!-- InetAddress.getByName: a private, loopback, link-local, multicast or unspecified IPv4 address is not public -->
            <set field="octets" from="visit.clientIpAddress.split('.').map((it) => parseInt(it, 10))"/>
            <if condition="octets[0] == 10 || octets[0] == 127 || octets[0] == 0 || octets[0] &gt;= 224 ||
                    (octets[0] == 172 &amp;&amp; octets[1] &gt;= 16 &amp;&amp; octets[1] &lt;= 31) ||
                    (octets[0] == 192 &amp;&amp; octets[1] == 168) || (octets[0] == 169 &amp;&amp; octets[1] == 254)">
                <return message="IP address is not a public address"/></if>

            <!-- get from http://freegeoip.net/json/${clientIpAddress} -->
            <script>geoIp = ec.service.rest().method("get").uri(`http://freegeoip.net/json/${visit.clientIpAddress}`).call().checkError().jsonObject()</script>

            <if condition="!geoIp"><return message="No return from freegeoip.net for IP ${visit.clientIpAddress}"/></if>
            <set field="mapped" from="{clientIpPostalCode: geoIp.zip_code, clientIpCity: geoIp.city,
                    clientIpMetroCode: geoIp.metro_code, clientIpRegionCode: geoIp.region_code, clientIpRegionName: geoIp.region_name,
                    clientIpLatitude: geoIp.latitude, clientIpLongitude: geoIp.longitude, clientIpTimeZone: geoIp.time_zone}"/>
            <if condition="geoIp.country_code">
                <entity-find entity-name="moqui.basic.Geo" list="geoList">
                    <econdition field-name="geoTypeEnumId" value="GEOT_COUNTRY"/>
                    <econdition field-name="geoCodeAlpha2" from="geoIp.country_code"/></entity-find>
                <if condition="geoList.length"><set field="mapped.clientIpCountryGeoId" from="geoList[0].geoId"/></if>
            </if>
            <if condition="geoIp.region_code">
                <entity-find entity-name="moqui.basic.Geo" list="geoList">
                    <econdition field-name="geoTypeEnumId" operator="in" value="GEOT_STATE,GEOT_PROVINCE,GEOT_TERRITORY"/>
                    <econdition field-name="geoCodeAlpha2" from="geoIp.region_code"/></entity-find>
                <if condition="geoList.length"><set field="mapped.clientIpStateProvGeoId" from="geoList[0].geoId"/></if>
            </if>

            <script>for (const [key, value] of Object.entries(mapped)) { context[key] = value; visit[key] = value }</script>
            <entity-update value-field="visit"/>
        </actions>
    </service>

    <service verb="clean" noun="PrintJobData" authenticate="false" transaction="ignore">
        <description>
            Delete print jobs older than daysToKeep, a chunk of rows at a time, each chunk committed on its own; no chunk
            begins after maxSeconds (plans/High-Level-Review.md HL-033).
        </description>
        <in-parameters>
            <parameter name="daysToKeep" type="Integer" default="7"/>
            <parameter name="maxSeconds" type="Integer" default="600"/>
        </in-parameters>
        <out-parameters><parameter name="printJobsRemoved" type="Long"/></out-parameters>
        <actions><script>
            const basisTimestamp = new Date(ec.user.timestampMillis(ec.user.nowTimestamp) - daysToKeep * 86400000).toISOString()
            printJobsRemoved = ec.entity.find("moqui.basic.print.PrintJob")
                    .condition(ec.entity.conditionFactory.makeCondition("createdDate", "&lt;", basisTimestamp))
                    .disableAuthz().purge(maxSeconds)
            ec.logger.log("info", `Removed ${printJobsRemoved} PrintJob records more than ${daysToKeep} days old`)
        </script></actions>
    </service>

    <service verb="backup" noun="EmbeddedDatabase" type="rust"
            location="moqui_core::service::backup::backup_embedded_database"
            authenticate="false" transaction="ignore">
        <description>
            Live backup of each embedded Postgres cluster this process runs, then the retention ladder, then an
            optional mirror of the archives that remain to the systemMessageRemoteId's sendUrl, over SFTP or to S3,
            plain or encrypted to an age recipient. The schedule is the ServiceJob cron. See docs/Run-Deploy.md#backups.
        </description>
        <in-parameters>
            <parameter name="dailyCount" type="Integer" default="7"/>
            <parameter name="weeklyCount" type="Integer" default="5"/>
            <parameter name="monthlyCount" type="Integer" default="12"/>
            <parameter name="yearlyCount" type="Integer"/>
            <parameter name="backupMode" type="String" default="dump"/>
            <parameter name="backupDir" type="String"/>
            <parameter name="fullEvery" type="Integer" default="7"/>
            <parameter name="chainIncrementals" type="Boolean" default="false">
                <description>In incremental mode, take each incremental from the archive before it rather than from the
                    full: the smallest archives to keep and send; a restore combines the whole chain.</description></parameter>
            <parameter name="fastCheckpoint" type="Boolean" default="false"/>
            <parameter name="timeoutMinutes" type="Integer" default="120"/>
            <parameter name="systemMessageRemoteId" type="String"/>
            <parameter name="mirrorTransport" type="String">
                <description>sftp or s3; empty is s3 for a sendUrl of s3://bucket, else sftp.</description></parameter>
            <parameter name="mirrorEncrypt" type="Boolean" default="false">
                <description>Seal each archive to mirrorRecipient (age format) before it leaves the host; S3 and SFTP
                    both. Restore with age -d and the matching identity, which the host does not hold.</description></parameter>
            <parameter name="mirrorRecipient" type="String">
                <description>The age recipient (age1..., as age-keygen prints) when mirrorEncrypt is on.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="archivePath" type="String"/>
            <parameter name="backupKind" type="String"/>
            <parameter name="bytesWritten" type="Long"/>
            <parameter name="promoted" type="String"/>
            <parameter name="archivesRemoved" type="String"/>
            <parameter name="mirrored" type="String"/>
            <parameter name="skipped" type="String"/>
        </out-parameters>
    </service>
</services>
