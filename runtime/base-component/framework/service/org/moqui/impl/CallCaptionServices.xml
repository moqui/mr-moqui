<!-- Live captions of a call (plans/Comms-Framework.md §5.4, §6.4, W6; docs/interfaces/WebRTC.md, Captions). Someone in the
    call turns them on or off; the call's media node transcribes each speaker's audio in chunks through the speech provider
    (org.moqui.impl.SpeechServices, the model bound to the transcribe feature) and sends the text to every leg as rtc frames,
    with the notice that captions are on and which provider hears the audio. The policy is CallCaptions.js beside this file.

    Refusals carry reasonCode: captionsOff (call_captions_enabled is not true), notSignedIn, notFound (not in the call: the
    same answer as for a call that does not exist), callEnded, encrypted (the call's media is end-to-end encrypted, which
    captions never downgrade), mediaUnavailable (no media node), noProvider (no speech to text set up). Like the call
    services, these check the signed-in user's part in the call themselves; the Calls screen's transitions call them with
    authorization off, each in its own transaction. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="start" noun="Captions">
        <description>Turn on a call's captions, as someone in it. Every leg is told they are on and who transcribes. When
            they are on already, the notice goes out again (repeated).</description>
        <in-parameters>
            <parameter name="callSessionId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="captions" type="Map"/>
            <parameter name="reasonCode"/>
            <parameter name="repeated" type="Boolean"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/CallCaptions.js').execute('start', context))</script></actions>
    </service>

    <service verb="stop" noun="Captions">
        <description>Turn off a call's captions, as someone in it. Stopping when they are off answers repeated.</description>
        <in-parameters>
            <parameter name="callSessionId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="captions" type="Map"/>
            <parameter name="reasonCode"/>
            <parameter name="repeated" type="Boolean"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/CallCaptions.js').execute('stop', context))</script></actions>
    </service>

    <service verb="get" noun="CaptionState">
        <description>A call's captions as the user in it sees them: captions {allowed (the CC button: the policy allows them
            for this call), on, providerLabel, local, startedByUserId}, and reasonCode when not allowed.</description>
        <in-parameters>
            <parameter name="callSessionId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="captions" type="Map"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/CallCaptions.js').execute('getState', context))</script></actions>
    </service>

    <service verb="note" noun="CaptionsLeg" authenticate="false" allow-remote="false">
        <description>Internal (Calls.js, in its transaction): a leg joined a call (a browser's leg bound, a phone answered)
            while its captions are on: its notice is logged (CallCaptionsNotice), and a phone hears it as a prompt (a browser
            has the rtc frame from its media node). Nothing when captions are off.</description>
        <in-parameters>
            <parameter name="callSessionId" required="true"/>
            <parameter name="callLegId" required="true"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/CallCaptions.js').execute('legJoined', context))</script></actions>
    </service>

    <!-- ========== The media node's captions (rtc/captions.rs). On an edge node (plans/Edge-Node.md §5.4, E7) the
        call's rows and the agent runtime's quota are its local node's: these are delegated there (MoquiDefaultConf.xml
        edge) and granted to _EDGE_ (EdgeSetupData.xml). ========== -->
    <service verb="get" noun="CaptionSpeaker" type="rust" location="moqui_core::service::call_media::get_caption_speaker"
            authenticate="false" allow-remote="false" transaction="ignore">
        <description>Internal (the media node's captions): the participant of a leg and the name the call shows for them
            (the participant's displayName, else its user's full name or username). Empty for a leg not found.</description>
        <in-parameters><parameter name="callLegId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="callParticipantId"/>
            <parameter name="name"/>
        </out-parameters>
    </service>
    <service verb="store" noun="CallTranscript" authenticate="false" allow-remote="false">
        <description>Internal (the media node's captions, with call_captions_store): a caption kept as a CallTranscript of
            the call and leg; only for a leg of that call.</description>
        <in-parameters>
            <parameter name="callSessionId" required="true"/>
            <parameter name="callLegId" required="true"/>
            <parameter name="segment" type="Long"/>
            <parameter name="speaker"/>
            <parameter name="text" required="true" allow-html="any"/>
        </in-parameters>
        <out-parameters><parameter name="callTranscriptId"/></out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.call.CallLeg" value-field="leg" disable-authz="true"/>
            <if condition="leg == null || leg.callSessionId != callSessionId">
                <return error="true" message="Leg ${callLegId} is not a leg of call ${callSessionId}"/>
            </if>
            <service-call name="create#moqui.call.CallTranscript" disable-authz="true" out-map="created"
                    in-map="{callSessionId, callLegId, segment, speaker, statusId: 'CtsDone', text,
                        createdDate: ec.user.nowTimestamp}"/>
            <set field="callTranscriptId" from="created.callTranscriptId"/>
        </actions>
    </service>
    <service verb="transcribe" noun="CaptionAudio" type="rust" location="moqui_core::service::call_media::transcribe_caption_audio"
            authenticate="false" allow-remote="false" transaction="ignore">
        <description>Internal (an edge node's captions): a chunk of a call's audio (audioBase64, WAV) through the agent
            runtime's transcribe binding, counted against userId's quota (the user who turned captions on, who must be a
            participant of the call) and kept as an LlmCall with the client captions:(callSessionId). text, or errorCode
            (notBuiltIn, notConfigured, invalid, quota, failed, timeout, or notAllowed for a user not in the call) and
            errorMessage; a provider's refusal is no service error, so its code comes back.</description>
        <in-parameters>
            <parameter name="callSessionId" required="true"/>
            <parameter name="audioBase64" required="true" allow-html="any"/>
            <parameter name="userId"/>
            <parameter name="language"/>
            <parameter name="timeoutSeconds" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="text"/>
            <parameter name="errorCode"/>
            <parameter name="errorMessage"/>
        </out-parameters>
    </service>
</services>
