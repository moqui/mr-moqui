<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="get" noun="ServerPrinters" type="rust" location="moqui_core::service::tools::get_server_printers">
        <description>Get printers from print server and create a moqui.basic.print.NetworkPrinter record for each.
            The body is Rust (crates/moqui-core/src/service/tools.rs), on the host's IPP client.</description>
        <in-parameters>
            <parameter name="serverHost" required="true"/>
            <parameter name="serverPort" type="Integer" default="631"/>
        </in-parameters>
        <out-parameters>
            <parameter name="networkPrinterIdList" type="List"><parameter name="networkPrinterId"/></parameter>
        </out-parameters>
    </service>
    <service verb="print" noun="DocumentInterface">
        <in-parameters>
            <parameter name="networkPrinterId" required="true"/>
            <parameter name="createdDate" type="Timestamp" default="ec.user.nowTimestamp"/>
            <parameter name="username"/>
            <parameter name="jobName"/>
            <parameter name="copies" type="Integer" default="1"/>
            <parameter name="duplex" default-value="N"/>
            <parameter name="pageRanges"/>
            <parameter name="orientation"><description>portrait or landscape (IPP orientation-requested); empty leaves it
                to the print queue. Java's cups4j asked for portrait on every job.</description>
                <matches regexp="portrait|landscape" message="Orientation must be portrait or landscape"/></parameter>
            <parameter name="colorMode"><description>color or monochrome (IPP print-color-mode); empty leaves it to the
                print queue. Java's cups4j asked for monochrome on every job.</description>
                <matches regexp="color|monochrome" message="Color mode must be color or monochrome"/></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="printJobId"/>
            <parameter name="jobId" type="Integer"/>
        </out-parameters>
    </service>
    <service verb="print" noun="Document" type="rust" location="moqui_core::service::tools::print_document">
        <description>Create a moqui.basic.print.PrintJob record and send it to the specified NetworkPrinter.
            The body is Rust (crates/moqui-core/src/service/tools.rs).</description>
        <implements service="org.moqui.impl.PrintServices.print#DocumentInterface"/>
        <in-parameters>
            <parameter name="storeDocument" type="Boolean" default="true"/>
            <parameter name="contentType"/>

            <parameter name="inputStream" type="InputStream"><description>The document may be passed in this
                parameter as an InputStream or in the serialBlob field as a wrapped byte[].</description></parameter>
            <parameter name="serialBlob" type="SerialBlob">
                <description>Use SerialBlob as a wrapper for byte[].</description></parameter>
        </in-parameters>
    </service>
    <service verb="print" noun="ResourceDocument" type="rust" location="moqui_core::service::tools::print_resource_document">
        <description>The body is Rust (crates/moqui-core/src/service/tools.rs).</description>
        <!-- org.moqui.impl.PrintServices.print#ResourceDocument -->
        <implements service="org.moqui.impl.PrintServices.print#DocumentInterface"/>
        <in-parameters>
            <parameter name="resourceLocation" required="true"/>
        </in-parameters>
    </service>
    <service verb="print" noun="ScreenDocument" type="rust" location="moqui_core::service::tools::print_screen_document">
        <description>The body is Rust (crates/moqui-core/src/service/tools.rs). The screen renders as html-print and
            PdfRenderer makes the PDF; without a Chromium binary the call reports that PDF is not available.</description>
        <!-- org.moqui.impl.PrintServices.print#ScreenDocument -->
        <implements service="org.moqui.impl.PrintServices.print#DocumentInterface"/>
        <in-parameters>
            <parameter name="screenLocation" required="true"/>
            <parameter name="screenParameters" type="Map"/>
            <parameter name="screenParametersStr"><description>Groovy expression that evaluates to a Map</description></parameter>
            <parameter name="contentType" default-value="application/pdf"/>
            <parameter name="webappName" default-value="webroot"/>
            <parameter name="storeDocument" type="Boolean" default="true"/>
        </in-parameters>
    </service>

    <service verb="send" noun="PrintJob">
        <in-parameters><parameter name="printJobId" required="true"/></in-parameters>
        <actions>
            <entity-find-one entity-name="moqui.basic.print.PrintJob" value-field="printJob"/>
            <service-call name="org.moqui.impl.PrintServices.send#PrintJobInternal"
                    in-map="{printJob: printJob}" out-map="context"/>
        </actions>
    </service>
    <service verb="send" noun="PrintJobInternal" type="rust" location="moqui_core::service::tools::send_print_job_internal">
        <description>Send the job's document to its NetworkPrinter over IPP (the moqui-cups port): taken, the job is
            PtjPending with the server's jobId; refused or unreachable, it is PtjSendFailed with the errorMessage and the
            call returns the error. The body is Rust (crates/moqui-core/src/service/tools.rs).</description>
        <in-parameters><parameter name="printJob" type="EntityValue" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="jobId" type="Integer"/>
        </out-parameters>
    </service>

    <service verb="get" noun="PrintJobDetailsFromServer" type="rust" location="moqui_core::service::tools::get_print_job_details">
        <!-- org.moqui.impl.PrintServices.get#PrintJobDetailsFromServer: the body is Rust (crates/moqui-core/src/service/tools.rs) -->
        <description>Gets known local job details (from PrintJob record) job details/attributes from the print server,
            updating PrintJob record for status and just returning the rest.</description>
        <in-parameters><parameter name="printJobId"/></in-parameters>
        <out-parameters>
            <auto-parameters entity-name="moqui.basic.print.PrintJob" include="nonpk"/>

            <parameter name="completeTime" type="Timestamp"/>
            <parameter name="createTime" type="Timestamp"/>
            <parameter name="jobUrl"/>
            <parameter name="pagesPrinted" type="Integer"/>
            <parameter name="printerUrl"/>
            <parameter name="size" type="Integer"/>
        </out-parameters>
    </service>

    <service verb="hold" noun="PrintJob" type="rust" location="moqui_core::service::tools::hold_print_job">
        <!-- org.moqui.impl.PrintServices.hold#PrintJob: the body is Rust (crates/moqui-core/src/service/tools.rs) -->
        <in-parameters><parameter name="printJobId"/></in-parameters>
    </service>
    <service verb="release" noun="PrintJob" type="rust" location="moqui_core::service::tools::release_print_job">
        <!-- org.moqui.impl.PrintServices.release#PrintJob: the body is Rust (crates/moqui-core/src/service/tools.rs) -->
        <in-parameters><parameter name="printJobId"/></in-parameters>
    </service>
    <service verb="cancel" noun="PrintJob" type="rust" location="moqui_core::service::tools::cancel_print_job">
        <!-- org.moqui.impl.PrintServices.cancel#PrintJob: the body is Rust (crates/moqui-core/src/service/tools.rs) -->
        <in-parameters><parameter name="printJobId"/></in-parameters>
    </service>
</services>
