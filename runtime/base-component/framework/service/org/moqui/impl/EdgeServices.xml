<!-- The edge link (plans/Edge-Node.md §5.2, §5.3, §5.7) for the System app: on a local node its Edge Node screen
    (check, pair, status, unpair), and on an edge node (node_role=edge) its Edge Clients screen (pairing codes, paired
    local nodes, revoke, their public host names); the link's queue and replication on both. The bodies are Rust
    (crates/moqui-core/src/service/edge.rs) over the host's edge link (crates/moqui-host/src/edge_link/, the edge
    feature, in Maximal and Enterprise). In a binary without it each service fails with "edge link not built into this
    host", except get#LinkStatus, which answers state notBuilt (or notStarted in a binary with the link but no HTTP
    listener). All are internal (allow-remote false) and for an administrator: pairing writes keys to runtime/.env. The
    model is framework/entity/EdgeEntities.xml. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="get" noun="LinkStatus" type="rust" location="moqui_core::service::edge::get_link_status"
            allow-remote="false" transaction="ignore">
        <description>The local node's link: state (unpaired, connecting, linked, retrying, refused; notBuilt in a binary
            without the edge link, notStarted in one with it where no HTTP listener started it, as under moqui test),
            the edge node's URL, the link generation, the round trip of the last Ping on the up connection, when the link
            last came up, the last error, the links lost since start, and the edge node as its last Hello said, with the
            pinned fingerprint. nodeRole is this node's node_role; on an edge node linkFingerprint is its own link key's
            fingerprint.</description>
        <out-parameters>
            <parameter name="nodeRole"/>
            <parameter name="state"/>
            <parameter name="url"/>
            <parameter name="generation" type="Long"/>
            <parameter name="rttMs" type="Double"/>
            <parameter name="lastConnectDate" type="Timestamp"/>
            <parameter name="lastError"/>
            <parameter name="reconnects" type="Long"/>
            <parameter name="linkFingerprint"><description>On an edge node, the fingerprint of its own link key
                (edge_link_key; SHA-256 of the public key, hex), to compare with what a local node's check#EdgeNode
                shows; empty on any other node. The key itself is never shown.</description></parameter>
            <parameter name="edgeName"/>
            <parameter name="fingerprint"/>
            <parameter name="binaryVersion"/>
            <parameter name="linkVersion" type="Long"/>
            <parameter name="features" type="List"/>
            <parameter name="capabilities" type="List"/>
            <parameter name="publicNames" type="List"/>
            <parameter name="compatible" type="Boolean"/>
            <parameter name="message"/>
        </out-parameters>
    </service>

    <service verb="check" noun="EdgeNode" type="rust" location="moqui_core::service::edge::check_edge_node"
            allow-remote="false" transaction="ignore">
        <description>Connect to the edge node at url (https://host or https://host:port), check its web certificate by
            WebPKI, and answer its name, the fingerprint of its link key (edge_link_key), versions and offer, without
            pairing: for the operator to confirm before pair#EdgeNode. compatible is false, with message, when the link
            protocol versions are more than one apart.</description>
        <in-parameters><parameter name="url" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="edgeName"/>
            <parameter name="fingerprint"/>
            <parameter name="binaryVersion"/>
            <parameter name="linkVersion" type="Long"/>
            <parameter name="features" type="List"/>
            <parameter name="capabilities" type="List"/>
            <parameter name="publicNames" type="List"/>
            <parameter name="compatible" type="Boolean"/>
            <parameter name="message"/>
        </out-parameters>
    </service>

    <service verb="pair" noun="EdgeNode" type="rust" location="moqui_core::service::edge::pair_edge_node"
            allow-remote="false" transaction="ignore">
        <description>Pair this local node with the edge node at url, using the one-use code its operator made: make this
            node's key, have the edge node pin it, pin the edge node's link key (refused when expectFingerprint, the
            fingerprint check#EdgeNode showed, is given and differs), write edge_node_url, edge_node_key and edge_node_pin to
            runtime/.env, and bring the link up without a restart. keyFingerprint is this node's key as the edge node
            pinned it.</description>
        <in-parameters>
            <parameter name="url" required="true"/>
            <parameter name="code" required="true"/>
            <parameter name="expectFingerprint"/>
        </in-parameters>
        <out-parameters>
            <parameter name="keyFingerprint"/>
            <parameter name="edgeName"/>
            <parameter name="fingerprint"/>
            <parameter name="binaryVersion"/>
            <parameter name="linkVersion" type="Long"/>
            <parameter name="features" type="List"/>
            <parameter name="capabilities" type="List"/>
            <parameter name="publicNames" type="List"/>
            <parameter name="compatible" type="Boolean"/>
            <parameter name="message"/>
        </out-parameters>
    </service>

    <service verb="unpair" noun="EdgeNode" type="rust" location="moqui_core::service::edge::unpair_edge_node"
            allow-remote="false" transaction="ignore">
        <description>Tell the edge node to revoke this node's key (when the link is up), close the link and remove
            edge_node_url, edge_node_key and edge_node_pin from runtime/.env.</description>
    </service>

    <service verb="create" noun="PairingCode" type="rust" location="moqui_core::service::edge::create_pairing_code"
            allow-remote="false">
        <description>On an edge node: a one-use pairing code for a local node, good for validMinutes (60 by default, at
            most 1440). The code is shown once; only its hash is kept (moqui.edge.EdgePairingCode).</description>
        <in-parameters><parameter name="validMinutes" type="Integer" default-value="60"/></in-parameters>
        <out-parameters>
            <parameter name="pairingCodeId"/>
            <parameter name="code"/>
            <parameter name="expireDate" type="Timestamp"/>
        </out-parameters>
    </service>

    <service verb="get" noun="EdgeClients" type="rust" location="moqui_core::service::edge::get_edge_clients"
            allow-remote="false" transaction="ignore">
        <description>On an edge node: the paired local nodes (moqui.edge.EdgeClient) with their live links: linked (the up
            connection is open), down (the down connection too), the generation, the remote address, and the versions of
            their last Hello.</description>
        <out-parameters>
            <parameter name="clientList" type="List"><parameter name="client" type="Map">
                <parameter name="pairedNodeId"/><parameter name="keyFingerprint"/><parameter name="statusId"/>
                <parameter name="linked" type="Boolean"/><parameter name="down" type="Boolean"/>
                <parameter name="generation" type="Long"/><parameter name="lastConnectDate" type="Timestamp"/>
                <parameter name="remoteAddress"/><parameter name="binaryVersion"/><parameter name="linkVersion" type="Long"/>
            </parameter></parameter>
        </out-parameters>
    </service>

    <service verb="revoke" noun="EdgeClient" type="rust" location="moqui_core::service::edge::revoke_edge_client"
            allow-remote="false">
        <description>On an edge node: revoke a local node's key and close its link; it can link again only by pairing
            with a new code. revoked is false when no such node is paired.</description>
        <in-parameters><parameter name="pairedNodeId" required="true"/></in-parameters>
        <out-parameters><parameter name="revoked" type="Boolean"/></out-parameters>
    </service>

    <service verb="ping" noun="EdgeClient" type="rust" location="moqui_core::service::edge::ping_edge_client"
            allow-remote="false" transaction="ignore">
        <description>On an edge node: a Ping down a linked local node's down connection; rttMs is its round
            trip.</description>
        <in-parameters><parameter name="pairedNodeId" required="true"/></in-parameters>
        <out-parameters><parameter name="rttMs" type="Double"/></out-parameters>
    </service>

    <service verb="get" noun="EdgeHosts" type="rust" location="moqui_core::service::edge::get_edge_hosts"
            allow-remote="false" transaction="ignore">
        <description>On an edge node: the public host names of the paired local nodes (moqui.edge.EdgeHost), of one
            node when pairedNodeId is given.</description>
        <in-parameters><parameter name="pairedNodeId"/></in-parameters>
        <out-parameters>
            <parameter name="hostList" type="List"><parameter name="host" type="Map">
                <parameter name="hostName"/><parameter name="pairedNodeId"/><parameter name="modeEnumId"/>
            </parameter></parameter>
        </out-parameters>
    </service>

    <service verb="add" noun="EdgeHost" type="rust" location="moqui_core::service::edge::add_edge_host"
            allow-remote="false" transaction="ignore">
        <description>On an edge node: a public host name for a paired local node, EdgeHostPassthrough (the default) or
            EdgeHostTerminate; for a name the node has already, its mode changes. The name is saved in lower case with no
            port; a name another node has is refused. The edge node uses it at once.</description>
        <in-parameters>
            <parameter name="hostName" required="true"/>
            <parameter name="pairedNodeId" required="true"/>
            <parameter name="modeEnumId" default-value="EdgeHostPassthrough"/>
        </in-parameters>
        <out-parameters><parameter name="hostName"/><parameter name="modeEnumId"/></out-parameters>
    </service>

    <service verb="remove" noun="EdgeHost" type="rust" location="moqui_core::service::edge::remove_edge_host"
            allow-remote="false" transaction="ignore">
        <description>On an edge node: remove a public host name; the edge node stops answering for it at once. removed
            is false when there was no such name.</description>
        <in-parameters><parameter name="hostName" required="true"/></in-parameters>
        <out-parameters><parameter name="removed" type="Boolean"/></out-parameters>
    </service>

    <!-- ========== How work crosses the link (plans/Edge-Node.md §5.2): queue and replicate ========== -->
    <service verb="enqueue" noun="Item" type="rust" location="moqui_core::service::edge::enqueue_item"
            allow-remote="false">
        <description>Queue an item for the other end of the link (moqui.edge.EdgeQueueItem): on an edge node for its
            local node (pairedNodeId, or the only one paired), on a local node for its edge node. It is delivered once
            the link is up, in order with the other items of its conversationKey, and applied on the receiver once, by
            the service its edge queue-kind conf names for kind, in the transaction of its receipt. An idempotencyKey
            queued already returns that item (created false); with none the item's id is its key. The payload is text
            (JSON) of at most 1 MiB; contentLocation names a larger body (a dbresource:// file, up to 64 MiB), copied
            into the item here and sent over the link before it, and its handler gets where the receiver kept
            it.</description>
        <in-parameters>
            <parameter name="kind" required="true"/>
            <parameter name="conversationKey" required="true"/>
            <parameter name="idempotencyKey"/>
            <parameter name="payload" allow-html="any"/>
            <parameter name="contentLocation"/>
            <parameter name="pairedNodeId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="queueItemId"/>
            <parameter name="created" type="Boolean"/>
        </out-parameters>
    </service>

    <service verb="get" noun="QueueStatus" type="rust" location="moqui_core::service::edge::get_queue_status"
            allow-remote="false" transaction="ignore">
        <description>The link's queue on this node, by paired node, direction and kind: items waiting, failed, and when
            the oldest waiting one was queued (of one node with pairedNodeId); whether this node's delivery is paused;
            on a local node its replicated sets (epoch, last batch acknowledged, changes waiting, whether a full send is
            due), and on an edge node the cursor of each node's set with its count of records.</description>
        <in-parameters><parameter name="pairedNodeId"/></in-parameters>
        <out-parameters>
            <parameter name="kindList" type="List"><parameter name="kindStats" type="Map">
                <parameter name="pairedNodeId"/><parameter name="directionEnumId"/><parameter name="kind"/>
                <parameter name="pending" type="Long"/><parameter name="failed" type="Long"/>
                <parameter name="oldestDate" type="Timestamp"/><parameter name="oldestAgeSeconds" type="Long"/>
            </parameter></parameter>
            <parameter name="paused" type="Boolean"/>
            <parameter name="setList" type="List"><parameter name="set" type="Map">
                <parameter name="setName"/><parameter name="epoch"/><parameter name="acked" type="Long"/>
                <parameter name="waiting" type="Long"/><parameter name="snapshotNeeded" type="Boolean"/>
                <parameter name="lastAckDate" type="Timestamp"/><parameter name="lastSnapshotDate" type="Timestamp"/>
            </parameter></parameter>
            <parameter name="cursorList" type="List"><parameter name="cursor" type="Map">
                <parameter name="pairedNodeId"/><parameter name="setName"/><parameter name="epoch"/>
                <parameter name="sequenceNum" type="Long"/><parameter name="values" type="Long"/>
                <parameter name="snapshotDate" type="Timestamp"/><parameter name="appliedDate" type="Timestamp"/>
            </parameter></parameter>
        </out-parameters>
    </service>

    <service verb="pause" noun="QueueDelivery" type="rust" location="moqui_core::service::edge::pause_queue_delivery"
            allow-remote="false" transaction="ignore">
        <description>Pause this node's queue delivery (paused true, the default) or resume it: while paused, every
            delivery from the other end is answered "paused" (it is tried again, and not counted as an attempt) and this
            node's own items wait. Kept in memory: a restart resumes.</description>
        <in-parameters><parameter name="paused" type="Boolean" default-value="true"/></in-parameters>
        <out-parameters><parameter name="paused" type="Boolean"/></out-parameters>
    </service>

    <service verb="resync" noun="Replication" type="rust" location="moqui_core::service::edge::resync_replication"
            allow-remote="false" transaction="ignore">
        <description>On a local node: send every replicated set to the edge node whole again, under a new epoch; the
            edge node then removes what the full send did not have. On an edge node: forget the cursors (of one node
            with pairedNodeId), so each node's next batch asks for its set whole. sets is how many.</description>
        <in-parameters><parameter name="pairedNodeId"/></in-parameters>
        <out-parameters><parameter name="sets" type="Long"/></out-parameters>
    </service>

    <service verb="get" noun="ReplicaValues" type="rust" location="moqui_core::service::edge::get_replica_values"
            allow-remote="false" transaction="ignore">
        <description>On an edge node: the copies of a local node's replicated set (moqui.edge.EdgeReplicaValue), of one
            entity with entityName, of one record with entityName and pk (its key fields), of one node with
            pairedNodeId; at most limit. Each has its entity, its key and the set's fields of it.</description>
        <in-parameters>
            <parameter name="setName" required="true"/>
            <parameter name="entityName"/>
            <parameter name="pk" type="Map"/>
            <parameter name="pairedNodeId"/>
            <parameter name="limit" type="Integer" default-value="1000"/>
        </in-parameters>
        <out-parameters>
            <parameter name="valueList" type="List"><parameter name="value" type="Map">
                <parameter name="pairedNodeId"/><parameter name="entityName"/>
                <parameter name="pk" type="Map"/><parameter name="fields" type="Map"/>
            </parameter></parameter>
        </out-parameters>
    </service>

    <!-- A diagnostic for an operator after pairing: list echo#Delegate in edge delegate on both nodes and call it on
        the edge node to check a delegated call end to end. It is the first member of the EDGE_DELEGATE artifact group,
        and changes nothing beyond its answer. -->
    <service verb="echo" noun="Delegate" allow-remote="false" transaction="ignore">
        <description>A delegated call's echo: on the local node it answers its message, the user it ran as (_edge_ for a
            delegated call) and the caller the edge node named. List it in edge delegate on both nodes to use
            it.</description>
        <in-parameters>
            <parameter name="message"/>
            <parameter name="edgeCaller" type="Map"/>
        </in-parameters>
        <out-parameters>
            <parameter name="message"/>
            <parameter name="username"/>
            <parameter name="edgeCaller" type="Map"/>
        </out-parameters>
        <actions>
            <set field="username" from="ec.user.username"/>
        </actions>
    </service>
</services>
