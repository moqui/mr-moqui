<!-- Desk and soft phones (plans/Comms-Framework.md §5.2 "Registrar for phones", §5.4, V4): a user's phones that register with
    Moqui's registrar, the SIP engine's lookups and bindings, and the calls to and from them. The model is the V4 block of
    framework/entity/VoiceEntities.xml (SipDevice, SipDeviceVerifier, SipRegistration); the logic is SipDevices.js beside
    this file, and a device's leg (CltSipDevice) is the CallServices state machine's (Calls.js deviceEvent). The registrar
    is the host's SIP engine (crates/moqui-host/src/sip/phones.rs, moqui-sip ua_phones.rs), on only with
    sip_registrar_enabled. No Java counterpart.

    Access. create#SipDevice, rotate#SipDeviceCredential, revoke#SipDevice and find#SipDevices are the current user's for
    their own phones; a voice admin (VoiceAdmin) may act on anyone's, and another user is refused as "not found" with the
    same parameters. The engine's services and make#SipCredential are internal. docs/interfaces/SIP.md, "Registrar", has the
    phone setup, NAT notes and the settings. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== The user's phones ========== -->

    <service verb="create" noun="SipDevice">
        <description>Add a desk or soft phone for the current user (or, for a voice admin, for userId): a generated SIP
            username and a strong password, which comes back here once and is never stored (only its digest verifiers,
            encrypted: SHA-256, and MD5 too when deviceProfile is legacy, for a phone without SHA-256). With them the domain,
            the SIP and TLS ports and the transport to choose, and registrarEnabled (false: phones cannot register yet).
            Refusals carry reasonCode: notSignedIn, notAllowed, notFound, tooManyDevices (10 at once), failed.</description>
        <in-parameters>
            <parameter name="name"/>
            <parameter name="deviceProfile" default-value="standard"><description>standard or legacy</description></parameter>
            <parameter name="userId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="sipDeviceId"/>
            <parameter name="username"/>
            <parameter name="password"><description>Shown once: it is not stored</description></parameter>
            <parameter name="domain"/>
            <parameter name="sipPort" type="Integer"/>
            <parameter name="tlsPort" type="Integer"/>
            <parameter name="transport"/>
            <parameter name="registrarEnabled" type="Boolean"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/SipDevices.js').execute('create', context))</script></actions>
    </service>

    <service verb="rotate" noun="SipDeviceCredential">
        <description>New credentials for a phone of the current user (or any, for a voice admin): the same username and a
            new password, shown once. The credential revision goes up, the old verifiers are deleted, and the phone's
            registrations end on every SIP engine, so it must register again with the new password. reasonCode notFound (not
            theirs), revoked, failed.</description>
        <in-parameters>
            <parameter name="sipDeviceId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="sipDeviceId"/>
            <parameter name="username"/>
            <parameter name="password"/>
            <parameter name="domain"/>
            <parameter name="sipPort" type="Integer"/>
            <parameter name="tlsPort" type="Integer"/>
            <parameter name="transport"/>
            <parameter name="registrarEnabled" type="Boolean"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/SipDevices.js').execute('rotate', context))</script></actions>
    </service>

    <service verb="revoke" noun="SipDevice">
        <description>Remove a phone of the current user (or any, for a voice admin): its verifiers are deleted, its
            registrations end and its calls on each SIP engine hang up; it cannot register or ring again. reasonCode notFound
            (not theirs); repeated when it was removed already.</description>
        <in-parameters>
            <parameter name="sipDeviceId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="sipDeviceId"/>
            <parameter name="repeated" type="Boolean"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/SipDevices.js').execute('revoke', context))</script></actions>
    </service>

    <service verb="find" noun="SipDevices">
        <description>The current user's phones (userId another's, or allUsers, for a voice admin only), newest first, the
            removed ones too with includeRevoked: name, username, profile, status, when it was added and last seen, and its
            live registrations (contact, transport, the address and port it registered from, its user agent, when it
            expires, whether it uses Outbound). Never a password or a verifier. With them the server setup (domain, ports,
            registrarEnabled).</description>
        <in-parameters>
            <parameter name="userId"/>
            <parameter name="allUsers" type="Boolean" default="false"/>
            <parameter name="includeRevoked" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="deviceList" type="List"/>
            <parameter name="domain"/>
            <parameter name="sipPort" type="Integer"/>
            <parameter name="tlsPort" type="Integer"/>
            <parameter name="transport"/>
            <parameter name="registrarEnabled" type="Boolean"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/SipDevices.js').execute('findDevices', context))</script></actions>
    </service>

    <!-- ========== Internal ========== -->

    <service verb="make" noun="SipCredential" type="rust" location="moqui_core::service::sip_credential::make_sip_credential"
            authenticate="false" allow-remote="false" transaction="ignore">
        <description>Internal (create# and rotate#): a new password for username (generated, ten digits, when empty) and its
            digest verifiers for realm (HA1, SHA-256; MD5 too when legacy).</description>
        <in-parameters>
            <parameter name="realm" required="true"/>
            <parameter name="username"/>
            <parameter name="legacy" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="username"/>
            <parameter name="password"/>
            <parameter name="verifierList" type="List"/>
        </out-parameters>
    </service>

    <service verb="get" noun="SipDeviceAuth" authenticate="false" allow-remote="false">
        <description>Internal (the SIP engine, on a REGISTER or INVITE that answers a challenge): the active device with
            this username, its credential revision and its verifiers for realm, decrypted. Nothing for a removed device, one
            whose user is disabled, or no such device.</description>
        <in-parameters>
            <parameter name="username" required="true"/>
            <parameter name="realm"/>
        </in-parameters>
        <out-parameters>
            <parameter name="sipDeviceId"/>
            <parameter name="username"/>
            <parameter name="credentialRevision" type="Integer"/>
            <parameter name="verifierList" type="List"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/SipDevices.js').execute('deviceAuth', context))</script></actions>
    </service>

    <service verb="store" noun="SipRegistration" authenticate="false" allow-remote="false">
        <description>Internal (the SIP engine): a binding was added, refreshed or removed (change). Kept as its
            SipRegistration row, and the device's lastSeenDate; one of an older credential revision, or of a removed device,
            is not kept.</description>
        <in-parameters>
            <parameter name="change" required="true"/>
            <parameter name="sipRegistrationId" required="true"/>
            <parameter name="sipDeviceId"/>
            <parameter name="instanceId"/>
            <parameter name="contactUri"/>
            <parameter name="transport"/>
            <parameter name="sourceAddress"/>
            <parameter name="sourcePort" type="Integer"/>
            <parameter name="sipCallId"/>
            <parameter name="cseq" type="Long"/>
            <parameter name="instanceKey"/>
            <parameter name="regId" type="Integer"/>
            <parameter name="outbound" type="Boolean"/>
            <parameter name="credentialRevision" type="Integer"/>
            <parameter name="expiresDate" type="Long"/>
            <parameter name="lastRefreshDate" type="Long"/>
            <parameter name="userAgent"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/SipDevices.js').execute('storeRegistration', context))</script></actions>
    </service>

    <service verb="expire" noun="SipRegistrations" authenticate="false" allow-remote="false">
        <description>Internal (the job expire_SipRegistrations, every 5 minutes): removes the registrations past their
            expiry and those whose SIP engine stopped. Each row on its own.</description>
        <out-parameters>
            <parameter name="removedCount" type="Integer"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/SipDevices.js').execute('expireRegistrations', context))</script></actions>
    </service>

    <service verb="ring" noun="SipDevices" authenticate="false" allow-remote="false">
        <description>Internal (Calls.js, when a call rings users): rings the users' phones registered with the call's node,
            a CltSipDevice leg offered for each, which that node's SIP engine forks to the phone's live bindings. From
            fromUserId's username, else the call's phone number. Nothing while the registrar is off, and nothing for an
            end-to-end encrypted call (W8, reasonCode encrypted): a phone cannot decrypt it.</description>
        <in-parameters>
            <parameter name="callSessionId" required="true"/>
            <parameter name="userIdList" type="List" required="true"/>
            <parameter name="fromUserId"/>
            <parameter name="fromName"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ringCount" type="Integer"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/SipDevices.js').execute('ringDevices', context))</script></actions>
    </service>

    <service verb="receive" noun="DeviceCall" authenticate="false" allow-remote="false">
        <description>Internal (the SIP engine of instanceId, after the phone's digest answer): a registered phone's call to
            toUser, placed as the phone's user with the phone as their leg (callLegId): another user's username is an internal
            call; anything else is a number, through place#PhoneCall's checks (outbound permission, caller ID, fraud limits,
            emergency first). Refusals carry place#PhoneCall's reasonCodes, or notAllowed (the registrar is off, the phone was
            removed).</description>
        <in-parameters>
            <parameter name="sipDeviceId" required="true"/>
            <parameter name="toUser" required="true"/>
            <parameter name="instanceId" required="true"/>
            <parameter name="sipCallId"/>
            <parameter name="sourceAddress"/>
        </in-parameters>
        <out-parameters>
            <parameter name="callSessionId"/>
            <parameter name="callLegId"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/SipDevices.js').execute('receiveDeviceCall', context))</script></actions>
    </service>
</services>
