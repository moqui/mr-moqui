<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== ScheduledScreen Services ========== -->

    <service verb="render" noun="ScheduledScreens" authenticate="anonymous-all">
        <actions>
            <entity-find entity-name="moqui.screen.ScreenScheduled" list="screenScheduledList" cache="true">
                <date-filter/></entity-find>
            <iterate list="screenScheduledList" entry="screenScheduled">
                <if condition="screenScheduled.paused == 'Y'"><continue/></if>
                <if condition="!screenScheduled.cronExpression">
                    <log level="warn" message="ScreenScheduled ${screenScheduled.screenScheduledId} has no cronExpression, not running"/>
                    <continue/>
                </if>

                <!-- check cronExpression vs lastRunTime to see if we need to run -->
                <entity-find-one entity-name="moqui.screen.ScreenScheduledLock" value-field="screenScheduledLock">
                    <field-map field-name="screenScheduledId" from="screenScheduled.screenScheduledId"/></entity-find-one>
                <set field="shouldRun" from="ec.service.isLastRunBeforeLastSchedule(screenScheduled.cronExpression, screenScheduledLock?.lastRunTime)"/>

                <if condition="shouldRun">
                    <service-call name="org.moqui.impl.ScreenServices.render#ScheduledScreen"
                            in-map="{screenScheduledId: screenScheduled.screenScheduledId}" async="true"/>
                </if>
            </iterate>
        </actions>
    </service>
    <service verb="render" noun="ScheduledScreen" authenticate="anonymous-all">
        <in-parameters>
            <parameter name="screenScheduledId" required="true"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="moqui.screen.ScreenScheduled" value-field="screenScheduled" cache="true"/>
            <if condition="screenScheduled.reportDefinitionId">
                <service-call name="org.moqui.report.ReportServices.run#ScheduledReport" in-map="{screenScheduledId: screenScheduledId}"/>
                <return/>
            </if>
            <set field="screenPath" from="screenScheduled.screenPath"/>
            <set field="renderMode" from="screenScheduled.renderMode || 'csv'"/>
            <set field="formListFindId" from="screenScheduled.formListFindId"/>
            <set field="saveToLocation" from="screenScheduled.saveToLocation"/>

            <!-- NOTE: emailTemplate may be null, if so don't sent email -->
            <set field="emailTemplate" from="screenScheduled.emailTemplate"/>
            <set field="webappName" from="emailTemplate?.webappName || 'webroot'"/>
            <set field="webHostName" from="emailTemplate?.webHostName"/>
            <!-- Java falls back to the webapp's https-host; the port's links take the configured base URL -->

            <!-- return here if validations fail -->
            <if condition="!screenPath"><log level="error" message="ScreenScheduled ${screenScheduledId} has no screenPath, not running"/><return/></if>
            <if condition="emailTemplate == null &amp;&amp; !saveToLocation"><log level="error" message="ScreenScheduled ${screenScheduledId} has no emailTemplate or saveToLocation, not running"/><return/></if>

            <if condition="screenScheduled.userId">
                <entity-find-one entity-name="moqui.security.UserAccount" value-field="userAccount">
                    <field-map field-name="userId" from="screenScheduled.userId"/></entity-find-one>
            </if>

            <!-- lock the ScreenScheduled row first, as the report runs do before their lock record: a lock on a missing
                lock record locks nothing, so a second run at once waits here, then finds the record the first created.
                Locking the parent first also keeps two runs from deadlocking on MySQL at REPEATABLE READ, where a
                for-update find of a missing row takes a gap lock that the other run's insert waits for. -->
            <entity-find-one entity-name="moqui.screen.ScreenScheduled" value-field="lockedScheduled" for-update="true" cache="false"/>
            <!-- get the lock record with for-update to make sure we're the only one running, if no record create one to lock -->
            <entity-find-one entity-name="moqui.screen.ScreenScheduledLock" value-field="screenScheduledLock" for-update="true"/>
            <if condition="screenScheduledLock == null">
                <service-call name="create#moqui.screen.ScreenScheduledLock"
                        in-map="{screenScheduledId: screenScheduledId, lastRunTime: ec.user.nowTimestamp}"/>
            </if>

            <!-- check again to make sure should run, now that all is locked -->
            <set field="shouldRun" from="ec.service.isLastRunBeforeLastSchedule(screenScheduled.cronExpression, screenScheduledLock?.lastRunTime)"/>
            <if condition="!shouldRun"><return type="warning" message="ScreenScheduled ${screenScheduled.screenScheduledId} is not yet scheduled to run since last run time ${screenScheduledLock?.lastRunTime}"/></if>

            <!-- render screen -->
            <script><![CDATA[
                // TODO FUTURE: support renderMode == 'html' with inline content instead of attached

                attachmentInfo = null

                const extension = renderMode == "xsl-fo" ? "pdf" : renderMode
                const lastPath = screenPath.substring(screenPath.lastIndexOf("/") + 1)
                const filename = lastPath + "-" + ec.l10n.format(ec.user.nowTimestamp, "yyyy-MM-dd-HH-mm") + "." + extension

                emailSubject = ec.resource.expand(screenScheduled.emailSubject || "", null)
                if (!emailSubject) emailSubject = `Scheduled Report ${lastPath} ${ec.l10n.format(ec.user.nowTimestamp, null)}`

                bodyParameters = {pageNoLimit: 'true', emailSubject: emailSubject, title: emailSubject, screenPath: screenPath, webHostName: webHostName}
                for (const [key, value] of Object.entries(bodyParameters)) context[key] = value

                // login user before rendering screen, render as user
                if (userAccount != null) ec.user.internalLoginUser(userAccount.username)

                // A saved form-list find goes to the render as formListFindId, which applies its parameters, order and
                // columns as for a request that names it; Java also adds those parameters to the email bodyParameters
                const screenRender = ec.screen.makeRender().webappName(webappName).rootScreenFromHost(webHostName || 'localhost')
                        .screenPath(screenPath).renderMode(renderMode)
                if (formListFindId) screenRender.parameters({formListFindId: formListFindId})
                // TODO: consider config or something for protocol and port
                if (webHostName) screenRender.baseLinkUrl(`https://${webHostName}`)
                if (renderMode == "xsl-fo") {
                    // TODO: consider making this configurable on ScreenScheduled or something
                    layoutMaster = "letter-landscape"
                } else {
                    // xsl-fo needs the full render path for header/footer, others better just the last screen
                    screenRender.lastStandalone("true")
                }

                if (ec.screen.isRenderModeText(renderMode)) {
                    const screenText = screenRender.render()
                    if (screenText != null && screenText.trim().length > 0) {
                        if (renderMode == "xsl-fo") {
                            // ResourceFacade.xslFoTransform() turns the html-print document into PDF bytes
                            try {
                                const pdfBytes = ec.resource.xslFoTransform(screenText, null, null, "application/pdf")
                                attachmentInfo = {fileName: filename, contentType: "application/pdf", contentBytes: pdfBytes}
                            } catch (e) {
                                ec.logger.warn(`Error generating PDF from XSL-FO: ${e}`)
                            }
                        } else {
                            const mimeType = ec.screen.getMimeTypeByMode(renderMode)
                            attachmentInfo = {fileName: filename, contentType: mimeType, contentText: screenText}
                        }
                    }
                } else {
                    // a binary render mode (xlsx): the bytes are the document, as Java's render to an output stream
                    const screenBytes = screenRender.renderBytes()
                    if (screenBytes != null && screenBytes.length > 0) {
                        attachmentInfo = {fileName: filename, contentType: ec.screen.getMimeTypeByMode(renderMode), contentBytes: screenBytes}
                    }
                }
            ]]></script>

            <!-- if noResultsAbort == 'Y' don't write file or send email. The counters are on the shared map;
                a bare name does not see it, and the map's get is property access, not a method. -->
            <if condition="attachmentInfo != null &amp;&amp; (screenScheduled.noResultsAbort != 'Y' || !ec.context.sharedMap._formListRendered || ec.context.sharedMap._formListResultCount)"><then>
                <!-- send email -->
                <if condition="emailTemplate != null">
                    <set field="toAddressSet" from="new Set()"/>
                    <if condition="userAccount != null">
                        <if condition="userAccount?.emailAddress"><then>
                            <if condition="userAccount.disabled != 'Y'"><then>
                                <script>toAddressSet.add(userAccount.emailAddress)</script>
                            </then><else>
                                <log level="warn" message="User ${userAccount.username} [${userAccount.userId}] is disabled, not sending email for ScreenScheduled ${screenScheduledId}"/>
                            </else></if>
                        </then><else>
                            <log level="warn" message="User ${userAccount.username} [${userAccount.userId}] has no emailAddress, tried to use in ScreenScheduled ${screenScheduledId}"/>
                        </else></if>
                    </if>
                    <!-- A screen schedule goes to a user group only through a registered adapter (an Enumeration of type
                        ReportLegacyAdapter whose enumCode is the screen path; BOSS design-insights §7.3, INS-11): the screen
                        renders as the schedule's user, and whether that result is each member's to see is the adapter's
                        review. Without one the group is not sent to and the schedule stays personal. With one, each member
                        the saved find is shared with (or every member when no find is named) gets a message of their own,
                        never an address line shared with another recipient. -->
                    <set field="groupAddressSet" from="new Set()"/>
                    <if condition="screenScheduled.userGroupId">
                        <entity-find-count entity-name="moqui.basic.Enumeration" count-field="legacyAdapterCount">
                            <econdition field-name="enumTypeId" value="ReportLegacyAdapter"/>
                            <econdition field-name="enumCode" from="screenPath"/>
                        </entity-find-count>
                        <if condition="!legacyAdapterCount"><then>
                            <log level="error" message="ScreenScheduled ${screenScheduledId} names user group ${screenScheduled.userGroupId} but ${screenPath} is not a registered ReportLegacyAdapter: not sending to the group, the user's own delivery continues"/>
                        </then><else>
                            <entity-find entity-name="moqui.security.UserGroupMemberUser" list="groupUserList">
                                <date-filter/>
                                <econdition field-name="userGroupId" from="screenScheduled.userGroupId"/>
                                <select-field field-name="userId,username,emailAddress,disabled"/>
                            </entity-find>
                            <iterate list="groupUserList" entry="groupUser">
                                <if condition="!groupUser.emailAddress || groupUser.disabled == 'Y'">
                                    <log level="warn" message="User ${groupUser.username} [${groupUser.userId}] in group ${screenScheduled.userGroupId} is disabled or has no emailAddress, not sending email for ScreenScheduled ${screenScheduledId}"/>
                                    <continue/>
                                </if>
                                <if condition="formListFindId &amp;&amp; groupUser.userId != screenScheduled.userId">
                                    <!-- the saved find must be the member's to read: shared with them or with a group of theirs -->
                                    <entity-find-count entity-name="moqui.screen.form.FormListFindUser" count-field="findUserCount">
                                        <econdition field-name="formListFindId"/>
                                        <econdition field-name="userId" from="groupUser.userId"/>
                                    </entity-find-count>
                                    <set field="findShared" from="findUserCount &gt; 0"/>
                                    <if condition="!findShared">
                                        <entity-find entity-name="moqui.screen.form.FormListFindUserGroup" list="findGroupList">
                                            <econdition field-name="formListFindId"/></entity-find>
                                        <set field="memberGroupIds" from="ec.user.getUserGroupIdSet(groupUser.userId) || new Set()"/>
                                        <set field="findShared" from="Array.from(findGroupList).some(row =&gt; row.userGroupId == 'ALL_USERS' || memberGroupIds.has(row.userGroupId))"/>
                                    </if>
                                    <if condition="!findShared">
                                        <log level="warn" message="Saved find ${formListFindId} is not shared with user ${groupUser.username} [${groupUser.userId}], not sending email for ScreenScheduled ${screenScheduledId}"/>
                                        <continue/>
                                    </if>
                                </if>
                                <script>if (!toAddressSet.has(groupUser.emailAddress)) groupAddressSet.add(groupUser.emailAddress)</script>
                            </iterate>
                        </else></if>
                    </if>
                    <iterate list="[...groupAddressSet]" entry="groupAddress">
                        <service-call name="org.moqui.mail.EmailServices.send#EmailTemplate" ignore-error="true" transaction="force-new"
                                in-map="{emailTemplateId: emailTemplate.emailTemplateId, bodyParameters: bodyParameters,
                                    attachments: [attachmentInfo], toAddresses: groupAddress, createEmailMessage: false}"/>
                    </iterate>
                    <if condition="toAddressSet.size"><then>
                        <set field="toAddresses" from="[...toAddressSet].join(',')"/>
                        <service-call name="org.moqui.mail.EmailServices.send#EmailTemplate" ignore-error="true" transaction="force-new"
                                in-map="{emailTemplateId: emailTemplate.emailTemplateId, bodyParameters: bodyParameters,
                                    attachments: [attachmentInfo], toAddresses: toAddresses, createEmailMessage: false}"/>
                    </then><else>
                        <if condition="!groupAddressSet.size">
                            <log level="error" message="No email addresses found trying to send email for ScreenScheduled ${screenScheduledId} user ${screenScheduled.userId} group ${screenScheduled.userGroupId}"/>
                        </if>
                    </else></if>
                </if>

                <!-- saveToLocation -->
                <if condition="saveToLocation">
                    <script>
                        const saveToLocationExp = ec.resource.expand(saveToLocation, null)
                        try {
                            const saveToRr = ec.resource.getLocationReference(saveToLocationExp)
                            if (attachmentInfo.contentBytes) saveToRr.putBytes(attachmentInfo.contentBytes)
                            else if (attachmentInfo.contentText) saveToRr.putText(attachmentInfo.contentText)
                        } catch (t) {
                            ec.logger.log(200, `Error saving to saveToLocation ${saveToLocationExp} for ScreenScheduled ${screenScheduledId}`, t)
                        }
                    </script>
                </if>
            </then><else>
                <log level="warn" message="Not saving or sending email for ScheduledScreen ${screenScheduledId}: no attachment, or noResultsAbort ${screenScheduled.noResultsAbort} _formListRendered ${ec.context.sharedMap._formListRendered} _formListResultCount ${ec.context.sharedMap._formListResultCount}"/>
            </else></if>

            <!-- save lastRunTime -->
            <service-call name="update#moqui.screen.ScreenScheduledLock"
                    in-map="{screenScheduledId: screenScheduledId, lastRunTime: ec.user.nowTimestamp}"/>
        </actions>
    </service>

    <!-- ========== DB Form Services ========== -->

    <service verb="get" noun="FormResponse">
        <description>A response with its answers; for a DbForm, the form's fields as they were at the response date
            (dbFormFieldList), so a response to a dated form reads as it was submitted.</description>
        <in-parameters><parameter name="formResponseId" required="true"/></in-parameters>
        <out-parameters>
            <auto-parameters entity-name="moqui.screen.form.FormResponse"/>
            <parameter name="responseMap" type="Map"/>
            <parameter name="dbForm" type="Map"/>
            <parameter name="dbFormFieldList" type="List"/>
            <parameter name="dbFormFieldPages" type="Integer"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.screen.form.FormResponse" value-field="formResponse"/>
            <if condition="formResponse.formId">
                <entity-find-one entity-name="moqui.screen.form.DbForm" value-field="dbForm">
                    <field-map field-name="formId" from="formResponse.formId"/></entity-find-one>
                <entity-find entity-name="moqui.screen.form.DbFormField" list="dbFormFieldList">
                    <econdition field-name="formId" from="formResponse.formId"/>
                    <order-by field-name="layoutSequenceNum"/>
                </entity-find>
                <!-- the form as it was when the response was made: its fields in effect at the response date -->
                <script>
                    const asOfNames = new Set(ec.screen.getFormNode('DbForm#' + formResponse.formId, formResponse.responseDate ?? null)
                        .children('field').map((field) => field.attribute('name')))
                    dbFormFieldList = Array.from(dbFormFieldList).filter((field) => asOfNames.has(field.fieldName))
                </script>
                <set field="dbFormFieldPages" from="1"/>
                <iterate list="dbFormFieldList" entry="dbFormField">
                    <set field="printPageNumber" from="dbFormField.printPageNumber || 1"/>
                    <if condition="printPageNumber &gt; dbFormFieldPages"><set field="dbFormFieldPages" from="printPageNumber"/></if>
                </iterate>
            </if>
            <script>for (const [key, value] of Object.entries(formResponse)) context[key] = value</script>
            <entity-find entity-name="moqui.screen.form.FormResponseAnswer" list="answerList">
                <econdition field-name="formResponseId"/></entity-find>
            <set field="responseMap" from="{}"/>
            <iterate list="answerList" entry="answer">
                <script>responseMap[answer.fieldName] = answer.valueText</script>
            </iterate>
        </actions>
    </service>
    <service verb="create" noun="FormResponse">
        <in-parameters>
            <parameter name="formLocation" required="true" default-value="DbForm#${formId}"/>
            <parameter name="formId"/>
            <parameter name="userId" default="ec.user.userId"/>
            <parameter name="responseDate" type="Timestamp" default="ec.user.nowTimestamp"/>
            <parameter name="responseMap" type="Map"/>
        </in-parameters>
        <out-parameters><parameter name="formResponseId"/></out-parameters>
        <actions>
            <service-call name="create#moqui.screen.form.FormResponse" in-map="context" out-map="context"/>

            <if condition="responseMap">
                <set field="formNode" from="ec.screen.getFormNode(formLocation, responseDate)"/>
                <iterate list="formNode.children('field')" entry="fieldNode">
                    <set field="fieldName" from="fieldNode.attribute('name')"/>
                    <if condition="Object.prototype.hasOwnProperty.call(responseMap, fieldName)">
                        <service-call name="create#moqui.screen.form.FormResponseAnswer"
                                in-map="{formResponseId: formResponseId, formId: formId, fieldName: fieldName,
                                    valueText: responseMap[fieldName] == null ? null : String(responseMap[fieldName])}"/>
                    </if>
                </iterate>
            </if>
        </actions>
    </service>
    <service verb="update" noun="FormResponse">
        <description>Updates existing FormResponseAnswer or adds new ones as needed. Note that this doesn't work with
            fields that have multiple responses (it will update the first response).</description>
        <in-parameters>
            <parameter name="formResponseId" required="true"/>
            <!-- QUESTION: update userId and responseDate? -->
            <parameter name="responseMap" type="Map" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="formResponseId"/></out-parameters>
        <actions>
            <entity-find-one entity-name="moqui.screen.form.FormResponse" value-field="formResponse"/>
            <set field="formNode" from="ec.screen.getFormNode(formResponse.formLocation, formResponse.responseDate)"/>
            <iterate list="formNode.children('field')" entry="fieldNode">
                <set field="fieldName" from="fieldNode.attribute('name')"/>
                <if condition="Object.prototype.hasOwnProperty.call(responseMap, fieldName)">
                    <entity-find-one entity-name="moqui.screen.form.FormResponseAnswer" value-field="answer">
                        <field-map field-name="formResponseId"/><field-map field-name="fieldName"/></entity-find-one>
                    <if condition="answer">
                        <service-call name="update#moqui.screen.form.FormResponseAnswer"
                                in-map="{formResponseAnswerId: answer.formResponseAnswerId,
                                    valueText: responseMap[fieldName] == null ? null : String(responseMap[fieldName])}"/>
                        <else>
                            <service-call name="create#moqui.screen.form.FormResponseAnswer"
                                    in-map="{formResponseId: formResponseId, fieldName: fieldName,
                                        valueText: responseMap[fieldName] == null ? null : String(responseMap[fieldName])}"/>
                        </else>
                    </if>
                </if>
            </iterate>
        </actions>
    </service>
    <service verb="delete" noun="FormResponse">
        <in-parameters><parameter name="formResponseId" required="true"/></in-parameters>
        <actions>
            <entity-find-one entity-name="moqui.screen.form.FormResponse" value-field="formResponse"/>
            <if condition="formResponse == null"><return message="Form Response ${formResponseId} not found"/></if>
            <entity-delete-by-condition entity-name="moqui.screen.form.FormResponseAnswer">
                <econdition field-name="formResponseId"/></entity-delete-by-condition>
            <entity-delete value-field="formResponse"/>
        </actions>
    </service>
    <service verb="update" noun="DbFormField">
        <description>On a form that is not dated, deletes the field and creates it again named from its title, with its
            options. On a dated form (DbForm.isDated) the field is updated in place, keeping its name and answers (the
            key fields are audit-logged); a published field keeps its type, which a successor field changes
            (create#DbFormFieldSuccessor), and its dates and replacesFieldName change only through publish#DbForm,
            end#DbFormField and create#DbFormFieldSuccessor.</description>
        <in-parameters>
            <auto-parameters entity-name="moqui.screen.form.DbFormField" include="nonpk"/>
            <auto-parameters entity-name="moqui.screen.form.DbFormField" include="pk" required="true"/>
        </in-parameters>
        <actions>
            <set field="dated" from="ec.resource.script('component://framework/service/org/moqui/impl/DbForms.js').execute('checkFieldChange',
                    {formId, fieldName, fieldTypeEnumId, fromDate, thruDate, replacesFieldName}).dated"/>
            <if condition="ec.message.hasError()"><return/></if>
            <if condition="dated">
                <!-- the dates and the field replaced change only through publish, end and successor -->
                <service-call name="update#moqui.screen.form.DbFormField" in-map="Object.fromEntries(Object.entries(Object.assign({}, context))
                        .filter((entry) => !['fromDate', 'thruDate', 'replacesFieldName'].includes(entry[0])))"/>
                <return/>
            </if>
            <entity-find entity-name="moqui.screen.form.DbFormFieldOption" list="dbFormFieldOptionList">
                <econdition field-name="formId" from="formId"/>
                <econdition field-name="fieldName" from="fieldName"/>
            </entity-find>
            <entity-delete-by-condition entity-name="moqui.screen.form.DbFormFieldOption">
                <econdition field-name="formId" from="formId"/>
                <econdition field-name="fieldName" from="fieldName"/>
                <econdition field-name="sequenceNum" from="dbFormFieldOptionList.map((it) => it.sequenceNum)" operator="in"/>
            </entity-delete-by-condition>
            <service-call name="delete#moqui.screen.form.DbFormField" in-map="context"/>
            <set field="fieldName" from="StringUtilities.prettyToCamelCase(title, false)"/>
            <service-call name="create#moqui.screen.form.DbFormField" in-map="context"/>
            <iterate list="dbFormFieldOptionList" entry="dbFormFieldOption">
                <set field="dbFormFieldOption.formId" from="formId"/>
                <set field="dbFormFieldOption.fieldName" from="fieldName"/>
                <service-call name="create#moqui.screen.form.DbFormFieldOption" in-map="dbFormFieldOption"/>
            </iterate>
        </actions>
    </service>
    <service verb="delete" noun="DbFormField">
        <description>Deletes the field with its options and dependencies. On a dated form a field with answers is
            refused: end it (end#DbFormField).</description>
        <in-parameters>
            <auto-parameters entity-name="moqui.screen.form.DbFormField" include="nonpk"/>
            <auto-parameters entity-name="moqui.screen.form.DbFormField" include="pk" required="true"/>
        </in-parameters>
        <actions>
            <script>ec.resource.script('component://framework/service/org/moqui/impl/DbForms.js').execute('checkFieldChange', {formId, fieldName, deleting: true})</script>
            <if condition="ec.message.hasError()"><return/></if>
            <entity-delete-by-condition entity-name="moqui.screen.form.DbFormFieldDependency">
                <econdition field-name="formId" from="formId"/>
                <econditions combine="or">
                    <econdition field-name="sourceFieldName" from="fieldName"/>
                    <econdition field-name="targetFieldName" from="fieldName"/>
                </econditions>
            </entity-delete-by-condition>
            <entity-find entity-name="moqui.screen.form.DbFormFieldOption" list="dbFormFieldOptionList">
                <econdition field-name="formId" from="formId"/>
                <econdition field-name="fieldName" from="fieldName"/>
            </entity-find>
            <entity-delete-by-condition entity-name="moqui.screen.form.DbFormFieldOption">
                <econdition field-name="formId" from="formId"/>
                <econdition field-name="fieldName" from="fieldName"/>
                <econdition field-name="sequenceNum" from="dbFormFieldOptionList.map((it) => it.sequenceNum)" operator="in"/>
            </entity-delete-by-condition>
            <service-call name="delete#moqui.screen.form.DbFormField" in-map="context"/>
        </actions>
    </service>
    <!-- Dated DbForms and their dependencies (docs/ui/Db-Forms.md; the bodies are in DbForms.js) -->
    <service verb="set" noun="DbFormDated">
        <description>Makes a DbForm dated (isDated): its fields, options and dependencies with no fromDate start at
            fromDate. From then on a row with no fromDate is a draft.</description>
        <in-parameters>
            <parameter name="formId" required="true"/>
            <parameter name="fromDate" type="Timestamp"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/DbForms.js').execute('setDated', context))</script></actions>
    </service>
    <service verb="publish" noun="DbForm">
        <description>Starts the drafts of a dated DbForm at fromDate (now by default; an earlier date is refused): each draft field (ending the field
            it replaces and that field's dependencies), option (ending the option of the same key) and dependency;
            fieldNames limits it to those fields. Refused, with nothing changed, when the dependencies would make a
            cycle or give a field two rules of one effect.</description>
        <in-parameters>
            <parameter name="formId" required="true"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="fieldNames" type="List"/>
        </in-parameters>
        <out-parameters><parameter name="publishedFieldNames" type="List"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/DbForms.js').execute('publish', context))</script></actions>
    </service>
    <service verb="end" noun="DbFormField">
        <description>Ends a field at thruDate (now by default), with the dependencies that name it. Its answers stay,
            and a response made before then reads it (get#FormResponse).</description>
        <in-parameters>
            <parameter name="formId" required="true"/>
            <parameter name="fieldName" required="true"/>
            <parameter name="thruDate" type="Timestamp"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/DbForms.js').execute('endField', context))</script></actions>
    </service>
    <service verb="end" noun="DbFormFieldOption">
        <in-parameters>
            <parameter name="formId" required="true"/>
            <parameter name="fieldName" required="true"/>
            <parameter name="sequenceNum" type="Integer" required="true"/>
            <parameter name="thruDate" type="Timestamp"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/DbForms.js').execute('endOption', context))</script></actions>
    </service>
    <service verb="delete" noun="DbFormFieldOption">
        <description>Deletes an option; on a dated form an option with answers is refused: end it.</description>
        <in-parameters>
            <parameter name="formId" required="true"/>
            <parameter name="fieldName" required="true"/>
            <parameter name="sequenceNum" type="Integer" required="true"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/DbForms.js').execute('deleteOption', context))</script></actions>
    </service>
    <service verb="create" noun="DbFormFieldSuccessor">
        <description>A field that succeeds fieldName on a dated form, for a new type or meaning: its values default to
            the old field's, and its options, attributes and dependencies are copied. With no fromDate it is a draft
            that replaces the old field when published; with fromDate (now or later) it starts then and the old field ends then. The
            old field's answers keep its name.</description>
        <in-parameters>
            <parameter name="formId" required="true"/>
            <parameter name="fieldName" required="true"/>
            <parameter name="newFieldName"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="copyOptions" type="Boolean" default-value="true"/>
            <parameter name="title"/><parameter name="tooltip"/><parameter name="fieldTypeEnumId"/>
            <parameter name="isRequired"/><parameter name="layoutSequenceNum" type="Integer"/>
        </in-parameters>
        <out-parameters><parameter name="newFieldName"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/DbForms.js').execute('createSuccessor', context))</script></actions>
    </service>
    <service verb="store" noun="DbFormFieldDependency">
        <description>Creates a dependency, or with dependencySeqId updates one in place (audit-logged): the target field
            shows (effect show) or is required (effect require) while the source field meets the operator (equals,
            not-equals, empty, not-empty) and value (one or a comma-separated list, never an expression). Refused when
            the form's dependencies would make a cycle or give a field two rules of one effect. On a dated form a new
            dependency with no fromDate is a draft, a fromDate before now is refused, and a published dependency is
            not edited: it ends now and the returned dependencySeqId is its replacement, from now.</description>
        <in-parameters>
            <parameter name="formId" required="true"/>
            <parameter name="dependencySeqId"/>
            <parameter name="sourceFieldName" required="true"/>
            <parameter name="operator" default-value="equals"/>
            <parameter name="value"/>
            <parameter name="targetFieldName" required="true"/>
            <parameter name="effect" required="true"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="thruDate" type="Timestamp"/>
        </in-parameters>
        <out-parameters><parameter name="dependencySeqId"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/DbForms.js').execute('storeDependency', context))</script></actions>
    </service>
    <service verb="end" noun="DbFormFieldDependency">
        <in-parameters>
            <parameter name="formId" required="true"/>
            <parameter name="dependencySeqId" required="true"/>
            <parameter name="thruDate" type="Timestamp"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/DbForms.js').execute('endDependency', context))</script></actions>
    </service>
    <service verb="evaluate" noun="DbFormDependencies">
        <description>Checks submitted values against a DbForm as of asOfDate (now by default; its drafts too with
            includeDrafts): the fields shown and hidden by their dependencies, the fields required (isRequired or a
            require dependency, while shown) and those of them with no value. A hidden field's value counts as empty
            for the fields that depend on it, as in the browser. For a caller's server-side check of a submit.</description>
        <in-parameters>
            <parameter name="formId" required="true"/>
            <parameter name="values" type="Map"/>
            <parameter name="asOfDate" type="Timestamp"/>
            <parameter name="includeDrafts" type="Boolean" default-value="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="visibleFieldNames" type="List"/>
            <parameter name="hiddenFieldNames" type="List"/>
            <parameter name="requiredFieldNames" type="List"/>
            <parameter name="missingFieldNames" type="List"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/impl/DbForms.js').execute('evaluate', context))</script></actions>
    </service>
    <service verb="get" noun="FormResponseStats">
        <in-parameters>
            <parameter name="formId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="textDbFormFieldResponseCountList" type="List"/>
            <parameter name="enumDbFormFieldResponseCountList" type="List"/>
            <parameter name="formResponseCount" type="List"/>
        </out-parameters>
        <actions>
            <script>enumFieldTypeEnumIdList = ['DBFFT_check', 'DBFFT_drop-down', 'DBFFT_radio'];</script>
            <entity-find entity-name="moqui.screen.form.DbFormField" list="textDbFormFieldList">
                <econdition field-name="formId" from="formId"/>
                <econdition field-name="fieldTypeEnumId" from="enumFieldTypeEnumIdList" operator="not-in" />
                <order-by field-name="layoutSequenceNum"/>
            </entity-find>
            <entity-find entity-name="moqui.screen.form.DbFormField" list="enumDbFormFieldList">
                <econdition field-name="formId" from="formId"/>
                <econdition field-name="fieldTypeEnumId" from="enumFieldTypeEnumIdList" operator="in"/>
                <order-by field-name="layoutSequenceNum"/>
            </entity-find>
            <set field="textDbFormFieldResponseCountList" from="[]"/>
            <iterate list="textDbFormFieldList" entry="textDbFormField">
                <set field="textDbFormFieldResponseObj" from="{}"/>
                <entity-find-count entity-name="moqui.screen.form.FormResponseAnsAndDbFormField" count-field="textDbFormFieldResponseCount">
                    <econdition field-name="formId" from="formId"/>
                    <econdition field-name="fieldName" from="textDbFormField.fieldName"/>
                    <econditions combine="and">
                        <econdition field-name="valueText" value="" operator="not-equals"/>
                        <econdition field-name="valueText" operator="is-not-null"/>
                    </econditions>
                </entity-find-count>
                <script>textDbFormFieldResponseObj.title = textDbFormField.title
                    textDbFormFieldResponseObj.count = textDbFormFieldResponseCount
                    textDbFormFieldResponseCountList.push(textDbFormFieldResponseObj)</script>
            </iterate>
            <set field="enumDbFormFieldResponseCountList" from="[]"/>
            <iterate list="enumDbFormFieldList" entry="enumDbFormField">
                <set field="enumDbFormFieldOptionResponseObj" from="{}"/>
                <set field="enumDbFormFieldOptionResponseList" from="[]"/>
                <entity-find entity-name="moqui.screen.form.DbFormFieldOption" list="dbFormFieldOptionList">
                    <econdition field-name="formId" from="formId"/>
                    <econdition field-name="fieldName" from="enumDbFormField.fieldName"/>
                </entity-find>
                <iterate list="dbFormFieldOptionList" entry="dbFormFieldOption">
                    <set field="dbFormFieldOptionResponseObj" from="{}"/>
                    <entity-find-count entity-name="moqui.screen.form.FormResponseAnsAndDbFormField" count-field="enumDbFormFieldOptionResponseCount">
                        <econdition field-name="formId" from="formId"/>
                        <econdition field-name="fieldName" from="enumDbFormField.fieldName"/>
                        <econdition field-name="valueText" from="dbFormFieldOption.keyValue" operator="equals"/>
                    </entity-find-count>
                    <script>dbFormFieldOptionResponseObj.text = dbFormFieldOption.text
                        dbFormFieldOptionResponseObj.count = enumDbFormFieldOptionResponseCount
                        enumDbFormFieldOptionResponseList.push(dbFormFieldOptionResponseObj)</script>
                </iterate>
                <script>enumDbFormFieldOptionResponseObj.title = enumDbFormField.title
                    enumDbFormFieldOptionResponseObj.fieldOptionList = enumDbFormFieldOptionResponseList
                    enumDbFormFieldResponseCountList.push(enumDbFormFieldOptionResponseObj)</script>
            </iterate>
            <entity-find-count entity-name="moqui.screen.form.FormResponse" count-field="formResponseCount">
                <econdition field-name="formId" from="formId"/>
            </entity-find-count>
        </actions>
    </service>
</services>
