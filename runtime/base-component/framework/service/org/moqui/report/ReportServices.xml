        <in-parameters><parameter name="definitionId"/></in-parameters><out-parameters><parameter name="evaluated" type="Integer"/><parameter name="failed" type="Integer"/><parameter name="notices" type="List"/></out-parameters>
    </service>
    <service verb="create" noun="Annotation" type="rust" location="moqui_core::report::create_annotation">
        <in-parameters><parameter name="time"/><parameter name="timeEnd"/><parameter name="source"/><parameter name="text" required="true"/><parameter name="tags" type="List"/><parameter name="scope"/><parameter name="serviceName"/><parameter name="instanceId"/><parameter name="dashboardId"/><parameter name="panelId"/><parameter name="version"/><parameter name="revision"/></in-parameters>
        <out-parameters><parameter name="annotationId"/><parameter name="annotation" type="Map"/></out-parameters>
    </service>
    <service verb="list" noun="Datasets" type="rust" location="moqui_core::report::list_datasets">
        <out-parameters><parameter name="datasets" type="List"/></out-parameters>
    </service>
    <service verb="get" noun="Dataset" type="rust" location="moqui_core::report::get_dataset">
        <in-parameters><parameter name="datasetId" required="true"/></in-parameters><out-parameters><parameter name="dataset" type="Map"/></out-parameters>
    </service>
    <service verb="render" noun="Dashboard" type="rust" location="moqui_core::report::render_dashboard">
        <in-parameters><parameter name="definitionId" required="true"/><parameter name="variables" type="Map"/><parameter name="filters" type="List"/><parameter name="from"/><parameter name="thru"/><parameter name="inspect" type="Boolean"/><parameter name="panelId"/></in-parameters><out-parameters><parameter name="dashboard" type="Map"/></out-parameters>
    </service>
    <service verb="get" noun="Definition" type="rust" location="moqui_core::report::get_definition">
        <in-parameters><parameter name="definitionId" required="true"/></in-parameters><out-parameters><parameter name="definition" type="Map"/></out-parameters>
    </service>
    <service verb="list" noun="Definitions" type="rust" location="moqui_core::report::list_definitions">
        <in-parameters><parameter name="definitionType"/></in-parameters><out-parameters><parameter name="definitions" type="List"/></out-parameters>
    </service>
    <service verb="save" noun="Definition" type="rust" location="moqui_core::report::save_definition">
        <in-parameters><parameter name="definition" type="Map" required="true"/><parameter name="note"/></in-parameters><out-parameters><parameter name="definition" type="Map"/></out-parameters>
    </service>
    <service verb="copy" noun="Definition" type="rust" location="moqui_core::report::copy_definition">
        <in-parameters><parameter name="definitionId" required="true"/><parameter name="newDefinitionId" required="true"/><parameter name="title"/></in-parameters><out-parameters><parameter name="definition" type="Map"/></out-parameters>
    </service>
    <service verb="versions" noun="Definition" type="rust" location="moqui_core::report::versions_definition">
        <in-parameters><parameter name="definitionId" required="true"/></in-parameters><out-parameters><parameter name="versions" type="List"/></out-parameters>
    </service>
    <service verb="find" noun="DefinitionUses" type="rust" location="moqui_core::report::find_definition_uses">
        <in-parameters><parameter name="definitionId" required="true"/></in-parameters><out-parameters><parameter name="usedIn" type="List"/></out-parameters>
    </service>
    <service verb="get" noun="DefinitionDiff" type="rust" location="moqui_core::report::get_definition_diff">
        <in-parameters><parameter name="definitionId" required="true"/><parameter name="fromVersion" type="Long"/><parameter name="toVersion" type="Long"/></in-parameters><out-parameters><parameter name="fromVersion" type="Long"/><parameter name="toVersion" type="Long"/><parameter name="changes" type="List"/><parameter name="from" type="Map"/><parameter name="to" type="Map"/><parameter name="truncated" type="Boolean"/></out-parameters>
    </service>
    <service verb="restore" noun="Definition" type="rust" location="moqui_core::report::restore_definition">
        <in-parameters><parameter name="definitionId" required="true"/><parameter name="version" type="Long" required="true"/><parameter name="note"/></in-parameters><out-parameters><parameter name="definition" type="Map"/></out-parameters>
    </service>
    <service verb="delete" noun="Definition" type="rust" location="moqui_core::report::delete_definition">
        <description>Delete a saved definition the viewer owns, with its versions and an alert rule's state. Shipped and read-only
            definitions cannot be deleted, nor one that other definitions still reference. Git syncs remove its file.</description>
        <in-parameters><parameter name="definitionId" required="true"/></in-parameters><out-parameters><parameter name="deleted" type="Map"/></out-parameters>
    </service>
    <service verb="export" noun="Definitions" type="rust" location="moqui_core::report::export_definitions">
        <in-parameters><parameter name="definitionId" required="true"/></in-parameters><out-parameters><parameter name="bundle" type="Map"/></out-parameters>
    </service>
    <service verb="import" noun="Definitions" type="rust" location="moqui_core::report::import_definitions">
        <in-parameters><parameter name="bundle" type="Map" required="true"/><parameter name="idPrefix"/></in-parameters><out-parameters><parameter name="definitions" type="List"/></out-parameters>
    </service>
    <service verb="audit" noun="Export" type="rust" allow-remote="false" location="moqui_core::report::audit_export">
        <description>Records an export of report data done outside the report services, such as the Explore document download.</description>
        <in-parameters><parameter name="kind"/><parameter name="format"/><parameter name="definitionId"/><parameter name="rowCount" type="Long"/></in-parameters>
    </service>
    <!-- Business datasets (crates/moqui-report/src/business.rs; BOSS impl-insights P3, INS-03): admission, scope policy, fields,
        conditions and the one-feed index, each guarded by the dataset's own artifact org.moqui.report.dataset.<id> (update) -->
    <service verb="find" noun="BusinessDatasets" type="rust" location="moqui_core::report::find_business_datasets">
        <description>The business datasets (signal business) the viewer may read, each with its source, scope policy, admission
            checks and state (admitted, review, retired, unavailable); a steward (org.moqui.report.dataset update) also sees
            those of theirs waiting for review.</description>
        <in-parameters><parameter name="datasetId"/><parameter name="status"/></in-parameters>
        <out-parameters><parameter name="datasets" type="List"/></out-parameters>
    </service>
    <service verb="validate" noun="BusinessDataset" type="rust" location="moqui_core::report::validate_business_dataset">
        <description>The admission checks of one business dataset for its steward: its document in a registered DataFeed, its
            index built (and not older than its last field change), its rowFilterService a registered scope policy.</description>
        <in-parameters><parameter name="datasetId" required="true"/></in-parameters>
        <out-parameters><parameter name="checks" type="List"/><parameter name="admissible" type="Boolean"/><parameter name="status"/><parameter name="dataset" type="Map"/></out-parameters>
    </service>
    <service verb="create" noun="BusinessDataset" type="rust" location="moqui_core::report::create_business_dataset">
        <description>A steward's business dataset over a DataDocument a registered DataFeed indexes, with a registered scope policy
            and its parameters, saved as a dataset definition they own and waiting for review. Refuses a document of no feed, a
            telemetry index, an unregistered policy and a group the steward is not in.</description>
        <in-parameters>
            <parameter name="datasetId" required="true"/><parameter name="title"/><parameter name="dataDocumentId" required="true"/>
            <parameter name="timeField"/><parameter name="scopePolicyId" required="true"/><parameter name="rowFilterParameters" type="Map"/>
            <parameter name="userGroupId"/>
        </in-parameters>
        <out-parameters><parameter name="dataset" type="Map"/></out-parameters>
    </service>
    <service verb="store" noun="BusinessDataset" type="rust" location="moqui_core::report::store_business_dataset">
        <description>A steward's changes to a business dataset: title, time field, scope policy and parameters (a saved dataset;
            a shipped one's definition is its component's), its steward, and admit or retire. A time field or scope change returns
            it to review; admission is refused while a check fails; a stale expectedVersion is refused.</description>
        <in-parameters>
            <parameter name="datasetId" required="true"/><parameter name="title"/><parameter name="timeField"/>
            <parameter name="scopePolicyId"/><parameter name="rowFilterParameters" type="Map"/><parameter name="stewardUserId"/>
            <parameter name="admit" type="Boolean"/><parameter name="retire" type="Boolean"/><parameter name="expectedVersion" type="Long"/>
        </in-parameters>
        <out-parameters><parameter name="dataset" type="Map"/></out-parameters>
    </service>
    <service verb="index" noun="BusinessDataset" type="rust" transaction-timeout="3600" location="moqui_core::report::index_business_dataset">
        <description>Rebuild one business dataset's index: org.moqui.search.SearchServices.index#DataFeedDocuments for its feed
            and its document only, for its steward (the dataset's update artifact), recording when and how many.</description>
        <in-parameters><parameter name="datasetId" required="true"/></in-parameters>
        <out-parameters><parameter name="documentsIndexed" type="Long"/><parameter name="dataFeedId"/><parameter name="dataDocumentId"/></out-parameters>
    </service>
    <service verb="store" noun="BusinessDatasetFields" type="rust" location="moqui_core::report::store_business_dataset_fields">
        <description>A steward adds, revises and removes a business dataset's document fields (fields: fieldSeqId, fieldPath,
            fieldNameAlias, functionName, sequenceNum, remove). A new path is plain (no expression or secret field); names stay
            unique; removing or renaming a field a definition over the dataset names is refused until it is revised, as is a
            stale expectedVersion. The index is stale until rebuilt.</description>
        <in-parameters><parameter name="datasetId" required="true"/><parameter name="fields" type="List"/><parameter name="expectedVersion" type="Long"/></in-parameters>
        <out-parameters><parameter name="dataset" type="Map"/></out-parameters>
    </service>
    <service verb="store" noun="BusinessDatasetConditions" type="rust" location="moqui_core::report::store_business_dataset_conditions">
        <description>A steward adds, revises and removes the conditions that narrow a business dataset's document (conditions:
            conditionSeqId, fieldNameAlias, operator, fieldValue, toFieldNameAlias, remove), each on a field of the document with
            an operator of the list; never a post-query expression, and never in place of the row filter.</description>
        <in-parameters><parameter name="datasetId" required="true"/><parameter name="conditions" type="List"/><parameter name="expectedVersion" type="Long"/></in-parameters>
        <out-parameters><parameter name="dataset" type="Map"/></out-parameters>
    </service>
    <service verb="get" noun="UserGroupRowFilter" allow-remote="false">
        <description>The framework's scope policy ReportUserGroups (ReportSetupData.xml), a business dataset's rowFilterService: the
            rows whose field named in rowFilterParameters (groupField, userGroupId by default) is one of the signed-in viewer's
            user groups; nothing for a viewer of none. A userId of another user is refused. A domain registers its own policies
            (an organization's, a confidential class's) the same way.</description>
        <in-parameters>
            <parameter name="userId"/><parameter name="datasetId"/><parameter name="rowFilterParameters" type="Map"/>
        </in-parameters>
        <out-parameters><parameter name="filter" type="Map"/></out-parameters>
        <actions>
            <if condition="userId &amp;&amp; userId != ec.user.userId">
                <return error="true" message="The user group row filter is computed for the signed-in user only"/></if>
            <set field="groupField" from="rowFilterParameters?.groupField || 'userGroupId'"/>
            <if condition="!/^[A-Za-z][A-Za-z0-9_.]{0,63}$/.test(groupField)">
                <return error="true" message="Group field ${groupField} is not a field name"/></if>
            <set field="groupIds" from="ec.user.userId ? Array.from(ec.user.getUserGroupIdSet() || []).filter(id => id !== 'ALL_USERS') : []"/>
            <set field="filter" from="groupIds.length ? {field: {name: groupField, op: 'in', values: groupIds}} : {bool: {none: [{match_all: {}}]}}"/>
        </actions>
    </service>
    <service verb="create" noun="Schedule" type="rust" location="moqui_core::report_schedule::create_schedule">
        <in-parameters><parameter name="definitionId" required="true"/><parameter name="cronExpression" required="true"/><parameter name="renderMode"/><parameter name="emailTemplateId"/><parameter name="userId"/><parameter name="userGroupId"/><parameter name="saveToLocation"/><parameter name="emailSubject"/></in-parameters><out-parameters><parameter name="screenScheduledId"/></out-parameters>
    </service>
    <service verb="list" noun="Schedules" type="rust" location="moqui_core::report_schedule::list_schedules"><out-parameters><parameter name="schedules" type="List"/></out-parameters></service>
    <service verb="pause" noun="Schedule" type="rust" location="moqui_core::report_schedule::pause_schedule"><in-parameters><parameter name="screenScheduledId" required="true"/><parameter name="paused" type="Boolean"/></in-parameters></service>
    <service verb="preview" noun="Report" type="rust" transaction="ignore" location="moqui_core::report_schedule::preview_report"><in-parameters><parameter name="definitionId" required="true"/><parameter name="renderMode"/><parameter name="panelId"/><parameter name="from"/><parameter name="thru"/><parameter name="variables" type="Map"/><parameter name="filters" type="List"/></in-parameters><out-parameters><parameter name="contentBase64"/><parameter name="contentType"/><parameter name="filename"/><parameter name="files" type="List"/><parameter name="empty" type="Boolean"/></out-parameters></service>
    <service verb="send" noun="Report" type="rust" transaction="ignore" location="moqui_core::report_schedule::send_report"><in-parameters><parameter name="screenScheduledId" required="true"/></in-parameters><out-parameters><parameter name="sent" type="Boolean"/><parameter name="skipped" type="Boolean"/><parameter name="reason"/></out-parameters></service>
    <service verb="run" noun="ScheduledReport" type="rust" authenticate="anonymous-all" allow-remote="false" transaction="ignore" location="moqui_core::report_schedule::run_scheduled"><in-parameters><parameter name="screenScheduledId" required="true"/></in-parameters><out-parameters><parameter name="sent" type="Boolean"/><parameter name="skipped" type="Boolean"/><parameter name="reason"/></out-parameters></service>
    <!-- Git sync of definition folders (report/git_sync.rs). Push and pull run as the sync's user in contexts of their own. -->
    <service verb="store" noun="DefinitionGitSync" type="rust" location="moqui_core::report::store_git_sync">
        <in-parameters><parameter name="syncId"/><parameter name="folder"/><parameter name="repositoryId"/><parameter name="path"/><parameter name="userId"/><parameter name="enabled"/></in-parameters>
        <out-parameters><parameter name="sync" type="Map"/></out-parameters>
    </service>
    <service verb="list" noun="DefinitionGitSyncs" type="rust" location="moqui_core::report::list_git_syncs"><out-parameters><parameter name="syncs" type="List"/></out-parameters></service>
    <service verb="push" noun="DefinitionGitSync" type="rust" transaction="ignore" location="moqui_core::report::push_git_sync">
        <in-parameters><parameter name="syncId" required="true"/></in-parameters>
        <out-parameters><parameter name="written" type="Integer"/><parameter name="unchanged" type="Integer"/></out-parameters>
    </service>
    <service verb="pull" noun="DefinitionGitSync" type="rust" transaction="ignore" location="moqui_core::report::pull_git_sync">
        <in-parameters><parameter name="syncId" required="true"/></in-parameters>
        <out-parameters><parameter name="saved" type="List"/><parameter name="unchanged" type="Integer"/><parameter name="failed" type="List"/><parameter name="missing" type="List"/></out-parameters>
    </service>
    <service verb="pull" noun="DefinitionGitSyncs" type="rust" allow-remote="false" transaction="ignore" location="moqui_core::report::pull_git_syncs">
        <description>For the gitECA of a push or fetch: pull every enabled sync of the repository when its default branch changed.</description>
        <in-parameters><parameter name="repositoryId" required="true"/><parameter name="isDefaultBranch" type="Boolean"/></in-parameters>
        <out-parameters><parameter name="pulled" type="Integer"/></out-parameters>
    </service>
</services>
