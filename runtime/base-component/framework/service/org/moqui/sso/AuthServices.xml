<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- The moqui-sso component's services, in the framework. The bodies are Rust (crates/moqui-core/src/service/sso.rs)
        on the host's OIDC and OAuth 2 client (huskarl). -->

    <service verb="login" noun="User" type="rust" location="moqui_core::service::sso::login_user" authenticate="anonymous-all">
        <description>
            Starts a login at the identity provider of the AuthFlow: keeps a same-origin returnTo, keeps the flow state
            (PKCE, state, nonce) in the session, and redirects the browser. A failure goes back to /Login.
        </description>
        <in-parameters>
            <parameter name="authFlowId" required="true"/>
            <parameter name="returnTo"/>
            <parameter name="reauth" type="Boolean"><description>A re-authentication (check#RecentAuth): an OpenID provider is asked to sign the user in again (prompt=login)</description></parameter>
        </in-parameters>
    </service>
    <service verb="handle" noun="Callback" type="rust" location="moqui_core::service::sso::handle_callback"
            authenticate="anonymous-all">
        <description>
            Handles the login callback: completes the flow the session started, syncs the UserAccount and its user
            groups (AuthFlowFieldMap, AuthFlowRoleMap, defaultUserGroupId), and logs the user in locally.
        </description>
    </service>
    <service verb="logout" noun="User" type="rust" location="moqui_core::service::sso::logout_user" authenticate="anonymous-all">
        <description>
            Performs a logout operation both locally and on the IdP server.
        </description>
        <in-parameters>
            <parameter name="returnTo"/>
        </in-parameters>
    </service>
</services>
