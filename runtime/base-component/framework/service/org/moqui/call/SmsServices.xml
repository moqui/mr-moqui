<!-- SMS and MMS (plans/Comms-Framework.md §5.6, C4-SMS; docs/interfaces/SMS.md): a number's texts through its messaging
    bridge (PhoneNumber.messagingBridgeId), in the number pair's external room. The logic is Sms.js beside this file; the
    provider's adapter is crates/moqui-channels (Telnyx), which calls receive#Sms from its webhook and check#SmsSend before
    each send. org.moqui.SmsServices.send#SmsMessage is the system's sender (a sign-in code). No Java counterpart.

    Access. open#PairRoom and find#MyTextNumbers are the current user's; the rest are internal (allow-remote false). -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="open" noun="PairRoom">
        <description>Text a number: the room of the current user's number fromNumber (one they are granted that has messaging;
            their only one when empty) and toNumber, found or made, with the user in it. Refusals carry reasonCode: notSignedIn,
            badNumber, emergency, numberNotGranted, noMessaging, internationalNotEnabled, premiumNotEnabled.</description>
        <in-parameters>
            <parameter name="toNumber" required="true"/>
            <parameter name="fromNumber"/>
        </in-parameters>
        <out-parameters>
            <parameter name="chatRoomId"/>
            <parameter name="ourNumber"><description>fromNumber in E.164</description></parameter>
            <parameter name="theirNumber"><description>toNumber in E.164</description></parameter>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/Sms.js').execute('openPairRoom', context))</script></actions>
    </service>

    <service verb="find" noun="MyTextNumbers">
        <description>The numbers the current user may text from: their caller-ID grants, and their ring groups' numbers, that
            have a messaging bridge (numberList: phoneNumber, description).</description>
        <out-parameters><parameter name="numberList" type="List"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/Sms.js').execute('myTextNumbers', context))</script></actions>
    </service>

    <service verb="ensure" noun="PairRoom" allow-remote="false">
        <description>Internal: the external room (CrtExternal) of our number and theirs, with its ChatRoomBridge on our number's
            messaging bridge (externalRoomId ours/theirs), found or made under the number's row lock, and the users our number
            reaches (its user or ring group, and its caller-ID grants) members of it; one who left stays out. reasonCode
            noMessaging when our number has no messaging bridge. Called in a transaction of its own before a text is taken in
            and before a call links to it.</description>
        <in-parameters>
            <parameter name="ourNumber" required="true"/>
            <parameter name="theirNumber" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="chatRoomId"/>
            <parameter name="chatBridgeId"/>
            <parameter name="chatRoomBridgeId"/>
            <parameter name="externalRoomId"/>
            <parameter name="created" type="Boolean"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/Sms.js').execute('ensurePairRoom', context))</script></actions>
    </service>

    <service verb="check" noun="SmsSend" allow-remote="false">
        <description>Internal (the adapter before each send, and send#SmsMessage): whether a text from fromNumber to toNumber
            may go now, from userId (empty: the system). allowed, else reasonCode and message: noMessaging, badNumber,
            emergency, numberNotGranted, internationalNotEnabled, premiumNotEnabled, optedOut, consentRequired (isPromotional
            with no sms-consent provider saying yes), dailyLimit. Out also the numbers in E.164 and the bridge.</description>
        <in-parameters>
            <parameter name="fromNumber" required="true"/>
            <parameter name="toNumber" required="true"/>
            <parameter name="userId"/>
            <parameter name="isPromotional" type="Boolean" default="false"/>
            <parameter name="reserve" type="Boolean" default="false"><description>Count the text for the day's limits when
                it is allowed, in the same step as the check under the lock of the day's deployment count (sends at once cannot pass a limit
                together); release#SmsSend takes it back when the text does not reach the provider</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="allowed" type="Boolean"/>
            <parameter name="counterDay"><description>With reserve, the day it was counted on (for release#SmsSend)</description></parameter>
            <parameter name="reasonCode"/>
            <parameter name="message"/>
            <parameter name="ourNumber"><description>fromNumber in E.164</description></parameter>
            <parameter name="theirNumber"><description>toNumber in E.164</description></parameter>
            <parameter name="chatBridgeId"/>
            <parameter name="destinationClass"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/Sms.js').execute('checkSend', context))</script></actions>
    </service>

    <service verb="note" noun="SmsSent" allow-remote="false">
        <description>Internal: a text went to the provider (taken, or not known): it counts for the day of userId (empty: the
            system's) and of the deployment (SmsSendCount).</description>
        <in-parameters><parameter name="userId"/></in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/Sms.js').execute('noteSent', context))</script></actions>
    </service>

    <service verb="release" noun="SmsSend" allow-remote="false">
        <description>Internal: a text check#SmsSend reserved on counterDay (today when empty) for userId (empty: the system)
            did not reach the provider (refused, or to be tried again): it no longer counts.</description>
        <in-parameters>
            <parameter name="userId"/>
            <parameter name="counterDay"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/Sms.js').execute('releaseSend', context))</script></actions>
    </service>

    <service verb="note" noun="SmsKeyword" allow-remote="false">
        <description>Internal: a person sent keyword STOP (opted out of our number), START (back in) or HELP (kept).</description>
        <in-parameters>
            <parameter name="ourNumber" required="true"/>
            <parameter name="theirNumber" required="true"/>
            <parameter name="keyword" required="true"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/Sms.js').execute('noteKeyword', context))</script></actions>
    </service>

    <service verb="receive" noun="Sms" allow-remote="false" transaction="ignore">
        <description>Internal (an SMS adapter's webhook, after it checked the provider's signature): a text from theirNumber to
            ourNumber on bridge chatBridgeId, the provider's webhook eventId (the ingest transaction: a repeated webhook does
            nothing again) and messageId, text and mediaList [{url, contentType, fileName, maxBytes}]. A STOP, START or HELP keeps
            the pair's opt-out; the pair room is found or made; the text goes through ChatBridgeServices.ingest#Event. outcome
            (accepted, duplicate, rejected, waiting, ignored for a number without messaging on this bridge, failed), reasonCode,
            chatRoomId, eventSeq.</description>
        <in-parameters>
            <parameter name="chatBridgeId" required="true"/>
            <parameter name="eventId" required="true"/>
            <parameter name="messageId" required="true"/>
            <parameter name="ourNumber" required="true"/>
            <parameter name="theirNumber" required="true"/>
            <parameter name="text" allow-html="any"/>
            <parameter name="mediaList" type="List"/>
            <parameter name="originMillis" type="Long"/>
        </in-parameters>
        <out-parameters>
            <parameter name="outcome"/>
            <parameter name="reasonCode"/>
            <parameter name="message"/>
            <parameter name="duplicate" type="Boolean"/>
            <parameter name="chatRoomId"/>
            <parameter name="eventSeq" type="Integer"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/Sms.js').execute('receive', context))</script></actions>
    </service>
</services>
