<!-- Business data transfer for delegated administration (mr-boss plan/design-admin.md §11, §14 "Import/export target",
    §17.2; impl-admin P15 and later): the dispatch of an import to its registered target and the runs of every target. The
    file grows by parts, each a section below with its bodies in a module of its own beside DataTransferLib.js, which they
    share: imports (DataTransferImports.js, with DataTransferBatch.js for a target that has no batch of its owner's); exports
    add theirs. A target is a moqui.server.TransferTarget its owner seeds: a request names a target by its id and never a
    service, an entity or a field the registration does not name. An owner's service is called as the caller
    (call#TargetService, whose ALL_USERS ALLOW is not inheritable), so the registration adds no right. ALL_USERS may call
    the services named in data/AdminConfigurationData.xml AdminTransferServices: each checks the caller itself
    (ADMIN_TRANSFER_VIEW for the catalog of targets and every target's runs; a target's own permissions and its owner's
    checks for its steps). A refusal a person can act on is answered (refused true, reasonCode, reason), never written. No
    dependency on Mantle or an app. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== The contracts an owner's services carry ========== -->

    <service verb="define" noun="ImportStep" type="interface">
        <description>The parameters of the five steps of an import (stage, configure, validate, apply, get), as
            mantle.product.ProductImportServices has them: an owner whose batch a target registers (targetMode steps)
            implements each step with them, and DataTransferServices' own steps carry them with a targetId. operationKey
            is the import; organizationPartyId its scope; mappingRevision the revision a mapping change and a validation
            name; inputFingerprint the revision of a validation, which an apply names; importRows a page of rows
            (itemSeqId, rowNumber, sourceValues, values, changes, warnings, result, errorMessage, resultRecordId).</description>
        <in-parameters>
            <parameter name="operationKey"/>
            <parameter name="kindId"/>
            <parameter name="organizationPartyId"/>
            <parameter name="sourceText"/>
            <parameter name="filename"/>
            <parameter name="importFile" type="FileItem"/>
            <parameter name="delimiter"/>
            <parameter name="forceNew" type="Boolean"/>
            <parameter name="updateMode"/>
            <parameter name="mappingRevision"/>
            <parameter name="mapping" type="Map"/>
            <parameter name="defaults" type="Map"/>
            <parameter name="valueMappings" type="Map"/>
            <parameter name="clearFields" type="List"/>
            <parameter name="numberFormat" type="Map"/>
            <parameter name="dateFormat"/>
            <parameter name="batchOptions" type="Map"/>
            <parameter name="inputFingerprint"/>
            <parameter name="selectedRowIds" type="List"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="errorsOnly" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="targetId"/>
            <parameter name="operationKey"/>
            <parameter name="kindId"/>
            <parameter name="kindDescription"/>
            <parameter name="organizationPartyId"/>
            <parameter name="state"/>
            <parameter name="lastError"/>
            <parameter name="filename"/>
            <parameter name="fileHash"/>
            <parameter name="mappingRevision"/>
            <parameter name="inputFingerprint"/>
            <parameter name="dateFormat"/>
            <parameter name="updateMode"/>
            <parameter name="mapping" type="Map"/>
            <parameter name="defaults" type="Map"/>
            <parameter name="valueMappings" type="Map"/>
            <parameter name="batchOptions" type="Map"/>
            <parameter name="numberFormat" type="Map"/>
            <parameter name="headers" type="List"/>
            <parameter name="clearFields" type="List"/>
            <parameter name="columns" type="List"/>
            <parameter name="importRows" type="List"/>
            <parameter name="rowCount" type="Integer"/>
            <parameter name="validCount" type="Integer"/>
            <parameter name="appliedCount" type="Integer"/>
            <parameter name="errorCount" type="Integer"/>
            <parameter name="failedCount" type="Integer"/>
            <parameter name="skippedCount" type="Integer"/>
            <parameter name="shownCount" type="Integer"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
            <parameter name="changedRows" type="Integer"/>
            <parameter name="attemptedCount" type="Integer"/>
            <parameter name="canEdit" type="Boolean"/>
            <parameter name="purged" type="Boolean"/>
            <parameter name="stagedDate" type="Long"/>
            <parameter name="appliedDate" type="Long"/>
            <parameter name="completedDate" type="Long"/>
            <parameter name="userId"/>
            <parameter name="userName"/>
            <parameter name="refused" type="Boolean"/>
            <parameter name="repeated" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
        </out-parameters>
    </service>
    <service verb="validate" noun="TargetRow" type="interface">
        <description>The validation of one row of a target with no batch of its owner's (TransferTarget
            validateRowService): rowValues holds the registered fields the file gave, as text; scopeKey the scope the
            import is for; batchOptions the batch's registered options; fixedValues what the registration fixes. It
            changes nothing. valid with normalizedValues (the values its apply is given, registered fields only), or
            errors; skip when the row needs nothing done; sourceRevision, when given, is what the row would change as it
            is now: an apply is not made when it differs from the preview's.</description>
        <in-parameters>
            <parameter name="targetId" required="true"/>
            <parameter name="scopeKey"/>
            <parameter name="rowValues" type="Map" required="true"/>
            <parameter name="batchOptions" type="Map"/>
            <parameter name="fixedValues" type="Map"/>
            <parameter name="operationKey"><description>At an apply only: the key the row's apply carries, so an owner
                that already made the row under it (an apply that stopped before its result was kept) still says
                valid</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="valid" type="Boolean"/>
            <parameter name="skip" type="Boolean"/>
            <parameter name="errors" type="List"/>
            <parameter name="warnings" type="List"/>
            <parameter name="normalizedValues" type="Map"/>
            <parameter name="sourceRevision"/>
            <parameter name="displayText"/>
        </out-parameters>
    </service>
    <service verb="apply" noun="TargetRow" type="interface">
        <description>The apply of one validated row (TransferTarget applyRowService), in a transaction of its own, as the
            caller: the owner's real write service, with its own permission, scope and rules. operationKey is the row's:
            a repeat with it answers what the first made. applied with resultRef (the owner's id of what it made) and
            resultText, or a reasonCode and reason.</description>
        <in-parameters>
            <parameter name="targetId" required="true"/>
            <parameter name="scopeKey"/>
            <parameter name="rowValues" type="Map" required="true"/>
            <parameter name="batchOptions" type="Map"/>
            <parameter name="fixedValues" type="Map"/>
            <parameter name="operationKey" required="true"/>
            <parameter name="sourceRevision"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="resultRef"/>
            <parameter name="resultText"/>
        </out-parameters>
    </service>
    <service verb="find" noun="TargetScopes" type="interface">
        <description>The scopes of a target (TransferTarget scopeService) the caller may import into and read, such as
            the organizations they administer: scopeList of scopeKey and title.</description>
        <in-parameters><parameter name="targetId" required="true"/></in-parameters>
        <out-parameters><parameter name="scopeList" type="List"/></out-parameters>
    </service>
    <service verb="find" noun="TargetRuns" type="interface">
        <description>An owner's runs of a target (TransferTarget findService) that the caller may read in the owner's
            own place, by the owner's own permission and scope, newest first, at most maxRows: runList of runId,
            fileLabel, scopeKey and scopeTitle, state (staged, validated, applying, open, running, complete, partial or
            failed) with stateText, startedDate (milliseconds), userName, rowCount, appliedCount, errorCount,
            skippedCount and ownerParameters (the parameters that open the run in the owner's place). Summaries only:
            never a row's content.</description>
        <in-parameters>
            <parameter name="targetId" required="true"/>
            <parameter name="scopeKey"/>
            <parameter name="fromDate" type="Long"/>
            <parameter name="thruDate" type="Long"/>
            <parameter name="maxRows" type="Integer"/>
        </in-parameters>
        <out-parameters><parameter name="runList" type="List"/></out-parameters>
    </service>
    <service verb="call" noun="TargetService" allow-remote="false">
        <description>The service a target's registration names for a step (stage, configure, validate, apply, get,
            report, sample, kinds, validateRow, applyRow, scopes, runs), with that step's parameters only, under the
            caller's own authorization: the service is read from the registration, never given, and must carry the
            step's contract. This service's ALL_USERS ALLOW (AdminTransferCall) is not inheritable, so the grant of the
            service that dispatches does not carry into the owner's service: one the caller is not authorized for is
            refused, as a direct call is. result is the owner's answer.</description>
        <in-parameters>
            <parameter name="targetId" required="true"/>
            <parameter name="step" required="true"/>
            <parameter name="stepParameters" type="Map"/>
        </in-parameters>
        <out-parameters><parameter name="result" type="Map"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('callTargetService', context))</script></actions>
    </service>

    <!-- ========== Imports (DataTransferImports.js, DataTransferBatch.js; impl-admin P15) ========== -->

    <service verb="find" noun="ImportTargets" allow-remote="false">
        <description>The registered import targets (targetList): each with its title, description, what applying it does,
            its owner, its mode (steps: its owner's batch through the shared wizard; rows: a batch kept here; wizard: its
            owner's own wizard, listed with its place), the key of its owner's place, whether it keeps runs, and whether
            the caller holds the permissions its registration names (importAllowed, viewAllowed: the owner's own checks
            still decide). Never a service name. Needs ADMIN_TRANSFER_VIEW.</description>
        <out-parameters>
            <parameter name="targetList" type="List"/>
            <parameter name="canRun" type="Boolean"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('findImportTargets', context))</script></actions>
    </service>
    <service verb="get" noun="ImportTarget" allow-remote="false">
        <description>One import target as its wizard needs it (target): its words (title, description, effectsNote,
            fieldLabel, scopeLabel), what its wizard offers (features), its bounds (maxBytes, maxRows), its fields
            (columnList) and batch options (optionList) when its batch is kept here, the kinds its owner gives this
            caller (kindOptions), the scopes its scope service gives this caller (scopeList), and importAllowed. For any
            signed-in user: a mount of the wizard in the owner's app reads it without ADMIN_TRANSFER_VIEW, and it
            answers nothing of another's.</description>
        <in-parameters>
            <parameter name="targetId" required="true"/>
            <parameter name="organizationPartyId"/>
        </in-parameters>
        <out-parameters><parameter name="target" type="Map"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('getImportTarget', context))</script></actions>
    </service>
    <service verb="stage" noun="Import" allow-remote="false">
        <description>Stage a file for a target: delimited UTF-8 text (importFile, or sourceText) within the target's bounds, for a scope the caller may import into (organizationPartyId). For a target whose batch is kept here: a file that is not text, is too large, does not read or has a column named like a secret or one the target refuses is refused with the reason (FILE_NOT_TEXT, FILE_TOO_LARGE, FILE_UNREADABLE, COLUMN_REFUSED) and nothing is kept; operationKey, when given, is the import's key: the same user, target, scope and content under it answer the import it made (repeated) and anything else under it is refused (OPERATION_KEY_CONFLICT); with none, the same file staged again answers the same import unless forceNew. Needs the target's import permission and whatever its owner checks.</description>
        <implements service="org.moqui.admin.DataTransferServices.define#ImportStep"/>
        <in-parameters>
            <parameter name="targetId" required="true"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('stageImport', context))</script></actions>
    </service>
    <service verb="configure" noun="Import" allow-remote="false">
        <description>Change an import's mapping (mapping: a file's header to a field of the target), defaults, value mappings or batch options, at the mappingRevision read (STALE_MAPPING otherwise). Only fields and options the target registers are taken. The rows not yet applied go back to staged.</description>
        <implements service="org.moqui.admin.DataTransferServices.define#ImportStep"/>
        <in-parameters>
            <parameter name="targetId" required="true"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('configureImport', context))</script></actions>
    </service>
    <service verb="validate" noun="Import" allow-remote="false">
        <description>Validate an import's rows at the mappingRevision read, changing nothing of the owner's: each row is valid, invalid with its reason, or skipped; the answer's inputFingerprint is the preview an apply must name.</description>
        <implements service="org.moqui.admin.DataTransferServices.define#ImportStep"/>
        <in-parameters>
            <parameter name="targetId" required="true"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('validateImport', context))</script></actions>
    </service>
    <service verb="apply" noun="Import" allow-remote="false" transaction-timeout="1800">
        <description>Apply the valid rows of the preview its caller reviewed (inputFingerprint; selectedRowIds narrows them): refused (STALE_PREVIEW) when the content, the mapping, the options, the registration or a row's preview changed since. Each row is on its own, under the caller's authority: validated again, then written by the owner's service in a transaction of its own; one that fails is named and the others go on. An applied row is never applied again, so a repeat, or a resumed apply after a stop, takes only what is left.</description>
        <implements service="org.moqui.admin.DataTransferServices.define#ImportStep"/>
        <in-parameters>
            <parameter name="targetId" required="true"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('applyImport', context))</script></actions>
    </service>
    <service verb="get" noun="Transfer" allow-remote="false">
        <description>One import with a page of its rows (pageIndex; errorsOnly for the rows that need attention), for the user who staged it and those its target admits; transferId may be given for operationKey.</description>
        <implements service="org.moqui.admin.DataTransferServices.define#ImportStep"/>
        <in-parameters>
            <parameter name="targetId" required="true"/>
            <parameter name="transferId"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('getTransfer', context))</script></actions>
    </service>
    <service verb="retry" noun="ImportItems" allow-remote="false" transaction-timeout="1800">
        <description>Apply again the failed rows of an import (itemSeqIdList, or every failed row; at most 200), each on
            its own after it is validated again. A row that did not fail is named in its result and left as it is: an
            applied row is never applied again. retryKey, when given, answers a repeat of the same retry with its first
            results. resultList has, per row, applied or a reasonCode and reason.</description>
        <in-parameters>
            <parameter name="targetId" required="true"/>
            <parameter name="operationKey" required="true"/>
            <parameter name="itemSeqIdList" type="List"/>
            <parameter name="retryKey"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="repeated" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="operationKey"/>
            <parameter name="state"/>
            <parameter name="appliedCount" type="Integer"/>
            <parameter name="refusedCount" type="Integer"/>
            <parameter name="resultList" type="List"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('retryImportItems', context))</script></actions>
    </service>
    <service verb="get" noun="ImportReport" allow-remote="false">
        <description>An import's rows as a file (reportCsv, filename): what was staged with each row's result, reason and
            reference, or only the rows that need attention (errorsOnly). For those who may read the import; a cell a
            spreadsheet would read as a formula is written as text.</description>
        <in-parameters>
            <parameter name="targetId" required="true"/>
            <parameter name="operationKey" required="true"/>
            <parameter name="errorsOnly" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="reportCsv"/>
            <parameter name="filename"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('getImportReport', context))</script></actions>
    </service>
    <service verb="get" noun="ImportSample" allow-remote="false">
        <description>An empty file of a target's fields (reportCsv, filename), for a kind of its owner's where it has
            kinds.</description>
        <in-parameters>
            <parameter name="targetId" required="true"/>
            <parameter name="kindId"/>
            <parameter name="organizationPartyId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="reportCsv"/>
            <parameter name="filename"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('getImportSample', context))</script></actions>
    </service>
    <service verb="find" noun="Transfers" allow-remote="false">
        <description>The import runs of every registered target the caller may view (transferList, transferCount), newest
            first, a page at a time: the target and its owner, the file's label, the scope, the state, the rows applied,
            failed and skipped, who ran it, whether its detail is read here (detail) and the key and parameters of its
            owner's place. An owner's runs are what the owner's find service answers for this caller, by the owner's
            own permission and scope: summaries, never a row's content. An owner that did not answer is named in
            unansweredTargetList. Narrowed by target, owner, scope, state and dates (by default the last defaultDays
            days, at most rangeDays). Needs ADMIN_TRANSFER_VIEW.</description>
        <in-parameters>
            <parameter name="targetId"/>
            <parameter name="ownerApp"/>
            <parameter name="scopeKey"/>
            <parameter name="state"/>
            <parameter name="fromDate"/>
            <parameter name="thruDate"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="transferList" type="List"/>
            <parameter name="transferCount" type="Integer"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
            <parameter name="unansweredTargetList" type="List"/>
            <parameter name="stateList" type="List"/>
            <parameter name="defaultDays" type="Integer"/>
            <parameter name="rangeDays" type="Integer"/>
            <parameter name="timeZone"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('findTransfers', context))</script></actions>
    </service>
    <!-- One row of a batch kept here, each in a transaction of its own under apply#Import and retry#ImportItems. No group
        is authorized to call them: they run under those services' grant. -->
    <service verb="apply" noun="TransferItem" allow-remote="false">
        <in-parameters>
            <parameter name="targetId" required="true"/>
            <parameter name="operationKey" required="true"/>
            <parameter name="itemSeqId" type="Integer" required="true"/>
            <parameter name="inputFingerprint"/>
            <parameter name="retry" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="alreadyApplied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="resultRef"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('applyTransferItem', context))</script></actions>
    </service>
    <service verb="fail" noun="TransferItem" allow-remote="false">
        <in-parameters>
            <parameter name="operationKey" required="true"/>
            <parameter name="itemSeqId" type="Integer" required="true"/>
            <parameter name="errorMessage"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('failTransferItem', context))</script></actions>
    </service>
    <service verb="clean" noun="TransferBatches" allow-remote="false" transaction-timeout="600">
        <description>The retention of the batches kept here (the job clean_TransferBatches_daily): past its target's
            retentionDays (30) a batch never applied is removed, and an applied one keeps its outcomes and loses what
            was staged.</description>
        <out-parameters>
            <parameter name="removedCount" type="Integer"/>
            <parameter name="purgedCount" type="Integer"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/admin/DataTransferImports.js').execute('cleanTransferBatches', context))</script></actions>
    </service>
</services>
