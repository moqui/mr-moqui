  <service verb="cleanup" noun="ExpiredChallenges" authenticate="false" allow-remote="false">
    <actions>
      <script><![CDATA[
            const old=ec.artifactExecution.disableAuthz()
            try{for(const name of ['AccountAttempt','RegistrationChallenge','SsoHandoff','DelegatedSession']){
                const entity='moqui.security.public.'+name
                const keys={AccountAttempt:'bucketId',RegistrationChallenge:'challengeId',SsoHandoff:'handoffId',DelegatedSession:'delegationId'}
                for(const row of ec.entity.find(entity).condition('expiresAt','less',ec.user.nowTimestamp).limit(100).list()){
                    try{ec.service.sync().throwOnError(true).name('delete#'+entity).parameters({[keys[name]]:row[keys[name]]}).requireNewTransaction(true).call()}
                    catch(error){ec.message.clearErrors();ec.logger.error('Public account cleanup failed for '+name+' '+row[keys[name]])}
                }
            }}finally{if(!old)ec.artifactExecution.enableAuthz()}
        ]]></script>
    </actions>
  </service>
