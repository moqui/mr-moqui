<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xs:include schemaLocation="common-types-3.xsd"/>
    <xs:include schemaLocation="xml-actions-3.xsd"/>

    <xs:element name="moqui-conf">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="default-property"/>
                <xs:element minOccurs="0" ref="tools"/>
                <xs:element minOccurs="0" ref="cache-list"/>
                <xs:element minOccurs="0" ref="server-stats"/>
                <xs:element minOccurs="0" ref="webapp-list"/>
                <xs:element minOccurs="0" ref="artifact-execution-facade"/>
                <xs:element minOccurs="0" ref="user-facade"/>
                <xs:element minOccurs="0" ref="transaction-facade"/>
                <xs:element minOccurs="0" ref="resource-facade"/>
                <xs:element minOccurs="0" ref="screen-facade"/>
                <xs:element minOccurs="0" ref="service-facade"/>
                <xs:element minOccurs="0" ref="search-facade"/>
                <xs:element minOccurs="0" ref="llm-facade"/>
                <xs:element minOccurs="0" ref="email-client"/>
                <xs:element minOccurs="0" ref="ssh-server"/>
                <xs:element minOccurs="0" ref="terminal"/>
                <xs:element minOccurs="0" ref="git-server"/>
                <xs:element minOccurs="0" ref="dav-server"/>
                <xs:element minOccurs="0" ref="smtp-server"/>
                <xs:element minOccurs="0" ref="logging"/>
                <xs:element minOccurs="0" ref="entity-facade"/>
                <xs:element minOccurs="0" ref="database-list"/>
                <xs:element minOccurs="0" ref="repository-list"/>
                <xs:element minOccurs="0" ref="component-list"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="init-param">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="value" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="default-property">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="value" type="xs:string" use="required"/>
            <xs:attribute name="is-secret" type="boolean" default="false"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="tools">
        <xs:complexType>
            <xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" ref="tool-factory"/></xs:sequence>
            <xs:attribute name="empty-db-load" type="xs:string" default="seed"><xs:annotation><xs:documentation>
                Comma-separated list of data file types to load if database is empty (if there are no records in the
                table for moqui.basic.Enumeration). Empty or 'none' means load nothing, use 'all' to load all found
                data files regardless of type.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="on-start-load-types" type="xs:string"><xs:annotation><xs:documentation>
                Comma-separated list of data file types to load on start. Empty or 'none' means load nothing.
                Does not run if empty-db-load runs.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="on-start-load-components" type="xs:string"><xs:annotation><xs:documentation>
                Comma-separated list of component names to load on start, used with on-start-load-types.
                Does not run if empty-db-load runs.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="worker-queue" type="xs:integer"><xs:annotation><xs:documentation>
                The maximum size of the worker queue.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="worker-pool-core" type="xs:integer"><xs:annotation><xs:documentation>
                The core (minimum) size of the worker thread pool.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="worker-pool-max" type="xs:integer"><xs:annotation><xs:documentation>
                The maximum size of the worker thread pool.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="worker-pool-alive" type="xs:integer"><xs:annotation><xs:documentation>
                The amount of time, in seconds, to keep idle worker threads alive (beyond core pool size).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="notification-topic-factory" type="xs:string"><xs:annotation><xs:documentation>
                The ToolFactory to use to get a SimpleTopic for distributed NotificationMessage</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="tool-factory">
        <xs:complexType>
            <xs:attribute name="class" type="xs:string" use="required"><xs:annotation><xs:documentation>
                Identifier of a linked native ToolFactory implementation. The component supplies code;
                this declaration selects it. disabled and init-priority control its factory-local lifecycle.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="init-priority" type="xs:integer" default="10"/>
            <xs:attribute name="disabled" type="boolean" default="false"/>
        </xs:complexType>
    </xs:element>
    <!-- ===================== Cache Conf Root ===================== -->
    <xs:element name="cache-list">
        <xs:complexType>
            <xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" ref="cache"/></xs:sequence>
            <xs:attribute name="warm-on-start" type="boolean" default="true"/>
            <xs:attribute name="local-factory" type="xs:string"><xs:annotation><xs:documentation>
                The name of the ToolFactory to use for the local CacheManager implementation.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="distributed-factory" type="xs:string"><xs:annotation><xs:documentation>
                The name of the ToolFactory to use for the distributed CacheManager implementation.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="cache">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="key-type" type="xs:string" default="String"/>
            <xs:attribute name="value-type" type="xs:string" default="Object"/>

            <xs:attribute name="expire-time-idle" type="xs:nonNegativeInteger" use="optional">
                <xs:annotation><xs:documentation>Idle expire time in seconds.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="expire-time-live" type="xs:nonNegativeInteger" use="optional">
                <xs:annotation><xs:documentation>Live expire time in seconds.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-elements" type="xs:nonNegativeInteger" use="optional"/>
            <xs:attribute name="eviction-strategy" default="least-frequently-used">
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="least-recently-used"/>
                        <xs:enumeration value="least-frequently-used"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="type" default="local">
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="local">
                            <xs:annotation><xs:documentation>Local only cache (MCache)</xs:documentation></xs:annotation></xs:enumeration>
                        <xs:enumeration value="distributed">
                            <xs:annotation><xs:documentation>Distributed cache; keys and values must be serializable</xs:documentation></xs:annotation></xs:enumeration>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="server-stats">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="artifact-stats"/>
            </xs:sequence>
            <xs:attribute name="bin-length-seconds" type="xs:positiveInteger" default="900">
                <xs:annotation><xs:documentation>The bin length should be less than or equal to one hour and evenly
                    divisible into an hour, the default is 900 seconds (15 minutes)</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="visit-enabled" type="boolean" default="true"/>
            <xs:attribute name="visit-ip-info-on-login" type="boolean" default="true"/>
            <xs:attribute name="visitor-enabled" type="boolean" default="true"/>
            <xs:attribute name="stats-skip-condition" type="xs:string">
                <xs:annotation><xs:documentation>If evaluates to true skips creating visit and visitor, and doesn't
                    track ArtifactHit for screens.</xs:documentation></xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="artifact-stats">
        <xs:complexType>
            <xs:attribute name="type" use="required"><xs:simpleType><xs:restriction base="xs:token">
                <xs:enumeration value="AT_XML_SCREEN"/>
                <xs:enumeration value="AT_XML_SCREEN_CONTENT"/>
                <xs:enumeration value="AT_XML_SCREEN_TRANS"/>
                <xs:enumeration value="AT_SERVICE"/>
                <xs:enumeration value="AT_ENTITY"/>
            </xs:restriction></xs:simpleType></xs:attribute>
            <!-- Removed, note that entity-auto and entity-implicit service calls never have hits persisted and that is
                mainly what this was used for: <xs:attribute name="sub-type" type="xs:string"/> -->
            <xs:attribute name="persist-hit" type="boolean" default="false"/>
            <xs:attribute name="persist-bin" type="boolean" default="false"/>
        </xs:complexType>
    </xs:element>

    <!-- ===================== Webapp Conf Root ===================== -->
    <xs:element name="webapp-list">
        <xs:complexType><xs:sequence><xs:element maxOccurs="unbounded" ref="webapp"/></xs:sequence></xs:complexType>
    </xs:element>
    <xs:element name="webapp">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="root-screen"><xs:complexType>
                    <xs:attribute name="host" type="xs:string" use="required">
                        <xs:annotation><xs:documentation>A pattern to match the host name against (from ServletRequest.getServerName())</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="location" type="xs:string" use="required">
                        <xs:annotation><xs:documentation>The location of the root screen XML file</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="error-screen"><xs:complexType>
                    <xs:attribute name="error" use="required"><xs:simpleType><xs:restriction base="xs:token">
                        <xs:enumeration value="unauthorized"><xs:annotation><xs:documentation>401 - authentication required</xs:documentation></xs:annotation></xs:enumeration>
                        <xs:enumeration value="forbidden"><xs:annotation><xs:documentation>403 - authorization failed</xs:documentation></xs:annotation></xs:enumeration>
                        <xs:enumeration value="not-found"><xs:annotation><xs:documentation>404 - screen/resource not found</xs:documentation></xs:annotation></xs:enumeration>
                        <xs:enumeration value="too-many"><xs:annotation><xs:documentation>429 - tarpit limit reached</xs:documentation></xs:annotation></xs:enumeration>
                        <xs:enumeration value="internal-error"><xs:annotation><xs:documentation>500 - general error</xs:documentation></xs:annotation></xs:enumeration>
                    </xs:restriction></xs:simpleType></xs:attribute>
                    <xs:attribute name="screen-path" type="xs:string" use="required">
                        <xs:annotation><xs:documentation>The path to the screen to render on error</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="token-route">
                    <xs:annotation><xs:documentation>An anonymous token route: /name/token renders the screen at
                        screen-location in the public shell (Vue, Quasar, the theme and the m-* components, with no header,
                        drawers or login), /name/token.qvt (or .qvue, .qjs) the screen itself, and /name/token/path what is
                        below it. The token-service runs first, with token and routeName, and answers valid and routeContext;
                        a token it does not accept gets a short "link expired or not found" page and nothing else runs. The
                        screen's context has token and tokenRoute {name, token, basePath, title, context}. A route named as
                        a framework path (apps, qapps, rest, ...) is left out. No Java counterpart.</xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="name" type="xs:string" use="required">
                            <xs:annotation><xs:documentation>The first path segment, for example s, u or call</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="screen-location" type="xs:string" use="required"/>
                        <xs:attribute name="token-service" type="xs:string" use="required"/>
                        <xs:attribute name="title" type="xs:string"/>
                        <xs:attribute name="post-transition" type="xs:string">
                            <xs:annotation><xs:documentation>A transition of the screen that a POST to /name/token itself
                                runs, after the token check, as a POST to /name/token/transition would: an RFC 8058
                                one-click unsubscribe posts to the List-Unsubscribe URL, the page's own. The poster has no
                                session token, so give the transition require-session-token="false". Without it a POST to
                                /name/token is the public shell page.</xs:documentation></xs:annotation></xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element minOccurs="0" name="first-hit-in-visit"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>
                <xs:element minOccurs="0" name="before-request"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>
                <xs:element minOccurs="0" name="after-request"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>
                <xs:element minOccurs="0" name="after-login"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>
                <xs:element minOccurs="0" name="before-logout"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>
                <xs:element minOccurs="0" name="after-startup"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>
                <xs:element minOccurs="0" name="before-shutdown"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>

                <xs:element minOccurs="0" maxOccurs="unbounded" name="context-param"><xs:complexType>
                    <xs:attribute name="name" type="xs:string" use="required"/>
                    <xs:attribute name="value" type="xs:string" use="required"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="filter">
                    <xs:annotation><xs:documentation>
                        A filter on the requests whose path a url-pattern maps (as the Servlet spec has it), run in
                        priority order, then as declared, before the servlet. It is the script at location, whose value is
                        a handler object with doFilter(request, response, chain); chain.doFilter() goes on. Or class, one
                        of the Java classes this server has: org.moqui.impl.webapp.MoquiAuthFilter (the script
                        component://webroot/script/AuthFilter.js) and org.moqui.impl.webapp.ElasticRequestLogFilter (the
                        server's request log; enabled="false" turns it off). See docs/Web-Scripts.md.
                    </xs:documentation></xs:annotation>
                    <xs:complexType>
                    <xs:sequence>
                        <xs:element minOccurs="0" maxOccurs="unbounded" ref="init-param"/>
                        <xs:element minOccurs="0" maxOccurs="unbounded" name="url-pattern" type="xs:string"/>
                        <xs:element minOccurs="0" maxOccurs="unbounded" name="dispatcher" type="xs:string"><xs:annotation>
                            <xs:documentation>Only REQUEST: a filter runs once, on the request from the client.</xs:documentation>
                        </xs:annotation></xs:element>
                    </xs:sequence>
                    <xs:attribute name="name" type="xs:string" use="required"/>
                    <xs:attribute name="location" type="xs:string"><xs:annotation><xs:documentation>
                        The script of the filter, such as component://mycomp/script/MyFilter.js. This or class.
                    </xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="class" type="xs:string"/>
                    <xs:attribute name="async-supported" type="boolean" default="false"><xs:annotation><xs:documentation>
                        Not read by this server.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="enabled" type="boolean" default="true"/>
                    <xs:attribute name="priority" type="xs:nonNegativeInteger" default="5"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="listener">
                    <xs:annotation><xs:documentation>
                        The script at location, whose value is a handler object with any of contextInitialized,
                        contextDestroyed, sessionCreated, sessionDestroyed, requestInitialized and requestDestroyed, each
                        taking the event. Or class org.moqui.impl.webapp.MoquiSessionListener, which this server has
                        natively. See docs/Web-Scripts.md.
                    </xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="location" type="xs:string"/>
                        <xs:attribute name="class" type="xs:string"/>
                        <xs:attribute name="enabled" type="boolean" default="true"/>
                    </xs:complexType>
                </xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="servlet">
                    <xs:annotation><xs:documentation>
                        What answers the requests whose path a url-pattern maps: an exact path, else the longest /path/*,
                        else *.extension, else the default /. It is the script at location, whose value is a handler object
                        with service(request, response) or doGet, doPost and the other methods. Or class, one of the Java
                        classes this server has: org.moqui.impl.webapp.MoquiServlet (the screens) and
                        org.moqui.impl.webapp.MoquiFopServlet (a screen as PDF). See docs/Web-Scripts.md.
                    </xs:documentation></xs:annotation>
                    <xs:complexType>
                    <xs:sequence>
                        <xs:element minOccurs="0" maxOccurs="unbounded" ref="init-param"/>
                        <xs:element minOccurs="1" maxOccurs="unbounded" name="url-pattern" type="xs:string"/>
                    </xs:sequence>
                    <xs:attribute name="name" type="xs:string" use="required"/>
                    <xs:attribute name="location" type="xs:string"><xs:annotation><xs:documentation>
                        The script of the servlet, such as component://mycomp/script/MyServlet.js. This or class.
                    </xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="class" type="xs:string"/>
                    <xs:attribute name="max-body" type="xs:string"><xs:annotation><xs:documentation>
                        The largest request body this servlet takes, such as 100m, in place of the web-protection max-body;
                        for a proxy that passes on a bulk load. Not for a multipart upload, whose limit is max-upload.
                        No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="load-on-startup" type="xs:nonNegativeInteger" default="1"><xs:annotation>
                        <xs:documentation>Not read by this server.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="async-supported" type="boolean" default="false"><xs:annotation><xs:documentation>
                        Not read by this server.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="enabled" type="boolean" default="true"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" name="session-config"><xs:complexType>
                    <xs:attribute name="timeout" type="non-neg-int-expandable" use="required"><xs:annotation><xs:documentation>
                        Minutes without a request before a web session expires; 0 never expires.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="flush" type="xs:string" default="eventual"><xs:annotation><xs:documentation>
                        eventual writes a changed session after the response; guarantee writes it before. No Java
                        counterpart.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max" type="non-neg-int-expandable" default="10000"><xs:annotation><xs:documentation>
                        Most web sessions kept in memory. Over it, the sessions used longest ago are written and dropped,
                        and reload from HttpSession when they come back. 0 keeps every session. No Java counterpart.
                    </xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="endpoint">
                    <xs:annotation><xs:documentation>Add a WebSocket Endpoint</xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="path" type="xs:string" use="required"><xs:annotation><xs:documentation>
                            The path for the endpoint, relative to webapp, must start with forward slash ('/')</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="class" type="xs:string"><xs:annotation><xs:documentation>
                            In Rust the host serves /notws and /termws itself and this is not used. Java: must extend javax.websocket.Endpoint. For Moqui-specific features including setting up an ExecutionContext
                            extend org.moqui.impl.webapp.MoquiAbstractEndpoint. Even if not using MoquiAbstractEndpoint it will try
                            to add the following ServerEndpointConfig user properties: handshakeRequest, httpSession,
                            executionContextFactory, and maxIdleTimeout (set to value of @timeout).</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="timeout" type="xs:integer"><xs:annotation><xs:documentation>
                            Milliseconds with nothing from the client before the socket closes.</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="enabled" type="boolean-expandable" default="true"/>
                    </xs:complexType>
                </xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="response-header"><xs:complexType>
                    <xs:attribute name="type" use="required"><xs:simpleType><xs:restriction base="xs:token">
                        <xs:enumeration value="web-resource-inline"/>
                        <xs:enumeration value="screen-resource-binary"/>
                        <xs:enumeration value="screen-resource-text"/>
                        <xs:enumeration value="screen-resource-template"/>
                        <xs:enumeration value="screen-render"/>
                        <xs:enumeration value="screen-secure"/>
                        <xs:enumeration value="screen-server-static"/>
                        <xs:enumeration value="screen-transition"/>
                        <xs:enumeration value="cors-actual"/>
                        <xs:enumeration value="cors-preflight"/>
                    </xs:restriction></xs:simpleType></xs:attribute>
                    <xs:attribute name="name" type="xs:string" use="required"/>
                    <xs:attribute name="value" type="xs:string" use="required"/>
                    <xs:attribute name="add" type="boolean" default="false"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" ref="web-protection"/>
            </xs:sequence>
            <xs:attribute name="name" type="name-plain" use="required"><xs:annotation><xs:documentation>
                Matched against value of a context-param.param-value element in the web.xml file where the param-name is "moqui-name".</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="https-enabled" default="false" type="xs:string"/>
            <xs:attribute name="https-port" type="xs:string"/>
            <xs:attribute name="https-host" type="xs:string"/>
            <xs:attribute name="http-port" type="xs:string"/>
            <xs:attribute name="http-host" type="xs:string"/>
            <xs:attribute name="handle-cors" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>
                Set to false to disable CORS handling globally in MoquiServlet including Origin validation and adding cors-preflight and cors-actual configured response headers
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="allow-origins" type="xs:string"><xs:annotation><xs:documentation>
                Comma separated list of host name or protocol plus host name to match against Origin request header; can be '*' to allow all</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="require-session-token" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>
                If not false (default true) moquiSessionToken (from ec.web.sessionToken) must be passed to all
                screen/transition requests in a session after the first.</xs:documentation></xs:annotation></xs:attribute>
            <!-- Needed? Not yet implemented: <xs:attribute name="cookie-domain" type="xs:string"/> -->
            <xs:attribute name="websocket-timeout" type="xs:integer"><xs:annotation><xs:documentation>
                The default WebSocket session max idle timeout for the whole server.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="upload-executable-allow" type="boolean-expandable" default="false"/>
            <xs:attribute name="client-ip-header" type="xs:string"><xs:annotation><xs:documentation>
                Set this if there is a reverse proxy in front of the Moqui server.

                Using X-Forwarded-For is risky because clients can set a value for the header to spoof a client IP
                address; if the outer-most proxy handles X-Forwarded-For by always setting it to its client IP address
                instead of the common default behavior of appending to an existing X-Forwarded-For header then it is fine,
                but should generally be set to a more reliable header for the reverse-proxy used.

                With trusted-proxies set the header is read only from those proxies, and the address taken is the
                rightmost one that is not itself a trusted proxy, so an appended X-Forwarded-For is safe too.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="trusted-proxies" type="xs:string"><xs:annotation><xs:documentation>
                Comma separated address ranges (10.0.0.0/8, fd00::/8, or one address) of the reverse proxies in front.
                client-ip-header and X-Forwarded-Proto are believed only from these. When one or more are set the
                per-client parts of web-protection are on by default. Empty, the header is believed from any peer
                (first hop), as before. No Java counterpart.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="status-ips" type="xs:string"><xs:annotation><xs:documentation>
                Comma separated addresses that may read /health and /metrics, besides loopback. No Java counterpart.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="transfer-workers" type="non-neg-int-expandable" default="16"><xs:annotation><xs:documentation>
                A file response over 256 KiB streams, read a window at a time as the client takes it; at most this many
                reads of files in the database run at once. No Java counterpart.
            </xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="web-protection">
        <xs:annotation><xs:documentation>Load handling and basic WAF features at the edge, checked before a session,
            a request worker or the database is spent, in memory per server. The global limits (connections, requests,
            overload) always apply. The per-client parts (max-per-client, the request methods, rate-limit, ban, and the
            rules) apply when enabled is true, or when it is empty and the webapp has trusted-proxies. Not the
            ArtifactTarpit, which counts a user's use of screens and services for business quotas; both apply, this
            first. Each attribute left out or empty uses its webapp_* property, then the built-in default. No Java
            counterpart.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" name="connections"><xs:complexType>
                    <xs:attribute name="max" type="xs:string"><xs:annotation><xs:documentation>
                        Connections served at once, HTTP and HTTPS together (webapp_max_connections, 1024). Past it new
                        connections wait until one closes.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-per-client" type="xs:string"><xs:annotation><xs:documentation>
                        Connections from one client address at once (64); past it a new one is closed. Trusted proxies
                        and exempt clients are not counted.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="header-timeout" type="xs:string"><xs:annotation><xs:documentation>
                        Seconds for the request head, the TLS handshake, and an idle kept-alive connection
                        (webapp_header_timeout, 30); 0 is no limit.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="shutdown-timeout" type="xs:string"><xs:annotation><xs:documentation>
                        Seconds open connections may take to finish after a stop (webapp_shutdown_timeout, 30).</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" name="requests"><xs:complexType>
                    <xs:attribute name="methods" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated request methods allowed; another is answered 405. Empty allows any. A per-client
                        rule: it applies when the per-client parts are on.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-uri-length" type="xs:string"><xs:annotation><xs:documentation>
                        Longest path and query (8192); longer is answered 414.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-header-bytes" type="xs:string"><xs:annotation><xs:documentation>
                        Largest request head in bytes (65536, at least 8192); larger is answered 431.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-headers" type="xs:string"><xs:annotation><xs:documentation>
                        Most header fields in a request (100); more is answered 431.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-body" type="xs:string"><xs:annotation><xs:documentation>
                        Largest request body that is not multipart, bytes or with a k, m or g suffix (webapp_max_body,
                        10m); larger is answered 413.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-upload" type="xs:string"><xs:annotation><xs:documentation>
                        Largest multipart/form-data body (webapp_max_upload, 2g).</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="body-timeout" type="xs:string"><xs:annotation><xs:documentation>
                        Seconds for a whole request body that is not an upload (webapp_body_timeout, 60); then 408.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="upload-idle-timeout" type="xs:string"><xs:annotation><xs:documentation>
                        Seconds an upload may send nothing (webapp_upload_idle_timeout, 60); then 408.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="request-timeout" type="xs:string"><xs:annotation><xs:documentation>
                        Seconds from the request head to the response head (webapp_request_timeout, 300); then 504.</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" name="overload"><xs:complexType>
                    <xs:attribute name="queue-timeout" type="xs:string"><xs:annotation><xs:documentation>
                        Seconds a request may wait for a request worker (10); one that waited
                        longer is answered 503 instead of run. 0 is no limit.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="retry-after" type="xs:string"><xs:annotation><xs:documentation>
                        The Retry-After seconds of a 503 for a full queue or a busy server (5).</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="rate-limit"><xs:complexType>
                    <xs:annotation><xs:documentation>Per client: requests per seconds sustained and burst at once, over
                        the requests path and methods match (all when left out). Past it the answer is 429 with
                        Retry-After. A request takes a token from every rate-limit that matches it. Merged by name; a
                        component sets enabled="false" to turn one off.</xs:documentation></xs:annotation>
                    <xs:attribute name="name" type="xs:string" use="required"/>
                    <xs:attribute name="requests" type="xs:string"/>
                    <xs:attribute name="seconds" type="xs:string" default="1"/>
                    <xs:attribute name="burst" type="xs:string"><xs:annotation><xs:documentation>
                        Requests allowed at once; requests when left out.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="path" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated url-pattern style globs: * within a segment, ** across segments.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="methods" type="xs:string"/>
                    <xs:attribute name="enabled" type="xs:string" default="true"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="ban"><xs:complexType>
                    <xs:annotation><xs:documentation>Per client: threshold of events within seconds bans the client for
                        duration seconds. A banned client's connections are closed and its requests answered 403. Merged
                        by name.</xs:documentation></xs:annotation>
                    <xs:attribute name="name" type="xs:string" use="required"/>
                    <xs:attribute name="events" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated: auth-failure (credentials that were not valid: a login form, Basic auth, an API
                        or login key, git), rate-limited (a 429), denied (a rule refused the request).</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="threshold" type="xs:string"/>
                    <xs:attribute name="seconds" type="xs:string"/>
                    <xs:attribute name="duration" type="xs:string"/>
                    <xs:attribute name="enabled" type="xs:string" default="true"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="client-rule"><xs:complexType>
                    <xs:attribute name="name" type="xs:string"><xs:annotation><xs:documentation>
                        A rule with a name merges by it; one without is added.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="enabled" type="xs:string" default="true"/>
                    <xs:attribute name="action"><xs:simpleType><xs:restriction base="xs:token">
                        <xs:enumeration value="deny"><xs:annotation><xs:documentation>Connections closed, requests 403.</xs:documentation></xs:annotation></xs:enumeration>
                        <xs:enumeration value="exempt"><xs:annotation><xs:documentation>No rules, rate limits or bans; the global limits still apply.</xs:documentation></xs:annotation></xs:enumeration>
                    </xs:restriction></xs:simpleType></xs:attribute>
                    <xs:attribute name="cidr" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated address ranges.</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="path-rule"><xs:complexType>
                    <xs:attribute name="name" type="xs:string"><xs:annotation><xs:documentation>
                        A rule with a name merges by it; one without is added.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="enabled" type="xs:string" default="true"/>
                    <xs:attribute name="action"><xs:simpleType><xs:restriction base="xs:token">
                        <xs:enumeration value="deny"><xs:annotation><xs:documentation>Answered 404.</xs:documentation></xs:annotation></xs:enumeration>
                    </xs:restriction></xs:simpleType></xs:attribute>
                    <xs:attribute name="path" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated url-pattern style globs, matched without regard to case against the decoded path.</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="user-agent-rule"><xs:complexType>
                    <xs:attribute name="name" type="xs:string"><xs:annotation><xs:documentation>
                        A rule with a name merges by it; one without is added.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="enabled" type="xs:string" default="true"/>
                    <xs:attribute name="action"><xs:simpleType><xs:restriction base="xs:token">
                        <xs:enumeration value="deny"><xs:annotation><xs:documentation>Answered 403.</xs:documentation></xs:annotation></xs:enumeration>
                    </xs:restriction></xs:simpleType></xs:attribute>
                    <xs:attribute name="contains" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated text; a User-Agent containing one, without regard to case, is denied.</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:string"><xs:annotation><xs:documentation>
                true or false for the per-client parts (webapp_web_protection); empty, on when the webapp has
                trusted-proxies.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="client-ipv6-prefix" type="xs:string" default="64"><xs:annotation><xs:documentation>
                IPv6 clients are counted by this many leading bits of their address.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-tracked-clients" type="xs:string" default="100000"><xs:annotation><xs:documentation>
                Most clients kept in memory; past it new clients are served without per-client limits.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <!-- ====================== Artifact Execution Facade Conf Root ======================= -->
    <xs:element name="artifact-execution-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="artifact-execution"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="artifact-execution">
        <xs:complexType>
            <xs:attribute name="type" use="required">
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="AT_XML_SCREEN"/>
                        <xs:enumeration value="AT_XML_SCREEN_TRANS"/>
                        <xs:enumeration value="AT_SERVICE"/>
                        <xs:enumeration value="AT_ENTITY"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="authz-enabled" type="boolean" default="true"/>
            <xs:attribute name="tarpit-enabled" type="boolean" default="true"/>
        </xs:complexType>
    </xs:element>

    <!-- ====================== User Facade Conf Root ======================= -->
    <xs:element name="user-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" ref="password"/>
                <xs:element minOccurs="0" ref="login-key"/>
                <xs:element minOccurs="0" ref="login"/>
                <xs:element minOccurs="0" ref="authz"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="authz">
        <xs:annotation><xs:documentation>Grants that only a holder may make. No Java counterpart.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="privileged-groups" type="xs:string" default="ADMIN,ADMIN_ADV"><xs:annotation><xs:documentation>
                Comma separated UserGroup IDs. UserGroupMember create, update and delete for these groups is allowed
                only if the caller is already a member (seed/install and disableAuthz skip the check).
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sealed-permissions" type="xs:string"><xs:annotation><xs:documentation>
                Comma separated UserPermission IDs. UserGroupPermission create, update and delete for these IDs is
                allowed only if the caller already has that permission.
            </xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="password">
        <xs:complexType>
            <xs:attribute name="encrypt-hash-type" default="SHA-256">
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="SHA-256"/>
                    <xs:enumeration value="SHA-384"/>
                    <xs:enumeration value="SHA-512"/>
                    <xs:enumeration value="SHA"/>
                    <xs:enumeration value="MD5"/>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="min-length" type="xs:nonNegativeInteger" default="8">
                <xs:annotation><xs:documentation>Minimum length of password</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="min-digits" type="xs:nonNegativeInteger" default="1">
                <xs:annotation><xs:documentation>Minimum number of digits (numeric characters) in the password</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="min-others" type="xs:nonNegativeInteger" default="1">
                <xs:annotation><xs:documentation>Minimum number of other (non-alpha/numeric, not letters or digits) characters in the password</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="history-limit" type="xs:nonNegativeInteger" default="5">
                <xs:annotation><xs:documentation>Number of old passwords to save that cannot be reused (0 means don't save any history)</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="change-weeks" type="xs:decimal" default="12">
                <xs:annotation><xs:documentation>Require password change after this many months (0 means don't ever require change)</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="email-require-change" type="boolean" default="false">
                <xs:annotation><xs:documentation>Require password change after a password reset email?</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="email-expire-hours" type="xs:nonNegativeInteger" default="48">
                <!-- TODO use in impl -->
                <xs:annotation><xs:documentation>How long will the new password be valid from the password reset email?</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="login-key">
        <xs:complexType>
            <xs:attribute name="encrypt-hash-type" default="SHA-256">
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="SHA-256"/>
                    <xs:enumeration value="SHA-384"/>
                    <xs:enumeration value="SHA-512"/>
                    <xs:enumeration value="SHA"/>
                    <xs:enumeration value="MD5"/>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="expire-hours" type="xs:nonNegativeInteger" default="144">
                <xs:annotation><xs:documentation>Expire key after this many hours</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="login">
        <xs:complexType>
            <xs:attribute name="max-failures" type="xs:nonNegativeInteger" default="3">
                <xs:annotation><xs:documentation>Account is disabled after max failures</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="disable-minutes" type="xs:nonNegativeInteger" default="30">
                <xs:annotation><xs:documentation>How long to disable the account (0 means no limit, ie forever)</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="history-store" type="boolean" default="true">
                <xs:annotation><xs:documentation>Store records of login attempts?</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="history-incorrect-password" type="boolean" default="true">
                <xs:annotation><xs:documentation>Store incorrect passwords in login attempt history?</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <!-- Future security settings:
    # NOTE: LDAP auth settings

    # - - allow x509 certificate login
    login.cert.allow=true

    # - - HTTP header based ID (for integrations; make sure client can't send this with some sort of filter)
    #login.http.header=REMOTE_USER

    # - - HttpServletRequest.getRemoteUser() based ID (for integration; uncomment to enable)
    # Use for external authentication solutions like CAS which overload the getRemoteUser method.
    #login.http.servlet.getRemoteUser.allow=true
    -->

    <!-- ====================== Transaction Facade Conf Root ======================= -->
    <xs:element name="transaction-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" ref="server-jndi"><xs:annotation><xs:documentation>
                    If not present the default JNDI server will be used.</xs:documentation></xs:annotation></xs:element>
                <xs:choice minOccurs="0">
                    <xs:element minOccurs="0" ref="transaction-jndi"/>
                    <xs:element minOccurs="0" ref="transaction-internal"/>
                </xs:choice>
            </xs:sequence>
            <xs:attribute name="use-transaction-cache" default="true" type="boolean"/>
            <xs:attribute name="use-connection-stash" default="true" type="boolean"/>
            <xs:attribute name="use-lock-track" default="false" type="boolean-expandable">
                <xs:annotation><xs:documentation>If true track locks from create, update, and delete plus FK locks and find for-update,
                    use that data to warn about possible lock conflicts</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="use-statement-timeout" default="false" type="boolean-expandable">
                <xs:annotation><xs:documentation>If true runs all JDBC statements in a separate Thread in order to enforce a timeout,
                    this has significant overhead but protects against long held locks, etc</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="transaction-jndi">
        <xs:complexType>
            <xs:attribute name="user-transaction-jndi-name" type="xs:string" use="required"/>
            <xs:attribute name="transaction-manager-jndi-name" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="transaction-internal">
        <xs:complexType>
            <xs:attribute name="class" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <!-- ====================== Resource Facade Conf Root ================= -->
    <xs:element name="resource-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="resource-reference"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="template-renderer"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="script-runner"/>
            </xs:sequence>
            <xs:attribute name="xml-actions-template-location" type="xs:string"/>
            <xs:attribute name="xsl-fo-handler-factory" type="xs:string"><xs:annotation><xs:documentation>
                Name of the ToolFactory to use for XSL-FO transformation in the ResourceFacade.xslFoTransform() method.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="blob-chunk-size" type="non-neg-int-expandable" default="1048576"><xs:annotation><xs:documentation>Bytes per ContentBlobChunk row of a content blob (moqui.resource.ContentBlob). No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="blob-gc-prune-days" type="non-neg-int-expandable" default="14"><xs:annotation><xs:documentation>How many days a content blob nothing refers to is kept (gc#ContentBlobs). No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="dbresource-blob-threshold" type="non-neg-int-expandable" default="65536"><xs:annotation><xs:documentation>A dbresource file over this many bytes is a content blob (stored once, streamed), not fileData. No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="image-max-concurrent" type="non-neg-int-expandable" default="2"><xs:annotation><xs:documentation>Image conversions (convert#Image) that may run at once; a decoded image may take hundreds of MB. No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="script-timeout" type="xs:string"><xs:annotation><xs:documentation>Seconds a script may run when no transaction limits it (a widget condition, a
                transaction="ignore" service), on every thread; a transaction's own timeout replaces it, and 0 is no
                limit. Empty, a script on a request worker is limited to the webapp's request-timeout and one on a
                service, job or scheduler thread is not limited, as in Java.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="resource-reference">
        <xs:annotation><xs:documentation>Maps a scheme to a built-in resource implementation or a linked
            native ResourceProvider identifier. This does not create a service or a tool.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="scheme" type="xs:string" use="required"/>
            <xs:attribute name="class" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="template-renderer">
        <xs:annotation><xs:documentation>Maps an extension to a built-in renderer or linked native
            TemplateRenderer identifier. This does not create a service or a tool.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="extension" type="xs:string" use="required"/>
            <xs:attribute name="class" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="script-runner">
        <xs:complexType>
            <xs:attribute name="extension" type="xs:string" use="required"/>
            <xs:attribute name="class" type="xs:string" use="optional">
                <xs:annotation><xs:documentation>If specified should point to a class that implements the
                    org.moqui.context.ScriptRunner interface.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="engine" type="xs:string" use="optional">
                <xs:annotation><xs:documentation>The JSR-223 engine name, i.e. the name passed to the
                    javax.script.ScriptEngine.getEngineByName() method. If you use this attribute do not use the class
                    attribute as that will override this setting.

                    NOTE: If you use a default extension supported in JSR-223 for the desired scripting language you do
                    not need a script-runner element. The ScriptEngine will be looked up using the
                    ScriptEngineManager.getEngineByExtension() method and the script (pre-compiled if supported) will
                    be cached in the "resource.script${extension}.location" cache.
                </xs:documentation></xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <!-- ====================== Screen Facade Conf Root =================== -->
    <xs:element name="screen-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" name="pdf"><xs:complexType>
                    <xs:annotation><xs:documentation>PDF, the html-print render through headless Chromium. No Java
                        counterpart.</xs:documentation></xs:annotation>
                    <xs:attribute name="chromium-path" type="xs:string"><xs:annotation><xs:documentation>
                        The Chromium executable; empty, or a path that names no file, looks in runtime/chromium (from
                        ./moq chromium-download), then for chromium, then chromium-browser, on the PATH.
                    </xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="page-limit" type="non-neg-int-expandable" default="4"><xs:annotation><xs:documentation>
                        The pages that print at once.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="timeout" type="non-neg-int-expandable" default="60"><xs:annotation><xs:documentation>
                        The seconds one document may take.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="preview-max-size" type="non-neg-int-expandable" default="26214400"><xs:annotation><xs:documentation>
                        The largest PDF, in bytes, that gets a preview (its first page and text, through pdf.js in the
                        same browser).</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="screen-text-output"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="screen-output"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="screen"><xs:complexType>
                    <xs:sequence>
                        <xs:element minOccurs="0" maxOccurs="unbounded" name="subscreens-item"><xs:annotation><xs:documentation>
                            See the screen.subscreens.subscreens-item element in xml-screen-{version}.xsd for more details
                        </xs:documentation></xs:annotation><xs:complexType>
                            <xs:attribute name="name" type="name-plain" use="required"/>
                            <xs:attribute name="location" type="xs:string"/>
                            <xs:attribute name="menu-title" type="xs:string"/>
                            <xs:attribute name="menu-index" type="xs:positiveInteger"/>
                            <xs:attribute name="menu-include" type="boolean" default="true"/>
                            <xs:attribute name="no-sub-path" type="boolean" default="false"/>
                        </xs:complexType></xs:element>
                    </xs:sequence>
                    <xs:attribute name="location" type="xs:string" use="required"/>
                    <xs:attribute name="default-subscreen" type="xs:string"/>
                </xs:complexType></xs:element>
            </xs:sequence>
            <xs:attribute name="boundary-comments" default="false" type="boolean"/>
            <xs:attribute name="default-paginate-rows" type="xs:string" default="20"/>
            <xs:attribute name="default-autocomplete-rows" type="xs:string" default="10"/>
            <xs:attribute name="check-interval-ms" type="xs:string"><xs:annotation><xs:documentation>
                How often a screen file is checked for changes, in milliseconds; empty is never when instance_purpose is
                production and two seconds otherwise. No Java counterpart.
            </xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="screen-text-output"><xs:complexType>
        <xs:attribute name="type" type="xs:string" use="required"><xs:annotation>
            <xs:documentation>Can be anything. Default supported values include: text, html, html-print (alias xsl-fo), xml, and csv.</xs:documentation>
        </xs:annotation></xs:attribute>
        <xs:attribute name="mime-type" type="xs:string" use="optional"/>
        <xs:attribute name="always-standalone" type="boolean" default="false"/>
        <xs:attribute name="macro-template-location" type="xs:string" use="required"/>
        <xs:attribute name="output-kind"><xs:annotation><xs:documentation>
            How a failed section is written, and whether the finished level is one JSON document: text and html write
            the escaped message where the section was, vue drops what the section wrote and escapes braces in the
            message, json writes an error node. Empty follows mime-type: application/json is json, text/html is html,
            anything else text. No Java counterpart.</xs:documentation></xs:annotation>
            <xs:simpleType><xs:restriction base="xs:token">
                <xs:enumeration value="text"/><xs:enumeration value="html"/>
                <xs:enumeration value="vue"/><xs:enumeration value="json"/>
            </xs:restriction></xs:simpleType>
        </xs:attribute>
    </xs:complexType></xs:element>
    <xs:element name="screen-output"><xs:complexType>
        <xs:attribute name="type" type="xs:string" use="required"><xs:annotation>
            <xs:documentation>Can be anything. Default supported values include: text, html, html-print (alias xsl-fo), xml, and csv.</xs:documentation>
        </xs:annotation></xs:attribute>
        <xs:attribute name="mime-type" type="xs:string" use="optional"/>
        <xs:attribute name="always-standalone" type="boolean" default="false"/>
        <xs:attribute name="macro-template-location" type="xs:string"><xs:annotation><xs:documentation>
            The JavaScript macro module that fills the document of this binary mode, such as
            framework/template/screen/ScreenXlsx.js for xlsx.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="output-kind"><xs:annotation><xs:documentation>
            How a failed section is written, and whether the finished level is one JSON document: text and html write
            the escaped message where the section was, vue drops what the section wrote and escapes braces in the
            message, json writes an error node. Empty follows mime-type: application/json is json, text/html is html,
            anything else text. No Java counterpart.</xs:documentation></xs:annotation>
            <xs:simpleType><xs:restriction base="xs:token">
                <xs:enumeration value="text"/><xs:enumeration value="html"/>
                <xs:enumeration value="vue"/><xs:enumeration value="json"/>
            </xs:restriction></xs:simpleType>
        </xs:attribute>
        <xs:attribute name="widget-render-class" type="xs:string"><xs:annotation><xs:documentation>
            The Java ScreenWidgetRender class. Read and not used: the type selects the built-in module.</xs:documentation></xs:annotation></xs:attribute>
    </xs:complexType></xs:element>

    <!-- ====================== Service Facade Conf Root ======================= -->
    <xs:element name="service-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="service-location"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="service-type"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="service-file"/>
                <!-- leaving this out for now, not easily supported by Quartz Scheduler: <xs:element minOccurs="0" ref="thread-pool"/> -->
                <!-- TABLED: not to include in 1.0: <xs:element minOccurs="0" maxOccurs="unbounded" ref="jms-service"/> -->
            </xs:sequence>
            <xs:attribute name="distributed-factory" type="xs:string"><xs:annotation><xs:documentation>
                The name of the ToolFactory to use for the distributed async service ExecutorService implementation.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="scheduled-job-check-time" type="non-neg-int-expandable"><xs:annotation><xs:documentation>
                How often to check for and run scheduled service jobs in seconds. Set to 0 (zero) to disable.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="job-queue-max" type="xs:integer"><xs:annotation><xs:documentation>
                The maximum number of jobs to queue when job-pool-max is reached.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="job-pool-core" type="xs:integer"><xs:annotation><xs:documentation>
                The core (minimum) size of the service job thread pool.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="job-pool-max" type="xs:integer"><xs:annotation><xs:documentation>
                The maximum size of the service job thread pool.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="job-pool-alive" type="xs:integer"><xs:annotation><xs:documentation>
                The amount of time, in seconds, to keep idle worker threads alive (beyond core pool size).</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="service-location">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="location" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="service-type">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="runner-class" type="xs:string" use="required"><xs:annotation><xs:documentation>
                Identifier of a linked native service runner. Service XML defines individual services;
                the runner receives their location and method attributes.
            </xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="service-file">
        <xs:complexType>
            <xs:attribute name="location" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="server-jndi">
        <xs:complexType>
            <xs:attribute name="context-provider-url" type="xs:string"/>
            <xs:attribute name="initial-context-factory" type="xs:string"/>
            <xs:attribute name="url-pkg-prefixes" type="xs:string"/>
            <xs:attribute name="security-principal" type="xs:string"><xs:annotation><xs:documentation>The username</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="security-credentials" type="xs:string"><xs:annotation><xs:documentation>The password</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <!-- ===================== Search Facade Conf Root ===================== -->

    <xs:element name="search-facade"><xs:complexType>
        <xs:annotation><xs:documentation>SearchFacade, data documents searched and aggregated through one backend.
            The postgres backend keeps one table per DataDocument in a search schema; the opensearch backend sends the
            same queries to an OpenSearch or ElasticSearch 7+ cluster, where OpenSearch Dashboards can also read them.
        </xs:documentation></xs:annotation>
        <xs:sequence>
            <xs:element name="postgres" minOccurs="0"><xs:complexType>
                <xs:annotation><xs:documentation>A Postgres for the postgres backend. With no url, search uses the
                    entity Postgres, or a dedicated embedded cluster when the entity database is not Postgres.</xs:documentation></xs:annotation>
                <xs:attribute name="url" type="xs:string"><xs:annotation><xs:documentation>
                    postgresql://host:port/database</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="user" type="xs:string"/>
                <xs:attribute name="password" type="xs:string"/>
                <xs:attribute name="schema" type="xs:string" default="search"/>
                <xs:attribute name="read-url" type="xs:string"><xs:annotation><xs:documentation>
                    postgresql://host:port/database of a physical replica of url. Searches and aggregations run there on a
                    separate read-only pool, with the same user and password; index and schema writes stay on url. A search
                    that asks for read-your-writes waits for the replica to replay the primary, or runs on url.
                </xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="read-statement-timeout" type="xs:positiveInteger" default="30"><xs:annotation><xs:documentation>
                    statement_timeout in seconds on replica sessions, so a long search does not hold back replay.
                </xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="text-config" type="xs:string" default="simple"><xs:annotation><xs:documentation>
                    The Postgres text search configuration. simple (lower case, no stemming, stop words kept) matches
                    Elastic's standard analyzer; change it only with tests on the corpus. A change rebuilds the tables.
                </xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="unaccent" type="boolean" default="false"><xs:annotation><xs:documentation>
                    Fold accents: a copy of text-config with the unaccent extension before its word dictionaries, and
                    folded titles for fuzzy and autocomplete. A change rebuilds the tables.
                </xs:documentation></xs:annotation></xs:attribute>
            </xs:complexType></xs:element>
            <xs:element name="cluster" minOccurs="0"><xs:complexType>
                <xs:annotation><xs:documentation>The cluster for the opensearch backend.</xs:documentation></xs:annotation>
                <xs:attribute name="url" type="xs:string" use="required"/>
                <xs:attribute name="user" type="xs:string"/>
                <xs:attribute name="password" type="xs:string"/>
                <xs:attribute name="index-prefix" type="xs:string"><xs:annotation><xs:documentation>
                    Prefix added to all index names just before requests.
                    Must follow index name requirements (lower case, etc).
                    No separator character is added, recommend ending with underscore (_).
                </xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="run" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>
                    When the url is this host and nothing answers there, start the install in runtime/opensearch (unless
                    it has a pid file, a node run outside the server) and stop it on shutdown.
                </xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="start-wait" type="non-neg-int-expandable" default="120"><xs:annotation><xs:documentation>
                    How many seconds startup waits for that node to answer.</xs:documentation></xs:annotation></xs:attribute>
            </xs:complexType></xs:element>
            <xs:element name="semantic" minOccurs="0"><xs:complexType>
                <xs:annotation><xs:documentation>Semantic and hybrid retrieval on the postgres backend. Off unless enabled;
                    needs the pgvector extension (not bundled with embedded Postgres) and an embedder. Enabling it
                    rebuilds the search tables. The embed#PendingDocuments service fills the embeddings.</xs:documentation></xs:annotation>
                <xs:attribute name="enabled" type="boolean" default="false"/>
                <xs:attribute name="dimensions" type="xs:positiveInteger" default="1024"><xs:annotation><xs:documentation>
                    The embedder's vector size.</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="representation" default="halfvec"><xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="halfvec"/><xs:enumeration value="vector"/></xs:restriction></xs:simpleType></xs:attribute>
                <xs:attribute name="max-chars" type="xs:positiveInteger" default="2000"><xs:annotation><xs:documentation>
                    Characters of document text, title roles first, an embedding is made from.</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="embedder" type="xs:string"><xs:annotation><xs:documentation>
                    llm calls the /v1/embeddings of the model the llm-facade binds to the embed feature (llm:modelId
                    names a model), a local embedding model being the expected use; its vectors must have dimensions
                    (a model's api-config may ask for them). hash installs a deterministic word-hash embedder for
                    development and tests; it has no semantic quality. With none, an application installs its model on
                    the search facade.</xs:documentation></xs:annotation></xs:attribute>
            </xs:complexType></xs:element>
        </xs:sequence>
        <xs:attribute name="backend" type="xs:string" default="postgres"><xs:annotation><xs:documentation>
            postgres or opensearch.</xs:documentation></xs:annotation></xs:attribute>
    </xs:complexType></xs:element>

    <!-- ===================== LLM Facade Conf Root ===================== -->

    <xs:element name="llm-facade"><xs:complexType>
        <xs:annotation><xs:documentation>The model endpoints, models and feature bindings of the agents and the LLM
            services (crates/moqui-core/src/llm, plans/LLM-A2A-Assist.md section 6). LlmEndpoint, LlmModel and
            LlmFeatureBinding rows override the entries here with the same id. A component or runtime conf merges by
            endpoint id, model id, bind feature, data-entity package and entity, user-facts service, and ai-task name; limits, content-log, screen-sessions, a2a, mcp and gateway merge
            their attributes.</xs:documentation></xs:annotation>
        <xs:sequence>
            <xs:element name="endpoint" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                <xs:annotation><xs:documentation>A model server. The key is api-key (from a secret default-property) or
                    the property or environment variable api-key-env names; no key sends no auth header (Ollama, LM
                    Studio).</xs:documentation></xs:annotation>
                <xs:sequence>
                    <xs:element name="header" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                        <xs:attribute name="value" type="xs:string" use="required"/>
                    </xs:complexType></xs:element>
                </xs:sequence>
                <xs:attribute name="id" type="xs:string" use="required"/>
                <xs:attribute name="protocol" default="chat-completions">
                    <xs:simpleType><xs:restriction base="xs:token">
                        <xs:enumeration value="chat-completions"/>
                        <xs:enumeration value="responses"/>
                        <xs:enumeration value="anthropic-messages"/>
                        <xs:enumeration value="fake"/>
                    </xs:restriction></xs:simpleType>
                </xs:attribute>
                <xs:attribute name="url" type="xs:string"><xs:annotation><xs:documentation>The base URL, as
                    https://api.openai.com or http://127.0.0.1:1234</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="path" type="xs:string"><xs:annotation><xs:documentation>Empty is the protocol's own:
                    /v1/chat/completions, /v1/responses, /v1/messages</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="api-key" type="xs:string"/>
                <xs:attribute name="api-key-env" type="xs:string"/>
                <xs:attribute name="auth-header" type="xs:string"><xs:annotation><xs:documentation>Empty is
                    Authorization, or x-api-key for anthropic-messages</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="auth-scheme" type="xs:string"><xs:annotation><xs:documentation>The prefix of the key,
                    Bearer by default; none for anthropic-messages</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="connect-timeout" type="xs:string" default="10"/>
                <xs:attribute name="idle-timeout" type="xs:string" default="120"><xs:annotation><xs:documentation>
                    Seconds without a byte of the response before the call fails as retryable.</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="max-concurrent" type="xs:string"/>
                <xs:attribute name="allow-private-network" type="boolean-expandable" default="false"/>
                <xs:attribute name="local" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>
                    Data sent here stays on the site; an agent limited to local endpoints uses only these.</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="disabled" type="boolean-expandable" default="false"/>
            </xs:complexType></xs:element>
            <xs:element name="model" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                <xs:annotation><xs:documentation>A model on an endpoint; name is the provider's name for it. Prices are
                    per million tokens. The behavior attributes are for small models (plan 7.9).</xs:documentation></xs:annotation>
                <xs:sequence>
                    <xs:element name="reasoning" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                        <xs:annotation><xs:documentation>A JSON object deep-merged onto the request body at this
                            reasoning level: nested objects combine, scalars and arrays replace, null removes a key.
                        </xs:documentation></xs:annotation>
                        <xs:simpleContent><xs:extension base="xs:string">
                            <xs:attribute name="level" use="required"><xs:simpleType><xs:restriction base="xs:token">
                                <xs:enumeration value="none"/><xs:enumeration value="low"/><xs:enumeration value="medium"/>
                                <xs:enumeration value="high"/><xs:enumeration value="max"/>
                            </xs:restriction></xs:simpleType></xs:attribute>
                        </xs:extension></xs:simpleContent>
                    </xs:complexType></xs:element>
                    <xs:element name="api-config" type="xs:string" minOccurs="0"><xs:annotation><xs:documentation>A JSON
                        object deep-merged onto every request body before the reasoning patch.</xs:documentation></xs:annotation></xs:element>
                </xs:sequence>
                <xs:attribute name="id" type="xs:string" use="required"/>
                <xs:attribute name="endpoint" type="xs:string" use="required"/>
                <xs:attribute name="name" type="xs:string"/>
                <xs:attribute name="tier" default="balanced"><xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="fast"/><xs:enumeration value="balanced"/><xs:enumeration value="thorough"/>
                </xs:restriction></xs:simpleType></xs:attribute>
                <xs:attribute name="context-window" type="xs:string"/>
                <xs:attribute name="max-output" type="xs:string"/>
                <xs:attribute name="price-input" type="xs:string"/>
                <xs:attribute name="price-cached-input" type="xs:string"/>
                <xs:attribute name="price-cache-write" type="xs:string"/>
                <xs:attribute name="price-output" type="xs:string"/>
                <xs:attribute name="currency" type="xs:string" default="USD"/>
                <xs:attribute name="tool-mode" default="native"><xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="native"/><xs:enumeration value="json"/>
                </xs:restriction></xs:simpleType></xs:attribute>
                <xs:attribute name="parallel-tool-calls" type="boolean-expandable"/>
                <xs:attribute name="prompt-variant" default="standard"><xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="standard"/><xs:enumeration value="small"/>
                </xs:restriction></xs:simpleType></xs:attribute>
                <xs:attribute name="result-cap-chars" type="xs:string"/>
                <xs:attribute name="screen-size" type="xs:string"><xs:annotation><xs:documentation>Columns x rows, as
                    100x30</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="list-limit" type="xs:string"/>
                <xs:attribute name="catalog-size" type="xs:string"/>
                <xs:attribute name="reasoning-replay" default="last"><xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="none"/><xs:enumeration value="last"/><xs:enumeration value="all"/>
                </xs:restriction></xs:simpleType></xs:attribute>
                <xs:attribute name="temperature" type="xs:string"/>
                <xs:attribute name="max-tool-calls" type="xs:string"/>
                <xs:attribute name="compact-high-percent" type="xs:string"/>
                <xs:attribute name="compact-low-percent" type="xs:string"/>
                <xs:attribute name="max-concurrency" type="xs:string"/>
                <xs:attribute name="intent-prefilter" default="none"><xs:annotation><xs:documentation>hint: a tiny
                    pre-call names the likely intent of a message in its context tail (likely: data); the tools never
                    change</xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="none"/><xs:enumeration value="hint"/>
                </xs:restriction></xs:simpleType></xs:attribute>
                <xs:attribute name="side-calls" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>
                    false: no calls besides a step's own (no intent hint, the deterministic compaction summary, no schema
                    repair call)</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="chars-per-token" type="xs:string"/>
                <xs:attribute name="disabled" type="boolean-expandable" default="false"/>
            </xs:complexType></xs:element>
            <xs:element name="bind" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                <xs:annotation><xs:documentation>The model of a feature: assist, title, summarize, classify, ai-field,
                    embed, or a component's own; fallback is used when that model is disabled or not configured.
                </xs:documentation></xs:annotation>
                <xs:attribute name="feature" type="xs:string" use="required"/>
                <xs:attribute name="model" type="xs:string" use="required"/>
                <xs:attribute name="fallback" type="xs:string"/>
                <xs:attribute name="reasoning" type="xs:string" default="low"/>
            </xs:complexType></xs:element>
            <xs:element name="limits" minOccurs="0"><xs:complexType>
                <xs:attribute name="max-concurrent-runs" type="xs:string" default="8"/>
                <xs:attribute name="run-queue" type="xs:string" default="64"/>
                <xs:attribute name="max-steps" type="xs:string" default="40"/>
                <xs:attribute name="max-run-seconds" type="xs:string" default="900"/>
                <xs:attribute name="user-daily-tokens" type="xs:string" default="2000000"/>
                <xs:attribute name="user-daily-cost" type="xs:string" default="20"/>
                <xs:attribute name="approval-ttl-minutes" type="xs:string" default="30"/>
                <xs:attribute name="lease-seconds" type="xs:string" default="60"/>
                <xs:attribute name="heartbeat-seconds" type="xs:string" default="15"/>
                <xs:attribute name="event-text-flush-ms" type="xs:string" default="300"/>
            </xs:complexType></xs:element>
            <xs:element name="content-log" minOccurs="0"><xs:complexType>
                <xs:annotation><xs:documentation>Keep the request and response of each call in LlmCall. Off by default;
                    with redact the values of secret-looking keys (and of redact-keys, a comma list) and token-shaped
                    strings are replaced. retention-days clears the content of older calls.</xs:documentation></xs:annotation>
                <xs:attribute name="enabled" type="boolean-expandable" default="false"/>
                <xs:attribute name="redact" type="boolean-expandable" default="true"/>
                <xs:attribute name="redact-keys" type="xs:string"/>
                <xs:attribute name="retention-days" type="xs:string" default="14"/>
            </xs:complexType></xs:element>
            <xs:element name="screen-sessions" minOccurs="0"><xs:complexType>
                <xs:attribute name="max" type="xs:string" default="64"/>
                <xs:attribute name="max-per-user" type="xs:string" default="4"/>
                <xs:attribute name="idle-minutes" type="xs:string" default="30"/>
            </xs:complexType></xs:element>
            <xs:element name="data-entity" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                <xs:annotation><xs:documentation>Entities the data tool reads directly, with artifact authorization off,
                    as Java's allowed-basic-entity: package and entity are regular expressions on the package and the
                    entity name (one left out matches any). With none listed the moqui.basic package is readable.
                    readable="false" turns a pattern off. Merged by package and entity. Warning: authorization is
                    off for these reads, so every user of an agent reads every row of a listed entity. Encrypted fields
                    are never read, and fields named like secrets (password, token, secret, credential, salt, a name
                    ending in key) only with secret-fields="true"; any other plaintext secret is readable. List only
                    entities fit for everyone, such as configuration and type data.</xs:documentation></xs:annotation>
                <xs:attribute name="package" type="xs:string"/>
                <xs:attribute name="entity" type="xs:string"/>
                <xs:attribute name="readable" type="boolean-expandable" default="true"/>
                <xs:attribute name="secret-fields" type="boolean-expandable" default="false"/>
            </xs:complexType></xs:element>
            <xs:element name="user-facts" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                <xs:annotation><xs:documentation>A service that adds facts about the user to the prompt of each new
                    conversation (the active organization, say), after the framework's name, locale and time zone: an
                    implementation of org.moqui.agent.AgentServices.get#UserFacts, called as the user with reads only.
                    One that fails is logged and left out. Merged by service.</xs:documentation></xs:annotation>
                <xs:attribute name="service" type="xs:string" use="required"/>
            </xs:complexType></xs:element>
            <xs:element name="ai-task" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                <xs:annotation><xs:documentation>A typed AI task a component adds to the registry of
                    org.moqui.agent.AiTaskServices (beside summarize, classify, extract, translate and generate): the
                    service prepares its call (an implementation of org.moqui.agent.AiTaskServices.prepare#AiTask: in
                    taskType and input, out system, prompt and the JSON schema of the output), and the feature's model
                    runs it. Merged by name.</xs:documentation></xs:annotation>
                <xs:attribute name="name" type="xs:string" use="required"/>
                <xs:attribute name="service" type="xs:string" use="required"/>
                <xs:attribute name="feature" type="xs:string"/>
                <xs:attribute name="description" type="xs:string"/>
            </xs:complexType></xs:element>
            <xs:element name="a2a" minOccurs="0"><xs:complexType>
                <xs:sequence>
                    <xs:element name="push" minOccurs="0"><xs:complexType>
                        <xs:attribute name="allow-http" type="boolean-expandable" default="false"/>
                        <xs:attribute name="allow-hosts" type="xs:string"/>
                        <xs:attribute name="timeout" type="xs:string" default="15"/>
                        <xs:attribute name="max-attempts" type="xs:string" default="6"/>
                    </xs:complexType></xs:element>
                    <xs:element name="security" minOccurs="0"><xs:complexType>
                        <xs:attribute name="api-key" type="boolean-expandable" default="true"/>
                        <xs:attribute name="bearer" type="boolean-expandable" default="true"/>
                        <xs:attribute name="oidc-issuer" type="xs:string"/>
                        <xs:attribute name="oidc-audience" type="xs:string"/>
                    </xs:complexType></xs:element>
                </xs:sequence>
                <xs:attribute name="enabled" type="boolean-expandable" default="false"/>
                <xs:attribute name="public-url" type="xs:string"/>
                <xs:attribute name="default-agent" type="xs:string" default="assist"/>
                <xs:attribute name="blocking-wait" type="xs:string" default="120"/>
                <xs:attribute name="max-part-bytes" type="xs:string" default="65536"/>
                <xs:attribute name="max-parts" type="xs:string" default="32"/>
                <xs:attribute name="trust-forwarded-headers" type="boolean-expandable" default="false"/>
                <xs:attribute name="client-enabled" type="boolean-expandable" default="true">
                    <xs:annotation><xs:documentation>The A2A client: delegate tools (a2a__name) to the remote agents of
                        AgentRemoteA2a rows (docs/A2A.md).</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="client-timeout" type="xs:string" default="300">
                    <xs:annotation><xs:documentation>Seconds a delegation waits for the remote task to end or pause; then
                        it is canceled.</xs:documentation></xs:annotation></xs:attribute>
            </xs:complexType></xs:element>
            <xs:element name="mcp" minOccurs="0"><xs:complexType>
                <xs:attribute name="server-enabled" type="boolean-expandable" default="false"/>
                <xs:attribute name="protocol-version" type="xs:string" default="2026-07-28"/>
                <xs:attribute name="tools-ttl-ms" type="xs:string" default="300000"/>
                <xs:attribute name="call-timeout" type="xs:string" default="60"/>
                <xs:attribute name="client-enabled" type="boolean-expandable" default="true"/>
                <xs:attribute name="max-result-bytes" type="xs:string" default="1000000"/>
                <xs:attribute name="agent" type="xs:string" default="mcp"/>
                <xs:attribute name="public-url" type="xs:string"/>
                <xs:attribute name="trust-forwarded-headers" type="boolean-expandable" default="false"/>
                <xs:attribute name="request-state-key" type="xs:string"/>
                <xs:attribute name="approval-wait" type="xs:string" default="20"/>
                <xs:attribute name="max-direct-tools" type="xs:string" default="40"/>
            </xs:complexType></xs:element>
            <xs:element name="gateway" minOccurs="0"><xs:complexType>
                <xs:annotation><xs:documentation>The OpenAI-compatible gateway at /llm/v1 (docs/Gateway.md), off by
                    default. require-client: only a key or app password an LlmApiClient with the gateway scope names may
                    call. timeout: seconds a call may take. A conf that lists aliases replaces the earlier ones.</xs:documentation></xs:annotation>
                <xs:sequence>
                    <xs:element name="alias" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                        <xs:annotation><xs:documentation>A model name the gateway answers to: the model it calls, or the
                            feature whose binding it follows. An LlmModelAlias row of the same name replaces
                            it.</xs:documentation></xs:annotation>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                        <xs:attribute name="model" type="xs:string"/>
                        <xs:attribute name="feature" type="xs:string"/>
                        <xs:attribute name="description" type="xs:string"/>
                    </xs:complexType></xs:element>
                </xs:sequence>
                <xs:attribute name="enabled" type="boolean-expandable" default="false"/>
                <xs:attribute name="require-client" type="boolean-expandable" default="true"/>
                <xs:attribute name="timeout" type="non-neg-int-expandable" default="300"/>
            </xs:complexType></xs:element>
            <xs:element name="assist" minOccurs="0"><xs:complexType>
                <xs:annotation><xs:documentation>The Assist drawer's composer extras and memory (docs/Assist.md): the
                    files a message may carry (bytes, count and media types, type/* allowed), the audio a dictation
                    sends, whether the browser's speech API may stand in when no model is bound to the transcribe
                    feature (it sends the audio to the browser's vendor, so it is off unless the admin turns it on), the
                    longest text of an inline text action, and whether a user who never chose lets the agent make
                    memories.</xs:documentation></xs:annotation>
                <xs:attribute name="max-attachment-bytes" type="non-neg-int-expandable" default="10485760"/>
                <xs:attribute name="max-attachments" type="non-neg-int-expandable" default="5"/>
                <xs:attribute name="attachment-types" type="xs:string"/>
                <xs:attribute name="max-audio-bytes" type="non-neg-int-expandable" default="10485760"/>
                <xs:attribute name="browser-dictation" type="boolean-expandable" default="false"/>
                <xs:attribute name="max-text-action-chars" type="non-neg-int-expandable" default="8000"/>
                <xs:attribute name="memory-default" type="boolean-expandable" default="true"/>
            </xs:complexType></xs:element>
        </xs:sequence>
        <xs:attribute name="enabled" type="boolean-expandable" default="true"/>
    </xs:complexType></xs:element>

    <!-- ===================== Entity Facade Conf Root ===================== -->
    <xs:element name="entity-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="decrypt-alt" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                    <xs:annotation><xs:documentation>Alternate settings for decryption only; useful for migrating keys, supporting data imported from other systems, etc</xs:documentation></xs:annotation>
                    <xs:attribute name="crypt-pass" type="xs:string"/>
                    <xs:attribute name="crypt-salt" type="xs:string"/>
                    <xs:attribute name="crypt-iter" type="xs:string"/>
                    <xs:attribute name="crypt-algo" type="xs:string"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" ref="server-jndi">
                    <xs:annotation><xs:documentation>If not present the default JNDI server will be used.</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="datasource"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="load-entity"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="load-data"/>
            </xs:sequence>
            <xs:attribute name="entity-eca-enabled" default="true" type="boolean-expandable"/>
            <xs:attribute name="distributed-cache-invalidate" default="false" type="boolean">
                <xs:annotation><xs:documentation>Enable distributed cache invalidate by distributed Topic</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="dci-topic-factory" type="xs:string">
                <xs:annotation><xs:documentation>Topic factory for distributed cache invalidate</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sequenced-id-prefix" type="xs:string"/>
            <xs:attribute name="sql-name-style" type="xs:string">
                <xs:annotation><xs:documentation>Rust only: java (default), or legacy to retain pre-compatibility quoted Rust table and column names. Supports property expansion.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="default-group-name" type="name-plain"/>
            <xs:attribute name="database-time-zone" type="xs:string"/>
            <xs:attribute name="database-locale" type="xs:string"/>
            <xs:attribute name="crypt-pass" type="xs:string"/>
            <xs:attribute name="crypt-salt" type="xs:string"/>
            <xs:attribute name="crypt-iter" type="xs:string"/>
            <xs:attribute name="crypt-algo" type="xs:string"/>
            <xs:attribute name="query-stats" default="false" type="boolean-expandable"/>
            <xs:attribute name="rest-max-page-size" type="non-neg-int-expandable" default="1000"><xs:annotation><xs:documentation>
                The most rows a page of the entity REST API returns. No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <!-- ===================== Server Elements (no Java counterpart) ===================== -->

    <xs:element name="email-client">
        <xs:annotation><xs:documentation>The mail client (org.moqui.impl.EmailClientServices).</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="allowed-hosts" type="xs:string"><xs:annotation><xs:documentation>Comma separated hostnames and IPs poll#EmailServer and send#Email may connect
                to; empty allows any host. smtp.example.com matches example.com; notexample.com does not.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="idle-enabled" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>IMAP IDLE on the Inbox of each active account, so new mail shows at once; false relies on the sync job only.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="idle-max" type="non-neg-int-expandable" default="8"><xs:annotation><xs:documentation>The most IDLE connections (a thread each) in a server.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sync-interval" type="non-neg-int-expandable" default="5"><xs:annotation><xs:documentation>Minutes between syncs of an account with no syncIntervalMinutes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sync-batch" type="non-neg-int-expandable" default="500"><xs:annotation><xs:documentation>The most new messages a folder brings in one sync.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="flag-scan" type="non-neg-int-expandable" default="15"><xs:annotation><xs:documentation>Minutes between reading every message's flags, on a server without CONDSTORE.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sync-push-now" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>Make a local change on the server right after it commits; false waits for the next sync.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="autoconfig-urls" type="xs:string"><xs:annotation><xs:documentation>discover#EmailServer's Thunderbird autoconfig URLs, comma separated, with
                {domain} and {email}; empty for autoconfig.{domain}, the domain's .well-known URL and the Thunderbird ISPDB.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="dns-server" type="xs:string"><xs:annotation><xs:documentation>The DNS server (host:port) for discover#EmailServer's SRV lookups; empty for the first in /etc/resolv.conf.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="tls-ca-file" type="xs:string"><xs:annotation><xs:documentation>A PEM file of more certificate authorities to trust, for a mail server with its own.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="oauth-redirect-uri" type="xs:string"><xs:annotation><xs:documentation>The callback the OAuth provider sends the browser back to, exactly as
                registered there; empty for the webroot webapp's URL and /emailOAuth/callback.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="ssh-server">
        <xs:annotation><xs:documentation>The built-in SSH server: the terminal client, SFTP, git and the admin shell.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="port" type="xs:string"><xs:annotation><xs:documentation>The port to bind; empty leaves the server off, 0 binds an ephemeral port.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="host" type="xs:string" default="127.0.0.1"><xs:annotation><xs:documentation>The address to bind.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="host-key" type="xs:string"><xs:annotation><xs:documentation>The base64 of a 32-byte Ed25519 seed, or an OpenSSH private key.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="public-host" type="xs:string"><xs:annotation><xs:documentation>The SSH host git clone URLs show; the webapp host when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="public-port" type="xs:string"><xs:annotation><xs:documentation>The SSH port git clone URLs show; port when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sftp-root" type="xs:string" default="runtime://sftp"><xs:annotation><xs:documentation>The resource location SFTP serves (runtime, file, component or dbresource).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sftp-max-file" type="non-neg-int-expandable" default="268435456"><xs:annotation><xs:documentation>The largest file SFTP takes, in bytes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-sessions" type="non-neg-int-expandable" default="8"><xs:annotation><xs:documentation>The most connections at once.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="git-password-auth" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Git over SSH on a connection that logged in by password; by key only when false.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="login-dialog" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>A client with no key is let in with no user and gets the terminal client's
                login dialog; when false, such a client logs in by password at the SSH level or not at all.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="terminal">
        <xs:annotation><xs:documentation>The terminal client's sessions, over SSH and in the browser together.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="max-sessions" type="non-neg-int-expandable" default="16"><xs:annotation><xs:documentation>The most sessions at once.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-sessions-per-user" type="non-neg-int-expandable" default="4"><xs:annotation><xs:documentation>The most sessions of one user; a session in its login dialog counts toward max-sessions only.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="git-server">
        <xs:annotation><xs:documentation>The git server, over smart HTTP and SSH, and the storage of db kind
            repositories (docs/Git-Hosting.md).</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="public-url" type="xs:string"><xs:annotation><xs:documentation>The base URL clone URLs show; from the webapp host and port when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="lfs-token-key" type="xs:string"><xs:annotation><xs:documentation>The key Git LFS action tokens are signed with.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="lfs-token-key-previous" type="xs:string"><xs:annotation><xs:documentation>A key that still reads while lfs-token-key is changed.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-concurrent" type="non-neg-int-expandable" default="4"><xs:annotation><xs:documentation>Clones and pushes that run at once, on threads of their own.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-queued" type="non-neg-int-expandable" default="16"><xs:annotation><xs:documentation>Clones and pushes that wait for one of those threads.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-request" type="non-neg-int-expandable" default="67108864"><xs:annotation><xs:documentation>Bytes of an upload-pack request.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-push-size" type="non-neg-int-expandable" default="2147483648"><xs:annotation><xs:documentation>Bytes of a push.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-object-size" type="non-neg-int-expandable" default="536870912"><xs:annotation><xs:documentation>Bytes of one pushed object.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="idle-timeout" type="non-neg-int-expandable" default="120"><xs:annotation><xs:documentation>Seconds of silence in a request body that end it.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="pack-threads" type="xs:string"><xs:annotation><xs:documentation>Threads that compress and index packs; all cores when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="allow-http" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Take credentials over plain HTTP.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="lfs-max-object-size" type="non-neg-int-expandable" default="5368709120"><xs:annotation><xs:documentation>The largest Git LFS object, in bytes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="eca-max-commits" type="non-neg-int-expandable" default="10000"><xs:annotation><xs:documentation>The most commits one change raises gitECA commit events for.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="webhook-private-network" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Deliver repository webhooks to loopback, private and link-local addresses too (a CI server on the same network). Off by default: a webhook URL is a user's.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="db-delta-depth" type="non-neg-int-expandable" default="50"><xs:annotation><xs:documentation>Deltas at most from an object to a whole one.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="db-delta-max-size" type="non-neg-int-expandable" default="16777216"><xs:annotation><xs:documentation>Objects up to this many bytes may be stored as deltas.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="db-large-object" type="non-neg-int-expandable" default="8388608"><xs:annotation><xs:documentation>An object over this many bytes is a content blob, read and sent a window at a time.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="db-write-format" type="xs:string" default="v2"><xs:annotation><xs:documentation>raw writes new rows uncompressed, as versions before this format read them.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="db-cache-bytes" type="non-neg-int-expandable" default="67108864"><xs:annotation><xs:documentation>Bytes of decoded objects kept in memory for all repositories.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="gc-prune-days" type="non-neg-int-expandable" default="14"><xs:annotation><xs:documentation>gc#GitRepositories deletes unreachable objects not written or referenced in this many days (at least 1).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="gc-reflog-days" type="non-neg-int-expandable" default="30"><xs:annotation><xs:documentation>gc#GitRepositories keeps the commits of this many days of changes, so a force push can be undone.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="gc-max-objects" type="non-neg-int-expandable" default="20000000"><xs:annotation><xs:documentation>gc#GitRepositories passes over a repository of more objects than this.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="dav-server">
        <xs:annotation><xs:documentation>The DAV server at /dav: WebDAV over drives, and CalDAV and CardDAV over the
            calendars and address books of the adapter services named here (docs/Sync.md). Devices log in with app
            passwords.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="enabled" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>Serve /dav; when false it answers 404.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="public-url" type="xs:string"><xs:annotation><xs:documentation>The base URL the Sync settings show devices; from the webapp host and port when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="calendar-services" type="xs:string"><xs:annotation><xs:documentation>The service class of the CalDAV adapter (get#DavCollections, get#DavObjects,
                put#DavObject, delete#DavObject); no CalDAV when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="contact-services" type="xs:string"><xs:annotation><xs:documentation>The service class of the CardDAV adapter; no CardDAV when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="account-password" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Take the account password too, for an account with no second factor; app passwords only when false.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="allow-http" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Take credentials over plain HTTP.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-file" type="non-neg-int-expandable" default="268435456"><xs:annotation><xs:documentation>The largest request body, so the largest file a PUT writes, in bytes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sftp-drives" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>A user without the SSH_SFTP permission who logs in to the SSH server
                with an app password or a key gets SFTP to the drives they may open, one folder each.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="smtp-server">
        <xs:annotation><xs:documentation>The inbound SMTP listener for hosted and shared mail accounts, behind the edge
            gateway (docs/Mail-Inbound.md).</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="listen-port" type="xs:string"><xs:annotation><xs:documentation>The port to bind; empty leaves the listener off, 0 binds an ephemeral port.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="listen-host" type="xs:string" default="127.0.0.1"><xs:annotation><xs:documentation>The address to bind.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="allowed-addresses" type="xs:string"><xs:annotation><xs:documentation>The gateway's IPs and CIDRs, comma separated; an empty list does not start the listener.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="hostname" type="xs:string"><xs:annotation><xs:documentation>The name in the greeting and the Received field; the webapp host when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="authserv-id" type="xs:string"><xs:annotation><xs:documentation>The authserv-id of the gateway's Authentication-Results; only those are kept.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="proxy-protocol" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Each connection starts with a PROXY v1 or v2 header, whose address must be allowed too.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="spam-headers" type="xs:string" default="X-Spam-Flag,X-Spam-Status,X-Spam"><xs:annotation><xs:documentation>The gateway's spam verdict fields; mail one of them says yes to goes to Junk.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="plus-separator" type="xs:string" default="+"><xs:annotation><xs:documentation>The plus-addressing characters (sales+news@ is sales@); none turns it off.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-message-size" type="non-neg-int-expandable" default="26214400"><xs:annotation><xs:documentation>The largest message, in bytes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-recipients" type="non-neg-int-expandable" default="100"><xs:annotation><xs:documentation>The most recipients of one message.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-connections" type="non-neg-int-expandable" default="20"><xs:annotation><xs:documentation>The most connections at once.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="command-timeout" type="non-neg-int-expandable" default="300"><xs:annotation><xs:documentation>Seconds for each command or data chunk.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="session-timeout" type="non-neg-int-expandable" default="1800"><xs:annotation><xs:documentation>Seconds for a whole session.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="protocol" default="smtp"><xs:annotation><xs:documentation>smtp, or lmtp (RFC 2033): LHLO, and a reply per recipient after the data.</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="smtp"/><xs:enumeration value="lmtp"/></xs:restriction></xs:simpleType></xs:attribute>
            <xs:attribute name="starttls" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Offer STARTTLS (RFC 3207). With no certificate the listener does not start.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="require-tls" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Refuse MAIL before STARTTLS (530); needs starttls.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="tls-cert-file" type="xs:string"><xs:annotation><xs:documentation>The certificate (and chain) PEM file of STARTTLS, absolute or under the runtime directory; empty for runtime/cert by the name asked for or hostname.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="tls-key-file" type="xs:string"><xs:annotation><xs:documentation>The private key PEM file that goes with tls-cert-file.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="chunking" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>CHUNKING (RFC 3030): BDAT.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="dsn" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>DSN (RFC 3461): RET, ENVID, NOTIFY and ORCPT are taken and kept, and NOTIFY=SUCCESS gets a "delivered" report.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="logging">
        <xs:annotation><xs:documentation>The log files moqui.log (all events) and moqui-error.log (warn and error).
            The stderr level and color are the properties moqui_log_level and moqui_log_color, read before the conf.
        </xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="dir" type="xs:string" default="runtime://log"><xs:annotation><xs:documentation>A path or runtime:// location; empty writes no files.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-size-mb" type="non-neg-int-expandable" default="100"><xs:annotation><xs:documentation>A file rolls over to moqui.yyyy-MM-dd.N.log (UTC) at this size or when the day changes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-files" type="non-neg-int-expandable" default="30"><xs:annotation><xs:documentation>Only this many of the newest rolled files of each kind are kept.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="datasource">
        <xs:complexType>
            <xs:sequence>
                <xs:choice minOccurs="1" maxOccurs="1">
                    <xs:element minOccurs="0" maxOccurs="1" ref="jndi-jdbc"/>
                    <xs:element minOccurs="0" maxOccurs="1" ref="inline-jdbc"/>
                    <xs:element minOccurs="0" maxOccurs="1" ref="inline-other"/>
                </xs:choice>
            </xs:sequence>
            <xs:attribute name="group-name" type="name-segmented" use="required"/>
            <xs:attribute name="database-conf-name" type="xs:string">
                <xs:annotation><xs:documentation>This is only required for JDBC/SQL datasources.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="schema-name" type="xs:string"/>
            <xs:attribute name="startup-add-missing" default="false" type="boolean-expandable"/>
            <xs:attribute name="runtime-add-missing" default="true" type="boolean-expandable"/>
            <xs:attribute name="runtime-add-fks" default="true" type="boolean-expandable"/>
            <xs:attribute name="object-factory" type="xs:string" default="org.moqui.impl.entity.EntityDatasourceFactoryImpl">
                <xs:annotation><xs:documentation>The references class must implement the
                    org.moqui.entity.EntityDatasourceFactory interface.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="sequence-primary-use-uuid" type="boolean-expandable" default="false">
                <xs:annotation><xs:documentation>Uses java.util.UUID.randomUUID() to get sequenced IDs for all entities in this datasource.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="start-server-args" type="xs:string">
                <xs:annotation><xs:documentation>Currently only for the H2 database. Start a remote access server for
                    the embedded DB using these arguments. See the main() method at
                    http://www.h2database.com/javadoc/org/h2/tools/Server.html for details.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="disabled" default="false" type="boolean-expandable"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="inline-jdbc">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="1" ref="xa-properties"/>
            </xs:sequence>
            <xs:attribute name="jdbc-uri" type="xs:string" use="optional"/>
            <xs:attribute name="jdbc-username" type="xs:string" use="optional"/>
            <xs:attribute name="jdbc-password" type="xs:string" use="optional"/>
            <xs:attribute name="jdbc-driver" type="xs:string" use="optional"/>
            <xs:attribute name="xa-ds-class" type="xs:string" use="optional"/>
            <xs:attribute name="isolation-level" type="isolation-level"/>
            <xs:attribute name="pool-maxsize" type="xs:nonNegativeInteger" default="50"/>
            <xs:attribute name="pool-minsize" type="xs:nonNegativeInteger" default="5"/>
            <xs:attribute name="pool-reserve" type="xs:nonNegativeInteger" default="8">
                <xs:annotation><xs:documentation>Connections inside pool-maxsize that only the framework's own short
                    work takes (sequence banks, sessions, login, hits, job and semaphore records, cluster membership),
                    so a full pool cannot block it.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="pool-time-idle" type="xs:nonNegativeInteger">
                <xs:annotation><xs:documentation>Maximum time in seconds that unused excess connections should stay in
                    the pool. Defaults to 60 seconds.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="pool-time-reap" type="xs:nonNegativeInteger">
                <xs:annotation><xs:documentation>Time in seconds that the connection pool will allow a connection to be
                    in use, before claiming it back. Defaults to no limit.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="pool-time-maint" type="xs:nonNegativeInteger">
                <xs:annotation><xs:documentation>Running interval in seconds for the pool maintenance thread.
                    Defaults to 60 seconds.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="pool-time-wait" type="xs:nonNegativeInteger">
                <xs:annotation><xs:documentation>Sets the maximum amount of time in seconds the pool will block
                    waiting for a connection to become available in the pool when it is empty. Defaults to 30 seconds.
                    Zero means no waiting.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="pool-test-query" type="xs:string"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="jndi-jdbc">
        <xs:complexType>
            <xs:attribute name="jndi-name" type="xs:string" use="required"/>
            <xs:attribute name="isolation-level" type="isolation-level"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="xa-properties">
        <xs:complexType><xs:anyAttribute processContents="skip"/></xs:complexType>
    </xs:element>
    <xs:element name="inline-other">
        <xs:complexType><xs:anyAttribute processContents="skip"/></xs:complexType>
    </xs:element>
    <xs:element name="load-entity">
        <xs:annotation><xs:documentation>Most resources should be loaded by directory convention (convention over
            configuration) within a component so this should only be used rarely. Sometimes that is not possible such
            as remote locations or on a classpath that is inside a war or ear file, or that is from a special
            ClassLoader.</xs:documentation></xs:annotation>
        <xs:complexType><xs:attribute name="location" type="xs:string" use="required"/></xs:complexType>
    </xs:element>
    <xs:element name="load-data">
        <xs:annotation><xs:documentation>Most resources should be loaded by directory convention (convention over
            configuration) within a component so this should only be used rarely. Sometimes that is not possible such
            as remote locations or on a classpath that is inside a war or ear file, or that is from a special
            ClassLoader.</xs:documentation></xs:annotation>
        <xs:complexType><xs:attribute name="location" type="xs:string" use="required"/></xs:complexType>
    </xs:element>

    <!-- ====================== Database Conf Root ======================= -->
    <xs:element name="database-list">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="dictionary-type"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="database"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="database">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="database-type"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="name-replace"><xs:complexType>
                    <xs:attribute name="original" type="name-plain" use="required"/>
                    <xs:attribute name="replace" type="name-plain" use="required"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="1" ref="inline-jdbc"/>
            </xs:sequence>

            <xs:attribute name="name" type="name-plain" use="required"/>
            <xs:attribute name="lb-name" type="name-plain"><xs:annotation>
                <xs:documentation>Name of the database for Liquibase, defaults to name attribute, see http://www.liquibase.org/databases.html</xs:documentation></xs:annotation></xs:attribute>

            <!-- TODO use in code -->
            <xs:attribute name="use-schemas" default="true" type="boolean"/>
            <xs:attribute name="use-pk-constraint-names" default="true" type="boolean"/>
            <xs:attribute name="constraint-name-clip-length" default="30" type="xs:nonNegativeInteger"/>
            <!-- TODO use in code -->
            <xs:attribute name="result-fetch-size" default="-1" type="xs:integer"/>
            <xs:attribute name="use-foreign-keys" default="true" type="boolean"/>
            <xs:attribute name="use-foreign-key-indexes" default="true" type="boolean"/>
            <xs:attribute name="fk-style" default="name_constraint">
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="name_constraint"/>
                        <xs:enumeration value="name_fk"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="use-fk-initially-deferred" default="false" type="boolean"/>
            <xs:attribute name="use-indexes" default="true" type="boolean">
                <xs:annotation><xs:documentation>Use manually declared indexes?</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="use-indexes-unique" default="true" type="boolean">
                <xs:annotation><xs:documentation>For manually declared indexes (if used), use the unique constraint?</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="use-indexes-unique-where-not-null" default="false" type="boolean">
                <xs:annotation><xs:documentation>For manually declared indexes (if used), unique constraints should disregard null values?</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="join-style" default="ansi">
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="ansi"/>
                    <xs:enumeration value="ansi-no-parenthesis"/>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="fts-style" default="none">
                <xs:annotation><xs:documentation>
                    How LIKE / NOT LIKE on a text-fts field is evaluated. none keeps SQL LIKE.
                    h2-native, postgres-tsvector, mysql-fulltext, mssql-contains, and oracle-text use that
                    database's full-text index. A missing index falls back to SQL LIKE.
                </xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="h2-native"/>
                    <xs:enumeration value="postgres-tsvector"/>
                    <xs:enumeration value="mysql-fulltext"/>
                    <xs:enumeration value="mssql-contains"/>
                    <xs:enumeration value="oracle-text"/>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="fts-ddl" default="true" type="xs:boolean">
                <xs:annotation><xs:documentation>
                    When false Moqui does not create the generated tsvector column, GIN or FULLTEXT index for text-fts fields.
                    Use it when a DBA manages them, because on PostgreSQL adding the stored column rewrites the table.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="fts-config" default="english" type="xs:token">
                <xs:annotation><xs:documentation>
                    Postgres text search configuration passed to to_tsvector / plainto_tsquery. Other fts-style values ignore it.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="offset-style" default="fetch">
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="fetch"><xs:annotation>
                        <xs:documentation>Use the SQL:2008 syntax (OFFSET ? ROWS FETCH FIRST ? ROWS ONLY)</xs:documentation>
                    </xs:annotation></xs:enumeration>
                    <xs:enumeration value="limit"><xs:annotation>
                        <xs:documentation>Use the basic limit/offset syntax (LIMIT ? OFFSET ?)</xs:documentation>
                    </xs:annotation></xs:enumeration>
                    <xs:enumeration value="cursor"><xs:annotation>
                        <xs:documentation>Don't use an SQL syntax, use a database cursor through the
                            EntityListIterator.getPartialList() method. Note that there may be different behavior when
                            calling EntityFind.iterator() as it only seeks to the offset but doesn't restrict by the
                            limit.</xs:documentation>
                    </xs:annotation></xs:enumeration>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="from-lateral-style" default="none">
                <xs:annotation><xs:documentation>
                    The SQL style for correlated sub-selects for joins in a FROM clause for sub-select=true; setting this to 'none'
                    results in the same SQL that would be generated for sub-select=non-lateral</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="lateral"><xs:annotation>
                        <xs:documentation>Use the SQL:1999 syntax ([INNER|OUTER LEFT] JOIN LATERAL)</xs:documentation>
                    </xs:annotation></xs:enumeration>
                    <xs:enumeration value="apply"><xs:annotation>
                        <xs:documentation>Use the apply syntax (CROSS APPLY or OUTER APPLY for join-optional=true)</xs:documentation>
                    </xs:annotation></xs:enumeration>
                    <xs:enumeration value="none"><xs:annotation>
                        <xs:documentation>No sort of lateral join supported, use non-correlated sub-selects</xs:documentation>
                    </xs:annotation></xs:enumeration>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="add-unique-as" default="false" type="boolean"/>
            <xs:attribute name="always-use-constraint-keyword" default="false" type="boolean"/>
            <xs:attribute name="use-schema-for-all" default="false" type="boolean">
                <xs:annotation><xs:documentation>Set to true to include the schema name for primary keys, foreign keys, and indexes.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="never-nulls" default="false" type="boolean">
                <xs:annotation><xs:documentation>Never use NULLS FIRST/LAST in ORDER BY clause</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="never-try-insert" default="false" type="boolean">
                <xs:annotation><xs:documentation>Never use try insert feature when storing a record</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="use-binary-type-for-blob" default="false" type="boolean"/>
            <xs:attribute name="table-engine" type="xs:string"/>
            <xs:attribute name="character-set" type="xs:string"/>
            <xs:attribute name="collate" type="xs:string"/>
            <xs:attribute name="default-isolation-level">
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="None"/>
                    <xs:enumeration value="ReadCommitted"/>
                    <xs:enumeration value="ReadUncommitted"/>
                    <xs:enumeration value="RepeatableRead"/>
                    <xs:enumeration value="Serializable"/>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="for-update" type="xs:string" default="FOR UPDATE"/>
            <xs:attribute name="use-tm-join" default="true" type="boolean">
                <xs:annotation><xs:documentation>For Bitronix set this to false to not use tm join (for Atomikos this is
                set in the serial_jta_transactions property in jta.properties)</xs:documentation></xs:annotation></xs:attribute>

            <!-- Defaults for inline-jdbc element -->
            <xs:attribute name="default-jdbc-driver" type="xs:string"/>
            <xs:attribute name="default-xa-ds-class" type="xs:string"/>
            <xs:attribute name="default-test-query" type="xs:string"/>

            <!-- Defaults for datasource element -->
            <xs:attribute name="default-startup-add-missing" type="boolean"/>
            <xs:attribute name="default-runtime-add-missing" type="boolean"/>
            <xs:attribute name="default-runtime-add-fks" type="boolean"/>
            <xs:attribute name="default-start-server-args" type="xs:string"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="dictionary-type">
        <xs:complexType>
            <xs:attribute name="type" type="xs:string" use="required"/>
            <xs:attribute name="java-type" type="xs:string" use="required"/>
            <xs:attribute name="default-sql-type" type="xs:string"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="database-type">
        <xs:complexType>
            <xs:attribute name="type" type="xs:string" use="required"/>
            <xs:attribute name="sql-type" type="xs:string" use="required"/>
            <xs:attribute name="sql-type-alias" type="xs:string"/>
            <xs:attribute name="java-type" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <!-- ================== Repository (JCR) Conf Root ==================== -->
    <xs:element name="repository-list">
        <xs:complexType><xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" ref="repository"/></xs:sequence></xs:complexType>
    </xs:element>
    <xs:element name="repository">
        <xs:annotation><xs:documentation>Configuration for a javax.jcr.Repository retrieved through a
            javax.jcr.RepositoryFactory using parameter sub-elements (with name and value attributes), and a
            javax.jcr.Session using the workspace, username, and password attributes.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="init-param" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="workspace" type="xs:string">
                <xs:annotation><xs:documentation>Defaults to the repository's default workspace.</xs:documentation></xs:annotation>
            </xs:attribute>

            <xs:attribute name="username" type="xs:string"/>
            <xs:attribute name="password" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <!-- ================= Additional Component Locations ================= -->
    <xs:element name="component-list">
        <xs:annotation><xs:documentation>Use this to specify components to load in addition to those in the
            runtime/component directory. This is useful for components in JCR repositories or wherever.
            The location needs to use a Resource Facade protocol/schema that supports looking at sub-directories, etc
            (like content:, file:, etc).</xs:documentation></xs:annotation>
        <xs:complexType><xs:sequence>
            <xs:choice maxOccurs="unbounded">
                <xs:element ref="component-dir"/>
                <xs:element ref="component"/>
            </xs:choice>
        </xs:sequence></xs:complexType>
    </xs:element>
    <xs:element name="component-dir">
        <xs:complexType>
            <xs:attribute name="location" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="component">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="depends-on" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" use="optional"/>
            <xs:attribute name="location" type="xs:string" use="optional"><xs:annotation><xs:documentation>
                Required when under component-list (in Moqui Conf XML file or a components.xml file), optional
                when component element is in a component.xml file within a component.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="version" type="xs:string" use="optional"/>
            <xs:attribute name="disabled" type="xs:string" use="optional"><xs:annotation><xs:documentation>
                In a component.xml file: when this expands to true the component is not loaded when a component-dir
                is scanned. A component element under component-list that names the component still loads it. The
                value can use a property, such as ${my_component_disabled ?: 'true'}, so a -D option or environment
                variable can turn it on for a run.
            </xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="depends-on">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="version" type="xs:string" use="optional"/>
        </xs:complexType>
    </xs:element>
</xs:schema>
