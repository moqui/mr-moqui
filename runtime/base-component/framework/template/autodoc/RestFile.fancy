<#-- A REST API file's doc (plans/archive/Autodoc.md): its resource tree and methods. The names: the doc's header, rest and
     diagrams; md is AutodocLib.js. -->
<#assign md = ec.resource.script("component://framework/template/autodoc/AutodocLib.js")>
# ${md.plain(rest.displayName || title)}

${md.nav(up, rootHref)}

- **REST API:** ${md.code(rest.path)}<#if rest.version> · **Version:** ${md.plain(rest.version)}</#if>
- **Defined in:** ${md.defined(component, name, "")}

${description}
<#if diagrams.tree>
## Resources

${md.mermaid(diagrams.tree)}
</#if>
## Methods

${md.table(["Resource", "Method", "Calls", "Description"], rest.resources.flatMap((resource) => resource.methods.map((method) =>
    [md.code(resource.path), md.plain(method.method), method.target ? md.plain(method.targetKind) + " " + md.codeLink(method.target, method.href) + (method.operation ? " " + md.plain(method.operation) : "") : "", resource.description || ""])))}
