<#-- A service directory's page (plans/Autodoc.md): its service files and a class diagram of them. The names: the
     doc's header, files and diagrams; md is AutodocLib.js. -->
<#assign md = ec.resource.script("component://framework/template/autodoc/AutodocLib.js")>
# Services in ${md.code(packageName)}

${md.nav(up, rootHref)}

## Service files

${md.table(["File", "Services", "Component"], files.map((file) => [md.link(file.title, file.href), String(file.serviceCount), md.plain(file.component)]))}
<#if diagrams.classes>
## Files, services and interfaces

${md.mermaid(diagrams.classes)}
</#if>
