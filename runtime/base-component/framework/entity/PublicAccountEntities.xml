<?xml version="1.0" encoding="UTF-8"?>
<!-- Framework identity state; contains no Mantle/site business records. CC0 plus patent grant. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
  <entity entity-name="VerifiedAddress" package="moqui.security.public">
    <field name="userId" type="id" is-pk="true"/>
    <field name="emailAddress" type="text-medium" is-pk="true"/>
    <field name="verifiedAt" type="date-time"/>
    <relationship type="one" related="moqui.security.UserAccount"/>
  </entity>
  <entity entity-name="RegistrationChallenge" package="moqui.security.public">
    <field name="challengeId" type="id" is-pk="true"/>
    <field name="userId" type="id"/>
    <field name="tokenHash" type="text-medium"/>
    <field name="emailAddress" type="text-medium"/>
    <field name="expiresAt" type="date-time"/>
    <field name="consumedAt" type="date-time"/>
    <field name="newAccount" type="text-indicator"/>
    <index name="PUBLIC_REG_HASH" unique="true">
      <index-field name="tokenHash"/>
    </index>
    <relationship type="one" related="moqui.security.UserAccount"/>
  </entity>
  <entity entity-name="DelegatedSession" package="moqui.security.public">
    <field name="delegationId" type="id" is-pk="true"/>
    <field name="userId" type="id"/>
    <field name="visitId" type="id"/>
    <field name="accountStamp" type="text-medium"/>
    <field name="clientId" type="id"/>
    <field name="siteId" type="id"/>
    <field name="tokenHash" type="text-medium"/>
    <field name="expiresAt" type="date-time"/>
    <field name="revokedAt" type="date-time"/>
    <index name="PUBLIC_DELEGATE_HASH" unique="true">
      <index-field name="tokenHash"/>
    </index>
    <relationship type="one" related="moqui.security.UserAccount"/>
  </entity>
  <entity entity-name="SsoHandoff" package="moqui.security.public">
    <field name="handoffId" type="id" is-pk="true"/>
    <field name="clientId" type="id"/>
    <field name="siteId" type="id"/>
    <field name="authFlowId" type="id"/>
    <field name="callbackUri" type="text-long"/>
    <field name="state" type="text-medium"/>
    <field name="verifierHash" type="text-medium"/>
    <field name="expiresAt" type="date-time"/>
    <field name="userId" type="id"/>
    <field name="codeHash" type="text-medium"/>
    <field name="codeExpiresAt" type="date-time"/>
    <field name="consumedAt" type="date-time"/>
    <relationship type="one" related="moqui.security.UserAccount"/>
  </entity>
  <entity entity-name="AccountAttempt" package="moqui.security.public">
    <field name="bucketId" type="id-long" is-pk="true"/>
    <field name="attemptCount" type="number-integer"/>
    <field name="expiresAt" type="date-time"/>
    <index name="PUBLIC_ATTEMPT_EXPIRY">
      <index-field name="expiresAt"/>
    </index>
  </entity>
</entities>
