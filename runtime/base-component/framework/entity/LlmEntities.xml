<!-- Model providers, usage and quotas (plans/LLM-A2A-Assist.md sections 4.2, 5 and 6; crates/moqui-core/src/llm). No data
    compatibility with the Java prototype. Endpoints, models and feature bindings come from the llm-facade conf and from
    these rows: a row overrides the conf entry with the same id (llm/registry.rs). The agents, conversations and runs that
    use them are moqui.agent (AgentEntities.xml).

    The configuration entities are cached; LlmCall and LlmUsageDaily are bookkeeping written even in a sim
    (SIM_PRODUCTION_ENTITIES in entity/cache.rs). -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="LlmEndpoint" package="moqui.llm" use="configuration" cache="true">
        <description>A model server: its protocol (chat-completions, responses, anthropic-messages or fake), base URL and
            path, and how to authenticate. The key is apiKey (encrypted); a property or environment variable can name it only
            in the conf (api-key-env). A row whose baseUrl moves the endpoint to another host does not send the conf's
            key: it needs its own. An endpoint URL is admin configuration and may be local (LM Studio, llama.cpp, Ollama);
            allowPrivateNetwork is for the private addresses that are not loopback. isLocal marks an endpoint whose data
            stays on the site, for agents limited to local endpoints.</description>
        <field name="endpointId" type="id" is-pk="true"/>
        <field name="description" type="text-medium"/>
        <field name="protocol" type="text-short"><description>chat-completions, responses, anthropic-messages or fake</description></field>
        <field name="baseUrl" type="text-medium"/>
        <field name="path" type="text-medium"><description>Empty is the protocol's own (/v1/chat/completions,
            /v1/responses, /v1/messages)</description></field>
        <field name="authHeader" type="text-short"><description>Empty is the protocol's own (Authorization, x-api-key for
            anthropic-messages)</description></field>
        <field name="authScheme" type="text-short"><description>The prefix of the key in the auth header, as Bearer; empty
            is the protocol's own</description></field>
        <field name="apiKey" type="text-medium" encrypt="true"/>
        <field name="headersJson" type="text-long"><description>More request headers, a JSON object of name to value</description></field>
        <field name="connectTimeout" type="number-integer"><description>Seconds; empty is 10</description></field>
        <field name="idleTimeout" type="number-integer"><description>Seconds without a byte of the response before the
            call fails as retryable; empty is 120</description></field>
        <field name="maxConcurrent" type="number-integer"><description>Calls at once on this endpoint from this server;
            empty is no limit. A local server that evicts its slots under parallel requests wants 1.</description></field>
        <field name="allowPrivateNetwork" type="text-indicator"/>
        <field name="isLocal" type="text-indicator"/>
        <field name="disabled" type="text-indicator"/>
        <field name="lastUpdatedByUserId" type="id"/>
        <relationship type="many" related="moqui.llm.LlmModel" short-alias="models">
            <key-map field-name="endpointId"/></relationship>
    </entity>

    <entity entity-name="LlmModel" package="moqui.llm" use="configuration" cache="true">
        <description>A model on an endpoint: providerModel is the name the provider knows it by. The prices are per million
            tokens in currencyUomId; cached input and cache writes cost the input price when theirs are empty. reasoningJson
            has a JSON patch per reasoning level ({"low": {...}, "medium": {...}}), deep-merged onto the request body;
            apiConfigJson is a patch applied to every request first. The behavior fields are for small models
            (plan 7.9); empty is the default the conf gives, then the framework's. charsPerToken is calibrated from usage.</description>
        <field name="modelId" type="id" is-pk="true"/>
        <field name="endpointId" type="id"/>
        <field name="providerModel" type="text-medium"/>
        <field name="description" type="text-medium"/>
        <field name="tier" type="text-short"><description>fast, balanced or thorough</description></field>
        <field name="contextWindow" type="number-integer"/>
        <field name="maxOutput" type="number-integer"/>
        <field name="priceInput" type="currency-precise"/>
        <field name="priceCachedInput" type="currency-precise"/>
        <field name="priceCacheWrite" type="currency-precise"/>
        <field name="priceOutput" type="currency-precise"/>
        <field name="currencyUomId" type="id"/>
        <field name="reasoningJson" type="text-long"/>
        <field name="apiConfigJson" type="text-long"/>
        <field name="toolMode" type="text-short"><description>native or json</description></field>
        <field name="parallelToolCalls" type="text-indicator"/>
        <field name="promptVariant" type="text-short"><description>standard or small</description></field>
        <field name="resultCapChars" type="number-integer"/>
        <field name="screenSize" type="text-short"><description>Columns x rows of a headless screen session, as 100x30</description></field>
        <field name="listLimit" type="number-integer"/>
        <field name="catalogSize" type="number-integer"/>
        <field name="reasoningReplay" type="text-short"><description>none, last or all</description></field>
        <field name="temperature" type="number-decimal"/>
        <field name="maxToolCalls" type="number-integer"/>
        <field name="compactHighPercent" type="number-integer"/>
        <field name="compactLowPercent" type="number-integer"/>
        <field name="maxConcurrency" type="number-integer"/>
        <field name="intentPrefilter" type="text-short"><description>none or hint</description></field>
        <field name="sideCalls" type="text-indicator"><description>N: no calls besides a step's own (no intent hint, the
            deterministic compaction summary, no schema repair); the agent evaluation's replay model</description></field>
        <field name="charsPerToken" type="number-decimal"/>
        <field name="disabled" type="text-indicator"/>
        <field name="lastUpdatedByUserId" type="id"/>
        <relationship type="one-nofk" related="moqui.llm.LlmEndpoint" short-alias="endpoint"/>
        <relationship type="one-nofk" title="Currency" related="moqui.basic.Uom" short-alias="currency">
            <key-map field-name="currencyUomId" related="uomId"/></relationship>
        <relationship type="many" related="moqui.llm.LlmModelCapability" short-alias="capabilities">
            <key-map field-name="modelId"/></relationship>
    </entity>

    <entity entity-name="LlmModelCapability" package="moqui.llm" use="configuration" cache="true">
        <description>What a model can do: tools, parallel-tools, json-schema, streaming, reasoning-replay, prompt-caching.
            verdict is yes, no or partial; source is probe (probe#Model, with the request and answer as evidence), registry
            or admin. An admin's verdict is never replaced by a probe.</description>
        <field name="modelId" type="id" is-pk="true"/>
        <field name="capability" type="text-short" is-pk="true"/>
        <field name="verdict" type="text-short"/>
        <field name="source" type="text-short"/>
        <field name="probeDate" type="date-time"/>
        <field name="evidence" type="text-very-long"/>
        <relationship type="one-nofk" related="moqui.llm.LlmModel" short-alias="model"/>
    </entity>

    <entity entity-name="LlmFeatureBinding" package="moqui.llm" use="configuration" cache="true">
        <description>The model a feature uses (assist, title, summarize, classify, ai-field, embed, or a component's own),
            the model to fall back to when that one is disabled or not configured, and the reasoning level.</description>
        <field name="featureId" type="id" is-pk="true"/>
        <field name="modelId" type="id"/>
        <field name="fallbackModelId" type="id"/>
        <field name="reasoningLevel" type="text-short"><description>none, low, medium, high or max</description></field>
        <field name="description" type="text-medium"/>
        <relationship type="one-nofk" related="moqui.llm.LlmModel" short-alias="model"/>
        <relationship type="one-nofk" title="Fallback" related="moqui.llm.LlmModel" short-alias="fallbackModel">
            <key-map field-name="fallbackModelId" related="modelId"/></relationship>
    </entity>

    <entity entity-name="LlmModelAlias" package="moqui.llm" use="configuration" cache="true">
        <description>A model name the OpenAI-compatible gateway answers to (/llm/v1), and the model it calls, or the
            feature whose binding (with its fallback and reasoning level) it follows when modelId is empty. A row
            replaces a gateway alias of the conf with the same name; disabled turns either off.</description>
        <field name="alias" type="text-medium" is-pk="true"/>
        <field name="modelId" type="id"/>
        <field name="featureId" type="id"/>
        <field name="description" type="text-medium"/>
        <field name="disabled" type="text-indicator"/>
        <relationship type="one-nofk" related="moqui.llm.LlmModel" short-alias="model"/>
    </entity>

    <entity entity-name="LlmApiClient" package="moqui.llm" use="transactional" cache="never">
        <description>A program that calls the A2A server, the MCP server or the gateway as a user, with an app password or a
            login key of that user. scopes is a comma list of a2a, mcp and gateway; allowedAgents and allowedAliases are
            comma lists, empty for all the user may use. The quota fields override the user's daily quota for this
            client.</description>
        <field name="clientId" type="id" is-pk="true"/>
        <field name="description" type="text-medium"/>
        <field name="userId" type="id"/>
        <field name="appPasswordId" type="id"/>
        <field name="loginKey" type="text-medium"><description>The hash a UserLoginKey is stored under</description></field>
        <field name="scopes" type="text-medium"/>
        <field name="allowedAgents" type="text-long"/>
        <field name="allowedAliases" type="text-long"/>
        <field name="dailyTokens" type="number-integer"/>
        <field name="dailyCost" type="currency-amount"/>
        <field name="requestsPerMinute" type="number-integer"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastUsedDate" type="date-time"/>
        <field name="disabled" type="text-indicator"/>
        <relationship type="one-nofk" related="moqui.security.UserAccount" short-alias="user"/>
        <relationship type="one-nofk" related="moqui.security.UserAppPassword" short-alias="appPassword"/>
        <index name="LLM_CLIENT_USER"><index-field name="userId"/></index>
    </entity>

    <entity entity-name="LlmQuota" package="moqui.llm" use="configuration" cache="true">
        <description>A limit on a user (userId) or on the members of a group (userGroupId): tokens and cost per period (day
            or month) and requests per minute, for one scope (all, agent, gateway, api; empty is all). A user's own row
            wins over the group rows; of the groups the largest limit applies; with no row the llm-facade limits
            (user-daily-tokens, user-daily-cost) apply.</description>
        <field name="quotaId" type="id" is-pk="true"/>
        <field name="userId" type="id"/>
        <field name="userGroupId" type="id"/>
        <field name="scope" type="text-short"/>
        <field name="period" type="text-short"><description>day or month; empty is day</description></field>
        <field name="maxTokens" type="number-integer"/>
        <field name="maxCost" type="currency-amount"/>
        <field name="requestsPerMinute" type="number-integer"/>
        <field name="disabled" type="text-indicator"/>
        <relationship type="one-nofk" related="moqui.security.UserAccount" short-alias="user"/>
        <relationship type="one-nofk" related="moqui.security.UserGroup" short-alias="userGroup"/>
        <index name="LLM_QUOTA_USER"><index-field name="userId"/></index>
        <index name="LLM_QUOTA_GROUP"><index-field name="userGroupId"/></index>
    </entity>

    <entity entity-name="LlmCall" package="moqui.llm" use="transactional" cache="never" sequence-bank-size="100">
        <description>One provider request (one attempt). source is agent, gateway, api, probe, embed or test. inputTokens is
            all of the prompt; cachedInputTokens (read from the provider's cache) and cacheWriteTokens are parts of it;
            reasoningTokens is the part of outputTokens spent reasoning. cost is from the model's prices at the time of the
            call. requestJson and responseJson are kept only with content-log on, redacted, and cleared after its
            retention-days (clean#LlmCallContent).</description>
        <field name="callId" type="id" is-pk="true"/>
        <field name="runId" type="id"/>
        <field name="stepSeq" type="number-integer"/>
        <field name="userId" type="id"/>
        <field name="featureId" type="id"/>
        <field name="modelId" type="id"/>
        <field name="endpointId" type="id"/>
        <field name="providerModel" type="text-medium"/>
        <field name="protocol" type="text-short"/>
        <field name="source" type="text-short"/>
        <field name="clientId" type="id"/>
        <field name="startDate" type="date-time"/>
        <field name="firstTokenMs" type="number-integer"/>
        <field name="durationMs" type="number-integer"/>
        <field name="httpStatus" type="number-integer"/>
        <field name="finishReason" type="text-short"/>
        <field name="errorClass" type="text-short"/>
        <field name="errorText" type="text-long"/>
        <field name="attempt" type="number-integer"/>
        <field name="inputTokens" type="number-integer"/>
        <field name="cachedInputTokens" type="number-integer"/>
        <field name="cacheWriteTokens" type="number-integer"/>
        <field name="outputTokens" type="number-integer"/>
        <field name="reasoningTokens" type="number-integer"/>
        <field name="usageEstimated" type="text-indicator"><description>Y when the tokens are the gateway's estimate (a
            stream cut before the provider's usage came), which the quotas count as any usage</description></field>
        <field name="cost" type="currency-precise"/>
        <field name="currencyUomId" type="id"/>
        <field name="requestJson" type="text-very-long"/>
        <field name="responseJson" type="text-very-long"/>
        <relationship type="one-nofk" related="moqui.security.UserAccount" short-alias="user"/>
        <relationship type="one-nofk" related="moqui.llm.LlmModel" short-alias="model"/>
        <relationship type="one-nofk" related="moqui.llm.LlmEndpoint" short-alias="endpoint"/>
        <relationship type="one-nofk" related="moqui.agent.AgentRun" short-alias="run"/>
        <index name="LLM_CALL_USER_DATE"><index-field name="userId"/><index-field name="startDate"/></index>
        <index name="LLM_CALL_DATE"><index-field name="startDate"/></index>
        <index name="LLM_CALL_RUN"><index-field name="runId"/><index-field name="stepSeq"/></index>
        <index name="LLM_CALL_MODEL"><index-field name="modelId"/><index-field name="startDate"/></index>
    </entity>

    <entity entity-name="LlmUsageDaily" package="moqui.llm" use="transactional" cache="never">
        <description>The calls of a day (in the server's time zone) per user, model and source, rolled up from LlmCall by
            rollup#LlmUsage, which recomputes a day whole each time it runs. A call with no user counts under _NA_.</description>
        <field name="userId" type="id" is-pk="true"/>
        <field name="usageDate" type="date" is-pk="true"/>
        <field name="modelId" type="id" is-pk="true"/>
        <field name="source" type="text-short" is-pk="true"/>
        <field name="callCount" type="number-integer"/>
        <field name="errorCount" type="number-integer"/>
        <field name="inputTokens" type="number-integer"/>
        <field name="cachedInputTokens" type="number-integer"/>
        <field name="cacheWriteTokens" type="number-integer"/>
        <field name="outputTokens" type="number-integer"/>
        <field name="reasoningTokens" type="number-integer"/>
        <field name="totalTokens" type="number-integer"/>
        <field name="cost" type="currency-precise"/>
        <field name="currencyUomId" type="id"/>
        <field name="rolledUpDate" type="date-time"/>
        <relationship type="one-nofk" related="moqui.security.UserAccount" short-alias="user"/>
        <relationship type="one-nofk" related="moqui.llm.LlmModel" short-alias="model"/>
        <index name="LLM_USAGE_DATE"><index-field name="usageDate"/></index>
    </entity>
    <view-entity entity-name="LlmUsageSummary" package="moqui.llm">
        <description>LlmUsageDaily summed over the fields a find selects with the totals, such as usageDate and modelId,
            or userId alone.</description>
        <member-entity entity-alias="LUD" entity-name="moqui.llm.LlmUsageDaily"/>
        <alias entity-alias="LUD" name="userId"/>
        <alias entity-alias="LUD" name="usageDate"/>
        <alias entity-alias="LUD" name="modelId"/>
        <alias entity-alias="LUD" name="source"/>
        <alias entity-alias="LUD" name="currencyUomId"/>
        <alias entity-alias="LUD" name="callCount" function="sum"/>
        <alias entity-alias="LUD" name="errorCount" function="sum"/>
        <alias entity-alias="LUD" name="inputTokens" function="sum"/>
        <alias entity-alias="LUD" name="cachedInputTokens" function="sum"/>
        <alias entity-alias="LUD" name="outputTokens" function="sum"/>
        <alias entity-alias="LUD" name="reasoningTokens" function="sum"/>
        <alias entity-alias="LUD" name="totalTokens" function="sum"/>
        <alias entity-alias="LUD" name="cost" function="sum"/>
    </view-entity>
</entities>
