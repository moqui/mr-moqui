<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="Definition" package="moqui.report" use="configuration" cache="never">
        <field name="definitionId" type="id-long" is-pk="true"/>
        <field name="definitionType" type="text-short"/>
        <field name="title" type="text-medium"/>
        <field name="bodyJson" type="text-very-long"/>
        <field name="ownerId" type="id"/>
        <field name="userGroupId" type="id"/>
        <field name="component" type="text-medium"/>
        <field name="readOnly" type="text-indicator"/>
        <field name="versionNumber" type="number-integer"/>
        <relationship type="one" related="moqui.security.UserAccount"><key-map field-name="ownerId" related="userId"/></relationship>
        <relationship type="one" related="moqui.security.UserGroup"/>
    </entity>
    <entity entity-name="DefinitionVersion" package="moqui.report" use="transactional" cache="never">
        <field name="definitionId" type="id-long" is-pk="true"/>
        <field name="versionNumber" type="number-integer" is-pk="true"/>
        <field name="bodyJson" type="text-very-long"/>
        <field name="note" type="text-long"/>
        <field name="changedBy" type="id"/>
        <field name="changedDate" type="date-time"/>
        <relationship type="one" related="moqui.report.Definition"/>
    </entity>
    <entity entity-name="DefinitionReference" package="moqui.report" use="configuration" cache="never">
        <field name="definitionId" type="id-long" is-pk="true"/>
        <field name="referencedId" type="id-long" is-pk="true"/>
        <relationship type="one" related="moqui.report.Definition"/>
        <index name="REPORT_REF_TARGET"><index-field name="referencedId"/></index>
    </entity>
    <!-- A business dataset's admission (BOSS impl-insights P3, INS-03; crates/moqui-report/src/business.rs): a dataset
        definition with signal "business" is read only once admitted here (admittedDate set, retiredDate not), except by its
        steward (the dataset's update artifact). Admission needs the document in a registered DataFeed, its index built and a
        rowFilterService registered as a ReportScopePolicy enumeration; the last index build and the last field or condition
        change are kept for the dataset's freshness. -->
    <entity entity-name="BusinessDataset" package="moqui.report" use="configuration" cache="never">
        <field name="datasetId" type="id-long" is-pk="true"/>
        <field name="admittedDate" type="date-time"/>
        <field name="admittedByUserId" type="id"/>
        <field name="retiredDate" type="date-time"/>
        <field name="stewardUserId" type="id"/>
        <field name="lastIndexedDate" type="date-time"/>
        <field name="lastIndexedCount" type="number-integer"/>
        <field name="lastIndexedByUserId" type="id"/>
        <field name="fieldsChangedDate" type="date-time"/>
        <field name="versionNumber" type="number-integer"/>
    </entity>
    <!-- A definition folder (body.folder) kept in a directory of a git repository, one JSON file per definition: a save
        pushes its file, and a push or fetch to the repository pulls (report/git_sync.rs). Runs as userId. -->
    <entity entity-name="DefinitionGitSync" package="moqui.report" use="configuration" cache="never">
        <field name="syncId" type="id" is-pk="true"/>
        <field name="folder" type="text-medium"/>
        <field name="repositoryId" type="id"/>
        <field name="path" type="text-medium"/>
        <field name="userId" type="id"/>
        <field name="enabled" type="text-indicator"/>
        <field name="lastPushDate" type="date-time"/>
        <field name="lastPullDate" type="date-time"/>
        <field name="lastError" type="text-long"/>
        <relationship type="one" related="moqui.resource.GitRepository"/>
        <relationship type="one" related="moqui.security.UserAccount"/>
        <index name="REPORT_GIT_SYNC_FOLDER"><index-field name="folder"/></index>
    </entity>
    <!-- A definition whose file a git sync wrote or read. Only a tracked definition is deleted when a pull finds its file
        gone, and deleting a tracked definition removes its file. -->
    <entity entity-name="DefinitionGitFile" package="moqui.report" use="configuration" cache="never">
        <field name="syncId" type="id" is-pk="true"/>
        <field name="definitionId" type="id-long" is-pk="true"/>
        <field name="syncedDate" type="date-time"/>
        <relationship type="one" related="moqui.report.DefinitionGitSync"/>
        <index name="REPORT_GIT_FILE_DEF"><index-field name="definitionId"/></index>
    </entity>
    <!-- Owner-equivalent delivery (BOSS impl-insights P7, INS-06; crates/moqui-report/src/delivery.rs; docs/tools/Monitoring.md
        "Report delivery"): the recipients of a business schedule, each run of it and each recipient's own outcome. No row
        holds a report's content: an occurrence and a delivery are evidence (who, when, which version, what state and safe
        reason), and a recipient's report is rendered again as that recipient when they ask for it. -->
    <entity entity-name="ReportScheduleRecipient" package="moqui.report" use="configuration" cache="never">
        <description>A recipient of a business report schedule (store#Schedule): a user, or a user group whose members in
            date are expanded at each run. Each must pass check#ReportAudience at save and again at each run.</description>
        <field name="screenScheduledId" type="id" is-pk="true"/>
        <field name="recipientKind" type="text-short" is-pk="true"><description>user or group</description></field>
        <field name="recipientId" type="id" is-pk="true"/>
        <relationship type="one" related="moqui.screen.ScreenScheduled"/>
    </entity>
    <entity entity-name="ReportOccurrence" package="moqui.report" use="transactional" cache="never">
        <description>One run of a business report schedule: a cron occurrence (its key the schedule and the cron instant, so
            a retry does not depend on the clock) or an explicit Send now. It pins the owner, the schedule's revision and the
            definition's version, and keeps safe counters; never frames or files.</description>
        <field name="occurrenceId" type="id" is-pk="true"/>
        <field name="screenScheduledId" type="id"/>
        <field name="occurrenceKey" type="text-medium"/>
        <field name="occurrenceKind" type="text-short"><description>scheduled or manual</description></field>
        <field name="occurrenceDate" type="date-time"/>
        <field name="completedDate" type="date-time"/>
        <field name="ownerUserId" type="id"/>
        <field name="scheduleRevision" type="number-integer"/>
        <field name="definitionId" type="id-long"/>
        <field name="definitionVersion" type="number-integer"/>
        <field name="renderMode" type="text-short"/>
        <field name="deliveryMode" type="text-short"/>
        <field name="statusId" type="id"/>
        <field name="reasonCode" type="text-short"/>
        <field name="recipientCount" type="number-integer"/>
        <field name="sentCount" type="number-integer"/>
        <field name="skippedCount" type="number-integer"/>
        <field name="failedCount" type="number-integer"/>
        <field name="uncertainCount" type="number-integer"/>
        <field name="renderCount" type="number-integer"><description>How many times the report was rendered for this
            occurrence: one per locale of its recipients, whatever their number</description></field>
        <field name="versionNumber" type="number-integer"><description>The revision a retry or a reconciliation
            advances</description></field>
        <relationship type="one" related="moqui.screen.ScreenScheduled"/>
        <relationship type="one" title="ReportOccurrence" related="moqui.basic.StatusItem"/>
        <index name="REPORT_OCC_KEY" unique="true"><index-field name="occurrenceKey"/></index>
        <index name="REPORT_OCC_SCHEDULE"><index-field name="screenScheduledId"/><index-field name="occurrenceDate"/></index>
        <index name="REPORT_OCC_OWNER"><index-field name="ownerUserId"/><index-field name="occurrenceDate"/></index>
    </entity>
    <entity entity-name="ReportRecipientDelivery" package="moqui.report" use="transactional" cache="never">
        <description>One recipient's outcome in an occurrence, unique by occurrence, recipient and channel: pending,
            sending (claimed by an attempt), sent, skipped, failed or uncertain, with a safe reason code (scope-differs,
            inactive, no-address, over-cap, removed-audience, schedule-changed, delivery-blocked, transport-failure,
            uncertain) and the attempt's identity. scopeHash is the scope fingerprint the delivery was sent under, which
            get#RecipientReport compares with the recipient's own before it renders for them.</description>
        <field name="deliveryId" type="id" is-pk="true"/>
        <field name="occurrenceId" type="id"/>
        <field name="userId" type="id"/>
        <field name="channel" type="text-short"><description>email</description></field>
        <field name="statusId" type="id"/>
        <field name="reasonCode" type="text-short"/>
        <field name="scopeHash" type="text-medium"/>
        <field name="locale" type="text-short"/>
        <field name="attemptCount" type="number-integer"/>
        <field name="attemptId" type="id-long"/>
        <field name="attemptDate" type="date-time"/>
        <field name="messageId" type="text-medium"/>
        <relationship type="one" related="moqui.report.ReportOccurrence"/>
        <relationship type="one" related="moqui.security.UserAccount"/>
        <relationship type="one" title="ReportDelivery" related="moqui.basic.StatusItem"/>
        <index name="REPORT_DLV_UNIQUE" unique="true"><index-field name="occurrenceId"/><index-field name="userId"/><index-field name="channel"/></index>
        <index name="REPORT_DLV_USER"><index-field name="userId"/><index-field name="attemptDate"/></index>
    </entity>
    <entity entity-name="AlertInstance" package="moqui.report" use="transactional" cache="never">
        <field name="definitionId" type="id-long" is-pk="true"/>
        <field name="seriesId" type="id-long" is-pk="true"/>
        <field name="state" type="text-short"/>
        <field name="stateSince" type="date-time"/>
        <field name="lastEvaluated" type="date-time"/>
        <field name="previouslyFiring" type="text-indicator"/>
        <field name="labelsJson" type="text-long"/>
        <!-- Consecutive successful evaluations without this series; at the rule's pruneAfterMissing (default 10) it is removed.
            Repeat delivery is per notification group, in AlertNotification.lastSent. -->
        <field name="missingCount" type="number-integer"/>
        <!-- The reading the state came from at the last evaluation, read through get#AlertState by the rule's owner and, for a
            business rule, a recipient whose scope is the owner's. -->
        <field name="lastValue" type="number-float"/>
        <relationship type="one" related="moqui.report.Definition"/>
    </entity>
    <entity entity-name="AlertRuleLock" package="moqui.report" use="transactional" cache="never">
        <field name="definitionId" type="id-long" is-pk="true"/><field name="lastEvaluated" type="date-time"/>
        <!-- An evaluator claims the rule briefly, runs its query and deliveries outside any lock, and writes state back
            only while it still holds this claim. A claim past claimedUntil (wall-clock millis) is abandoned. -->
        <field name="claimToken" type="id-long"/><field name="claimedUntil" type="number-integer"/>
        <relationship type="one" related="moqui.report.Definition"/>
    </entity>
    <entity entity-name="AlertNotification" package="moqui.report" use="transactional" cache="never">
        <field name="definitionId" type="id-long" is-pk="true"/><field name="contactId" type="id-long" is-pk="true"/><field name="groupId" type="id-long" is-pk="true"/>
        <field name="firstPending" type="date-time"/><field name="lastSent" type="date-time"/>
        <field name="stateHash" type="id-long"/><field name="lastSentHash" type="id-long"/><field name="payloadJson" type="text-very-long"/>
        <relationship type="one" related="moqui.report.Definition"/>
    </entity>
    <entity entity-name="AlertRecipientDelivery" package="moqui.report" use="transactional" cache="never">
        <description>One recipient's last outcome for one notification group of a business alert rule on one channel
            (crates/moqui-report/src/alert_delivery.rs), unique by rule, channel, group and recipient: sent, skipped or failed,
            with a safe reason code (scope-differs, not-shared, inactive, external, no-address, over-cap, owner-unauthorized,
            transport-failure), the state told (its name, never a value or a series label) and stateHash, the state a
            recipient was told, so a retry of a failed recipient tells nobody twice. scopeHash is the fingerprint it was
            sent under.</description>
        <field name="deliveryId" type="id" is-pk="true"/>
        <field name="definitionId" type="id-long"/>
        <field name="channel" type="text-short"><description>notification or email</description></field>
        <field name="groupId" type="id-long"/>
        <field name="userId" type="id"/>
        <field name="stateHash" type="id-long"/>
        <field name="alertState" type="text-short"/>
        <field name="statusId" type="id"/>
        <field name="reasonCode" type="text-short"/>
        <field name="scopeHash" type="text-medium"/>
        <field name="attemptCount" type="number-integer"/>
        <field name="attemptDate" type="date-time"/>
        <relationship type="one" related="moqui.report.Definition"/>
        <relationship type="one" related="moqui.security.UserAccount"/>
        <relationship type="one" title="ReportDelivery" related="moqui.basic.StatusItem"/>
        <index name="ALERT_DLV_UNIQUE" unique="true"><index-field name="definitionId"/><index-field name="channel"/><index-field name="groupId"/><index-field name="userId"/></index>
        <index name="ALERT_DLV_USER"><index-field name="userId"/><index-field name="attemptDate"/></index>
    </entity>
</entities>
