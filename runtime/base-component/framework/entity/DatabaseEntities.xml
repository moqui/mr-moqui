<!-- The Tools app's database administration, data grid and ETL (plans/Tools-Database.md): its jobs, saved queries and
    grid views, the audit of what ran outside the entity facade, the connections to databases the entity groups do not
    use, and the ETL mappings and runs. The services are org.moqui.impl.DatabaseServices (crates/moqui-tools); the
    enumerations and status items are in framework/data/DatabaseSetupData.xml. No Java counterpart. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ========== moqui.database ========== -->

    <entity entity-name="DatabaseJob" package="moqui.database" use="transactional" cache="never">
        <description>DDL or maintenance that runs outside an HTTP request, one statement after another, each on a
            connection of its own (plans/Tools-Database.md §6). db is group:&lt;groupName&gt; or ext:&lt;connectionId&gt;.
            instanceId is the instance that runs it: a job left Running under it when the instance starts again is marked
            Failed.</description>
        <field name="jobId" type="id" is-pk="true"/>
        <field name="db" type="text-medium"/>
        <field name="description" type="text-medium"/>
        <field name="kindEnumId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="userId" type="id"/>
        <field name="instanceId" type="id-long"/>
        <field name="createdDate" type="date-time" default="ec.user.nowTimestamp"/>
        <field name="startTime" type="date-time"/>
        <field name="endTime" type="date-time"/>
        <field name="lockTimeoutMs" type="number-integer"/>
        <relationship type="one" title="DatabaseJobKind" related="moqui.basic.Enumeration" short-alias="kind">
            <key-map field-name="kindEnumId"/></relationship>
        <relationship type="one" related="moqui.basic.StatusItem" short-alias="status"/>
        <relationship type="one" related="moqui.security.UserAccount"/>
        <relationship type="many" related="moqui.database.DatabaseJobStatement" short-alias="statements">
            <key-map field-name="jobId"/></relationship>
        <index name="DB_JOB_STATUS"><index-field name="statusId"/><index-field name="instanceId"/></index>
    </entity>
    <entity entity-name="DatabaseJobStatement" package="moqui.database" use="transactional" cache="never">
        <description>One statement of a job. dependsOnSeqId names the statement it waits on (a VALIDATE CONSTRAINT on its
            NOT VALID): when that one fails this one is skipped. backendPid is the Postgres pid or MySQL connection id that
            ran it, so any cluster member can cancel it.</description>
        <field name="jobId" type="id" is-pk="true"/>
        <field name="statementSeqId" type="id" is-pk="true"/>
        <field name="statementText" type="text-very-long"/>
        <field name="dependsOnSeqId" type="id"/>
        <field name="statusId" type="id"/>
        <field name="backendPid" type="number-integer"/>
        <!-- Schema and jobs: when the session backendPid names started (Postgres pg_stat_activity.backend_start as
            text), so a cancel from another instance reaches that session and not a later one with the pid -->
        <field name="backendStart" type="text-medium"/>
        <field name="startTime" type="date-time"/>
        <field name="endTime" type="date-time"/>
        <field name="rowsAffected" type="number-integer"/>
        <field name="errorText" type="text-very-long"/>
        <relationship type="one" related="moqui.database.DatabaseJob"/>
        <relationship type="one" related="moqui.basic.StatusItem" short-alias="status"/>
    </entity>

    <entity entity-name="SavedQuery" package="moqui.database" use="configuration" cache="never">
        <description>A SQL statement saved from Tools › SQL (§8.1), with the database it runs on. A :name in sqlText is
            bound as a value from parametersJson's defaults or the run's input, never pasted into the text. Shared queries
            (isShared Y) are listed to everyone who may open SQL.</description>
        <field name="queryId" type="id" is-pk="true"/>
        <field name="description" type="text-medium"/>
        <field name="db" type="text-medium"/>
        <field name="sqlText" type="text-very-long"/>
        <field name="ownerUserId" type="id"/>
        <field name="isShared" type="text-indicator"/>
        <field name="parametersJson" type="text-very-long"/>
        <relationship type="one" title="Owner" related="moqui.security.UserAccount">
            <key-map field-name="ownerUserId" related="userId"/></relationship>
        <index name="DB_SAVED_QUERY_OWNER"><index-field name="ownerUserId"/></index>
    </entity>

    <entity entity-name="GridView" package="moqui.database" use="configuration" cache="never">
        <description>A saved data grid view (§9.6): its source (an entity find, SQL or a file, sourceJson) and its layout
            (columns, widths, order, frozen columns, filters and sort, layoutJson).</description>
        <field name="viewId" type="id" is-pk="true"/>
        <field name="description" type="text-medium"/>
        <field name="ownerUserId" type="id"/>
        <field name="isShared" type="text-indicator"/>
        <field name="sourceJson" type="text-very-long"/>
        <field name="layoutJson" type="text-very-long"/>
        <relationship type="one" title="Owner" related="moqui.security.UserAccount">
            <key-map field-name="ownerUserId" related="userId"/></relationship>
        <index name="DB_GRID_VIEW_OWNER"><index-field name="ownerUserId"/></index>
    </entity>

    <entity entity-name="DatabaseAudit" package="moqui.database" use="nontransactional" cache="never">
        <description>What ran outside the entity facade (§14.2): every SQL statement, reads included, jobs, cancels and
            terminates, grid saves, loads, ETL runs and stats resets. Written in a transaction of its own, so it survives a
            rollback of what it records, and for failed statements too. For a grid save detailJson has the entity and the
            counts, not the values. Kept 90 days by default (database_audit_days).</description>
        <field name="auditId" type="id" is-pk="true"/>
        <field name="userId" type="id"/>
        <field name="visitId" type="id"/>
        <field name="instanceId" type="id-long"/>
        <field name="db" type="text-medium"/>
        <field name="actionEnumId" type="id"/>
        <field name="statementText" type="text-very-long"/>
        <field name="isChange" type="text-indicator"/>
        <field name="rowsReturned" type="number-integer"/>
        <field name="rowsAffected" type="number-integer"/>
        <field name="durationMs" type="number-integer"/>
        <field name="errorText" type="text-very-long"/>
        <field name="startTime" type="date-time"/>
        <field name="detailJson" type="text-very-long"/>
        <!-- a SQL run's statement: the run id the client named, and the statement's place in the script; the row's id is
            the server's, so a run id used again replaces nothing -->
        <field name="runId" type="id"/>
        <field name="statementSeq" type="number-integer"/>
        <relationship type="one" title="DatabaseAuditAction" related="moqui.basic.Enumeration" short-alias="action">
            <key-map field-name="actionEnumId"/></relationship>
        <relationship type="one" related="moqui.security.UserAccount"/>
        <index name="DB_AUDIT_USER_TIME"><index-field name="userId"/><index-field name="startTime"/></index>
        <index name="DB_AUDIT_TIME"><index-field name="startTime"/></index>
        <index name="DB_AUDIT_RUN"><index-field name="runId"/></index>
    </entity>

    <entity entity-name="SqlRunToken" package="moqui.database" use="transactional" cache="never">
        <description>The one-time confirmation of a SQL run with changes allowed (§8.2), issued by classify#Sql and
            spent by run#Sql or explain#Sql on any instance: a delete that must remove exactly this row. tokenHash is the
            SHA-256 of the token (the token itself is only the client's); textHash the SHA-256 of the script it confirms.
            Expired rows are purged with the audit (purge#DatabaseAudit). Never written or read through the generic
            entity tools.</description>
        <field name="tokenHash" type="id-long" is-pk="true"/>
        <field name="userId" type="id"/>
        <field name="db" type="text-medium"/>
        <field name="textHash" type="text-medium"/>
        <field name="expireTime" type="date-time"/>
        <index name="DB_SQL_TOKEN_EXPIRE"><index-field name="expireTime"/></index>
    </entity>

    <entity entity-name="DatabaseConnection" package="moqui.database" use="configuration" cache="never">
        <description>A database the entity groups do not use (§4.3), reached as db=ext:&lt;connectionId&gt;. Refused on a
            production instance and without the DATABASE_EXTERNAL permission, rows included. dbType is a database-list
            name (postgres, mysql, mysql8; MariaDB is mysql). A readOnly connection (the default) runs every statement in a
            read-only transaction.</description>
        <field name="connectionId" type="id" is-pk="true"/>
        <field name="description" type="text-medium"/>
        <field name="dbType" type="text-short"/>
        <field name="host" type="text-medium"/>
        <field name="port" type="number-integer"/>
        <field name="databaseName" type="text-medium"/>
        <field name="userName" type="text-medium"/>
        <field name="password" type="text-medium" encrypt="true"/>
        <field name="sslMode" type="text-short"/>
        <!-- sslrootcert as the datasource conf takes it: the path of a PEM file of the certificate authorities to trust,
            not the PEM itself; empty trusts the public ones -->
        <field name="sslRootCert" type="text-medium"/>
        <field name="readOnly" type="text-indicator" default="'Y'"/>
        <field name="ownerUserId" type="id"/>
        <relationship type="one" title="Owner" related="moqui.security.UserAccount">
            <key-map field-name="ownerUserId" related="userId"/></relationship>
    </entity>

    <!-- ========== moqui.etl ========== -->
    <!-- The ETL mappings and their runs (plans/Tools-Database.md §10.2): EtlMapping, EtlMappingField, EtlValueMap,
        EtlValueMapEntry, EtlRun and EtlRunError go here. -->

</entities>
