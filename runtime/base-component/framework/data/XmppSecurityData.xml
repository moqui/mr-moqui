<!-- XMPP for local users (C3a, docs/interfaces/XMPP.md): the services an XMPP client's session calls as its user, as
    DriveDeviceServices are for WebDAV and SFTP. Each checks the room (get#RoomAccess) or works on the user's own rows,
    as for the Chat screens; the sign-in lookups are internal (authenticate false) and not here. -->
<entity-facade-xml type="seed">
    <moqui.security.ArtifactGroup artifactGroupId="XmppClientServices" description="Chat services of XMPP clients"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="XmppClientServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y" nameIsPattern="Y"
            artifactName="org\.moqui\.impl\.ChatServices\.(send#Message|edit#Message|redact#Message|react#Message|mark#Read|signal#Typing|add#Member|find#Rooms|set#UserStatus|heartbeat#UserStatus)"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="XmppClientServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y" nameIsPattern="Y"
            artifactName="org\.moqui\.impl\.XmppServices\.(get#Users|get#Roster|get#DirectRoom|get#RoomInfo|get#Archive|find#EventByRef|store#EncryptedMessage|get#PepItems|publish#PepItem|retract#PepItem|configure#PepNode|delete#PepNode|get#BlockedJids|block#Jids|unblock#Jids|enable#Push|disable#Push|create#UploadSlot|attach#Upload|get#AttachmentUrls|get#IceServers)"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="XmppClientServicesALL" userGroupId="ALL_USERS" artifactGroupId="XmppClientServices"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
</entity-facade-xml>
