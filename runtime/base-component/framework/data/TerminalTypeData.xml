<!-- The terminal's seed data (plans/Terminal-Fancy.md §11.1). -->
<entity-facade-xml type="seed">
    <!-- A terminal session that wants its user while nobody looks at it: blocked (a permission, a question), done, a long
        command finished, a bell, as the user's Terminal settings say (crates/moqui-host/src/term/notice.rs). Kept and
        alerting, so Web Push takes it to a phone. -->
    <moqui.security.user.NotificationTopic topic="TerminalAttention" inboxEnumId="NinNotifications" description="Terminal Attention"
            typeString="warning" showAlert="Y" persistOnSend="Y" receiveNotifications="Y" titleTemplate="${title || 'Terminal'}"/>
</entity-facade-xml>
