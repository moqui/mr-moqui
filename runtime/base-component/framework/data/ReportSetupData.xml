<?xml version="1.0" encoding="UTF-8"?>
<entity-facade-xml type="seed">
    <moqui.service.job.ServiceJob jobName="evaluate_ReportAlerts_minute" description="Evaluate report alert rules as their owners"
        serviceName="org.moqui.report.ReportServices.evaluate#Alerts" cronExpression="0 * * * * ?" paused="N" errorHistoryOnly="Y"/>
    <moqui.security.user.NotificationTopic topic="ReportAlert" inboxEnumId="NinUpdates" description="Report alert"
        typeString="warning" showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y"/>
    <!-- Business dataset scope policies (crates/moqui-report/src/business.rs): each a rowFilterService (enumCode) a domain
        component registers as an Enumeration of this type, which a business dataset must name to be admitted -->
    <moqui.basic.EnumerationType enumTypeId="ReportScopePolicy" description="Business dataset scope policy (a row-filter service)"/>
    <moqui.basic.Enumeration enumId="ReportUserGroups" enumTypeId="ReportScopePolicy"
            enumCode="org.moqui.report.ReportServices.get#UserGroupRowFilter" description="the viewer's user groups"/>
    <!-- Business annotation sources (crates/moqui-report/src/annotations.rs; BOSS impl-insights P6): each a dataset (enumCode) over
        the annotations that a domain component registers and scopes with its own row filter; a dashboard over business data
        shows the business events of each source its viewer may read -->
    <moqui.basic.EnumerationType enumTypeId="ReportAnnotationSource" description="Business annotation source (a dataset over the annotations)"/>
</entity-facade-xml>
