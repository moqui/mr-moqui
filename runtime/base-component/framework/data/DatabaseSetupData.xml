<!-- The Tools app's database administration (framework/entity/DatabaseEntities.xml, org.moqui.impl.DatabaseServices,
    plans/Tools-Database.md): the kinds and statuses of database jobs and the actions of the audit. The permissions are
    in tools/data/ToolsSecurityData.xml. -->
<entity-facade-xml type="seed">
    <!-- DatabaseJob.kindEnumId (§6) -->
    <moqui.basic.EnumerationType enumTypeId="DatabaseJobKind" description="Database Job Kind"/>
    <moqui.basic.Enumeration enumId="DbjDdl" enumTypeId="DatabaseJobKind" sequenceNum="1" description="DDL"/>
    <moqui.basic.Enumeration enumId="DbjMaintenance" enumTypeId="DatabaseJobKind" sequenceNum="2" description="Maintenance"/>
    <moqui.basic.Enumeration enumId="DbjLoadWrap" enumTypeId="DatabaseJobKind" sequenceNum="3" description="Load Wrapper"/>

    <!-- DatabaseJob.statusId and DatabaseJobStatement.statusId (§6); the runner sets them, there is no status flow -->
    <moqui.basic.StatusType statusTypeId="DatabaseJob" description="Database Job"/>
    <moqui.basic.StatusItem statusId="DbjsPending" statusTypeId="DatabaseJob" sequenceNum="1" description="Pending"/>
    <moqui.basic.StatusItem statusId="DbjsRunning" statusTypeId="DatabaseJob" sequenceNum="2" description="Running"/>
    <moqui.basic.StatusItem statusId="DbjsDone" statusTypeId="DatabaseJob" sequenceNum="3" description="Done" statusColor="positive"/>
    <moqui.basic.StatusItem statusId="DbjsFailed" statusTypeId="DatabaseJob" sequenceNum="4" description="Failed" statusColor="negative"/>
    <moqui.basic.StatusItem statusId="DbjsCancelled" statusTypeId="DatabaseJob" sequenceNum="5" description="Cancelled" statusColor="warning"/>
    <moqui.basic.StatusItem statusId="DbjsSkipped" statusTypeId="DatabaseJob" sequenceNum="6" description="Skipped" statusColor="warning"/>

    <!-- ========== Schema and jobs: a finished job tells its user (crates/moqui-tools/src/jobs.rs) ========== -->
    <moqui.security.user.NotificationTopic topic="DatabaseJob" inboxEnumId="NinUpdates" description="Database Job"
            typeString="info" showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y"
            titleTemplate="Database job ${jobId || ''} ${statusId || ''}"/>

    <!-- DatabaseAudit.actionEnumId (§14.2) -->
    <moqui.basic.EnumerationType enumTypeId="DatabaseAuditAction" description="Database Audit Action"/>
    <moqui.basic.Enumeration enumId="DbaSql" enumTypeId="DatabaseAuditAction" sequenceNum="1" description="SQL"/>
    <moqui.basic.Enumeration enumId="DbaJob" enumTypeId="DatabaseAuditAction" sequenceNum="2" description="Job"/>
    <moqui.basic.Enumeration enumId="DbaCancel" enumTypeId="DatabaseAuditAction" sequenceNum="3" description="Cancel"/>
    <moqui.basic.Enumeration enumId="DbaTerminate" enumTypeId="DatabaseAuditAction" sequenceNum="4" description="Terminate"/>
    <moqui.basic.Enumeration enumId="DbaGridSave" enumTypeId="DatabaseAuditAction" sequenceNum="5" description="Grid Save"/>
    <moqui.basic.Enumeration enumId="DbaLoad" enumTypeId="DatabaseAuditAction" sequenceNum="6" description="Load"/>
    <moqui.basic.Enumeration enumId="DbaEtlRun" enumTypeId="DatabaseAuditAction" sequenceNum="7" description="ETL Run"/>
    <moqui.basic.Enumeration enumId="DbaStatsReset" enumTypeId="DatabaseAuditAction" sequenceNum="8" description="Stats Reset"/>
</entity-facade-xml>
