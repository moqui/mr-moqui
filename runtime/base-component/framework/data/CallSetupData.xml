<!-- Calls (framework/entity/CallEntities.xml, org.moqui.impl.CallServices, CallRecordingServices): the cleanup jobs. -->
<entity-facade-xml type="seed-initial">
    <!-- Calls that rang out, legs whose socket did not come back, calls whose media server stopped. Each item is on its
        own. A success is not kept: the call is the record. -->
    <moqui.service.job.ServiceJob jobName="expire_Calls_frequent" description="End abandoned calls and legs"
            serviceName="org.moqui.impl.CallServices.expire#Calls" cronExpression="0 * * * * ?" paused="N"
            errorHistoryOnly="Y"/>
    <!-- Call recordings (W5, org.moqui.impl.CallRecordingServices): retention deletes recordings past their
        retentionUntilDate, files and rows; recovery fails a recording whose recorder is gone and removes partial uploads
        and segments. Each item is on its own. -->
    <moqui.service.job.ServiceJob jobName="expire_Recordings_hourly" description="Delete expired call recordings, clean up partial ones"
            serviceName="org.moqui.impl.CallRecordingServices.expire#Recordings" cronExpression="0 17 * * * ?" paused="N"
            errorHistoryOnly="Y"/>
    <!-- Voicemail (V2, org.moqui.impl.VoicemailServices): messages in a trash longer than voicemail_trash_days are deleted
        with their audio and transcripts. Each message is on its own. -->
    <moqui.service.job.ServiceJob jobName="expire_VoicemailTrash_daily" description="Delete voicemail long in the trash"
            serviceName="org.moqui.impl.VoicemailServices.expire#VoicemailTrash" cronExpression="0 41 3 * * ?" paused="N"
            errorHistoryOnly="Y"/>
</entity-facade-xml>
