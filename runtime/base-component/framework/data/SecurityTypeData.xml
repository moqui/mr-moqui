<entity-facade-xml type="seed">
    <moqui.basic.Enumeration description="Moqui Administrators" enumId="UgtMoquiAdmin" enumTypeId="UserGroupType"/>
    <moqui.basic.Enumeration description="Remote Systems" enumId="UgtRemoteSystems" enumTypeId="UserGroupType"/>

    <!-- User Group for full-access Administrators -->
    <moqui.security.UserGroup userGroupId="ADMIN" description="Administrators (full access)" groupTypeEnumId="UgtMoquiAdmin"/>
    <moqui.security.UserGroup userGroupId="ADMIN_ADV" description="Administrators - Advanced" groupTypeEnumId="UgtMoquiAdmin"/>

    <!-- A default/automatic group for all users -->
    <moqui.security.UserGroup userGroupId="ALL_USERS" description="All Users (all users members by default)"/>

    <!-- An artifact group for remote EntitySync calls; members of other groups like remote API only groups would use this as well -->
    <moqui.security.ArtifactGroup artifactGroupId="EntitySyncServices" description="EntitySync Services"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="EntitySyncServices" artifactName="org.moqui.impl.EntitySyncServices.put#EntitySyncData"
            nameIsPattern="N" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="EntitySyncServices" artifactName="org.moqui.impl.EntitySyncServices.get#EntitySyncData"
            nameIsPattern="N" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="EntitySyncServicesADMIN" userGroupId="ADMIN" artifactGroupId="EntitySyncServices"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>

    <!-- The resources transition of webroot.xml (the elFinder protocol over a resource root, ElFinderServices.run#Command)
        reads and writes any root it is given, so only ADMIN -->
    <moqui.security.ArtifactGroup artifactGroupId="ResourceCommandServices" description="Resource command services (/resources)"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="ResourceCommandServices" artifactName="org.moqui.resource.ElFinderServices.run#Command"
            nameIsPattern="N" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="ResourceCommandServicesADMIN" userGroupId="ADMIN" artifactGroupId="ResourceCommandServices"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>

    <!-- An artifact group for remote SystemMessage calls; members of other groups like remote API only groups would use this as well -->
    <moqui.security.ArtifactGroup artifactGroupId="SystemMessageServices" description="SystemMessage Services"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="SystemMessageServices"
            artifactName="org.moqui.impl.SystemMessageServices.receive#IncomingSystemMessage"
            nameIsPattern="N" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="SystemMessageServicesADMIN" userGroupId="ADMIN" artifactGroupId="SystemMessageServices"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>

    <moqui.security.UserGroup userGroupId="SYSMSG_RECEIVE" description="System Message Receivers" groupTypeEnumId="UgtRemoteSystems"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="SystemMessageServicesSYSMSG" userGroupId="SYSMSG_RECEIVE" artifactGroupId="SystemMessageServices"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>

    <!-- The drive services a device calls through the DAV server (WebDAV) and SFTP to the drives, as the user who logged in
        with an app password (docs/interfaces/Sync.md). Each checks the drive's members and shares itself, as for the Files screens. -->
    <moqui.security.ArtifactGroup artifactGroupId="DriveDeviceServices" description="Drive services of devices (WebDAV, SFTP)"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="DriveDeviceServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y" nameIsPattern="Y"
            artifactName="org\.moqui\.resource\.FileServices\.(get#UserDrives|list#Folder|get#ResourceInfo|upload#Resource|create#Folder|rename#Resource|move#Resource|copy#Resource|trash#Resource)"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="DriveDeviceServicesALL" userGroupId="ALL_USERS" artifactGroupId="DriveDeviceServices"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>

    <!-- Special Permissions -->
    <!-- An outside user (an app's client contacts, a vendor's or partner's users): no room bound to a record (not as a
        member either), no public room but as a member, no other user's presence, no records drive (screens, WebDAV, SFTP),
        and never the agent permissions (Assist, chat agents, AI tasks, A2A, MCP, the LLM gateway), whatever else a group
        grants; check#RecordVisible shows them no record whatever the app's hook says (crates/moqui-core user::EXTERNAL_USER,
        ChatServices, FileServices.get#DriveAccess). Granted to no group here: an app grants it to its outside users' group. -->
    <moqui.security.UserPermission userPermissionId="EXTERNAL_USER" description="External user (no record rooms, records drive, others' presence or agents)"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_PASSWORD" description="Admin Password Update"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_PASSWORD" fromDate="0"/>
    <!-- Delegated administration (the org.moqui.admin services and an app's Admin screens): a view and a write permission
        per responsibility, each granted to ADMIN; an app grants them to its own groups. ADMIN_IDENTITY_GLOBAL (an
        account-wide change of an identity that works for several organizations), ADMIN_ACCESS_MANAGE (grants and
        memberships) and ADMIN_BACKUP_DOWNLOAD (a backup archive, the whole instance's data) are sealed (MoquiDefaultConf
        authz sealed-permissions), so only a holder grants them. -->
    <moqui.security.UserPermission userPermissionId="ADMIN_OVERVIEW_VIEW" description="Admin: setup and health summaries"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_IDENTITY_VIEW" description="Admin: view user accounts and memberships"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_IDENTITY_MANAGE" description="Admin: manage user accounts and memberships"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_IDENTITY_GLOBAL" description="Admin: change an account across all its organizations"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_ACCESS_VIEW" description="Admin: view groups and grants"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_ACCESS_MANAGE" description="Admin: manage group grants and memberships"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_SETTINGS_VIEW" description="Admin: view instance and organization settings"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_SETTINGS_MANAGE" description="Admin: manage instance and organization settings"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_CONNECTION_VIEW" description="Admin: view connections and their readiness"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_CONNECTION_MANAGE" description="Admin: manage connections and replace credentials"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_OPERATION_VIEW" description="Admin: view jobs, queues and recovery"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_OPERATION_MANAGE" description="Admin: run jobs and recovery actions"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_TRANSFER_VIEW" description="Admin: view imports and exports"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_TRANSFER_RUN" description="Admin: run imports and exports"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_AUDIT_VIEW" description="Admin: view change and access evidence"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_BACKUP_VIEW" description="Admin: view backup coverage"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_BACKUP_RUN" description="Admin: request a backup"/>
    <moqui.security.UserPermission userPermissionId="ADMIN_BACKUP_DOWNLOAD" description="Admin: download a backup archive"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_OVERVIEW_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_IDENTITY_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_IDENTITY_MANAGE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_IDENTITY_GLOBAL" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_ACCESS_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_ACCESS_MANAGE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_SETTINGS_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_SETTINGS_MANAGE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_CONNECTION_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_CONNECTION_MANAGE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_OPERATION_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_OPERATION_MANAGE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_TRANSFER_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_TRANSFER_RUN" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_AUDIT_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_BACKUP_VIEW" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_BACKUP_RUN" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_BACKUP_DOWNLOAD" fromDate="0"/>
    <!-- Admin P3 (mr-boss plan/impl-admin.md P3): the access administration services, org.moqui.admin.AccessServices and
        IdentityServices.check#AdministrationPath, for every signed-in user: each checks ADMIN_ACCESS_VIEW or ADMIN_ACCESS_MANAGE
        itself and writes the security rows through the entity facade with authorization on, so the sealed-permission and
        privileged-group EECAs decide each row (an ALLOW, so an app's deny of a package still applies; inheritable, so the
        service's own writes are authorized as it). Admin P4 adds IdentityServices' sessions and credentials (find#Sessions,
        revoke#Sessions, get#AccountCredentials, revoke#AccountAccess), each the caller's own or another user's with
        ADMIN_IDENTITY_VIEW or ADMIN_IDENTITY_MANAGE, checked by the service -->
    <moqui.security.ArtifactGroup artifactGroupId="AdminAccessServices" description="Admin access services"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="AdminAccessServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y" nameIsPattern="Y"
            artifactName="org\.moqui\.admin\.(AccessServices\.(find#Groups|get#Group|create#Group|store#Group|store#Membership|end#Membership|preview#Grants|apply#Grants|store#GroupPreference|check#GrantProposal|apply#GrantProposal)|IdentityServices\.(check#AdministrationPath|find#Sessions|revoke#Sessions|get#AccountCredentials|revoke#AccountAccess))"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="AdminAccessServicesALL" userGroupId="ALL_USERS" artifactGroupId="AdminAccessServices"
            authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    <!-- Admin P9: AccessServices' read projections (the capability matrix, the row rules and the access review), each checking
        ADMIN_ACCESS_VIEW itself; a member row of its own, so an installed database gets it beside the row above -->
    <moqui.security.ArtifactGroupMember artifactGroupId="AdminAccessServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y" nameIsPattern="Y"
            artifactName="org\.moqui\.admin\.AccessServices\.(get#Capabilities|get#ScopeRules|get#GrantReview)"/>
    <!-- Admin P10: the lockout preview of a group's sign-in rules, checking ADMIN_ACCESS_VIEW itself; a member row of its own -->
    <moqui.security.ArtifactGroupMember artifactGroupId="AdminAccessServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y" nameIsPattern="Y"
            artifactName="org\.moqui\.admin\.AccessServices\.preview#GroupSignInRules"/>
    <!-- Admin P6 (mr-boss plan/impl-admin.md P6, F31): the owner change of a shared drive and of a shared mail account, which an
        account's lifecycle uses when the owner leaves (the owned-resource contract of org.moqui.admin.IdentityServices). Their
        owner may hand them over; another user's need these permissions, granted to ADMIN (an app grants them to its identity
        operators). The services check the permission and the new owner themselves, so ALL_USERS may call them. -->
    <moqui.security.UserPermission userPermissionId="DRIVE_OWNER_CHANGE" description="Drives: change the owner of another user's shared drive"/>
    <moqui.security.UserPermission userPermissionId="EMAIL_ACCOUNT_OWNER_CHANGE" description="Mail: change the owner of another user's shared mail account"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="DRIVE_OWNER_CHANGE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="EMAIL_ACCOUNT_OWNER_CHANGE" fromDate="0"/>
    <moqui.security.ArtifactGroup artifactGroupId="ResourceOwnerServices" description="Owned resource lookup and owner change"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="ResourceOwnerServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y" nameIsPattern="Y"
            artifactName="org\.moqui\.(resource\.FileServices\.(find#OwnedDrives|transfer#DriveOwner)|mail\.EmailClientServices\.(find#OwnedEmailAccounts|transfer#EmailAccountOwner))"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="ResourceOwnerServicesALL" userGroupId="ALL_USERS" artifactGroupId="ResourceOwnerServices"
            authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    <!-- A coordinator's call of a stored step's owner service (IdentityServices.call#OwnedResourceService; impl-admin P6 review,
        F-P6-1): not inheritable, so the coordinator's own inheritable ALLOW (Mantle's identity services') stops here and the owner
        service is authorized on its own records, as a direct call would be -->
    <moqui.security.ArtifactGroup artifactGroupId="OwnedResourceCall" description="Owned resource step call"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="OwnedResourceCall" artifactTypeEnumId="AT_SERVICE" inheritAuthz="N" nameIsPattern="N"
            artifactName="org.moqui.admin.IdentityServices.call#OwnedResourceService"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="OwnedResourceCallALL" userGroupId="ALL_USERS" artifactGroupId="OwnedResourceCall"
            authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    <!-- The registered purposes of a custom group (optionIndicator Y): CreateGroup offers them, and a group of one of them is a
        custom group an access administrator created, never privileged. A component adds its own. -->
    <moqui.basic.Enumeration description="Team" enumId="UgtCustomTeam" enumTypeId="UserGroupType" optionIndicator="Y" sequenceNum="10"/>
    <moqui.basic.Enumeration description="Job role" enumId="UgtCustomRole" enumTypeId="UserGroupType" optionIndicator="Y" sequenceNum="11"/>
    <moqui.basic.Enumeration description="Project or initiative" enumId="UgtCustomProject" enumTypeId="UserGroupType" optionIndicator="Y" sequenceNum="12"/>

    <moqui.security.UserPermission userPermissionId="ADMIN_LOGIN_AS" description="Admin Login As User"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN_ADV" userPermissionId="ADMIN_LOGIN_AS" fromDate="0"/>
    <moqui.security.UserPermission userPermissionId="SQL_RUNNER_WEB" description="Tools: SQL Runner"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN_ADV" userPermissionId="SQL_RUNNER_WEB" fromDate="0"/>
    <!-- Deploying a component from a git URL runs its code and loads its data (System > Components,
        docs/tools/Component-Deploy.md); sealed, and in production also needs component_deploy_enabled=true. -->
    <moqui.security.UserPermission userPermissionId="COMPONENT_DEPLOY" description="System: deploy a component from git"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN_ADV" userPermissionId="COMPONENT_DEPLOY" fromDate="0"/>
    <!-- Reading and saving the conf files on System > Conf > Edit; a save reloads the conf (docs/tools/Component-Deploy.md).
        The conf names the code the server runs, so it is sealed. -->
    <moqui.security.UserPermission userPermissionId="CONF_EDIT" description="System: edit the conf files"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN_ADV" userPermissionId="CONF_EDIT" fromDate="0"/>
    <!-- The built-in SSH server (ssh_port): SFTP over ssh-server sftp-root, and the admin command shell, which runs JavaScript. -->
    <moqui.security.UserPermission userPermissionId="SSH_SFTP" description="SSH: SFTP file access"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="SSH_SFTP" fromDate="0"/>
    <moqui.security.UserPermission userPermissionId="SSH_SHELL" description="SSH: admin command shell; on a dev instance also the browser terminal's moqui> command line"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN_ADV" userPermissionId="SSH_SHELL" fromDate="0"/>
    <!-- The terminal client (plans/archive/Screen-TUI-Impl.md 4.2, 4.4) needs no permission: every user gets the apps over SSH
        and in the browser terminal, every screen is still checked as the user, and files are not downloaded. SSH_SHELL
        adds the admin shell's prompt before them, for a login by key or password at the SSH level, and on a dev instance
        the same moqui> command line in the browser terminal (plans/Terminal-Fancy.md D6). -->
    <!-- git-upload-pack and git-receive-pack over SSH (git clone ssh://...); AT_GIT_REPOSITORY still gates each
        repository. Grant it to the groups of developers. Git takes a connection that logged in by key (UserSshKey)
        unless ssh-server git-password-auth is true. -->
    <moqui.security.UserPermission userPermissionId="SSH_GIT" description="SSH: git clone, fetch and push"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="SSH_GIT" fromDate="0"/>
    <!-- Git repositories (AT_GIT_REPOSITORY): view to clone, fetch and read; create and update to push new refs and
        fast-forwards; delete to force a push or delete a ref. Admins get all; grant others through ArtifactAuthz on
        this group, or on a group of their own with the repositoryId (or a pattern) as the artifact name. -->
    <moqui.security.ArtifactGroup artifactGroupId="GitRepositories" description="All git repositories"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="GitRepositories" artifactName=".*" nameIsPattern="Y"
            artifactTypeEnumId="AT_GIT_REPOSITORY" inheritAuthz="N"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="GitRepositoriesADMIN" userGroupId="ADMIN"
            artifactGroupId="GitRepositories" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.UserPermission userPermissionId="LOAD_RUNNER" description="Tools: Load testing (run load scripts against this or an allowed server)"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN_ADV" userPermissionId="LOAD_RUNNER" fromDate="0"/>
</entity-facade-xml>
