<!-- The AiOptOut spec's screen (test only, never mounted): a form field, a hidden value, a list column and a section opted
    out of AI (ai-opt-out, design-people PE-21), beside a field and a column that are not. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-title="AI opt-out">
    <transition name="save"><default-response type="none"/></transition>
    <actions>
        <set field="caseMap" from="{subject: 'Visible subject', note: 'Confidential note A', caseRef: 'Confidential ref B'}"/>
        <set field="caseList" from="[{caseId: 'C1', title: 'Visible title', reason: 'Confidential reason C'}]"/>
    </actions>
    <widgets>
        <form-single name="EditCase" map="caseMap" transition="save">
            <field name="subject"><default-field title="Subject"><text-line/></default-field></field>
            <field name="note" ai-opt-out="true"><default-field title="Note"><text-area editor-type="rich"/></default-field></field>
            <field name="caseRef" ai-opt-out="true"><default-field><hidden/></default-field></field>
            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
        </form-single>
        <form-list name="CaseList" list="caseList" skip-form="true">
            <field name="title"><default-field title="Title"><display/></default-field></field>
            <field name="reason" ai-opt-out="true"><header-field><text-find/></header-field><default-field title="Reason"><display/></default-field></field>
        </form-list>
        <section name="Statement" ai-opt-out="true"><widgets><label text="Confidential statement D"/></widgets></section>
    </widgets>
</screen>
