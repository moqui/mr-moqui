      "rate": {
        "title": "Request rate",
        "visualization": "timeSeries",
        "queries": [
          {
            "datasetId": "otel_metrics",
            "metricGranularity": "auto",
            "queryString": "name:\"http.server.request.duration\"",
            "aggregations": [
              {
                "id": "time",
                "type": "date_histogram",
                "role": "x-axis",
                "params": {
                  "field": "bucket_start",
                  "fixed_interval": "auto",
                  "min_doc_count": 0
                }
              },
              {
                "id": "service",
                "type": "terms",
                "role": "series",
                "params": {
                  "field": "service.name",
                  "size": 10,
                  "missing": "(unknown)"
                }
              },
              {
                "id": "requests",
                "type": "sum",
                "role": "metric",
                "params": {
                  "field": "count"
                }
              }
            ],
            "transformations": [
              {
                "type": "organize",
                "hide": [
                  "count"
                ]
              }
            ]
          }
        ]
