<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Logs" default-menu-index="4">
    <!-- Explore's links and forms resolve against this screen's URL, so its transitions run here, under this app's authorization. -->
    <transition-include name="remember" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="trace" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="user" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="context" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="visit" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="tail" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="saveSearch" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="addPanel" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="split" location="component://tools/screen/Dashboards/Explore.xml"/>
    <pre-actions><set field="datasetId" from="datasetId || 'otel_logs'"/></pre-actions>
    <widgets><include-screen location="component://tools/screen/Dashboards/Explore.xml" share-scope="true"/></widgets>
</screen>
