<!-- Real-user monitoring (telemetry/browser): page loads and their web vitals, in-app navigations, the browser's requests and
    its JavaScript errors, from signed-in qvt pages. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Browser" default-menu-index="12">
    <!-- Dashboard's links, forms and panel requests resolve against this screen's URL, so its transitions run here, under this app's authorization. -->
    <transition-include name="edit" location="component://tools/screen/Dashboards/Dashboard.xml"/>
    <transition-include name="setVariable" location="component://tools/screen/Dashboards/Dashboard.xml"/>
    <transition-include name="exportPanel" location="component://tools/screen/Dashboards/Dashboard.xml"/>
    <transition-include name="inspectPanel" location="component://tools/screen/Dashboards/Dashboard.xml"/>
    <pre-actions><set field="definitionId" value="monitor-browser"/></pre-actions>
    <widgets>
        <label text="Browser telemetry is sent only when telemetry browser enabled is true, and only by signed-in pages. No data here does not establish that pages are healthy." type="p"/>
        <include-screen location="component://tools/screen/Dashboards/Dashboard.xml" share-scope="true"/>
    </widgets>
</screen>
