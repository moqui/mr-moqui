<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Artifacts" default-menu-index="8">
    <!-- Dashboard's links, forms and panel requests resolve against this screen's URL, so its transitions run here, under this app's authorization. -->
    <transition-include name="edit" location="component://tools/screen/Dashboards/Dashboard.xml"/>
    <transition-include name="setVariable" location="component://tools/screen/Dashboards/Dashboard.xml"/>
    <transition-include name="exportPanel" location="component://tools/screen/Dashboards/Dashboard.xml"/>
    <transition-include name="inspectPanel" location="component://tools/screen/Dashboards/Dashboard.xml"/>
    <pre-actions><set field="definitionId" value="monitor-artifacts"/></pre-actions>
    <widgets><include-screen location="component://tools/screen/Dashboards/Dashboard.xml" share-scope="true"/></widgets>
</screen>
