<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Dashboards" menu-image="sym_o_dashboard" menu-image-type="icon">
    <!-- Tools' own report screens: no mount (docs/tools/Monitoring.md, "Mounting the report screens"), so a request parameter
        never sets a mount's links, policy, fixed variables, hidden components or editor types here -->
