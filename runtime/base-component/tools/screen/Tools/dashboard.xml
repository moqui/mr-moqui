<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-index="1" menu-image="sym_o_dashboard" menu-image-type="icon">

    <transition name="reloadEcfi" begin-transaction="false" authz-action="all">
        <actions>
            <script>ec.factory.triggerDynamicReInit()</script>
            <message>ExecutionContextFactory dynamic re-initialize triggered</message>
        </actions>
        <default-response url="."/>
    </transition>

    <!-- the permission checks run here, so a server-static template reads flags from the screen package -->
    <actions>
        <set field="canServiceLoadRunner" from="ec.user.hasPermission('SERVICE_LOAD_RUNNER')"/>
        <set field="canSqlRunner" from="ec.user.hasPermission('SQL_RUNNER_WEB')"/>
    </actions>

    <widgets>
        <container-row>
            <row-col md="4">
                <container-box><box-header title="Browse and edit data"/><box-body>
                    <label text="Find entity definitions and records, or build a view of related data." type="p" style="m-muted"/>
                    <link url="../Entity/DataEdit" text="Entities"/>
                    <link url="../AutoScreen" text="Auto screens"/>
                    <link url="../DataView" text="Data views"/>
                </box-body></container-box>
                <container-box><box-header title="Import and export"/><box-body>
                    <label text="Load data files, export selected records, or compare data snapshots." type="p" style="m-muted"/>
                    <link url="../Entity/DataImport" text="Import data"/>
                    <link url="../Entity/DataExport" text="Export data"/>
                    <link url="../Entity/DataSnapshot" text="Data snapshots"/>
                </box-body></container-box>
            </row-col>
            <row-col md="4">
                <container-box><box-header title="Services and queries"/><box-body>
                    <label text="Inspect service inputs and results, run a service, or execute a database query." type="p" style="m-muted"/>
                    <link url="../Service" text="Services"/>
                    <link url="../Entity/SqlRunner" text="SQL query" condition="canSqlRunner"/>
                    <link url="../Entity/SqlScriptRunner" text="SQL script" condition="canSqlRunner"/>
                    <link url="../Service/ServiceLoadRunner" text="Service load runner" condition="canServiceLoadRunner"/>
                </box-body></container-box>
                <container-box><box-header title="Inspect and diagnose"/><box-body>
                    <link url="../StatusFlows" text="Status flows"/>
                    <link url="../ArtifactStats" text="Artifact statistics"/>
                    <link url="../Entity/TableStats" text="Table statistics"/>
                    <link url="../Entity/QueryStats" text="Query statistics"/>
                    <link url="../Entity/SpeedTest" text="Entity speed test"/>
                </box-body></container-box>
            </row-col>
            <row-col md="4">
            <section name="RestApiSection"><actions>
                <set field="restUrl" from="sri.buildUrl('/rest').url"/>
                <set field="rootResources" from="ec.service.restApi.getFreshRootResources()"/>

                <set field="masterEntityNameList" from="ec.entity.getAllEntityNamesWithMaster()"/>
            </actions><widgets>
                <container-box><box-header title="API reference"/><box-body>
                    <section-iterate name="RootResourcesSection" list="rootResources" entry="resource"><widgets>
                        <section name="RootResourceChildren" condition="resource.childMethods &gt; 100"><widgets>
                            <container-dialog id="RootResourceSwaggerDialog_${resource.name}" button-text="${resource.displayName || resource.name} (${resource.childMethods})">
                                <section-iterate name="RootResourceSwaggerSection" list="Object.values(resource.resourceMap)" entry="childResource"><widgets>
                                    <container><link url="/toolstatic/lib/swagger-ui/index.html?url=${restUrl}/service.swagger/${resource.name}/${childResource.name}"
                                                     text="${childResource.displayName || childResource.description || childResource.name} (${childResource.childMethods})"
                                                     url-type="plain" link-type="anchor" target-window="_blank"/></container>
                                </widgets></section-iterate>
                            </container-dialog>
                        </widgets><fail-widgets>
                            <link url="/toolstatic/lib/swagger-ui/index.html?url=${restUrl}/service.swagger/${resource.name}" url-type="plain"
                                  target-window="_blank" text="${resource.displayName || resource.name} (${resource.childMethods})"
                                  tooltip="${resource.description || ''}"/>
                        </fail-widgets></section>
                    </widgets></section-iterate>

                    <container-dialog id="EntitySwagger" button-text="Entity master API">
                        <section-iterate name="EntitySwaggerSection" list="masterEntityNameList" entry="masterEntityName"><widgets>
                            <container><link url="/toolstatic/lib/swagger-ui/index.html?url=${restUrl}/master.swagger/${masterEntityName}" url-type="plain"
                                             text="${masterEntityName}" link-type="anchor" target-window="_blank"/></container>
                        </widgets></section-iterate>
                    </container-dialog>
                    <!-- Generates enough that Swagger UI has a hard time loading it, takes a long time or fails:
                    <link url="/toolstatic/lib/swagger-ui/index.html?url=${restUrl}/master.swagger/all"
                            url-type="plain" target-window="_blank" text="Entity master API"/>
                    -->
                    <label text="Open interactive API documentation in a new tab using your current sign-in. Larger APIs may take a few seconds to load." type="p"/>
                </box-body></container-box>
            </widgets></section>
            </row-col>
        </container-row>
    </widgets>
</screen>
