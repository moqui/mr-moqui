<!-- Mappings that load files, query results and entity data into entities and services (plans/Tools-Database.md §10).
    Left out of the menu until there are mappings to show. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="ETL" default-menu-index="5" default-menu-include="false" menu-image="sym_o_move_down" menu-image-type="icon">
    <always-actions>
        <!-- the database: db, else the last choice, else the default group's (template/DatabaseParts.xml) -->
        <set field="databaseList" from="ec.entity.getDatabaseList()"/>
        <set field="db" from="[db, ec.user.getPreference('database.selected')].find((name) =&gt; databaseList.some((database) =&gt; database.db == name)) || databaseList[0]?.db"/>
        <set field="selectedDatabase" from="databaseList.find((database) =&gt; database.db == db)"/>
    </always-actions>
    <widgets>
        <container-box><box-header title="Data mappings"/><box-body>
            <label text="Saved mappings from files and query results to entities are not available on this server yet. To load an entity data file, use Load in Data." type="p"/>
            <link url="../Data/Load" text="Load data"/>
        </box-body></container-box>
    </widgets>
</screen>
