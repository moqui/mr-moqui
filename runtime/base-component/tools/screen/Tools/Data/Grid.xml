<!-- The records of one entity: a form-list with CSV and XLSX, and the record form (Record.xml). The entity is
    `selectedEntity`, or `entityName` in a link from elsewhere (the Dev AIDE, Schema). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Grid" default-menu-index="1">

    <parameter name="selectedEntity"/>
    <parameter name="entityName"/>

    <transition name="list"><default-response url="../../Schema/Entities"/></transition>
    <transition name="find"><default-response url="."/></transition>
    <transition name="create">
        <actions>
            <if condition="WebUtilities.isRestrictedGenericEntity(selectedEntity)"><message error="true">Entity ${selectedEntity} is not available through this tool</message><return/></if>
            <service-call name="create#${selectedEntity}" in-map="true"/></actions>
        <default-response url="."/>
    </transition>
    <transition name="listSubmit">
        <actions>
            <if condition="WebUtilities.isRestrictedGenericEntity(selectedEntity)"><message error="true">Entity ${selectedEntity} is not available through this tool</message><return/></if>
            <if condition="context.delete">
                <service-call name="delete#${selectedEntity}" in-map="true"/>
            </if>
        </actions>
        <conditional-response url=".">
            <condition><expression>context.delete</expression></condition>
        </conditional-response>
        <default-response url="../Record" parameter-map="ec.entity.getEntityDefinition(selectedEntity).getPrimaryKeys(context)"/>
    </transition>

    <actions>
        <script><![CDATA[
            // `entityName` names the entity only when `selectedEntity` does not; it is not then a field condition
            if (!selectedEntity && entityName) {
                selectedEntity = entityName
                entityName = null
            }
        ]]></script>
        <if condition="!selectedEntity"><return/></if>
        <if condition="WebUtilities.isRestrictedGenericEntity(selectedEntity)"><message error="true">Entity ${selectedEntity} is not available through this tool</message><return/></if>
        <set field="entityDefinition" from="ec.entity.getEntityDefinition(selectedEntity)"/>
        <script><![CDATA[
            // The search, so Edit's Find link returns to it (one per entity, in this session)
            if (ec.web) {
                const kept = {}
                for (const [key, value] of Object.entries(ec.web.requestParameters || {}))
                    if (!['moquiSessionToken', 'lastStandalone', 'selectedEntity', 'entityName'].includes(key) && value != null && value !== '') kept[key] = String(value)
                ec.web.sessionAttributes['toolsEntityFind:' + selectedEntity] = JSON.stringify(kept)
            }
        ]]></script>
        <entity-find entity-name="${selectedEntity}" list="entityValueList" offset="0" limit="50" use-clone="true">
            <search-form-inputs/>
        </entity-find>
    </actions>
    <widgets>
        <section name="ChooseEntity" condition="!selectedEntity"><widgets>
            <container-box><box-header title="Choose an entity"/><box-body>
                <form-single name="ChooseEntityForm" transition=".">
                    <field name="selectedEntity"><default-field title="Entity">
                        <drop-down><list-options list="ec.entity.getAllEntitiesInfo('fullEntityName', null, false, false)"
                                key="${fullEntityName}" text="${fullEntityName}"/></drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Open"><submit/></default-field></field>
                    <field-layout><field-row-big><field-ref name="selectedEntity"/><field-ref name="submitButton"/></field-row-big></field-layout>
                </form-single>
                <link url="list" text="Entity list"/>
            </box-body></container-box>
        </widgets><fail-widgets>
            <container>
                <link url="list" text="Entity List"/>
                <container-dialog id="FindValueDialog" button-text="Find Options">
                    <form-single name="FindEntityValue" transition="find" dynamic="true">
                        <auto-fields-entity entity-name="${selectedEntity}" field-type="find"/>
                        <field name="selectedEntity"><default-field title="Entity Name"><hidden/></default-field></field>
                        <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
                <link url="../../Schema/Entity" parameter-map="{selectedEntity:selectedEntity}" text="Entity Detail"/>
                <container-dialog id="CreateValueDialog" button-text="New Value">
                    <form-single name="CreateEntityValue" transition="create" dynamic="true">
                        <auto-fields-entity entity-name="${selectedEntity}" field-type="edit"/>
                        <field name="selectedEntity"><default-field title="Entity Name"><hidden/></default-field></field>
                        <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
            <container><label text="Find ${entityDefinition.getPrettyName(null, null)} (${selectedEntity})" type="h3"/></container>
            <form-list name="ListEntityValue" list="entityValueList" transition="listSubmit" header-dialog="true" dynamic="true"
                    show-csv-button="true" show-xlsx-button="true" show-page-size="true">
                <hidden-parameters><parameter name="selectedEntity"/></hidden-parameters>
                <field name="find"><header-field title="Find"><submit/></header-field></field>
                <field name="edit"><default-field title="Edit"><submit/></default-field></field>
                <field name="delete"><default-field title="Delete"><submit/></default-field></field>
                <auto-fields-entity entity-name="${selectedEntity}" field-type="find-display"/>
                <columns>
                    <column><field-ref name="edit"/><field-ref name="delete"/></column>
                </columns>
            </form-list>
        </fail-widgets></section>
    </widgets>
</screen>
