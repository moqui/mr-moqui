<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-index="1" menu-image="sym_o_home" menu-image-type="icon" default-menu-title="Home">

    <transition name="reloadEcfi" begin-transaction="false" authz-action="all">
        <actions>
            <script>ec.factory.triggerDynamicReInit()</script>
            <message>ExecutionContextFactory dynamic re-initialize triggered</message>
        </actions>
        <default-response url="."/>
    </transition>

    <!-- the permission checks run here, so a server-static template reads flags from the screen package -->
    <actions>
        <set field="canLoadRunner" from="ec.user.hasPermission('LOAD_RUNNER')"/>
        <set field="canSql" from="ec.user.hasPermission('SQL_RUNNER_WEB')"/>
        <!-- Database › Connections, when the server offers external databases to this user -->
        <script><![CDATA[
            // whether the server offers external databases to this user (find#DatabaseConnections refuses with "Not available"
            // on production or without DATABASE_EXTERNAL); asked only of a DATABASE_EXTERNAL holder
            canExternal = false
            if (ec.user.hasPermission('DATABASE_EXTERNAL')) {
                try { ec.service.sync().name('org.moqui.dev.DatabaseServices.find#DatabaseConnections').call(); canExternal = !ec.message.hasError() } catch (e) { canExternal = false }
                ec.message.clearErrors()
            }
        ]]></script>
    </actions>

    <widgets>
        <container-row>
            <row-col md="4">
                <container-box><box-header title="Data"/><box-body>
                    <label text="Find and edit records, browse related records, build views, and load, export or snapshot data." type="p" style="m-muted"/>
                    <link url="../Data/Grid" text="Records"/>
                    <link url="../Data/Browse" text="Browse related records"/>
                    <link url="../Data/Views" text="Data views"/>
                    <link url="../Data/Load" text="Load data"/>
                    <link url="../Data/Export" text="Export data"/>
                    <link url="../Data/Snapshots" text="Data snapshots"/>
                </box-body></container-box>
                <container-box><box-header title="ETL"/><box-body>
                    <label text="Saved mappings that load a file, a query result or entity data into an entity or a service, run now or on a schedule." type="p" style="m-muted"/>
                    <link url="../Etl/Mappings" text="Mappings"/>
                    <link url="../Etl/Runs" text="Runs"/>
                    <link url="../Etl/ValueMaps" text="Value maps"/>
                </box-body></container-box>
                <section name="SqlSection" condition="canSql"><widgets>
                    <container-box><box-header title="SQL"/><box-body>
                        <label text="Run a statement or a script on a database." type="p" style="m-muted"/>
                        <link url="../Sql" text="SQL"/>
                    </box-body></container-box>
                </widgets></section>
            </row-col>
            <row-col md="4">
                <container-box><box-header title="Schema and database"/><box-body>
                    <label text="Entity definitions and their tables, indexes and keys; the database server, its sessions, statements, tables and jobs." type="p" style="m-muted"/>
                    <link url="../Schema/Entities" text="Entities"/>
                    <link url="../Schema/IndexesKeys" text="Indexes and keys"/>
                    <link url="../Database/Overview" text="Database"/>
                    <link url="../Database/Activity" text="Sessions and activity"/>
                    <link url="../Database/Queries" text="Statement statistics"/>
                    <link url="../Database/Tables" text="Tables"/>
                    <link url="../Database/Jobs" text="Database jobs"/>
                    <link url="../Database/SpeedTest" text="Entity speed test"/>
                    <link url="../Database/Settings" text="Database settings"/>
                    <link url="../Database/Connections" text="External databases" condition="canExternal"/>
                </box-body></container-box>
                <container-box><box-header title="Services and diagnostics"/><box-body>
                    <label text="Inspect service inputs and results, run a service, and see status flows and artifact use." type="p" style="m-muted"/>
                    <link url="../Service" text="Services"/>
                    <link url="../StatusFlows" text="Status flows"/>
                    <link url="../ArtifactStats" text="Artifact statistics"/>
                </box-body></container-box>
                <section name="LoadSection" condition="canLoadRunner"><widgets>
                    <container-box><box-header title="Load testing"/><box-body>
                        <label text="Run a component's load scripts against this server or another, follow a run as it goes, and compare runs." type="p" style="m-muted"/>
                        <link url="../Load/Scripts" text="Load scripts"/>
                        <link url="../Load/Runs" text="Runs"/>
                    </box-body></container-box>
                </widgets></section>
            </row-col>
            <row-col md="4">
            <section name="RestApiSection"><actions>
                <set field="restUrl" from="sri.buildUrl('/rest').url"/>
                <set field="rootResources" from="ec.service.restApi.getFreshRootResources()"/>

                <set field="masterEntityNameList" from="ec.entity.getAllEntityNamesWithMaster()"/>
            </actions><widgets>
                <container-box><box-header title="API reference"/><box-body>
                    <section-iterate name="RootResourcesSection" list="rootResources" entry="resource"><widgets>
                        <section name="RootResourceChildren" condition="resource.childMethods &gt; 100"><widgets>
                            <container-dialog id="RootResourceSwaggerDialog_${resource.name}" button-text="${resource.displayName || resource.name} (${resource.childMethods})">
                                <section-iterate name="RootResourceSwaggerSection" list="Object.values(resource.resourceMap)" entry="childResource"><widgets>
                                    <container><link url="/toolstatic/lib/swagger-ui/index.html?url=${restUrl}/service.swagger/${resource.name}/${childResource.name}"
                                                     text="${childResource.displayName || childResource.description || childResource.name} (${childResource.childMethods})"
                                                     url-type="plain" link-type="anchor" target-window="_blank"/></container>
                                </widgets></section-iterate>
                            </container-dialog>
                        </widgets><fail-widgets>
                            <link url="/toolstatic/lib/swagger-ui/index.html?url=${restUrl}/service.swagger/${resource.name}" url-type="plain"
                                  target-window="_blank" text="${resource.displayName || resource.name} (${resource.childMethods})"
                                  tooltip="${resource.description || ''}"/>
                        </fail-widgets></section>
                    </widgets></section-iterate>

                    <container-dialog id="EntitySwagger" button-text="Entity master API">
                        <section-iterate name="EntitySwaggerSection" list="masterEntityNameList" entry="masterEntityName"><widgets>
                            <container><link url="/toolstatic/lib/swagger-ui/index.html?url=${restUrl}/master.swagger/${masterEntityName}" url-type="plain"
                                             text="${masterEntityName}" link-type="anchor" target-window="_blank"/></container>
                        </widgets></section-iterate>
                    </container-dialog>
                    <!-- Generates enough that Swagger UI has a hard time loading it, takes a long time or fails:
                    <link url="/toolstatic/lib/swagger-ui/index.html?url=${restUrl}/master.swagger/all"
                            url-type="plain" target-window="_blank" text="Entity master API"/>
                    -->
                    <label text="Open interactive API documentation in a new tab using your current sign-in. Larger APIs may take a few seconds to load." type="p"/>
                </box-body></container-box>
            </widgets></section>
            </row-col>
        </container-row>
    </widgets>
</screen>
