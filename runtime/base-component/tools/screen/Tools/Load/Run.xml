<!-- One load run (plans/LoadRunner.md §8, Detail): its header, Stop and Stop now while it runs, Run again, Download
    result and Delete after; the number cards; the charts of requests and errors per second, of p50, p95 and p99, and of
    active users; the table by name; the first errors; the generator and, for a load running on this server, the
    server's CPU load and memory. A run that is not here (no such run, or a load running on another server) is "Not
    available". The browser page is Run.qvue, which asks ../runStatus for the run, and again every 2 seconds while it
    runs; the terminal page is Run.tui.json, the run as it is when shown, with Refresh and the transitions here. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Run" default-menu-include="false" render-modes="vue,qvue,tui" server-static="vue,qvue">

    <parameter name="runId" required="true"/>

    <!-- the terminal's actions; the browser posts to ../stopRun, ../updateUsers and ../deleteRun -->
    <transition name="stop" method="post" begin-transaction="false" authz-action="all">
        <actions><script><![CDATA[
            const stopped = ec.resource.script('component://tools/template/LoadRuns.js').call('stop#LoadRun', {runId: String(runId || ''), now: false})
            if (stopped.error) ec.message.addError(stopped.error)
        ]]></script></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="stopNow" method="post" begin-transaction="false" authz-action="all">
        <actions><script><![CDATA[
            const stopped = ec.resource.script('component://tools/template/LoadRuns.js').call('stop#LoadRun', {runId: String(runId || ''), now: true})
            if (stopped.error) ec.message.addError(stopped.error)
        ]]></script></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="updateUsers" method="post" begin-transaction="false" authz-action="all">
        <actions><script><![CDATA[
            const error = ec.resource.script('component://tools/template/LoadRuns.js').updateUsers(runId, context.scenario, context.users, context.rate)
            if (error) ec.message.addError(error)
            else ec.message.addMessage(ec.resource.expand('${scenario}: ${what} from now on', '', {scenario: String(context.scenario || ''),
                what: context.rate != null && context.rate !== '' ? context.rate + ' per second' : context.users + ' users'}), 'success')
        ]]></script></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="delete" method="post" begin-transaction="false" authz-action="all">
        <actions><script><![CDATA[
            const deleted = ec.resource.script('component://tools/template/LoadRuns.js').call('delete#LoadRun', {runId: String(runId || '')})
            if (deleted.error) ec.message.addError(deleted.error)
        ]]></script></actions>
        <default-response url="../Runs"/>
        <error-response url="."/>
    </transition>

    <widgets>
        <render-mode>
            <text type="qvue" location="component://tools/screen/Tools/Load/Run.qvue" template="false"/>
            <text type="tui" location="component://tools/screen/Tools/Load/Run.tui.json" template="fancy"/>
        </render-mode>
    </widgets>
</screen>
