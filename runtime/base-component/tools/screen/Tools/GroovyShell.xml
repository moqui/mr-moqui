<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-index="3" menu-image="sym_o_code_blocks" menu-image-type="icon">

    <actions>
        <if condition="!ec.user.hasPermission('GROOVY_SHELL_WEB')">
            <return error="true" message="User does not have permission to use Groovy Shell"/></if>
        <if condition="!ec.artifactExecution.isPermitted(sri.getActiveScreenDef().getLocation(), 'AT_XML_SCREEN', 'all')">
            <return error="true" message="User must be authorized for all actions on this screen"/></if>
    </actions>
    <widgets>
        <!-- The Groovy shell is not replaced with a script console and there is no eval endpoint (Implementation-Phases,
            phase 11): the shell's websocket and terminal are not part of this port. -->
        <label text="The Groovy Shell is not available: this port has no Groovy and no script console. Admin access through an SSH server is a later step (plans/archive/Ssh.md)." type="p" style="text-warning"/>
    </widgets>
</screen>
