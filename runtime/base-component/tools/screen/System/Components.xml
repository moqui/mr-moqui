<!-- Components (plans/archive/Component-Deploy.md, Phase 2; guide docs/tools/Component-Deploy.md): the loaded components, the
    ones a deploy loaded with their state (moqui.server.DeployedComponent), and the ones found in a component directory
    that are not loaded (org.moqui.dev.ComponentServices.scan#Components), placed by ./moq component-get or a clone
    since the start. Preview shows what loading one would do (preview#ComponentLoad): why it cannot be loaded now, the
    conf changes of its MoquiConf.xml with their class, its entities, and its data files by type. Load loads it on the
    running server, or with Load at Next Start records it for the next start (load#Component). Remove leaves a deployed
    component out at the next start (remove#Component). Deploy from Git fetches a branch into a repository kept in the
    database, as a bare repository on disk, or as a working clone, and stages its files (preview#ComponentDeploy); the
    staged component shows the same preview, with Deploy (deploy#Component) and Discard (discard#ComponentDeploy). A
    component deployed from git has Check for Update (preview#ComponentUpdate) and Update (update#Component). Where the
    server can restart for this user (a dev instance, restart#Server), Load, Deploy and Update also have a choice that
    restarts the server right after. Load Data loads a loaded component's data files again (load#ComponentData). A
    working clone with changes asks again before Remove sets it aside. Deploying needs the sealed COMPONENT_DEPLOY
    permission, and on a production instance component_deploy_enabled=true. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Components" default-menu-index="20" default-menu-group="Server" menu-image="sym_o_extension" menu-image-type="icon">

    <transition name="loadComponent" authz-action="update">
        <service-call name="org.moqui.dev.ComponentServices.load#Component"
                in-map="{componentName:componentName, mode:mode, dataTypes:dataTypes}" out-map="loadOut"/>
        <actions><if condition="!ec.message.hasError()">
            <if condition="loadOut.restarting"><then>
                <message type="success">${componentName} is loaded at the start the server is restarting into, with its data</message>
            </then><else-if condition="loadOut.report?.status == 'pending-restart'"><then>
                <message type="success">${componentName} is loaded at the next start, with its data</message>
            </then></else-if><else>
                <message type="success">${componentName} loaded: ${loadOut.report?.records ?? 0} records, ${(loadOut.report?.problems || []).length} problems</message>
            </else></if>
        </if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="previewDeploy" authz-action="update">
        <service-call name="org.moqui.dev.ComponentServices.preview#ComponentDeploy" out-map="deployOut"
                in-map="{url:url, branch:branch, storage:storage, directory:directory, username:username, accessToken:accessToken}"/>
        <actions><if condition="!ec.message.hasError()">
            <message type="success">${deployOut.preview?.component} ${(deployOut.preview?.commit || '').substring(0, 12)} is staged; check what deploying it does below</message>
        </if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="deployComponent" authz-action="update">
        <service-call name="org.moqui.dev.ComponentServices.deploy#Component"
                in-map="{componentName:componentName, mode:mode, dataTypes:dataTypes}" out-map="deployOut"/>
        <actions><if condition="!ec.message.hasError()">
            <message type="success">${componentName} deployed (${deployOut.report?.status}${deployOut.restarting ? ', the server is restarting' : ''}): ${deployOut.report?.records ?? 0} records, ${(deployOut.report?.problems || []).length} problems</message>
        </if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="discardDeploy" authz-action="update">
        <service-call name="org.moqui.dev.ComponentServices.discard#ComponentDeploy" in-map="{componentName:componentName}"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="checkUpdate" authz-action="update">
        <service-call name="org.moqui.dev.ComponentServices.preview#ComponentUpdate" in-map="{componentName:componentName}" out-map="updateOut"/>
        <actions><script><![CDATA[
            const preview = updateOut.preview || {}
            if (!ec.message.hasError()) {
                if (preview.from === preview.to) ec.message.addMessage(`${componentName} is up to date`, 'info')
                else ec.message.addMessage(`${componentName}: ${(preview.changed || []).length} files changed from ${(preview.from || '').substring(0, 12)} to ${(preview.to || '').substring(0, 12)}` +
                    ((preview.refusals || []).length ? `; it cannot be updated now: ${preview.refusals.join('; ')}` : '') +
                    (preview.conf?.pendingRestart ? `; ${preview.conf.pendingRestart} conf changes need a restart` : ''), 'warning')
            }
        ]]></script></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="updateComponent" authz-action="update">
        <service-call name="org.moqui.dev.ComponentServices.update#Component" in-map="{componentName:componentName, mode:mode}" out-map="updateOut"/>
        <actions><if condition="!ec.message.hasError()">
            <message type="success">${componentName} updated${updateOut.restarting ? ', the server is restarting' : ''}: ${(updateOut.report?.problems || []).join('; ') || 'no problems'}</message>
        </if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="removeComponent" authz-action="update">
        <service-call name="org.moqui.dev.ComponentServices.remove#Component" in-map="{componentName:componentName, confirmDirty:confirmDirty}" out-map="removeOut"/>
        <actions><if condition="!ec.message.hasError()">
            <if condition="(removeOut.dirty || []).length"><then>
                <message type="warning">${componentName} is a working clone with changes; it was not removed</message>
            </then><else>
                <message type="success">${componentName} is left out at the next start</message>
            </else></if>
        </if></actions>
        <default-response url=".">
            <parameter name="dirtyName" from="(removeOut?.dirty || []).length ? componentName : null"/>
            <parameter name="dirtyChanges" from="(removeOut?.dirty || []).slice(0, 20).join('\n') || null"/></default-response>
        <error-response url="."/>
    </transition>
    <transition name="loadData" authz-action="update">
        <service-call name="org.moqui.dev.ComponentServices.load#ComponentData"
                in-map="{componentName:componentName, dataTypes:dataTypes}" out-map="dataOut"/>
        <actions><if condition="!ec.message.hasError()">
            <message type="${(dataOut.report?.problems || []).length ? 'warning' : 'success'}">${componentName}: ${dataOut.report?.records ?? 0} records loaded, ${(dataOut.report?.problems || []).length} problems</message>
        </if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <parameter name="dataName"/>
    <parameter name="dirtyName"/>
    <parameter name="dirtyChanges"/>
    <actions>
        <set field="loadedList" from="CollectionUtilities.orderMapList(ec.factory.getComponentInfoList(), ['^name'])"/>
        <entity-find entity-name="moqui.server.DeployedComponent" list="deployedList">
            <order-by field-name="componentName"/></entity-find>
        <service-call name="org.moqui.dev.ComponentServices.scan#Components" out-map="scanOut"/>
        <service-call name="org.moqui.dev.ComponentServices.get#PendingRestart" out-map="pendingOut"/>
        <script><![CDATA[
            foundList = scanOut.components || []
            pendingList = pendingOut.changes || []
            restartAllowed = !!pendingOut.restartAllowed
            modeOptions = [{key: 'now', text: 'Now'}, {key: 'restart', text: 'At the next start'}]
                .concat(restartAllowed ? [{key: 'restart-now', text: 'With a restart now'}] : [])
            dirtyList = dirtyChanges ? String(dirtyChanges).split('\n').map((text) => ({text})) : []
            dataComponent = dataName && Array.from(loadedList).some((info) => info.name === dataName) ? dataName : null
            preview = null
            if (componentName && foundList.some((found) => found.name === componentName)) {
                const previewOut = ec.service.sync().name('org.moqui.dev.ComponentServices.preview#ComponentLoad')
                    .parameters({componentName}).call() || {}
                preview = previewOut.preview || null
            }
            refusalList = preview ? (preview.refusals || []).map((text) => ({text})) : []
            confChangeList = preview ? (preview.conf?.changes || []) : []
            const counts = preview ? (preview.dataTypes || {}) : {}
            dataTypeOptions = Object.keys(counts).filter((type) => type !== '(any)')
                .map((type) => ({type, label: `${type} (${counts[type]} files)`}))
            untypedCount = counts['(any)'] || 0
            if (!dataTypes) dataTypes = dataTypeOptions.map((option) => option.type)
                .filter((type) => ['seed', 'seed-initial', 'install'].includes(type))
            entitiesAdded = preview ? (preview.entities?.added || []).join(', ') : ''
            entitiesChanged = preview ? (preview.entities?.changed || []).join(', ') : ''
            // the components a git deploy staged, with the preview kept on their row
            stagedList = Array.from(deployedList).filter((row) => row.status === 'staged').map((row) => {
                let staged = {}
                try { staged = JSON.parse(row.lastReport || '{}') } catch (err) { staged = {} }
                const load = staged.load || {}
                const types = Object.keys(load.dataTypes || {}).filter((type) => type !== '(any)')
                return {componentName: row.componentName, commit: (row.commitId || '').substring(0, 12),
                    remoteUrl: row.remoteUrl, branch: row.branch, storage: row.storage, location: staged.location || row.location,
                    refusals: (load.refusals || []).join('; '), restartNeeded: !!load.restartNeeded,
                    confChanges: (load.conf?.changes || []).length, dataTypeText: types.map((type) => `${type} (${load.dataTypes[type]})`).join(', '),
                    stagedTypes: types.filter((type) => ['seed', 'seed-initial', 'install'].includes(type)).join(',')}
            })
            deployedRows = Array.from(deployedList).filter((row) => row.status !== 'staged')
            storageOptions = [{key: 'database', text: 'Database'}, {key: 'bare', text: 'Bare repository on disk'},
                {key: 'clone', text: 'Working clone in a component directory'}]
        ]]></script>
    </actions>
    <widgets>
        <container-box><box-header title="Found in a Component Directory"/><box-body>
            <section name="FoundSection" condition="foundList.length > 0"><widgets>
                <form-list name="FoundList" list="foundList" skip-form="true">
                    <field name="name"><default-field title="Component"><display/></default-field></field>
                    <field name="version"><default-field><display/></default-field></field>
                    <field name="location"><default-field><display/></default-field></field>
                    <field name="dependsOnNames" from="(dependsOn || []).join(', ')"><default-field title="Depends On"><display/></default-field></field>
                    <field name="previewLink"><default-field title=""><link url="." text="Preview" link-type="anchor">
                        <parameter name="componentName" from="name"/></link></default-field></field>
                </form-list>
            </widgets><fail-widgets>
                <label text="Every component in the component directories is loaded." type="p"/>
            </fail-widgets></section>
        </box-body></container-box>

        <section name="PreviewSection" condition="preview"><widgets>
            <container-box><box-header title="Load ${preview.component} ${preview.version}"/><box-body>
                <label text="${preview.location}" type="p"/>
                <section name="RefusalSection" condition="refusalList.length > 0"><widgets>
                    <label text="It cannot be loaded now:" type="strong"/>
                    <form-list name="RefusalList" list="refusalList" skip-form="true">
                        <field name="text"><default-field title="Reason"><display/></default-field></field>
                    </form-list>
                </widgets></section>
                <label text="New entities: ${entitiesAdded}" type="p" condition="entitiesAdded"/>
                <label text="Entities it changes: ${entitiesChanged}" type="p" condition="entitiesChanged"/>
                <label text="Some of its conf changes need a restart; Load applies the rest now, or load it at the next start."
                        type="p" condition="preview.restartNeeded"/>
                <section name="ConfSection" condition="confChangeList.length > 0"><widgets>
                    <form-list name="ConfChangeList" list="confChangeList" skip-form="true">
                        <field name="unit"><default-field title="Conf"><display/></default-field></field>
                        <field name="attribute"><default-field><display/></default-field></field>
                        <field name="kind"><default-field><display/></default-field></field>
                        <field name="class"><default-field title="Class"><display/></default-field></field>
                        <field name="outcome"><default-field><display/></default-field></field>
                        <field name="reason"><default-field><display/></default-field></field>
                    </form-list>
                </widgets></section>
                <section name="LoadSection" condition="refusalList.length == 0"><widgets>
                    <form-single name="LoadForm" transition="loadComponent">
                        <field name="componentName"><default-field><hidden default-value="${preview.component}"/></default-field></field>
                        <field name="dataTypes"><default-field title="Data to load"
                                tooltip="Data files that declare no type load with any choice">
                            <drop-down allow-multiple="true"><list-options list="dataTypeOptions" key="${type}" text="${label}"/></drop-down>
                        </default-field></field>
                        <field name="mode"><default-field title="When"><radio no-current-selected-key="now">
                            <list-options list="modeOptions" key="${key}" text="${text}"/></radio></default-field></field>
                        <field name="submitButton"><default-field title="Load"><submit/></default-field></field>
                    </form-single>
                </widgets></section>
            </box-body></container-box>
        </widgets></section>

        <container-box><box-header title="Deploy from Git"/><box-body>
            <form-single name="DeployForm" transition="previewDeploy">
                <field name="url"><default-field title="URL" tooltip="https:// or ssh:// (or user@host:path)"><text-line size="60"/></default-field></field>
                <field name="branch"><default-field><text-line size="20" default-value="main"/></default-field></field>
                <field name="storage"><default-field title="Keep it"><drop-down no-current-selected-key="database">
                    <list-options list="storageOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                <field name="directory"><default-field title="Clone into" tooltip="For a working clone: the component directory, component when empty">
                    <text-line size="20"/></default-field></field>
                <field name="username"><default-field><text-line size="20"/></default-field></field>
                <field name="accessToken"><default-field title="Access token"><password size="30"/></default-field></field>
                <field name="submitButton"><default-field title="Fetch and Preview"><submit/></default-field></field>
            </form-single>
            <section name="StagedSection" condition="stagedList.length > 0"><widgets>
                <label text="Staged" type="h6"/>
                <form-list name="StagedList" list="stagedList" skip-form="true">
                    <field name="componentName"><default-field title="Component"><display/></default-field></field>
                    <field name="commit"><default-field><display/></default-field></field>
                    <field name="storage"><default-field><display/></default-field></field>
                    <field name="location"><default-field><display/></default-field></field>
                    <field name="refusals"><default-field title="Cannot deploy now"><display/></default-field></field>
                    <field name="confChanges"><default-field title="Conf changes"><display/></default-field></field>
                    <field name="restartNeeded"><default-field title="Restart needed"><display/></default-field></field>
                    <field name="dataTypeText"><default-field title="Data files"><display/></default-field></field>
                    <field name="deployLink"><default-field title="">
                        <link url="deployComponent" text="Deploy" link-type="hidden-form-link" btn-type="primary" condition="!refusals"
                                confirmation="Deploy ${componentName} now and load its ${stagedTypes || 'seed, seed-initial and install'} data?">
                            <parameter name="componentName"/><parameter name="mode" value="now"/><parameter name="dataTypes" from="stagedTypes"/></link>
                        <link url="deployComponent" text="At Next Start" link-type="hidden-form-link" condition="!refusals">
                            <parameter name="componentName"/><parameter name="mode" value="restart"/><parameter name="dataTypes" from="stagedTypes"/></link>
                        <link url="deployComponent" text="Deploy and Restart" link-type="hidden-form-link" condition="!refusals &amp;&amp; restartAllowed"
                                confirmation="Deploy ${componentName} and restart the server now? Sessions are lost; it loads at the start, with its data.">
                            <parameter name="componentName"/><parameter name="mode" value="restart-now"/><parameter name="dataTypes" from="stagedTypes"/></link>
                        <link url="discardDeploy" text="Discard" link-type="hidden-form-link" btn-type="danger">
                            <parameter name="componentName"/></link>
                    </default-field></field>
                </form-list>
            </widgets></section>
        </box-body></container-box>

        <section name="DirtySection" condition="dirtyName"><widgets>
            <container-box><box-header title="${dirtyName} Has Changes"/><box-body>
                <label type="p" text="This working clone has changes that are not committed or not pushed. Remove moves the directory to .removed/ beside it, with the changes."/>
                <form-list name="DirtyList" list="dirtyList" skip-form="true">
                    <field name="text"><default-field title="Change"><display/></default-field></field>
                </form-list>
                <link url="removeComponent" text="Remove Anyway" link-type="hidden-form" btn-type="danger"
                        parameter-map="{componentName: dirtyName, confirmDirty: 'true'}"/>
                <link url="." text="Cancel" link-type="anchor"/>
            </box-body></container-box>
        </widgets></section>

        <section name="DataSection" condition="dataComponent"><widgets>
            <container-box><box-header title="Load Data of ${dataComponent}"/><box-body>
                <form-single name="LoadDataForm" transition="loadData">
                    <field name="componentName"><default-field><hidden default-value="${dataComponent}"/></default-field></field>
                    <field name="dataTypes"><default-field title="Data types" tooltip="Comma separated; data files that declare no type load with any">
                        <text-line size="40" default-value="seed"/></default-field></field>
                    <field name="submitButton"><default-field title="Load Data"><submit/></default-field></field>
                </form-single>
            </box-body></container-box>
        </widgets></section>

        <container-box><box-header title="Deployed"/><box-body>
            <section name="DeployedSection" condition="deployedRows.length > 0"><widgets>
                <form-list name="DeployedList" list="deployedRows" skip-form="true">
                    <field name="componentName"><default-field title="Component"><display/></default-field></field>
                    <field name="status"><default-field><display/></default-field></field>
                    <field name="source"><default-field><display/></default-field></field>
                    <field name="dataTypes"><default-field title="Data"><display/></default-field></field>
                    <field name="changedDate"><default-field title="Changed"><display/></default-field></field>
                    <field name="location"><default-field><display/></default-field></field>
                    <field name="removeLink"><default-field title="">
                        <link url="checkUpdate" text="Check for Update" link-type="hidden-form-link"
                                condition="source == 'git' &amp;&amp; status == 'deployed'"><parameter name="componentName"/></link>
                        <link url="updateComponent" text="Update" link-type="hidden-form-link" condition="source == 'git' &amp;&amp; status == 'deployed'"
                                confirmation="Update ${componentName} to the head of ${branch} and load its changed seed data?">
                            <parameter name="componentName"/></link>
                        <link url="updateComponent" text="Update and Restart" link-type="hidden-form-link"
                                condition="source == 'git' &amp;&amp; status == 'deployed' &amp;&amp; restartAllowed"
                                confirmation="Update ${componentName}, then restart the server for the changes that wait for a restart? Sessions are lost.">
                            <parameter name="componentName"/><parameter name="mode" value="restart-now"/></link>
                        <link url="removeComponent" text="Remove" link-type="hidden-form-link" btn-type="danger"
                                condition="status != 'removed'"
                                confirmation="Leave ${componentName} out at the next start? Its directory is moved aside; its tables and data stay.">
                            <parameter name="componentName"/></link>
                    </default-field></field>
                </form-list>
            </widgets><fail-widgets>
                <label text="No deployment history: no component has been loaded, deployed or removed from this screen. The components the server started with run as usual; the Overview lists them." type="p"/>
            </fail-widgets></section>
        </box-body></container-box>

        <section name="PendingSection" condition="pendingList.length > 0"><widgets>
            <container-box><box-header title="Conf Waiting for a Restart"/><box-body-nopad>
                <form-list name="PendingList" list="pendingList" skip-form="true">
                    <field name="unit"><default-field title="Conf"><display/></default-field></field>
                    <field name="attribute"><default-field><display/></default-field></field>
                    <field name="reason"><default-field><display/></default-field></field>
                </form-list>
            </box-body-nopad></container-box>
        </widgets></section>

        <container-box><box-header title="Loaded"/><box-body-nopad>
            <form-list name="LoadedList" list="loadedList" skip-form="true">
                <field name="name"><default-field title="Component"><display/></default-field></field>
                <field name="version"><default-field><display/></default-field></field>
                <field name="location"><default-field><display/></default-field></field>
                <field name="dependsOnNames" from="(dependsOn || []).join(', ')"><default-field title="Depends On"><display/></default-field></field>
                <field name="dataLink"><default-field title=""><link url="." text="Load Data" link-type="anchor">
                    <parameter name="dataName" from="name"/></link></default-field></field>
            </form-list>
        </box-body-nopad></container-box>
    </widgets>
</screen>
