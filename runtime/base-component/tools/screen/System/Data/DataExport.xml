<!-- DataExport (plans/Admin-Screens-Down.md; first IronStone Admin's, mr-boss design-admin §11 DataExport): the export of a
    registered domain format, on one page: ExportSelection (the target, then one of the scopes it gives this user and its
    registered options), ExportFields (the registered fields this user may read; one they may not read is named as left
    out and cannot be chosen), ExportReview (the target and its version, the scope, the fields and the owner's count of
    rows, then Export). Everything shown is org.moqui.admin.DataTransferServices' answer for this user (get#ExportContext
    over get#ExportFields and preview#Export), and the export is run#ExportRequest over run#Export: the registration
    alone names what is exported and by which fields, its owner's service runs as this user, and the file is this
    request's response, never stored or sent anywhere. An export here is run with ADMIN_TRANSFER_RUN, besides what the
    target and its owner ask. A target exported in its owner's own place is linked there by the mount's route for the
    registration's ownerRoute (template/AdminMount.js); no entity, field, filter or address is typed here. The screen has
    no part for the instance administrator and its one transition calls only the service, so an app shows it by location
    (README, "Mounting the administration screens"). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Export data" default-menu-index="3" menu-image="sym_o_file_download" menu-image-type="icon">
    <parameter name="targetId"/>
    <parameter name="scopeKey"/>
    <parameter name="option1"/>
    <parameter name="option2"/>
    <parameter name="option3"/>
    <parameter name="fields"/>
    <parameter name="review"/>

    <!-- The export: a posted form, since it keeps a record; the file is the response. A refusal a person can act on comes
        back as a message on the wizard. -->
    <transition name="download">
        <actions>
            <service-call name="org.moqui.admin.DataTransferServices.run#ExportRequest" out-map="exported"
                    in-map="{targetId:targetId, scopeKey:scopeKey, option1:option1, option2:option2, option3:option3, fields:fields,
                        operationKey:operationKey}"/>
            <script><![CDATA[
                if (!ec.message.hasError()) {
                    if (exported?.refused) ec.message.addError(exported.reason || 'The export was refused')
                    else if (exported?.exported) ec.web.sendTextResponse(exported.fileText, exported.contentType, exported.filename)
                    else ec.message.addError('Nothing was exported')
                }
            ]]></script>
        </actions>
        <default-response type="none"/>
        <error-response url=".">
            <parameter name="targetId"/><parameter name="scopeKey"/><parameter name="option1"/><parameter name="option2"/>
            <parameter name="option3"/><parameter name="fields"/>
        </error-response>
    </transition>

    <actions>
        <set field="mount" from="ec.resource.script('component://tools/template/AdminMount.js').state()"/>
        <!-- a refusal is shown as its reason (AdminCalls.read; ignore-error would clear it); what a person can act on is
            answered in out-parameters -->
        <set field="called" from="ec.resource.script('component://framework/service/org/moqui/admin/AdminCalls.js').read('org.moqui.admin.DataTransferServices.get#ExportContext',
                {targetId:(targetId || null), scopeKey:(scopeKey || null), option1:option1, option2:option2, option3:option3,
                    fields:(fields || null), review:(review == 'true' || review === true)}, 'it could not be read')"/>
        <set field="found" from="called.out"/>
        <set field="failure" from="called.failure"/>
        <set field="available" from="!!found?.targetOptions"/>
        <script><![CDATA[
            found = found || {}
            exportTarget = found.exportTarget || {}
            hasTarget = !!found.hasTarget
            mayExport = hasTarget && !!found.canRun && !!exportTarget.exportAllowed
            targetOptions = Array.from(found.targetOptions || [])
            scopeOptions = Array.from(found.scopeOptions || [])
            scopeLabel = exportTarget.scopeLabel || 'Scope'
            const slots = Array.from(found.slotList || [])
            const slot = index => slots[index] || null
            option1Label = slot(0)?.label || ''; option1Choice = !!slot(0)?.isChoice; option1Choices = slot(0)?.choices || []
            option2Label = slot(1)?.label || ''; option2Choice = !!slot(1)?.isChoice; option2Choices = slot(1)?.choices || []
            option3Label = slot(2)?.label || ''; option3Choice = !!slot(2)?.isChoice; option3Choices = slot(2)?.choices || []
            fieldOptions = Array.from(found.fieldOptions || [])
            selectedFields = Array.from(found.selectedFields || [])
            deniedFieldText = found.deniedFieldText || ''
            selectionValues = {targetId: hasTarget ? targetId : null, scopeKey: scopeKey, option1: slot(0)?.value ?? '', option2: slot(1)?.value ?? '',
                option3: slot(2)?.value ?? '', fields: selectedFields}
            preview = found.preview || null
            previewRefusal = found.previewRefusal || ''
            const chosen = (list, value) => (Array.from(list || []).find(option => option.value === value) || {}).label || value || ''
            reviewValues = preview ? {
                targetText: (exportTarget.title || targetId) + (preview.targetVersion ? ' (version ' + preview.targetVersion + ')' : '') + (exportTarget.ownerApp ? ' · ' + exportTarget.ownerApp : ''),
                scopeText: preview.scopeTitle || '',
                optionText: slots.map(found => found.label + ': ' + (found.isChoice ? chosen(found.choices, found.value) : (found.value || 'any'))).join(' · '),
                fieldText: Array.from(preview.fieldList || []).map(field => field.label).join(', '),
                omittedText: Array.from(preview.omittedFieldList || []).map(field => field.label).join(', '),
                countText: preview.rowCount + (preview.rowCount === 1 ? ' row' : ' rows') + ' (at most ' + preview.maxRows + ' in one export)',
                deliveryText: 'A file in your browser, now. It is not stored or sent anywhere; that it was exported, by whom and how many rows is recorded.'} : {}
            exportParameters = {targetId: targetId, scopeKey: scopeKey, option1: selectionValues.option1, option2: selectionValues.option2,
                option3: selectionValues.option3, fields: selectedFields.join(','), operationKey: found.operationKey}
            // with the permissions and nothing to export from, say that; else what is needed
            refusalText = !hasTarget || mayExport ? ''
                : found.canRun && exportTarget.scoped && !scopeOptions.length && !exportTarget.problem
                    ? 'There is nothing for you to export here: it exports ' + scopeLabel.toLowerCase() + 's you may read, and you may read none.'
                    : 'You may not export this: it needs ' + ['ADMIN_TRANSFER_RUN'].concat(String(exportTarget.exportPermission || '').split(',')).filter((name, index, all) => name && all.indexOf(name) === index).join(' and ') + '.'
            // an owner's own place, by the mount's route for the registration's ownerRoute: a plain route by its href, a screen
            // path by its url and parameters. A link carries what its target declares of this screen's context, so this
            // screen's own values are sent empty
            const mountLib = ec.resource.script('component://tools/template/AdminMount.js')
            const ownEmpty = {targetId: '', scopeKey: '', option1: '', option2: '', option3: '', fields: '', review: ''}
            elsewhere = Array.from(found.elsewhereList || []).map(target => {
                const link = (target.ownerRoute ? mountLib.link(mount.routes, target.ownerRoute) : null) || {}
                return Object.assign({}, target, {ownerHref: link.plain ? link.href : '', ownerUrl: link.plain ? '' : link.url || '',
                    ownerParameters: link.plain ? {} : Object.assign({}, ownEmpty, link.parameters || {})})
            })
        ]]></script>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col"><label text="Export data" type="h5"/></container>
            <container style="col-auto"><link url="../Exports" text="Exports" icon="sym_o_list"/></container>
        </container>
        <label text="A registered format of its owner's, with the fields you may read, as a file in your browser. What is exported and by which fields is its owner's registration: nothing else can be named here."
                type="p" style="text-caption m-muted q-mb-none"/>
        <label type="p" style="text-negative" condition="!available" text="Exporting is not available to you: ${failure || 'it could not be read'}."/>
        <section name="DataExportSection" condition="available">
            <widgets>
                <container-box>
                    <box-header title="1. What to export"/>
                    <box-body>
                        <label type="p" style="m-muted" condition="!targetOptions.length" text="No export is registered to be made here."/>
                        <form-single name="ExportSelection" transition="." map="selectionValues">
                            <field name="targetId">
                                <default-field title="Target"><drop-down><list-options list="targetOptions" key="${value}" text="${label}"/></drop-down></default-field>
                            </field>
                            <field name="scopeKey">
                                <conditional-field condition="hasTarget &amp;&amp; !!exportTarget.scoped" title="${scopeLabel}">
                                    <drop-down allow-empty="true"><list-options list="scopeOptions" key="${value}" text="${label}"/></drop-down>
                                </conditional-field>
                                <default-field title=""><hidden/></default-field>
                            </field>
                            <field name="option1">
                                <conditional-field condition="!!option1Label &amp;&amp; option1Choice" title="${option1Label}">
                                    <drop-down><list-options list="option1Choices" key="${value}" text="${label}"/></drop-down>
                                </conditional-field>
                                <conditional-field condition="!!option1Label" title="${option1Label}"><text-line size="30"/></conditional-field>
                                <default-field title=""><hidden/></default-field>
                            </field>
                            <field name="option2">
                                <conditional-field condition="!!option2Label &amp;&amp; option2Choice" title="${option2Label}">
                                    <drop-down><list-options list="option2Choices" key="${value}" text="${label}"/></drop-down>
                                </conditional-field>
                                <conditional-field condition="!!option2Label" title="${option2Label}"><text-line size="30"/></conditional-field>
                                <default-field title=""><hidden/></default-field>
                            </field>
                            <field name="option3">
                                <conditional-field condition="!!option3Label &amp;&amp; option3Choice" title="${option3Label}">
                                    <drop-down><list-options list="option3Choices" key="${value}" text="${label}"/></drop-down>
                                </conditional-field>
                                <conditional-field condition="!!option3Label" title="${option3Label}"><text-line size="30"/></conditional-field>
                                <default-field title=""><hidden/></default-field>
                            </field>
                            <field name="submitButton"><default-field title="${hasTarget ? 'Update' : 'Choose'}"><submit/></default-field></field>
                        </form-single>
                        <label type="p" style="text-warning" condition="!!refusalText" text="${refusalText}"/>
                        <label type="p" style="text-warning" condition="hasTarget &amp;&amp; !!exportTarget.problem" text="${exportTarget.problem}. Try again later."/>
                    </box-body>
                </container-box>
                <section name="ExportFieldsSection" condition="mayExport">
                    <widgets>
                        <container-box>
                            <box-header title="2. Fields"/>
                            <box-body>
                                <label type="p" style="text-caption m-muted" text="${exportTarget.description || ''}"/>
                                <form-single name="ExportFields" transition="." map="selectionValues">
                                    <field name="targetId"><default-field title=""><hidden/></default-field></field>
                                    <field name="scopeKey"><default-field title=""><hidden/></default-field></field>
                                    <field name="option1"><default-field title=""><hidden/></default-field></field>
                                    <field name="option2"><default-field title=""><hidden/></default-field></field>
                                    <field name="option3"><default-field title=""><hidden/></default-field></field>
                                    <field name="review" from="'true'"><default-field title=""><hidden/></default-field></field>
                                    <field name="fields">
                                        <default-field title="Fields to include" tooltip="The fields this export's owner registered that you may read">
                                            <drop-down allow-multiple="true"><list-options list="fieldOptions" key="${value}" text="${label}"/></drop-down>
                                        </default-field>
                                    </field>
                                    <field name="submitButton"><default-field title="Review"><submit/></default-field></field>
                                </form-single>
                                <label type="p" style="text-warning" condition="!!deniedFieldText" text="Not included, because you may not read them: ${deniedFieldText}."/>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <section name="ExportReviewSection" condition="mayExport &amp;&amp; (!!preview || !!previewRefusal)">
                    <widgets>
                        <container-box>
                            <box-header title="3. Review and export"/>
                            <box-toolbar>
                                <link url="download" text="Export" link-type="hidden-form" btn-type="primary" icon="sym_o_download" condition="!!preview &amp;&amp; preview.rowCount &gt; 0"
                                        confirmation="Export ${reviewValues.countText} of ${exportTarget.title} to a file in your browser? That you exported it is recorded."
                                        parameter-map="exportParameters"/>
                            </box-toolbar>
                            <box-body>
                                <label type="p" style="text-warning" condition="!!previewRefusal" text="${previewRefusal}"/>
                                <section name="ExportReviewBody" condition="!!preview">
                                    <widgets>
                                        <form-single name="ExportReview" map="reviewValues">
                                            <field name="targetText"><default-field title="Target"><display/></default-field></field>
                                            <field name="scopeText">
                                                <conditional-field condition="!!reviewValues.scopeText" title="${scopeLabel}"><display/></conditional-field>
                                                <default-field title=""><hidden/></default-field>
                                            </field>
                                            <field name="optionText">
                                                <conditional-field condition="!!reviewValues.optionText" title="Selection"><display/></conditional-field>
                                                <default-field title=""><hidden/></default-field>
                                            </field>
                                            <field name="fieldText"><default-field title="Fields"><display/></default-field></field>
                                            <field name="omittedText">
                                                <conditional-field condition="!!reviewValues.omittedText" title="Left out (you may not read them)"><display/></conditional-field>
                                                <default-field title=""><hidden/></default-field>
                                            </field>
                                            <field name="countText"><default-field title="Rows"><display/></default-field></field>
                                            <field name="deliveryText"><default-field title="Delivery"><display/></default-field></field>
                                        </form-single>
                                        <label type="p" style="m-muted" condition="preview.rowCount == 0" text="Nothing matches, so there is nothing to export."/>
                                        <label type="p" style="text-caption m-muted" text="Larger volumes are not exported here: ask a system administrator, who has tools for volume (Tools' ETL, snapshots and data export)."/>
                                    </widgets>
                                </section>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
                <section name="ExportElsewhereSection" condition="elsewhere.length &gt; 0">
                    <widgets>
                        <container-box>
                            <box-header title="Exported in their owner's own place"/>
                            <box-body>
                                <label type="p" style="text-caption m-muted" text="Each from its owner's own screens, by its owner's permissions."/>
                                <form-list name="ExportElsewhere" list="elsewhere" skip-form="true" paginate="false">
                                    <field name="title">
                                        <conditional-field condition="!!ownerHref" title="Export">
                                            <link url="${ownerHref}" url-type="plain" text="${title}" link-type="anchor" icon="sym_o_open_in_new"/>
                                        </conditional-field>
                                        <conditional-field condition="!!ownerUrl" title="Export">
                                            <link url="${ownerUrl}" text="${title}" link-type="anchor" icon="sym_o_open_in_new" parameter-map="ownerParameters"/>
                                        </conditional-field>
                                        <default-field title="Export"><display/></default-field>
                                    </field>
                                    <field name="ownerApp"><default-field title="Owner"><display/></default-field></field>
                                    <field name="description"><default-field title="What it exports"><display/></default-field></field>
                                </form-list>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
