<!-- ImportDetail (plans/Admin-Screens-Down.md; first IronStone Admin's, mr-boss design-admin §11 ImportDetail): one import
    of a target whose batch is read through the import contract (kept by the framework, or its owner's), from
    org.moqui.admin.DataTransferServices.get#ImportDetail. ImportSummary: the target and its version, the file and its
    content hash, what it is for, the state, the counts, who staged it and when. ImportResults: each row with its result,
    reason, what it made and the attempts, all or only those that need attention, the results and the errors as files
    (results: get#ImportReport, in which a cell a spreadsheet would read as a formula is written as text), and the retry
    of failed rows: the rows named, or every failed row, each validated again and applied on its own by
    retry#ImportItems, which never applies an applied row again; a retry here needs ADMIN_TRANSFER_RUN besides what the
    target asks. An import still open is continued in the wizard the mount gives (the dataImport route,
    template/AdminMount.js); with none there is no link. Read by who staged the import and those its target admits;
    anyone else is told it is not available.
    The screen has no part for the instance administrator. An app that reads the import with data of its own (an
    organization's name, its wizard's context) has a screen of its own: it sets detail (get#ImportDetail's answer, or
    the same names of its own) in its actions, takes in retry and results, and includes ImportDetailView (README,
    "Mounting the administration screens"). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Import" default-menu-include="false">
    <parameter name="targetId" required="true"/>
    <parameter name="operationKey" required="true"/>
    <parameter name="pageIndex"/>
    <parameter name="errorsOnly"/>

    <transition name="retry">
        <actions>
            <!-- this screen's own rule, besides the target's and its owner's: a retry here is made with ADMIN_TRANSFER_RUN -->
            <script>if (!ec.user.hasPermission('ADMIN_TRANSFER_RUN')) throw new Error('ADMIN_TRANSFER_RUN is required')</script>
            <service-call name="org.moqui.admin.DataTransferServices.retry#ImportItems" out-map="result"
                    in-map="{targetId:targetId, operationKey:operationKey, itemSeqIdList:(retryRowIds ? [retryRowIds] : null)}"/>
            <script><![CDATA[
                if (!ec.message.hasError()) {
                    const rows = Array.from(result?.resultList || [])
                    const refused = rows.filter(row => !row.applied)
                    if (result?.appliedCount) ec.message.addMessage(result.appliedCount + ' rows applied', 'success')
                    if (!rows.length) ec.message.addMessage(result?.reason || 'Nothing was retried', 'warning')
                    for (const row of refused.slice(0, 5)) ec.message.addMessage('Row ID ' + row.itemSeqId + ': ' + (row.reason || 'not applied'), 'warning')
                    if (refused.length > 5) ec.message.addMessage((refused.length - 5) + ' more rows were not applied', 'warning')
                }
            ]]></script>
        </actions>
        <default-response url="."><parameter name="targetId"/><parameter name="operationKey"/></default-response>
        <error-response url="."><parameter name="targetId"/><parameter name="operationKey"/></error-response>
    </transition>
    <!-- The import's rows with their results as a file, or only those that need attention: for who may read the import -->
    <transition name="results" read-only="true" method="get">
        <actions>
            <service-call name="org.moqui.admin.DataTransferServices.get#ImportReport" out-map="report"
                    in-map="{targetId:targetId, operationKey:operationKey, errorsOnly:(errorsOnly == 'true' || errorsOnly === true)}"/>
            <script><![CDATA[
                if (ec.message.hasError()) ec.web.sendJsonResponse({})
                else ec.web.sendTextResponse(report.reportCsv, 'text/csv', report.filename)
            ]]></script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <!-- a refusal is not told apart from an import that is not there: either way it is not available -->
        <set field="detail" from="ec.resource.script('component://framework/service/org/moqui/admin/AdminCalls.js').read('org.moqui.admin.DataTransferServices.get#ImportDetail',
                {targetId:targetId, operationKey:operationKey, pageIndex:Math.max(Number(pageIndex) || 0, 0), errorsOnly:(errorsOnly == 'true' || errorsOnly === true)}).out"/>
    </actions>
    <widgets>
        <!-- the import as detail gives it (get#ImportDetail's names; scopeLabel, when set, is what its scope is called); the
            section's actions make what its parts show, so a screen of an app's own that sets detail shares the whole view -->
        <section name="ImportDetailView">
            <actions>
                <script><![CDATA[
                    detail = detail || {}
                    available = !!detail.state
                    onlyErrors = errorsOnly == 'true' || errorsOnly === true
                    // in the server's time zone, as the Imports list
                    const zone = detail.timeZone || 'UTC'
                    const when = value => value == null ? '' : ec.l10n.format(Number(value), 'yyyy-MM-dd HH:mm', null, zone)
                    const stateTexts = {staged: 'Staged', mapped: 'Mapped', validated: 'Validated', applying: 'Applying', complete: 'Complete', partial: 'Partly applied'}
                    importTarget = detail.importTarget || {}
                    scopeLabel = detail.scopeLabel || importTarget.scopeLabel || 'For'
                    summary = {
                        targetText: (importTarget.title || targetId) + (importTarget.targetVersion ? ' (version ' + importTarget.targetVersion + ')' : '') + (importTarget.ownerApp ? ' · ' + importTarget.ownerApp : ''),
                        fileText: [detail.filename, detail.kindDescription && detail.kindDescription !== importTarget.title ? detail.kindDescription : null].filter(Boolean).join(' · '),
                        hashText: String(detail.fileHash || '').slice(0, 16),
                        scopeTitle: detail.scopeTitle || '',
                        stateText: stateTexts[detail.state] || detail.state || '',
                        countText: (detail.rowCount || 0) + ' rows · ' + (detail.appliedCount || 0) + ' applied · ' + (detail.errorCount || 0) + ' need attention' + (detail.skippedCount ? ' · ' + detail.skippedCount + ' skipped' : '') + (detail.validCount ? ' · ' + detail.validCount + ' ready, not applied' : ''),
                        userName: detail.userName || '',
                        periodText: [when(detail.stagedDate) ? 'staged ' + when(detail.stagedDate) : '', when(detail.appliedDate) ? 'applied ' + when(detail.appliedDate) : '', when(detail.completedDate) ? 'completed ' + when(detail.completedDate) : ''].filter(Boolean).join(' · ') + ' (' + zone + ')',
                        lastError: detail.lastError || ''}
                    resultList = Array.from(detail.importRows || []).map(row => Object.assign({}, row, {
                        outcomeText: [row.resultText, row.resultRecordId].filter(Boolean).join(' · '),
                        reasonText: row.errorMessage || row.warningText || ''}))
                    resultPageIndex = Number(detail.pageIndex || 0)
                    resultPageSize = Number(detail.pageSize || 50)
                    resultShown = Number(detail.shownCount ?? detail.rowCount ?? 0)
                    canRetry = !!detail.canEdit && Number(detail.failedCount || 0) > 0
                    // an import still open is continued in the wizard the mount gives: a plain route by its href, a screen path by
                    // its url and parameters (this screen's page and filter sent empty: a link carries what its target declares)
                    const mountLib = ec.resource.script('component://tools/template/AdminMount.js')
                    const wizard = !!detail.canEdit && ['staged', 'mapped', 'validated'].includes(detail.state)
                        ? mountLib.link(mountLib.state().routes, 'dataImport', targetId, {operationKey: operationKey}) : null
                    wizardHref = wizard?.plain ? wizard.href : ''
                    wizardUrl = wizard && !wizard.plain ? wizard.url : ''
                    wizardParameters = wizard && !wizard.plain ? Object.assign({pageIndex: '', errorsOnly: ''}, wizard.parameters || {}) : {}
                    pageParameters = {targetId: targetId, operationKey: operationKey, errorsOnly: (onlyErrors ? true : '')}
                ]]></script>
            </actions>
            <widgets>
                <container style="row items-center q-col-gutter-sm q-mb-sm">
                    <container style="col"><label text="${available ? (summary.fileText || 'Import') : 'Import'}" type="h5"/></container>
                    <container style="col-auto"><link url="../Imports" text="Imports" icon="sym_o_list" parameter-map="{targetId:'', pageIndex:''}"/></container>
                </container>
                <label type="p" style="text-negative" condition="!available" text="This import is not available to you."/>
                <section name="ImportDetailSection" condition="available">
                    <widgets>
                        <container-box>
                            <box-header title="Summary"/>
                            <box-toolbar>
                                <link url="${wizardHref}" url-type="plain" text="Continue in the wizard" link-type="anchor-button" icon="sym_o_upload_file" condition="!!wizardHref"/>
                                <link url="${wizardUrl}" text="Continue in the wizard" link-type="anchor-button" icon="sym_o_upload_file" condition="!!wizardUrl" parameter-map="wizardParameters"/>
                            </box-toolbar>
                            <box-body>
                                <form-single name="ImportSummary" map="summary">
                                    <field name="targetText"><default-field title="Target"><display/></default-field></field>
                                    <field name="fileText"><default-field title="File"><display/></default-field></field>
                                    <field name="hashText"><default-field title="Content hash" tooltip="The start of the SHA-256 of what was staged"><display/></default-field></field>
                                    <field name="scopeTitle"><default-field title="${scopeLabel}"><display/></default-field></field>
                                    <field name="stateText"><default-field title="State"><display/></default-field></field>
                                    <field name="countText"><default-field title="Rows"><display/></default-field></field>
                                    <field name="userName"><default-field title="Staged by"><display/></default-field></field>
                                    <field name="periodText"><default-field title="When"><display/></default-field></field>
                                    <field name="lastError"><default-field title="Attention"><display/></default-field></field>
                                    <field-layout>
                                        <field-row><field-ref name="targetText"/><field-ref name="fileText"/></field-row>
                                        <field-row><field-ref name="scopeTitle"/><field-ref name="stateText"/></field-row>
                                        <field-row><field-ref name="countText"/><field-ref name="lastError"/></field-row>
                                        <field-row><field-ref name="userName"/><field-ref name="periodText"/></field-row>
                                        <field-ref name="hashText"/>
                                    </field-layout>
                                </form-single>
                                <label text="The staged rows of this import were removed after its retention; its outcomes are kept." type="p" style="m-muted" condition="!!detail.purged"/>
                            </box-body>
                        </container-box>
                        <container-box>
                            <box-header title="Results"/>
                            <box-toolbar>
                                <link url="." text="Rows that need attention" link-type="anchor-button" icon="sym_o_report" condition="!onlyErrors" parameter-map="{targetId:targetId, operationKey:operationKey, errorsOnly:true, pageIndex:''}"/>
                                <link url="." text="All rows" link-type="anchor-button" icon="sym_o_list" condition="onlyErrors" parameter-map="{targetId:targetId, operationKey:operationKey, errorsOnly:'', pageIndex:''}"/>
                                <link url="results" text="All results CSV" link-type="anchor-button" icon="sym_o_download" parameter-map="{targetId:targetId, operationKey:operationKey, errorsOnly:false}"/>
                                <link url="results" text="Error CSV" link-type="anchor-button" icon="sym_o_download" parameter-map="{targetId:targetId, operationKey:operationKey, errorsOnly:true}"/>
                            </box-toolbar>
                            <box-body>
                                <section name="RetrySection" condition="canRetry">
                                    <widgets>
                                        <form-single name="RetryImportItems" transition="retry">
                                            <field name="targetId"><default-field title=""><hidden/></default-field></field>
                                            <field name="operationKey"><default-field title=""><hidden/></default-field></field>
                                            <field name="retryRowIds">
                                                <default-field title="Only these row IDs" tooltip="Leave empty to retry every failed row"><text-line size="30"/></default-field>
                                            </field>
                                            <field name="submitButton">
                                                <default-field title="Retry failed rows">
                                                    <submit confirmation="Retry the failed rows of ${importTarget.title}? Each is checked again and applied on its own; a row already applied is not applied again."/>
                                                </default-field>
                                            </field>
                                            <field-layout><field-row-big><field-ref name="retryRowIds"/><field-ref name="submitButton"/></field-row-big></field-layout>
                                        </form-single>
                                    </widgets>
                                </section>
                                <label type="p" style="m-muted" condition="!resultList.length" text="${onlyErrors ? 'No row needs attention.' : 'No rows.'}"/>
                                <form-list name="ImportResults" list="resultList" skip-form="true" paginate="false">
                                    <field name="itemSeqId"><default-field title="Row ID"><display/></default-field></field>
                                    <field name="rowNumber"><default-field title="File row"><display/></default-field></field>
                                    <field name="result"><default-field title="Result"><display/></default-field></field>
                                    <field name="sourceText"><default-field title="Source"><display/></default-field></field>
                                    <field name="proposedText"><default-field title="Values"><display/></default-field></field>
                                    <field name="reasonText"><default-field title="Reason"><display/></default-field></field>
                                    <field name="outcomeText"><default-field title="Made"><display/></default-field></field>
                                    <field name="attemptCount"><default-field title="Attempts"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="itemSeqId"/><field-ref name="result"/><field-ref name="outcomeText"/></column>
                                        <column><field-ref name="sourceText"/><field-ref name="reasonText"/></column>
                                    </columns>
                                </form-list>
                                <container style="row items-center q-gutter-sm">
                                    <link url="." text="Previous rows" link-type="anchor-button" icon="sym_o_chevron_left" condition="resultPageIndex &gt; 0" parameter-map="Object.assign({}, pageParameters, {pageIndex:resultPageIndex - 1})"/>
                                    <label text="Rows ${resultShown ? resultPageIndex * resultPageSize + 1 : 0}–${resultPageIndex * resultPageSize + resultList.length} of ${resultShown}" type="span" style="m-muted"/>
                                    <link url="." text="Next rows" link-type="anchor-button" icon="sym_o_chevron_right" condition="(resultPageIndex + 1) * resultPageSize &lt; resultShown" parameter-map="Object.assign({}, pageParameters, {pageIndex:resultPageIndex + 1})"/>
                                </container>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
