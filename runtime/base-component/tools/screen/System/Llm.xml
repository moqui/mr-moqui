<!-- The models, agents and their usage (plans/LLM-A2A-Assist.md 4.18). Every screen under it needs AgentAdmin; the other
    screens of the plan come with the phases whose data they show. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="LLM and Agents" default-menu-index="16" menu-image="sym_o_psychology" menu-image-type="icon">
    <always-actions>
        <if condition="!ec.user.hasPermission('AgentAdmin')">
            <return error="true" message="User does not have permission to administer the models and agents (AgentAdmin)"/></if>
    </always-actions>
    <subscreens default-item="Dashboard"/>
    <widgets>
        <subscreens-panel id="LlmPanel" type="popup"/>
    </widgets>
</screen>
