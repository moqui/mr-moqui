<!-- Monitor › Settings (plans/archive/Monitor-Settings.md, guide docs/tools/Monitoring.md "Changing settings for a while"): logging
    levels and target rules, sampling, artifact types, metric attributes, operations, browser RUM and the receiver, each
    with its on-disk value beside its value now. A change is in memory on every running instance, expires on its own and
    is gone on restart. Seeing it needs Monitor access; changing it MONITOR_SETTINGS, which the services check. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Settings" default-menu-index="18" menu-image="sym_o_tune" menu-image-type="icon">
    <parameter name="changeKey"/>
    <transition name="setSetting">
        <service-call name="org.moqui.monitor.MonitorServices.set#RuntimeSetting"/>
        <default-response url="."/>
    </transition>
    <transition name="revertSetting">
        <service-call name="org.moqui.monitor.MonitorServices.revert#RuntimeSetting"/>
        <default-response url="."/>
    </transition>
    <transition name="revertAll">
        <service-call name="org.moqui.monitor.MonitorServices.revert#AllRuntimeSettings"/>
        <default-response url="."/>
    </transition>
    <actions><script><![CDATA[
        settingsAllowed = ec.user.hasPermission('MONITOR_SETTINGS')
        const result = ec.service.sync().name('org.moqui.monitor.MonitorServices.list#RuntimeSettings').call() || {}
        instanceId = result.instanceId || ''
        memberCount = result.memberCount || 1
        const now = Date.now()
        const shown = (value, empty) => value === '' || value == null ? empty : String(value)
        const rows = (result.settings || []).map((setting) => {
            const active = setting.override
            const left = active ? Math.max(0, Math.round((active.expiresAt - now) / 60000)) : 0
            const empty = setting.group === 'metrics' ? 'global list' : 'none'
            return {
                key: setting.key,
                group: setting.group,
                settingName: setting.subject && setting.group === 'logging' ? 'Target ' + setting.subject : setting.name,
                onDiskText: shown(setting.onDisk, empty) + ' · ' + setting.source,
                nowText: shown(setting.effective, empty),
                overridden: !!active,
                expiresText: active ? new Date(active.expiresAt).toISOString().slice(0, 16).replace('T', ' ') + ' UTC · in ' + left + ' min' : '',
                setByText: active ? active.setBy + ' · ' + active.reason : '',
                choices: setting.choices || [],
                onDisk: setting.onDisk,
                effective: setting.effective,
            }
        })
        overrideList = rows.filter((row) => row.overridden)
        const groups = [
            ['logging', 'Logging', 'rsipstack is held at WARN. DEBUG and TRACE lines go to the console and the log files, not to Monitor › Logs. A target rule has no on-disk value: reverting it removes it.'],
            ['traces', 'Traces and sampling', 'At sample ratio 0 only request and job roots are kept, with the whole trace of an error or a slow root.'],
            ['artifacts', 'Artifact types', 'Spans, metrics and the sample ratio of each artifact type; an empty sample ratio uses the global one.'],
            ['metrics', 'Metrics', 'The attributes each instrument keeps, comma separated.'],
            ['operations', 'Operations', 'Which service calls count as business operations.'],
            ['browser', 'Browser', 'A tab picks up a change on its next page load.'],
            ['receiver', 'Receiver', 'The OTLP receiver that takes telemetry from other services.'],
        ]
        groupList = groups.map(([groupId, title, note]) => ({groupId, title, note, rows: rows.filter((row) => row.group === groupId)}))
            .filter((group) => group.rows.length > 0)
        selected = changeKey ? rows.find((row) => row.key === changeKey) || null : null
        selectedChoices = selected ? selected.choices.map((choice) => ({choice})) : []
        levelChoices = ['error', 'warn', 'info', 'debug', 'trace'].map((choice) => ({choice}))
    ]]></script></actions>
    <widgets>
        <container style="m-record-header">
            <container style="m-record-title">
                <label text="Settings" type="h5"/>
                <label text="Instance ${instanceId} · ${memberCount} cluster member${memberCount == 1 ? '' : 's'} · changes apply to all running instances" type="p"/>
            </container>
            <container style="m-record-actions">
                <link url="revertAll" text="Revert all" btn-type="danger" link-type="hidden-form" icon="sym_o_undo"
                        condition="settingsAllowed &amp;&amp; overrideList.length &gt; 0"
                        confirmation="Revert all ${overrideList.length} overrides to their on-disk values on every running instance?"/>
            </container>
        </container>
        <label text="On-disk values come from the merged conf (MoquiDefaultConf, the components' MoquiConf, the runtime conf) and moqui_log_level; change them there and deploy. A change here is in memory, expires on its own, and is gone on restart. An instance that starts later has the on-disk values only." type="p"/>
        <section name="ReadOnly" condition="!settingsAllowed"><widgets>
            <label text="Changing these settings needs the MONITOR_SETTINGS permission." type="p"/>
        </widgets></section>

        <section name="ChangeSelected" condition="settingsAllowed &amp;&amp; selected"><widgets>
            <container-dialog id="ChangeSetting" button-text="Change ${selected.settingName}" type="primary"
                    title="Change ${selected.settingName} for a while">
                <label text="This replaces the override now in force and sets a new expiry." type="p" condition="selected.overridden"/>
                <form-single name="ChangeSettingForm" transition="setSetting"
                        map="{key:selected.key, value:selected.effective, minutes:'60'}">
                    <field name="key"><default-field><hidden/></default-field></field>
                    <field name="settingName"><default-field title="Setting"><display text="${selected.settingName}"/></default-field></field>
                    <field name="onDiskText"><default-field title="On disk"><display text="${selected.onDiskText}"/></default-field></field>
                    <field name="value">
                        <conditional-field condition="selectedChoices.length &gt; 0" title="Value">
                            <drop-down><list-options list="selectedChoices" key="${choice}" text="${choice}"/></drop-down>
                        </conditional-field>
                        <default-field title="Value"><text-line size="40"/></default-field>
                    </field>
                    <field name="minutes"><default-field title="For"><drop-down>
                        <option key="15" text="15 minutes"/><option key="60" text="1 hour"/>
                        <option key="240" text="4 hours"/><option key="1440" text="24 hours"/>
                    </drop-down></default-field></field>
                    <field name="reason"><default-field title="Reason"><text-line size="60"/></default-field></field>
                    <field name="submit"><default-field><submit text="Change for a while"/></default-field></field>
                </form-single>
            </container-dialog>
        </widgets></section>

        <section name="Overrides" condition="overrideList.length &gt; 0"><widgets>
            <container-box><box-header title="Active overrides"/><box-body-nopad>
                <form-list name="OverrideList" list="overrideList" skip-form="true">
                    <field name="settingName"><default-field title="Setting"><display/></default-field></field>
                    <field name="onDiskText"><default-field title="On disk"><display/></default-field></field>
                    <field name="nowText"><default-field title="Now"><display/></default-field></field>
                    <field name="setByText"><default-field title="Set by · reason"><display/></default-field></field>
                    <field name="expiresText"><default-field title="Expires"><display/></default-field></field>
                    <field name="actions"><default-field title="">
                        <link url="." text="Extend" link-type="anchor-button" icon="sym_o_schedule" condition="settingsAllowed"
                                parameter-map="{changeKey:key, _openDialog:'ChangeSetting'}"/>
                        <link url="revertSetting" text="Revert to on-disk" link-type="hidden-form" icon="sym_o_undo"
                                condition="settingsAllowed" parameter-map="{key:key}"/>
                    </default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="settingName"/><field-ref name="expiresText"/></column>
                        <column><field-ref name="nowText"/><field-ref name="actions"/></column>
                    </columns>
                </form-list>
            </box-body-nopad></container-box>
        </widgets></section>

        <section-iterate name="Groups" list="groupList" entry="group"><widgets>
            <container-box><box-header title="${group.title}"/>
                <box-toolbar>
                    <container-dialog id="AddTargetRule" button-text="Add a target rule" icon="sym_o_add"
                            condition="settingsAllowed &amp;&amp; group.groupId == 'logging'" title="Add a log target rule for a while">
                        <form-single name="AddTargetRuleForm" transition="setSetting" map="{value:'debug', minutes:'60'}">
                            <field name="target"><default-field title="Target" tooltip="A module path (moqui_core::service) or a dotted target (moqui.monitor.audit); it covers the targets below it">
                                <text-line size="40"/></default-field></field>
                            <field name="value"><default-field title="Level"><drop-down>
                                <list-options list="levelChoices" key="${choice}" text="${choice}"/></drop-down></default-field></field>
                            <field name="minutes"><default-field title="For"><drop-down>
                                <option key="15" text="15 minutes"/><option key="60" text="1 hour"/>
                                <option key="240" text="4 hours"/><option key="1440" text="24 hours"/>
                            </drop-down></default-field></field>
                            <field name="reason"><default-field title="Reason"><text-line size="60"/></default-field></field>
                            <field name="submit"><default-field><submit text="Add the rule for a while"/></default-field></field>
                        </form-single>
                    </container-dialog>
                </box-toolbar>
                <box-body-nopad>
                    <label text="${group.note}" type="p"/>
                    <form-list name="SettingList" list="group.rows" skip-form="true">
                        <field name="settingName"><default-field title="Setting"><display/></default-field></field>
                        <field name="onDiskText"><default-field title="On disk"><display/></default-field></field>
                        <field name="nowText"><default-field title="Now"><display/></default-field></field>
                        <field name="expiresText"><default-field title="Expires"><display/></default-field></field>
                        <field name="actions"><default-field title="">
                            <link url="." text="Change…" link-type="anchor-button" icon="sym_o_edit" condition="settingsAllowed"
                                    parameter-map="{changeKey:key, _openDialog:'ChangeSetting'}"/>
                            <link url="revertSetting" text="Revert to on-disk" link-type="hidden-form" icon="sym_o_undo"
                                    condition="settingsAllowed &amp;&amp; overridden" parameter-map="{key:key}"/>
                        </default-field></field>
                        <columns type="mobile">
                            <column><field-ref name="settingName"/><field-ref name="onDiskText"/></column>
                            <column><field-ref name="nowText"/><field-ref name="actions"/></column>
                        </columns>
                    </form-list>
                </box-body-nopad>
            </container-box>
        </widgets></section-iterate>
    </widgets>
</screen>
