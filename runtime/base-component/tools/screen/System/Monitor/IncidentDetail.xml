<!-- One incident (plans/archive/Monitoring.md, Later: Regressions and incidents; the 3 a.m. incident): what failed and since when,
    its status and severity, the ranked causes with what supports and contradicts each, one timeline of the changes,
    regressions, errors, failing traces, missing telemetry, decisions and notes, its regressions, and its recovery.
    MONITOR_INCIDENT is checked by the services, and each view is logged. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Incident" default-menu-include="false">
    <parameter name="incidentId" required="true"/>
    <transition name="updateIncident">
        <service-call name="org.moqui.monitor.MonitorServices.update#Incident"/>
        <default-response url="."/>
    </transition>
    <transition name="confirmCause">
        <service-call name="org.moqui.monitor.MonitorServices.update#Incident" in-map="{incidentId:incidentId, confirmCauseSeqId:causeSeqId}"/>
        <default-response url="."/>
    </transition>
    <transition name="rejectCause">
        <service-call name="org.moqui.monitor.MonitorServices.update#Incident" in-map="{incidentId:incidentId, rejectCauseSeqId:causeSeqId}"/>
        <default-response url="."/>
    </transition>
    <transition name="addNote">
        <service-call name="org.moqui.monitor.MonitorServices.add#IncidentNote"/>
        <default-response url="."/>
    </transition>
    <transition name="approveDecision">
        <service-call name="org.moqui.monitor.MonitorServices.approve#RecoveryDecision" in-map="{decisionId:decisionId}"/>
        <default-response url="." parameter-map="{incidentId:incidentId}"/>
    </transition>
    <transition name="refuseDecision">
        <service-call name="org.moqui.monitor.MonitorServices.refuse#RecoveryDecision" in-map="{decisionId:decisionId}"/>
        <default-response url="." parameter-map="{incidentId:incidentId}"/>
    </transition>
    <transition name="completeAction">
        <service-call name="org.moqui.monitor.MonitorServices.complete#RecoveryAction" in-map="{actionId:actionId, outcome:outcome}"/>
        <default-response url="." parameter-map="{incidentId:incidentId}"/>
    </transition>
    <transition name="cancelAction">
        <service-call name="org.moqui.monitor.MonitorServices.cancel#RecoveryAction" in-map="{actionId:actionId}"/>
        <default-response url="." parameter-map="{incidentId:incidentId}"/>
    </transition>
    <transition name="revertAction">
        <service-call name="org.moqui.monitor.MonitorServices.revert#RecoveryAction" in-map="{actionId:actionId}"/>
        <default-response url="." parameter-map="{incidentId:incidentId}"/>
    </transition>
    <transition name="releaseDetail"><default-response url="../ReleaseDetail"/></transition>
    <transition name="traces"><default-response url="../Traces"/></transition>
    <actions><script><![CDATA[
        // Incident/recovery JSON exposes entity timestamps as epoch-millisecond strings. Keep the raw values for actions.
        const displayTime = value => {
            if (value == null || value === '') return ec.l10n.localize('Not recorded')
            const date = new Date(/^-?\d+$/.test(String(value)) ? Number(value) : value)
            return Number.isNaN(date.getTime()) ? ec.l10n.localize('Unavailable') : ec.l10n.format(date, 'yyyy-MM-dd HH:mm:ss')
        }
        incidentAllowed = !!ec.user.userId && ec.user.hasPermission('MONITOR_INCIDENT')
        incidentFound = false
        incident = {}
        causeList = []
        evidenceList = []
        regressionList = []
        decisionList = []
        actionList = []
        manualActionList = []
        recoveryStopped = false
        recoverAllowed = ec.user.hasPermission('MONITOR_RECOVER')
        if (incidentAllowed) {
            // Match get#Incident's permission-gated read without catching real service or authorization errors.
            incidentFound = ec.entity.find('moqui.monitor.MonitorIncident').condition('incidentId', incidentId).useCache(false).disableAuthz().one() != null
        }
        if (incidentFound) {
            // Decimals from the entities are not JavaScript numbers.
            const num = value => value == null ? null : typeof value == 'object' && value.toNumber ? value.toNumber() : Number(value)
            const result = ec.service.sync().name('org.moqui.monitor.MonitorServices.get#Incident').parameters({incidentId}).call()
            const original = result.incident || {}
            incident = Object.assign({}, original, {onsetText: displayTime(original.onsetDate), detectedText: displayTime(original.detectedDate)})
            const linkOf = row => row.kind == 'trace' ? '/apps/system/Monitor/TraceDetail?traceId=' + encodeURIComponent(row.refId)
                : row.kind == 'error' ? '/apps/system/Monitor/ErrorDetail?fingerprint=' + encodeURIComponent(row.refId) : ''
            evidenceList = (result.evidence || []).map(row => Object.assign({}, row, {link: linkOf(row), evidenceText: displayTime(row.evidenceDate)}))
            causeList = (result.causes || []).map(row => Object.assign({}, row, {
                support: (row.supporting || []).join('; '), against: (row.contradicting || []).join('; '),
                scoreText: row.score == null ? '' : num(row.score).toFixed(3)}))
            const shown = (metric, value) => value == null ? '' : metric == 'latency_p95' ? num(value).toFixed(3) + ' s' : (num(value) * 100).toFixed(2) + '%'
            regressionList = (result.regressions || []).map(row => Object.assign({}, row, {
                change: shown(row.metric, row.baselineValue) + ' → ' + shown(row.metric, row.candidateValue)}))
            const recovery = result.recovery || {}
            recoveryStopped = !!recovery.stopped
            decisionList = (recovery.decisions || []).map(row => Object.assign({}, row, {
                decidedText: displayTime(row.decidedDate), waiting: row.statusId == 'Proposed' || row.statusId == 'AwaitingApproval'}))
            const manualInstructions = row => {
                if (row.statusId != 'AwaitingOperator') return ''
                // Only Manual adapters enter AwaitingOperator and persist this exact request shape.
                // Never expose controller bodies, callback credentials, or other request JSON fields.
                try {
                    const request = JSON.parse(row.requestJson || '{}')
                    if (request && !Array.isArray(request) && Object.keys(request).length == 1 && typeof request.instructions == 'string') {
                        return request.instructions || ec.l10n.localize('No operator instructions were recorded for this manual action.')
                    }
                } catch (_) { /* The action remains usable even if its stored instructions cannot be read. */ }
                ec.logger.error('Manual recovery instructions unavailable for action ' + row.actionId)
                return ec.l10n.localize('Operator instructions are unavailable. Contact the recovery administrator before marking this action done.')
            }
            actionList = (recovery.actions || []).map(row => Object.assign({}, row, {
                createdText: displayTime(row.createdDate), manualInstructions: manualInstructions(row), active: ['Persisted', 'Running', 'AwaitingOperator'].includes(row.statusId),
                revertible: row.statusId == 'Succeeded' && !!row.undoJson}))
            manualActionList = actionList.filter(row => row.statusId == 'AwaitingOperator')
        }
    ]]></script></actions>
    <widgets>
        <label text="${incident.title || incidentId}" type="h4" style="m-wrap-anywhere"/>
        <render-mode><text type="qvt,html,html-print" template="false"><![CDATA[<div style="width:100%;max-width:1600px">]]></text>
            <text type="tui" template="false">[]</text></render-mode>
        <section name="NotAllowed" condition="!incidentAllowed"><widgets>
            <label text="Incidents need the MONITOR_INCIDENT permission." type="p"/>
        </widgets><fail-widgets>
            <section name="IncidentFound" condition="incidentFound"><widgets>
                <container style="row items-center q-gutter-sm q-mb-md">
                    <link url="../Incidents" text="Back to incidents" link-type="anchor"/>
                    <label text="Incident ${incidentId} · Times shown in ${ec.user.timeZone}." type="span" style="m-muted m-wrap-anywhere"/>
                </container>
                <container-row>
                    <row-col md="8">
                        <container-box><box-header title="Incident context"/><box-body>
                            <label text="${incident.summary || ''}" type="p" condition="incident.summary" style="m-wrap-anywhere"/>
                            <label text="Service: ${incident.serviceName || ec.l10n.localize('Not recorded')}" type="p" style="m-wrap-anywhere"/>
                            <label text="Version: ${incident.version || ec.l10n.localize('Not recorded')}" type="p" style="m-wrap-anywhere"/>
                            <container-row>
                                <row-col md="6"><label text="Onset" type="h6"/><label text="${incident.onsetText}" type="p"/></row-col>
                                <row-col md="6"><label text="Detected" type="h6"/><label text="${incident.detectedText}" type="p"/></row-col>
                            </container-row>
                            <label text="Cause status: ${incident.causeStatus || ec.l10n.localize('Not recorded')}" type="p"/>
                        </box-body></container-box>
                    </row-col>
                    <row-col md="4">
                        <container-box><box-header title="Incident state"/><box-body>
                            <form-single name="UpdateIncident" transition="updateIncident" map="incident">
                                <field name="incidentId"><default-field><hidden/></default-field></field>
                                <field name="statusId"><default-field title="Status"><drop-down>
                                    <option key="Open"/><option key="Mitigating"/><option key="Monitoring"/><option key="Reopened"/><option key="Resolved"/>
                                </drop-down></default-field></field>
                                <field name="severity"><default-field title="Severity"><drop-down>
                                    <option key="minor" text="Minor"/><option key="major" text="Major"/><option key="critical" text="Critical"/>
                                </drop-down></default-field></field>
                                <field name="submit"><default-field><submit text="Update"/></default-field></field>
                                <field-layout>
                                    <field-ref name="incidentId"/>
                                    <field-row><field-ref name="statusId"/><field-ref name="severity"/></field-row>
                                    <field-ref name="submit"/>
                                </field-layout>
                            </form-single>
                        </box-body></container-box>
                    </row-col>
                </container-row>
                <container-box><box-header title="Probable causes"/><box-body>
                    <label text="Causes remain hypotheses until confirmed." type="p" style="m-muted"/>
                    <section name="AvailableCauseList" condition="causeList.length"><widgets>
                        <form-list name="CauseList" list="causeList" skip-form="true">
                            <field name="causeRank"><default-field title="#"><display/></default-field></field>
                            <field name="title"><default-field title="Cause"><display style="m-wrap-anywhere"/></default-field></field>
                            <field name="scoreText"><default-field title="Score"><display/></default-field></field>
                            <field name="support"><default-field title="Supporting"><display style="m-wrap-anywhere"/></default-field></field>
                            <field name="against"><default-field title="Contradicting"><display style="m-wrap-anywhere"/></default-field></field>
                            <field name="statusId"><default-field title="Status"><display/></default-field></field>
                            <field name="confirm"><default-field title="">
                                <link url="confirmCause" text="Confirm" condition="statusId == 'hypothesis'" parameter-map="{incidentId:incidentId, causeSeqId:causeSeqId}"/>
                                <link url="rejectCause" text="Reject" condition="statusId == 'hypothesis'" parameter-map="{incidentId:incidentId, causeSeqId:causeSeqId}"/>
                            </default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="causeRank"/><field-ref name="title"/><field-ref name="scoreText"/><field-ref name="statusId"/></column>
                                <column><field-ref name="support"/><field-ref name="against"/><field-ref name="confirm"/></column>
                            </columns>
                        </form-list>
                    </widgets><fail-widgets>
                        <label text="No probable causes are recorded for this incident." type="p"/>
                    </fail-widgets></section>
                </box-body></container-box>
                <container-row>
                    <row-col md="8">
                        <container-box><box-header title="Timeline"/><box-body>
                            <section name="AvailableEvidenceList" condition="evidenceList.length"><widgets>
                                <form-list name="EvidenceList" list="evidenceList" skip-form="true">
                                    <field name="evidenceDate"><default-field title="When"><display text="${evidenceText}"/></default-field></field>
                                    <field name="kind"><default-field title="What"><display/></default-field></field>
                                    <field name="summary"><default-field title="Detail"><display style="m-wrap-anywhere"/></default-field></field>
                                    <field name="refId"><default-field title="Link">
                                        <link url="${link}" url-type="plain" text="${refId}" style="m-wrap-anywhere" condition="link" link-type="anchor"/>
                                    </default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="evidenceDate"/><field-ref name="kind"/></column>
                                        <column><field-ref name="summary"/><field-ref name="refId"/></column>
                                    </columns>
                                </form-list>
                            </widgets><fail-widgets>
                                <label text="No timeline entries are recorded for this incident." type="p"/>
                            </fail-widgets></section>
                        </box-body></container-box>
                    </row-col>
                    <row-col md="4">
                        <container-box><box-header title="Add a note"/><box-body>
                            <form-single name="AddNote" transition="addNote">
                                <field name="incidentId"><default-field><hidden/></default-field></field>
                                <field name="text"><default-field title="Note"><text-area rows="4" cols="60"/></default-field></field>
                                <field name="submit"><default-field><submit text="Add note"/></default-field></field>
                                <field-layout><field-ref name="incidentId"/><field-ref name="text"/><field-ref name="submit"/></field-layout>
                            </form-single>
                        </box-body></container-box>
                    </row-col>
                </container-row>
                <container-box><box-header title="Recovery"/><box-body>
                    <label text="The emergency stop is on: no recovery action runs." type="p" condition="recoveryStopped"/>
                    <label text="Decisions" type="h6"/>
                    <section name="AvailableDecisionList" condition="decisionList.length"><widgets>
                        <form-list name="DecisionList" list="decisionList" skip-form="true">
                            <field name="decidedDate"><default-field title="Decided"><display text="${decidedText}"/></default-field></field>
                            <field name="action"><default-field title="Next safe action"><display/></default-field></field>
                            <field name="target"><default-field title="Target"><display style="m-wrap-anywhere"/></default-field></field>
                            <field name="adapterId"><default-field title="Adapter"><display style="m-wrap-anywhere"/></default-field></field>
                            <field name="blastRadius"><default-field title="Blast radius"><display style="m-wrap-anywhere"/></default-field></field>
                            <field name="statusId"><default-field title="Status"><display/></default-field></field>
                            <field name="blockedReason"><default-field title="Why automation stopped"><display style="m-wrap-anywhere"/></default-field></field>
                            <field name="approve"><default-field title="">
                                <link url="approveDecision" text="Approve" condition="waiting &amp;&amp; recoverAllowed" parameter-map="{incidentId:incidentId, decisionId:decisionId}" confirmation="Run ${action} ${target || ''} now?"/>
                                <link url="refuseDecision" text="Refuse" condition="waiting &amp;&amp; recoverAllowed" parameter-map="{incidentId:incidentId, decisionId:decisionId}"/>
                            </default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="decidedDate"/><field-ref name="action"/><field-ref name="target"/><field-ref name="adapterId"/><field-ref name="blastRadius"/></column>
                                <column><field-ref name="statusId"/><field-ref name="blockedReason"/><field-ref name="approve"/></column>
                            </columns>
                        </form-list>
                    </widgets><fail-widgets>
                        <label text="No recovery decisions are recorded for this incident." type="p"/>
                    </fail-widgets></section>
                    <label text="Actions" type="h6"/>
                    <section-iterate name="ManualActionInstructions" list="manualActionList" entry="manualAction"><widgets>
                        <container-box><box-header title="Manual action ${manualAction.actionId}"/><box-body>
                            <label text="${manualAction.action} · ${manualAction.target || ec.l10n.localize('No target recorded')}" type="p" style="m-wrap-anywhere"/>
                            <label text="Adapter: ${manualAction.adapterId || ec.l10n.localize('Not recorded')}" type="p" style="m-wrap-anywhere"/>
                            <label text="Operator instructions" type="h6"/>
                            <label text="${manualAction.manualInstructions}" type="pre" encode="true" style="m-wrap-anywhere"/>
                        </box-body></container-box>
                    </widgets></section-iterate>
                    <section name="AvailableActionList" condition="actionList.length"><widgets>
                        <form-list name="ActionList" list="actionList" skip-form="true">
                            <field name="createdDate"><default-field title="Created"><display text="${createdText}"/></default-field></field>
                            <field name="action"><default-field title="Action"><display/></default-field></field>
                            <field name="target"><default-field title="Target"><display style="m-wrap-anywhere"/></default-field></field>
                            <field name="adapterId"><default-field title="Adapter"><display style="m-wrap-anywhere"/></default-field></field>
                            <field name="statusId"><default-field title="Status"><display/></default-field></field>
                            <field name="resultingState"><default-field title="Result"><display style="m-wrap-anywhere"/></default-field></field>
                            <field name="verificationStatus"><default-field title="Verification"><display/></default-field></field>
                            <field name="manage"><default-field title="">
                                <link url="completeAction" text="Mark done" condition="active &amp;&amp; recoverAllowed" parameter-map="{incidentId:incidentId, actionId:actionId, outcome:'done'}"/>
                                <link url="completeAction" text="Mark failed" condition="active &amp;&amp; recoverAllowed" parameter-map="{incidentId:incidentId, actionId:actionId, outcome:'failed'}"/>
                                <link url="cancelAction" text="Cancel" condition="active &amp;&amp; recoverAllowed" parameter-map="{incidentId:incidentId, actionId:actionId}"/>
                                <link url="revertAction" text="Revert" condition="revertible &amp;&amp; recoverAllowed" parameter-map="{incidentId:incidentId, actionId:actionId}" confirmation="Revert ${action} ${target || ''}?"/>
                            </default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="createdDate"/><field-ref name="action"/><field-ref name="target"/><field-ref name="adapterId"/><field-ref name="statusId"/></column>
                                <column><field-ref name="resultingState"/><field-ref name="verificationStatus"/><field-ref name="manage"/></column>
                            </columns>
                        </form-list>
                    </widgets><fail-widgets>
                        <label text="No recovery actions are recorded for this incident." type="p"/>
                    </fail-widgets></section>
                </box-body></container-box>
                <container-box><box-header title="Regressions"/><box-body>
                    <section name="AvailableRegressionList" condition="regressionList.length"><widgets>
                        <form-list name="RegressionList" list="regressionList" skip-form="true">
                            <field name="metric"><default-field title="Metric"><display/></default-field></field>
                            <field name="candidateVersion"><default-field title="Version">
                                <link url="releaseDetail" text="${candidateVersion}" parameter-map="{serviceName:serviceName, version:candidateVersion}" link-type="anchor"/>
                            </default-field></field>
                            <field name="baselineVersion"><default-field title="Against"><display/></default-field></field>
                            <field name="change"><default-field title="Baseline → candidate"><display/></default-field></field>
                            <field name="dataQuality"><default-field title="Data"><display/></default-field></field>
                            <field name="locality"><default-field title="Where"><display/></default-field></field>
                            <field name="statusId"><default-field title="Status"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="metric"/><field-ref name="candidateVersion"/><field-ref name="baselineVersion"/><field-ref name="change"/></column>
                                <column><field-ref name="dataQuality"/><field-ref name="locality"/><field-ref name="statusId"/></column>
                            </columns>
                        </form-list>
                    </widgets><fail-widgets>
                        <label text="No regressions are linked to this incident." type="p"/>
                    </fail-widgets></section>
                </box-body></container-box>
            </widgets><fail-widgets>
                <container-box><box-header title="Incident unavailable"/><box-body>
                    <label text="No incident was found for ID ${incidentId}." type="p" style="m-wrap-anywhere"/>
                    <link url="../Incidents" text="Back to incidents" link-type="anchor"/>
                </box-body></container-box>
            </fail-widgets></section>
        </fail-widgets></section>
        <render-mode><text type="qvt,html,html-print" template="false"><![CDATA[</div>]]></text>
            <text type="tui" template="false">[]</text></render-mode>
    </widgets>
</screen>
