<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-index="1" menu-image="sym_o_home" menu-image-type="icon" default-menu-title="Home">

    <transition name="threadList"><default-response url="../ThreadList"/></transition>

    <actions>
        <set field="smap" from="ec.factory.getStatusMap(true)"/>
        <set field="loadPercent" from="smap.Utilization.LoadPercent"/>
        <set field="componentInfoList" from="CollectionUtilities.orderMapList(ec.factory.getComponentInfoList(), ['^name'])"/>

        <set field="runtimeVersionMap" from="ec.factory.versionMap"/>

        <!-- one pool runs service calls and jobs in this port -->
        <set field="workerPool" from="ec.factory.workerPool"/>

        <!-- Java lists its Elastic clients; the search facade has one backend -->
        <set field="searchBackendName" from="ec.search.backendName()"/>
        <set field="searchAvailable" from="ec.search.isAvailable()"/>

        <!-- request and clock values for the labels, so a server-static template reads them from the screen package -->
        <set field="requestDetails" from="ec.web.getRequestDetails()"/>
        <set field="nowText" from="ec.l10n.format(ec.user.nowTimestamp, null)"/>
        <set field="startedText" from="ec.l10n.format(smap.Runtime.Start, null)"/>
        <set field="memoryUsedText" from="smap.Process.MemoryUsed != null ? ec.l10n.format(smap.Process.MemoryUsed, '#,##0.00') + ' MiB' : ec.l10n.localize('Unavailable')"/>
        <set field="memoryPeakText" from="smap.Process.MemoryPeak != null ? ec.l10n.format(smap.Process.MemoryPeak, '#,##0.00') + ' MiB' : ec.l10n.localize('Unavailable')"/>
        <set field="threadCountText" from="smap.Process.Threads != null ? ec.l10n.format(smap.Process.Threads, '#,##0') : ec.l10n.localize('Unavailable')"/>
        <!-- The status map's load average comes from Linux /proc and is zero-filled on other platforms. -->
        <set field="loadAvailable" from="smap.System.OsName == 'linux'"/>

        <!-- Explore Documents opens the first DataDocument index this user may read (index:<indexName>); with none it opens
            Explore's default. list#Datasets leaves out the indexes whose documents the user's groups may not read. -->
        <script><![CDATA[
            documentDatasetId = null
            try {
                const datasets = ec.service.sync().name('org.moqui.report.ReportServices.list#Datasets').call().datasets || []
                documentDatasetId = (datasets.find(dataset => String(dataset.id).startsWith('index:')) || {}).id || null
            } catch (error) { ec.logger.warn('Explore Documents dataset unavailable: ' + String(error)) }
        ]]></script>
    </actions>
    <widgets>
        <container-box id="SystemInformation">
            <box-header title="Instance overview"/>
            <box-toolbar>
                <link url="../Monitor" text="Open Monitor"/>
                <container-dialog id="RequestHeaders" button-text="Request details">
                    <label text="${requestDetails}" type="pre"/>
                </container-dialog>
                <link url="threadList" text="Threads"/>
            </box-toolbar>
            <box-body>
                <container-row>
                    <row-col md="3" sm="6">
                        <label text="Runtime" type="strong"/>
                        <label text="MR Moqui ${ec.factory.moquiVersion}" type="div"/>
                        <label text="Started: ${startedText}" type="div"/>
                        <label text="Uptime: ${ec.l10n.format(smap.Runtime.UptimeHours, '#,##0.00')} hours" type="div"/>
                    </row-col>
                    <row-col md="3" sm="6">
                        <label text="Host" type="strong"/>
                        <label text="${smap.Web.HostName}" type="div"/>
                        <label text="${smap.System.OsName} ${smap.System.OsVersion}" type="div"/>
                        <label text="${smap.System.CPU} · ${smap.System.Processors} processors" type="div"/>
                        <label text="Load: ${loadAvailable ? ec.l10n.format(loadPercent, '0.0') + '%' : ec.l10n.localize('Unavailable')}"
                                type="div" tooltip="One-minute load average as a percentage of available processors"/>
                    </row-col>
                    <row-col md="3" sm="6">
                        <label text="Process" type="strong"/>
                        <label text="Memory used: ${memoryUsedText}" type="div"/>
                        <label text="Peak memory: ${memoryPeakText}" type="div"/>
                        <label text="Threads: ${threadCountText}" type="div"/>
                        <label text="Process metrics are not reported by this platform." type="div" style="m-muted"
                                condition="smap.Process.MemoryUsed == null &amp;&amp; smap.Process.Threads == null"/>
                    </row-col>
                    <row-col md="3" sm="6">
                        <label text="Workers and search" type="strong"/>
                        <label text="Active workers: ${workerPool.activeCount} of ${workerPool.poolSize} (maximum ${workerPool.maximumPoolSize})"
                                type="div" style="${workerPool.activeCount == workerPool.maximumPoolSize ? 'text-warning' : ''}"/>
                        <label text="Queued: ${workerPool.queueSize} · Available queue capacity: ${workerPool.remainingCapacity}"
                                type="div" style="${workerPool.remainingCapacity == 0 ? 'text-danger' : ''}"/>
                        <label text="Search: ${searchBackendName}${searchAvailable ? '' : ' (unavailable)'}" type="div"/>
                    </row-col>
                </container-row>
                <label text="Updated ${nowText} ${ec.user.timeZone} · Locale ${ec.user.locale}" type="div" style="m-muted q-mt-sm"/>
            </box-body>
        </container-box>

        <container-row>
            <row-col md="4">
                <container-box id="ServerAdmin"><box-header title="Server administration"/><box-body>
                    <label text="Manage the running instance, its components and background work." type="p" style="m-muted"/>
                    <link url="../Components" text="Components"/>
                    <link url="../Conf" text="Configuration"/>
                    <link url="../Cache" text="Caches"/>
                    <link url="../Instance" text="Instances"/>
                    <link url="../ServiceJob/Jobs" text="Service jobs"/>
                    <link url="../ServiceJob/JobRuns" text="Job history"/>
                    <link url="../Print/Printer" text="Printers"/>
                    <link url="../Print/PrintJob" text="Print jobs"/>
                </box-body></container-box>
                <container-box id="Security"><box-header title="Users and access"/><box-body>
                    <label text="Manage accounts, group membership and artifact access." type="p" style="m-muted"/>
                    <link url="../Security/UserAccount" text="Users"/>
                    <link url="../Security/UserGroup" text="User groups"/>
                    <link url="../Security/ArtifactGroup" text="Artifact groups"/>
                    <link url="../Security/ActiveUsers" text="Active users"/>
                </box-body></container-box>
                <container-box id="Usage"><box-header title="Diagnostics and history"/><box-body>
                    <link url="../Monitor/Artifacts" text="Artifact performance"/>
                    <link url="../Monitor/Traces" text="Request traces"/>
                    <link url="../Monitor/Logs" text="Logs"/>
                    <link url="../AuditLog" text="Audit log"/>
                    <link url="../Visit" text="Visits"/>
                </box-body></container-box>
            </row-col>
            <row-col md="4">
                <container-box id="DataDocumentsFeeds"><box-header title="Documents and feeds"/><box-body>
                    <label text="Define document data, maintain indexes and explore results." type="p" style="m-muted"/>
                    <link url="//apps/dashboards/Explore" text="Explore documents" parameter-map="documentDatasetId ? {datasetId:documentDatasetId,from:'now-10y',thru:'now'} : {}"/>
                    <link url="//apps/tools/Data/Documents/Edit" text="Document definitions"/>
                    <link url="//apps/tools/Data/Export" text="Export documents"/>
                    <link url="//apps/tools/Data/Documents/Index" text="Feed indexes"/>
                </box-body></container-box>
                <container-box id="DataAdmin"><box-header title="Resources and localization"/><box-body>
                    <link url="../Resource" text="Resources"/>
                    <link url="../Localization/Messages" text="Localized messages"/>
                    <link url="../Localization/EntityFields" text="Localized entity fields"/>
                </box-body></container-box>
                <container-box id="IntegrationAdmin"><box-header title="Integration messages"/><box-body>
                    <label text="Inspect delivery and configure the systems exchanging data." type="p" style="m-muted"/>
                    <link url="../SystemMessage/Message" text="System messages"/>
                    <link url="../SystemMessage/Remote" text="Remote systems"/>
                    <link url="../SystemMessage/Type" text="Message types"/>
                    <link url="../EntitySync" text="Entity data sync"/>
                </box-body></container-box>
            </row-col>
            <row-col md="4">
                <container-box id="LlmAdmin"><box-header title="Models and agents"/><box-body>
                    <label text="Configure models, tools and the agents' constitution, then inspect activity and approvals." type="p" style="m-muted"/>
                    <link url="../Llm/Dashboard" text="Overview"/>
                    <link url="../Llm/Models" text="Models"/>
                    <link url="../Llm/Tools" text="Tools"/>
                    <link url="../Llm/Runs" text="Runs"/>
                    <link url="../Llm/Approvals" text="Approvals"/>
                    <link url="../Llm/Usage" text="Usage"/>
                    <link url="../Llm/Calls" text="Calls"/>
                    <link url="../Constitution" text="Constitution"/>
                </box-body></container-box>
                <container-box id="EdgeAdmin"><box-header title="Edge connections"/><box-body>
                    <label text="Connect this instance to an edge node and inspect its clients." type="p" style="m-muted"/>
                    <link url="../EdgeNode" text="Edge node"/>
                    <link url="../EdgeClients" text="Edge clients"/>
                </box-body></container-box>
            </row-col>
        </container-row>

        <container-box id="DatabaseConnections"><box-header title="Database connections"/><box-body-nopad>
            <form-list name="DatasourceList" list="smap.DataSources" skip-form="true" paginate="false">
                <field name="group"><default-field title="Entity group"><display/></default-field></field>
                <field name="uniqueName"><default-field title="Connection"><display/></default-field></field>
                <field name="database"><default-field><display/></default-field></field>
                <field name="detail"><default-field title="Pool state"><display/></default-field></field>
                <columns type="mobile">
                    <column><field-ref name="group"/><field-ref name="database"/></column>
                    <column><field-ref name="detail"/></column>
                </columns>
            </form-list>
        </box-body-nopad></container-box>
        <container-box id="LoadedComponents"><box-header title="Loaded components"/><box-toolbar>
            <link url="../Components" text="Manage components"/>
        </box-toolbar><box-body-nopad>
            <label text="Framework: ${runtimeVersionMap.framework.toString()}" condition="runtimeVersionMap?.framework" type="div"/>
            <label text="Runtime: ${runtimeVersionMap.runtime.toString()}" condition="runtimeVersionMap?.runtime" type="div"/>
            <form-list name="ComponentInfoList" list="componentInfoList" skip-form="true" paginate="false">
                <field name="name"><default-field title="Component"><display/></default-field></field>
                <field name="version"><default-field><display/></default-field></field>
                <field name="location"><default-field><display/></default-field></field>
                <field name="versionMap"><default-field title="Version details"><display/></default-field></field>
                <field name="dependsOnNames" from="(dependsOn || []).join(', ')"><default-field title="Dependencies"><display/></default-field></field>
                <form-list-column><field-ref name="name"/><field-ref name="version"/></form-list-column>
                <form-list-column><field-ref name="location"/><field-ref name="versionMap"/></form-list-column>
                <form-list-column><field-ref name="dependsOnNames"/></form-list-column>
                <columns type="mobile">
                    <column><field-ref name="name"/><field-ref name="version"/></column>
                    <column><field-ref name="dependsOnNames"/></column>
                </columns>
            </form-list>
        </box-body-nopad></container-box>
    </widgets>
</screen>
