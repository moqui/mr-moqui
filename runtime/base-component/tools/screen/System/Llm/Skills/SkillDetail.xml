<!-- One skill: its Markdown (a site or personal skill is edited here; a file's text is the file's, so only its lock
    changes), its status, its sections with what each holds, the risk that counts, whether another skill is in effect
    for its name, and its recent uses. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Skill" default-menu-index="2" default-menu-include="false">

    <parameter name="skillId" required="true"/>

    <transition name="skillList"><default-response url="../SkillList"/></transition>
    <transition name="skillDetail"><default-response url="."/></transition>
    <transition name="storeSkill"><service-call name="org.moqui.agent.AgentAdminServices.store#AgentSkill"/>
        <default-response url="."/><error-response url="."/></transition>
    <transition name="runDetail"><default-response url="../../Runs/RunDetail"/></transition>
    <transition name="retrievalTest"><default-response url="../RetrievalTest"/></transition>

    <actions>
        <entity-find-one entity-name="moqui.agent.AgentSkill" value-field="skill"/>
        <if condition="skill">
            <service-call name="org.moqui.agent.AgentAdminServices.get#AgentSkill" in-map="{skillId: skillId}" out-map="detail"/>
            <set field="sectionList" from="detail.sectionList ?? []"/>
            <set field="skillText" from="detail.skillText"/>
            <entity-find entity-name="moqui.agent.AgentSkillUse" list="useList" limit="50">
                <econdition field-name="skillId"/><order-by field-name="-usedDate"/></entity-find>
        </if>
    </actions>
    <widgets>
        <container-box><box-header title="Skill ${skill?.skillName ?? skillId}"/><box-toolbar>
            <link url="skillList" text="All Skills"/>
            <link url="retrievalTest" text="Retrieval Test" condition="skill" parameter-map="{query: skill.title}"/>
            <link url="storeSkill" text="Lock" condition="skill &amp;&amp; skill.locked != 'Y'" parameter-map="{skillId: skillId, locked: 'Y'}"
                    tooltip="A personal skill of this name no longer shadows it"/>
            <link url="storeSkill" text="Unlock" condition="skill &amp;&amp; skill.locked == 'Y'" parameter-map="{skillId: skillId, locked: 'N'}"/>
        </box-toolbar><box-body>
            <section name="MissingSection" condition="!skill"><widgets>
                <label text="There is no skill ${skillId ?? ''}." type="p" style="text-warning"/>
            </widgets><fail-widgets>
                <label text="${skill.title ?? ''}: ${skill.description ?? ''}" type="p"/>
                <label text="From ${skill.sourceLocation}: change the file and sync; here only its lock changes." type="p" condition="skill.sourceLocation"/>
                <label text="Personal skill of ${skill.ownerUserId}: it shadows the site skill of its name unless that one is locked." type="p" condition="skill.ownerUserId"/>
                <label text="Not in effect: another skill of this name counts (${detail.inEffectSkillId ?? 'none, it is not published or not allowed'})." type="p" style="text-warning"
                        condition="detail.inEffectSkillId != skillId"/>
                <label text="Source ${skill.provenance ?? ''}, version ${skill.versionNum ?? 1}, ${skill.useCount ?? 0} uses, risk ${detail.risk ?? ''} (only a skill a person wrote lowers a risk), body ${detail.bodyChars ?? 0} characters." type="p"/>
                <form-single name="SkillForm" transition="storeSkill" condition="!skill.sourceLocation">
                    <field name="skillId"><default-field><hidden/></default-field></field>
                    <field name="skillText"><default-field title="Skill" tooltip="Markdown with front matter; a front matter error is shown and nothing is saved">
                        <text-area rows="24" cols="100"/></default-field></field>
                    <field name="statusId" from="skill.statusId"><default-field title="Status"><drop-down allow-empty="false">
                        <entity-options key="${statusId}" text="${description}"><entity-find entity-name="moqui.basic.StatusItem">
                            <econdition field-name="statusTypeId" value="AgentSkill"/><order-by field-name="sequenceNum"/></entity-find></entity-options>
                    </drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-single>
                <label text="${skillText ?? ''}" type="pre" encode="true" condition="skill.sourceLocation"/>
            </fail-widgets></section>
        </box-body></container-box>
        <section name="Detail1Section" condition="skill"><widgets><container-box><box-header title="Sections"/><box-body>
            <label text="skill(name) sends the whole body under 6,000 characters, else the text before the first section and these contents; skill(name#section) sends one." type="p"/>
            <form-list name="SectionList" list="sectionList" skip-form="true">
                <field name="slug"><default-field title="Load As"><display/></default-field></field>
                <field name="title"><default-field><display/></default-field></field>
                <field name="purpose"><default-field><display/></default-field></field>
                <field name="chars"><default-field title="Characters"><display/></default-field></field>
            </form-list>
        </box-body></container-box></widgets></section>
        <section name="Detail2Section" condition="skill"><widgets><container-box><box-header title="Recent Uses"/><box-body>
            <form-list name="UseList" list="useList" skip-form="true">
                <field name="usedDate"><default-field title="Used"><display/></default-field></field>
                <field name="sectionName"><default-field title="Section" tooltip="Empty: the head and contents; *: the whole body"><display/></default-field></field>
                <field name="runId"><default-field title="Run"><link url="runDetail" text="${runId}" link-type="anchor" condition="runId"/></default-field></field>
                <field name="conversationId"><default-field title="Conversation"><display/></default-field></field>
                <field name="outcome"><default-field><display/></default-field></field>
            </form-list>
        </box-body></container-box></widgets></section>
    </widgets>
</screen>
