<!-- Pair with an edge node and set this node up with it (plans/Edge-Node.md §5.7; style-guide §3.10 Wizard): a
    subscreens-panel type="wizard" over the steps in Pair/: EdgeUrl (the edge node's address and the pairing code its
    operator made; Next connects and checks its certificate), Connect (its name, link key fingerprint and versions to
    confirm; Next pairs, pinning that fingerprint, and waits for the link), Discover (what the edge node offers, as a
    filled-out form of the areas this node uses it for), Apply (this node's rows and settings, the edge node's part,
    and the DNS records to set, each checked live) and Test (each area end to end; Finish shows the status). Between
    the steps the URL carries the address only. The pairing code is a secret: it is kept in the session for Connect,
    as the Chat apps screen keeps a new app password, and never put in a URL; Discover's choices are kept in the
    session too. Status links to Discover to set a paired node up again. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Pair" default-menu-index="2" default-menu-include="false">

    <parameter name="url"/>
    <subscreens default-item="EdgeUrl"/>

    <widgets>
        <container style="row items-center q-mb-sm">
            <label type="h5" text="Set up an edge node" style="q-my-none"/>
            <container style="col"/>
            <link url="../Status" text="Edge node" icon="sym_o_cloud_sync"/>
        </container>
        <subscreens-panel id="PairEdgeNodeWizard" type="wizard" finish-text="Finish"/>
    </widgets>
</screen>
