<!-- Edge Node status (plans/Edge-Node.md §5.7): the link's state, generation, round trip, last connect, links lost and last
    error, and the edge node as its last Hello said (name, the pinned fingerprint of its link key, versions, public names). Unpair
    (org.moqui.impl.EdgeServices.unpair#EdgeNode) revokes this node's key on the edge node and removes the link's settings
    from runtime/.env. Queue and replication (§5.2, get#QueueStatus): this node's outbox by kind (waiting, failed, the
    oldest), and each replicated set's epoch, last batch acknowledged and changes waiting; Pause (pause#QueueDelivery)
    holds queue delivery both ways until Resume, and Resync (resync#Replication) sends every set whole again. Not paired: the way to the Pair wizard. A build without the edge link (state notBuilt), a process
    where it is not running (notStarted: no HTTPS listener started it), and an edge node see a notice instead. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Status" default-menu-index="1" default-menu-include="false">

    <transition name="pauseDelivery">
        <service-call name="org.moqui.impl.EdgeServices.pause#QueueDelivery" in-map="{paused:paused}" out-map="pauseOut"/>
        <actions><if condition="!ec.message.hasError()"><then>
            <if condition="pauseOut?.paused"><then><message type="warning">Queue delivery is paused until you resume it</message></then>
                <else><message type="success">Queue delivery resumed</message></else></if>
        </then></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="resyncReplication">
        <service-call name="org.moqui.impl.EdgeServices.resync#Replication" out-map="resyncOut"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Every replicated set goes to the edge node whole again</message></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="unpair">
        <service-call name="org.moqui.impl.EdgeServices.unpair#EdgeNode"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Unpaired: the link to the edge node is closed</message></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions><script><![CDATA[
        const L = (text) => ec.l10n.localize(text)
        const link = ec.service.sync().name('org.moqui.impl.EdgeServices.get#LinkStatus').call() || {}
        const state = link.state || 'unpaired'
        notBuilt = state === 'notBuilt'
        notStarted = state === 'notStarted'
        const running = !notBuilt && !notStarted
        isEdge = running && link.nodeRole === 'edge'
        paired = running && !isEdge && state !== 'unpaired'
        unpaired = running && !isEdge && state === 'unpaired'
        const states = {connecting: [L('Connecting'), 'info'], linked: [L('Linked'), 'positive'], retrying: [L('Retrying'), 'warning'],
            refused: [L('Refused'), 'negative']}
        const [stateLabel, stateColor] = states[state] || [state, 'grey']
        const list = (items) => Array.from(items || []).join(', ')
        incompatibleMessage = paired && link.compatible === false ? link.message || '' : ''
        lastError = link.lastError || ''
        refusedState = paired && state === 'refused'
        edge = {edgeName: link.edgeName || link.url || L('Edge node'), stateLabel, stateColor,
            url: link.url || '',
            generationText: link.generation ? String(link.generation) : '',
            rttText: link.rttMs != null ? ec.l10n.format(link.rttMs, '#,##0.0') + ' ms' : '',
            lastConnectText: link.lastConnectDate ? ec.l10n.format(link.lastConnectDate, '') : L('Not yet'),
            reconnectsText: String(link.reconnects ?? 0),
            fingerprint: link.fingerprint || '',
            versionText: link.binaryVersion ? link.binaryVersion + (link.linkVersion ? ' · ' + L('link') + ' ' + link.linkVersion : '') : '',
            publicNamesText: list(link.publicNames),
            featuresText: list(link.features)}
        // the queue and replication (plans/Edge-Node.md §5.2): this node's own rows and state, with or without the
        // link; a probe (Practices-App-Dev §4), so a failure shows on the page instead of failing it
        let work = {}
        queueError = ''
        if (paired) {
            ec.message.pushErrors()
            try {
                work = ec.service.sync().name('org.moqui.impl.EdgeServices.get#QueueStatus').call() || {}
                if (ec.message.hasError()) queueError = ec.message.getErrorsString()
            } finally {
                ec.message.clearErrors()
                ec.message.popErrors()
            }
        }
        queuePaused = !!work.paused
        const age = (seconds) => seconds == null ? '' : seconds < 120 ? seconds + ' s'
            : seconds < 7200 ? Math.round(seconds / 60) + ' min' : Math.round(seconds / 3600) + ' h'
        // a local node's own items all go to the edge node
        kindList = Array.from(work.kindList || []).filter((kind) => kind.directionEnumId === 'EqdToEdge')
            .map((kind) => ({kind: kind.kind, pendingText: String(kind.pending ?? 0),
                failedText: String(kind.failed ?? 0), oldestText: age(kind.oldestAgeSeconds)}))
        setList = Array.from(work.setList || []).map((set) => ({setName: set.setName,
            epochText: set.epoch ? String(set.epoch).slice(0, 8) : '', ackedText: String(set.acked ?? 0),
            waitingText: String(set.waiting ?? 0),
            stateLabel: set.snapshotNeeded ? L('Full send due') : L('Up to date'),
            stateColor: set.snapshotNeeded ? 'warning' : 'positive',
            lastAckText: set.lastAckDate ? ec.l10n.format(set.lastAckDate, '') : L('Not yet')}))
    ]]></script></actions>
    <widgets>
        <section name="NotBuilt" condition="notBuilt"><widgets>
            <container-box><box-header title="Edge node"/><box-body>
                <label type="p" text="This build has no edge link. The Maximal and Enterprise packages have it." style="q-mb-none"/>
            </box-body></container-box>
        </widgets></section>

        <section name="NotStarted" condition="notStarted"><widgets>
            <container-box><box-header title="Edge node"/><box-body>
                <label type="p" text="The edge link starts with the HTTPS listener, and it is not running in this process." style="q-mb-none"/>
            </box-body></container-box>
        </widgets></section>

        <section name="IsEdge" condition="isEdge"><widgets>
            <container-box><box-header title="Edge node"/><box-body>
                <label type="p" text="This node is an edge node. Local nodes pair with it in Edge Clients."/>
                <link url="../../EdgeClients" text="Edge clients" icon="sym_o_lan"/>
            </box-body></container-box>
        </widgets></section>

        <section name="Unpaired" condition="unpaired"><widgets>
            <container-box><box-header title="Edge node"/><box-body>
                <label type="p" text="This node is not paired with an edge node. An edge node is a small server in the cloud that gives this node a public presence. This node dials out to it and keeps one link open, so it needs no open port or fixed address."/>
                <label type="p" text="Make a pairing code on the edge node, in System, Edge Clients, then pair with it here." style="m-muted"/>
                <link url="../Pair" text="Pair with an edge node" icon="sym_o_add_link" btn-type="primary"/>
            </box-body></container-box>
        </widgets></section>

        <section name="Paired" condition="paired"><widgets>
            <container style="m-record-header">
                <container style="row items-start q-col-gutter-x-md q-col-gutter-y-sm">
                    <container style="col-12 col-md m-record-title">
                        <label type="h5" text="${edge.edgeName}"/>
                        <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="m-tonal text-${edge.stateColor}">]]></text><text type="tui" template="false">[]</text></render-mode>
                        <label type="span" text="${edge.stateLabel}"/>
                        <render-mode><text type="qvt"><![CDATA[</q-chip>]]></text><text type="tui" template="false">[]</text></render-mode>
                        <label type="div" text="${edge.url}" style="text-caption m-muted"/>
                    </container>
                    <container style="col-12 col-md-auto row items-center q-gutter-y-xs m-record-actions">
                        <link url="." text="Refresh" icon="sym_o_refresh"/>
                        <link url="unpair" link-type="hidden-form" text="Unpair" icon="sym_o_link_off" btn-type="danger"
                                confirmation="Unpair from ${edge.edgeName}? The link closes on both sides, and pairing again needs a new code."/>
                    </container>
                </container>
            </container>
            <section name="Incompatible" condition="incompatibleMessage"><widgets>
                <container-box type="warning"><box-body>
                    <label type="p" text="${incompatibleMessage}" style="q-mb-none"/>
                </box-body></container-box>
            </widgets></section>
            <section name="Refused" condition="refusedState"><widgets>
                <container-box type="danger"><box-header title="The link is refused"/><box-body>
                    <label type="p" text="${lastError || 'This node stopped linking to the edge node.'}"/>
                    <label type="p" text="This node stops when the edge node's link key no longer matches its pin, and the edge node refuses this node when it was revoked there. Unpair, make a new pairing code on the edge node, and pair again." style="m-muted q-mb-none"/>
                </box-body></container-box>
            </widgets></section>
            <section name="LastError" condition="lastError &amp;&amp; !refusedState &amp;&amp; edge.stateColor != 'positive'"><widgets>
                <container-box type="warning"><box-header title="Last error"/><box-body>
                    <label type="p" text="${lastError}" style="q-mb-none"/>
                </box-body></container-box>
            </widgets></section>
            <container-box><box-header title="Link"/><box-body>
                <form-single name="LinkStatus" map="edge">
                    <field name="rttText"><default-field title="Round trip"><display/></default-field></field>
                    <field name="lastConnectText"><default-field title="Last connect"><display/></default-field></field>
                    <field name="generationText"><default-field title="Generation" tooltip="Goes up by one each time the link comes up"><display/></default-field></field>
                    <field name="reconnectsText"><default-field title="Links lost" tooltip="Since this server started"><display/></default-field></field>
                    <field name="versionText"><default-field title="Edge node version"><display/></default-field></field>
                    <field name="fingerprint"><default-field title="Link key fingerprint" tooltip="The SHA-256 of the edge node's link key, pinned at pairing; a renewed web certificate does not change it"><display/></default-field></field>
                    <field name="publicNamesText"><default-field title="Public names"><display/></default-field></field>
                    <field name="featuresText"><default-field title="Features"><display/></default-field></field>
                    <field-layout>
                        <field-row><field-ref name="rttText"/><field-ref name="lastConnectText"/></field-row>
                        <field-row><field-ref name="generationText"/><field-ref name="reconnectsText"/></field-row>
                        <field-row><field-ref name="versionText"/><field-ref name="publicNamesText"/></field-row>
                        <field-ref name="fingerprint"/>
                        <field-ref name="featuresText"/>
                    </field-layout>
                </form-single>
            </box-body></container-box>
            <container-box><box-header title="Queue and replication"/><box-toolbar>
                <link url="pauseDelivery" link-type="hidden-form" text="Pause delivery" icon="sym_o_pause"
                        condition="!queuePaused" parameter-map="{paused:'true'}"
                        confirmation="Pause queue delivery? Items wait on both nodes until you resume it."/>
                <link url="pauseDelivery" link-type="hidden-form" text="Resume delivery" icon="sym_o_play_arrow"
                        condition="queuePaused" parameter-map="{paused:'false'}"/>
                <link url="resyncReplication" link-type="hidden-form" text="Resync" icon="sym_o_sync"
                        confirmation="Send every replicated set to the edge node whole again?"/>
            </box-toolbar><box-body-nopad>
                <section name="QueueError" condition="queueError"><widgets>
                    <label type="p" text="${queueError}" style="text-negative q-pa-sm q-mb-none"/>
                </widgets></section>
                <section name="QueuePaused" condition="queuePaused"><widgets>
                    <label type="p" style="text-warning q-pa-sm q-mb-none"
                            text="Queue delivery is paused: items wait on both nodes until it resumes."/>
                </widgets></section>
                <label type="p" style="m-muted q-pa-sm q-mb-none"
                        text="Items this node queued for the edge node, by kind. Each goes once, in order."/>
                <form-list name="KindList" list="kindList" skip-form="true" paginate="false">
                    <field name="kind"><default-field title="Kind">
                        <display style="text-weight-medium"/></default-field></field>
                    <field name="pendingText" align="right"><default-field title="Waiting">
                        <display/></default-field></field>
                    <field name="failedText" align="right"><default-field title="Failed">
                        <display/></default-field></field>
                    <field name="oldestText" align="right"><default-field title="Oldest waiting">
                        <display/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="kind"/><field-ref name="failedText"/></column>
                        <column><field-ref name="pendingText"/><field-ref name="oldestText"/></column>
                    </columns>
                </form-list>
                <section name="NoKinds" condition="!kindList.length"><widgets>
                    <label type="p" text="Nothing is waiting for the edge node." style="m-muted q-pa-sm q-mb-none"/>
                </widgets></section>
                <label type="p" style="m-muted q-pa-sm q-mb-none"
                        text="Replicated sets: records the edge node answers from while this node is away."/>
                <form-list name="SetList" list="setList" skip-form="true" paginate="false">
                    <field name="setName"><default-field title="Set">
                        <display style="text-weight-medium"/></default-field></field>
                    <field name="state"><default-field title="State"><render-mode>
                        <text type="qvt"><![CDATA[<q-chip dense square
                            class="q-ma-none m-tonal text-${stateColor}">${stateLabel}</q-chip>]]></text>
                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateLabel})}]]></text>
                    </render-mode></default-field></field>
                    <field name="epochText"><default-field title="Epoch" tooltip="Each full send starts a new one">
                        <display/></default-field></field>
                    <field name="ackedText" align="right"><default-field title="Last batch"
                            tooltip="The last batch the edge node acknowledged in this epoch">
                        <display/></default-field></field>
                    <field name="waitingText" align="right"><default-field title="Changes waiting">
                        <display/></default-field></field>
                    <field name="lastAckText"><default-field title="Last acknowledged">
                        <display/></default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="setName"/><field-ref name="lastAckText"/></column>
                        <column><field-ref name="state"/><field-ref name="waitingText"/></column>
                    </columns>
                </form-list>
                <section name="NoSets" condition="!setList.length"><widgets>
                    <label type="p" style="m-muted q-pa-sm q-mb-none"
                            text="No replicated sets in this node's edge conf, or none since the link started."/>
                </widgets></section>
            </box-body-nopad></container-box>
        </widgets></section>
    </widgets>
</screen>
