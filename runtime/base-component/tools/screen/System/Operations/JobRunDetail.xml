<!-- JobRunDetail (plans/Admin-Screens-Down.md; first IronStone Admin's, mr-boss design-admin §10): one run of a job, from
    org.moqui.admin.OperationServices.get#JobRun. RunEvidence: its job, who started it (a person or
    the scheduler), its times in the machine's time zone, where it ran, its state, the class of its failure with up to five
    masked lines, the numbers among its results and the names of what else it answered; the names of its parameters, with a
    value only where it is a number, a yes or no, or a parameter its owner registered as safe. Its trace opens in Monitor only
    for a user System's own grant opens (Monitor is a section of System); for the others its id is shown and nothing is
    linked: the page grants nothing. RunItems: what each independent item of the run came to, by the job's owner (the registered
    provider); a run with failed items is never shown as a success; an item that is itself recovered here (a system message)
    links its own page, and a successful item is never replayed. Reading needs ADMIN_OPERATION_VIEW, checked by the service.
    For the instance administrator (README, "Mounting the administration screens"): RawRun, the run as it is stored, with its
    parameters, results, messages and errors whole, and its logs in Monitor: read only, shown only where there is no mount. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Job run" default-menu-include="false">
    <parameter name="jobRunId" required="true"/>

    <actions>
        <service-call name="org.moqui.admin.OperationServices.get#JobRun" out-map="found" transaction="force-new" ignore-error="true"
                in-map="{jobRunId:jobRunId}"/>
        <!-- ignore-error clears a refusal's message -->
        <set field="recordFound" from="!!found?.run"/>
        <script>ec.message.clearErrors()</script>
        <set field="mount" from="ec.resource.script('component://tools/template/AdminMount.js').state()"/>
        <if condition="mount.raw">
            <entity-find-one entity-name="moqui.service.job.ServiceJobRun" value-field="serviceJobRun"/>
        </if>
        <script><![CDATA[
            const colors = {failed: 'negative', itemsFailed: 'deep-orange', stopped: 'deep-orange', running: 'info', waiting: 'info', succeeded: 'positive'}
            const itemColors = {failed: 'negative', uncertain: 'deep-orange', waiting: 'info', done: 'positive'}
            const when = value => value ? ec.l10n.format(Date.parse(value), 'yyyy-MM-dd HH:mm:ss', null, run.timeZone) : ''
            const duration = value => value == null ? '' : value < 1000 ? value + ' ms' : value < 120000 ? Math.round(value / 1000) + ' s' : Math.round(value / 60000) + ' min'
            run = found?.run || {}
            stateColor = colors[run.state] || 'grey-7'
            // Monitor is a section of System and opens by System's own grant: the link is shown to those it opens to, asked of
            // the user's own authorization records, since a mounting app's inheritable grant would answer the stack's question
            // for everyone
            const monitorOpen = ec.artifactExecution.isPermittedOwn('component://tools/screen/System.xml')
            traceOpen = monitorOpen && !!run.traceId
            // the telemetry screens take ISO-8601 times; a minute either side of the run keeps clock rounding out of the way,
            // and a run still going ends now
            const isoTime = (value, shift) => {
                const millis = value ? Date.parse(value) : NaN
                return Number.isFinite(millis) ? new Date(millis + shift).toISOString() : null
            }
            traceParameters = {traceId: run.traceId, from: isoTime(run.startTime, -60000) || 'now-7d', thru: isoTime(run.endTime, 60000) || 'now'}
            logParameters = {queryString: run.runThread ? 'thread.name:' + JSON.stringify(String(run.runThread)) : '',
                from: isoTime(run.startTime, 0) || 'now-1d', thru: isoTime(run.endTime, 1000) || 'now'}
            const itemRoute = mount.routes.systemMessage
            evidence = recordFound ? [
                {label: 'Job', value: run.title + (run.title !== run.jobName ? ' (' + run.jobName + ')' : '')},
                {label: 'Owner', value: run.ownerApp || 'Not registered'},
                {label: 'Started by', value: run.startedBy},
                {label: 'Started', value: run.startTime ? when(run.startTime) + ' (' + run.timeZone + ')' : 'Not started'},
                {label: 'Ended', value: when(run.endTime)},
                {label: 'Took', value: duration(run.durationMs)},
                {label: 'Ran on', value: [run.hostName, run.instanceId, run.runThread].filter(Boolean).join(' · ')},
                {label: 'Holds the job\u2019s lock', value: run.isLockHolder ? 'Yes: the job does not start again while it does' : ''},
                {label: 'Failure', value: run.errorClass},
                {label: 'Result counts', value: Array.from(run.countList || []).map(count => count.name + ' ' + count.value).join(' · ')},
                {label: 'Also answered', value: Array.from(run.otherResultList || []).join(', ') ? Array.from(run.otherResultList).join(', ') + ' (not shown)' : ''},
                {label: 'Messages', value: run.messageLineCount ? run.messageLineCount + ' lines (not shown)' : ''},
                {label: 'Trace', value: run.traceId && !traceOpen ? run.traceId + ' (in Monitor, which opens by System\u2019s own grant)' : ''}
            ].filter(row => row.value) : []
            errorLines = Array.from(run.errorLineList || []).map(line => ({line: line}))
            parameters = Array.from(found?.parameterList || [])
            // an item that is recovered on a page of its own: a system message by the mount's route for one, a job beside this screen
            const itemRoutes = {SystemMessage: id => itemRoute ? {url: itemRoute.url, parameters: Object.assign({}, itemRoute.parameters || {}, {[itemRoute.idParameter]: id})} : null,
                ServiceJob: id => ({url: '../JobDetail', parameters: {jobName: id}})}
            items = Array.from(found?.itemList || []).map(row => {
                const route = row.recoveryTargetId && Object.hasOwn(itemRoutes, row.recoveryKind || '') ? itemRoutes[row.recoveryKind](row.recoveryTargetId) : null
                return Object.assign({}, row, {stateColor: itemColors[row.state] || 'grey-7', itemUrl: route?.url || '', itemParameters: route?.parameters || {},
                    detailText: [row.reason, row.nextStep].filter(Boolean).join(' · ')})
            })
        ]]></script>
    </actions>
    <widgets>
        <section name="RunUnavailable" condition="!recordFound">
            <widgets>
                <label type="p" style="text-negative" text="This run is not available to you, or there is no such run."/>
                <link url="../JobRuns" text="Job runs" link-type="anchor"/>
            </widgets>
        </section>
        <section name="RunFound" condition="recordFound">
            <widgets>
                <container style="row items-center q-col-gutter-sm q-mb-sm">
                    <container style="col">
                        <label text="Run ${run.jobRunId}" type="h5"/>
                        <label text="${run.title}" type="p" style="text-caption m-muted q-mb-none"/>
                    </container>
                    <container style="col-auto">
                        <render-mode>
                            <text type="qvt"><![CDATA[<q-chip square class="q-ma-none m-tonal text-${stateColor}">${run.stateText}</q-chip>]]></text>
                            <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: run.stateText})}]]></text>
                            <text type="html">${run.stateText}</text>
                        </render-mode>
                    </container>
                    <container style="col-auto">
                        <link url="//apps/system/Monitor/TraceDetail" text="Trace in Monitor" icon="sym_o_account_tree" condition="traceOpen"
                                parameter-map="traceParameters"/>
                        <link url="../JobDetail" text="Job" icon="sym_o_schedule" parameter-map="{jobName:run.jobName}" condition="run.jobFound"/>
                        <link url="../JobRuns" text="Runs" icon="sym_o_arrow_back" parameter-map="{jobName:run.jobName}"/>
                    </container>
                </container>

                <container-box>
                    <box-header title="Evidence"/>
                    <box-body>
                        <form-list name="RunEvidence" list="evidence" skip-form="true" paginate="false">
                            <field name="label"><default-field title=""><display/></default-field></field>
                            <field name="value"><default-field title=""><display/></default-field></field>
                        </form-list>
                        <section name="RunErrors" condition="errorLines.length">
                            <widgets>
                                <label type="p" style="text-caption m-muted q-mt-sm"
                                        text="What was recorded${run.errorLineCount &gt; errorLines.length ? ' (the first ' + errorLines.length + ' of ' + run.errorLineCount + ' lines)' : ''}; addresses, paths and tokens are struck out"/>
                                <form-list name="RunErrorLines" list="errorLines" skip-form="true" paginate="false">
                                    <field name="line"><default-field title=""><display/></default-field></field>
                                </form-list>
                            </widgets>
                        </section>
                        <section name="RunParameters" condition="parameters.length">
                            <widgets>
                                <label type="p" style="text-caption m-muted q-mt-sm" text="Started with"/>
                                <form-list name="RunParameterList" list="parameters" skip-form="true" paginate="false">
                                    <field name="name"><default-field title="Parameter"><display/></default-field></field>
                                    <field name="valueText"><default-field title="Value"><display/></default-field></field>
                                </form-list>
                            </widgets>
                        </section>
                    </box-body>
                </container-box>

                <container-box>
                    <box-header title="Items"/>
                    <box-body>
                        <label type="p" style="m-muted" condition="!found.itemsAvailable" text="${found.itemsReason}."/>
                        <label type="p" style="m-muted" condition="found.itemsAvailable"
                                text="${found.itemsOwnerApp}: ${found.itemCount} ${found.itemCount === 1 ? 'item' : 'items'}${run.failedItemCount ? ', ' + run.failedItemCount + ' failed' : ''}${found.itemCount &gt; items.length ? '; the failed first, ' + items.length + ' shown' : ''}. An item that went through is not repeated from here."/>
                        <form-list name="RunItems" list="items" skip-form="true" paginate="false">
                            <field name="title">
                                <default-field title="Item">
                                    <link url="${itemUrl}" text="${title}" link-type="anchor" condition="itemUrl" parameter-map="itemParameters"/>
                                    <label text="${title}" condition="!itemUrl"/>
                                </default-field>
                            </field>
                            <field name="stateText">
                                <default-field title="State">
                                    <render-mode>
                                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${stateText}</q-chip>]]></text>
                                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                        <text type="html">${stateText}</text>
                                    </render-mode>
                                </default-field>
                            </field>
                            <field name="detailText"><default-field title="Reason and next step"><display/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </widgets>
        </section>
        <section name="RawRun" condition="mount.raw &amp;&amp; serviceJobRun">
            <widgets>
                <label text="Instance administrator" type="h6" style="q-mt-md q-mb-none"/>
                <label type="p" style="text-caption m-muted" text="The run as it is stored: its parameters, results, messages and errors whole."/>
                <container-box><box-header title="Stored run"/><box-toolbar>
                    <link url="//apps/system/Monitor/Logs" text="Logs in Monitor" icon="sym_o_subject" parameter-map="logParameters"/>
                </box-toolbar><box-body>
                    <form-single name="ServiceJobRunDetail" map="serviceJobRun">
                        <field name="userId">
                            <conditional-field condition="userId" title="Started by">
                                <display-entity entity-name="moqui.security.UserAccount" text="${username} - ${userFullName}"/>
                                <link url="../../Security/UserAccount/UserAccountDetail" text="${userId}" link-type="anchor" parameter-map="{userId:userId}"/>
                            </conditional-field>
                            <default-field title="Started by"><display text="Not recorded"/></default-field>
                        </field>
                        <field name="hasError"><default-field title="Error recorded"><display text="${hasError === 'Y' ? 'Yes' : hasError === 'N' ? 'No' : 'Not recorded'}"/></default-field></field>
                        <field name="errors"><default-field><display text="${errors || 'No error details recorded'}" style="m-wrap-anywhere"/></default-field></field>
                        <field name="results"><default-field><display text="${results || 'No results recorded'}" style="m-wrap-anywhere"/></default-field></field>
                        <field name="messages"><default-field><display text="${messages || 'No messages recorded'}" style="m-wrap-anywhere"/></default-field></field>
                        <field name="parameters"><default-field><display text="${parameters || 'No parameters recorded'}" style="m-wrap-anywhere"/></default-field></field>
                        <field name="hostAddress"><default-field><display text="${hostAddress || 'Not recorded'}" style="m-wrap-anywhere"/></default-field></field>
                        <field name="runThread"><default-field><display text="${runThread || 'Not recorded'}" style="m-wrap-anywhere"/></default-field></field>
                        <field name="traceId"><default-field><display text="${traceId || 'Not recorded'}" style="m-wrap-anywhere"/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </widgets>
        </section>
    </widgets>
</screen>
