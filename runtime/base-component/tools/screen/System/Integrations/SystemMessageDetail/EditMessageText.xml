<!-- EditMessageText (plans/Admin-Screens-Down.md): a system message's text edited directly, in a dialog of
    SystemMessageDetail's part for the instance administrator (RawMessage). It is System's alone: an app that shows
    SystemMessageDetail at a location of its own has no such subscreen, the text is read only where raw is true (README,
    "Mounting the administration screens") and the transition carries raw() as its condition. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit message text" default-menu-include="false" standalone="true">
    <parameter name="systemMessageId" required="true"/>

    <transition name="updateMessage">
        <condition><expression>ec.resource.script('component://tools/template/AdminMount.js').raw()</expression></condition>
        <service-call name="update#moqui.service.message.SystemMessage"/>
        <default-response url=".."/>
    </transition>

    <actions>
        <set field="mount" from="ec.resource.script('component://tools/template/AdminMount.js').state()"/>
        <if condition="mount.raw">
            <entity-find-one entity-name="moqui.service.message.SystemMessage" value-field="systemMessage"/>
        </if>
    </actions>
    <widgets>
        <section name="EditText" condition="mount.raw &amp;&amp; systemMessage">
            <widgets>
                <form-single name="SystemMessageForm" map="systemMessage" transition="updateMessage">
                    <field name="systemMessageId"><default-field title="ID"><display/></default-field></field>
                    <field name="messageText"><default-field title="Message text"><text-area cols="100" rows="30"/></default-field></field>
                    <field name="submitButton"><default-field title="Update message text"><submit/></default-field></field>
                </form-single>
            </widgets>
            <fail-widgets>
                <label type="p" style="text-negative" text="This message's text is not available to you, or there is no such message."/>
            </fail-widgets>
        </section>
    </widgets>
</screen>
