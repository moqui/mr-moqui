<!-- Operations (plans/Admin-Screens-Down.md): the instance's scheduled jobs and their runs, and the notification topics, over
    org.moqui.admin.OperationServices, which check ADMIN_OPERATION_VIEW and ADMIN_OPERATION_MANAGE themselves. Its screens are
    the files of Operations/, with the sibling names an app that shows them under its own root uses (README, "Mounting the
    administration screens"), so their links to each other are relative. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Operations" default-menu-index="6" default-menu-group="Administration" menu-image="sym_o_monitor_heart" menu-image-type="icon">
    <subscreens default-item="Jobs"/>
    <widgets>
        <subscreens-panel id="SystemOperationsPanel" type="tab"/>
    </widgets>
</screen>
