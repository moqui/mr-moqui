<!-- Edge Clients (plans/Edge-Node.md §5.7): on an edge node (node_role=edge), the local nodes paired with it and their links
    (org.moqui.impl.EdgeServices.get#EdgeClients): state, generation, last connect, address and versions. Ping sends a
    Ping down a node's down connection and shows the round trip; Revoke ends its key and closes its link. Make a pairing
    code (create#PairingCode) shows the code once, after the redirect, as the Chat apps screen shows a new app password;
    only its hash is kept. Near the top is this edge node's link key fingerprint (get#LinkStatus linkFingerprint), for the
    operator to compare with what a local node's Connect step shows. On a node that is not an edge node, and in a build
    without the edge link or a process where it is not running (no HTTPS listener started it), a notice instead. The menu cannot leave this screen out by node role, so it is listed on
    every node. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edge Clients" default-menu-index="18" menu-image="sym_o_lan" menu-image-type="icon">

    <transition name="makePairingCode">
        <service-call name="org.moqui.impl.EdgeServices.create#PairingCode" in-map="{validMinutes:validMinutes}" out-map="codeOut"/>
        <actions><!-- shown once, after the redirect -->
            <script>if (!ec.message.hasError()) { ec.web.sessionAttributes.newEdgePairingCode = codeOut.code ?? ''; ec.web.sessionAttributes.newEdgePairingExpire = codeOut.expireDate ? ec.l10n.format(codeOut.expireDate, '') : '' }</script></actions>
        <default-response url="."/><error-response url="."/>
    </transition>
    <transition name="revokeClient">
        <service-call name="org.moqui.impl.EdgeServices.revoke#EdgeClient" in-map="{pairedNodeId:pairedNodeId}" out-map="revokeOut"/>
        <actions><if condition="!ec.message.hasError()"><then>
            <if condition="revokeOut?.revoked"><then><message type="success">Revoked: the node's link is closed</message></then>
                <else><message type="warning">No such node is paired</message></else></if>
        </then></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="pingClient">
        <service-call name="org.moqui.impl.EdgeServices.ping#EdgeClient" in-map="{pairedNodeId:pairedNodeId}" out-map="pingOut"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Round trip to ${pairedNodeId}: ${ec.l10n.format(pingOut.rttMs, '#,##0.0')} ms</message></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions><script><![CDATA[
        const L = (text) => ec.l10n.localize(text)
        newCode = ec.web.sessionAttributes.remove('newEdgePairingCode') || null
        newCodeExpire = ec.web.sessionAttributes.remove('newEdgePairingExpire') || ''
        const link = ec.service.sync().name('org.moqui.impl.EdgeServices.get#LinkStatus').call() || {}
        notBuilt = link.state === 'notBuilt'
        notStarted = link.state === 'notStarted'
        notEdge = !notBuilt && !notStarted && link.nodeRole !== 'edge'
        isEdge = !notBuilt && !notStarted && !notEdge
        clientList = []
        clientsError = ''
        // empty when the HTTPS listener is off: the link key is loaded with it
        linkKey = {linkFingerprint: isEdge ? link.linkFingerprint || '' : ''}
        if (!isEdge) return
        // a probe (Practices-App-Dev §4): an edge node whose HTTPS listener is off takes no links, and the page says so
        let out = {}
        ec.message.pushErrors()
        try {
            out = ec.service.sync().name('org.moqui.impl.EdgeServices.get#EdgeClients').call() || {}
            if (ec.message.hasError()) clientsError = ec.message.getErrorsString()
        } finally {
            ec.message.clearErrors()
            ec.message.popErrors()
        }
        if (clientsError) return
        clientList = Array.from(out.clientList || []).map((client) => {
            const revoked = client.statusId === 'EdgeClientRevoked'
            const [stateLabel, stateColor] = revoked ? [L('Revoked'), 'negative']
                : client.linked && client.down ? [L('Linked'), 'positive']
                : client.linked ? [L('Connecting'), 'info'] : [L('Offline'), 'grey']
            return {pairedNodeId: client.pairedNodeId, stateLabel, stateColor, revoked, linked: !!client.linked && !!client.down,
                generationText: client.generation ? String(client.generation) : '',
                lastConnectText: client.lastConnectDate ? ec.l10n.format(client.lastConnectDate, '') : L('Never'),
                remoteAddress: client.remoteAddress || '',
                versionText: (client.binaryVersion || '') + (client.linkVersion ? ' · ' + L('link') + ' ' + client.linkVersion : ''),
                keyFingerprint: client.keyFingerprint || '',
                keyShort: client.keyFingerprint ? String(client.keyFingerprint).slice(0, 16) + '…' : ''}
        })
    ]]></script></actions>
    <widgets>
        <section name="NotBuilt" condition="notBuilt"><widgets>
            <container-box><box-header title="Edge clients"/><box-body>
                <label type="p" text="This build has no edge link. The Maximal and Enterprise packages have it." style="q-mb-none"/>
            </box-body></container-box>
        </widgets></section>
        <section name="NotStarted" condition="notStarted"><widgets>
            <container-box><box-header title="Edge clients"/><box-body>
                <label type="p" text="The edge link starts with the HTTPS listener, and it is not running in this process." style="q-mb-none"/>
            </box-body></container-box>
        </widgets></section>
        <section name="NotEdge" condition="notEdge"><widgets>
            <container-box><box-header title="Edge clients"/><box-body>
                <label type="p" text="This node is not an edge node, so no local nodes pair with it. An edge node runs with node_role set to edge (conf/MoquiEdgeConf.xml). To pair this node with an edge node, use Edge Node."/>
                <link url="../EdgeNode" text="Edge node" icon="sym_o_cloud_sync"/>
            </box-body></container-box>
        </widgets></section>

        <section name="EdgeClients" condition="isEdge"><widgets>
            <container style="row items-center q-mb-sm">
                <label type="h6" text="Edge clients" style="q-my-none"/>
                <container style="col"/>
                <container-dialog id="PairingCodeDialog" button-text="Make a pairing code" icon="sym_o_key" width="480" title="Make a pairing code" type="primary">
                    <form-single name="PairingCode" transition="makePairingCode">
                        <field name="validMinutes"><default-field title="Good for"><drop-down no-current-selected-key="60">
                            <option key="15" text="15 minutes"/>
                            <option key="60" text="An hour"/>
                            <option key="240" text="4 hours"/>
                            <option key="1440" text="A day"/>
                        </drop-down></default-field></field>
                        <field name="submitButton"><default-field title="Make the code"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
            <section name="ClientsError" condition="clientsError"><widgets>
                <container-box type="warning"><box-header title="This edge node takes no links"/><box-body>
                    <label type="p" text="${clientsError}" style="q-mb-none"/>
                </box-body></container-box>
            </widgets></section>
            <label type="p" style="m-muted" text="Local nodes paired with this edge node. A local node pairs in its own System, Edge Node, with a pairing code made here."/>
            <section name="LinkKey" condition="linkKey.linkFingerprint"><widgets>
                <container-box><box-body>
                    <form-single name="LinkKey" map="linkKey">
                        <field name="linkFingerprint"><default-field title="This edge node's link key fingerprint" tooltip="The SHA-256 of this edge node's link key. A local node shows it in its Pair step before it pairs: check that the two match"><display/></default-field></field>
                    </form-single>
                </box-body></container-box>
            </widgets></section>

            <section name="NewCode" condition="newCode"><widgets>
                <container-box type="success"><box-header title="Pairing code"/><box-body>
                    <label type="p" text="Enter it on the local node now, with this node's address. It pairs one node, once, until ${newCodeExpire}. It is shown only this once; make another if you lose it."/>
                    <label type="pre" text="${newCode}" style="text-h6"/>
                </box-body></container-box>
            </widgets></section>

            <container-box><box-body-nopad>
                <form-list name="ClientList" list="clientList" skip-form="true" paginate="false">
                    <field name="pairedNodeId"><default-field title="Node"><display style="text-weight-medium"/></default-field></field>
                    <field name="state"><default-field title="State">
                        <render-mode><text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${stateLabel}</q-chip>]]></text><text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateLabel})}]]></text></render-mode>
                    </default-field></field>
                    <field name="generationText"><default-field title="Generation"><display/></default-field></field>
                    <field name="lastConnectText"><default-field title="Last connect"><display/></default-field></field>
                    <field name="remoteAddress"><default-field title="Address"><display/></default-field></field>
                    <field name="versionText"><default-field title="Version"><display/></default-field></field>
                    <field name="keyShort"><default-field title="Key" tooltip="The start of the SHA-256 of the node's key, pinned at pairing"><display/></default-field></field>
                    <field name="tools" align="right"><default-field title="">
                        <link url="pingClient" link-type="hidden-form-link" icon="sym_o_network_ping" text="Ping" style="m-btn-flat"
                                condition="linked" parameter-map="{pairedNodeId:pairedNodeId}"/>
                        <link url="revokeClient" link-type="hidden-form-link" icon="sym_o_block" text="Revoke" style="m-btn-flat" btn-type="danger"
                                condition="!revoked" confirmation="Revoke ${pairedNodeId}? Its link closes, and it can link again only by pairing with a new code."
                                parameter-map="{pairedNodeId:pairedNodeId}"/>
                    </default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="pairedNodeId"/><field-ref name="lastConnectText"/></column>
                        <column><field-ref name="state"/><field-ref name="tools"/></column>
                    </columns>
                </form-list>
                <section name="NoClients" condition="!clientList.length"><widgets>
                    <label type="p" text="No local node is paired yet. Make a pairing code, then pair on the local node." style="m-muted q-pa-sm q-mb-none"/>
                </widgets></section>
            </box-body-nopad></container-box>
        </widgets></section>
    </widgets>
</screen>
