<!-- Conf (guide docs/tools/Component-Deploy.md, "Viewing and editing the conf"): the conf merged from the default conf,
    each component's MoquiConf.xml and the runtime conf. Settings shows the merged conf with where each value came from;
    Edit (with the sealed CONF_EDIT permission) changes one conf file and reloads; Changes compares the files with the
    running conf, applies what can be live and restarts for the rest. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Configuration" default-menu-index="4" default-menu-group="Server" menu-image="sym_o_tune" menu-image-type="icon">
    <subscreens default-item="View"/>
    <widgets>
        <subscreens-panel id="ConfPanel" type="tab"/>
    </widgets>
</screen>
