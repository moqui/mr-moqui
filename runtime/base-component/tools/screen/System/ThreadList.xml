<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-index="7" default-menu-title="Threads" menu-image="sym_o_forum" menu-image-type="icon">

    <transition name="interruptThread" authz-action="all">
        <parameter name="threadName"/>
        <!-- A Rust thread cannot be interrupted from outside, so this reports that -->
        <actions><script>ec.message.addMessage(`Thread ${threadName} not interrupted: a thread cannot be interrupted in this server`, "warning")</script></actions>
        <default-response url="."/>
    </transition>
    <transition name="setWorkerPoolSize" authz-action="all">
        <!-- The worker pool size is the conf tools@worker-pool-max, set when the server starts -->
        <actions><script>ec.message.addMessage(ec.l10n.localize("The worker pool size is set by the conf (tools worker-pool-max) when the server starts"), "warning")</script></actions>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="workerPool" from="ec.factory.workerPool"/>
        <set field="jobRunner" from="ec.service.getJobRunner()"/>
        <set field="jobRunnerLastCheckText" from="jobRunner &amp;&amp; jobRunner.executeCount &gt; 0 ? (jobRunner.lastExecuteTime != null ? ec.l10n.format(jobRunner.lastExecuteTime, null) : ec.l10n.localize('Unavailable')) : ec.l10n.localize('Not run yet')"/>
        <set field="processInfo" from="ec.factory.getStatusMap().Process"/>
        <set field="threadCountText" from="processInfo.Threads != null ? ec.l10n.format(processInfo.Threads, '#,##0') : ec.l10n.localize('Unavailable')"/>

        <set field="orderByField" from="orderByField || 'threadName'"/>

        <!-- Java reads a ThreadMXBean; the port reads the process's threads (Linux /proc), with no lock or stack detail -->
        <set field="threadMapList" from="ec.factory.getThreadList()"/>
        <script>orderMapList(threadMapList, [orderByField])</script>
    </actions>
    <widgets>
        <label text="Threads: ${threadCountText}" type="p"/>

        <container-row>
            <row-col md="6">
                <container-box><box-header title="Worker pool"/><box-body>
                    <container-row>
                        <row-col sm="6">
                            <label text="Threads" type="strong"/>
                            <label text="Active: ${workerPool.activeCount}" type="div"
                                    style="${workerPool.activeCount == workerPool.maximumPoolSize ? 'text-warning' : ''}"/>
                            <label text="Current: ${workerPool.poolSize} · Maximum: ${workerPool.maximumPoolSize}" type="div"/>
                        </row-col>
                        <row-col sm="6">
                            <label text="Queue" type="strong"/>
                            <label text="Current: ${workerPool.queueSize}" type="div"/>
                            <label text="Remaining capacity: ${workerPool.remainingCapacity}" type="div"
                                    style="${workerPool.remainingCapacity == 0 ? 'text-danger' : (workerPool.queueSize &gt; workerPool.remainingCapacity ? 'text-warning' : '')}"/>
                        </row-col>
                    </container-row>
                </box-body></container-box>
            </row-col>
            <row-col md="6">
                <container-box><box-header title="Service job scheduler"/><box-body>
                    <section name="JobRunnerInfo" condition="jobRunner"><widgets>
                        <label text="Last check: ${jobRunnerLastCheckText}" type="div"/>
                        <label text="Checks performed: ${jobRunner.executeCount} · Jobs run: ${jobRunner.totalJobsRun}" type="div"/>
                        <label text="At last check: ${jobRunner.lastJobsActive} active · ${jobRunner.lastJobsPaused} paused" type="div" style="m-muted"/>
                    </widgets><fail-widgets>
                        <label text="The service job scheduler is not running." type="div"/>
                        <label text="A scheduled-job-check-time of 0 disables the scheduler." type="div" style="m-muted"/>
                    </fail-widgets></section>
                </box-body></container-box>
            </row-col>
        </container-row>

        <section name="ThreadDetails" condition="threadMapList.length &gt; 0"><widgets>
            <form-list name="ThreadList" list="threadMapList" skip-form="true" select-columns="true">
                <field name="threadName"><header-field title="Name" show-order-by="case-insensitive"/><default-field><display/></default-field></field>
                <field name="threadId"><header-field title="ID" show-order-by="true"/><default-field><display/></default-field></field>
                <field name="threadState"><header-field title="State" show-order-by="true"/><default-field><display/></default-field></field>

                <field name="cpuTime"><header-field title="CPU Time" show-order-by="true"/><default-field>
                    <display text="${ec.l10n.format(cpuTime/1E9, '#,##0.000')}s"/></default-field></field>
                <field name="userTime"><header-field show-order-by="true"/><default-field>
                    <display text="${ec.l10n.format(userTime/1E9, '#,##0.000')}s"/></default-field></field>

                <field name="lockName"><header-field title="Lock" show-order-by="true"/><default-field><display/></default-field></field>
                <field name="lockOwnerName"><header-field title="Lock Owner" show-order-by="true"/><default-field><display/></default-field></field>
                <field name="lockOwnerId"><header-field title="Lock Owner ID" show-order-by="true"/><default-field><display/></default-field></field>

                <field name="blockedTime"><header-field title="Blocked Total" show-order-by="true"/><default-field><display/></default-field></field>
                <field name="waitedTime"><header-field title="Waited Total" show-order-by="true"/><default-field><display/></default-field></field>

                <field name="stack"><default-field title="">
                    <container-dialog id="StackListDialog" button-text="Stack" type="default" width="960">
                        <label text="${(stackList || []).join('\n')}" type="pre"/>
                    </container-dialog>
                </default-field></field>
                <field name="interrupt"><default-field title="">
                    <link url="interruptThread" text="Interrupt" confirmation="Really interrupt thread ${threadName}?" btn-type="danger"/>
                </default-field></field>

                <form-list-column><field-ref name="threadName"/></form-list-column>
                <form-list-column><field-ref name="threadId"/></form-list-column>
                <form-list-column><field-ref name="threadState"/></form-list-column>
                <form-list-column><field-ref name="cpuTime"/></form-list-column>
                <form-list-column><field-ref name="userTime"/></form-list-column>
                <form-list-column><field-ref name="stack"/></form-list-column>
                <form-list-column><field-ref name="interrupt"/></form-list-column>
            </form-list>
        </widgets><fail-widgets>
            <label text="Thread details are unavailable on this server." type="p" style="m-muted"/>
        </fail-widgets></section>
    </widgets>
</screen>
