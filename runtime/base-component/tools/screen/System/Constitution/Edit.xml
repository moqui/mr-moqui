<!-- Edit the global Constitution in one language: the document's title, provenance and shared agent instructions, each
    rule's title, human description and agent instructions, and a rule's references (localized titles, shared URLs).
    Rules and references keep their ids through moves and removals; new ones get ids not used yet. Each change is one
    edit#ConstitutionDocument of the current document and one store#Constitution with the hash it was read at, so a
    change made elsewhere in between is refused rather than lost. Editing the shipped document saves the instance's own
    copy. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit" default-menu-index="2">
    <parameter name="locale"/>
    <parameter name="ruleId"/>

    <transition name="applyEdit">
        <actions>
            <if condition="!canEdit"><return error="true" message="Changing the Constitution needs the ADMIN_CONSTITUTION_GLOBAL permission"/></if>
            <service-call name="org.moqui.admin.ConstitutionServices.get#Constitution" out-map="current"
                    in-map="{scope: 'global', includeDocument: true}"/>
            <service-call name="org.moqui.admin.ConstitutionServices.edit#ConstitutionDocument" out-map="edited"
                    in-map="{documentText: current.documentText, operation: context.operation, locale: context.locale,
                        ruleId: context.ruleId, referenceId: context.referenceId, direction: context.direction,
                        title: context.title, provenance: context.provenance, description: context.description,
                        instructions: context.instructions, url: context.url}"/>
            <if condition="!ec.message.hasError()">
                <service-call name="org.moqui.admin.ConstitutionServices.store#Constitution"
                        in-map="{documentText: edited.documentText, expectedHash: context.expectedHash}"/></if>
            <if condition="!ec.message.hasError() &amp;&amp; edited.newId &amp;&amp; context.operation == 'addRule'">
                <set field="ruleId" from="edited.newId"/></if>
        </actions>
        <default-response url="."><parameter name="locale"/><parameter name="ruleId"/></default-response>
        <error-response url="."/>
    </transition>

    <actions>
        <service-call name="org.moqui.admin.ConstitutionServices.get#Constitution" out-map="cons"
                in-map="{scope: 'global', locale: context.locale || null, includeDocument: true}"/>
        <set field="locale" from="cons.locale"/>
        <script><![CDATA[
            // the text of each field in this language only (empty when it falls back), with what it falls back to
            const doc = cons.documentText ? JSON.parse(cons.documentText) : {rules: []}
            const defaultLocale = cons.defaultLocale || 'en'
            const own = (map) => {
                if (!map) return ''
                for (const key of Object.keys(map)) if (key.replace('-', '_').toLowerCase() == String(locale).toLowerCase()) return map[key]
                return ''
            }
            const shown = (map) => {
                if (!map) return ''
                return own(map) || map[String(locale).split('_')[0]] || map[defaultLocale] || ''
            }
            isDefaultLocale = String(locale) == defaultLocale
            expectedHash = cons.globalHash
            docTitle = own(doc.title); docProvenance = own(doc.provenance); docInstructions = own(doc.instructions)
            docTitleShown = shown(doc.title)
            ruleRows = (doc.rules || []).map((rule, index, rules) => ({ruleId: rule.id, title: own(rule.title), titleShown: shown(rule.title),
                description: own(rule.description), instructions: own(rule.instructions),
                fallback: own(rule.title) && own(rule.description) && own(rule.instructions) ? '' : 'Falls back',
                referenceCount: (rule.references || []).length, first: index == 0, last: index == rules.length - 1}))
            if (!ruleId && ruleRows.length) ruleId = ruleRows[0].ruleId
            const rule = (doc.rules || []).find((candidate) => candidate.id == ruleId)
            selectedRuleTitle = rule ? shown(rule.title) : ''
            referenceRows = rule ? (rule.references || []).map((ref, index, refs) => ({referenceId: ref.id, title: own(ref.title),
                titleShown: shown(ref.title), url: ref.url, first: index == 0, last: index == refs.length - 1,
                trusted: ((cons.ruleList || []).find((r) => r.ruleId == ruleId)?.referenceList || []).find((r) => r.referenceId == ref.id)?.trusted == 'Y' ? 'Trusted' : 'Not trusted'})) : []
            ruleOptions = ruleRows.map((row) => ({ruleId: row.ruleId, label: row.ruleId + ' — ' + row.titleShown}))
            otherLocales = (cons.localeList || []).filter((code) => code != defaultLocale).map((code) => ({code}))
            docLocaleOptions = (cons.localeList || []).map((code) => ({code}))
        ]]></script>
    </actions>
    <widgets>
        <section name="ReadOnlySection" condition="!canEdit"><widgets>
            <label text="Changing the Constitution needs the ADMIN_CONSTITUTION_GLOBAL permission; the Rules tab shows it." type="p" style="text-warning"/>
        </widgets><fail-widgets>
            <container-box id="ConstitutionDocumentBox"><box-header title="Document"/><box-body>
                <section-include name="ConstitutionSource" location="component://tools/template/ConstitutionParts.xml"/>
                <section-include name="ConstitutionLanguage" location="component://tools/template/ConstitutionParts.xml"/>
                <label text="Editing ${locale}${isDefaultLocale ? ', the default language: its text is required' : ': an empty field uses the default language'}. A change applies to agent runs that start after it." type="p"/>
                <form-single name="DocumentForm" transition="applyEdit">
                    <field name="operation"><default-field><hidden default-value="setDocumentText"/></default-field></field>
                    <field name="locale"><default-field><hidden/></default-field></field>
                    <field name="expectedHash"><default-field><hidden/></default-field></field>
                    <field name="title" from="docTitle"><default-field title="Title"><text-line size="60"/></default-field></field>
                    <field name="provenance" from="docProvenance"><default-field title="Provenance" tooltip="Where the guidance comes from; shown to readers, not to agents">
                        <text-area rows="3" cols="100"/></default-field></field>
                    <field name="instructions" from="docInstructions"><default-field title="Agent instructions"
                            tooltip="Shared instructions every agent run gets before the rules, including how a conflict and a person's acknowledgement are handled">
                        <text-area rows="10" cols="100"/></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-single>
            </box-body></container-box>

            <container-box id="ConstitutionRuleBox"><box-header title="Rules"/><box-toolbar>
                <container-dialog id="AddRuleDialog" button-text="Add rule" icon="sym_o_add" width="800" title="Add a rule">
                    <label text="The new rule gets the next unused id. Its text is in the default language; translate it afterwards." type="p"/>
                    <form-single name="AddRuleForm" transition="applyEdit">
                        <field name="operation"><default-field><hidden default-value="addRule"/></default-field></field>
                        <field name="locale"><default-field><hidden/></default-field></field>
                        <field name="expectedHash"><default-field><hidden/></default-field></field>
                        <field name="title" from="''"><default-field title="Title"><text-line size="60"/></default-field></field>
                        <field name="description" from="''"><default-field title="Description" tooltip="What the rule means for people"><text-area rows="5" cols="90"/></default-field></field>
                        <field name="instructions" from="''"><default-field title="Agent instructions" tooltip="What an agent does to follow it"><text-area rows="5" cols="90"/></default-field></field>
                        <field name="submitButton"><default-field title="Add rule"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar><box-body>
                <form-list name="RuleList" list="ruleRows" skip-form="true">
                    <field name="ruleId"><default-field title="Rule"><display/></default-field></field>
                    <field name="titleShown"><default-field title="Title"><display/></default-field></field>
                    <field name="fallback"><default-field title="${locale}" tooltip="Falls back: a field has no text in this language yet"><display/></default-field></field>
                    <field name="referenceCount"><default-field title="References">
                        <link url="." text="${referenceCount} references" link-type="anchor" parameter-map="{locale: locale, ruleId: ruleId}"/></default-field></field>
                    <field name="actions" align="right"><default-field title="">
                        <container-dialog id="EditRuleDialog" button-text="Edit" icon="sym_o_edit" width="800" title="Rule ${ruleId} in ${locale}">
                            <form-single name="EditRuleForm" transition="applyEdit">
                                <field name="operation"><default-field><hidden default-value="setRuleText"/></default-field></field>
                                <field name="ruleId"><default-field><hidden/></default-field></field>
                                <field name="locale" from="locale"><default-field><hidden/></default-field></field>
                                <field name="expectedHash" from="expectedHash"><default-field><hidden/></default-field></field>
                                <field name="title"><default-field title="Title"><text-line size="60"/></default-field></field>
                                <field name="description"><default-field title="Description" tooltip="What the rule means for people"><text-area rows="5" cols="90"/></default-field></field>
                                <field name="instructions"><default-field title="Agent instructions" tooltip="What an agent does to follow it"><text-area rows="5" cols="90"/></default-field></field>
                                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        <link url="applyEdit" text="Up" icon="sym_o_arrow_upward" condition="!first"
                                parameter-map="{operation: 'moveRule', direction: 'up', ruleId: ruleId, locale: locale, expectedHash: expectedHash}"/>
                        <link url="applyEdit" text="Down" icon="sym_o_arrow_downward" condition="!last"
                                parameter-map="{operation: 'moveRule', direction: 'down', ruleId: ruleId, locale: locale, expectedHash: expectedHash}"/>
                        <link url="applyEdit" text="Remove" icon="sym_o_delete" btn-type="danger"
                                confirmation="Remove rule ${ruleId}, ${titleShown}, in every language? Its id is not used again."
                                parameter-map="{operation: 'removeRule', ruleId: ruleId, locale: locale, expectedHash: expectedHash}"/>
                    </default-field></field>
                    <columns type="mobile"><column><field-ref name="ruleId"/><field-ref name="titleShown"/></column>
                        <column><field-ref name="actions"/></column></columns>
                </form-list>
            </box-body></container-box>

            <container-box id="ConstitutionReferenceBox" condition="ruleId"><box-header title="References of ${ruleId}: ${selectedRuleTitle}"/><box-toolbar>
                <container-dialog id="AddReferenceDialog" button-text="Add reference" icon="sym_o_add" width="700" title="Add a reference to ${ruleId}">
                    <label text="A reference URL is https:// on a trusted origin (Origins tab) or a path on this server starting with /. Its title is in the default language." type="p"/>
                    <form-single name="AddReferenceForm" transition="applyEdit">
                        <field name="operation"><default-field><hidden default-value="addReference"/></default-field></field>
                        <field name="ruleId"><default-field><hidden/></default-field></field>
                        <field name="locale"><default-field><hidden/></default-field></field>
                        <field name="expectedHash"><default-field><hidden/></default-field></field>
                        <field name="title" from="''"><default-field title="Title" tooltip="How the reference supports the rule"><text-line size="60"/></default-field></field>
                        <field name="url" from="''"><default-field title="URL"><text-line size="60"/></default-field></field>
                        <field name="submitButton"><default-field title="Add reference"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </box-toolbar><box-body>
                <form-list name="ReferenceList" list="referenceRows" skip-form="true">
                    <field name="referenceId"><default-field title="Reference"><display/></default-field></field>
                    <field name="titleShown"><default-field title="Title"><display/></default-field></field>
                    <field name="url"><default-field title="URL"><display/></default-field></field>
                    <field name="trusted"><default-field title="Origin"><display/></default-field></field>
                    <field name="actions" align="right"><default-field title="">
                        <container-dialog id="EditReferenceDialog" button-text="Edit" icon="sym_o_edit" width="700" title="Reference ${referenceId} in ${locale}">
                            <form-single name="EditReferenceForm" transition="applyEdit">
                                <field name="operation"><default-field><hidden default-value="setReference"/></default-field></field>
                                <field name="referenceId"><default-field><hidden/></default-field></field>
                                <field name="ruleId" from="ruleId"><default-field><hidden/></default-field></field>
                                <field name="locale" from="locale"><default-field><hidden/></default-field></field>
                                <field name="expectedHash" from="expectedHash"><default-field><hidden/></default-field></field>
                                <field name="title"><default-field title="Title"><text-line size="60"/></default-field></field>
                                <field name="url"><default-field title="URL" tooltip="Shared by every language"><text-line size="60"/></default-field></field>
                                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        <link url="applyEdit" text="Up" icon="sym_o_arrow_upward" condition="!first"
                                parameter-map="{operation: 'moveReference', direction: 'up', referenceId: referenceId, ruleId: ruleId, locale: locale, expectedHash: expectedHash}"/>
                        <link url="applyEdit" text="Down" icon="sym_o_arrow_downward" condition="!last"
                                parameter-map="{operation: 'moveReference', direction: 'down', referenceId: referenceId, ruleId: ruleId, locale: locale, expectedHash: expectedHash}"/>
                        <link url="applyEdit" text="Remove" icon="sym_o_delete" btn-type="danger"
                                confirmation="Remove reference ${referenceId} from ${ruleId}?"
                                parameter-map="{operation: 'removeReference', referenceId: referenceId, ruleId: ruleId, locale: locale, expectedHash: expectedHash}"/>
                    </default-field></field>
                    <columns type="mobile"><column><field-ref name="titleShown"/><field-ref name="url"/></column>
                        <column><field-ref name="actions"/></column></columns>
                </form-list>
            </box-body></container-box>

            <container-box id="ConstitutionLanguageBox"><box-header title="Languages"/><box-body>
                <label text="The default language (${cons.defaultLocale}) has every text; another language may leave texts out, which then fall back. To translate, choose the language above and edit." type="p"/>
                <form-single name="DefaultLocaleForm" transition="applyEdit">
                    <field name="operation"><default-field><hidden default-value="setDefaultLocale"/></default-field></field>
                    <field name="expectedHash"><default-field><hidden/></default-field></field>
                    <field name="locale" from="cons.defaultLocale"><default-field title="Default language"
                            tooltip="Every text needs a translation in the new default language before it can be saved">
                        <drop-down allow-empty="false"><list-options list="docLocaleOptions" key="${code}" text="${code}"/></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Set default"><submit confirmation="Make this the default language? Every text must already have it."/></default-field></field>
                    <field-layout><field-row-big><field-ref name="locale"/><field-ref name="submitButton"/></field-row-big></field-layout>
                </form-single>
                <form-list name="LocaleList" list="otherLocales" skip-form="true">
                    <field name="code"><default-field title="Language"><display/></default-field></field>
                    <field name="actions" align="right"><default-field title="">
                        <link url="applyEdit" text="Remove translation" icon="sym_o_delete" btn-type="danger"
                                confirmation="Remove every ${code} text from the Constitution? Readers and agent runs in ${code} then get the default language."
                                parameter-map="{operation: 'removeLocale', locale: code, expectedHash: expectedHash}"/>
                    </default-field></field>
                </form-list>
            </box-body></container-box>
        </fail-widgets></section>
    </widgets>
</screen>
