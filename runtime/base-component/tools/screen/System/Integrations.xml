<!-- Integrations (plans/Admin-Screens-Down.md): the instance's connections to other systems (gateways, remote systems,
    printers), the message types it exchanges with them and what became of its system messages, over
    org.moqui.admin.ConfigurationServices (ADMIN_CONNECTION_VIEW and ADMIN_CONNECTION_MANAGE) and
    org.moqui.admin.OperationServices (ADMIN_OPERATION_VIEW and ADMIN_OPERATION_MANAGE), which check the permissions
    themselves. Its screens are the files of Integrations/, with the sibling names an app that shows them under its own root
    uses (README, "Mounting the administration screens"), so their links to each other are relative. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Integrations" default-menu-index="10" default-menu-group="Integration" menu-image="sym_o_hub" menu-image-type="icon">
    <subscreens default-item="Connections"/>
    <widgets>
        <subscreens-panel id="SystemIntegrationsPanel" type="tab"/>
    </widgets>
</screen>
