<!-- One moqui.resource.GitRepository: its settings, the fetch, init, export and import actions of
    org.moqui.impl.GitServices (docs/data/Revision-Management.md), the storage of a db one with its collection and check,
    Git LFS, its clone URLs, branches and tags, recent commits, and the log of its updates (pushes, fetches, imports)
    with the outcome of their gitECA rules (docs/interfaces/Git-Hosting.md). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Git Repository" default-menu-include="false">

    <parameter name="repositoryId" required="true"/>

    <!-- an empty access token leaves the stored one; clearAccessToken removes it -->
    <transition name="updateGitRepository">
        <actions>
            <set field="updateMap" from="Object.assign({}, ec.web.parameters)"/>
            <if condition="!accessToken"><script>delete updateMap.accessToken</script></if>
            <if condition="clearAccessToken == 'Y'"><set field="updateMap.accessToken" from="null"/></if>
            <service-call name="update#moqui.resource.GitRepository" in-map="updateMap"/>
        </actions>
        <default-response url="."/>
    </transition>
    <transition name="fetchGitRepository"><service-call name="org.moqui.impl.GitServices.fetch#GitRepository"/>
        <default-response url="."/></transition>
    <transition name="initGitRepository"><service-call name="org.moqui.impl.GitServices.init#GitRepository"/>
        <default-response url="."/></transition>
    <transition name="exportGitRepository"><service-call name="org.moqui.impl.GitServices.export#GitRepository"/>
        <default-response url="."/></transition>
    <transition name="importGitRepository"><service-call name="org.moqui.impl.GitServices.import#GitRepository"/>
        <default-response url="."/></transition>
    <transition name="gcGitRepository"><service-call name="org.moqui.impl.GitServices.gc#GitRepositories"/>
        <default-response url="."/></transition>
    <transition name="fsckGitRepository"><service-call name="org.moqui.impl.GitServices.fsck#GitRepository"/>
        <default-response url="."/></transition>
    <transition name="setupGitLfs"><service-call name="org.moqui.impl.GitServices.setup#GitLfs"/>
        <default-response url="."/></transition>
    <!-- run the gitECA post events of an update again -->
    <transition name="rerunGitUpdate">
        <service-call name="update#moqui.resource.GitUpdate" in-map="{updateId:updateId, ecaStatus:'pending', ecaError:null}"/>
        <actions><service-call name="org.moqui.impl.GitServices.process#GitUpdate" in-map="{updateId:updateId}"/></actions>
        <default-response url="."/></transition>

    <actions>
        <entity-find-one entity-name="moqui.resource.GitRepository" value-field="gitRepository"/>
        <set field="rootLocation" value="git://${repositoryId}/"/>
        <set field="isRemote" from="gitRepository?.repositoryKind == 'remote'"/>
        <set field="isDb" from="gitRepository?.repositoryKind == 'db'"/>
        <set field="hasAccessToken" from="!!gitRepository?.accessToken"/>
        <service-call name="org.moqui.impl.GitServices.get#GitCloneUrls" in-map="{repositoryId:repositoryId}" out-map="cloneUrls"/>
        <!-- a mirror not fetched yet has no refs or commits to show -->
        <set field="refList" from="[]"/><set field="commitList" from="[]"/>
        <if condition="!isRemote || gitRepository?.lastFetchDate">
            <service-call name="org.moqui.impl.GitServices.get#GitRefs" in-map="{repositoryId:repositoryId}" out-map="refsOut"/>
            <set field="refList" from="refsOut.refList ?? []"/>
            <service-call name="org.moqui.impl.GitServices.get#GitLog" in-map="{repositoryId:repositoryId, limit:20}" out-map="logOut"/>
            <set field="commitList" from="logOut.commitList ?? []"/>
        </if>
        <entity-find entity-name="moqui.resource.GitUpdate" list="updateList" limit="30">
            <econdition field-name="repositoryId"/><order-by field-name="-updateDate"/><order-by field-name="-updateId"/></entity-find>
        <set field="updateRows" from="[]"/>
        <iterate list="updateList" entry="update">
            <entity-find entity-name="moqui.resource.GitUpdateRef" list="updateRefList">
                <econdition field-name="updateId" from="update.updateId"/></entity-find>
            <script>updateRows.push(Object.assign({}, update, {refsText: updateRefList.map(ref =>
                ref.refName.replace(/^refs\/(heads|tags)\//, '') + ' ' + ref.changeType + (ref.result == 'ok' ? '' : ': ' + ref.result)).join('; ')}))</script>
        </iterate>
    </actions>
    <widgets>
        <container-row>
            <row-col lg="6">
                <form-single name="GitRepositoryForm" map="gitRepository" transition="updateGitRepository">
                    <field name="repositoryId"><default-field title="ID"><display/></default-field></field>
                    <field name="rootLocation" from="rootLocation"><default-field title="Location"><display/></default-field></field>
                    <field name="description"><default-field><text-line size="50"/></default-field></field>
                    <field name="repositoryKind"><default-field title="Kind"><display/></default-field></field>
                    <field name="branch"><default-field tooltip="main when empty"><text-line size="20"/></default-field></field>
                    <field name="localPath"><default-field title="Local Path"
                            tooltip="The bare repository of a local or remote kind; relative to the runtime directory unless absolute, runtime/git/ID when empty">
                        <text-line size="50"/></default-field></field>
                    <field name="remoteUrl"><default-field title="Remote URL"><text-line size="60"/></default-field></field>
                    <field name="username"><default-field><text-line size="30"/></default-field></field>
                    <field name="accessToken" from="''"><default-field title="Access Token"
                            tooltip="An HTTPS password or token; leave empty to keep the one stored">
                        <password size="30"/></default-field></field>
                    <field name="clearAccessToken" from="'N'"><conditional-field condition="hasAccessToken" title="Clear Token">
                        <check><option key="Y" text=" "/></check></conditional-field></field>
                    <field name="fetchIntervalMinutes"><default-field title="Fetch Every (minutes)"
                            tooltip="For a remote repository: fetch#AllGitRepositories fetches it when this long has passed; never when empty">
                        <text-line size="6"/></default-field></field>
                    <field name="headCommitId"><default-field title="Head"><display/></default-field></field>
                    <field name="lastFetchDate"><default-field title="Last Fetch"><display/></default-field></field>
                    <field name="lastFetchError"><default-field title="Fetch Error"><display/></default-field></field>
                    <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
                </form-single>
            </row-col>
            <row-col lg="6">
                <container-box><box-header title="Actions"/><box-body>
                    <section name="RemoteActions" condition="isRemote"><widgets>
                        <link url="fetchGitRepository" text="Fetch Now" parameter-map="{repositoryId:repositoryId}"/>
                        <label text="Replaces the mirror's branch with the remote one." type="p"/>
                    </widgets></section>
                    <section name="LocalActions" condition="gitRepository?.repositoryKind == 'local'"><widgets>
                        <link url="initGitRepository" text="Create Bare Repository" parameter-map="{repositoryId:repositoryId}"/>
                        <label text="A local repository is also created on its first write. Clone it, or push to it, at its clone URLs."
                                type="p"/>
                    </widgets></section>
                    <section name="DbActions" condition="isDb"><widgets>
                        <form-single name="ExportGitRepository" transition="exportGitRepository">
                            <field name="repositoryId"><default-field><hidden/></default-field></field>
                            <field name="targetPath"><default-field title="Export To"
                                    tooltip="A directory for a bare repository; the Local Path (or runtime/git/ID) when empty">
                                <text-line size="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Export"><submit/></default-field></field>
                        </form-single>
                        <form-single name="ImportGitRepository" transition="importGitRepository">
                            <field name="repositoryId"><default-field><hidden/></default-field></field>
                            <field name="source"><default-field title="Import From"
                                    tooltip="git://otherId, a repository directory, or a URL; the Remote URL when empty. Replaces the branch.">
                                <text-line size="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Import"><submit confirmation="Replace the branch with the imported one?"/></default-field></field>
                        </form-single>
                        <label text="Storage: ${gitRepository.objectCount ?? '?'} objects, ${gitRepository.storedBytes != null ? Math.round(gitRepository.storedBytes / 1024) + ' KiB' : '? bytes'} after the last collection${gitRepository.lastGcDate ? ' (' + ec.l10n.format(gitRepository.lastGcDate, 'yyyy-MM-dd HH:mm') + ': ' + (gitRepository.lastGcResult ?? '') + ')' : ''}"
                                type="p"/>
                        <form-single name="GcGitRepository" transition="gcGitRepository">
                            <field name="repositoryId"><default-field><hidden/></default-field></field>
                            <field name="dryRun" from="'true'"><default-field title="Dry Run"
                                    tooltip="Count what would be deleted, and change nothing">
                                <check><option key="true" text=" "/></check></default-field></field>
                            <field name="submitButton"><default-field title="Collect and Repack"><submit/></default-field></field>
                        </form-single>
                        <link url="fsckGitRepository" text="Check Objects" parameter-map="{repositoryId:repositoryId}"/>
                    </widgets></section>
                    <section name="LfsActions" condition="!isRemote"><widgets>
                        <form-single name="SetupGitLfs" transition="setupGitLfs">
                            <field name="repositoryId"><default-field><hidden/></default-field></field>
                            <field name="patterns"><default-field title="Keep in Git LFS"
                                    tooltip="gitattributes patterns separated by spaces; images, video, audio, PDFs and archives when empty">
                                <text-line size="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Set Up LFS"><submit/></default-field></field>
                        </form-single>
                    </widgets></section>
                </box-body></container-box>
            </row-col>
        </container-row>

        <container-box><box-header title="Clone"/><box-body>
            <label text="git clone ${cloneUrls.httpsUrl ?? ''}" type="div"/>
            <label text="git clone ${cloneUrls.sshUrl}" type="div" condition="cloneUrls.sshUrl"/>
            <label text="Access is granted through AT_GIT_REPOSITORY artifact authorization: view to clone and fetch, create and update to push, delete to force a push or delete a ref."
                    type="p"/>
        </box-body></container-box>

        <container-row>
            <row-col lg="5">
                <label text="Branches and Tags" type="h5"/>
                <form-list name="GitRefList" list="refList" skip-form="true">
                    <field name="shortName"><default-field title="Name"><display/></default-field></field>
                    <field name="refType"><default-field title="Type"><display/></default-field></field>
                    <field name="commitId"><default-field title="Commit"><display text="${commitId?.substring(0, 10) ?? ''}"/></default-field></field>
                    <field name="summary"><default-field><display/></default-field></field>
                    <field name="commitDate"><default-field title="Date"><display format="yyyy-MM-dd HH:mm"/></default-field></field>
                </form-list>
            </row-col>
            <row-col lg="7">
                <label text="Recent Commits" type="h5"/>
                <form-list name="GitCommitList" list="commitList" skip-form="true">
                    <field name="shortId"><default-field title="Commit"><display/></default-field></field>
                    <field name="summary"><default-field><display/></default-field></field>
                    <field name="authorName"><default-field title="Author"><display/></default-field></field>
                    <field name="committerDate"><default-field title="Date"><display format="yyyy-MM-dd HH:mm"/></default-field></field>
                </form-list>
            </row-col>
        </container-row>

        <label text="Updates" type="h5"/>
        <form-list name="GitUpdateList" list="updateRows" transition="rerunGitUpdate">
            <field name="updateId"><default-field title="ID"><display/></default-field></field>
            <field name="updateDate"><default-field title="Date"><display format="yyyy-MM-dd HH:mm:ss"/></default-field></field>
            <field name="source"><default-field><display/></default-field></field>
            <field name="transport"><default-field><display/></default-field></field>
            <field name="userId"><default-field title="User"><display/></default-field></field>
            <field name="refsText"><default-field title="Refs"><display/></default-field></field>
            <field name="ecaStatus"><default-field title="Rules"><display/></default-field></field>
            <field name="ecaError"><default-field title="Rule Errors"><display/></default-field></field>
            <field name="submitButton"><conditional-field condition="['done', 'failed'].includes(ecaStatus)" title="Run Rules Again">
                <submit confirmation="Run the gitECA rules of this update again?"/></conditional-field>
                <default-field><display text=""/></default-field></field>
        </form-list>
    </widgets>
</screen>
