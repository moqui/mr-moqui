<!-- DatasetFields (docs/tools/Monitoring.md, "Business datasets"; plans/Admin-Screens-Down.md, Track I; first BOSS
    Insights'): a business dataset's document fields and conditions for its steward, from get#BusinessDataset: FieldList
    (each field's name, function and order, or remove it), AddField (a plain path of the document's entity and its
    relationships, never an expression), AddCondition and ConditionList (a field, an operator of the engine's list and a
    value; conditions narrow a source and never replace its row filter). Each change goes through the engine's
    store#BusinessDatasetFields or store#BusinessDatasetConditions, which check the dataset's update artifact, refuse
    removing or renaming a field a definition over the dataset uses and a stale version, and leave the index to be
    rebuilt. The operators and functions offered are the engine's (get#BusinessDatasetOptions). Another app shows the
    screen under its own root in a screen of its own, taking in storeFields and storeConditions (BOSS Insights › Report
    builder › DatasetFields). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Fields" default-menu-include="false">
    <parameter name="datasetId" required="true"/>

    <transition name="storeFields">
        <service-call name="org.moqui.report.ReportServices.store#BusinessDatasetFields"
                in-map="{datasetId:datasetId, expectedVersion:expectedVersion, fields:[{fieldSeqId:(fieldSeqId || null), fieldPath:(fieldPath || null),
                    fieldNameAlias:(fieldNameAlias || ''), functionName:(functionName || ''), sequenceNum:(sequenceNum || null),
                    remove:(remove === 'true')}]}"/>
        <default-response url="." parameter-map="{datasetId:datasetId}"/>
        <error-response url="." parameter-map="{datasetId:datasetId}"/>
    </transition>
    <transition name="storeConditions">
        <service-call name="org.moqui.report.ReportServices.store#BusinessDatasetConditions"
                in-map="{datasetId:datasetId, expectedVersion:expectedVersion, conditions:[{conditionSeqId:(conditionSeqId || null),
                    fieldNameAlias:(fieldNameAlias || ''), operator:(operator || 'equals'), fieldValue:(fieldValue || ''),
                    remove:(remove === 'true')}]}"/>
        <default-response url="." parameter-map="{datasetId:datasetId}"/>
        <error-response url="." parameter-map="{datasetId:datasetId}"/>
    </transition>

    <actions>
        <set field="detail" from="ec.resource.script('component://tools/template/ReportDatasets.js').detail(datasetId)"/>
        <set field="failure" from="detail.failure"/>
        <set field="recordFound" from="detail.found"/>
        <set field="dataset" from="detail.dataset"/>
        <set field="expectedVersion" from="dataset.version"/>
        <set field="fieldList" from="detail.fields"/>
        <set field="conditionList" from="detail.conditions"/>
        <set field="fieldNames" from="detail.fieldNames"/>
        <set field="operatorOptions" from="detail.operatorOptions"/>
        <set field="functionOptions" from="detail.functionOptions"/>
        <set field="newValues" from="{datasetId:datasetId, expectedVersion:expectedVersion}"/>
    </actions>
    <widgets>
        <section name="FieldsFound" condition="recordFound">
            <widgets>
                <container style="row items-center q-col-gutter-sm q-mb-sm">
                    <container style="col">
                        <label text="Fields of ${dataset.title}" type="h5"/>
                        <label type="p" style="text-caption m-muted q-mb-none" text="A change needs the index rebuilt before the dataset can be admitted again."/>
                    </container>
                    <container style="col-auto">
                        <link url="../DatasetDetail" text="Back to the dataset" link-type="anchor-button" icon="sym_o_arrow_back" parameter-map="{datasetId:datasetId}"/>
                    </container>
                </container>
                <container-box>
                    <box-header title="Fields"/>
                    <box-toolbar>
                        <container-dialog id="AddField" button-text="Add field" type="primary" icon="sym_o_add" width="520" title="Add a field to ${dataset.title}">
                            <form-single name="AddFieldForm" transition="storeFields" map="newValues">
                                <field name="datasetId"><default-field><hidden/></default-field></field>
                                <field name="expectedVersion"><default-field><hidden/></default-field></field>
                                <field name="fieldPath"><default-field title="Field path" tooltip="A field of the source, or relationship:field"><text-line size="40"/></default-field></field>
                                <field name="fieldNameAlias"><default-field title="Name" tooltip="Unique in the dataset; the last part of the path by default"><text-line size="30"/></default-field></field>
                                <field name="submitButton"><default-field title="Add field"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body-nopad>
                        <form-list name="FieldList" list="fieldList" transition="storeFields" paginate="false">
                            <field name="datasetId"><default-field><hidden/></default-field></field>
                            <field name="expectedVersion"><default-field><hidden/></default-field></field>
                            <field name="fieldSeqId"><default-field><hidden/></default-field></field>
                            <field name="fieldPath"><default-field title="Path"><display/></default-field></field>
                            <field name="fieldNameAlias"><default-field title="Name"><text-line size="20"/></default-field></field>
                            <field name="functionName">
                                <default-field title="Function">
                                    <drop-down allow-empty="true"><list-options list="functionOptions" key="${key}" text="${text}"/></drop-down>
                                </default-field>
                            </field>
                            <field name="sequenceNum"><default-field title="Order"><text-line size="4" input-type="number"/></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                            <field name="actions">
                                <default-field title="">
                                    <link url="storeFields" link-type="hidden-form-link" text="Remove" icon="sym_o_delete" btn-type="danger"
                                            confirmation="Remove the field ${fieldName}?"
                                            parameter-map="{datasetId:datasetId, expectedVersion:expectedVersion, fieldSeqId:fieldSeqId, remove:'true'}"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="fieldPath"/><field-ref name="fieldNameAlias"/></column>
                                <column><field-ref name="submitButton"/><field-ref name="actions"/></column>
                            </columns>
                        </form-list>
                    </box-body-nopad>
                </container-box>
                <container-box>
                    <box-header title="Conditions"/>
                    <box-toolbar>
                        <container-dialog id="AddCondition" button-text="Add condition" icon="sym_o_filter_alt" width="520" title="Narrow ${dataset.title}">
                            <form-single name="AddConditionForm" transition="storeConditions" map="newValues">
                                <field name="datasetId"><default-field><hidden/></default-field></field>
                                <field name="expectedVersion"><default-field><hidden/></default-field></field>
                                <field name="fieldNameAlias">
                                    <default-field title="Field"><drop-down><list-options list="fieldNames" key="${key}" text="${text}"/></drop-down></default-field>
                                </field>
                                <field name="operator">
                                    <default-field title="Operator"><drop-down><list-options list="operatorOptions" key="${key}" text="${text}"/></drop-down></default-field>
                                </field>
                                <field name="fieldValue"><default-field title="Value"><text-line size="30"/></default-field></field>
                                <field name="submitButton"><default-field title="Add condition"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </box-toolbar>
                    <box-body-nopad>
                        <form-list name="ConditionList" list="conditionList" transition="storeConditions" paginate="false">
                            <field name="datasetId"><default-field><hidden/></default-field></field>
                            <field name="expectedVersion"><default-field><hidden/></default-field></field>
                            <field name="conditionSeqId"><default-field><hidden/></default-field></field>
                            <field name="fieldNameAlias">
                                <default-field title="Field"><drop-down><list-options list="fieldNames" key="${key}" text="${text}"/></drop-down></default-field>
                            </field>
                            <field name="operator">
                                <default-field title="Operator"><drop-down><list-options list="operatorOptions" key="${key}" text="${text}"/></drop-down></default-field>
                            </field>
                            <field name="fieldValue"><default-field title="Value"><text-line size="20"/></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                            <field name="actions">
                                <default-field title="">
                                    <link url="storeConditions" link-type="hidden-form-link" text="Remove" icon="sym_o_delete" btn-type="danger"
                                            confirmation="Remove the condition on ${fieldNameAlias}?"
                                            parameter-map="{datasetId:datasetId, expectedVersion:expectedVersion, conditionSeqId:conditionSeqId, remove:'true'}"/>
                                </default-field>
                            </field>
                            <columns type="mobile">
                                <column><field-ref name="fieldNameAlias"/><field-ref name="fieldValue"/></column>
                                <column><field-ref name="submitButton"/><field-ref name="actions"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="q-pa-md m-muted" condition="!conditionList.length" text="No condition narrows this dataset."/>
                    </box-body-nopad>
                </container-box>
            </widgets>
            <fail-widgets>
                <label type="h5" text="Not available"/>
                <label type="p" text="${failure || 'This dataset is not available.'}"/>
                <link url="../Datasets" text="Back to datasets" link-type="anchor"/>
            </fail-widgets>
        </section>
    </widgets>
</screen>
