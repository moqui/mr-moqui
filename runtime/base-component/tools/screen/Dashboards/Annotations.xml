<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Annotations" default-menu-index="8">
    <!-- Explore's links and forms resolve against this screen's URL, so its transitions run here, under this app's authorization. -->
    <transition-include name="remember" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="trace" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="user" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="context" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="visit" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="tail" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="saveSearch" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="addPanel" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition-include name="split" location="component://tools/screen/Dashboards/Explore.xml"/>
    <transition name="create" method="post" authz-action="create">
        <actions><service-call name="org.moqui.report.ReportServices.create#Annotation" in-map="{time:annotationTime || null,timeEnd:annotationEnd || null,source:'user',text:annotationText,tags:String(annotationTags || '').split(',').map(tag=>tag.trim()).filter(Boolean),scope:annotationScope || null,serviceName:serviceName || null,instanceId:instanceId || null,dashboardId:dashboardId || null,panelId:panelId || null}"/></actions>
        <default-response url="."/>
    </transition>
    <pre-actions><set field="datasetId" from="datasetId || 'monitor_annotations'"/></pre-actions>
    <widgets>
        <container-dialog id="NewAnnotation" button-text="Add annotation">
            <form-single name="NewAnnotation" transition="create">
                <field name="annotationText"><default-field title="Note"><text-area rows="4" cols="80"/></default-field></field>
                <field name="annotationTime"><default-field title="Start (ISO time, empty = now)"><text-line/></default-field></field>
                <field name="annotationEnd"><default-field title="End (optional ISO time)"><text-line/></default-field></field>
                <field name="annotationTags"><default-field title="Tags (comma separated)"><text-line/></default-field></field>
                <field name="annotationScope"><default-field title="Scope"><drop-down allow-empty="true"><option key="service"/><option key="instance"/><option key="dashboard"/><option key="panel"/></drop-down></default-field></field>
                <field name="serviceName"><default-field title="Service"><text-line/></default-field></field>
                <field name="instanceId"><default-field title="Instance"><text-line/></default-field></field>
                <field name="dashboardId"><default-field title="Dashboard ID"><text-line/></default-field></field>
                <field name="panelId"><default-field title="Panel ID"><text-line/></default-field></field>
                <field name="create"><default-field><submit text="Add annotation"/></default-field></field>
            </form-single>
        </container-dialog>
        <include-screen location="component://tools/screen/Dashboards/Explore.xml" share-scope="true"/>
    </widgets>
</screen>
