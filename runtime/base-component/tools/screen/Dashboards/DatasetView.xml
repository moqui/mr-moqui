<!-- DatasetView (docs/tools/Monitoring.md, "Business datasets"; plans/archive/Admin-Screens-Down.md, Track I; first BOSS
    Insights'): a business dataset's rows as the viewer reads them: DatasetOptions (the dataset among those they read, the
    range, the mount's when the request names none, and a query), DataViewList (each row's title and fields, a page at a
    time, from query#Documents) and ExportDocuments (the same rows as CSV or JSON, to the cap, recorded through
    audit#Export). Every row passes the dataset's row filter in the engine, so a reader of one scope sees and exports only
    its rows; there is no raw DataDocument view or export. The dataset opens in Explore where the mount has one, with the
    range and the query and without this list's page (Explore's list has its own). Another app shows the screen under its
    own root in a screen of its own, taking in exportDocuments (BOSS Insights › Report builder › DatasetView). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Preview" default-menu-include="false">
    <parameter name="datasetId"/>
    <parameter name="from"/>
    <parameter name="thru"/>
    <parameter name="queryString"/>
    <parameter name="pageIndex"/>

    <transition name="exportDocuments" method="get" read-only="true">
        <actions><script><![CDATA[
            // a refusal (the dataset not read, a query the engine refuses) is the transition's error
            let exported = null
            try {
                exported = ec.resource.script('component://tools/template/ReportDatasets.js').exportRows({datasetId:datasetId, from:from, thru:thru,
                    queryString:queryString, format:format, prettyPrint:prettyPrint, requestedRowLimit:requestedRowLimit})
            } catch (error) { ec.message.addError(String(error?.message ?? error)) }
            if (exported && !ec.message.hasError()) ec.web.sendTextResponse(String(exported.content || ''), exported.contentType, exported.filename)
        ]]></script></actions>
        <default-response type="none"/>
        <error-response url="." parameter-map="{datasetId:datasetId}"/>
    </transition>

    <actions>
        <set field="viewed" from="ec.resource.script('component://tools/template/ReportDatasets.js').view({datasetId:datasetId, from:from, thru:thru,
                queryString:queryString, pageIndex:pageIndex})"/>
        <set field="from" from="viewed.from"/>
        <set field="thru" from="viewed.thru"/>
        <set field="failure" from="viewed.failure"/>
        <set field="dataset" from="viewed.dataset"/>
        <set field="datasetChoices" from="viewed.choices"/>
        <set field="exploreUrl" from="viewed.exploreUrl"/>
        <set field="documentList" from="viewed.documents"/>
        <set field="documentListCount" from="viewed.count"/>
        <set field="documentListPageIndex" from="viewed.pageIndex"/>
        <set field="documentListPageSize" from="viewed.pageSize"/>
        <set field="documentListPageMaxIndex" from="viewed.pageMaxIndex"/>
        <set field="documentListPageRangeLow" from="viewed.pageRangeLow"/>
        <set field="documentListPageRangeHigh" from="viewed.pageRangeHigh"/>
        <set field="totalText" from="viewed.totalText"/>
        <set field="optionValues" from="{datasetId:datasetId, from:from, thru:thru, queryString:queryString}"/>
        <set field="exportValues" from="{datasetId:datasetId, from:from, thru:thru, queryString:queryString, format:'csv', requestedRowLimit:viewed.exportDefault}"/>
    </actions>
    <widgets>
        <container style="row items-center q-col-gutter-sm q-mb-sm">
            <container style="col">
                <label text="${dataset ? dataset.title : 'Preview a dataset'}" type="h5"/>
                <label type="p" style="text-caption m-muted q-mb-none" condition="dataset"
                        text="Rows scoped by ${dataset?.scopeText}; ${totalText} in the range"/>
            </container>
            <container style="col-auto">
                <!-- Explore declares pageIndex too, and a link carries what its target declares of this screen's context: the
                    page of this list is not Explore's, so it is sent empty -->
                <link url="${exploreUrl}" text="Explore" icon="sym_o_search" condition="dataset &amp;&amp; !!exploreUrl"
                        parameter-map="{datasetId:datasetId, from:from, thru:thru, queryString:queryString, pageIndex:''}"/>
                <container-dialog id="ExportDocuments" button-text="Export" type="primary" icon="sym_o_download" width="520"
                        title="Export ${dataset?.title}" condition="dataset">
                    <label type="p" text="The rows you see here, up to ${viewed.exportCapText}; the export is recorded."/>
                    <form-single name="ExportDocumentsForm" transition="exportDocuments" map="exportValues">
                        <field name="datasetId"><default-field><hidden/></default-field></field>
                        <field name="from"><default-field><hidden/></default-field></field>
                        <field name="thru"><default-field><hidden/></default-field></field>
                        <field name="queryString"><default-field><hidden/></default-field></field>
                        <field name="format">
                            <default-field title="Format"><radio><option key="csv" text="CSV"/><option key="json" text="JSON"/></radio></default-field>
                        </field>
                        <field name="prettyPrint"><default-field title=" "><check><option key="true" text="Indented JSON"/></check></default-field></field>
                        <field name="requestedRowLimit"><default-field title="Rows at most"><text-line size="8" input-type="number"/></default-field></field>
                        <field name="submitButton"><default-field title="Download"><submit/></default-field></field>
                    </form-single>
                </container-dialog>
            </container>
        </container>
        <form-single name="DatasetOptions" transition="." map="optionValues">
            <field name="datasetId">
                <default-field title="Dataset">
                    <drop-down allow-empty="true"><list-options list="datasetChoices" key="${key}" text="${text}"/></drop-down>
                </default-field>
            </field>
            <field name="from"><default-field title="From" tooltip="A date or a relative time such as now-30d"><text-line size="16"/></default-field></field>
            <field name="thru"><default-field title="Through"><text-line size="16"/></default-field></field>
            <field name="queryString"><default-field title="Query" tooltip="Field:value terms, as in Explore"><text-line size="30"/></default-field></field>
            <field name="submitButton"><default-field title="Show"><submit/></default-field></field>
            <field-layout>
                <field-row-big><field-ref name="datasetId"/><field-ref name="from"/><field-ref name="thru"/>
                    <field-ref name="queryString"/><field-ref name="submitButton"/></field-row-big>
            </field-layout>
        </form-single>
        <label type="p" style="text-negative" condition="failure" text="${failure}"/>
        <section name="DatasetRows" condition="dataset">
            <widgets>
                <container-box>
                    <box-body-nopad>
                        <form-list name="DataViewList" list="documentList" skip-form="true">
                            <field name="title"><default-field title="Row"><display/></default-field></field>
                            <field name="summary"><default-field title="Fields"><display/></default-field></field>
                            <columns type="mobile">
                                <column><field-ref name="title"/></column>
                                <column><field-ref name="summary"/></column>
                            </columns>
                        </form-list>
                        <label type="p" style="q-pa-md m-muted" condition="!documentList.length" text="No row of this dataset is in the range for you."/>
                    </box-body-nopad>
                </container-box>
            </widgets>
            <fail-widgets>
                <label type="p" style="q-pa-md m-muted" condition="!failure" text="Choose an admitted dataset to see its rows."/>
            </fail-widgets>
        </section>
    </widgets>
</screen>
