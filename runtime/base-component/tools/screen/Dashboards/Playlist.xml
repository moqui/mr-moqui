<!-- One dashboard playlist played in the app, in kiosk mode, for whoever sits at it (docs/tools/Monitoring.md, "Playlists
    and the wall display"): its dashboards in turn over the request's range, or the mount's when it names none
    (reportPolicy.range), each also opened on its own. The playlists are listed, made and shared on Playlists, and one
    plays full screen and unattended on WallDisplay, which takes no range from a request. A screen that shows it under
    another app (BOSS Insights › Wall display) takes in its data transition, which the player calls at that screen's path,
    and its dashboard links open the app's Dashboard (the reportLinks map of its root, "Mounting the report screens");
    Tools' Dashboards app keeps its own. What it shows is template/ReportPlaylists.js (player, playerData). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Playlist">
    <parameter name="definitionId" required="true"/><parameter name="from"/><parameter name="thru"/>
    <transition name="data" method="get" read-only="true">
        <actions><script>ec.web.sendJsonResponse(ec.resource.script('component://tools/template/ReportPlaylists.js').playerData({definitionId:definitionId, index:(typeof index === 'undefined' ? null : index), from:from, thru:thru}))</script></actions>
        <default-response type="none"/>
    </transition>
    <actions><script><![CDATA[
        const player = ec.resource.script('component://tools/template/ReportPlaylists.js').player({definitionId, from, thru})
        playlistTitle = player.title; playlistSeconds = player.seconds; playlistRange = player.range
        // Links still open the full dashboard; the playlist requests authorized frames from its data transition.
        const dashboardPath = sri.buildUrl(ec.resource.script('component://tools/template/ReportMount.js').url('dashboard')).path
        playlistEntries = player.entries.map(entry => ({index: entry.index, title: entry.title,
            url: dashboardPath + '?definitionId=' + encodeURIComponent(entry.id) + '&from=' + encodeURIComponent(player.range.from) + '&thru=' + encodeURIComponent(player.range.thru) + '&kiosk=true'}))
        playlistsLink = player.links.playlists
    ]]></script></actions>
    <widgets>
        <link url="${playlistsLink}" text="All playlists" link-type="anchor" parameter-map="{definitionId:''}" condition="playlistsLink"/>
        <label text="${playlistTitle}" type="h4"/>
        <render-mode>
            <text type="qvt"><![CDATA[<m-report-playlist source="${WebUtilities.encodeHtml(sri.buildUrl('data').getUrlWithParams())}" :items="${WebUtilities.encodeHtml(JSON.stringify(playlistEntries))}" :seconds="${playlistSeconds}"></m-report-playlist>]]></text>
            <text type="tui"><![CDATA[${JSON.stringify({t:'component',name:'report-playlist',props:{source:sri.buildUrl('data').getUrlWithParams(),definitionId:definitionId,from:playlistRange.from,thru:playlistRange.thru,items:playlistEntries,seconds:playlistSeconds}})}]]></text>
            <text type="html,html-print,text"><![CDATA[<p>Open a dashboard below.</p>]]></text>
        </render-mode>
        <form-list name="PlaylistDashboards" list="playlistEntries" skip-form="true">
            <field name="title"><default-field><link url="${url}" url-type="plain" text="${title}"/></default-field></field>
        </form-list>
    </widgets>
</screen>
