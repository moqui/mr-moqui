<?xml version="1.0" encoding="UTF-8"?>
<!-- Monitoring/reporting grants are separate so an upgrade need not reload unrelated tool grants. Monitor is a section
    of System and is granted with it: its datasets, services and entities are members of SYSTEM_APP (ToolsSecurityData.xml). -->
<entity-facade-xml type="seed">
    <artifactGroups artifactGroupId="DASHBOARDS_APP" description="Dashboards and report execution">
        <artifacts artifactName="/moqui/reports" artifactTypeEnumId="AT_REST_PATH" inheritAuthz="Y"/>
        <artifacts artifactName="component://tools/screen/Dashboards.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <artifacts artifactName="org.moqui.report.ReportServices.*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y"/>
        <authz artifactAuthzId="DASHBOARDS_APP_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <artifactGroups artifactGroupId="REPORT_DATASETS_ADMIN" description="Dataset administration and unrestricted dataset access">
        <artifacts artifactName="org.moqui.report.dataset.*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y"/>
        <authz artifactAuthzId="REPORT_DATASETS_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <artifactGroups artifactGroupId="REPORT_GIT_SYNC_ADMIN" description="Create, push and pull git syncs of definition folders">
        <artifacts artifactName="org.moqui.report.gitSync" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="REPORT_GIT_SYNC_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <artifactGroups artifactGroupId="REPORT_CONTACT_ADMIN" description="Allow outgoing report alert webhooks">
        <artifacts artifactName="org.moqui.report.contact.webhook" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="REPORT_CONTACT_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Business events on the time series (source business of create#Annotation) and the records of a dataset whose
        definition restricts them (rows restricted; crates/moqui-report/src/semantics.rs): ADMIN's, and a domain service
        writes its own events with authorization off after its commit -->
    <artifactGroups artifactGroupId="REPORT_BUSINESS_ADMIN" description="Business annotations and restricted dataset records">
        <artifacts artifactName="org.moqui.report.annotation.business" artifactTypeEnumId="AT_SERVICE"/>
        <artifacts artifactName="org.moqui.report.rows.*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y"/>
        <authz artifactAuthzId="REPORT_BUSINESS_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Group delivery of a report schedule (store#Schedule and check#ReportAudience for recipients other than the owner;
        crates/moqui-report/src/delivery.rs): ADMIN's, and an app grants it to its distributors -->
    <artifactGroups artifactGroupId="REPORT_DELIVERY_ADMIN" description="Deliver report schedules to owner-equivalent groups">
        <artifacts artifactName="org.moqui.report.delivery.group" artifactTypeEnumId="AT_SERVICE"/>
        <authz artifactAuthzId="REPORT_DELIVERY_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Sharing a definition with a group the sharer is not in (save#Definition, org.moqui.report.share.<userGroupId>;
        crates/moqui-report/src/definitions.rs): ADMIN's for any group, and an app grants the artifact of a group no
        person is in (its wall displays) to those who share with it. A group of one's own needs no grant -->
    <artifactGroups artifactGroupId="REPORT_SHARE_ADMIN" description="Share report definitions with any user group">
        <artifacts artifactName="org.moqui.report.share.*" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y"/>
        <authz artifactAuthzId="REPORT_SHARE_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <moqui.security.UserPermission userPermissionId="MONITOR_INGEST" description="Send telemetry through source-scoped ingestion keys"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MONITOR_INGEST" fromDate="0"/>
    <moqui.security.UserPermission userPermissionId="MONITOR_REPLAY" description="See browser session replays (Monitor › Replays)"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MONITOR_REPLAY" fromDate="0"/>
    <moqui.security.UserPermission userPermissionId="MONITOR_INCIDENT" description="See and work on regressions and incidents (Monitor › Releases and Incidents)"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MONITOR_INCIDENT" fromDate="0"/>
    <moqui.security.UserPermission userPermissionId="MONITOR_RECOVER" description="Approve, refuse, mark done and cancel recovery actions"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MONITOR_RECOVER" fromDate="0"/>
    <moqui.security.UserPermission userPermissionId="MONITOR_RECOVER_ADMIN" description="Manage recovery policies and adapters and the recovery emergency stop"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MONITOR_RECOVER_ADMIN" fromDate="0"/>
    <moqui.security.UserPermission userPermissionId="MONITOR_SETTINGS" description="Change logging and telemetry settings for a while (Monitor › Settings)"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MONITOR_SETTINGS" fromDate="0"/>
    <moqui.security.UserPermission userPermissionId="REPORT_SAVE_LOCATION" description="Write scheduled report files to configured server resource locations"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="REPORT_SAVE_LOCATION" fromDate="0"/>
    <moqui.security.ArtifactGroup artifactGroupId="REPORT_ALERT_EVALUATION" description="Evaluate alert rules for all owners"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="REPORT_ALERT_EVALUATION" artifactTypeEnumId="AT_SERVICE" artifactName="org.moqui.report.alert.evaluateAll" inheritAuthz="Y"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="REPORT_ALERT_EVALUATION_ADMIN" artifactGroupId="REPORT_ALERT_EVALUATION" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
</entity-facade-xml>
