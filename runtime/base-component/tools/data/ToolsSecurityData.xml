<entity-facade-xml type="seed">
    <!-- Tools App artifacts/authz -->
    <artifactGroups artifactGroupId="TOOLS_APP" description="Tools App (via root screen)">
        <artifacts artifactName="component://tools/screen/Tools.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <!-- Full permissions for the ADMIN user group -->
        <authz artifactAuthzId="TOOLS_APP_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>

    <!-- Tools database administration (plans/Tools-Database.md §14.1), both sealed (user-facade authz
        sealed-permissions): DATABASE_ADMIN cancels or terminates sessions, runs DDL and maintenance jobs and resets
        statement stats; DATABASE_EXTERNAL reaches databases the entity groups do not use (db=ext:...), never on a
        production instance. -->
    <moqui.security.UserPermission userPermissionId="DATABASE_ADMIN" description="Tools: Database Administration"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN_ADV" userPermissionId="DATABASE_ADMIN" fromDate="0"/>
    <moqui.security.UserPermission userPermissionId="DATABASE_EXTERNAL" description="Tools: External Databases"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN_ADV" userPermissionId="DATABASE_EXTERNAL" fromDate="0"/>
    <!-- org.moqui.impl.DatabaseServices (crates/moqui-tools): each service refuses a user the Tools app's own
        authorization (TOOLS_APP above) does not let view Tools.xml, and checks DATABASE_ADMIN or DATABASE_EXTERNAL where
        it needs them, so any signed-in user reaches the service and the service decides. inheritAuthz N: what the
        services read and write through the entity facade needs its own authorization. -->
    <artifactGroups artifactGroupId="TOOLS_DATABASE_API" description="Tools database services (each checks the Tools app)">
        <artifacts artifactName="org\.moqui\.impl\.DatabaseServices\..*" nameIsPattern="Y" artifactTypeEnumId="AT_SERVICE"
                inheritAuthz="N"/>
        <authz artifactAuthzId="TOOLS_DATABASE_API_USERS" userGroupId="ALL_USERS" authzTypeEnumId="AUTHZT_ALLOW"
                authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>

    <!-- System App artifacts/authz -->
    <artifactGroups artifactGroupId="SYSTEM_APP" description="System App (via root screen)">
        <artifacts artifactName="component://tools/screen/System.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <!-- Full permissions for the ADMIN user group -->
        <authz artifactAuthzId="SYSTEM_APP_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>

    <!-- Artifact group for all of the Moqui Tools REST API via the moqui resource (the root resource) -->
    <artifactGroups artifactGroupId="MOQUI_API" description="Moqui Tools REST API (via root resource)">
        <artifacts artifactTypeEnumId="AT_REST_PATH" inheritAuthz="Y" artifactName="/moqui"/>
        <!-- Full permissions for the ADMIN user group -->
        <authz artifactAuthzId="MOQUI_API_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Commit statuses posted by outside CI: any signed-in user reaches the path, and the services check the push right
        on the repository (AT_GIT_REPOSITORY) -->
    <artifactGroups artifactGroupId="MOQUI_API_GIT" description="Moqui Tools REST API: git commit statuses">
        <artifacts artifactTypeEnumId="AT_REST_PATH" inheritAuthz="Y" artifactName="/moqui/git"/>
        <authz artifactAuthzId="MOQUI_API_GIT_USERS" userGroupId="ALL_USERS" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
</entity-facade-xml>
