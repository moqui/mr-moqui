<!-- The AdminMounts spec's app root (test only, never mounted): an app that shows System's administration screens under its
    own root, as IronStone Admin does (README, "Mounting the administration screens"). Its adminMount sends a user's link to
    its own screen, adds a route of its own and leaves one part out. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Admin mount">
    <always-actions>
        <set field="adminMount" from="{routes:{user:{url:'../Staff', idParameter:'staffUserId'}, storeIntegration:{url:'../Store', idParameter:'storeId', parameters:{tab:'messages'}}}, hide:['scheduler']}"/>
    </always-actions>
    <subscreens default-item="Probe">
        <!-- a System screen that has instance administrator's transitions, mounted by location: what an app must not do
            (it includes such a screen and takes in the transitions it wants), here to show that the screen refuses them -->
        <subscreens-item name="JobDetail" location="component://tools/screen/System/Operations/JobDetail.xml"/>
    </subscreens>
    <widgets><subscreens-active/></widgets>
</screen>
