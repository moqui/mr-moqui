<!-- The test mount's dashboard: Tools' Dashboard screen with its transitions here, and what template/ReportMount.js answers
    under the mount, as a transition's answer (no render). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Board">
    <transition-include name="edit" location="component://tools/screen/Dashboards/Dashboard.xml"/>
    <transition-include name="inspectPanel" location="component://tools/screen/Dashboards/Dashboard.xml"/>
    <transition-include name="duplicatePanel" location="component://tools/screen/Dashboards/Dashboard.xml"/>
    <transition name="mountState" method="get" read-only="true">
        <actions><script>ec.web.sendJsonResponse(ec.resource.script('component://tools/template/ReportMount.js').state())</script></actions>
        <default-response type="none"/>
    </transition>
    <widgets><include-screen location="component://tools/screen/Dashboards/Dashboard.xml" share-scope="true"/></widgets>
</screen>
