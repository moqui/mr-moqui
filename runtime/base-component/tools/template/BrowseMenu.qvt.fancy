<#-- The tabs of an auto-generated entity screen in the qvt mode: the entity itself and each dependent entity, then the active subscreen. -->
<#assign masterUrl = sri.buildUrl("AutoEditMaster").addParameter("aen", aen).addParameters(masterPrimaryKeyMap || {}).removeParameter("den")>
<div id="auto-menu">
    <q-tabs id="auto-edit-tabs" dense no-caps align="left" narrow-indicator inline-label class="text-grey-7" active-color="primary" indicator-color="primary" :model-value="$root.currentParameters.den||'current'">
        <q-tab name="current" label="${html(aen)}" @click="$root.setUrl('${html(masterUrl.pathWithParams)}')"></q-tab>
<#list relationshipInfoList || [] as relationshipInfo>
<#assign curKeyMap = relationshipInfo.getTargetParameterMap(context)>
<#if curKeyMap>
<#assign tabUrl = sri.buildUrl("AutoEditDetail").addParameters(masterPrimaryKeyMap || {}).addParameter("den", relationshipInfo.riRelatedEntityName()).addParameter("aen", aen).addParameters(curKeyMap)>
        <q-tab name="${html(relationshipInfo.riRelatedEntityName())}" label="${html(relationshipInfo.riPrettyName())}" @click="$root.setUrl('${html(tabUrl.pathWithParams)}')"></q-tab>
</#if>
</#list>
    </q-tabs>
    <q-separator class="q-mb-md"></q-separator>
    <m-subscreens-active></m-subscreens-active>
</div>
