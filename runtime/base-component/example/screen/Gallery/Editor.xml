<!-- Gallery screen for the 3.13 Editor archetype of the style guide: a wiki page with its page list at the side, the
    rendered page, and history, compare, restore and publish as actions. Unlike the other gallery screens this one
    writes, into its own demo spaces only: EXAMPLE (pages are dbresource files, past versions kept as reverse deltas)
    and EXGIT (pages are files in the database git repository example-wiki, versions are commits), which the screen
    creates on request. Data: data/ExampleWikiData.xml. Guide: docs/Revision-Management.md. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Editor" default-menu-index="15" menu-image="sym_o_text_fields" menu-image-type="icon">

    <parameter name="wikiSpaceId"/>
    <parameter name="pagePath"/>
    <parameter name="versionName"/>
    <parameter name="versionNameLhs"/>
    <parameter name="versionNameRhs"/>

    <transition name="savePage">
        <actions>
            <set field="pageName" from="pagePath ? pagePath.substring(pagePath.lastIndexOf('/') + 1) : wikiSpaceId"/>
            <service-call name="org.moqui.impl.WikiServices.update#WikiPage"
                    in-map="{wikiSpaceId:wikiSpaceId, pagePath:pagePath, pageName:pageName, pageText:pageText, versionNote:versionNote}"/>
        </actions>
        <default-response url="."><parameter name="wikiSpaceId"/><parameter name="pagePath"/></default-response>
    </transition>
    <!-- a restore writes the old text as a new version, so nothing in the history is lost -->
    <transition name="restoreVersion">
        <actions>
            <service-call name="org.moqui.impl.WikiServices.get#WikiPageInfo" in-map="{wikiSpaceId:wikiSpaceId, pagePath:pagePath}"
                    out-map="restoreInfo"/>
            <if condition="!restoreInfo.wikiPageId"><return error="true" message="There is no page ${pagePath} in ${wikiSpaceId}"/></if>
            <service-call name="org.moqui.impl.WikiServices.restore#WikiPageVersion"
                    in-map="{wikiPageId:restoreInfo.wikiPageId, versionName:versionName}"/>
            <message>Restored version ${versionName.substring(0, 10)} as the newest version</message>
        </actions>
        <default-response url="."><parameter name="wikiSpaceId"/><parameter name="pagePath"/></default-response>
    </transition>
    <transition name="publishVersion">
        <service-call name="org.moqui.impl.WikiServices.set#PublishedVersion"/>
        <default-response url="."><parameter name="wikiSpaceId"/><parameter name="pagePath"/><parameter name="versionName"/></default-response>
    </transition>
    <transition name="createGitSpace">
        <actions>
            <service-call name="org.moqui.impl.WikiServices.create#WikiSpace"
                    in-map="{wikiSpaceId:'EXGIT', description:'Example wiki (git)', rootPageDirectory:'git://example-wiki'}"/>
            <service-call name="org.moqui.impl.WikiServices.update#WikiPage" in-map="{wikiSpaceId:'EXGIT', pageName:'Welcome',
                    pageText:'# Welcome\n\nThis space keeps its pages in the git repository example-wiki, in the database. Each save is a commit.\n'}"/>
        </actions>
        <default-response url="."><parameter name="wikiSpaceId" value="EXGIT"/><parameter name="pagePath" value="Welcome"/></default-response>
    </transition>

    <actions>
        <if condition="!wikiSpaceId"><set field="wikiSpaceId" value="EXAMPLE"/></if>
        <entity-find-one entity-name="moqui.resource.wiki.WikiSpace" value-field="gitSpace">
            <field-map field-name="wikiSpaceId" value="EXGIT"/></entity-find-one>
        <entity-find entity-name="moqui.resource.wiki.WikiPage" list="pageList">
            <econdition field-name="wikiSpaceId"/><order-by field-name="sequenceNum,pagePath"/></entity-find>
        <if condition="pagePath == null &amp;&amp; pageList.length">
            <set field="pagePath" from="(pageList.find((page) => page.pagePath) || pageList[0]).pagePath || ''"/></if>
        <service-call name="org.moqui.impl.WikiServices.get#WikiPageInfo" out-map="pageInfo"
                in-map="{wikiSpaceId:wikiSpaceId, pagePath:pagePath || '', versionName:versionName}"/>
        <set field="pageReference" from="pageInfo.pageReference"/>
        <set field="currentVersionName" from="pageInfo.currentVersionName"/>
        <set field="publishedVersionName" from="pageInfo.publishedVersionName"/>
        <set field="viewVersion" from="versionName &amp;&amp; versionName != currentVersionName ? versionName : null"/>
        <script><![CDATA[
            // a git version name is a 40 digit commit id; show its first 10 digits
            const short = (name) => name == null ? '' : String(name).length > 12 ? String(name).substring(0, 10) : String(name)
            pageTitle = pagePath ? pagePath.substring(pagePath.lastIndexOf('/') + 1) : (pageInfo.wikiSpace?.description || wikiSpaceId)
            pageText = pageReference?.exists ? (pageReference.getText() ?? '') : ''
            const userNames = {}
            const userName = (userId) => {
                if (!userId) return ''
                if (!(userId in userNames)) {
                    const account = ec.entity.find("moqui.security.UserAccount").condition("userId", userId).one()
                    userNames[userId] = account ? (account.userFullName || account.username) : userId
                }
                return userNames[userId]
            }
            const history = pageReference?.exists ? pageReference.getVersionHistory() : []
            versionList = history.map((version, index) => ({
                versionName: version.versionName, shortName: short(version.versionName),
                previousVersionName: version.previousVersionName,
                versionDate: version.versionDate ? ec.l10n.format(version.versionDate, 'yyyy-MM-dd HH:mm') : '',
                userName: userName(version.userId), note: version.note ? String(version.note).split('\n')[0] : '', isCurrent: index === 0,
                isPublished: version.versionName === publishedVersionName }))
            versionCount = versionList.length
            currentShort = short(currentVersionName)
            viewShort = short(viewVersion)
            publishedShort = short(publishedVersionName)
            storage = String(pageInfo.pageLocation || '').startsWith('git:') ? 'git commits' : 'dbresource history'

            // the compare: a server-side diff, an HTML table with every text escaped
            diffHtml = null
            diffText = null
            if (versionNameLhs && pageReference?.exists) {
                try {
                    const diff = pageReference.getVersionDiff(versionNameLhs, versionNameRhs || '')
                    diffHtml = diff.html
                    diffText = diff.unifiedDiff
                    diffTitle = 'Compare ' + short(diff.fromName) + ' with ' + short(diff.toName) + ': ' + diff.stats.insertions +
                            ' added, ' + diff.stats.deletions + ' removed'
                } catch (err) {
                    ec.message.addError('Cannot compare: ' + err.message)
                }
            }
        ]]></script>
    </actions>
    <widgets>
        <container-box type="info"><box-header title="Archetype 3.13 Editor"/><box-body>
            <label type="p" text="A document the user writes: the page list at the side, the rendered page with its title and version in a title row, and History, Compare, Restore and Publish as actions in a dialog, not tabs. The body is a text-area with editor-type md (the co-editing component of §8 is not built). Unlike the other gallery screens these actions write, into the demo spaces only."/>
            <label type="p" text="Two storages under one resource API: the EXAMPLE space keeps its pages as dbresource files (each past version a reverse delta), the EXGIT space as files in a git repository in the database (each version a commit). The compare is rendered on the server."/>
        </box-body></container-box>

        <container-row>
            <row-col lg="3" md="4">
                <container-box><box-header title="${pageInfo.wikiSpace?.description || wikiSpaceId}"/><box-body>
                    <section-iterate name="PageLinks" list="pageList" entry="page"><widgets><container>
                        <link url="." text="${page.pagePath || 'Home'}" link-type="anchor" style="${(page.pagePath || '') == (pagePath || '') ? 'text-weight-bold' : ''}"
                                parameter-map="{wikiSpaceId:wikiSpaceId, pagePath:page.pagePath || ''}"/>
                    </container></widgets></section-iterate>
                </box-body></container-box>
                <container-box><box-header title="Spaces"/><box-body>
                    <container><link url="." text="dbresource: EXAMPLE" link-type="anchor" parameter-map="{wikiSpaceId:'EXAMPLE'}"/></container>
                    <container><link url="." text="git: EXGIT" link-type="anchor" parameter-map="{wikiSpaceId:'EXGIT'}" condition="gitSpace"/></container>
                    <link url="createGitSpace" text="Create the git space" condition="!gitSpace"
                            confirmation="Create the EXGIT space in the git repository example-wiki?"/>
                </box-body></container-box>
            </row-col>
            <row-col lg="9" md="8">
                <!-- title row -->
                <container style="row items-center q-col-gutter-sm q-mx-sm q-mb-sm">
                    <container style="col-12 col-md">
                        <label text="${pageTitle}" type="h5" style="q-my-none"/>
                        <label text="${viewVersion ? 'Version ' + viewShort + ' (not current)' : 'Version ' + currentShort} · ${versionCount} versions in ${storage}${publishedShort ? ' · published ' + publishedShort : ''}"
                                type="div" style="text-caption text-grey-6"/>
                    </container>
                    <container style="col-12 col-md-auto row items-center q-gutter-x-sm no-wrap">
                        <container-dialog id="EditPageDialog" button-text="Edit" width="960">
                            <form-single name="EditPage" transition="savePage">
                                <field name="wikiSpaceId"><default-field><hidden/></default-field></field>
                                <field name="pagePath"><default-field><hidden/></default-field></field>
                                <field name="pageText"><default-field title="">
                                    <text-area rows="18" cols="100" editor-type="md"/></default-field></field>
                                <field name="versionNote"><default-field title="Version note"><text-line size="60"/></default-field></field>
                                <field name="submitButton"><default-field title="Save as a new version"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                        <container-dialog id="HistoryDialog" button-text="History" width="960">
                            <form-list name="VersionList" list="versionList" skip-form="true">
                                <field name="shortName"><default-field title="Version">
                                    <link url="." text="${shortName}" link-type="anchor"
                                            parameter-map="{wikiSpaceId:wikiSpaceId, pagePath:pagePath, versionName:versionName}"/>
                                </default-field></field>
                                <field name="versionDate"><default-field title="Date"><display/></default-field></field>
                                <field name="userName"><default-field title="By"><display/></default-field></field>
                                <field name="note"><default-field title="Note"><display/></default-field></field>
                                <field name="state"><default-field title="">
                                    <label text="current" condition="isCurrent" style="text-positive"/>
                                    <label text=" published" condition="isPublished" style="text-primary"/>
                                </default-field></field>
                                <field name="compare"><default-field title="Compare"><container style="row no-wrap q-gutter-x-md">
                                    <link url="." text="prev" link-type="anchor" condition="previousVersionName"
                                            parameter-map="{wikiSpaceId:wikiSpaceId, pagePath:pagePath, versionNameLhs:previousVersionName, versionNameRhs:versionName}"/>
                                    <link url="." text="current" link-type="anchor" condition="!isCurrent"
                                            parameter-map="{wikiSpaceId:wikiSpaceId, pagePath:pagePath, versionNameLhs:versionName}"/>
                                </container></default-field></field>
                                <field name="actions"><default-field title="">
                                    <link url="restoreVersion" text="Restore" condition="!isCurrent" link-type="hidden-form-link"
                                            confirmation="Restore version ${shortName} as the newest version?"
                                            parameter-map="{wikiSpaceId:wikiSpaceId, pagePath:pagePath, versionName:versionName}"/>
                                    <link url="publishVersion" text="Publish" condition="!isPublished &amp;&amp; pageInfo.wikiPageId" link-type="hidden-form-link"
                                            parameter-map="{wikiSpaceId:wikiSpaceId, pagePath:pagePath, wikiPageId:pageInfo.wikiPageId, publishedVersionName:versionName}"/>
                                </default-field></field>
                            </form-list>
                        </container-dialog>
                    </container>
                </container>

                <section name="ViewingVersion" condition="viewVersion"><widgets>
                    <container-box type="warning"><box-header title="Version ${viewShort}, not the current text"/><box-body>
                        <container style="row items-center q-gutter-x-md">
                        <link url="." text="Back to current" link-type="anchor" parameter-map="{wikiSpaceId:wikiSpaceId, pagePath:pagePath}"/>
                        <link url="." text="Compare with current" link-type="anchor"
                                parameter-map="{wikiSpaceId:wikiSpaceId, pagePath:pagePath, versionNameLhs:viewVersion}"/>
                        <link url="restoreVersion" text="Restore this version" confirmation="Restore version ${viewShort} as the newest version?"
                                parameter-map="{wikiSpaceId:wikiSpaceId, pagePath:pagePath, versionName:viewVersion}"/>
                        </container>
                    </box-body></container-box>
                </widgets></section>

                <section name="Compare" condition="diffHtml"><widgets>
                    <container-box><box-header title="${diffTitle}"/><box-toolbar>
                        <link url="." text="Close" link-type="anchor" parameter-map="{wikiSpaceId:wikiSpaceId, pagePath:pagePath}"/>
                    </box-toolbar><box-body>
                        <render-mode><text type="html,qvt"><![CDATA[<div class="scroll">${diffHtml}</div>]]></text>
                            <!-- the same compare as a unified diff -->
                            <text type="tui"><![CDATA[{"t": "text", "id": "EditorDiff", "style": "pre", "text": ${JSON.stringify(String(diffText || ''))}}]]></text></render-mode>
                    </box-body></container-box>
                </widgets></section>

                <section name="PageBody" condition="pageReference?.exists"><widgets>
                    <container-box><box-body>
                        <render-mode><text type="html,qvt" template="true"
                                location="${pageInfo.pageLocation}${viewVersion ? '#' + viewVersion : ''}"/>
                            <!-- the same page rendered, as text blocks with numbered links -->
                            <text type="tui"><![CDATA[${JSON.stringify(Object.assign({t: 'html', id: 'EditorPageBody'},
                                JSON.parse(sri.htmlText(String(sri.renderTextValue(pageInfo.pageLocation + (viewVersion ? '#' + viewVersion : ''), 'true') || '')))))}]]></text></render-mode>
                    </box-body></container-box>
                </widgets><fail-widgets>
                    <label type="p" text="There is no page ${pagePath} in ${wikiSpaceId}."/>
                </fail-widgets></section>
            </row-col>
        </container-row>
    </widgets>
</screen>
