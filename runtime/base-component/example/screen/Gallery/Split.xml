<!-- Gallery screen for the 3.8 Split archetype of the style guide: a master list of countries beside the selected
    country's detail and its states, over moqui.basic.Geo and GeoAssoc, in a container-split (style-guide §8.2). The
    selected geoId is in the URL (select-parameter), so below 1024 px the list shows alone until a country is chosen, and
    the detail shows with a back button to the list. The side list is find-driven and limited to 30 rows because the
    paging row of a form-list does not fit in a 320 px pane. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Split" default-menu-index="8">

    <parameter name="geoId"/>

    <transition name="editCountry"><actions>
        <message>Edit ${geoId}: a gallery demo, nothing is written</message>
    </actions><default-response url="."><parameter name="geoId"/></default-response></transition>

    <actions>
        <entity-find entity-name="moqui.basic.Geo" list="countryList" limit="30">
            <search-form-inputs default-order-by="geoName" paginate="false" skip-fields="geoId"/>
            <econdition field-name="geoTypeEnumId" value="GEOT_COUNTRY"/>
        </entity-find>
        <entity-find-count entity-name="moqui.basic.Geo" count-field="countryCount">
            <search-form-inputs paginate="false" skip-fields="geoId"/>
            <econdition field-name="geoTypeEnumId" value="GEOT_COUNTRY"/>
        </entity-find-count>
        <!-- side by side the first country fills the main pane; stacked, no selection shows the list alone -->
        <set field="shownGeoId" from="geoId || (countryList.length ? countryList[0].geoId : null)"/>
        <entity-find-one entity-name="moqui.basic.Geo" value-field="country"><field-map field-name="geoId" from="shownGeoId"/></entity-find-one>
        <entity-find entity-name="moqui.basic.GeoAssocAndToDetail" list="stateList">
            <econdition field-name="geoId" from="shownGeoId"/>
            <order-by field-name="geoName"/>
        </entity-find>
    </actions>
    <widgets>
        <container-box type="info"><box-header title="Archetype 3.8 Split"/><box-body>
            <label text="A master list beside a detail pane: countries on the side with a header find, the selected country in the main pane with its details in a box and its states as a list. The selected geoId is in the URL so the detail is bookmarkable; the side list keeps its find while the detail changes." type="p"/>
            <label text="container-split (§8.2): a splitter from 1024 px whose side can be dragged from 200 px to what leaves 480 px to the main pane, its width kept for the session; below 1024 px the panes stack, the list alone until a country is chosen, then the country with a back button. The side list is limited to 30 rows and narrowed by the find instead of paged, because a form-list's paging row does not fit in a 320 px pane." type="p"/>
        </box-body></container-box>

        <container-split id="CountrySplit" side-width="320" min-main="480" select-parameter="geoId" back-text="Countries">
            <split-side>
                <form-list name="CountryList" list="countryList" skip-form="true" paginate="false">
                    <field name="geoName">
                        <header-field title="Country" show-order-by="true"><text-find size="12" default-operator="begins"/></header-field>
                        <default-field><link url="." text="${geoName}" style="${geoId == shownGeoId ? 'text-weight-bold' : ''}">
                            <parameter name="geoId"/></link></default-field>
                    </field>
                    <field name="geoCodeAlpha2"><default-field title="Code"><display style="text-mono"/></default-field></field>
                </form-list>
                <label text="${countryList.length} of ${countryCount} countries; narrow the list with the find." type="p" style="text-caption text-grey-7 q-px-sm"
                        condition="countryCount > countryList.length"/>
            </split-side>
            <split-main>
                <section name="CountrySection" condition="country"><widgets>
                    <container-box><box-header title="${country.geoName}"/><box-toolbar>
                        <link url="editCountry" text="Edit" icon="edit" parameter-map="{geoId: country.geoId}"/>
                    </box-toolbar><box-body>
                        <form-single name="CountryDetail" map="country">
                            <field name="geoId"><default-field title="Geo ID"><display style="text-mono"/></default-field></field>
                            <field name="geoTypeEnumId"><default-field title="Type"><display-entity entity-name="moqui.basic.Enumeration"/></default-field></field>
                            <field name="geoCodeAlpha2"><default-field title="Alpha-2"><display style="text-mono"/></default-field></field>
                            <field name="geoCodeAlpha3"><default-field title="Alpha-3"><display style="text-mono"/></default-field></field>
                            <field name="geoCodeNumeric"><default-field title="Numeric"><display style="text-mono"/></default-field></field>
                            <field name="stateCount" from="stateList.length"><default-field title="States and regions"><display/></default-field></field>
                            <field-layout>
                                <field-col-row>
                                    <field-col xs="12" md="6"><field-ref name="geoId"/><field-ref name="geoCodeAlpha2"/><field-ref name="geoCodeNumeric"/></field-col>
                                    <field-col xs="12" md="6"><field-ref name="geoTypeEnumId"/><field-ref name="geoCodeAlpha3"/><field-ref name="stateCount"/></field-col>
                                </field-col-row>
                            </field-layout>
                        </form-single>
                    </box-body></container-box>
                    <container-box><box-header title="States and regions"/><box-body-nopad>
                        <form-list name="StateList" list="stateList" skip-form="true" paginate="false">
                            <field name="toGeoId"><default-field title="Geo ID"><display style="text-mono"/></default-field></field>
                            <field name="geoName"><default-field title="Name"><display/></default-field></field>
                            <field name="geoCodeAlpha2"><default-field title="Code"><display style="text-mono"/></default-field></field>
                            <field name="geoTypeEnumId"><default-field title="Type"><display-entity entity-name="moqui.basic.Enumeration"/></default-field></field>
                        </form-list>
                        <label text="No states or regions are recorded for ${country.geoName}." type="p" style="q-pa-sm" condition="!stateList.length"/>
                    </box-body-nopad></container-box>
                </widgets></section>
                <section name="NoCountrySection" condition="!country"><widgets>
                    <container-box><box-header title="No country"/><box-body>
                        <label text="No country matches ${geoId}. Pick one from the list." type="p"/>
                    </box-body></container-box>
                </widgets></section>
            </split-main>
        </container-split>
    </widgets>
</screen>
