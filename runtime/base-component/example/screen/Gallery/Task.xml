<!-- Gallery screen for the 3.5 Task archetype of the style guide: a pick step over an inline list of lines, with the
    step area in a dynamic-container. The container loads this same screen with stepOnly=Y (the stepLoad transition only
    names "." so the macro expands the container URL to it), which renders the step section alone; Confirm submits in
    the background and reloads the container. Nothing is written: the pick lines are an inline list in the actions. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Task" default-menu-index="5">

    <parameter name="stepOnly"/>
    <parameter name="lineIndex"/>

    <transition name="stepLoad"><default-response url="."/></transition>
    <transition name="confirm"><actions>
        <message type="success">Confirmed ${scanInput || ''} of ${productId || ''} at ${locationId || ''} (gallery demo: nothing is written)</message>
    </actions><default-response type="none"/></transition>
    <transition name="short"><actions>
        <set field="nextIndex" from="(Number(lineIndex) || 0) + 1"/>
        <message type="warning">Short: line ${lineSeq || ''} marked short (gallery demo: nothing is written)</message>
    </actions><default-response url="."><parameter name="lineIndex" from="nextIndex"/></default-response></transition>
    <transition name="skip"><actions>
        <set field="nextIndex" from="(Number(lineIndex) || 0) + 1"/>
        <message>Skipped line ${lineSeq || ''} (gallery demo: nothing is written)</message>
    </actions><default-response url="."><parameter name="lineIndex" from="nextIndex"/></default-response></transition>

    <actions>
        <set field="lines" from="[
            {lineSeq: 1, locationId: 'A-03-12', productId: 'WIDGET-RED-L', productName: 'Red widget, large', quantity: 4},
            {lineSeq: 2, locationId: 'A-03-14', productId: 'WIDGET-BLU-L', productName: 'Blue widget, large', quantity: 2},
            {lineSeq: 3, locationId: 'A-04-01', productId: 'GADGET-STD', productName: 'Gadget, standard', quantity: 12},
            {lineSeq: 4, locationId: 'B-01-07', productId: 'GIZMO-MINI', productName: 'Gizmo, mini', quantity: 1},
            {lineSeq: 5, locationId: 'B-02-03', productId: 'WIDGET-GRN-S', productName: 'Green widget, small', quantity: 6},
            {lineSeq: 6, locationId: 'C-11-20', productId: 'BRACKET-L', productName: 'Bracket, left', quantity: 8},
            {lineSeq: 7, locationId: 'C-11-21', productId: 'BRACKET-R', productName: 'Bracket, right', quantity: 8}]"/>
        <set field="lineIndex" from="Math.min(Math.max(Number(lineIndex) || 0, 0), lines.length - 1)"/>
        <set field="current" from="lines[lineIndex]"/>
        <set field="remaining" from="lines.slice(lineIndex + 1)"/>
        <set field="stepTitle" value="Pick · Wave W-118 · line ${lineIndex + 1} of ${lines.length}"/>
    </actions>
    <widgets>
        <!-- The step alone, as the dynamic-container loads it -->
        <section name="StepOnly" condition="stepOnly == 'Y'"><widgets>
            <container-box><box-header title="${stepTitle}"/><box-body>
                <form-single name="PickStep" transition="confirm" map="current" background-submit="true" background-reload-id="TaskStep" focus-field="scanInput"
                        background-message="Line confirmed; the step reloaded (gallery demo: nothing is written)">
                    <field name="lineSeq"><default-field><hidden/></default-field></field>
                    <field name="lineIndex"><default-field><hidden default-value="${lineIndex}"/></default-field></field>
                    <field name="locationId"><default-field title="Location"><display style="text-h5 text-mono"/></default-field></field>
                    <field name="productId"><default-field title="Product"><display text="${productId} · ${productName}" style="text-h5"/></default-field></field>
                    <field name="scanInput"><default-field title="Pick">
                        <text-line size="10" default-value="${quantity}"/>
                        <label text="of ${quantity} · scan or type" style="text-body1"/>
                    </default-field></field>
                    <field name="confirmButton"><default-field title="Confirm"><submit icon="check"/></default-field></field>
                    <field name="shortButton"><default-field><link url="short" text="Short" btn-type="warning" icon="remove_circle_outline"
                            parameter-map="{lineSeq: lineSeq, lineIndex: lineIndex}"/></default-field></field>
                    <field name="skipButton"><default-field><link url="skip" text="Skip" icon="skip_next"
                            parameter-map="{lineSeq: lineSeq, lineIndex: lineIndex}"/></default-field></field>
                    <field-layout>
                        <field-ref name="lineSeq"/>
                        <field-ref name="lineIndex"/>
                        <field-row><field-ref name="locationId"/><field-ref name="productId"/></field-row>
                        <field-row-big><field-ref name="scanInput"/></field-row-big>
                        <field-row-big><field-ref name="confirmButton"/><field-ref name="shortButton"/><field-ref name="skipButton"/></field-row-big>
                    </field-layout>
                </form-single>
            </box-body></container-box>
        </widgets></section>

        <!-- The whole screen -->
        <section name="Full" condition="stepOnly != 'Y'"><widgets>
            <container-box type="info"><box-header title="Archetype 3.5 Task"/><box-body>
                <label text="One operational job at a time: the current pick line with large read-only location and product, a focused scan field (Enter confirms), Confirm as the one primary and Short / Skip as tonal actions, then a compact list of what remains. The step is a dynamic-container that reloads after Confirm; Short and Skip move to the next line through the URL." type="p"/>
                <label text="Fallbacks: the handheld density of §8 (48 px controls) does not exist yet, so the controls are the dense defaults; pick lines have no framework entity, so they are an inline list built in the screen actions." type="p"/>
            </box-body></container-box>

            <dynamic-container id="TaskStep" transition="stepLoad">
                <parameter name="stepOnly" value="Y"/><parameter name="lineIndex" from="lineIndex"/></dynamic-container>

            <container-box><box-header title="Remaining lines (${remaining.length})"/><box-body-nopad>
                <form-list name="RemainingLines" list="remaining" skip-form="true" skip-header="true" paginate="false">
                    <field name="lineSeq"><default-field title="Line"><display/></default-field></field>
                    <field name="locationId"><default-field title="Location"><display style="text-mono"/></default-field></field>
                    <field name="productId"><default-field title="Product"><display text="${productId} · ${productName}"/></default-field></field>
                    <field name="quantity" align="right"><default-field title="Qty"><display/></default-field></field>
                </form-list>
            </box-body-nopad></container-box>
        </widgets></section>
    </widgets>
</screen>
