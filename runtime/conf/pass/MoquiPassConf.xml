<!-- A PASS server (conf/pass/README.md): a public machine that serves mr-pass's sites (Forum, Account, Members, Sites)
    and keeps no business data. Every read and write is a call to the authority, a BOSS server or cluster that runs
    conf/pass/MoquiAuthorityConf.xml; this node stores only framework tables and sessions, which hold each visitor's
    delegation from the authority. The runtime has the base components and mr-pass only, no Mantle: mr-pass declares no
    depends-on, and a conf cannot remove a component that is in runtime/components/addon. Any server package will do;
    Lite, the smallest, is enough, since the authority does the images and sign-in. Embedded Postgres is enough.
    Change the example names (forum.example.com, boss.example.com, FORUM_SITE, forum) to yours. Mail, media, workers,
    imports and the transports in detail: mr-pass's docs/Deployment.md. -->
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <default-property name="instance_purpose" value="production"/>
    <!-- rate limits, connection limits and bans by client address. Behind a proxy set webapp_trusted_proxies and
        webapp_client_ip_header (.env) as well: each call to the authority carries the visitor's address, which its
        sign-in limits count by -->
    <default-property name="webapp_web_protection" value="true"/>

    <!-- The authority: its final https origin, so that no call depends on a redirect. Unset is local mode, with Mantle in
        this runtime. The deployment's client id is the one registered on the authority (pass_client_<id>_*); put its
        secret in .env, never here:
            pass_client_secret=...
        pass_backend_transport: rest, grpc, or empty for automatic: gRPC when the package has it (Maximal, Enterprise)
        and pass_backend_grpc_url names the authority's gRPC listener, such as grpcs://boss.example.com:443 (its HTTPS
        port takes gRPC over HTTP/2), else REST, which every package has. -->
    <default-property name="pass_backend_url" value="https://boss.example.com"/>
    <default-property name="pass_client_id" value="forum"/>
    <default-property name="pass_backend_transport" value=""/>
    <default-property name="pass_backend_grpc_url" value=""/>

    <entity-facade crypt-pass="${entity_ds_crypt_pass}" query-stats="true"/>

    <!-- The public site: its host and mounts must match the ones bound at the authority
        (mantle.public.SiteServices.create#Site and store#Mounts there). The certificate for the host goes in cert/. -->
    <webapp-list>
        <webapp name="webroot">
            <public-site host="forum.example.com" site-id="FORUM_SITE" screen-location="component://mr-pass/screen/Pass.xml"
                    resolver-service="pass.RouteServices.resolve#Route">
                <mount path="/forum" screen="Forum"/>
                <mount path="/account" screen="Account"/>
                <mount path="/members" screen="Members"/>
                <mount path="/sites" screen="Sites"/>
            </public-site>
        </webapp>
    </webapp-list>
</moqui-conf>
