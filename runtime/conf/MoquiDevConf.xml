<?xml version="1.0" encoding="UTF-8" ?>
<!-- No copyright or license for configuration file, details here are not considered a creative work. -->

<!-- NOTE: for default settings, examples, and comments see the MoquiDefaultConf.xml file at
    https://github.com/moqui/moqui-framework/blob/master/framework/src/main/resources/MoquiDefaultConf.xml -->
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-moqui-conf.xsd">

    <instance purpose="dev"/>
    <!-- A front-end dev server on another port of this machine (Vite, a second app) may call the server with the
        session cookie: localhost and 127.0.0.1 on any port and either scheme, and no other site (SEC-WEB-10). Name
        another origin here when a dev server runs elsewhere; `*` would let any site read the responses, and never
        comes with credentials. -->
    <webapp-list><webapp name="webroot" http-listen-port="off" grpc-listen-port="off" https-enabled="true" https-port="8443" allow-origins="localhost,127.0.0.1"/></webapp-list>
    <tools empty-db-load="all"/>
    <!-- the first administrator's form on an empty database (off by default, MoquiDefaultConf.xml) -->
    <user-facade><login initial-admin-enabled="true"/></user-facade>
    <transaction-facade use-lock-track="true"/>
    <!-- The built-in SSH server on localhost (its host defaults to 127.0.0.1): the apps in the terminal over SSH for
        every user, as `ssh -p 2222 john.doe@localhost` (the login dialog without a key); docs/ui/TUI.md "Over SSH" -->
    <ssh-server port="2222"/>


    <!-- An external database for testing, in runtime/.env (or the environment), on local mysql8:
            moqui_conf__entity_facade__datasource__TRANSACTIONAL__database_conf_name=mysql8
            moqui_conf__entity_facade__datasource__TRANSACTIONAL__user=root
            moqui_conf__entity_facade__datasource__TRANSACTIONAL__password=moquiroot
            moqui_conf__entity_facade__datasource__TRANSACTIONAL__sslmode=disable
        or on local postgres (docker run -d -e POSTGRES_USER=moqui -e POSTGRES_PASSWORD=moqui -e POSTGRES_DB=moqui
        -p 127.0.0.1:5432:5432 postgres:18):
            moqui_conf__entity_facade__datasource__TRANSACTIONAL__database_conf_name=postgres
            moqui_conf__entity_facade__datasource__TRANSACTIONAL__user=moqui
            moqui_conf__entity_facade__datasource__TRANSACTIONAL__password=moqui
            moqui_conf__entity_facade__datasource__TRANSACTIONAL__sslmode=disable
        With either, the content database (docs/Run-Deploy.md "Content database") apart, in the database moqui_content
        on the same server, which must exist (for the postgres above: createdb -h 127.0.0.1 -U moqui moqui_content), by
        the transactional one's database-conf-name; without it the content shares the external transactional database:
            moqui_conf__entity_facade__datasource__CONTENT__database_conf_name=postgres -->

    <cache-list warm-on-start="false">
        <!-- Development Mode - expires artifact cache entries; don't use these for production, load testing, etc -->
        <cache name="entity.definition" expire-time-idle="30"/>
        <!-- longer timeout since this basically looks through all files to check for new or moved entity defs -->
        <cache name="entity.location" expire-time-live="300"/>
        <cache name="entity.data.feed.info" expire-time-idle="30"/>

        <cache name="service.location" expire-time-idle="10"/>
        <cache name="service.rest.api" expire-time-idle="10"/>

        <cache name="screen.location" expire-time-idle="10"/>
        <cache name="screen.url" expire-time-idle="10"/>
        <cache name="screen.find.path" expire-time-idle="30"/>

        <cache name="resource.xml-actions.location" expire-time-idle="5"/>
        <cache name="resource.groovy.location" expire-time-idle="5"/>

        <cache name="resource.wiki.location" expire-time-idle="5"/>
        <cache name="resource.markdown.location" expire-time-idle="5"/>
        <cache name="resource.text.location" expire-time-idle="5"/>
        <cache name="resource.reference.location" expire-time-idle="5"/>

        <cache name="l10n.message" expire-time-idle="600"/>
    </cache-list>

    <!-- For development, record more: screen content as spans, and entity frame times as metrics. Screens, transitions
        and services have both by default. Set moqui_conf__telemetry__sample_ratio=1 to keep every span, not only those of error and
        slow traces. -->
    <telemetry>
        <artifact type="AT_XML_SCREEN_CONTENT" spans="true" metrics="true"/>
        <artifact type="AT_ENTITY" spans="false" metrics="true"/>
        <!-- OTLP over gRPC over HTTP/2 on the HTTPS listener -->
        <receiver grpc-enabled="true"/>
    </telemetry>

    <artifact-execution-facade>
        <!-- turn off tarpit in dev mode -->
        <artifact-execution type="AT_XML_SCREEN" tarpit-enabled="false"/>
        <artifact-execution type="AT_XML_SCREEN_TRANS" tarpit-enabled="false"/>
        <artifact-execution type="AT_SERVICE" tarpit-enabled="false"/>
    </artifact-execution-facade>

    <screen-facade boundary-comments="true">
        <!-- The default conf file has a macro location defined for html already, but this is an example of how to
            refer to a file to override the default macros: a copy of ScreenHtml.js at another location replaces
            the one built into the binary, so it is picked up on the next change of the screen. -->
        <screen-text-output type="html" mime-type="text/html" macro-template-location="framework/template/screen/ScreenHtml.js"/>
    </screen-facade>

    <!-- The default endpoint is a local model server on this machine (OpenAI-compatible, LM Studio's port); set its
        model's name (moqui_conf__llm_facade__model__DEFAULT__name). Or Claude on the Claude API (platform.claude.com),
        the claude-haiku model below, for the dev instance's features: its key and the default model in runtime/.env
        (never here), as
            moqui_conf__llm_facade__endpoint__ANTHROPIC__api_key=sk-ant-...
            moqui_conf__llm_facade__default_model=claude-haiku
        default-model is a model id of the llm-facade, the model of every feature bound to none. -->
    <llm-facade>
        <endpoint id="default" url="http://127.0.0.1:1234" local="true"/>
        <!-- Claude Haiku 5.5 on the Claude API, native Messages. Thinking is adaptive and on
            unless turned off; effort is the reasoning level (Haiku's own default is medium). context-window keeps a
            conversation under 200k tokens; prompts over 100k cost five times as much. Prices are per million tokens. -->
        <endpoint id="anthropic" protocol="anthropic-messages" url="https://api.anthropic.com" api-key=""/>
        <model id="claude-haiku" endpoint="anthropic" name="claude-haiku-5-5" tier="fast" context-window="200000"
                max-output="16000" price-input="0.10" price-output="0.50">
            <reasoning level="none">{"thinking":{"type":"disabled"},"output_config":{"effort":"low"}}</reasoning>
            <reasoning level="low">{"output_config":{"effort":"low"}}</reasoning>
            <reasoning level="medium">{"output_config":{"effort":"medium"}}</reasoning>
            <reasoning level="high">{"output_config":{"effort":"high"}}</reasoning>
        </model>
        <!-- Example settings for Qwen in LM Studio, with the content of calls kept for testing:
        <model id="default" endpoint="default" name="qwen3.8-27b-imatrix-nvfp4-mtp" tier="balanced" context-window="32768"
                max-output="6144" prompt-variant="small" result-cap-chars="4000" list-limit="10" reasoning-replay="none"
                max-concurrency="1" temperature="0.3" max-tool-calls="12">
            <api-config>{"chat_template_kwargs":{"preserve_thinking":true}}</api-config>
            <reasoning level="low">{"reasoning_effort":"low","chat_template_kwargs":{"enable_thinking":false}}</reasoning>
            <reasoning level="medium">{"reasoning_effort":"low","chat_template_kwargs":{"enable_thinking":true}}</reasoning>
            <reasoning level="high">{"reasoning_effort":"medium","chat_template_kwargs":{"enable_thinking":true}}</reasoning>
        </model>
        <limits max-run-seconds="1800" max-steps="100"/>
        <content-log enabled="true"/>
        -->
    </llm-facade>

    <entity-facade query-stats="true">
        <!-- add datasource elements here to configure databases; one with only attributes keeps the default conf's
            inline-jdbc -->
        <!-- pg_stat_statements for Tools › Database › Queries: the embedded cluster preloads it at its next start -->
        <datasource group-name="transactional" pg-stat-statements="true"/>
        <datasource group-name="content" pg-stat-statements="true"/>
    </entity-facade>
</moqui-conf>
