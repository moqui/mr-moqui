<!-- NOTE: for default settings, examples, and comments see the MoquiDefaultConf.xml file at
    https://github.com/moqui/moqui-framework/blob/master/framework/src/main/resources/MoquiDefaultConf.xml -->
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">

    <!-- for load test turn off tarpit -->
    <artifact-execution-facade>
        <artifact-execution type="AT_XML_SCREEN" tarpit-enabled="false"/>
        <artifact-execution type="AT_XML_SCREEN_TRANS" tarpit-enabled="false"/>
        <artifact-execution type="AT_SERVICE" tarpit-enabled="false"/>
    </artifact-execution-facade>
    <!-- for load test don't store login history -->
    <user-facade><login history-store="false"/></user-facade>

    <!-- for SSH load scripts (docs/tools/Load-Runner.md): the SSH server on localhost as in the dev conf, and room for
        many virtual users of one account at once; the defaults are 8 connections and 4 terminal sessions a user -->
    <default-property name="ssh_port" value="2222"/>
    <ssh-server max-sessions="1000" max-sessions-per-user="1000" max-sessions-per-source="1000"/>
    <terminal max-sessions="1000" max-sessions-per-user="1000"/>

    <entity-facade query-stats="true">
        <!-- add datasource elements here to configure databases -->
        <!-- the embedded cluster's buffers, above the code's 128MB for a load's growing data: a size for the machine,
            such as 512MB or 1GB on a large one. On the old default of 16MB the order to cash walk slowed run after run
            as its data grew: each backend evicted dirty pages all the time, and their writeback stalled every query for
            up to a second (plans/archive/LoadRunner.md section 11). The other sizes go here too: work-mem,
            maintenance-work-mem, effective-cache-size (docs/tools/Database.md) -->
        <datasource group-name="transactional" shared-buffers="256MB"/>
    </entity-facade>
</moqui-conf>
