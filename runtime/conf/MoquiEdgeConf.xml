<!-- An edge node (plans/Edge-Node.md): the production conf for a small cloud instance in front of a local node. Local
    nodes pair with it (System › Edge Clients) and dial its HTTPS listener (by ALPN). It gives them web access: the host
    names added there, passthrough or terminate, and an SSH tunnel port (edge_ssh_tunnel_port); delegated calls, the
    queue and replication (the edge element below); mr-pass's authority, the local node over the link
    (pass_backend_url below; set pass_backend_web_url in .env to the local node's web address for SSO); and mail, with
    Postfix and Rspamd beside it (the smtp-server below; docs/Run-Deploy.md, Edge node mail); and chat bridges' webhooks
    and MMS files (channels below). A client-ip-header here needs trusted-proxies, or it is ignored.
    Build, archive and run with the release flag of ./moq: the Maximal package, which has the edge link and embedded
    Postgres. The runtime has the base components and mr-pass only (./moq component-get edge). Per-host settings (names,
    addresses, ports) go in .env.
    The HTTPS listener needs a WebPKI certificate, in runtime/cert: local nodes check it when they pair. The links use
    the edge node's own link key, edge_link_key, generated into .env at the first start. A renewed web certificate does
    not touch the links; a changed edge_link_key means every local node must pair again. The command is in
    docs/Run-Deploy.md, Edge node. -->
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <default-property name="instance_purpose" value="production"/>
    <default-property name="node_role" value="edge"/>
    <default-property name="webapp_web_protection" value="true"/>
    <!-- mr-pass calls its local node as the PASS authority over gRPC down the link (plans/Edge-Node.md §5.5) -->
    <default-property name="pass_backend_url" value="edge:"/>

    <!-- Mail (plans/Edge-Node.md §5.4, E5a): Postfix on this host takes port 25 (SPF, DKIM, DMARC and Rspamd's verdict)
        and hands each message for the local node's domains to the LMTP listener below, on smtp_listen_port (set it in
        .env, as 10024; the listener is off while it is empty). The listener answers RCPT TO from the local node's
        replicated accounts, so an unknown address is refused while the local node is away too, and queues each message
        for the local node. Mail the local node sends through an EmailServer with smtpHost edge: is relayed to Postfix
        on edge_mail_relay_port, which signs it with DKIM (Rspamd) and delivers it, from bounce+(item)@ the domain
        edge_mail_bounce_domain names (set it in .env, and route that domain to the LMTP listener too), so a later
        bounce comes back to the message. -->
    <default-property name="smtp_allowed_addresses" value="127.0.0.1,::1"/>
    <default-property name="edge_mail_relay_host" value="127.0.0.1"/>
    <default-property name="edge_mail_relay_port" value="10025"/>
    <smtp-server protocol="lmtp"/>

    <!-- Chat bridges and SMS (plans/Edge-Node.md §5.4, E6): a network's webhook URL is this node's,
        /channels/{chatBridgeId}/webhook. The signature is checked with the local node's replicated bridge and the
        request queued for it; the files of the texts the local node sends (MMS) are served here at /channels/{id}/media/.
        On the local node, set channels_public_url to this node's address. -->
    <default-property name="channels_webhooks_enabled" value="true"/>

    <!-- Not built yet; each is turned on by the phase that uses it:
        E7, calls (rtc_public_address in .env, needed when binding every address):
                                     <default-property name="rtc_media_port" value="10000"/>
                                     <default-property name="rtc_media_host" value="0.0.0.0"/>
                                     <default-property name="turn_port" value="3478"/> -->

    <!-- The link's queue is the only data here that matters: unpause the backup_EmbeddedDatabase_daily job (System ›
        Service Jobs) and set its mirror (docs/Run-Deploy.md, backups). -->

    <entity-facade crypt-pass="${entity_ds_crypt_pass}" query-stats="true"/>

    <!-- How work crosses the link (plans/Edge-Node.md §5.2): what waits for a local node that is away is kept 14
        days (both nodes should keep the same period), and at most 1 GB of it; then the oldest fails, logged. A payload
        is at most 1 MiB, and a larger body goes as its content. What the edge node delegates, the queue kinds and the
        sets a local node replicates are in MoquiDefaultConf.xml, read by both ends (mail's since E5a, chat's since
        E6); a later phase adds its own there, with grants for _EDGE_, as:
            <delegate service="org.moqui.impl.VoiceServices.receive#PhoneCall" allow-anonymous="true"/>   (E8)
        To check a delegated call end to end, list org.moqui.impl.EdgeServices.echo#Delegate on both nodes. -->
    <edge queue-retention-days="14" queue-max-megabytes="1024" queue-max-attempts="10" queue-retry-seconds="5"/>
</moqui-conf>
