<!-- One of several local nodes on one edge node (conf/multi-domain/README.md; plans/Edge-Node2.md §4.1): a production
    server with its own database and its own domains, which pairs with the shared edge node as conf/edge/MoquiLocalConf.xml
    does, with a pairing code of its own. Pairing writes edge_node_url, edge_node_key, edge_node_pin and edge_node_id to
    runtime/.env, and the System › Edge Node wizard writes the rest of this node's part. What differs from a local node
    alone on its edge node is that each name must be its own: the edge node refuses a host name, XMPP domain, SIP realm,
    number or PASS site another local node claimed first ("another node has this name"), and the wizard's Apply and
    Test say which. Per-host settings go in .env. -->
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <default-property name="instance_purpose" value="production"/>

    <!-- Web access (.env): webapp_http_host, this node's own public name, such as erp.branch-a.example.com; the wizard
        offers it as this node's first host name. A passthrough name ends its TLS here, with a certificate for it in
        runtime/cert; a terminate name is ended on the edge node. -->

    <!-- Names of its own (.env), one per local node:
        xmpp_domain, this node's XMPP domain (branch-a.example.com), which the edge node's XMPP ports route by;
        sip_domain, its phones' realm (sip.branch-a.example.com), which its Configure names;
        the PASS sites in pass_client_edge_sites, which the wizard sends: an mr-pass site has one authority;
        mail: its domains' addresses, which reach it by its replicated accounts (a domain two nodes share is split by
        address, and an address both have is held back until one lets it go).
        Chat and SMS: the wizard sets channels_public_url to the edge node's address. Bridge ids from two databases can
        be the same; when they may, set channels_public_url to one of this node's terminate host names, so its
        networks' webhooks name this node. -->

    <!-- Backups: this node holds the business data. This sets the paused seed job backup_EmbeddedDatabase_daily
        running at each boot (docs/Run-Deploy.md, Backups). -->
    <default-property name="embedded_db_backup_scheduled" value="true"/>

    <entity-facade crypt-pass="${entity_ds_crypt_pass}" query-stats="true"/>
</moqui-conf>
