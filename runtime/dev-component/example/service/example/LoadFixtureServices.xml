<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <!-- A fixture of runtime/base-component/tools/test/LoadRunner.spec.js (a dev component, not on a production server):
        a service that does what a service must not, leave its caller's context with authorization off, so the spec
        can show that a load run's next call does not inherit it. It changes nothing but the caller's own context. -->
    <service verb="leave" noun="AuthzDisabled">
        <actions><script>ec.artifactExecution.disableAuthz()</script></actions>
    </service>
    <!-- As leave#AuthzDisabled, and the caller's own account disabled too, so a fresh login for it fails: the spec puts
        the account back. -->
    <service verb="leave" noun="AuthzDisabledAccountDisabled">
        <actions><script><![CDATA[
            ec.artifactExecution.disableAuthz()
            const account = ec.entity.find('moqui.security.UserAccount').condition('userId', ec.user.userId).one()
            account.disabled = 'Y'
            account.update()
        ]]></script></actions>
    </service>
</services>
