<!-- Step 2 of the gallery wizard: the country and what the customer receives, kept in the draft by saveOptions. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Options" default-menu-index="2">

    <transition name="saveOptions"><actions><script><![CDATA[
        if (!countryGeoId) ec.message.addValidationError(null, 'countryGeoId', null, 'Choose a country', null)
        if (ec.message.hasError()) return
        const draft = JSON.parse(ec.web.sessionAttributes.get('galleryWizard') || '{}')
        Object.assign(draft, {countryGeoId: countryGeoId, currencyUomId: currencyUomId || '', newsletter: newsletter === 'Y' ? 'Y' : 'N'})
        ec.web.sessionAttributes.put('galleryWizard', JSON.stringify(draft))
    ]]></script></actions><default-response url="."/></transition>

    <actions>
        <set field="wizard" from="Object.assign({countryGeoId: 'USA', currencyUomId: 'USD', newsletter: 'Y'},
            JSON.parse(ec.web.sessionAttributes.get('galleryWizard') || '{}'))"/>
    </actions>
    <widgets>
        <container-box><box-header title="Options"/><box-body>
            <label text="The country the customer trades from and what they want to receive." type="p" style="m-muted"/>
            <form-single name="WizardOptions" transition="saveOptions" map="wizard" focus-field="countryGeoId">
                <field name="countryGeoId"><default-field title="Country">
                    <drop-down><entity-options key="${geoId}" text="${geoName}">
                        <entity-find entity-name="moqui.basic.Geo">
                            <econdition field-name="geoTypeEnumId" value="GEOT_COUNTRY"/>
                            <order-by field-name="geoName"/></entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="currencyUomId"><default-field title="Currency">
                    <drop-down allow-empty="true"><entity-options key="${uomId}" text="${description} (${abbreviation})">
                        <entity-find entity-name="moqui.basic.Uom">
                            <econdition field-name="uomTypeEnumId" value="UT_CURRENCY_MEASURE"/>
                            <order-by field-name="description"/></entity-find>
                    </entity-options></drop-down></default-field></field>
                <field name="newsletter"><default-field title="Preferences">
                    <check><option key="Y" text="Send the monthly newsletter"/></check></default-field></field>
                <field-layout>
                    <field-row><field-ref name="countryGeoId"/><field-ref name="currencyUomId"/></field-row>
                    <field-ref name="newsletter"/>
                </field-layout>
            </form-single>
        </box-body></container-box>
    </widgets>
</screen>
