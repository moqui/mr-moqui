<!-- Gallery screen for the 3.10 Wizard archetype of the style guide: subscreens-panel type="wizard" (style-guide §8.2) over
    three step screens in Wizard/ (Customer, Options, Review), so the URL holds the step. Each step's form-single posts to its
    own transition, which checks the entries and keeps them as a draft in the session (a real wizard saves a draft record);
    the wizard's Next submits it and goes on when the answer has no errors. Back never loses what a step saved. Nothing is
    written. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Wizard" default-menu-index="10" menu-image="sym_o_auto_awesome" menu-image-type="icon">

    <subscreens default-item="Customer"/>

    <widgets>
        <container-box type="info"><box-header title="Archetype 3.10 Wizard"/><box-body>
            <label text="Multi-step creation: subscreens-panel type=&quot;wizard&quot; is a stepper with one step per subscreen (the menu titles, in menu order), so the URL holds the step. Next submits the step's form to its transition and moves on when the answer has no errors; Back goes to the step before, whose entries the draft kept; the last step is a review with a single primary." type="p"/>
            <label text="The steps keep a draft in the session; a real wizard saves a draft record. Try Next with an empty customer name: the field shows the error and the wizard stays." type="p"/>
        </box-body></container-box>
        <subscreens-panel id="CustomerWizard" type="wizard" finish-text="Create customer"/>
    </widgets>
</screen>
