<!-- A text-area with editor-type="code" in a form: an example's description edited as JSON in the code editor
    (m-code-editor, js/WebrootCode.js) and saved through update#moqui.example.Example. A plain text area in the terminal,
    and when the editor's library cannot load. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Code Field" default-menu-include="false">

    <parameter name="exampleId" required="true"/>

    <transition name="updateExample"><service-call name="update#moqui.example.Example"/>
        <default-response url="."/></transition>

    <actions>
        <entity-find-one entity-name="moqui.example.Example" value-field="example"/>
    </actions>
    <widgets>
        <section name="CodeFieldSection" condition="example"><widgets>
            <form-single name="CodeFieldForm" map="example" transition="updateExample">
                <field name="exampleId"><default-field><hidden/></default-field></field>
                <field name="description"><default-field title="Description (JSON)">
                    <text-area editor-type="code" language="json" rows="8"/></default-field></field>
                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
            </form-single>
        </widgets><fail-widgets>
            <label type="p" text="No example ${exampleId}" style="m-muted"/>
        </fail-widgets></section>
    </widgets>
</screen>
