<!-- The Board archetype (style-guide 3.6) as a Vue component file served by Board.xml in the qvue render mode.
    Quasar and the m-* components are used directly within the rules of style-guide 4.8: brand color names only,
    layout classes, q-card and q-btn in their roles, and the shell's root for navigation (this.$root.setUrl). -->
<template><div>
    <m-container-box type="info" title="Archetype 3.6 Board">
        <p class="q-mb-xs">A list shown as columns by stage with cards: each column header has the stage, its count and its sum; a card shows the title, amount, owner initials and the next activity; a card opens the Detail archetype. Drag a card to another column: the stage change posts to the moveCard transition and its message shows as a notification. The search filters the cards on the client. Columns scroll horizontally at narrow widths.</p>
        <p class="q-mb-none">The .qvue path of style-guide 4.8, for a board an XML form-list cannot be (a component file served as the screen, data from the boardRows transition); the list / board / calendar toggle is a q-btn-toggle that links to the List and Calendar screens. A form-list with <code>views</code> and <code>view-board</code> (section 8.2) is the Views screen.</p>
    </m-container-box>

    <div class="row items-center q-col-gutter-sm q-mb-sm q-px-sm">
        <div class="col-auto">
            <q-btn-toggle v-model="view" dense no-caps unelevated toggle-color="primary" :options="viewOptions" @update:model-value="switchView"></q-btn-toggle>
        </div>
        <div class="col-12 col-sm-4 col-md-3">
            <m-text-line v-model="search" name="search" id="BoardSearch" label="Search cards"></m-text-line>
        </div>
        <div class="col-auto">
            <q-btn dense unelevated no-caps class="m-btn-tonal" icon="add" label="New opportunity" @click="newCard"></q-btn>
        </div>
        <q-space></q-space>
        <div class="col-auto text-caption" :class="mutedClass">{{filteredRows.length}} of {{rows.length}} cards</div>
    </div>

    <div class="row no-wrap scroll q-px-sm q-pb-sm">
        <q-card v-for="stage in stages" :key="stage.id" flat bordered class="col q-mr-sm column no-wrap" style="min-width:230px;max-width:320px;"
                :class="dropStage === stage.id ? ($q.dark.isActive ? 'bg-grey-9' : 'bg-grey-2') : ''"
                @dragover.prevent="dropStage = stage.id" @dragleave="leaveStage(stage.id)" @drop.prevent="onDrop(stage.id)">
            <q-card-section class="q-py-xs q-px-sm row items-center no-wrap">
                <div class="text-subtitle2 text-weight-medium ellipsis">{{stage.name}}</div>
                <q-badge class="q-ml-xs" :color="stage.color" :text-color="stage.color === 'warning' ? 'dark' : 'white'">{{cardsIn(stage.id).length}}</q-badge>
                <q-space></q-space>
                <div class="text-caption" :class="mutedClass">{{formatAmount(sumIn(stage.id))}}</div>
            </q-card-section>
            <q-separator></q-separator>
            <q-card-section class="q-pa-xs col">
                <q-card v-for="row in cardsIn(stage.id)" :key="row.id" flat bordered class="q-mb-xs cursor-pointer" :class="dragId === row.id ? 'shadow-4' : ''"
                        draggable="true" @dragstart="onDragStart(row, $event)" @dragend="dragId = null" @click="openCard(row)">
                    <q-card-section class="q-pa-sm">
                        <div class="row items-start no-wrap">
                            <div class="col text-body2 text-weight-medium">{{row.title}}</div>
                            <q-avatar size="22px" color="primary" text-color="white" class="text-caption q-ml-xs">{{row.owner}}<q-tooltip>Owner {{row.owner}}</q-tooltip></q-avatar>
                        </div>
                        <div class="text-body2 q-mt-xs">{{formatAmount(row.amount)}}</div>
                        <div class="text-caption row items-center no-wrap" :class="mutedClass">
                            <q-icon name="schedule" size="xs" class="q-mr-xs"></q-icon><span class="ellipsis">{{row.next}}</span>
                        </div>
                    </q-card-section>
                </q-card>
                <div v-if="!cardsIn(stage.id).length" class="text-caption text-center q-pa-sm" :class="mutedClass">{{loading ? 'Loading' : 'No cards'}}</div>
            </q-card-section>
        </q-card>
    </div>
</div></template>

<script>
module.exports = {
    data() {
        return {
            view: 'board', search: '', stages: [], rows: [], dragId: null, dropStage: null, loading: false,
            viewOptions: [{ label: 'List', value: 'list', icon: 'view_list' }, { label: 'Board', value: 'board', icon: 'view_kanban' },
                { label: 'Calendar', value: 'calendar', icon: 'calendar_month' }]
        };
    },
    computed: {
        // the screen's own path under the apps base, where its transitions are
        screenPath() { return this.$root.basePath + '/' + this.$root.currentPathList.join('/'); },
        mutedClass() { return this.$q.dark.isActive ? 'text-grey-5' : 'text-grey-7'; },
        filteredRows() {
            const term = this.search.trim().toLowerCase();
            if (!term) return this.rows;
            return this.rows.filter((row) => (row.id + ' ' + row.title + ' ' + row.owner + ' ' + row.next).toLowerCase().indexOf(term) >= 0);
        }
    },
    methods: {
        siblingUrl(name, search) {
            const path = this.$root.currentPathList.slice(0, -1).concat([name]).join('/');
            return this.$root.linkBasePath + '/' + path + (search ? '?' + search : '');
        },
        cardsIn(stageId) { return this.filteredRows.filter((row) => row.stage === stageId); },
        sumIn(stageId) { return this.cardsIn(stageId).reduce((sum, row) => sum + Number(row.amount || 0), 0); },
        formatAmount(value) { return moqui.l10n ? moqui.l10n.formatCurrency(value, 'USD', 0) : String(value); },
        load() {
            this.loading = true;
            moqui.request(this.screenPath + '/boardRows').then((result) => {
                this.loading = false;
                const json = result.json || {};
                this.stages = json.stages || [];
                this.rows = json.rows || [];
            }, (err) => { this.loading = false; moqui.handleAjaxError(err); });
        },
        switchView(value) {
            if (value === 'board') return;
            this.$root.setUrl(this.siblingUrl(value === 'list' ? 'List' : 'Calendar'));
        },
        newCard() { this.$root.setUrl(this.siblingUrl('Dialog')); },
        openCard(row) { this.$root.setUrl(this.siblingUrl('Detail', 'opportunityId=' + encodeURIComponent(row.id))); },
        onDragStart(row, event) {
            this.dragId = row.id;
            if (event.dataTransfer) { event.dataTransfer.effectAllowed = 'move'; event.dataTransfer.setData('text/plain', row.id); }
        },
        leaveStage(stageId) { if (this.dropStage === stageId) this.dropStage = null; },
        onDrop(stageId) {
            const id = this.dragId;
            this.dropStage = null;
            this.dragId = null;
            const row = this.rows.find((item) => item.id === id);
            if (!row || row.stage === stageId) return;
            const from = row.stage;
            row.stage = stageId;
            moqui.request(this.screenPath + '/moveCard', { method: 'POST', params: { id, stage: stageId } }).then((result) => {
                if (result.json) moqui.notifyMessages(result.json.messageInfos, result.json.errors);
                else if (result.text) moqui.notifyMessages(result.text);
            }, (err) => { row.stage = from; moqui.handleAjaxError(err); });
        }
    },
    mounted() { this.load(); }
};
</script>
