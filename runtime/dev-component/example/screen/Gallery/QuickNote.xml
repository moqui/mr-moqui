<!-- The gallery's quick-create kind (shell-providers in Gallery.xml): a dialog screen the shell's + menu opens with the screen
    context as parameters, as BOSS's Commons/QuickCreate does. Saving is a no-op. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Gallery note" default-menu-include="false">

    <parameter name="recordEntity"/>
    <parameter name="recordId"/>

    <!-- The answer stays in the dialog: JSON with the message (messageInfos, as a url response carries them) and no screenUrl,
        so the shell's quick-create dialog closes on it and the page under it stays. -->
    <transition name="saveNote">
        <actions><script><![CDATA[
            const text = 'Gallery: the note would be saved' + (recordId ? ' on ' + recordEntity + ' ' + recordId : '') + '; nothing is written.'
            ec.web.sendJsonResponse({messageInfos: [{message: text, type: 'success'}]})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <widgets>
        <label type="p" text="A note from the shell's quick create. With a record in the screen context it is linked to it." style="m-muted"/>
        <label type="p" text="On ${recordEntity} ${recordId}" condition="recordId"/>
        <form-single name="GalleryNote" transition="saveNote" focus-field="noteText">
            <field name="recordEntity"><default-field><hidden/></default-field></field>
            <field name="recordId"><default-field><hidden/></default-field></field>
            <field name="noteText"><default-field title="Note"><text-area rows="3" cols="50"/></default-field></field>
            <field name="saveButton"><default-field title="Save"><submit/></default-field></field>
        </form-single>
    </widgets>
</screen>
