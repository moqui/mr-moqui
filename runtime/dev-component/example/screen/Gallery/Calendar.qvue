<!-- The Calendar archetype (style-guide 3.7) as a Vue component file served by Calendar.xml in the qvue render mode:
    a month grid built in the template from the month URL parameter, events from the events transition, a click on
    a day opens the shell's m-dialog with an m-form that posts to createEvent. On a phone the grid keeps its seven
    columns with one-letter day names and event dots in place of titles. -->
<template><div>
    <m-container-box type="info" title="Archetype 3.7 Calendar">
        <p class="q-mb-xs">Events on a month grid: seven columns and five or six rows built in the template from the <code>month</code> URL parameter (Previous, Today and Next change the URL through the root's setUrl, so a month is bookmarkable); the kind of an event picks a semantic color; a click on a day opens the quick-create dialog with the time prefilled. On a phone the grid keeps seven columns with one-letter day names and event dots.</p>
        <p class="q-mb-none">The .qvue path of style-guide 4.8, for a calendar an XML form-list cannot be (a component file served as the screen, data from the events transition); only the month view is built here, the day and week buttons show a banner. A form-list with <code>view-calendar</code> (section 8.2: month, week, day and list, drag to move and resize, quick create) is the Views screen.</p>
    </m-container-box>

    <div class="row items-center q-col-gutter-sm q-mb-sm q-px-sm">
        <div class="col-auto row items-center no-wrap">
            <q-btn flat dense round icon="chevron_left" @click="go(-1)"><q-tooltip>Previous month</q-tooltip></q-btn>
            <q-btn flat dense no-caps label="Today" @click="goToday"></q-btn>
            <q-btn flat dense round icon="chevron_right" @click="go(1)"><q-tooltip>Next month</q-tooltip></q-btn>
        </div>
        <div class="col-auto text-h6">{{monthTitle}}</div>
        <div class="col-auto text-caption" :class="mutedClass">{{events.length}} events</div>
        <q-space></q-space>
        <div class="col-auto">
            <q-btn-toggle v-model="mode" dense no-caps unelevated toggle-color="primary" :options="modeOptions"></q-btn-toggle>
        </div>
    </div>

    <q-banner v-if="mode !== 'month'" dense rounded class="q-mx-sm q-mb-sm" :class="$q.dark.isActive ? 'bg-grey-9' : 'bg-grey-2'">
        <template v-slot:avatar><q-icon name="info" color="info"></q-icon></template>
        The {{mode}} view is not in this gallery; the month view is the one built.
        <template v-slot:action><q-btn flat dense no-caps label="Back to month" @click="mode = 'month'"></q-btn></template>
    </q-banner>

    <q-card v-else flat bordered class="q-mx-sm">
        <div class="row no-wrap">
            <div v-for="name in dayNames" :key="name" class="col text-center text-caption text-weight-medium q-py-xs" :class="mutedClass">{{$q.screen.lt.sm ? name.slice(0, 1) : name}}</div>
        </div>
        <template v-for="(week, weekIndex) in weeks" :key="weekIndex">
            <q-separator></q-separator>
            <div class="row no-wrap">
                <template v-for="(day, dayIndex) in week" :key="day.date">
                    <q-separator v-if="dayIndex > 0" vertical></q-separator>
                    <div class="col q-pa-xs cursor-pointer" :class="day.inMonth ? '' : ($q.dark.isActive ? 'bg-grey-10' : 'bg-grey-1')"
                            :style="{minHeight: $q.screen.lt.sm ? '48px' : '92px'}" @click="openCreate(day)">
                        <div class="row items-center no-wrap">
                            <q-avatar v-if="day.isToday" size="20px" color="primary" text-color="white" class="text-caption">{{day.dayNum}}</q-avatar>
                            <span v-else class="text-caption" :class="day.inMonth ? '' : 'text-grey-5'">{{day.dayNum}}</span>
                        </div>
                        <div v-if="$q.screen.lt.sm" class="row q-gutter-xs q-mt-xs">
                            <q-badge v-for="ev in day.events" :key="ev.id" rounded :class="colorClass(ev.kind)" class="q-pa-none" style="width:8px;height:8px;"></q-badge>
                        </div>
                        <template v-else>
                            <div v-for="ev in day.events" :key="ev.id" class="text-caption ellipsis q-px-xs q-mt-xs rounded-borders" :class="colorClass(ev.kind)">
                                {{ev.start.slice(11)}} {{ev.title}}<q-tooltip>{{ev.title}}: {{ev.start}} to {{ev.end}}</q-tooltip>
                            </div>
                        </template>
                    </div>
                </template>
            </div>
        </template>
        <q-separator></q-separator>
        <q-card-section class="q-py-xs row items-center q-gutter-sm">
            <span class="text-caption" :class="mutedClass">Kinds:</span>
            <q-badge v-for="kind in kinds" :key="kind.id" :class="colorClass(kind.id)">{{kind.label}}</q-badge>
        </q-card-section>
    </q-card>

    <m-dialog v-model="createShown" title="New event" width="440">
        <div>
            <m-form :action="screenPath + '/createEvent'" :fields-initial="newEvent" submit-hide-id="CalendarCreateDialog" v-slot="formProps">
                <m-text-line v-model="formProps.fields.title" name="title" id="CalendarTitle" label="Title"></m-text-line>
                <div class="row q-col-gutter-sm q-mt-xs">
                    <div class="col"><m-date-time v-model="formProps.fields.start" name="start" id="CalendarStart" label="Start" type="date-time"></m-date-time></div>
                    <div class="col"><m-date-time v-model="formProps.fields.end" name="end" id="CalendarEnd" label="End" type="date-time"></m-date-time></div>
                </div>
                <div class="row justify-end q-mt-sm q-gutter-sm">
                    <q-btn flat dense no-caps label="Cancel" @click="createShown = false"></q-btn>
                    <q-btn dense unelevated no-caps color="primary" type="submit" label="Create"></q-btn>
                </div>
            </m-form>
        </div>
    </m-dialog>
</div></template>

<script>
module.exports = {
    data() {
        return {
            month: '', mode: 'month', events: [], createShown: false, newEvent: { title: '', start: '', end: '' },
            dayNames: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
            modeOptions: [{ label: 'Day', value: 'day' }, { label: 'Week', value: 'week' }, { label: 'Month', value: 'month' }],
            kinds: [{ id: 'meeting', label: 'Meeting' }, { id: 'call', label: 'Call' }, { id: 'deadline', label: 'Deadline' }, { id: 'done', label: 'Done' }]
        };
    },
    computed: {
        screenPath() { return this.$root.basePath + '/' + this.$root.currentPathList.join('/'); },
        mutedClass() { return this.$q.dark.isActive ? 'text-grey-5' : 'text-grey-7'; },
        monthTitle() {
            if (!this.month) return '';
            const first = new Date(Number(this.month.slice(0, 4)), Number(this.month.slice(5, 7)) - 1, 1);
            return first.toLocaleDateString(undefined, { month: 'long', year: 'numeric' });
        },
        // six weeks at most, from the Sunday on or before the first of the month
        weeks() {
            if (!this.month) return [];
            const year = Number(this.month.slice(0, 4));
            const monthIndex = Number(this.month.slice(5, 7)) - 1;
            const first = new Date(year, monthIndex, 1);
            const start = new Date(year, monthIndex, 1 - first.getDay());
            const todayText = this.dateText(new Date());
            const byDay = {};
            this.events.forEach((ev) => { const day = ev.start.slice(0, 10); (byDay[day] = byDay[day] || []).push(ev); });
            const weeks = [];
            const cursor = new Date(start.getTime());
            while (weeks.length < 6) {
                const week = [];
                for (let i = 0; i < 7; i++) {
                    const date = this.dateText(cursor);
                    week.push({ date, dayNum: cursor.getDate(), inMonth: cursor.getMonth() === monthIndex, isToday: date === todayText, events: byDay[date] || [] });
                    cursor.setDate(cursor.getDate() + 1);
                }
                weeks.push(week);
                if (cursor.getMonth() !== monthIndex) break;
            }
            return weeks;
        }
    },
    methods: {
        pad(n) { return String(n).padStart(2, '0'); },
        dateText(d) { return d.getFullYear() + '-' + this.pad(d.getMonth() + 1) + '-' + this.pad(d.getDate()); },
        colorClass(kind) {
            return { meeting: 'bg-primary text-white', call: 'bg-info text-white', deadline: 'bg-warning text-dark', done: 'bg-positive text-white' }[kind] || 'bg-grey-6 text-white';
        },
        load() {
            moqui.request(this.screenPath + '/events', { params: { month: this.month } }).then((result) => {
                const json = result.json || {};
                if (json.month) this.month = json.month;
                this.events = json.events || [];
            }, moqui.handleAjaxError);
        },
        // the month lives in the URL: Previous, Today and Next change it through the root, which reloads this screen
        go(delta) {
            const year = Number(this.month.slice(0, 4));
            const monthIndex = Number(this.month.slice(5, 7)) - 1 + delta;
            const target = new Date(year, monthIndex, 1);
            this.$root.setUrl(this.$root.currentLinkPath + '?month=' + target.getFullYear() + '-' + this.pad(target.getMonth() + 1));
        },
        goToday() { this.$root.setUrl(this.$root.currentLinkPath); },
        openCreate(day) {
            this.newEvent = { title: '', start: day.date + ' 09:00', end: day.date + ' 10:00' };
            this.createShown = true;
        },
        hide() { this.createShown = false; },
        readMonth() {
            const param = this.$root.currentParameters && this.$root.currentParameters.month;
            const now = new Date();
            this.month = param && /^\d{4}-\d{2}$/.test(String(param)) ? String(param) : now.getFullYear() + '-' + this.pad(now.getMonth() + 1);
        }
    },
    watch: {
        // a query-only change of the URL (Previous, Today, Next) does not remount the screen: the month is re-read here
        '$root.currentParameters': { handler() { this.readMonth(); this.load(); }, deep: true }
    },
    mounted() {
        // the m-form posts and notifies, then hides the container named by submit-hide-id: this dialog registers as one
        this.$root.addContainer('CalendarCreateDialog', this);
        this.readMonth();
        this.load();
    }
};
</script>
