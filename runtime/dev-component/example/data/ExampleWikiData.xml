<!-- The wiki behind the gallery's Editor archetype (screen/Gallery/Editor.xml): a space whose pages are dbresource
    files, Welcome with two versions, and a git repository in the database for the second space the screen creates on
    request (git://example-wiki/). See docs/data/Revision-Management.md. -->
<entity-facade-xml type="demo">
    <moqui.resource.DbResource resourceId="EX_WIKI" filename="ExampleWiki" isFile="N" parentResourceId=""/>
    <moqui.resource.DbResource resourceId="EX_WIKI_ROOT" filename="EXAMPLE.md" isFile="Y" parentResourceId="EX_WIKI">
        <file mimeType="text/plain" versionName="01" rootVersionName="01">
            <fileData><![CDATA[# Example Wiki

The pages of the gallery's Editor archetype. Each save of a page is a new version; the History dialog lists them,
compares any two, and restores or publishes one.
]]></fileData>
            <histories versionName="01" versionDate="1760000000000" isDiff="N"/>
        </file>
    </moqui.resource.DbResource>
    <moqui.resource.DbResource resourceId="EX_WIKI_DIR" filename="EXAMPLE" isFile="N" parentResourceId="EX_WIKI"/>
    <moqui.resource.DbResource resourceId="EX_WIKI_WELCOME" filename="Welcome.md" isFile="Y" parentResourceId="EX_WIKI_DIR">
        <file mimeType="text/plain" versionName="02" rootVersionName="01">
            <fileData><![CDATA[# Welcome

This page has two versions. Open **History** to see them, then *diff prev* on the newest to compare.

## Revisions

- Each save keeps the text it replaced.
- Older text is stored as a reverse delta.
- Any version can be viewed, compared, restored or published.
]]></fileData>
            <histories versionName="01" versionDate="1760000000000" isDiff="N"><fileData><![CDATA[# Welcome

This page has one version.

## Revisions

- Each save keeps the text it replaced.
]]></fileData></histories>
            <histories versionName="02" previousVersionName="01" versionDate="1760003600000" isDiff="N"/>
        </file>
    </moqui.resource.DbResource>
    <moqui.resource.DbResource resourceId="EX_WIKI_NOTES" filename="Notes.md" isFile="Y" parentResourceId="EX_WIKI_DIR">
        <file mimeType="text/plain" versionName="01" rootVersionName="01">
            <fileData><![CDATA[# Notes

A page with a single version. Edit it to make the second.
]]></fileData>
            <histories versionName="01" versionDate="1760000000000" isDiff="N"/>
        </file>
    </moqui.resource.DbResource>

    <moqui.resource.wiki.WikiSpace wikiSpaceId="EXAMPLE" description="Example wiki (dbresource)" restrictView="N" restrictUpdate="N"
            rootPageLocation="dbresource://ExampleWiki/EXAMPLE.md"/>
    <moqui.resource.wiki.WikiPage wikiPageId="EX_WIKI_ROOT" wikiSpaceId="EXAMPLE" pagePath="" sequenceNum="1" publishedVersionName="01"/>
    <moqui.resource.wiki.WikiPage wikiPageId="EX_WIKI_WELCOME" wikiSpaceId="EXAMPLE" pagePath="Welcome" sequenceNum="10" publishedVersionName="01">
        <histories historySeqId="01" versionName="01" changeDateTime="1760000000000"/>
        <histories historySeqId="02" versionName="02" changeDateTime="1760003600000"/>
    </moqui.resource.wiki.WikiPage>
    <moqui.resource.wiki.WikiPage wikiPageId="EX_WIKI_NOTES" wikiSpaceId="EXAMPLE" pagePath="Notes" sequenceNum="20"/>

    <moqui.resource.GitRepository repositoryId="example-wiki" repositoryKind="db" branch="main"
            description="The git-backed example wiki space (EXGIT), kept in the database"/>
</entity-facade-xml>
