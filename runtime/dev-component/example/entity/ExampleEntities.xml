<!-- The example record of the Java Moqui example component (moqui.example.Example: a type, a status in a flow, a name and a
    size), with a start and end, so the gallery's List views screen (screen/Gallery/Views.xml) has records to show on a board by
    status and on a calendar, and to move through their transitions. The status flow is Java's; the colors are the status
    color map's meanings (style-guide §5.2). -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="Example" package="moqui.example" short-alias="examples">
        <field name="exampleId" type="id" is-pk="true"><description>primary sequenced ID</description></field>
        <field name="exampleTypeEnumId" type="id"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="exampleName" type="text-medium"/>
        <field name="description" type="text-medium"/>
        <field name="exampleSize" type="number-integer"/>
        <field name="exampleDate" type="date-time"><description>When the example starts, on the calendar</description></field>
        <field name="exampleEndDate" type="date-time"><description>When the example ends (not Java's)</description></field>
        <field name="allDay" type="text-indicator"><description>Y for an example that takes whole days (not Java's)</description></field>
        <relationship type="one" title="ExampleType" related="moqui.basic.Enumeration" short-alias="type">
            <key-map field-name="exampleTypeEnumId"/></relationship>
        <relationship type="one" related="moqui.basic.StatusItem" short-alias="status"/>

        <seed-data>
            <moqui.basic.EnumerationType description="Example Type" enumTypeId="ExampleType"/>
            <moqui.basic.Enumeration description="Real World" enumId="EXT_REAL_WORLD" enumTypeId="ExampleType" sequenceNum="1"/>
            <moqui.basic.Enumeration description="Made Up" enumId="EXT_MADE_UP" enumTypeId="ExampleType" sequenceNum="2"/>
            <moqui.basic.Enumeration description="Contrived" enumId="EXT_CONTRIVED" parentEnumId="EXT_MADE_UP" enumTypeId="ExampleType" sequenceNum="3"/>
            <moqui.basic.Enumeration description="Inspired" enumId="EXT_INSPIRED" parentEnumId="EXT_MADE_UP" enumTypeId="ExampleType" sequenceNum="4"/>

            <moqui.basic.StatusType description="Example" statusTypeId="Example"/>
            <moqui.basic.StatusItem description="In Design" sequenceNum="1" statusId="EXST_IN_DESIGN" statusTypeId="Example" statusColor="grey-7"/>
            <moqui.basic.StatusItem description="Defined" sequenceNum="2" statusId="EXST_DEFINED" statusTypeId="Example" statusColor="info"/>
            <moqui.basic.StatusItem description="Approved" sequenceNum="3" statusId="EXST_APPROVED" statusTypeId="Example" statusColor="primary"/>
            <moqui.basic.StatusItem description="Implemented" sequenceNum="4" statusId="EXST_IMPLEMENTED" statusTypeId="Example" statusColor="primary"/>
            <moqui.basic.StatusItem description="Tested" sequenceNum="5" statusId="EXST_TESTED" statusTypeId="Example" statusColor="info"/>
            <moqui.basic.StatusItem description="Complete" sequenceNum="6" statusId="EXST_COMPLETE" statusTypeId="Example" statusColor="positive"/>
            <moqui.basic.StatusItem description="Cancelled" sequenceNum="99" statusId="EXST_CANCELLED" statusTypeId="Example" statusColor="negative"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EXST_IN_DESIGN" toStatusId="EXST_DEFINED" transitionName="Definition Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EXST_DEFINED" toStatusId="EXST_APPROVED" transitionName="Approve"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EXST_APPROVED" toStatusId="EXST_IMPLEMENTED" transitionName="Implementation Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EXST_IMPLEMENTED" toStatusId="EXST_TESTED" transitionName="Testing Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EXST_TESTED" toStatusId="EXST_COMPLETE" transitionName="Example Completed"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EXST_IN_DESIGN" toStatusId="EXST_CANCELLED" transitionName="Cancel Example"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EXST_DEFINED" toStatusId="EXST_CANCELLED" transitionName="Cancel Example"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EXST_APPROVED" toStatusId="EXST_CANCELLED" transitionName="Cancel Example"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EXST_IMPLEMENTED" toStatusId="EXST_CANCELLED" transitionName="Cancel Example"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EXST_TESTED" toStatusId="EXST_CANCELLED" transitionName="Cancel Example"/>
        </seed-data>
    </entity>
</entities>
