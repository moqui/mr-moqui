<!-- Dev AIDE, the assisted IDE (plans/design-dev-aide.md 1): Home (the site's changes, Publish, the reload log), the
    Workspace (the IDE: repositories and directories, files in the editor, changes and commits), Artifacts (search, the
    references, the site's customizations) and Settings. Mounted under
    apps as dev by the component's MoquiConf.xml; only on a dev instance, for ADMIN, DEV_AIDE_USERS and DEV_AIDE_EXTENDERS
    (the DEV_AIDE_APP artifact group). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        include-child-content="true" menu-image="sym_o_code" menu-image-type="icon">
    <subscreens default-item="Home">
        <subscreens-item name="Home" menu-title="Home" menu-index="1" location="component://dev-aide/screen/DevAide/Home.xml"/>
        <subscreens-item name="Workspace" menu-title="Workspace" menu-index="2" location="component://dev-aide/screen/DevAide/Workspace.xml"/>
        <subscreens-item name="Artifacts" menu-title="Artifacts" menu-index="3" location="component://dev-aide/screen/DevAide/Artifacts.xml"/>
        <subscreens-item name="Settings" menu-title="Settings" menu-index="9" location="component://dev-aide/screen/DevAide/Settings.xml"/>
    </subscreens>
    <shell-providers>
        <palette-action label="Dev AIDE Workspace" icon="sym_o_code" screen="dev/Workspace" sequence="70"/>
        <palette-action label="Dev AIDE Home: publish site changes" icon="sym_o_publish" screen="dev/Home" sequence="71"/>
        <palette-action label="Dev AIDE Settings" icon="sym_o_settings" screen="dev/Settings" sequence="72"/>
        <palette-action label="Go to artifact" icon="sym_o_travel_explore" screen="dev/Artifacts/Search" sequence="73"/>
        <palette-action label="Dev AIDE Customizations: what the site extends" icon="sym_o_extension" screen="dev/Artifacts/Customizations" sequence="74"/>
        <!-- the artifact index: entities, services, screens and rules by name, each opening in the Workspace at its line -->
        <palette-source group="DevArtifacts" label="Artifacts" icon="sym_o_data_object" sequence="60"
                service="org.moqui.devaide.ArtifactServices.search#Palette"/>
        <!-- on every app page of a Dev AIDE user: Dev Assist with the recipes for the page (plans/design-dev-aide.md 3.5) -->
        <page-action label="Customize this screen" icon="sym_o_design_services" agent="dev" sequence="10"/>
        <!-- the dev agent's prompts on Dev AIDE's pages (13.4) -->
        <assist-prompt label="Explain this artifact" text="Explain the artifact I have open: what it is, what uses it and what it uses."/>
        <assist-prompt label="Where is this used?" text="Where is the artifact at my cursor used? List the screens, services and rules."/>
        <assist-prompt label="What does my site customize here?" text="What does the site component extend of the artifact I have open, and is any extension broken?"/>
        <assist-prompt label="Fix the problems in this file" text="Fix the problems in the file I have open, as a change set."/>
    </shell-providers>
    <widgets>
        <subscreens-panel id="dev-aide-app" type="popup"/>
    </widgets>
</screen>
