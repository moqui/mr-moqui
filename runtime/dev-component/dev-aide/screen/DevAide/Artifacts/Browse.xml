<!-- The Artifact Browser (plans/design-dev-aide.md 7.3, D9, P9): an artifact in the center, what uses it and what it uses
    in cards beside it, each row expanding into the next column. The page is Browse.qvue, which loads the client
    (DevAide.js, DevAideBrowser.js) and reads the index through the Workspace's transitions. The same references as lists
    are Refs, which the terminal reaches. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Browser" default-menu-index="4" render-modes="qvue">
    <parameter name="artifactId"/>
    <widgets>
        <render-mode><text type="qvue" location="component://dev-aide/screen/DevAide/Artifacts/Browse.qvue" template="false"/></render-mode>
    </widgets>
</screen>
