<!-- The services of the artifact index (plans/design-dev-aide.md 9.3): by name, with their component, how many SECA rules
    run on each and how often the last spec run called it; a name opens the service view, the file the Workspace. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Services" default-menu-index="1">
    <parameter name="filter"/>
    <parameter name="component"/>
    <transition name="edit"><default-response url="../Edit"/></transition>

    <actions>
        <service-call name="org.moqui.devaide.ServiceWriterServices.list#Services" out-map="found" in-map="{filter: filter, component: component}"/>
        <set field="services" from="(found.services || []).slice(0, 500)"/>
        <set field="serviceCount" from="(found.services || []).length"/>
    </actions>
    <widgets>
        <form-single name="ServiceFilter" transition="." focus-field="filter">
            <field name="filter"><default-field title="Name"><text-line size="30"/></default-field></field>
            <field name="component"><default-field title="Component"><text-line size="20"/></default-field></field>
            <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
        </form-single>
        <label text="${serviceCount} services${serviceCount > 500 ? ', the first 500 shown' : ''}" type="p"/>
        <form-list name="ServiceList" list="services" skip-form="true">
            <field name="shortName"><default-field title="Service">
                <link url="edit" text="${shortName}" parameter-map="{artifact: id}" link-type="anchor"/></default-field></field>
            <field name="name"><default-field title="Full name"><display/></default-field></field>
            <field name="component"><default-field title="Component"><display text="${component}${upstream ? '' : ' · site'}"/></default-field></field>
            <field name="secaCount"><default-field title="SECA"><display text="${secaCount || ''}"/></default-field></field>
            <field name="calls"><default-field title="Calls"><display text="${calls == null ? '' : calls}"/></default-field></field>
            <field name="open"><default-field title="File">
                <link url="${url || ''}" url-type="plain" text="${(relativePath || path || '').split('/').slice(-2).join('/')}:${line}" link-type="anchor" condition="url"/>
            </default-field></field>
        </form-list>
    </widgets>
</screen>
