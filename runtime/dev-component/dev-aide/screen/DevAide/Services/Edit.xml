<!-- A service in its view (plans/design-dev-aide.md 9, D18 guided): the artifact resolved to its file through the index
    and opened in the Workspace's client with no tree or tabs; the Workspace's transitions answer it. Browser only. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit" default-menu-include="false" render-modes="qvue">
    <parameter name="artifact"/>
    <widgets>
        <render-mode>
            <text type="qvue" location="component://dev-aide/screen/DevAide/GuidedEdit.qvue" template="false"/>
        </render-mode>
    </widgets>
</screen>
