<!-- The screen tree (plans/design-dev-aide.md 11.1): a screen's subscreens as the screen facade mounts them (a file in
    the parent's directory, a subscreens-item, a conf mount, a row), each with its menu title and index, whether it is the
    default, its render modes and authentication; Children goes a level down, Design opens it in the builder. New
    subscreen makes a file from a gallery archetype in the parent's directory. A list, so the terminal reaches it. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Screens" default-menu-index="1">
    <parameter name="location"/>
    <parameter name="path"/>
    <parameter name="parentRootId"/>
    <parameter name="parentPath"/>
    <transition name="children"><default-response url="."/></transition>
    <transition name="design"><default-response url="../Design"/></transition>
    <transition name="updateSubscreen">
        <service-call name="org.moqui.devaide.ScreenServices.update#Subscreen" in-map="{parentRootId: parentRootId, parentPath: parentPath, name: name, isDefault: isDefault, menuIndex: menuIndex, mountedBy: mountedBy}"/>
        <default-response url="."/>
    </transition>
    <transition name="moveScreen">
        <service-call name="org.moqui.devaide.ScreenServices.move#Screen" in-map="{rootId: parentRootId, path: screenPath, to: to, updateRefs: updateRefs}"/>
        <default-response url="."/>
    </transition>
    <transition name="removeScreen">
        <service-call name="org.moqui.devaide.ScreenServices.remove#Screen" in-map="{rootId: parentRootId, path: screenPath, confirm: confirm}"/>
        <default-response url="."/>
    </transition>
    <transition name="createSubscreen">
        <service-call name="org.moqui.devaide.ScreenServices.create#Subscreen" in-map="{rootId: parentRootId, parentPath: parentPath, name: name, archetype: archetype, menuTitle: menuTitle}"/>
        <default-response url="."/>
    </transition>

    <actions>
        <service-call name="org.moqui.devaide.ScreenServices.get#ScreenChildren" out-map="found" in-map="{location: location, path: path}"/>
        <set field="screens" from="found.children || []"/>
        <set field="shownPath" from="path || '/qapps'"/>
        <set field="screenOptions" from="screens.filter((item) => item.relativePath).map((item) => ({ key: item.relativePath, text: item.name }))"/>
        <set field="nameOptions" from="screens.map((item) => ({ key: item.name, text: item.menuTitle + ' (' + item.name + ')' }))"/>
    </actions>
    <widgets>
        <label text="${shownPath}" type="h6"/>
        <form-list name="ScreenList" list="screens" skip-form="true">
            <field name="menuTitle"><default-field title="Screen">
                <link url="children" text="${menuTitle}" parameter-map="{location: location, path: path, parentRootId: rootId, parentPath: relativePath}" link-type="anchor"/></default-field></field>
            <field name="name"><default-field title="Name"><display/></default-field></field>
            <field name="menuIndex"><default-field title="Menu"><display text="${menuIndex == null ? '' : menuIndex}${menuInclude ? '' : ' (hidden)'}${isDefault ? ' · default' : ''}"/></default-field></field>
            <field name="mountedBy"><default-field title="Mounted by"><display text="${(mountedBy || '').split('/').slice(-2).join('/')}"/></default-field></field>
            <field name="renderModes"><default-field title="Modes"><display text="${(renderModes || []).join(', ')}"/></default-field></field>
            <field name="subscreenCount"><default-field title="Subscreens"><display text="${subscreenCount || ''}"/></default-field></field>
            <field name="design"><default-field title="">
                <link url="design" text="Design" parameter-map="{rootId: rootId, path: relativePath}" link-type="anchor" condition="relativePath"/></default-field></field>
        </form-list>
        <section name="NewSubscreenSection" condition="parentPath">
            <widgets>
                <form-single name="SubscreenSettings" transition="updateSubscreen">
                    <field name="parentRootId"><default-field><hidden/></default-field></field>
                    <field name="parentPath"><default-field><hidden/></default-field></field>
                    <field name="location"><default-field><hidden/></default-field></field>
                    <field name="path"><default-field><hidden/></default-field></field>
                    <field name="name"><default-field title="Subscreen"><drop-down><list-options list="nameOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                    <field name="menuIndex"><default-field title="Menu index"><text-line size="4"/></default-field></field>
                    <field name="isDefault"><default-field title="Make it the default"><check><option key="true" text=" "/></check></default-field></field>
                    <field name="mountedBy"><default-field title="Mounted by"><drop-down allow-empty="true">
                        <option key="directory" text="a file in the directory"/><option key="item" text="a subscreens-item"/></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Set"><submit/></default-field></field>
                </form-single>
                <form-single name="MoveScreen" transition="moveScreen">
                    <field name="parentRootId"><default-field><hidden/></default-field></field>
                    <field name="parentPath"><default-field><hidden/></default-field></field>
                    <field name="location"><default-field><hidden/></default-field></field>
                    <field name="path"><default-field><hidden/></default-field></field>
                    <field name="screenPath"><default-field title="Move"><drop-down><list-options list="screenOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                    <field name="to"><default-field title="To (a path in the root)"><text-line size="40"/></default-field></field>
                    <field name="updateRefs"><default-field title="Update what references it"><check><option key="true" text=" "/></check></default-field></field>
                    <field name="submitButton"><default-field title="Move"><submit/></default-field></field>
                </form-single>
                <form-single name="RemoveScreen" transition="removeScreen">
                    <field name="parentRootId"><default-field><hidden/></default-field></field>
                    <field name="parentPath"><default-field><hidden/></default-field></field>
                    <field name="location"><default-field><hidden/></default-field></field>
                    <field name="path"><default-field><hidden/></default-field></field>
                    <field name="screenPath"><default-field title="Remove"><drop-down><list-options list="screenOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                    <field name="confirm"><default-field title="Even when something references it"><check><option key="true" text=" "/></check></default-field></field>
                    <field name="submitButton"><default-field title="Remove"><submit confirmation="Remove the screen's file and its subscreens?"/></default-field></field>
                </form-single>
                <form-single name="NewSubscreen" transition="createSubscreen">
                    <field name="parentRootId"><default-field><hidden/></default-field></field>
                    <field name="parentPath"><default-field><hidden/></default-field></field>
                    <field name="location"><default-field><hidden/></default-field></field>
                    <field name="path"><default-field><hidden/></default-field></field>
                    <field name="name"><default-field title="New subscreen"><text-line size="20"/></default-field></field>
                    <field name="menuTitle"><default-field title="Menu title"><text-line size="20"/></default-field></field>
                    <field name="archetype"><default-field title="From"><drop-down allow-empty="true">
                        <option key="Landing"/><option key="List"/><option key="Detail"/><option key="Record360" text="360"/><option key="Task"/>
                        <option key="Board"/><option key="Calendar"/><option key="Split"/><option key="Settings"/><option key="Wizard"/>
                        <option key="Dialog"/><option key="Report"/><option key="Editor"/><option key="Panel"/></drop-down></default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
                <!-- the archetypes as the gallery shows them, each a small live render (stamped, so it may be framed here) -->
                <render-mode><text type="qvt"><![CDATA[<q-expansion-item dense icon="dashboard" label="Preview the archetypes" id="DevArchetypePreview">
                    <div class="row q-gutter-sm q-pa-sm">
                        <div v-for="archetype in ['Landing','List','Detail','Record360','Task','Board','Calendar','Split','Settings','Wizard','Dialog','Report','Editor','Panel']" :key="archetype" class="m-dev-archetype">
                            <div class="text-caption">{{ archetype === 'Record360' ? '360' : archetype }}</div>
                            <div style="width:195px;height:300px;overflow:hidden;border:1px solid rgba(128,128,128,.4);border-radius:4px">
                                <iframe loading="lazy" :src="'/qapps/gallery/' + archetype + '?moquiAide=source'" :title="archetype"
                                        style="width:390px;height:600px;border:0;transform:scale(.5);transform-origin:0 0;pointer-events:none" tabindex="-1"></iframe>
                            </div>
                        </div>
                    </div>
                </q-expansion-item>]]></text><text type="tui"><![CDATA[{"t": "text", "id": "DevArchetypePreview", "text": "Archetypes: the gallery (/apps/gallery) shows each one."}]]></text></render-mode>
            </widgets>
        </section>
    </widgets>
</screen>
