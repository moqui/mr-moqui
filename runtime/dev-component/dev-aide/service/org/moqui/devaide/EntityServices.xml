<!-- The entity modeler (plans/design-dev-aide.md 8): the entities as the server merged them, with each field's origin
    and where an edit goes (the site's extend-entity for an upstream entity, D17), the table against the fields, the
    changes the table check never makes (the full tier, typed confirm, audited) and the load of a modeler's seed data. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="list" noun="Entities" type="rust" location="dev_aide::entities::list_entities" allow-remote="false" read-only="true">
        <description>The entities and view entities of the artifact index by name, with their component, file and how many site extensions each has.</description>
        <in-parameters>
            <parameter name="filter"/>
            <parameter name="component"/>
            <parameter name="kind"><description>entity, view-entity, or empty for both</description></parameter>
        </in-parameters>
        <out-parameters><parameter name="entities" type="List"/></out-parameters>
    </service>
    <service verb="get" noun="EntityView" type="rust" location="dev_aide::entities::get_entity_view" allow-remote="false" read-only="true">
        <description>An entity as its view shows it: the merged definition, each field's origin, the extensions, where an
            edit goes, the seed data file, the incoming relationships, the EECA rules, the table against the fields, the
            first rows, and the field types with their SQL types.</description>
        <in-parameters>
            <parameter name="artifactId"/>
            <parameter name="entityName"/>
        </in-parameters>
        <out-parameters><parameter name="view" type="Map"/></out-parameters>
    </service>
    <service verb="plan" noun="EntityDdl" type="rust" location="dev_aide::entities::plan_entity_ddl" allow-remote="false" read-only="true">
        <description>The SQL of a change the table check never makes, to read before running it: drop-column, change-type,
            copy-column (a renamed field's data, then the old column dropped) or recreate-table. The full tier.</description>
        <in-parameters>
            <parameter name="entityName" required="true"/>
            <parameter name="action" required="true"/>
            <parameter name="fieldName"/>
            <parameter name="columnName"/>
        </in-parameters>
        <out-parameters>
            <parameter name="statements" type="List"/>
            <parameter name="tableName"/>
        </out-parameters>
    </service>
    <service verb="run" noun="EntityDdl" type="rust" location="dev_aide::entities::run_entity_ddl" allow-remote="false">
        <description>Run a planned change when confirmTable is the table's name typed back; each statement audited. The full tier.</description>
        <in-parameters>
            <parameter name="entityName" required="true"/>
            <parameter name="action" required="true"/>
            <parameter name="fieldName"/>
            <parameter name="columnName"/>
            <parameter name="confirmTable" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="ran" type="List"/></out-parameters>
    </service>
    <service verb="load" noun="SeedFile" type="rust" location="dev_aide::entities::load_seed_file" allow-remote="false">
        <description>Load one data file the user may write (a site component's) into the database, audited.</description>
        <in-parameters>
            <parameter name="rootId" required="true"/>
            <parameter name="path" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="records" type="Long"/>
            <parameter name="file"/>
        </out-parameters>
    </service>
    <service verb="check" noun="DataFile" type="rust" location="dev_aide::entities::check_data_file" allow-remote="false" read-only="true">
        <description>A data file's records (the buffer's text, or the file) against the database: each record not found and each field that differs.</description>
        <in-parameters>
            <parameter name="rootId" required="true"/>
            <parameter name="path" required="true"/>
            <parameter name="text" allow-html="any"/>
        </in-parameters>
        <out-parameters>
            <parameter name="messages" type="List"/>
            <parameter name="differences" type="List"/>
            <parameter name="fieldsChecked" type="Long"/>
        </out-parameters>
    </service>
    <service verb="export" noun="Records" type="rust" location="dev_aide::entities::export_records" allow-remote="false" read-only="true">
        <description>An entity's records as the elements of a data file, at most a thousand; filter narrows by field values.</description>
        <in-parameters>
            <parameter name="entityName" required="true"/>
            <parameter name="filter" type="Object" allow-html="any"><description>A JSON object of field values.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="records"/>
            <parameter name="count" type="Long"/>
        </out-parameters>
    </service>
    <service verb="load" noun="ChangedRecords" type="rust" location="dev_aide::entities::load_changed_records" allow-remote="false">
        <description>Of a data file the user may write, only the records added or changed since its last commit, loaded; audited.</description>
        <in-parameters>
            <parameter name="rootId" required="true"/>
            <parameter name="path" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="changed" type="Integer"/>
            <parameter name="records" type="Long"/>
        </out-parameters>
    </service>
    <service verb="get" noun="ViewSql" type="rust" location="dev_aide::entities::get_view_sql" allow-remote="false" read-only="true">
        <description>The SQL of a find of a view entity's first rows.</description>
        <in-parameters><parameter name="entityName" required="true"/></in-parameters>
        <out-parameters><parameter name="sql"/></out-parameters>
    </service>
</services>
