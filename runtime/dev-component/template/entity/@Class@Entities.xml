<!-- The entities of @Title@. A new field or entity is added to the database at the next start of the server. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="@Class@Item" package="@package@">
        <field name="itemId" type="id" is-pk="true"/>
        <field name="itemName" type="text-medium"><description>What the item is called</description></field>
        <field name="description" type="text-long"/>
    </entity>
</entities>
