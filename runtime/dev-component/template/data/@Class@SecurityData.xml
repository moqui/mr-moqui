<!-- Who may use the app: its root screen and everything under it, for the ADMIN group. -->
<entity-facade-xml type="seed">
    <artifactGroups artifactGroupId="@ID@_APP" description="@Title@ App (via root screen)">
        <artifacts artifactName="component://@component@/screen/@Class@.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <authz artifactAuthzId="@ID@_APP_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
</entity-facade-xml>
