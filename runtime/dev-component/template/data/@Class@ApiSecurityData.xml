<!-- Who may call the REST API (service/@component@.rest.xml): all of it, through its root resource, for the ADMIN
    group. -->
<entity-facade-xml type="seed">
    <artifactGroups artifactGroupId="@ID@_API" description="@Title@ REST API (via root resource)">
        <artifacts artifactName="/@component@" artifactTypeEnumId="AT_REST_PATH" inheritAuthz="Y"/>
        <authz artifactAuthzId="@ID@_API_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
</entity-facade-xml>
