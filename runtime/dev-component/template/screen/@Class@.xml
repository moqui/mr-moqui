<!-- @Title@, mounted under the apps root by the component's MoquiConf.xml. Who may open it is in
    data/@Class@SecurityData.xml. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="true" default-menu-title="@Title@" menu-image="sym_o_inventory_2" menu-image-type="icon">
    <subscreens default-item="FindItem">
        <subscreens-item name="FindItem" menu-title="Items" menu-index="1" location="component://@component@/screen/@Class@/FindItem.xml"/>
        <subscreens-item name="EditItem" menu-include="false" location="component://@component@/screen/@Class@/EditItem.xml"/>
    </subscreens>
    <widgets><subscreens-panel id="@component@-panel" type="popup"/></widgets>
</screen>
