<!-- The items: find by name, a list with each item linked to its detail, and a New dialog. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Items" default-menu-index="1" menu-image="sym_o_view_list" menu-image-type="icon">

    <transition name="editItem"><default-response url="../EditItem"/></transition>
    <transition name="createItem"><service-call name="@package@.@Class@Services.create#Item"/>
        <default-response url="../EditItem"/></transition>

    <actions>
        <entity-find entity-name="@package@.@Class@Item" list="itemList">
            <search-form-inputs default-order-by="itemName"/>
        </entity-find>
    </actions>
    <widgets>
        <container-dialog id="NewItemDialog" button-text="New item">
            <form-single name="NewItemForm" transition="createItem" focus-field="itemName">
                <field name="itemName"><default-field title="Name"><text-line size="40"/></default-field></field>
                <field name="description"><default-field><text-area rows="3" cols="60"/></default-field></field>
                <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
            </form-single>
        </container-dialog>
        <form-list name="ItemList" list="itemList" skip-form="true" header-dialog="true">
            <field name="itemName">
                <header-field title="Name" show-order-by="true"><text-find size="20" hide-options="true"/></header-field>
                <default-field><link text="${itemName || itemId}" url="editItem" link-type="anchor"/></default-field>
            </field>
            <field name="itemId"><header-field title="ID" show-order-by="true"/><default-field><display/></default-field></field>
            <field name="description"><default-field><display/></default-field></field>
        </form-list>
    </widgets>
</screen>
