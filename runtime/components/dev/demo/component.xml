<!-- Locks a server down for a public demo: the apps stay usable with the john.doe login, the sharp tools and servers do
    not (README.md). Off by default. A demo server names it in its conf (runtime/conf/MoquiDemoConf.xml), which loads it
    on a production instance; on a dev instance -D demo_disabled=false turns it on. No purpose here: a conf that names
    the component loads it on any instance purpose. -->
<component xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd"
        name="demo" version="${moqui_version}" disabled="${demo_disabled ?: 'true'}">
    <!-- after these, so its data overwrites their security rows -->
    <depends-on name="tools"/>
    <depends-on name="webroot"/>
</component>
