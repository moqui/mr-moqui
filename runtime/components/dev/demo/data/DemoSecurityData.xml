<!-- The demo lock-down of ADMIN (README.md). Seed, not demo: a seed load runs the tools and framework seed again and
    then this, after them, so the lock-down holds on every seed load and on a production first-run load. Each row has
    the primary key of the row it overwrites. -->
<entity-facade-xml type="seed">
    <!-- VIEW-only for ADMIN on the Tools and System apps, so the lock-down below cannot be undone from them, and on the
        Moqui REST API (component://tools/data/ToolsSecurityData.xml) -->
    <moqui.security.ArtifactAuthz artifactAuthzId="TOOLS_APP_ADMIN" artifactGroupId="TOOLS_APP" userGroupId="ADMIN"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_VIEW"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="SYSTEM_APP_ADMIN" artifactGroupId="SYSTEM_APP" userGroupId="ADMIN"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_VIEW"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MOQUI_API_ADMIN" artifactGroupId="MOQUI_API" userGroupId="ADMIN"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_VIEW"/>
    <!-- EntitySync put and get, and SystemMessage receive, are not under the Tools and System screens
        (component://framework/data/SecurityTypeData.xml) -->
    <moqui.security.ArtifactAuthz artifactAuthzId="EntitySyncServicesADMIN" artifactGroupId="EntitySyncServices" userGroupId="ADMIN"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_VIEW"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="SystemMessageServicesADMIN" artifactGroupId="SystemMessageServices" userGroupId="ADMIN"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_VIEW"/>
    <!-- /resources (webroot.xml) reads and writes any resource root; VIEW does not cover run#Command, so it is refused -->
    <moqui.security.ArtifactAuthz artifactAuthzId="ResourceCommandServicesADMIN" artifactGroupId="ResourceCommandServices" userGroupId="ADMIN"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_VIEW"/>
    <!-- git repositories: clone and read, no push, no new repositories or mirrors (SecurityTypeData.xml) -->
    <moqui.security.ArtifactAuthz artifactAuthzId="GitRepositoriesADMIN" artifactGroupId="GitRepositories" userGroupId="ADMIN"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_VIEW"/>
    <!-- Monitor: its checks and scrape targets fetch URLs a user gives, and its sources issue ingest keys; reports keep
        their editing but not git sync or webhook contacts (component://tools/data/MonitoringSecurityData.xml) -->
    <moqui.security.ArtifactAuthz artifactAuthzId="REPORT_GIT_SYNC_ADMIN" artifactGroupId="REPORT_GIT_SYNC_ADMIN" userGroupId="ADMIN"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_VIEW"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="REPORT_CONTACT_ADMIN" artifactGroupId="REPORT_CONTACT_ADMIN" userGroupId="ADMIN"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_VIEW"/>
    <!-- the data load wrap (bulk load with the foreign keys dropped, component://tools/data/ToolsDatabaseData.xml), and which
        projects' artifact index may be read (framework DevToolsSecurityData.xml), which a visitor does not change -->
    <moqui.security.ArtifactAuthz artifactAuthzId="TOOLS_DATABASE_LOAD_ADMIN" artifactGroupId="TOOLS_DATABASE_LOAD" userGroupId="ADMIN"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_VIEW"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="AIDE_PROJECTS_ADMIN" artifactGroupId="AIDE_PROJECTS" userGroupId="ADMIN"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_VIEW"/>

    <!-- ADMIN permissions ended: the search store and OpenSearch Dashboards proxies
        (component://framework/data/MoquiSetupData.xml), another user's password without the old one, SFTP and git over
        SSH should SSH be turned back on, telemetry ingest, report files written on the server, and recovery actions and
        their policies, and runtime log and telemetry settings -->
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="SearchRemote" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="DashboardRemote" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_PASSWORD" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="SSH_SFTP" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="SSH_GIT" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MONITOR_INGEST" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="REPORT_SAVE_LOCATION" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MONITOR_RECOVER" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MONITOR_RECOVER_ADMIN" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MONITOR_SETTINGS" fromDate="0" thruDate="1265184000000"/>
    <!-- Admin's writes (framework SecurityTypeData.xml, AgentTypeData.xml): group grants and memberships, which would undo this
        lock-down, accounts across organizations, backups and their downloads, connections and their credentials, imports and
        exports, instance settings, jobs and recovery actions, and the agents' instance Constitution -->
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_ACCESS_MANAGE" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_IDENTITY_MANAGE" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_IDENTITY_GLOBAL" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_BACKUP_RUN" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_BACKUP_DOWNLOAD" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_CONNECTION_MANAGE" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_TRANSFER_RUN" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_SETTINGS_MANAGE" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_OPERATION_MANAGE" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ADMIN_CONSTITUTION_GLOBAL" fromDate="0" thruDate="1265184000000"/>
    <!-- the agents' models, endpoints and keys, and saving skills; chat bridges and phone trunks (outside services); CI runner pools
        and their tokens; eval runs, which cost money; other visitors' browser session replays; and mail accounts hosted here -->
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="AgentAdmin" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="AgentSkillAuthor" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ChatBridgeAdmin" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="VoiceAdmin" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="GIT_CI_ADMIN" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MONITOR_EVAL_RUN" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MONITOR_REPLAY" fromDate="0" thruDate="1265184000000"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="EMAIL_ACCOUNT_HOSTED" fromDate="0" thruDate="1265184000000"/>
</entity-facade-xml>
