<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-entity-eca.xsd">
    <!-- An Assist conversation that ends (archived) or is deleted ends its session's worktrees (plans/design-dev-aide.md
        21.8): once the write commits, a clean one is removed and one with uncommitted changes is kept, its user told
        (WorktreeServices.end#ConversationWorktrees). The condition is narrow: an update that does not write the archived
        status registers nothing. A write with no transaction runs it at once, on its own thread. One that cannot be
        registered is logged, and the conversation's write goes on. -->
    <eeca id="DevAideConversationWorktrees" entity="moqui.agent.AgentConversation" on-update="true" on-delete="true">
        <condition><expression>eecaOperation == 'delete' || statusId == 'AgcArchived'</expression></condition>
        <actions><script><![CDATA[
            const name = 'org.moqui.devaide.WorktreeServices.end#ConversationWorktrees'
            try {
                // a write with no transaction is in the database already
                if (ec.transaction.isTransactionInPlace())
                    ec.service.special().name(name).parameter('conversationId', conversationId).registerOnCommit()
                else ec.service.async().name(name).parameter('conversationId', conversationId).call()
            } catch (err) {
                ec.logger.error(`The worktrees of conversation ${conversationId} were not ended: ${err && err.message ? err.message : err}`)
            }
        ]]></script></actions>
    </eeca>
</eecas>
