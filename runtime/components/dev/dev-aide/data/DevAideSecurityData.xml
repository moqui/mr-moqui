<!-- Who may use Dev AIDE (plans/design-dev-aide.md 3.4): the app's screens for ADMIN and the two dev-aide groups, and the
    three tiers the services check: DEV_AIDE_VIEW reads, DEV_AIDE_EXTEND writes inside site components, DEV_AIDE does
    everything. Seed of the dev-aide, so it exists only where the component loads (a dev instance). -->
<entity-facade-xml type="seed">
    <moqui.security.UserGroup userGroupId="DEV_AIDE_USERS" description="Dev AIDE developers (the full tier)"/>
    <moqui.security.UserGroup userGroupId="DEV_AIDE_EXTENDERS" description="Dev AIDE extenders (writes in site components)"/>

    <moqui.security.UserPermission userPermissionId="DEV_AIDE_VIEW" description="Dev AIDE: browse, search and read files"/>
    <moqui.security.UserPermission userPermissionId="DEV_AIDE_EXTEND" description="Dev AIDE: write site components, publish"/>
    <moqui.security.UserPermission userPermissionId="DEV_AIDE" description="Dev AIDE: everything, upstream edits and every git command"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="DEV_AIDE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="DEV_AIDE_USERS" userPermissionId="DEV_AIDE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="DEV_AIDE_EXTENDERS" userPermissionId="DEV_AIDE_EXTEND" fromDate="0"/>

    <artifactGroups artifactGroupId="DEV_AIDE_APP" description="Dev AIDE App (via root screen)">
        <artifacts artifactName="component://dev-aide/screen/DevAide.xml" artifactTypeEnumId="AT_XML_SCREEN" inheritAuthz="Y"/>
        <!-- the services, which check the tier themselves, called from elsewhere than the screens (agents, specs) -->
        <artifacts artifactName="org\.moqui\.devaide\..*" nameIsPattern="Y" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
        <!-- the framework's development tools that write, run or rebuild (the index's rebuild, the schema digest, XML
            operations, restart), which check the dev instance and the permission themselves; the index's reads are in
            the framework's AIDE_READ_API group, granted to the dev-aide's groups below -->
        <artifacts artifactName="org\.moqui\.dev\.DevToolsServices\.(apply#XmlOps|get#SchemaDigest|get#XmlOutline|rebuild#ArtifactIndex|restart#Server)"
                nameIsPattern="Y" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
        <authz artifactAuthzId="DEV_AIDE_APP_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="DEV_AIDE_APP_USERS" userGroupId="DEV_AIDE_USERS" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="DEV_AIDE_APP_EXTENDERS" userGroupId="DEV_AIDE_EXTENDERS" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- the index's reads (the framework's DevToolsSecurityData.xml), which check the dev instance and the tier, or
        AIDE_READ, themselves -->
    <moqui.security.ArtifactAuthz artifactAuthzId="AIDE_READ_API_DA_USERS" artifactGroupId="AIDE_READ_API"
            userGroupId="DEV_AIDE_USERS" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_VIEW"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="AIDE_READ_API_DA_EXTENDERS" artifactGroupId="AIDE_READ_API"
            userGroupId="DEV_AIDE_EXTENDERS" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_VIEW"/>
    <!-- the services' own records, written by the services after their tier check -->
    <artifactGroups artifactGroupId="DEV_AIDE_ENTITIES" description="Dev AIDE records">
        <artifacts artifactName="moqui\.dev\..*" nameIsPattern="Y" artifactTypeEnumId="AT_ENTITY" inheritAuthz="N"/>
        <authz artifactAuthzId="DEV_AIDE_ENT_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
        <authz artifactAuthzId="DEV_AIDE_ENT_USERS" userGroupId="DEV_AIDE_USERS" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>

    <moqui.basic.EnumerationType enumTypeId="DevAideAction" description="Dev AIDE audited action"/>
    <moqui.basic.Enumeration enumId="DAA_SAVE" enumTypeId="DevAideAction" description="Save"/>
    <moqui.basic.Enumeration enumId="DAA_CREATE" enumTypeId="DevAideAction" description="Create"/>
    <moqui.basic.Enumeration enumId="DAA_MOVE" enumTypeId="DevAideAction" description="Move or rename"/>
    <moqui.basic.Enumeration enumId="DAA_DELETE" enumTypeId="DevAideAction" description="Delete"/>
    <moqui.basic.Enumeration enumId="DAA_GIT" enumTypeId="DevAideAction" description="Git command"/>
    <moqui.basic.Enumeration enumId="DAA_DDL" enumTypeId="DevAideAction" description="DDL on a dev database"/>
    <moqui.basic.Enumeration enumId="DAA_LOAD" enumTypeId="DevAideAction" description="Data file loaded"/>
    <moqui.basic.Enumeration enumId="DAA_TRY" enumTypeId="DevAideAction" description="Service run for real"/>
    <moqui.basic.Enumeration enumId="DAA_EXPORT" enumTypeId="DevAideAction" description="Docs exported"/>

    <moqui.security.user.NotificationTopic topic="DevReload" description="Dev AIDE reload" typeString="info" showAlert="N"
            persistOnSend="N"/>
</entity-facade-xml>
