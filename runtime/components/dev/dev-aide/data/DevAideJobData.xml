<!-- The Dev AIDE's jobs (plans/design-dev-aide.md 21.8): every five minutes, the worktrees of sessions whose conversation
    ended while a run of it was still at work, or while the server was down, are ended (WorktreeServices). -->
<entity-facade-xml type="seed-initial">
    <moqui.service.job.ServiceJob jobName="sweep_DevAideWorktrees_frequent" description="End the worktrees of ended Assist sessions"
            serviceName="org.moqui.devaide.WorktreeServices.sweep#ConversationWorktrees" cronExpression="0 0/5 * * * ?"
            paused="N" errorHistoryOnly="Y"/>
</entity-facade-xml>
