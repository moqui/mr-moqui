<!-- Dev AIDE, the assisted IDE (plans/design-dev-aide.md): a workspace of the components' repositories and
    directories with an editor, git and live reload, at /qapps/dev. It gives its users code execution as the server's OS
    user, so it loads only when instance_purpose is dev: runtime/components/dev is a dev-only component directory, and this
    purpose keeps a copy elsewhere out too. -->
<component xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd"
        name="dev-aide" version="${moqui_version}" purpose="dev"/>
