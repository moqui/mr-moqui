<!-- Mounts the Dev AIDE app under the apps root (/apps/dev, /qapps/dev), and the dev-aide settings: the site components
    (whose files the extend tier writes; the others are upstream and read only), shared mode for a team dev server, and
    the git command and its timeouts (plans/design-dev-aide.md 16). -->
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <screen-facade>
        <screen location="component://webroot/screen/webroot/apps.xml">
            <subscreens-item name="dev" menu-title="Dev AIDE" menu-index="97" location="component://dev-aide/screen/DevAide.xml"/>
        </screen>
        <!-- DevAide.js and its CSS for the Workspace (screen/devstatic/) -->
        <screen location="component://webroot/screen/webroot.xml">
            <subscreens-item name="devstatic" location="component://dev-aide/screen/devstatic.xml" menu-include="false"/>
        </screen>
    </screen-facade>
    <dev-aide site-component="${dev_aide_site_component ?: ''}" shared="${dev_aide_shared ?: 'false'}"
            allow-upstream-edits="false" git-command="git" git-read-timeout="15" git-network-timeout="300" git-write-timeout="120"
            max-edit-bytes="2097152">
        <!-- the apps a task opens in (plans/design-dev-aide.md 14); Settings adds more as DevAideTaskApp rows -->
        <task-app name="projects" title="IronStone Projects"
                project-path="/qapps/Projects/Projects/ProjectDetail?workEffortId={projectId}"
                task-path="/qapps/Projects/WorkItems/WorkItemDetail?workEffortId={taskId}"/>
        <task-app name="marble" title="MarbleERP" project-path="/qapps/marble/Project/ProjectSummary?workEffortId={projectId}"
                task-path="/qapps/marble/Task/TaskSummary?workEffortId={taskId}"/>
    </dev-aide>
</moqui-conf>
