<!-- A screen in the builder (plans/design-dev-aide.md 11.2, D18 guided): from its file (rootId, path) or an app page
    (page, as "Open in screen builder" sends it), in the Workspace's client with no tree or tabs. The terminal's twin is DesignTui.xml. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Design" default-menu-include="false" render-modes="qvue,tui">
    <parameter name="rootId"/>
    <parameter name="path"/>
    <parameter name="page"/>
    <widgets>
        <render-mode>
            <text type="qvue" location="component://dev-aide/screen/DevAide/GuidedEdit.qvue" template="false"/>
            <text type="tui"><![CDATA[${JSON.stringify([{t: 'dynamicContainer', id: 'ScreenDesignTui', url: sri.buildUrl('../DesignTui')
                .addParameters({rootId: rootId || null, path: path || null, page: page || null}).getUrlWithParams()}])}]]></text>
        </render-mode>
    </widgets>
</screen>
