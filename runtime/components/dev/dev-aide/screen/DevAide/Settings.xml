<!-- Dev AIDE Settings (plans/design-dev-aide.md 16): the site components (whose files the extend tier writes; the rest is
    upstream), "Allow editing upstream components" for a full-tier user (D17), the roots with their labels, read only
    flags and publish branches (question 15), roots of other directories, git init of a plain root, network git on a
    shared dev server (an admin's), and the group servers (21.2): Connect signs in at the server as an installed app
    (its page comes back to serverSignedIn here), through the identity provider the user picks of those the server
    offers or its own login, or takes a pasted token, then sets what the user confirms. The services
    check the tier; the page shows what the user may change. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Settings" default-menu-index="11" menu-image="sym_o_settings" menu-image-type="icon">

    <parameter name="serverId"/>

    <!-- group servers (21.2) -->
    <!-- a server with identity providers answers them first: the page lists them (and the server's own login) to choose -->
    <transition name="startConnect"><service-call name="org.moqui.devaide.HostingServices.start#Connect" out-map="started"/>
        <conditional-response url="."><condition><expression>!started.authorizeUrl</expression></condition>
            <parameter name="serverId" from="started.serverId"/></conditional-response>
        <default-response url="${started.authorizeUrl}" url-type="plain"/>
        <error-response url="."/></transition>
    <transition name="serverSignedIn" require-session-token="false">
        <parameter name="code"/><parameter name="state"/><parameter name="error"/>
        <service-call name="org.moqui.devaide.HostingServices.finish#Connect" in-map="{code: code, state: state, error: error}" out-map="finished"/>
        <actions><message type="success">Connected: confirm what to set from the server</message></actions>
        <default-response url="." parameter-map="{serverId: finished.serverId}"/>
        <error-response url="."/></transition>
    <transition name="storeServerToken"><service-call name="org.moqui.devaide.HostingServices.store#ServerToken" out-map="stored"/>
        <actions><message type="success">Token saved</message></actions>
        <default-response url="." parameter-map="{serverId: stored.serverId}"/>
        <error-response url="."/></transition>
    <transition name="refreshServer"><service-call name="org.moqui.devaide.HostingServices.refresh#Server"/>
        <default-response url="."/></transition>
    <transition name="applyServerSetup"><service-call name="org.moqui.devaide.HostingServices.apply#ServerSetup" out-map="applied"/>
        <actions><message type="success">Set: ${(applied.done || []).join('; ') || 'nothing'}</message></actions>
        <default-response url="."/>
        <error-response url="."/></transition>
    <transition name="removeServer"><service-call name="org.moqui.devaide.HostingServices.remove#Server" out-map="removed"/>
        <actions><message type="success">Removed the connection${removed.removed &amp;&amp; removed.removed.length ? ' and ' + removed.removed.join(', ') : ''}</message></actions>
        <default-response url="."/></transition>

    <transition name="setSiteComponents"><service-call name="org.moqui.devaide.WorkspaceServices.set#Setting"
            in-map="{settingName: 'siteComponents', settingValue: siteComponents}"/>
        <actions><message type="success">Site components saved</message></actions>
        <default-response url="."/></transition>
    <transition name="setUpstreamEdits"><service-call name="org.moqui.devaide.WorkspaceServices.set#UpstreamEdits"
            in-map="{enabled: upstreamEdits == 'true'}"/>
        <default-response url="."/></transition>
    <transition name="setNetworkGit"><service-call name="org.moqui.devaide.WorkspaceServices.set#Setting"
            in-map="{settingName: 'networkGit', settingValue: networkGit == 'Y' ? 'Y' : 'N'}"/>
        <default-response url="."/></transition>
    <transition name="storeCredential"><service-call name="org.moqui.devaide.WorkspaceServices.store#Credential"/>
        <actions><message type="success">Token saved</message></actions>
        <default-response url="."/></transition>
    <transition name="deleteCredential"><service-call name="org.moqui.devaide.WorkspaceServices.delete#Credential"/>
        <default-response url="."/></transition>
    <transition name="storeRoot"><service-call name="org.moqui.devaide.WorkspaceServices.store#Root"/>
        <actions><message type="success">Saved</message></actions>
        <default-response url="."/></transition>
    <transition name="deleteRoot"><service-call name="org.moqui.devaide.WorkspaceServices.delete#Root"/>
        <default-response url="."/></transition>
    <transition name="initRepository"><service-call name="org.moqui.devaide.VcsServices.init#Repository"/>
        <actions><message type="success">Initialized a git repository</message></actions>
        <default-response url="."/></transition>

    <actions>
        <service-call name="org.moqui.devaide.WorkspaceServices.get#Roots" out-map="info"/>
        <set field="roots" from="info.roots"/>
        <set field="full" from="info.tier == 'full'" type="Boolean"/>
        <set field="siteComponents" from="(info.siteComponents || []).join(', ')"/>
        <set field="upstreamEdits" from="info.upstreamEdits ? 'true' : 'false'"/>
        <set field="admin" from="ec.user.isInGroup('ADMIN')" type="Boolean"/>
        <service-call name="org.moqui.devaide.HostingServices.get#Servers" out-map="hosting"/>
        <set field="servers" from="(hosting.servers || []).map((server) => Object.assign({}, server, {
            offered: [server.offer &amp;&amp; server.offer.git ? 'git' : null, server.offer &amp;&amp; server.offer.gateway &amp;&amp; server.offer.gateway.enabled ? 'LLM gateway' : null,
                server.offer &amp;&amp; server.offer.application ? server.offer.application.name : null].filter((part) => part).join(', ')}))"/>
        <set field="planServer" from="serverId ? servers.find((server) => server.serverId == serverId &amp;&amp; server.mine) : null"/>
        <!-- the identity providers the server's app sign-in offers (signIn.providers, from its get#AppProviders) -->
        <set field="signInProviders" from="planServer &amp;&amp; planServer.offer &amp;&amp; planServer.offer.signIn &amp;&amp; planServer.offer.signIn.providers
            ? planServer.offer.signIn.providers.map((provider) => Object.assign({baseUrl: planServer.baseUrl, label: planServer.label}, provider)) : []"/>
        <set field="plan" from="planServer ? planServer.plan : null"/>
        <if condition="info.shared &amp;&amp; admin &amp;&amp; full">
            <service-call name="org.moqui.devaide.WorkspaceServices.get#Credentials" out-map="stored"/>
            <set field="credentials" from="stored.credentials || []"/>
            <set field="rootOptions" from="roots.map((root) => ({key: root.id, text: root.label}))"/>
        </if>
    </actions>
    <widgets>
        <container-box id="DevAideServersBox"><box-header title="Group servers"/><box-body>
            <label type="p" text="A group server hosts the team's repositories, work items and LLM gateway. Connect signs you in there in the browser, as the desktop app does, and this instance keeps the key it gets, sent only to that server. Then confirm what to set from it: the addons repository, the task source, the gateway and git's credential."/>
            <form-list name="ServerList" list="servers" skip-form="true">
                <field name="label"><default-field title="Server"><display text="${label} (${baseUrl})"/></default-field></field>
                <field name="statusText"><default-field title="State"><display text="${statusText || ''}${username ? ' as ' + username : ''}${lastError ? ': ' + lastError : ''}"/></default-field></field>
                <field name="offered"><default-field title="Offers"><display/></default-field></field>
                <field name="actions"><default-field title="">
                    <link url="." text="Set up" parameter-map="{serverId: serverId}" condition="mine"/>
                    <link url="startConnect" text="Sign in again" parameter-map="{baseUrl: baseUrl, label: label}" link-type="hidden-form" condition="mine"/>
                    <link url="refreshServer" text="Check" parameter-map="{serverId: serverId}" link-type="hidden-form" condition="mine"/>
                    <link url="removeServer" text="Remove" parameter-map="{serverId: serverId}" link-type="hidden-form" condition="mine"
                            btn-type="danger" confirmation="Remove the connection to ${label}, and what Connect set from it?"/>
                </default-field></field>
            </form-list>
            <form-single name="ConnectForm" transition="startConnect">
                <field name="baseUrl"><default-field title="Server address (https://team.example.com)"><text-line size="40"/></default-field></field>
                <field name="label"><default-field title="Label"><text-line size="20"/></default-field></field>
                <field name="submitButton"><default-field title="Connect"><submit/></default-field></field>
            </form-single>
            <container-dialog id="ServerTokenDialog" button-text="Paste an access token">
                <label type="p" text="An access token made on the server's Git access page works too, as a team's server without the app sign-in needs."/>
                <form-single name="ServerTokenForm" transition="storeServerToken">
                    <field name="baseUrl"><default-field title="Server address"><text-line size="40"/></default-field></field>
                    <field name="label"><default-field title="Label"><text-line size="20"/></default-field></field>
                    <field name="token"><default-field title="Access token"><password size="40"/></default-field></field>
                    <field name="submitButton"><default-field title="Save token"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </box-body></container-box>

        <section name="ServerSignInSection" condition="signInProviders.length"><widgets>
            <container-box id="DevAideServerSignInBox"><box-header title="Sign in to ${planServer.label}"/><box-body>
                <label type="p" text="${planServer.label} signs you in with one of these, or with its own login."/>
                <form-list name="SignInProviderList" list="signInProviders" skip-form="true">
                    <field name="description"><default-field title="Sign in with"><display/></default-field></field>
                    <field name="signIn"><default-field title="">
                        <link url="startConnect" text="Sign in with ${description}" parameter-map="{baseUrl: baseUrl, label: label, authFlowId: authFlowId}"
                                link-type="hidden-form"/></default-field></field>
                </form-list>
                <link url="startConnect" text="Sign in with ${planServer.label}'s own login" link-type="hidden-form"
                        parameter-map="{baseUrl: planServer.baseUrl, label: planServer.label, ownLogin: 'true'}"/>
            </box-body></container-box>
        </widgets></section>

        <section name="ServerPlanSection" condition="plan"><widgets>
            <container-box id="DevAideServerPlanBox"><box-header title="Set up from ${planServer.label}"/><box-body>
                <label type="p" text="Each is set only when checked."/>
                <form-single name="ServerSetupForm" transition="applyServerSetup">
                    <field name="serverId"><default-field><hidden default-value="${planServer.serverId}"/></default-field></field>
                    <field name="addons"><default-field title="Addons repository" tooltip="A repository entry in ${plan.addons.file} for ${plan.addons.url}, so ./moq component-get takes components from the server">
                        <check><option key="true" text="${plan.addons.present ? 'Replace' : 'Add'} the repository ${plan.addons.repositoryName}${plan.addons.writable ? '' : ' (the full tier, not on a shared server)'}"/></check></default-field></field>
                    <field name="repositoryName"><default-field title="Repository name"><text-line size="16" default-value="${plan.addons.repositoryName}"/></default-field></field>
                    <field name="defaultRepository"><default-field title="Default repository"><check><option key="true" text="Every component from this server"/></check></default-field></field>
                    <field name="taskSource"><default-field title="Task source" tooltip="Your work items from ${plan.taskSource.path}">
                        <check><option key="true" text="${plan.taskSource.present ? 'Keep' : 'Add'} the server's tasks as your task source${plan.taskSource.app ? ', opening in ' + plan.taskSource.app.title : ''}"/></check></default-field></field>
                    <field name="gateway"><default-field title="LLM gateway" tooltip="${(plan.gateway.lines || []).join('  ')}">
                        <check><option key="true" text="${plan.gateway.available ? 'Write the gateway lines to runtime/.env (a restart applies them)' : 'The server offers no gateway'}"/></check></default-field></field>
                    <field name="gatewayAlias"><default-field title="Model alias"><text-line size="16" default-value="default"/></default-field></field>
                    <field name="gitCredential"><default-field title="Git's credential for ${plan.gitCredential.prefix}">
                        <radio no-current-selected-key="${plan.gitCredential.mode}"><option key="helper" text="Git's own helpers (D5)"/><option key="stored" text="My token from this connection"/></radio></default-field></field>
                    <field name="submitButton"><default-field title="Set"><submit/></default-field></field>
                </form-single>
            </box-body></container-box>
        </widgets></section>

        <container-box id="DevAideSiteBox"><box-header title="Site components"/><box-body>
            <label type="p" text="The components this site owns, comma separated, the first the default target of an extension. Every other component is upstream: read only, and extended from the site component instead of edited."/>
            <form-single name="SiteComponentsForm" transition="setSiteComponents">
                <field name="siteComponents"><default-field title="Site components"><text-line size="50"/></default-field></field>
                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
            </form-single>
        </box-body></container-box>

        <section name="UpstreamSection" condition="full"><widgets>
            <container-box id="DevAideUpstreamBox"><box-header title="Upstream components"/><box-body>
                <label type="p" text="Editing an upstream component in place is a fork: every upgrade of it has to merge your change. Turn this on to work on the framework or an app itself."/>
                <form-single name="UpstreamForm" transition="setUpstreamEdits">
                    <field name="upstreamEdits"><default-field title="Allow editing upstream components">
                        <radio><option key="false" text="No"/><option key="true" text="Yes"/></radio></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-single>
            </box-body></container-box>
        </widgets></section>

        <container-box id="DevAideRootsBox"><box-header title="Roots"/><box-body-nopad>
            <form-list name="RootSettings" list="roots" transition="storeRoot">
                <field name="location"><default-field><hidden default-value="${path}"/></default-field></field>
                <field name="id"><default-field title="Root"><display text="${label} (${kind == 'git' ? 'git' : 'Not a git repository'}${upstream ? ', upstream' : ''})"/></default-field></field>
                <field name="label"><default-field title="Label"><text-line size="16"/></default-field></field>
                <field name="readOnly"><default-field title="Read only"><check><option key="true" text=" "/></check></default-field></field>
                <field name="publishBranch"><default-field title="Publish branch"><text-line size="18"/></default-field></field>
                <field name="publishBranchRequired"><default-field title="Required"><check><option key="true" text=" "/></check></default-field></field>
                <field name="submitButton"><default-field title=""><submit text="Save"/></default-field></field>
                <field name="initGit"><default-field title="">
                    <link url="initRepository" text="Initialize git" parameter-map="{rootId: id}" link-type="hidden-form"
                            condition="kind != 'git' &amp;&amp; full" confirmation="Initialize a git repository in ${path}?"/>
                </default-field></field>
            </form-list>
        </box-body-nopad></container-box>

        <section name="AddRootSection" condition="full"><widgets>
            <container-box id="DevAideAddRootBox"><box-header title="Add a directory"/><box-body>
                <form-single name="AddRootForm" transition="storeRoot">
                    <field name="location"><default-field title="Directory (full path)"><text-line size="50"/></default-field></field>
                    <field name="label"><default-field title="Label"><text-line size="20"/></default-field></field>
                    <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                </form-single>
            </box-body></container-box>
        </widgets></section>

        <section name="SharedSection" condition="info.shared"><widgets>
            <container-box id="DevAideSharedBox"><box-header title="Shared dev server"/><box-body>
                <label type="p" text="On a shared dev server fetch, pull and push are off until an admin enables them; the server's git then uses its own credentials."/>
                <form-single name="NetworkGitForm" transition="setNetworkGit">
                    <field name="networkGit"><default-field title="Network git commands">
                        <radio><option key="N" text="Off"/><option key="Y" text="On"/></radio></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-single>
            </box-body></container-box>
        </widgets></section>

        <section name="TokensSection" condition="info.shared &amp;&amp; admin &amp;&amp; full"><widgets>
            <container-box id="DevAideTokensBox"><box-header title="Git tokens"/><box-body>
                <label type="p" text="With a token stored, fetch, pull and push on that root use it in place of the server's own credentials: a user's own token when they have one, else the root's deploy token. Tokens are kept encrypted and never shown again, and git gives each only to the host it was stored for."/>
                <form-list name="CredentialList" list="credentials" skip-form="true">
                    <field name="rootLabel"><default-field title="Root"><display/></default-field></field>
                    <field name="userId"><default-field title="User"><display text="${userId || 'Deploy token (everyone)'}"/></default-field></field>
                    <field name="username"><default-field title="User name"><display/></default-field></field>
                    <field name="urlPrefix"><default-field title="For"><display text="${urlPrefix || 'no remote: store it again'}"/></default-field></field>
                    <field name="remove"><default-field title="">
                        <link url="deleteCredential" text="Remove" parameter-map="{credentialId: credentialId}" link-type="hidden-form" confirmation="Remove this token?"/>
                    </default-field></field>
                </form-list>
                <form-single name="StoreCredentialForm" transition="storeCredential">
                    <field name="rootId"><default-field title="Root"><drop-down><list-options list="rootOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                    <field name="userId"><default-field title="For user (empty: the root's deploy token)"><text-line size="20"/></default-field></field>
                    <field name="username"><default-field title="User name on the remote"><text-line size="20"/></default-field></field>
                    <field name="token"><default-field title="Token"><password size="30"/></default-field></field>
                    <field name="remoteUrl"><default-field title="Remote URL (empty: the root's origin)"><text-line size="40"/></default-field></field>
                    <field name="submitButton"><default-field title="Save token"><submit/></default-field></field>
                </form-single>
            </box-body></container-box>
        </widgets></section>
    </widgets>
</screen>
