<!-- Repositories (plans/design-dev-aide.md 4.7): every root as ./moq git-status lists it, with Fetch all and Pull all (root
    by root; one that fails is reported and the others go on; a pull reloads what it changed and says when it broke a
    site extension); Get a component through ./moq component-get, Clone a URL into the component directory, and a site
    component from Home. A change to the set of components needs a restart. A list, so the terminal reaches it. Terminal
    opens a shell on the server in the root's directory (the browser terminal's host session, for a user who may). Add
    hosted root makes a root of a repository of this server's git hosting at a branch (4.10), one the user may update:
    edited in the Workspace with each Save a commit, never loaded or run. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Repositories" default-menu-index="3" menu-image="sym_o_folder_data" menu-image-type="icon">

    <transition name="fetchAll"><service-call name="org.moqui.devaide.VcsServices.fetch#All" out-map="done"/>
        <actions><script>for (const row of done.results || []) {
            if (row.ok) ec.message.addMessage(row.label + ': fetched', 'success'); else ec.message.addMessage(row.label + ': ' + row.error, 'warning');
        }</script></actions>
        <default-response url="."/></transition>
    <transition name="pullAll"><service-call name="org.moqui.devaide.VcsServices.pull#All" out-map="done"/>
        <actions><script>for (const row of done.results || []) {
            if (row.ok) ec.message.addMessage(row.label + ': ' + (row.output || 'up to date'), 'success'); else ec.message.addMessage(row.label + ': ' + row.error, 'warning');
        }
        if (done.extensionsAffected) ec.message.addMessage('Extensions affected: ' + done.extensionsAffected + ' (Artifacts, Customizations)', 'warning');</script></actions>
        <default-response url="."/></transition>
    <!-- A component got or cloned is offered for loading now when its load needs no restart (plans/design-dev-aide.md
        4.7); otherwise it loads at the next restart, with the reasons said. -->
    <transition name="getComponent"><service-call name="org.moqui.devaide.VcsServices.get#Component" out-map="got"/>
        <actions><message type="success">${got.loadable ? 'Got ' + name + ': Load it now, or it loads at the next restart' : 'Got ' + name + ': it loads after a restart (Home)' + ((got.restartReasons || []).length ? '; ' + got.restartReasons.join('; ') : '')}</message></actions>
        <default-response url="."><parameter name="loadName" from="got.loadable ? got.componentName : null"/></default-response></transition>
    <transition name="cloneRepository"><service-call name="org.moqui.devaide.VcsServices.clone#Repository" out-map="got"/>
        <actions><message type="success">${got.loadable ? 'Cloned into ' + got.location + ': Load it now, or it loads at the next restart' : 'Cloned into ' + got.location + ': it loads after a restart (Home)' + ((got.restartReasons || []).length ? '; ' + got.restartReasons.join('; ') : '')}</message></actions>
        <default-response url="."><parameter name="loadName" from="got.loadable ? got.componentName : null"/></default-response></transition>
    <transition name="loadComponent"><service-call name="org.moqui.dev.ComponentServices.load#Component" in-map="{componentName: loadName}" out-map="loaded"/>
        <actions><message type="${(loaded.report?.problems || []).length ? 'warning' : 'success'}">${loadName}: ${loaded.report?.status || 'not loaded'}${(loaded.report?.problems || []).length ? '; ' + loaded.report.problems.join('; ') : ''}</message></actions>
        <default-response url="."/></transition>
    <transition name="workspace"><default-response url="../Workspace"/></transition>
    <!-- the drop-down's key is the repository and the branch as a JSON list -->
    <transition name="addHostedRoot"><actions>
            <set field="picked" from="hostedBranch ? JSON.parse(hostedBranch) : []"/>
            <service-call name="org.moqui.devaide.HostedRootServices.store#HostedRoot" out-map="added"
                    in-map="{repositoryId: picked[0], branch: picked[1] || '', label: hostedLabel || ''}"/>
            <message type="success">Hosted root ${picked[0]} at ${picked[1] || 'its default branch'}: open it in the Workspace</message></actions>
        <default-response url="."/></transition>
    <transition name="removeHostedRoot"><service-call name="org.moqui.devaide.HostedRootServices.delete#HostedRoot" in-map="{rootId: rootId}"/>
        <default-response url="."/></transition>

    <parameter name="loadName"/>
    <!-- Add hosted root asks the hosting for the repositories only once it is opened: a call for each repository -->
    <parameter name="addHosted"/>
    <actions>
        <service-call name="org.moqui.devaide.VcsServices.list#Repositories" out-map="found"/>
        <set field="repositories" from="found.repositories || []"/>
        <service-call name="org.moqui.devaide.VcsServices.get#Addons" out-map="addonsOut"/>
        <set field="addonOptions" from="(addonsOut.addons || []).filter((addon) => !addon.here).map((addon) => ({key: addon.name, text: addon.name}))"/>
        <set field="full" from="ec.user.hasPermission('DEV_AIDE')" type="Boolean"/>
        <set field="extend" from="full || ec.user.hasPermission('DEV_AIDE_EXTEND')" type="Boolean"/>
        <!-- the hosting's repositories this user may update, each branch an option (none without the git services) -->
        <set field="hostedOptions" from="[]"/>
        <script>if (extend &amp;&amp; addHosted == 'true') {
            const listed = ec.service.sync().name('org.moqui.devaide.HostedRootServices.get#HostedRepositories').call() || {}
            for (const repository of listed.repositories || []) for (const branch of (repository.branches.length ? repository.branches : [repository.defaultBranch]))
                hostedOptions.push({key: JSON.stringify([repository.repositoryId, branch]), text: repository.repositoryId + ' · ' + branch + (repository.description ? ' (' + repository.description + ')' : '')})
        }</script>
    </actions>
    <widgets>
        <container-row><row-col md="8">
            <label text="${repositories.length} roots${found.gitAvailable ? '' : ': no git on the server, so every root is shown as plain'}" type="p"/>
        </row-col><row-col md="4" style="text-right">
            <link url="fetchAll" text="Fetch all" link-type="hidden-form" btn-type="default"/>
            <link url="pullAll" text="Pull all" link-type="hidden-form" btn-type="primary" confirmation="Pull every repository, fast-forward only?"/>
        </row-col></container-row>
        <form-list name="RepositoryList" list="repositories" skip-form="true">
            <!-- the row's own path (an absolute directory) is not Workspace's path (a file in the root): the empty value leaves it out -->
            <field name="label"><default-field title="Root">
                <link url="workspace" text="${label}${upstream ? '' : ' (site)'}" parameter-map="{rootId: rootId, path: ''}" link-type="anchor"/></default-field></field>
            <field name="kind"><default-field title="Kind"><display text="${kind == 'git' ? 'git' : kind == 'hosted' ? 'hosted' : 'plain'}"/></default-field></field>
            <field name="components"><default-field title="Components"><display/></default-field></field>
            <field name="branch"><default-field title="Branch"><display text="${branch || ''}${upstream ? ' → ' + upstream : ''}"/></default-field></field>
            <field name="ahead"><default-field title="↑ ↓"><display text="${kind == 'git' &amp;&amp; upstream ? ahead + ' / ' + behind : ''}"/></default-field></field>
            <field name="changes"><default-field title="Changes"><display text="${changes == null ? '' : changes}"/></default-field></field>
            <field name="lastFetch"><default-field title="Last fetch"><display text="${lastFetch ? new Date(lastFetch * 1000).toISOString().slice(0, 16).replace('T', ' ') : ''}"/></default-field></field>
            <field name="path"><default-field title="Path"><display/></default-field></field>
            <!-- a shell on the server in the root's directory (plans/Terminal-Fancy.md §7.1, P9), for a user who may open one -->
            <field name="terminal"><conditional-field condition="kind == 'hosted'" title="">
                <link url="removeHostedRoot" text="Remove" link-type="hidden-form" btn-type="danger" parameter-map="{rootId: rootId}"
                        confirmation="Take ${label} out of the Workspace? The repository stays as it is."/></conditional-field>
                <default-field title="">
                <link url="/qapps/Terminal" url-type="plain" text="Terminal" link-type="anchor" icon="sym_o_terminal"
                        parameter-map="{openHost: 'shell', directory: path}" tooltip="Open a terminal here"/></default-field></field>
        </form-list>

        <section name="LoadSection" condition="full &amp;&amp; loadName"><widgets>
            <container-box id="DevLoadComponentBox"><box-header title="Load ${loadName} now"/><box-body>
                <label type="p" text="It needs no restart: its entities, services, screens and conf load on this server, with its seed, seed-initial and install data."/>
                <link url="loadComponent" text="Load" link-type="hidden-form" btn-type="primary" parameter-map="{loadName: loadName}"/>
            </box-body></container-box>
        </widgets></section>
        <section name="HostedSection" condition="extend"><widgets>
            <container-box id="DevAddHostedRootBox"><box-header title="Add hosted root"/><box-body>
                <label type="p" text="A repository of this server's git hosting at a branch, edited in the Workspace: each Save is a commit to the branch as you, which the repository's rights and branch rules allow or refuse. It is not loaded or run."/>
                <section name="HostedClosed" condition="addHosted != 'true'"><widgets>
                    <link url="." text="Choose a repository" link-type="anchor" parameter-map="{addHosted: 'true'}"/>
                </widgets></section>
                <section name="HostedNone" condition="addHosted == 'true' &amp;&amp; !hostedOptions.length"><widgets>
                    <label type="p" text="No repository of this server's hosting that you may update."/>
                </widgets></section>
                <section name="HostedForm" condition="hostedOptions.length"><widgets>
                <form-single name="AddHostedRootForm" transition="addHostedRoot">
                    <field name="hostedBranch"><default-field title="Repository and branch"><drop-down allow-empty="false">
                        <list-options list="hostedOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                    <field name="hostedLabel"><default-field title="Label (the repository and branch when empty)"><text-line size="30"/></default-field></field>
                    <field name="submitButton"><default-field title="Add hosted root"><submit/></default-field></field>
                </form-single>
                </widgets></section>
            </box-body></container-box>
        </widgets></section>
        <section name="AddSection" condition="full"><widgets>
            <container-box id="DevGetComponentBox"><box-header title="Get a component"/><box-body>
                <section name="MoqSection" condition="found.moqAvailable"><widgets>
                    <form-single name="GetComponentForm" transition="getComponent">
                        <field name="name"><default-field title="Component (addons.xml)"><drop-down allow-empty="false">
                            <list-options list="addonOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                        <field name="dev"><default-field title="Into runtime/components/dev (dev only)"><check><option key="true" text=" "/></check></default-field></field>
                        <field name="test"><default-field title="Into runtime/components/test (test only)"><check><option key="true" text=" "/></check></default-field></field>
                        <field name="submitButton"><default-field title="Get"><submit/></default-field></field>
                    </form-single>
                </widgets><fail-widgets><label type="p" text="This runtime has no ./moq beside it: clone a URL instead."/></fail-widgets></section>
                <form-single name="CloneForm" transition="cloneRepository">
                    <field name="url"><default-field title="Clone a URL"><text-line size="50"/></default-field></field>
                    <field name="name"><default-field title="Directory (from the URL when empty)"><text-line size="20"/></default-field></field>
                    <field name="dev"><default-field title="Into runtime/components/dev (dev only)"><check><option key="true" text=" "/></check></default-field></field>
                    <field name="test"><default-field title="Into runtime/components/test (test only)"><check><option key="true" text=" "/></check></default-field></field>
                    <field name="submitButton"><default-field title="Clone"><submit/></default-field></field>
                </form-single>
                <label type="p" text="A new site component is made from Home. A component got or cloned is offered to Load now when it needs no restart; otherwise it loads after a restart."/>
            </box-body></container-box>
        </widgets></section>
    </widgets>
</screen>
