<!-- The Workspace page: loads the client (/devstatic/DevAide.js, with js/WebrootCode.js) and mounts m-dev-workspace on
    this screen's path, whose transitions answer it; the query (rootId, path, line) opens a file. -->
<template><div class="m-dev-workspace-page">
    <m-dev-workspace v-if="ready" :base="mScreen.path" :query="mScreen.parameters"></m-dev-workspace>
    <div v-else class="q-pa-md m-muted" id="DevWorkspaceLoading">{{failed || 'Loading the Workspace…'}}</div>
</div></template>

<script>
module.exports = {
    inject: { mScreen: { default: null } },
    data() { return { ready: false, failed: '' }; },
    mounted() {
        const moqui = window.moqui;
        moqui.loadScript('/devstatic/DevAide.js', null, () => !!(moqui.devAide && moqui.devAide.components))
            .then(() => moqui.devAide.start())
            .then(() => { this.ready = true; }, (err) => { this.failed = 'The Workspace could not load: ' + (err && err.message || err); });
    }
};
</script>
