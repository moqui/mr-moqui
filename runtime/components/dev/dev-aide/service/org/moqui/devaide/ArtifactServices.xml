<!-- The framework's artifact index (plans/design-dev-aide.md 7, F11) as the dev-aide shows it: each artifact with the root
    and path that open it in the Workspace and whether it is the site's or upstream. The view tier and above. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-service-definition.xsd">
    <service verb="search" noun="Artifacts" type="rust" location="dev_aide::artifacts::search_artifacts" allow-remote="false" read-only="true">
        <description>The artifacts whose names match a text, best first (OrdHdr, place#Order), by kind and component.</description>
        <in-parameters>
            <parameter name="text"/>
            <parameter name="kinds" type="Object"/>
            <parameter name="components" type="Object"/>
            <parameter name="limit" type="Integer" default-value="50"/>
        </in-parameters>
        <out-parameters><parameter name="artifacts" type="List"/></out-parameters>
    </service>
    <service verb="get" noun="ArtifactDetail" type="rust" location="dev_aide::artifacts::get_artifact_detail" allow-remote="false" read-only="true">
        <description>An artifact with its origin: where it is defined and each extension of it, the site's first; the counts of what uses it and what it uses.</description>
        <in-parameters><parameter name="artifactId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="artifact" type="Map"/>
            <parameter name="extensions" type="List"/>
            <parameter name="usedByCount" type="Integer"/>
            <parameter name="usesCount" type="Integer"/>
        </out-parameters>
    </service>
    <service verb="get" noun="Refs" type="rust" location="dev_aide::artifacts::get_refs" allow-remote="false" read-only="true">
        <description>What uses an artifact (direction in) or what it uses (out), static and observed, grouped by kind.</description>
        <in-parameters>
            <parameter name="artifactId" required="true"/>
            <parameter name="direction" default-value="in"/>
            <parameter name="kinds" type="Object"/>
        </in-parameters>
        <out-parameters>
            <parameter name="artifact" type="Map"/>
            <parameter name="groups" type="List"/>
            <parameter name="refs" type="List"/>
        </out-parameters>
    </service>
    <service verb="get" noun="ArtifactBrowse" type="rust" location="dev_aide::browser::get_artifact_browse" allow-remote="false" read-only="true">
        <description>The Artifact Browser's graph for the terminal (Artifacts/BrowseTui): the artifact with its lines and links,
            what uses it and what it uses in sections by the other side's kind, the kinds there are, and the filter applied.
            The framework's own artifacts are hidden unless the artifact is one of them or hideFramework says. An artifact
            not in the index answers a null center and a message.</description>
        <in-parameters>
            <parameter name="artifactId" required="true"/>
            <parameter name="kinds" type="Object"/>
            <parameter name="hideFramework"/>
            <parameter name="observed"/>
            <parameter name="staticLinks"/>
        </in-parameters>
        <out-parameters>
            <parameter name="center" type="Map"/>
            <parameter name="usedBy" type="List"/>
            <parameter name="uses" type="List"/>
            <parameter name="kinds" type="List"/>
            <parameter name="filter" type="Map"/>
            <parameter name="message"/>
        </out-parameters>
    </service>
    <service verb="get" noun="Definition" type="rust" location="dev_aide::artifacts::get_definition" allow-remote="false" read-only="true">
        <description>Go to definition: the artifact the reference at a line of a file names (the one naming word), with where it opens.</description>
        <in-parameters>
            <parameter name="rootId" required="true"/>
            <parameter name="path" required="true"/>
            <parameter name="line" type="Integer" required="true"/>
            <parameter name="word"/>
        </in-parameters>
        <out-parameters><parameter name="reference" type="Map"/><parameter name="artifact" type="Map"/></out-parameters>
    </service>
    <service verb="get" noun="ArtifactsInFile" type="rust" location="dev_aide::artifacts::get_artifacts_in_file" allow-remote="false" read-only="true">
        <description>The artifacts a file of a root defines at its top (a screen, an entity file's entities, a service file's
            services), in file order, each with where it opens; none for a file the index does not have.</description>
        <in-parameters>
            <parameter name="rootId" required="true"/>
            <parameter name="path" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="artifacts" type="List"/></out-parameters>
    </service>
    <service verb="get" noun="Customizations" type="rust" location="dev_aide::artifacts::get_customizations" allow-remote="false" read-only="true">
        <description>Every extension the site components make (extend-entity, screen-extend and its anchors, ECA rules on
            upstream services and entities), with whether what it extends is there: the upgrade checklist after a pull.</description>
        <out-parameters>
            <parameter name="extensionCount" type="Integer"/>
            <parameter name="brokenCount" type="Integer"/>
            <parameter name="extensions" type="List"/>
            <parameter name="siteComponents" type="List"/>
        </out-parameters>
    </service>
    <!-- Convert to site extension (plans/design-dev-aide.md 7.2, question 16), src/dbform.rs: a DbForm that modifies a
        screen form becomes the form merge of the site's screen-extend of that screen, one way. -->
    <service verb="get" noun="DbFormChanges" type="rust" location="dev_aide::dbform::get_db_form_changes" allow-remote="false" read-only="true">
        <description>The DbForms that modify a screen form (modifyXmlScreenForm): formId, description, screenLocation,
            formName, userGroups and fieldCount, the rows Customizations offers Convert on.</description>
        <out-parameters><parameter name="dbForms" type="List"/></out-parameters>
    </service>
    <service verb="get" noun="DbFormConversion" type="rust" location="dev_aide::dbform::get_db_form_conversion" allow-remote="false" read-only="true">
        <description>The conversion of a DbForm to review: the site's screen-extend file it writes (rootId, path, exists),
            its text now and converted with the diff, the rows that go (each entity and its count), what is not carried
            (notes: the user groups, a dated form's drafts and history, the print layout) and the digest convert#DbForm
            takes. Refused for a DbForm with responses, one that modifies no screen form, or with no site component.</description>
        <in-parameters><parameter name="formId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="rootId"/>
            <parameter name="path"/>
            <parameter name="component"/>
            <parameter name="exists" type="Boolean"/>
            <parameter name="currentText"/>
            <parameter name="proposedText"/>
            <parameter name="diff"/>
            <parameter name="rows" type="List"/>
            <parameter name="notes" type="List"/>
            <parameter name="digest"/>
        </out-parameters>
    </service>
    <service verb="convert" noun="DbForm" type="rust" location="dev_aide::dbform::convert_db_form" allow-remote="false">
        <description>The accepted conversion: when the digest is still the review's, the DbForm's rows are deleted and
            the screen-extend written through the save pipeline in one transaction (a refused or conflicting write keeps
            the rows). Audited (DAA_CONVERT, and the file's save). Out as a save, with the deleted rows' counts.</description>
        <in-parameters>
            <parameter name="formId" required="true"/>
            <parameter name="digest" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="rootId"/>
            <parameter name="path"/>
            <parameter name="deleted" type="Map"/>
            <parameter name="hash"/>
            <parameter name="problems" type="List"/>
        </out-parameters>
    </service>
    <service verb="search" noun="Palette" type="rust" location="dev_aide::artifacts::search_palette" allow-remote="false" read-only="true">
        <description>The shell palette's Artifacts group: entities, services, screens and rules matching the text.</description>
        <in-parameters>
            <parameter name="text"/>
            <parameter name="limit" type="Integer"/>
            <parameter name="docTypes" type="Object"/>
        </in-parameters>
        <out-parameters><parameter name="rows" type="List"/><parameter name="moreUrl"/></out-parameters>
    </service>
</services>
