<!-- Test data of @Title@: records for trying the apps by hand. Its type is its own (@package@-test): a load of every type
    (./moq load with no types, the test database) reads it, a load of chosen types (./moq load seed demo, a production
    load) leaves it out, and the tool's screen loads it again (load#TestData). -->
<entity-facade-xml type="@package@-test">
    <moqui.basic.EnumerationType enumTypeId="@Class@Test" description="@Title@ Test"/>
    <moqui.basic.Enumeration enumId="@ID@_TEST_1" enumTypeId="@Class@Test" sequenceNum="1" description="First test record"/>
    <moqui.basic.Enumeration enumId="@ID@_TEST_2" enumTypeId="@Class@Test" sequenceNum="2" description="Second test record"/>
</entity-facade-xml>
