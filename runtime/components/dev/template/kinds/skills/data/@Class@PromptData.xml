<!-- The prompts of @Title@: chips the Assist drawer suggests (docs/ai/Assist.md, GET prompts) on the pages whose /apps path
    matches screenPathPattern (a regular expression over the whole path), for the agent agentId. sendMode prefill puts
    the text in the composer; send sends it at once. -->
<entity-facade-xml type="seed">
    <moqui.agent.AgentSuggestedPrompt promptId="@ID@_PROMPT_1" agentId="assist" label="@Title@"
            promptText="Help me with @Title@ on this page." sendMode="prefill" screenPathPattern="/apps/.*" sequenceNum="50"/>
</entity-facade-xml>
