<!-- Seed data of @Title@: what every instance needs, loaded at setup and again on each load of seed data. A seed record
    is configuration (types, statuses, settings), not business data. Here an enumeration type and its values. -->
<entity-facade-xml type="seed">
    <moqui.basic.EnumerationType enumTypeId="@Class@Kind" description="@Title@ Kind"/>
    <moqui.basic.Enumeration enumId="@ID@_KIND_STANDARD" enumTypeId="@Class@Kind" enumCode="STANDARD" sequenceNum="1" description="Standard"/>
    <moqui.basic.Enumeration enumId="@ID@_KIND_SPECIAL" enumTypeId="@Class@Kind" enumCode="SPECIAL" sequenceNum="2" description="Special"/>
</entity-facade-xml>
