<!-- Who may call the services of @Title@ (service/@package@/@Class@Services.xml): all of them, by the package's name
    pattern, for the ADMIN group. -->
<entity-facade-xml type="seed">
    <artifactGroups artifactGroupId="@ID@_SERVICES" description="@Title@ services">
        <artifacts artifactName="@package@\..*" nameIsPattern="Y" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
        <authz artifactAuthzId="@ID@_SERVICES_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
</entity-facade-xml>
