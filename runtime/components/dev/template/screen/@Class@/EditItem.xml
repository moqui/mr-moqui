<!-- One item: its name and description, saved with update#Item. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Item" default-menu-include="false">

    <parameter name="itemId" required="true"/>

    <transition name="updateItem"><service-call name="@package@.@Class@Services.update#Item"/>
        <default-response url="."/></transition>
    <transition name="findItem"><default-response url="../FindItem"/></transition>

    <actions>
        <entity-find-one entity-name="@package@.@Class@Item" value-field="item"/>
    </actions>
    <widgets>
        <link url="findItem" text="All items" link-type="anchor" icon="sym_o_arrow_back"/>
        <section name="ItemSection" condition="item"><widgets>
            <form-single name="ItemForm" map="item" transition="updateItem">
                <field name="itemId"><default-field title="ID"><display/></default-field></field>
                <field name="itemName"><default-field title="Name"><text-line size="40"/></default-field></field>
                <field name="description"><default-field><text-area rows="5" cols="60"/></default-field></field>
                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
            </form-single>
        </widgets><fail-widgets>
            <label type="p" text="No item ${itemId}"/>
        </fail-widgets></section>
    </widgets>
</screen>
