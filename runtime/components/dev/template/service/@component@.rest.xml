<!-- The REST API of @Title@, at /rest/s1/@component@ (data/@Class@ApiSecurityData.xml says who may call it).
    GET=find, POST=create, PATCH=update. -->
<resource xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/rest-api-3.xsd"
        name="@component@" displayName="@Title@ REST API" version="1.0.0" description="The items of @Title@.">
    <!-- curl -u john.doe:moqui http://localhost:8080/rest/s1/@component@/items -->
    <resource name="items" description="Items">
        <method type="get"><entity name="@package@.@Class@Item" operation="list"/></method>
        <method type="post"><service name="@package@.@Class@Services.create#Item"/></method>
        <id name="itemId">
            <method type="get"><entity name="@package@.@Class@Item" operation="one"/></method>
            <method type="patch"><service name="@package@.@Class@Services.update#Item"/></method>
        </id>
    </resource>
</resource>
