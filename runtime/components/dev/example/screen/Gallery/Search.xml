<!-- A find screen over moqui.example.Example: a one-field search (anyField, matched against part of the name), a dialog
    with a country and a state drop-down whose states depend on the country (dynamic-options on moqui.basic.Geo through
    BasicServices.get#GeoRegionsForDropDown), and a New dialog whose service requires a name and a description, which
    creates the example and opens EditExample. Unlike most of the gallery it writes: the examples it creates. The scripted
    TUI gate (crates/moqui-host/tests/tui_screens.rs, drive_search_dialog) drives it. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Search" default-menu-include="false">

    <transition name="editExample"><default-response url="../EditExample"/></transition>
    <transition name="createExample"><service-call name="example.ExampleServices.create#GalleryExample"/>
        <default-response url="../EditExample"/></transition>
    <transition name="addAddress"><actions>
        <message type="success">Address in ${stateProvinceGeoId || ''} ${countryGeoId || ''} added (gallery demo: nothing is written)</message>
    </actions><default-response url="."/></transition>
    <transition name="getGeoCountryStates"><service-call name="org.moqui.impl.BasicServices.get#GeoRegionsForDropDown"
            in-map="{geoId:countryGeoId, term:term}" web-send-json-response="resultList"/>
        <default-response type="none"/></transition>

    <actions>
        <set field="anyFieldLike" from="anyField ? '%' + String(anyField).trim() + '%' : null"/>
    </actions>
    <widgets>
        <container style="row items-center q-gutter-sm q-mx-sm q-mb-xs">
            <label text="Examples" type="h5" style="q-my-none"/>
            <container style="col"/>
            <container-dialog id="NewExampleDialog" button-text="New example">
                <form-single name="NewExampleForm" transition="createExample">
                    <field name="exampleName"><default-field title="Name"><text-line size="30"/></default-field></field>
                    <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                    <field name="exampleTypeEnumId"><default-field title="Type">
                        <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                            <entity-find entity-name="moqui.basic.Enumeration" cache="true"><econdition field-name="enumTypeId" value="ExampleType"/>
                                <order-by field-name="sequenceNum"/></entity-find></entity-options></drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            <container-dialog id="NewAddressDialog" button-text="New address">
                <form-single name="NewAddressForm" transition="addAddress">
                    <field name="address1"><default-field title="Address"><text-line size="30"/></default-field></field>
                    <field name="city"><default-field title="City"><text-line size="20"/></default-field></field>
                    <field name="countryGeoId"><default-field title="Country">
                        <drop-down no-current-selected-key="USA"><entity-options key="${geoId}" text="${geoName}">
                            <entity-find entity-name="moqui.basic.Geo" list="geoList">
                                <econdition field-name="geoTypeEnumId" value="GEOT_COUNTRY"/>
                                <order-by field-name="geoName"/></entity-find>
                        </entity-options></drop-down>
                    </default-field></field>
                    <field name="stateProvinceGeoId"><default-field title="State">
                        <drop-down><dynamic-options transition="getGeoCountryStates" value-field="geoId">
                            <depends-on field="countryGeoId"/></dynamic-options></drop-down>
                    </default-field></field>
                    <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>

        <form-single name="SearchForm" transition="." focus-field="anyField">
            <field name="anyField"><default-field title="" tooltip="Matches part of the name"><text-line size="40"/></default-field></field>
            <field name="submitButton"><default-field title="Search"><submit/></default-field></field>
            <field-layout><field-row-big><field-ref name="anyField"/><field-ref name="submitButton"/></field-row-big></field-layout>
        </form-single>

        <form-list name="ExampleList" list="exampleList" skip-form="true">
            <entity-find entity-name="moqui.example.Example" list="exampleList">
                <search-form-inputs default-order-by="exampleName,exampleId"/>
                <econdition field-name="exampleName" operator="like" from="anyFieldLike" ignore-case="true" ignore-if-empty="true"/>
            </entity-find>
            <field name="exampleId"><header-field title="ID" show-order-by="true"/>
                <default-field><link url="editExample" text="${exampleId}"/></default-field></field>
            <field name="exampleName"><header-field title="Name" show-order-by="true"/><default-field><display/></default-field></field>
            <field name="exampleTypeEnumId"><header-field title="Type"/>
                <default-field><display-entity entity-name="moqui.basic.Enumeration"/></default-field></field>
            <field name="description"><header-field title="Description"/><default-field><display/></default-field></field>
        </form-list>
    </widgets>
</screen>
