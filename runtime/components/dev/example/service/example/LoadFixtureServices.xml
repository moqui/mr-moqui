<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <!-- A fixture of runtime/components/base/tools/test/LoadRunner.spec.js (a dev component, not on a production server):
        a service that does what a service must not, disable authorization and never enable it again. The call's own
        scope ends it (service/call.rs), so the spec can show that the load user's next call is still authorized. -->
    <service verb="leave" noun="AuthzDisabled">
        <actions><script>ec.artifactExecution.disableAuthz()</script></actions>
    </service>
    <!-- A call that leaves its caller's context logged out, with the caller's own account disabled, so a fresh login for
        it fails: the spec puts the account back. It changes nothing else but the caller's own context. -->
    <service verb="leave" noun="LoggedOutAccountDisabled">
        <actions><script><![CDATA[
            const wasDisabled = ec.artifactExecution.disableAuthz()
            try {
                const account = ec.entity.find('moqui.security.UserAccount').condition('userId', ec.user.userId).one()
                account.disabled = 'Y'
                account.update()
            } finally {
                if (!wasDisabled) ec.artifactExecution.enableAuthz()
            }
            ec.user.logoutLocal()
        ]]></script></actions>
    </service>
</services>
