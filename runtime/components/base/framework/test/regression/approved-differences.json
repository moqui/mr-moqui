    {
      "table": "public.localized_message",
      "key": {
        "original": "UomNameTemplate",
        "locale": "default"
      },
      "field": "localized",
      "validator": "elvis_or",
      "java": "${description?:''} (${abbreviation?:uomId})"
    },
    {
      "table": "public.localized_message",
      "key": {
        "original": "UsernameTemplate",
        "locale": "default"
      },
      "field": "localized",
      "validator": "elvis_or",
      "java": "${userFullName ?: (lastName ? (firstName ? firstName + ' ' : '') + lastName : '')} [${username?:userId?:''}]"
