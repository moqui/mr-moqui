<!-- The ScreenOffer spec's screen offered only under another appRoot (test only, never mounted): its own condition, with no
    fail-widgets, leaves it out of its parent's tabs, and a request naming it runs none of its actions. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        require-authentication="false" default-menu-title="Hidden screen">
    <condition><expression>appRoot == 'Elsewhere'</expression></condition>
    <actions><script>ec.message.addError('The hidden screen actions ran')</script></actions>
    <widgets><label text="Hidden screen widgets"/></widgets>
</screen>
