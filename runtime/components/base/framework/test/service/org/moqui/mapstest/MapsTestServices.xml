<!-- For moqui test runs only (test/MoquiConf.xml registers this file): a map adapter for the MapsConfig spec, which registers
    it as a moqui.maps.MapAdapter row of its own and grants it. Its records are its recordKey's recordId: LOCATED has a
    point, DENIED is refused as an adapter refuses a record the caller may not read, and any other fails. Its layer answers
    two features more than the limit it is given, and says it is not truncated, so the caller's own cut is what the spec
    sees; each layer it is asked for is kept (cache moqui.test.maps.asked), so the spec sees a hidden layer was not asked.
    get#UngrantedContext is a second adapter's, which the spec grants to no one: it keeps that it ran, which it must not. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-service-definition.xsd">
    <service verb="get" noun="RecordMapContext">
        <implements service="org.moqui.maps.MapServices.get#RecordMapContext"/>
        <actions>
            <set field="recordId" from="String(recordKey?.recordId ?? '')"/>
            <if condition="recordId == 'DENIED'"><set field="reasonCode" value="PERMISSION_DENIED"/><return/></if>
            <if condition="recordId != 'LOCATED'"><return error="true" message="The spec record ${recordId} cannot be read"/></if>
            <set field="label" value="Spec place"/>
            <set field="geometry" from="{type: 'Point', coordinates: [-87.6298, 41.8781]}"/>
            <set field="precisionEnumId" value="GPP_POSTAL_AREA"/>
            <set field="sourceText" value="Spec data set"/>
            <set field="recordVersion" value="1"/>
            <set field="permittedActions" from="['view']"/>
            <set field="links" from="[{label: 'Spec record', route: 'specRecord', parameters: {recordId}}]"/>
        </actions>
    </service>
    <service verb="find" noun="LayerFeatures">
        <implements service="org.moqui.maps.MapServices.find#LayerFeatures"/>
        <actions>
            <script>ec.cache.getCache('moqui.test.maps.asked').put(String(layerId), 'Y')</script>
            <set field="features" from="[]"/>
            <script>for (let index = 0; index &lt; limit + 2; index++) features.push({featureId: 'F' + index, label: 'Feature ' + index,
                geometry: {type: 'Point', coordinates: [index % 180, 10]}})</script>
            <set field="truncated" from="false"/>
        </actions>
    </service>
    <service verb="get" noun="UngrantedContext">
        <implements service="org.moqui.maps.MapServices.get#RecordMapContext"/>
        <actions>
            <script>ec.cache.getCache('moqui.test.maps.asked').put('UNGRANTED', 'Y')</script>
            <set field="label" value="UNGRANTED-SECRET"/>
            <set field="geometry" from="{type: 'Point', coordinates: [1, 1]}"/>
        </actions>
    </service>
</services>
