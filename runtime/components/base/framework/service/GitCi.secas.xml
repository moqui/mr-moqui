<!-- Pipelines follow merge requests (docs/interfaces/Pipelines.md "Events"): every change of a merge request goes through
    org.moqui.git.GitReviewServices.queue#MergeRequestEvent (opened, synchronize for a new head, reopened, ready),
    whoever made it: of a branch, of a fork and of a push to refs/for, and of a hidden merge request, for which the
    service sends no webhook and still runs. So the engine queues its merge-request pipelines after it, with
    authorization disabled as the event itself is queued. Not after an event that was refused (a caller without the
    update right): nothing happened to the merge request. The pushes and tags are a gitECA rule (Git.gitecas.xml). -->
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <seca id="GitCiQueueMergeRequestRuns" service="org.moqui.git.GitReviewServices.queue#MergeRequestEvent" when="post-service">
        <condition><expression>action == 'opened' || action == 'synchronize' || action == 'reopened' || action == 'ready'</expression></condition>
        <actions><service-call name="org.moqui.git.GitCiServices.queue#MergeRequestRuns"
                in-map="{mergeRequestId: mergeRequestId, action: action}" disable-authz="true"/></actions>
    </seca>
</secas>
