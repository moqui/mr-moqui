<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-service-definition.xsd">
    <service verb="clean" noun="TelemetryData" type="rust" location="moqui_core::telemetry::clean" transaction="ignore">
        <description>Apply each configured telemetry retention independently. A failed index is logged and the remaining indexes continue.</description>
        <out-parameters><parameter name="deleted" type="Long"/><parameter name="droppedPartitions" type="Long"/>
            <parameter name="failed" type="Long"/></out-parameters>
    </service>
    <service verb="partition" noun="TelemetryTables" type="rust" location="moqui_core::telemetry::partition_tables" transaction="ignore">
        <description>With search-facade postgres partition-telemetry="true", move each telemetry table made before it was on
            (or only index) into a day-partitioned table: rows are copied a day at a time, then the new table is swapped in
            under a short lock. The old table is kept as &lt;table&gt;_unpartitioned to drop. A failed table is logged and
            listed, and the others go on.</description>
        <in-parameters><parameter name="index"><description>otel_spans, otel_logs, otel_metrics or monitor_annotations; empty is all.</description></parameter></in-parameters>
        <out-parameters><parameter name="moved" type="Long"/><parameter name="rows" type="Long"/>
            <parameter name="kept" type="List"/><parameter name="failed" type="List"/></out-parameters>
    </service>
    <service verb="rollup" noun="Metrics" type="rust" location="moqui_core::telemetry::rollup" transaction="ignore">
        <description>Roll minute metrics into hours and hours into days, with deterministic document ids for safe retries.</description>
        <out-parameters><parameter name="written" type="Long"/><parameter name="failed" type="Long"/></out-parameters>
    </service>
    <service verb="scrape" noun="Targets" type="rust" location="moqui_core::telemetry::scrape_targets" transaction="ignore">
        <description>Scrape each enabled moqui.monitor.ScrapeTarget whose interval has passed into otel_metrics, or targetId now.
            A failed target is logged and recorded on its row, and the others are still scraped.</description>
        <in-parameters><parameter name="targetId"/></in-parameters>
        <out-parameters><parameter name="scraped" type="Long"/><parameter name="failed" type="Long"/><parameter name="written" type="Long"/></out-parameters>
    </service>
    <service verb="run" noun="Checks" type="rust" location="moqui_core::telemetry::run_checks" transaction="ignore">
        <description>Run each enabled moqui.monitor.SyntheticCheck whose interval has passed, or checkId now. Each is a root span
            (moqui.synthetic.check) kept whatever the sample ratio; a failed check is an error span, logged, and recorded on its row.</description>
        <in-parameters><parameter name="checkId"/></in-parameters>
        <out-parameters><parameter name="run" type="Long"/><parameter name="failed" type="Long"/><parameter name="traceId"/></out-parameters>
    </service>
    <service verb="store" noun="ScrapeTarget">
        <description>Create or update a moqui.monitor.ScrapeTarget (System › Monitor › Checks). allowPrivateNetwork Y lets it
            reach loopback and private addresses; setting Y, or changing the URL of a target that has it, needs
            MONITOR_PRIVATE_NETWORK.</description>
        <in-parameters>
            <parameter name="targetId" required="true"/><parameter name="url"/><parameter name="serviceName"/>
            <parameter name="intervalSeconds" type="Integer"/><parameter name="timeoutSeconds" type="Integer"/>
            <parameter name="bearerToken"/><parameter name="enabled"/><parameter name="allowPrivateNetwork"/>
        </in-parameters>
        <out-parameters><parameter name="targetId"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/monitor/TelemetryTargets.js').execute('storeTarget', context))</script></actions>
    </service>
    <service verb="store" noun="SyntheticCheck">
        <description>Create or update a moqui.monitor.SyntheticCheck, with the allowPrivateNetwork rule of store#ScrapeTarget.</description>
        <in-parameters>
            <parameter name="checkId" required="true"/><parameter name="name"/><parameter name="url"/><parameter name="method"/>
            <parameter name="expectStatus" type="Integer"/><parameter name="expectBodyContains"/>
            <parameter name="intervalSeconds" type="Integer"/><parameter name="timeoutSeconds" type="Integer"/>
            <parameter name="enabled"/><parameter name="allowPrivateNetwork"/>
        </in-parameters>
        <out-parameters><parameter name="checkId"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/monitor/TelemetryTargets.js').execute('storeCheck', context))</script></actions>
    </service>
</services>
