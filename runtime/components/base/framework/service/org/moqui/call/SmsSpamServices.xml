<!-- The spam filter of texts from outside numbers, and the blocks that keep a text out of sight (plans/Comms-Messaging.md
    §18.3 phase 11; docs/interfaces/SMS.md "Blocked numbers and spam"). The logic is SmsSpam.js beside this file.
    judge#SmsText and note#SmsJudged are internal (receive#Sms); Not spam, Report spam and the banner's reasons act for a
    current member of the phone room; the filter's settings and rules need VoiceAdmin. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="judge" noun="SmsText" allow-remote="false" authenticate="false">
        <description>Internal (receive#Sms, in a transaction of its own, before ensure#PairRoom): the filters a text from
            theirNumber to ourNumber on chatBridgeId puts on the users our number reaches: memberFilterMap (userId to
            CmfBlocked for a user with the sender on their Blocked list, in a pair room; CmfSpam for the others whose filter is
            on, when the text is spam), spam, score, reasons (the rules it matched) and judged (false when it was not
            judged: the filter off, a room with a message of ours, a trusted or known number). groupNumbers: a group text's
            numbers; pairNumber: the pair room's number when it is not the sender's.</description>
        <in-parameters>
            <parameter name="chatBridgeId" required="true"/>
            <parameter name="ourNumber" required="true"/>
            <parameter name="theirNumber" required="true"/>
            <parameter name="pairNumber"/>
            <parameter name="groupNumbers" type="List"/>
            <parameter name="text" allow-html="any"/>
        </in-parameters>
        <out-parameters>
            <parameter name="memberFilterMap" type="Map"/>
            <parameter name="spam" type="Boolean"/>
            <parameter name="score" type="Integer"/>
            <parameter name="reasons" type="List"/>
            <parameter name="judged" type="Boolean"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/SmsSpam.js').execute('judge', context))</script></actions>
    </service>

    <service verb="note" noun="SmsJudged" allow-remote="false" authenticate="false">
        <description>Internal (receive#Sms, once a text judged spam was taken and is not a duplicate): its number keeps the
            verdict (SmsSpamNumber: score and the rules, the banner's reasons) and each rule it matched counts it.</description>
        <in-parameters>
            <parameter name="theirNumber" required="true"/>
            <parameter name="score" type="Integer"/>
            <parameter name="reasons" type="List"/>
        </in-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/SmsSpam.js').execute('noteJudged', context))</script></actions>
    </service>

    <service verb="mark" noun="NotSpam">
        <description>Not spam, for a current member of phone room chatRoomId: the room comes back for every member it was
            Spam for, its numbers get the user's not-spam vote (a number with more not-spam votes than spam votes is never
            judged again) and the rules of its last verdict count it.</description>
        <in-parameters><parameter name="chatRoomId" required="true"/></in-parameters>
        <out-parameters><parameter name="reasonCode"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/SmsSpam.js').execute('markNotSpam', context))</script></actions>
    </service>

    <service verb="report" noun="Spam">
        <description>Report spam, for a current member of phone room chatRoomId: a pair room's number goes on the user's
            Blocked list (its calls refused too), a group text's room is blocked for the user; its numbers get the user's spam
            vote, the rules of its last verdict count it, and the room goes to Spam for the other members whose filter is on.
            No provider's report API is used.</description>
        <in-parameters><parameter name="chatRoomId" required="true"/></in-parameters>
        <out-parameters><parameter name="reasonCode"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/SmsSpam.js').execute('reportSpam', context))</script></actions>
    </service>

    <service verb="get" noun="SpamInfo">
        <description>A phone room's banner, for a current member: filtered (spam, blocked or none) and reasons, the
            descriptions of the rules its numbers' last verdict matched.</description>
        <in-parameters><parameter name="chatRoomId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="filtered"/>
            <parameter name="reasons" type="List"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/SmsSpam.js').execute('spamInfo', context))</script></actions>
    </service>

    <service verb="get" noun="SpamFilter">
        <description>The spam filter's settings (VoiceAdmin): settings {smsSpamFilter, smsSpamThreshold, smsSpamLookup,
            smsSpamLookupDays, smsSpamLookupMaxPerDay}, with the defaults, and ruleList (each rule with its counts).</description>
        <out-parameters>
            <parameter name="settings" type="Map"/>
            <parameter name="ruleList" type="List"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/SmsSpam.js').execute('getFilter', context))</script></actions>
    </service>

    <service verb="update" noun="SpamFilter">
        <description>Change the spam filter's settings (VoiceAdmin): smsSpamFilter and smsSpamLookup (true or false), the
            threshold, the lookup's days and its limit a day (empty: the default). A parameter not given stays.</description>
        <in-parameters>
            <parameter name="smsSpamFilter"/>
            <parameter name="smsSpamThreshold"/>
            <parameter name="smsSpamLookup"/>
            <parameter name="smsSpamLookupDays"/>
            <parameter name="smsSpamLookupMaxPerDay"/>
        </in-parameters>
        <out-parameters>
            <parameter name="settings" type="Map"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/SmsSpam.js').execute('updateFilter', context))</script></actions>
    </service>

    <service verb="store" noun="SmsSpamRule">
        <description>Add or change a rule of the spam filter (VoiceAdmin): ruleTypeEnumId (SmsSpamRuleType), pattern
            (plain text: words, a host, a number or a prefix ending in *, a line type), weight (-1000 to 1000), description,
            disabled.</description>
        <in-parameters>
            <parameter name="smsSpamRuleId"/>
            <parameter name="ruleTypeEnumId"/>
            <parameter name="pattern"/>
            <parameter name="weight"/>
            <parameter name="description"/>
            <parameter name="disabled"/>
        </in-parameters>
        <out-parameters>
            <parameter name="smsSpamRuleId"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/SmsSpam.js').execute('storeRule', context))</script></actions>
    </service>

    <service verb="delete" noun="SmsSpamRule">
        <description>Remove a rule of the spam filter (VoiceAdmin).</description>
        <in-parameters><parameter name="smsSpamRuleId" required="true"/></in-parameters>
        <out-parameters><parameter name="reasonCode"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/SmsSpam.js').execute('deleteRule', context))</script></actions>
    </service>

    <service verb="purge" noun="SpamRooms" allow-remote="false" authenticate="anonymous-all">
        <description>Internal (clean#ChatRetention, daily): with the property chat_spam_purge_days above 0 (0, the default,
            keeps everything), the texts older than that in each phone room every current member has in Spam are deleted
            (clean#RoomRetention), each room on its own. purgeDays in place of the property (a one-off run). Out: roomCount,
            deletedCount, failedCount.</description>
        <in-parameters><parameter name="purgeDays" type="Integer"/></in-parameters>
        <out-parameters>
            <parameter name="roomCount" type="Integer"/>
            <parameter name="deletedCount" type="Integer"/>
            <parameter name="failedCount" type="Integer"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/call/SmsSpam.js').execute('purgeSpam', context))</script></actions>
    </service>
</services>
