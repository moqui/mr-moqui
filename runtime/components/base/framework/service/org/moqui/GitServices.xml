<!-- No Java counterpart (MR Moqui). The rules are in framework/xsd/git-eca-3.xsd; guide: docs/interfaces/Git-Hosting.md. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="process" noun="GitEca" type="interface">
        <description>The values a gitECA rule has in its context. A service a rule calls with in-map="context" can
            implement this interface. Which are set depends on the event.</description>
        <in-parameters>
            <parameter name="repositoryId"/>
            <parameter name="source"><description>push, fetch, import or write</description></parameter>
            <parameter name="transport"><description>http, ssh or internal</description></parameter>
            <parameter name="userId"><description>Who pushed or wrote; empty for a fetch by a job</description></parameter>
            <parameter name="updateId"><description>The moqui.resource.GitUpdate of a post event</description></parameter>
            <parameter name="pushOptions" type="List"><description>git push -o options</description></parameter>
            <parameter name="refUpdates" type="List"><description>Every ref of the change</description>
                <parameter name="refUpdate" type="Map">
                    <parameter name="refName"/>
                    <parameter name="refType"><description>branch, tag or other</description></parameter>
                    <parameter name="shortName"/>
                    <parameter name="oldId"/>
                    <parameter name="newId"/>
                    <parameter name="changeType"><description>create, update (a fast-forward), force or delete</description></parameter>
                    <parameter name="isDefaultBranch" type="Boolean"/>
                </parameter>
            </parameter>
            <parameter name="refName"><description>Per-ref events: the ref; commit: the ref it came on</description></parameter>
            <parameter name="refType"/>
            <parameter name="shortName"/>
            <parameter name="oldId"/>
            <parameter name="newId"/>
            <parameter name="changeType"/>
            <parameter name="isDefaultBranch" type="Boolean"/>
            <parameter name="newCommitIds" type="List"><description>ref-update and pre-ref-update: the commits the ref
                gained, oldest first</description></parameter>
            <parameter name="newCommits" type="List"><description>pre-receive: the commits the push adds, oldest first,
                each a Map as commit</description></parameter>
            <parameter name="commit" type="Map"><description>commit event</description>
                <parameter name="commitId"/>
                <parameter name="shortId"/>
                <parameter name="treeId"/>
                <parameter name="parentIds" type="List"/>
                <parameter name="authorName"/>
                <parameter name="authorEmail"/>
                <parameter name="authorDate" type="Timestamp"/>
                <parameter name="committerName"/>
                <parameter name="committerEmail"/>
                <parameter name="committerDate" type="Timestamp"/>
                <parameter name="summary"/>
                <parameter name="body"/>
                <parameter name="message"/>
                <parameter name="trailers" type="Map"><description>By trailer name, each a List of values</description></parameter>
                <parameter name="moquiUserId"><description>Of a commit made through git://</description></parameter>
            </parameter>
            <parameter name="tag" type="Map"><description>tag event</description>
                <parameter name="tagName"/>
                <parameter name="targetId"/>
                <parameter name="commitId"/>
                <parameter name="annotated" type="Boolean"/>
                <parameter name="message"/>
                <parameter name="taggerName"/>
                <parameter name="taggerEmail"/>
                <parameter name="taggerDate" type="Timestamp"/>
            </parameter>
        </in-parameters>
    </service>
</services>
