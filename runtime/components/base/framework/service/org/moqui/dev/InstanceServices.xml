<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- ========== Instance interfaces: an InstanceHostType's container services (the driver contract) ========== -->

    <service verb="init" noun="Instance" type="interface" authz-action="all">
        <in-parameters><parameter name="appInstanceId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="connectSuccess" type="Boolean"/>
            <parameter name="instanceCreated" type="Boolean"/>
            <parameter name="instanceExists" type="Boolean"/>
            <parameter name="instanceUuid"/>
            <parameter name="warnings"/>
        </out-parameters>
    </service>
    <service verb="start" noun="Instance" type="interface" authz-action="all">
        <in-parameters><parameter name="appInstanceId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="instanceStarted" type="Boolean"/>
            <parameter name="instanceRunning" type="Boolean"/>
        </out-parameters>
    </service>
    <service verb="stop" noun="Instance" type="interface" authz-action="all">
        <in-parameters><parameter name="appInstanceId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="instanceStopped" type="Boolean"/>
            <parameter name="instanceRunning" type="Boolean"/>
        </out-parameters>
    </service>
    <service verb="remove" noun="Instance" type="interface" authz-action="all">
        <in-parameters>
            <parameter name="appInstanceId" required="true"/>
            <parameter name="removeVolumes" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="instanceRemoved" type="Boolean"/>
            <parameter name="instanceExists" type="Boolean"/>
        </out-parameters>
    </service>
    <service verb="check" noun="Instance" type="interface">
        <in-parameters><parameter name="appInstanceId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="connectSuccess" type="Boolean"/>
            <parameter name="instanceExists" type="Boolean"/>
            <parameter name="instanceRunning" type="Boolean"/>
            <parameter name="statusString"/>
            <parameter name="healthString"/>
        </out-parameters>
    </service>

    <!-- ========== Runs that end: a container for one CI job (docs/interfaces/Pipelines.md "Runners and drivers") ==========
        A host type names its implementations in InstanceHostType.runStartService, runInspectService, runRemoveService
        and runCleanupService; the CI engine (crates/moqui-git/src/ci/driver) calls them with authorization disabled. -->
    <service verb="start" noun="InstanceRun" type="interface">
        <description>Start a container that runs once and ends: no privilege, no host socket or path, a non-root user,
            the limits given, and the labels, which tie it to its job run. Service containers are started first, kept
            in as the run is, each reached from the run by its name on a network of the run's own, which reaches out
            only as networkMode does.</description>
        <in-parameters>
            <parameter name="instanceHostId" required="true"/>
            <parameter name="name" required="true"/>
            <parameter name="image" required="true"/>
            <parameter name="command" type="List"><description>The image's own when empty</description></parameter>
            <parameter name="envMap" type="Map"/>
            <parameter name="labels" type="Map"/>
            <parameter name="services" type="List"><description>Maps: name, image, envMap</description></parameter>
            <parameter name="cpuLimit"><description>CPUs, a decimal</description></parameter>
            <parameter name="memoryMb" type="Integer"/>
            <parameter name="diskMb" type="Integer"/>
            <parameter name="pidsLimit" type="Integer"/>
            <parameter name="networkMode"><description>bridge when empty; none, or a network of the host (never host
                or container:...)</description></parameter>
            <parameter name="pullImages" type="Boolean"><description>Pull an image the host does not have; false (an
                untrusted pool's run): such an image is an error</description></parameter>
        </in-parameters>
        <out-parameters><parameter name="instanceRef"><description>The container's id on the host</description></parameter></out-parameters>
    </service>
    <service verb="inspect" noun="InstanceRun" type="interface">
        <in-parameters>
            <parameter name="instanceHostId" required="true"/>
            <parameter name="instanceRef" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="state"><description>running, exited or missing</description></parameter>
            <parameter name="exitCode" type="Integer"/>
        </out-parameters>
    </service>
    <service verb="remove" noun="InstanceRun" type="interface">
        <description>Remove a run's container, running or not, with its volumes; with labelName and labelValue every
            container of that label too that has every label of filterLabels (the run's service containers, of this
            server) and the run's network.</description>
        <in-parameters>
            <parameter name="instanceHostId" required="true"/>
            <parameter name="instanceRef"/>
            <parameter name="labelName"/>
            <parameter name="labelValue"/>
            <parameter name="filterLabels" type="Map"/>
            <parameter name="networkName"><description>The run's network, removed once nothing is on it</description></parameter>
        </in-parameters>
    </service>
    <service verb="cleanup" noun="InstanceRuns" type="interface">
        <description>Remove the containers that have every label of filterLabels and whose labelName label is not one
            of keepValues, made before createdBefore: what ended or lost runs left (one made after the list of runs to
            keep was read may be a run that just started).</description>
        <in-parameters>
            <parameter name="instanceHostId" required="true"/>
            <parameter name="labelName" required="true"/>
            <parameter name="keepValues" type="List"/>
            <parameter name="filterLabels" type="Map"/>
            <parameter name="createdBefore" type="Long"><description>Epoch seconds; none when empty</description></parameter>
        </in-parameters>
        <out-parameters><parameter name="removedCount" type="Integer"/></out-parameters>
    </service>

    <service verb="start" noun="RunDocker" type="rust" location="moqui_git::ci::driver::docker::start_run_docker">
        <implements service="org.moqui.dev.InstanceServices.start#InstanceRun"/></service>
    <service verb="inspect" noun="RunDocker" type="rust" location="moqui_git::ci::driver::docker::inspect_run_docker">
        <implements service="org.moqui.dev.InstanceServices.inspect#InstanceRun"/></service>
    <service verb="remove" noun="RunDocker" type="rust" location="moqui_git::ci::driver::docker::remove_run_docker">
        <implements service="org.moqui.dev.InstanceServices.remove#InstanceRun"/></service>
    <service verb="cleanup" noun="RunsDocker" type="rust" location="moqui_git::ci::driver::docker::cleanup_runs_docker">
        <implements service="org.moqui.dev.InstanceServices.cleanup#InstanceRuns"/></service>

    <!-- The fake host type (crates/moqui-git/src/ci/driver/fake.rs): starts nothing, records what it was asked, and
        answers as the host's hostAddress says (success, fail, hang, lost or exit). For tests. -->
    <service verb="start" noun="RunFake" type="rust" location="moqui_git::ci::driver::fake::start_run_fake">
        <implements service="org.moqui.dev.InstanceServices.start#InstanceRun"/></service>
    <service verb="inspect" noun="RunFake" type="rust" location="moqui_git::ci::driver::fake::inspect_run_fake">
        <implements service="org.moqui.dev.InstanceServices.inspect#InstanceRun"/></service>
    <service verb="remove" noun="RunFake" type="rust" location="moqui_git::ci::driver::fake::remove_run_fake">
        <implements service="org.moqui.dev.InstanceServices.remove#InstanceRun"/></service>
    <service verb="cleanup" noun="RunsFake" type="rust" location="moqui_git::ci::driver::fake::cleanup_runs_fake">
        <implements service="org.moqui.dev.InstanceServices.cleanup#InstanceRuns"/></service>

    <!-- ========== Database interfaces: a database kind's create#Database and check#Database ========== -->

    <service verb="create" noun="Database" type="interface">
        <description>Make an instance's database and user on its database dependency, with that server's admin login from
            the lease the call runs under; the user's password is made and deposited as the instance's dbPassword
            binding (refused when that is deposited already). Names are plain identifiers; a password is quoted as
            each server reads it (a quote or backslash refused for MySQL).</description>
        <in-parameters><parameter name="appInstanceId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="databaseCreated" type="Boolean"/>
            <parameter name="userCreated" type="Boolean"/>
        </out-parameters>
    </service>
    <service verb="check" noun="Database" type="interface">
        <in-parameters><parameter name="appInstanceId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="dbConnectSuccess" type="Boolean"/>
            <parameter name="databaseExists" type="Boolean"/>
            <parameter name="dbUserExists" type="Boolean"/>
        </out-parameters>
    </service>
    <service verb="create" noun="DatabasePostgres" type="rust" location="moqui_instance::services::create_database_postgres"
            allow-remote="false" transaction="ignore">
        <implements service="org.moqui.dev.InstanceServices.create#Database"/></service>
    <service verb="create" noun="DatabaseMySQL" type="rust" location="moqui_instance::services::create_database_mysql"
            allow-remote="false" transaction="ignore">
        <implements service="org.moqui.dev.InstanceServices.create#Database"/></service>
    <service verb="check" noun="DatabasePostgres" type="rust" location="moqui_instance::services::check_database_postgres"
            allow-remote="false">
        <implements service="org.moqui.dev.InstanceServices.check#Database"/></service>
    <service verb="check" noun="DatabaseMySQL" type="rust" location="moqui_instance::services::check_database_mysql"
            allow-remote="false">
        <implements service="org.moqui.dev.InstanceServices.check#Database"/></service>

    <!-- ========== Managed instances (plans/Vault-Instances.md §4; docs/Run-Deploy.md "Managed instances") ==========
        Rust (crates/moqui-instance), over the container driver CI's runs use (moqui_lib::docker). Each service needs the
        sealed INSTANCE_ADMIN unless authorization is disabled. No parameter or result holds a secret: what an instance
        needs is a vault item by binding, made and deposited by its provision, or leased. -->

    <service verb="store" noun="InstanceEnvironment" type="rust" location="moqui_instance::services::store_instance_environment"
            allow-remote="false">
        <description>Make or change an environment: its operational vault, approvers, required pipeline, machine access (Y
            lets its operations run under the vault's machine access for it, with no approver), unseal policy and method,
            transport and lease time limit. A given parameter that is empty clears its field.</description>
        <in-parameters>
            <auto-parameters entity-name="moqui.server.instance.InstanceEnvironment" include="nonpk"/>
            <parameter name="environmentId" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="environmentId"/></out-parameters>
    </service>
    <service verb="store" noun="InstanceCluster" type="rust" location="moqui_instance::services::store_instance_cluster"
            allow-remote="false">
        <in-parameters>
            <auto-parameters entity-name="moqui.server.instance.InstanceCluster" include="nonpk"/>
            <parameter name="clusterId" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="clusterId"/></out-parameters>
    </service>
    <service verb="store" noun="InstanceHost" type="rust" location="moqui_instance::services::store_instance_host"
            allow-remote="false">
        <description>Make or change a Docker or Podman host: unix (a socket's path), https (its client key is the item
            InstanceHost:&lt;id&gt;:tlsClientKey of its vault) or http to this machine only.</description>
        <in-parameters>
            <auto-parameters entity-name="moqui.server.instance.InstanceHost" include="nonpk"/>
            <parameter name="instanceHostId" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="instanceHostId"/></out-parameters>
    </service>
    <service verb="store" noun="InstanceImage" type="rust" location="moqui_instance::services::store_instance_image"
            allow-remote="false">
        <in-parameters>
            <parameter name="instanceImageId" required="true"/>
            <parameter name="instanceKindId"/>
            <parameter name="imageName"/>
            <parameter name="registryLocation"/>
            <parameter name="registryLogin"/>
            <parameter name="vaultId"/>
        </in-parameters>
        <out-parameters><parameter name="instanceImageId"/></out-parameters>
    </service>
    <service verb="store" noun="DatabaseHost" type="rust" location="moqui_instance::services::store_database_host"
            allow-remote="false">
        <in-parameters>
            <auto-parameters entity-name="moqui.server.instance.DatabaseHost" include="nonpk"/>
            <parameter name="databaseHostId" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="databaseHostId"/></out-parameters>
    </service>

    <service verb="create" noun="AppInstance" type="rust" location="moqui_instance::services::create_app_instance"
            allow-remote="false">
        <description>Make an instance from its image's kind: its dependencies (another instance of the environment, made
            first by its provision, or a database host), checked against what the kind takes; its settings, volumes and
            host config from the kind's templates; and its secret bindings. Makes nothing on a host.</description>
        <in-parameters>
            <parameter name="appInstanceId"><description>instanceName when empty</description></parameter>
            <parameter name="instanceImageId" required="true"/>
            <parameter name="instanceHostId" required="true"/>
            <parameter name="environmentId" required="true"/>
            <parameter name="clusterId"/>
            <parameter name="instanceName" required="true"/>
            <parameter name="hostName"/>
            <parameter name="hostPort"><description>The host's port its service is published on, on the host's loopback
                only</description></parameter>
            <parameter name="databaseInstanceId"/>
            <parameter name="databaseHostId"/>
            <parameter name="searchInstanceId"/>
            <parameter name="databaseName"/>
            <parameter name="databaseUser"/>
        </in-parameters>
        <out-parameters><parameter name="appInstanceId"/></out-parameters>
    </service>

    <service verb="preview" noun="AppInstanceProvision" type="rust"
            location="moqui_instance::services::preview_app_instance_provision" allow-remote="false">
        <description>What a provision of the instance makes, dependencies first: containers, volumes, networks, databases
            and users, the vault items it deposits, host names, and the items its lease needs (a host's TLS key, a
            registry login, a database's admin login), with whether the environment has machine access.</description>
        <in-parameters><parameter name="appInstanceId" required="true"/></in-parameters>
        <out-parameters><parameter name="preview" type="Map"/></out-parameters>
    </service>
    <service verb="request" noun="InstanceAction" type="rust" location="moqui_instance::services::request_instance_action"
            allow-remote="false" transaction="ignore">
        <description>An action from a screen (IatProvision, IatStart, IatStop, IatRestart, IatRemove): run now when it opens
            no vault item or its environment has machine access; else its lease is asked for, the action recorded as
            waiting with it (approve it in System › Vaults › Lease), and run on this server once the lease
            opens.</description>
        <in-parameters>
            <parameter name="appInstanceId" required="true"/>
            <parameter name="actionEnumId" required="true"/>
            <parameter name="removeVolumes" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="instanceActionId"/>
            <parameter name="statusEnumId"/>
            <parameter name="leaseId"/>
        </out-parameters>
    </service>
    <service verb="provision" noun="AppInstance" type="rust" location="moqui_instance::services::provision_app_instance"
            allow-remote="false" transaction="ignore">
        <description>Provision the instance and its dependencies not made yet (plans/Vault-Instances.md §4.3): the
            credentials its kinds make, deposited; its database and user, made with the admin login; its volumes,
            network and container with secrets as files; started and checked. One that opens vault items runs only
            under leaseId (a lease this server holds, asked for this provision and opened by an approver) or its
            environment's machine access, and is refused otherwise. An InstanceAction row records it.</description>
        <in-parameters>
            <parameter name="appInstanceId" required="true"/>
            <parameter name="leaseId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="instanceActionId"/>
            <parameter name="report"/>
        </out-parameters>
    </service>
    <service verb="start" noun="AppInstance" type="rust" location="moqui_instance::services::start_app_instance"
            allow-remote="false" transaction="ignore">
        <description>The host type's start, under leaseId or machine access when the host's key is a vault item.</description>
        <in-parameters><parameter name="appInstanceId" required="true"/><parameter name="leaseId"/></in-parameters>
        <out-parameters><parameter name="instanceActionId"/><parameter name="report"/></out-parameters>
    </service>
    <service verb="stop" noun="AppInstance" type="rust" location="moqui_instance::services::stop_app_instance"
            allow-remote="false" transaction="ignore">
        <in-parameters><parameter name="appInstanceId" required="true"/><parameter name="leaseId"/></in-parameters>
        <out-parameters><parameter name="instanceActionId"/><parameter name="report"/></out-parameters>
    </service>
    <service verb="restart" noun="AppInstance" type="rust" location="moqui_instance::services::restart_app_instance"
            allow-remote="false" transaction="ignore">
        <in-parameters><parameter name="appInstanceId" required="true"/><parameter name="leaseId"/></in-parameters>
        <out-parameters><parameter name="instanceActionId"/><parameter name="report"/></out-parameters>
    </service>
    <service verb="remove" noun="AppInstance" type="rust" location="moqui_instance::services::remove_app_instance"
            allow-remote="false" transaction="ignore">
        <description>The host type's remove: the container, and its volumes (its data) only with removeVolumes. The
            instance's row and its vault items stay.</description>
        <in-parameters>
            <parameter name="appInstanceId" required="true"/>
            <parameter name="leaseId"/>
            <parameter name="removeVolumes" type="Boolean"/>
        </in-parameters>
        <out-parameters><parameter name="instanceActionId"/><parameter name="report"/></out-parameters>
    </service>
    <service verb="check" noun="AppInstance" type="rust" location="moqui_instance::services::check_app_instance"
            allow-remote="false" transaction="ignore">
        <description>What the host says of the instance's container, written to its row; a host reached with a client key
            from the vault is checked during an action, under its lease.</description>
        <implements service="org.moqui.dev.InstanceServices.check#Instance"/>
    </service>

    <!-- The docker host type's services (the driver contract of InstanceHostType), over moqui_lib::docker: called by the
        actions above under their lease -->
    <service verb="init" noun="InstanceContainer" type="rust" location="moqui_instance::services::init_instance_container"
            allow-remote="false" transaction="ignore">
        <implements service="org.moqui.dev.InstanceServices.init#Instance"/></service>
    <service verb="start" noun="InstanceContainer" type="rust" location="moqui_instance::services::start_instance_container"
            allow-remote="false" transaction="ignore">
        <implements service="org.moqui.dev.InstanceServices.start#Instance"/></service>
    <service verb="stop" noun="InstanceContainer" type="rust" location="moqui_instance::services::stop_instance_container"
            allow-remote="false" transaction="ignore">
        <implements service="org.moqui.dev.InstanceServices.stop#Instance"/></service>
    <service verb="remove" noun="InstanceContainer" type="rust" location="moqui_instance::services::remove_instance_container"
            allow-remote="false" transaction="ignore">
        <implements service="org.moqui.dev.InstanceServices.remove#Instance"/></service>
    <service verb="check" noun="InstanceContainer" type="rust" location="moqui_instance::services::check_instance_container"
            allow-remote="false" transaction="ignore">
        <implements service="org.moqui.dev.InstanceServices.check#Instance"/></service>

    <service verb="reconcile" noun="AppInstances" type="rust" location="moqui_instance::services::reconcile_app_instances"
            allow-remote="false" transaction="ignore">
        <description>The reconcile job: for each instance with a container, what its host says (state, health, image) is
            written beside its desired state. It changes nothing on a host. A host reached with a client key from the
            vault is left until an action runs.</description>
        <out-parameters>
            <parameter name="observedCount" type="Integer"/>
            <parameter name="unreachableCount" type="Integer"/>
            <parameter name="skippedCount" type="Integer"/>
        </out-parameters>
    </service>

    <!-- ========== Deploys (plans/Vault-Instances.md §4.6, M3; docs/tools/Component-Deploy.md "A deploy over the link") ==========
        The gate (a passed run of the environment's required pipeline for the commit), the lease its approval opens (or
        the environment's machine access), a backup first, the roll one instance at a time (a cluster member drained over
        the link), the annotations, and rollback to the versions an action recorded, refused across a schema change. -->
    <service verb="define" noun="InstanceDeployParameters" type="interface">
        <description>What a deploy by hand changes: a new image (instanceImageId, gated on the revision its row records),
            a component's commit (componentName, repositoryId, refName, commitId, dataTypes), or the rollback of a deploy
            action (rollbackOfActionId); in an environment, or on one instance or cluster of it.</description>
        <in-parameters>
            <parameter name="environmentId"><description>Its instance's when appInstanceId is given</description></parameter>
            <parameter name="appInstanceId"/>
            <parameter name="clusterId"/>
            <parameter name="instanceImageId"/>
            <parameter name="componentName"/>
            <parameter name="refName"/>
            <parameter name="commitId"><description>A component's commit, which the gate checks; an image is gated on the
                revision its row records</description></parameter>
            <parameter name="repositoryId"><description>A component's repository: a CI environment of it must deploy to
                this environment, whose cloneUrl the instance fetches from</description></parameter>
            <parameter name="dataTypes"/>
            <parameter name="rollbackOfActionId"/>
        </in-parameters>
    </service>
    <service verb="preview" noun="InstanceDeploy" type="rust" location="moqui_instance::services::preview_instance_deploy"
            allow-remote="false" transaction="ignore">
        <description>What a deploy would change: each instance with its image digest, component commits and schema hash
            before and after, whether it is drained or replaced, the backups it runs first, and the lease it needs (where
            each item goes). No value.</description>
        <implements service="org.moqui.dev.InstanceServices.define#InstanceDeployParameters"/>
        <out-parameters><parameter name="preview" type="Map"/></out-parameters>
    </service>
    <service verb="request" noun="InstanceDeploy" type="rust" location="moqui_instance::services::request_instance_deploy"
            allow-remote="false" transaction="ignore">
        <description>A deploy from the instance or environment page: refused without a passed run of the environment's
            required pipeline for the commit (a rollback is not gated, and is refused across a schema change); run now
            when it opens no vault item or the environment has machine access, else its lease is asked for and it runs on
            this server once an approver opens it (System › Vaults › Lease).</description>
        <implements service="org.moqui.dev.InstanceServices.define#InstanceDeployParameters"/>
        <out-parameters>
            <parameter name="instanceActionId"/>
            <parameter name="statusEnumId"/>
            <parameter name="leaseId"/>
        </out-parameters>
    </service>
    <service verb="prepare" noun="GitDeployment" type="rust" location="moqui_instance::services::prepare_git_deployment"
            allow-remote="false" transaction="ignore">
        <description>Called only by a deployment's step (crates/moqui-git, with authorization disabled) whose environment
            names an InstanceEnvironment, once its pipeline passed (the deployment waiting-pipeline): the gate, and the lease of what its deploy opens, held on this server, which then runs its
            deploy step. None with machine access or when it opens nothing; approvalRequired unless the environment has
            machine access.</description>
        <in-parameters><parameter name="deploymentId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="leaseId"/>
            <parameter name="approvalRequired" type="Boolean"/>
            <parameter name="leaseMinutes" type="Long"/>
        </out-parameters>
    </service>
    <service verb="deploy" noun="GitDeployment" type="rust" location="moqui_instance::services::deploy_git_deployment"
            allow-remote="false" transaction="ignore">
        <description>A deployment's deploy step to managed instances (crates/moqui-git only, with authorization disabled; the
            deployment deploying and leaseId its own): the component at the deployment's commit to the environment's mr-moqui instances over the manager link, no attestation posted, under leaseId or
            the environment's machine access.</description>
        <in-parameters>
            <parameter name="deploymentId" required="true"/>
            <parameter name="leaseId"/>
            <parameter name="componentName" required="true"/>
            <parameter name="repositoryUrl" required="true"/>
            <parameter name="source"/>
            <parameter name="dataTypes"/>
        </in-parameters>
        <out-parameters>
            <parameter name="deployResult"><description>JSON: status, component, commitId, instances, actions</description></parameter>
            <parameter name="report"/>
        </out-parameters>
    </service>
    <service verb="backup" noun="DatabaseInstance" type="rust" location="moqui_instance::services::backup_database_instance"
            allow-remote="false" transaction="ignore">
        <description>A database kind's backup, which a deploy runs first: one database (databaseName) or all, dumped by a
            one-shot client on the server's network into its backups volume (instanceName-backups), with the admin login
            from the lease the call runs under, checked against the server its item names.</description>
        <in-parameters>
            <parameter name="appInstanceId" required="true"/>
            <parameter name="databaseName"/>
        </in-parameters>
        <out-parameters><parameter name="backupFile"><description>volume:file</description></parameter></out-parameters>
    </service>
    <service verb="approve" noun="InstanceDeploy" type="rust" location="moqui_instance::services::approve_instance_deploy"
            allow-remote="false" transaction="ignore">
        <description>Approve a deploy by hand that waits for another member of its environment's approver group (it opens
            no vault item, or runs under machine access, and the environment is not singlePersonDeploy): INSTANCE_ADMIN
            and a member of the group, never its requester; the deploy then runs as it was asked.</description>
        <in-parameters><parameter name="instanceActionId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="instanceActionId"/>
            <parameter name="statusEnumId"/>
        </out-parameters>
    </service>
    <!-- Monitor (plans/Vault-Instances.md §4.8) -->
    <service verb="get" noun="InstanceFleet" type="rust" location="moqui_instance::services::get_instance_fleet"
            allow-remote="false" transaction="ignore">
        <description>The fleet screen's rows: each instance (not removed) by environment, with its kind, version, health
            (its host's check and how fresh its telemetry is), seal and link state, cluster, last deploy, open Monitor
            incidents and items past their rotation age (M5). From the rows only.</description>
        <out-parameters><parameter name="fleetList" type="List"/></out-parameters>
    </service>
    <service verb="run" noun="InstanceRecovery" type="rust" location="moqui_instance::services::run_instance_recovery"
            allow-remote="false" transaction="ignore">
        <description>Monitor's instance recovery adapter (moqui-report calls it by name, with authorization disabled):
            the recovery action's step, read from its RecoveryAction (active) and RecoveryDecision (Approved), never from
            parameters. Approved by a person: that user must hold INSTANCE_ADMIN and be in the environment's approver
            group; automatic: the environment must allow automatic recovery and have machine access. restart and rollback
            are instance actions, which wait for their lease unless the environment has machine access; isolate-instance
            drains the instance over its link; pause-rollout and promote stop and let go on the environment's rolling
            deploys. Another caller needs INSTANCE_ADMIN.</description>
        <in-parameters>
            <parameter name="recoveryActionId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="status"><description>done, or waiting for its lease</description></parameter>
            <parameter name="instanceActionId"/>
            <parameter name="leaseId"/>
            <parameter name="state"/>
        </out-parameters>
    </service>
    <service verb="cancel" noun="InstanceRecovery" type="rust" location="moqui_instance::services::cancel_instance_recovery"
            allow-remote="false" transaction="ignore">
        <description>Monitor cancelled or timed out an instance adapter's recovery action: the instance action it waits on
            (its RecoveryAction's externalId) is marked failed and its lease ended, so it runs nothing. One that runs or
            ended is left as it is.</description>
        <in-parameters>
            <parameter name="recoveryActionId" required="true"/>
            <parameter name="reason"/>
        </in-parameters>
        <out-parameters><parameter name="cancelled" type="Boolean"/></out-parameters>
    </service>

    <!-- Rotation (plans/Vault-Instances.md §4.7, M5; crates/moqui-instance/src/rotate) -->
    <service verb="rotate" noun="Credential" type="rust" location="moqui_instance::rotate::services::rotate_credential"
            allow-remote="false" transaction="ignore">
        <description>The kinds' rotate service (InstanceKindSecret.rotateService): one instance's secret, now, under the
            lease handed to it (whose operation is this rotation's) or the environment's machine access; refused without
            either, and when the caller is not INSTANCE_ADMIN or not in the environment's approver group. In order: each
            instance that uses it must be up and unsealed; a new value set at its source (a database user's or admin's
            password from a one-shot on the database's network or over verified TLS, an OpenSearch admin password through
            its security API); put on each instance that uses it, which is restarted; the source and the instances
            checked; the item's next revision deposited, the one before kept in VaultItemHistory. A failure after the
            source puts the old value back there and on the instances. An InstanceAction (IatRotate) with its report, never
            a value.</description>
        <in-parameters>
            <parameter name="appInstanceId" required="true"/>
            <parameter name="secretName" required="true"/>
            <parameter name="leaseId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="instanceActionId"/>
            <parameter name="revision" type="Long"/>
            <parameter name="report"/>
        </out-parameters>
    </service>
    <service verb="request" noun="InstanceRotation" type="rust" location="moqui_instance::rotate::services::request_instance_rotation"
            allow-remote="false" transaction="ignore">
        <description>Rotates credentials of an environment: those named (bindingList, bindingKey, or appInstanceId with
            secretName), or every item the manager can rotate (all, the incident list of Sealed-Secrets §3.12), or those
            past their age (dueOnly). It runs now under the environment's machine access; else it asks for one lease of
            them and records a waiting rotate action (the page goes to the lease dialog), and rotates on this member once an
            approver opens it. What is not rotated comes back with why (notRotatedList: no rotate service and what to do by
            hand, or deposited and not taken in yet). INSTANCE_ADMIN, and the environment's approver group when it names
            one.</description>
        <in-parameters>
            <parameter name="environmentId"><description>Else the environment of appInstanceId</description></parameter>
            <parameter name="bindingList" type="List"/>
            <parameter name="bindingKey"/>
            <parameter name="appInstanceId"/>
            <parameter name="secretName"/>
            <parameter name="all" type="Boolean"/>
            <parameter name="dueOnly" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="instanceActionId"/>
            <parameter name="statusEnumId"/>
            <parameter name="leaseId"/>
            <parameter name="bindingList" type="List"/>
            <parameter name="notRotatedList" type="List"/>
        </out-parameters>
    </service>
    <service verb="get" noun="InstanceRotations" type="rust" location="moqui_instance::rotate::services::get_instance_rotations"
            allow-remote="false" transaction="ignore">
        <description>The rotation list of an environment: each item of its vault with its type, binding, name, age in days,
            rotation age (its own, else its type's), whether it is due, the instance and secret it is bound to, whether
            the manager rotates it, whether it waits for a member to take it in, and what to do by hand when the manager
            cannot change it. No value. INSTANCE_ADMIN, and the environment's approver group when it names one.</description>
        <in-parameters><parameter name="environmentId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="itemList" type="List"/>
            <parameter name="dueCount" type="Long"/>
        </out-parameters>
    </service>
    <service verb="rotate" noun="DueCredentials" type="rust" location="moqui_instance::rotate::services::rotate_due_credentials"
            allow-remote="false" transaction="ignore">
        <description>The job at the policy age (rotate_DueInstanceCredentials): in each environment, the items past their
            age that the manager rotates and a member has taken in are rotated under its machine access, or one lease of
            them is asked for, not again while a rotation waits for its lease. An item whose last rotation failed within
            manage@rotate-retry-days is held back and told to the administrators (topic InstanceRotationFailed). An
            environment that fails is logged and the rest go on. INSTANCE_ADMIN, or authorization disabled (the job); a
            caller with authorization on rotates only the environments whose approver group they are in, or that name
            none.</description>
        <out-parameters>
            <parameter name="rotatedCount" type="Long"/>
            <parameter name="askedCount" type="Long"/>
            <parameter name="failedCount" type="Long"/>
            <parameter name="heldBackCount" type="Long"/>
            <parameter name="skippedCount" type="Long"/>
        </out-parameters>
    </service>

</services>