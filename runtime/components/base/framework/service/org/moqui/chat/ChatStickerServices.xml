<!-- Sticker packs (plans/Comms-Messaging.md §18.3 phase 20): the server's packs (ChatStickerAdmin keeps them) and each
    user's own; a sent sticker is a copy of its picture in the room. Local only, no outside service. Each service checks
    the caller: another user's pack is "not found". The logic is ChatSticker.js beside this file. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="get" noun="StickerPacks">
        <description>The caller's own offered packs, then the server's offered ones, each {chatStickerPackId, packName, own,
            hidden, coverStickerId, stickers [{chatStickerId, emoji, altText, width, height, contentType}]}; manage adds the
            caller's hidden packs and, for a sticker admin, every server pack. version is the newest change; canManageServer
            whether the caller keeps the server's packs.</description>
        <in-parameters><parameter name="manage" type="Boolean" default="false"/></in-parameters>
        <out-parameters>
            <parameter name="packList" type="List"/>
            <parameter name="version" type="Long"/>
            <parameter name="canManageServer" type="Boolean"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/chat/ChatSticker.js').execute('packs', context))</script></actions>
    </service>

    <service verb="create" noun="StickerPack">
        <description>A pack: the caller's own, or with server a server pack (ChatStickerAdmin). packName up to 60 characters.
            At most chat/stickers@user-packs-max (10) of a user's and chat/stickers@server-packs-max (50) of the server's.
            Refused: badName, notAllowed, tooMany. Out: chatStickerPackId.</description>
        <in-parameters>
            <parameter name="packName" required="true"/>
            <parameter name="server" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="chatStickerPackId"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/chat/ChatSticker.js').execute('createPack', context))</script></actions>
    </service>

    <service verb="update" noun="StickerPack">
        <description>A pack the caller keeps: packName, hidden (kept, not offered), sequenceNum, coverStickerId (one of its
            stickers). Out: reasonCode.</description>
        <in-parameters>
            <parameter name="chatStickerPackId" required="true"/>
            <parameter name="packName"/>
            <parameter name="hidden" type="Boolean"/>
            <parameter name="sequenceNum" type="Integer"/>
            <parameter name="coverStickerId"/>
        </in-parameters>
        <out-parameters><parameter name="reasonCode"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/chat/ChatSticker.js').execute('updatePack', context))</script></actions>
    </service>

    <service verb="delete" noun="StickerPack">
        <description>A pack the caller keeps, its stickers and their files (each file on its own: one that cannot be removed
            is logged). A sticker already sent stays in its room. Out: reasonCode.</description>
        <in-parameters><parameter name="chatStickerPackId" required="true"/></in-parameters>
        <out-parameters><parameter name="reasonCode"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/chat/ChatSticker.js').execute('deletePack', context))</script></actions>
    </service>

    <service verb="add" noun="Sticker">
        <description>A picture into a pack the caller keeps: a PNG, WebP or GIF by its bytes (whatever its name or type says;
            it is stored with its real type and extension), animated ones too, at most chat/stickers@max-bytes (512 KB) and
            chat/stickers@max-side (512 px a side, read from its header before it is decoded), decoded within a small memory
            limit (its still 128 px thumbnail is made from it); at most chat/stickers@uploads-per-hour (60) of a user an hour;
            the same picture once a pack; at most chat/stickers@pack-max (200) stickers a server pack and
            chat/stickers@user-pack-max (100) a user's. emoji (one, up to 16 characters) and altText (up to 80). Refused:
            noFile, badType, tooLarge, tooMany, duplicate. Out: chatStickerId, sticker.</description>
        <in-parameters>
            <parameter name="chatStickerPackId" required="true"/>
            <parameter name="file" type="FileItem" required="true"/>
            <parameter name="emoji"/>
            <parameter name="altText"/>
        </in-parameters>
        <out-parameters>
            <parameter name="chatStickerId"/>
            <parameter name="sticker" type="Map"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/chat/ChatSticker.js').execute('addSticker', context))</script></actions>
    </service>

    <service verb="update" noun="Sticker">
        <description>A sticker of a pack the caller keeps: emoji, altText, sequenceNum. Out: reasonCode.</description>
        <in-parameters>
            <parameter name="chatStickerId" required="true"/>
            <parameter name="emoji"/>
            <parameter name="altText"/>
            <parameter name="sequenceNum" type="Integer"/>
        </in-parameters>
        <out-parameters><parameter name="reasonCode"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/chat/ChatSticker.js').execute('updateSticker', context))</script></actions>
    </service>

    <service verb="remove" noun="Sticker">
        <description>A sticker of a pack the caller keeps, with its files. A copy already sent stays. Out: reasonCode.</description>
        <in-parameters><parameter name="chatStickerId" required="true"/></in-parameters>
        <out-parameters><parameter name="reasonCode"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/chat/ChatSticker.js').execute('removeSticker', context))</script></actions>
    </service>

    <service verb="get" noun="StickerImage">
        <description>Where a sticker's picture is (thumb: its still 128 px PNG), for one who may use its pack (their own, or
            an offered server pack; a sticker admin sees a hidden server pack's too); another user's is not found. Out:
            location, contentType, reasonCode.</description>
        <in-parameters>
            <parameter name="chatStickerId" required="true"/>
            <parameter name="thumb" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="location"/>
            <parameter name="contentType"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/chat/ChatSticker.js').execute('image', context))</script></actions>
    </service>

    <service verb="send" noun="Sticker">
        <description>A sticker the caller may use, to a plain room they may post in: its picture copied as the room's file
            (ChatAttachment stickerOf, in the day's file bytes), send#Message with its words ("Sticker 👍") and that file,
            then content.sticker {chatStickerId, packName, emoji, altText, width, height} and the update pushed.
            replyToEventSeq, threadRootEventSeq, clientRef and roomUrl as send#Message. Refused: notFound, notMember,
            archived, encryptedRoom (the browser seals and sends it there), tooMany (the day's file bytes). Out: eventSeq,
            event (with sticker), duplicate, reasonCode.</description>
        <in-parameters>
            <parameter name="chatRoomId" required="true"/>
            <parameter name="chatStickerId" required="true"/>
            <parameter name="replyToEventSeq" type="Integer"/>
            <parameter name="threadRootEventSeq" type="Integer"/>
            <parameter name="clientRef"/>
            <parameter name="roomUrl"/>
        </in-parameters>
        <out-parameters>
            <parameter name="eventSeq" type="Integer"/>
            <parameter name="event" type="Map"/>
            <parameter name="duplicate" type="Boolean"/>
            <parameter name="reasonCode"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://framework/service/org/moqui/chat/ChatSticker.js').execute('send', context))</script></actions>
    </service>
</services>
