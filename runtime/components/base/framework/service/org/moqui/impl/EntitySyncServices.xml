<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <!-- The services without actions have Rust bodies, in crates/moqui-core/src/service/system_sync/entity_sync.rs. JSON-RPC
        is not part of this port, so a remote call is REST through RestClient: a POST of the parameters as JSON to
        /rest/s1/moqui/entity/syncs/data/get or .../put (moqui.rest.xml) under EntitySync.targetServerUrl, which is the root
        of the remote server (like https://host:8443), with basic auth from targetUsername and targetPassword. -->
    <service verb="run" noun="EntitySyncAll" transaction="ignore" authenticate="anonymous-all">
        <actions>
            <entity-find entity-name="moqui.entity.sync.EntitySync" list="entitySyncList">
                <econdition field-name="statusId" operator="not-equals" value="EsRunning"/></entity-find>
            <iterate list="entitySyncList" entry="entitySync">
                <!-- NOTE: currently calls async, consider transaction="force-new" if there are multiple large syncs to
                    avoid running out of memory, etc -->
                <service-call name="org.moqui.impl.EntitySyncServices.run#EntitySync"
                        in-map="{entitySyncId:entitySync.get('entitySyncId')}" async="true"/>
            </iterate>
        </actions>
    </service>
    <service verb="run" noun="EntitySync" type="rust" location="moqui_core::service::system_sync::entity_sync::run_sync"
            authenticate="anonymous-all">
        <description>Lock the EntitySync record (only one sync at a time), quit if it is already running (unless its
            lastStartDate is more than 24 hours ago) or if delayBufferMillis have not passed since lastSuccessfulSyncTime,
            then mark it running, call internalRun#EntitySync in its own transaction, save the result status, record an
            EntitySyncHistory row, and if not yet up to delayBufferMillis start another run async.</description>
        <in-parameters><parameter name="entitySyncId" required="true"/></in-parameters>
    </service>
    <service verb="internalRun" noun="EntitySync" type="rust"
            location="moqui_core::service::system_sync::entity_sync::internal_run" transaction="force-new">
        <description>For a pull get the data from the remote (get#EntitySyncData) and store it here (put#EntitySyncData);
            for a push get it here and store it on the remote. Errors are returned in errorMessage and cleared.</description>
        <in-parameters>
            <parameter name="entitySync" type="EntityValue" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="errorMessage"/>
            <parameter name="exclusiveFromTime" type="Timestamp"/>
            <parameter name="inclusiveThruTime" type="Timestamp"/>
            <parameter name="recordsStored" type="Long"/>
        </out-parameters>
    </service>

    <service verb="put" noun="EntitySyncData" type="rust" location="moqui_core::service::system_sync::entity_sync::put_data"
            transaction="ignore" allow-remote="true">
        <description>Load entity-facade-xml text, refusing the identity-admin and secret-config entities as the
            restrictSensitiveEntities option of the Java data loader does.</description>
        <in-parameters>
            <parameter name="entityData" required="true" allow-html="any"/><!-- this is XML coming in, don't validate as HTML -->
            <parameter name="timeout" type="Integer" default="600"/>
            <parameter name="dummyFks" type="Boolean" default="true"/>
            <parameter name="useTryInsert" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="recordsStored" type="Long"/>
        </out-parameters>
    </service>
    <service verb="get" noun="EntitySyncData" type="rust" location="moqui_core::service::system_sync::entity_sync::get_data"
            allow-remote="true">
        <description>The records of each entity in entityIncludeList with a lastUpdatedStamp in time splits of
            syncSplitMillis after lastSuccessfulSyncTime, until recordThreshold records or delayBufferMillis before now,
            as entity-facade-xml text. The query of each split streams through an entity list iterator.</description>
        <in-parameters>
            <parameter name="entityIncludeList" type="List">
                <parameter name="entryMap" type="Map">
                    <parameter name="entityName"/>
                    <parameter name="includeFilterList" type="List">
                        <description>List of Maps to be ORed together</description>
                        <parameter name="filterMap" type="Map"/>
                    </parameter>
                    <parameter name="dependents" type="Boolean"/>
                </parameter>
            </parameter>
            <parameter name="lastSuccessfulSyncTime" type="Timestamp"/>
            <parameter name="syncSplitMillis" type="Long" default="1000"/>
            <parameter name="recordThreshold" type="Long" default="1000"/>
            <parameter name="delayBufferMillis" type="Long" default="300000"/><!-- default to 5 minutes -->
        </in-parameters>
        <out-parameters>
            <parameter name="entityData"/>
            <parameter name="recordCount" type="Long"/>
            <parameter name="exclusiveFromTime" type="Timestamp"/>
            <parameter name="inclusiveThruTime" type="Timestamp"/>
        </out-parameters>
    </service>

    <service verb="get" noun="EntitySyncIncludeList" type="rust"
            location="moqui_core::service::system_sync::entity_sync::include_list">
        <description>The entities of the EntitySyncArtifact groups (AT_ENTITY members, a name pattern matched against every
            non-view entity), with excluded entities removed and always-include entries added. A member filterMap is a
            JavaScript object expression.</description>
        <in-parameters><parameter name="entitySyncId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="entityIncludeList" type="List">
                <parameter name="entryMap" type="Map">
                    <parameter name="entityName"/>
                    <parameter name="includeFilterList" type="List">
                        <description>List of Maps to be ORed together</description>
                        <parameter name="filterMap" type="Map"/>
                    </parameter>
                    <parameter name="dependents" type="Boolean"/>
                </parameter>
            </parameter>
        </out-parameters>
    </service>
</services>
