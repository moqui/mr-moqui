<!-- The framework's own gitECA rules (docs/interfaces/Git-Hosting.md): webhooks, merge requests and push mirrors follow every change of a
    repository's refs, from a push, a mirror fetch, an import or a write through Moqui (create#GitRef, merge#GitRefs,
    a wiki save). Each runs even after another rule of the change failed. Branch rules are not rules here: the git
    server enforces them, so no component can remove them. -->
<gitecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/git-eca-3.xsd">
    <giteca rule-name="Merge requests follow their branches" id="FrameworkRefreshMergeRequests" event="ref-update"
            ref-type="branch" source="push,fetch,import,write" priority="7" run-on-error="true">
        <actions><service-call name="org.moqui.git.GitReviewServices.refresh#MergeRequests" in-map="context"/></actions>
    </giteca>
    <!-- Not on write: a definition save writes its own file, which needs no pulling back. -->
    <giteca rule-name="Report definitions follow their synced directories" id="FrameworkPullDefinitionGitSyncs" event="ref-update"
            ref-type="branch" source="push,fetch,import" priority="9" run-on-error="true">
        <actions><service-call name="org.moqui.report.ReportServices.pull#DefinitionGitSyncs" in-map="context"/></actions>
    </giteca>
    <giteca rule-name="Webhooks of pushes and tags" id="FrameworkWebhookPush" event="post-receive"
            source="push,fetch,import,write" priority="8" run-on-error="true">
        <actions><service-call name="org.moqui.git.GitServices.queue#GitWebhookPush" in-map="context"/></actions>
    </giteca>
    <!-- A no-op for a repository with no pushMirrorRemoteId. Async: the push runs outside this change's events, so a
        slow or unreachable mirror holds up no later change's rules; its outcome is on the repository's row. -->
    <giteca rule-name="Push mirrors follow their repositories" id="FrameworkPushMirror" event="post-receive"
            source="push,fetch,import,write" priority="9" run-on-error="true">
        <actions><service-call name="org.moqui.git.GitServices.push#GitMirror" in-map="{repositoryId:repositoryId}"
                async="true"/></actions>
    </giteca>
    <!-- Pipelines (docs/interfaces/Pipelines.md): a no-op when the engine is off here or the commit has no ci.xml and no
        component.xml. Not for a mirror's fetch or an import: nobody with the update right pushed those commits. A
        merge request's runs follow its events (GitCi.secas.xml). -->
    <giteca rule-name="Pipelines run for pushes and tags" id="FrameworkQueuePipelineRuns" event="post-receive"
            source="push,write" priority="9" run-on-error="true">
        <actions><service-call name="org.moqui.git.GitCiServices.queue#PushRuns" in-map="context"/></actions>
    </giteca>
</gitecas>
