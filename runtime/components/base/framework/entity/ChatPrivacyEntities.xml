<!-- Screen security and one-time codes in chat (plans/Comms-Messaging.md §18.3 phase 21; org.moqui.chat.ChatPrivacyServices,
    ChatOtp.js). The settings are the user's preferences (CHAT_SCREEN_SECURITY: off, encrypted or app; CHAT_OTP_DELETE); a
    code is the message's content.otp, and its delete after a day phase 16's ChatEvent.expireDate. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <extend-entity entity-name="ChatRoomMember" package="moqui.chat">
        <field name="screenSecure" type="text-indicator"><description>Y: the member blocks screenshots while this encrypted room is
            open (Android's FLAG_SECURE), whatever CHAT_SCREEN_SECURITY says</description></field>
    </extend-entity>
</entities>
