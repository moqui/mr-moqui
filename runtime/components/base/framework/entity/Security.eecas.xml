<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="UserGroupMemberPrivileged" entity="moqui.security.UserGroupMember"
            on-create="true" on-update="true" on-delete="true" run-before="true">
        <actions><script>UserSecurityChecks.assertPrivilegedGroupMembership(userGroupId)</script></actions>
    </eeca>
    <!-- a membership carries its group's grants: in a group that grants a sealed permission only a holder of it gives one (a
        change that only ends a membership sooner passes; granting a sealed permission is UserGroupPermissionSealed) -->
    <eeca id="UserGroupMemberSealed" entity="moqui.security.UserGroupMember"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>UserSecurityChecks.assertSealedGroupMembership(userGroupId, thruDate,
            eecaOperation == "update" &amp;&amp; originalValue != null, originalValue != null ? originalValue.thruDate : null)</script></actions>
    </eeca>
    <eeca id="UserGroupPermissionSealed" entity="moqui.security.UserGroupPermission"
            on-create="true" on-update="true" on-delete="true" run-before="true">
        <actions><script>UserSecurityChecks.assertSealedPermissionGrant(userPermissionId)</script></actions>
    </eeca>
    <!-- a DataDocument field expression is script run as whoever reads the document: writing one needs DATABASE_ADMIN -->
    <eeca id="DataDocumentFieldExpression" entity="moqui.entity.document.DataDocumentField"
            on-create="true" on-update="true" run-before="true">
        <actions><script>UserSecurityChecks.assertDocumentExpression(fieldPath)</script></actions>
    </eeca>
    <!-- The new-device sign-in notice (mr-boss plan/impl-admin.md P10, design-admin §4 Sessions): a successful sign-in's
        history row is written by a worker after the sign-in itself (crates/moqui-core/src/user/login.rs save_history, at
        most one row a minute for a user), with its visit; the notice is decided and sent then, in a transaction of its own
        (a notification whose email cannot be sent marks its transaction rollback-only). It never fails the row: a failure
        is logged. -->
    <eeca id="UserLoginHistoryNewDevice" entity="moqui.security.UserLoginHistory" on-create="true">
        <condition><expression>successfulLogin == 'Y' &amp;&amp; !!visitId</expression></condition>
        <actions><script><![CDATA[
            ec.message.pushErrors()
            try {
                ec.service.sync().name('org.moqui.admin.IdentityServices.notify#NewDeviceSignIn')
                    .parameters({userId: userId, visitId: visitId, fromDate: fromDate}).requireNewTransaction(true).disableAuthz().call()
                if (ec.message.hasError()) ec.logger.error('New-device notice for ' + userId + ': ' + ec.message.getErrorsString())
            } catch (err) {
                ec.logger.error('New-device notice for ' + userId + ': ' + (err && err.message ? err.message : err))
            } finally { ec.message.clearErrors(); ec.message.popErrors() }
        ]]></script></actions>
    </eeca>
</eecas>
