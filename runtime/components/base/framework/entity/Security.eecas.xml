<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="UserGroupMemberPrivileged" entity="moqui.security.UserGroupMember"
            on-create="true" on-update="true" on-delete="true" run-before="true">
        <actions><script>UserSecurityChecks.assertPrivilegedGroupMembership(userGroupId)</script></actions>
    </eeca>
    <!-- a membership carries its group's grants: in a group that grants a sealed permission only a holder of it gives one (a
        change that only ends a membership sooner passes; granting a sealed permission is UserGroupPermissionSealed) -->
    <eeca id="UserGroupMemberSealed" entity="moqui.security.UserGroupMember"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>UserSecurityChecks.assertSealedGroupMembership(userGroupId, thruDate,
            eecaOperation == "update" &amp;&amp; originalValue != null, originalValue != null ? originalValue.thruDate : null)</script></actions>
    </eeca>
    <eeca id="UserGroupPermissionSealed" entity="moqui.security.UserGroupPermission"
            on-create="true" on-update="true" on-delete="true" run-before="true">
        <actions><script>UserSecurityChecks.assertSealedPermissionGrant(userPermissionId)</script></actions>
    </eeca>
    <!-- a DataDocument field expression is script run as whoever reads the document: writing one needs DATABASE_ADMIN -->
    <eeca id="DataDocumentFieldExpression" entity="moqui.entity.document.DataDocumentField"
            on-create="true" on-update="true" run-before="true">
        <actions><script>UserSecurityChecks.assertDocumentExpression(fieldPath)</script></actions>
    </eeca>
    <!-- a DataDocument's title and a link's URL and label are templates, and a link's condition is script, run as whoever
        reads a search hit or a notification of the document: writing one needs DATABASE_ADMIN too
        (plans/Security-Review.md SEC-SCR-05). Only a value that changes is checked, so another field of a document whose
        title a seed load wrote can still be changed. -->
    <eeca id="DataDocumentTitleTemplate" entity="moqui.entity.document.DataDocument"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>
            if (eecaOperation != "update" || documentTitle != originalValue?.documentTitle)
                UserSecurityChecks.assertDocumentTemplate(documentTitle)
        </script></actions>
    </eeca>
    <eeca id="DataDocumentLinkTemplate" entity="moqui.entity.document.DataDocumentLink"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>
            const updating = eecaOperation == "update"
            if (!updating || linkUrl != originalValue?.linkUrl) UserSecurityChecks.assertDocumentTemplate(linkUrl)
            if (!updating || label != originalValue?.label) UserSecurityChecks.assertDocumentTemplate(label)
            if (!updating || linkCondition != originalValue?.linkCondition) UserSecurityChecks.assertDocumentCondition(linkCondition)
        </script></actions>
    </eeca>
    <!-- Records whose text runs as script where they are used (plans/Security-Review-Medium.md SEC-SCR-06, SEC-SCR-12): a
        template (${}) or an expression in them needs DATABASE_ADMIN, the permission for script stored in records, as a
        DataDocument's does. Only a value that changes is checked, so another field of a row a seed load wrote can still be
        changed; a data load runs with authorization disabled and is not checked. -->
    <!-- a translation is expanded where its original is: it may keep the original's placeholders; adding an expression, or
        a message key's template with one, needs DATABASE_ADMIN -->
    <eeca id="LocalizedMessageScript" entity="moqui.basic.LocalizedMessage"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>
            if (eecaOperation != "update" || localized != originalValue?.localized)
                UserSecurityChecks.assertTranslation(original, localized)
        </script></actions>
    </eeca>
    <eeca id="EmailTemplateScript" entity="moqui.basic.email.EmailTemplate"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>
            const updating = eecaOperation == "update"
            if (!updating || fromAddress != originalValue?.fromAddress)
                UserSecurityChecks.assertStoredTemplate(fromAddress, "EmailTemplate.fromAddress")
            if (!updating || fromName != originalValue?.fromName)
                UserSecurityChecks.assertStoredTemplate(fromName, "EmailTemplate.fromName")
            if (!updating || subject != originalValue?.subject)
                UserSecurityChecks.assertStoredTemplate(subject, "EmailTemplate.subject")
        </script></actions>
    </eeca>
    <eeca id="EmailTemplateAttachmentScript" entity="moqui.basic.email.EmailTemplateAttachment"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>
            const updating = eecaOperation == "update"
            if (!updating || fileName != originalValue?.fileName)
                UserSecurityChecks.assertStoredTemplate(fileName, "EmailTemplateAttachment.fileName")
            if (!updating || attachmentCondition != originalValue?.attachmentCondition)
                UserSecurityChecks.assertStoredExpression(attachmentCondition, "EmailTemplateAttachment.attachmentCondition")
            if (!updating || forEachIn != originalValue?.forEachIn)
                UserSecurityChecks.assertStoredExpression(forEachIn, "EmailTemplateAttachment.forEachIn")
        </script></actions>
    </eeca>
    <eeca id="SystemMessageRemoteScript" entity="moqui.service.message.SystemMessageRemote"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>
            if (eecaOperation != "update" || sendUrl != originalValue?.sendUrl)
                UserSecurityChecks.assertStoredTemplate(sendUrl, "SystemMessageRemote.sendUrl")
        </script></actions>
    </eeca>
    <!-- a plain claim name is no expression (what store#IdentityProvider writes) -->
    <eeca id="AuthFlowFieldMapScript" entity="moqui.security.sso.AuthFlowFieldMap"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>
            const updating = eecaOperation == "update"
            if (!updating || dstFieldExpression != originalValue?.dstFieldExpression)
                UserSecurityChecks.assertStoredExpression(dstFieldExpression, "AuthFlowFieldMap.dstFieldExpression")
            if ((!updating || srcFieldName != originalValue?.srcFieldName) &amp;&amp; srcFieldName
                    &amp;&amp; !/^[A-Za-z_][A-Za-z0-9_]*$/.test(String(srcFieldName)))
                UserSecurityChecks.assertStoredExpression(srcFieldName, "AuthFlowFieldMap.srcFieldName")
        </script></actions>
    </eeca>
    <!-- an artifact group member's filter map narrows an authorization, and an entity sync artifact's members are these rows
        (EntitySyncArtifactDetail is a view of them) -->
    <eeca id="ArtifactGroupMemberScript" entity="moqui.security.ArtifactGroupMember"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>
            if (eecaOperation != "update" || filterMap != originalValue?.filterMap)
                UserSecurityChecks.assertStoredExpression(filterMap, "ArtifactGroupMember.filterMap")
        </script></actions>
    </eeca>
    <eeca id="EntityFilterScript" entity="moqui.security.EntityFilter"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>
            if (eecaOperation != "update" || filterMap != originalValue?.filterMap)
                UserSecurityChecks.assertStoredExpression(filterMap, "EntityFilter.filterMap")
        </script></actions>
    </eeca>
    <eeca id="EntityFilterSetScript" entity="moqui.security.EntityFilterSet"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>
            if (eecaOperation != "update" || applyCond != originalValue?.applyCond)
                UserSecurityChecks.assertStoredExpression(applyCond, "EntityFilterSet.applyCond")
        </script></actions>
    </eeca>
    <eeca id="ArtifactAuthzFilterScript" entity="moqui.security.ArtifactAuthzFilter"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>
            if (eecaOperation != "update" || applyCond != originalValue?.applyCond)
                UserSecurityChecks.assertStoredExpression(applyCond, "ArtifactAuthzFilter.applyCond")
        </script></actions>
    </eeca>
    <eeca id="SubscreensItemMenuTitle" entity="moqui.screen.SubscreensItem"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>
            if (eecaOperation != "update" || menuTitle != originalValue?.menuTitle)
                UserSecurityChecks.assertStoredTemplate(menuTitle, "SubscreensItem.menuTitle")
        </script></actions>
    </eeca>
    <!-- a text block's ${name} placeholders are values put in as text where it is used (a queue's acknowledgement,
        mantle.request.RequestServices.send#IntakeConfirmation), never a template run; any other ${} in its body is held as
        one (plans/Security-Review.md SEC-BAP-81). Removing the placeholders first holds a ${ that removing one makes. The
        placeholder pattern is the one send#IntakeConfirmation fills in (mr-mantle service/mantle/request/RequestServices.xml);
        the two are kept the same. -->
    <eeca id="EmailTextBlockScript" entity="moqui.basic.email.EmailTextBlock"
            on-create="true" on-update="true" run-before="true" get-original-value="true">
        <actions><script>
            if (eecaOperation != "update" || bodyHtml != originalValue?.bodyHtml)
                UserSecurityChecks.assertStoredTemplate(String(bodyHtml ?? "").replace(/\$\{\s*[A-Za-z_][A-Za-z0-9_]*\s*\}/g, ""),
                    "EmailTextBlock.bodyHtml")
        </script></actions>
    </eeca>
    <!-- Where a whole-database backup goes is its download (plans/Security-Review-Medium.md SEC-TLS-83): a backup job's
        directory and mirror parameters, its service, and the address, credentials and message type of a remote a backup job
        mirrors to, and the send path of that type (the mirror's directory or key prefix), are changed only by a holder of
        the sealed ADMIN_BACKUP_DOWNLOAD, whatever screen or tool writes them (System's JobDetail and ConnectionDetail,
        Tools). The rules are BackupDestination.js, on get#BackupDestination's list, which backup#EmbeddedDatabase refuses
        another destination named in a call by (service/backup.rs). A data load runs with authorization disabled and is not
        checked. They are checks, so they run when the call already has errors too. -->
    <!-- Who made a job's user row, whatever wrote it: the user signed in, none for a data load (SEC-TLS-103). An update
        keeps the value the row was made with, whatever the request passed (an entity-auto update takes its parameters). A
        row with none is no consent of its user's: run#EtlMapping refuses to run as them by it. -->
    <eeca id="ServiceJobUserAddedBy" entity="moqui.service.job.ServiceJobUser" on-create="true" on-update="true"
            run-before="true" get-original-value="true" run-on-error="true">
        <actions><script>entityValue.addedByUserId = eecaOperation == 'create' ? (ec.user.userId || null)
            : (originalValue?.addedByUserId || null)</script></actions>
    </eeca>
    <eeca id="BackupDestinationParameter" entity="moqui.service.job.ServiceJobParameter"
            on-create="true" on-update="true" on-delete="true" run-before="true" get-original-value="true" run-on-error="true">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/BackupDestination.js')
            .parameter(eecaOperation, jobName, parameterName, parameterValue, originalValue)</script></actions>
    </eeca>
    <eeca id="BackupDestinationJob" entity="moqui.service.job.ServiceJob"
            on-update="true" run-before="true" get-original-value="true" run-on-error="true">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/BackupDestination.js')
            .job(eecaOperation, jobName, serviceName, originalValue)</script></actions>
    </eeca>
    <eeca id="BackupDestinationRemote" entity="moqui.service.message.SystemMessageRemote"
            on-create="true" on-update="true" run-before="true" get-original-value="true" run-on-error="true">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/BackupDestination.js')
            .remote(eecaOperation, systemMessageRemoteId, {sendUrl, username, password, privateKey, sharedSecret, sendSharedSecret,
                systemMessageTypeId}, originalValue)</script></actions>
    </eeca>
    <eeca id="BackupDestinationMessageType" entity="moqui.service.message.SystemMessageType"
            on-create="true" on-update="true" run-before="true" get-original-value="true" run-on-error="true">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/impl/BackupDestination.js')
            .messageType(eecaOperation, systemMessageTypeId, sendPath, originalValue)</script></actions>
    </eeca>
    <!-- The endpoint-change rule of ConfigurationConnections.js for every record that keeps a secret beside the address it
        is sent to, on every write path (plans/Security-Review-Low.md SEC-TLS-116; admin/EndpointSecrets.js moved): a change
        of an address field clears the stored secrets unless new ones are written with it, and says so; a model endpoint's
        and an entity sync's is a member of ADMIN's only. Only a seed or install load answers for itself. An AgentMcpServer's
        or AgentRemoteA2a's URL counts by its origin, as their store services decide; an EmailServer pointed at the edge
        node, or back from it, keeps its secrets (edge/setup.rs). -->
    <eeca id="LlmEndpointSecretMoves" entity="moqui.llm.LlmEndpoint" on-update="true" run-before="true" get-original-value="true">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/admin/EndpointSecrets.js')
            .moved(entityValue, originalValue, {endpoints: ['baseUrl', 'path', 'authHeader', 'authScheme', 'headersJson'], secrets: ['apiKey'], admin: true})</script></actions>
    </eeca>
    <eeca id="EntitySyncSecretMoves" entity="moqui.entity.sync.EntitySync" on-update="true" run-before="true" get-original-value="true">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/admin/EndpointSecrets.js')
            .moved(entityValue, originalValue, {endpoints: ['targetServerUrl', 'targetUsername'], secrets: ['targetPassword'], admin: true})</script></actions>
    </eeca>
    <eeca id="SystemMessageRemoteSecretMoves" entity="moqui.service.message.SystemMessageRemote" on-update="true" run-before="true" get-original-value="true">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/admin/EndpointSecrets.js')
            .moved(entityValue, originalValue, {endpoints: ['sendUrl', 'username', 'sendAuthEnumId', 'authHeaderName'],
                secrets: ['password', 'sharedSecret', 'sendSharedSecret', 'privateKey']})</script></actions>
    </eeca>
    <eeca id="ScrapeTargetSecretMoves" entity="moqui.monitor.ScrapeTarget" on-update="true" run-before="true" get-original-value="true">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/admin/EndpointSecrets.js')
            .moved(entityValue, originalValue, {endpoints: ['url'], secrets: ['bearerToken']})</script></actions>
    </eeca>
    <eeca id="EmailServerSecretMoves" entity="moqui.basic.email.EmailServer" on-update="true" run-before="true" get-original-value="true">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/admin/EndpointSecrets.js')
            .moved(entityValue, originalValue, {endpoints: ['smtpHost', 'smtpPort', 'smtpSsl', 'smtpStartTls', 'storeHost', 'storePort', 'mailUsername',
                'smtpUsername'], secrets: ['mailPassword', 'smtpPassword', 'oauthRefreshToken'], passThrough: ['edge:']})</script></actions>
    </eeca>
    <eeca id="AgentMcpServerSecretMoves" entity="moqui.agent.AgentMcpServer" on-update="true" run-before="true" get-original-value="true">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/admin/EndpointSecrets.js')
            .moved(entityValue, originalValue, {endpoints: ['url'], secrets: ['authJson'], origin: true})</script></actions>
    </eeca>
    <eeca id="AgentRemoteA2aSecretMoves" entity="moqui.agent.AgentRemoteA2a" on-update="true" run-before="true" get-original-value="true">
        <actions><script>ec.resource.script('component://framework/service/org/moqui/admin/EndpointSecrets.js')
            .moved(entityValue, originalValue, {endpoints: ['cardUrl'], secrets: ['authJson'], origin: true})</script></actions>
    </eeca>
    <!-- The new-device sign-in notice (mr-boss plan/impl-admin.md P10, design-admin §4 Sessions): a successful sign-in's
        history row is written by a worker after the sign-in itself (crates/moqui-core/src/user/login.rs save_history, at
        most one row a minute for a user), with its visit; the notice is decided and sent then, in a transaction of its own
        (a notification whose email cannot be sent marks its transaction rollback-only). It never fails the row: a failure
        is logged. -->
    <eeca id="UserLoginHistoryNewDevice" entity="moqui.security.UserLoginHistory" on-create="true">
        <condition><expression>successfulLogin == 'Y' &amp;&amp; !!visitId</expression></condition>
        <actions><script><![CDATA[
            ec.message.pushErrors()
            try {
                ec.service.sync().name('org.moqui.admin.IdentityServices.notify#NewDeviceSignIn')
                    .parameters({userId: userId, visitId: visitId, fromDate: fromDate}).requireNewTransaction(true).disableAuthz().call()
                if (ec.message.hasError()) ec.logger.error('New-device notice for ' + userId + ': ' + ec.message.getErrorsString())
            } catch (err) {
                ec.logger.error('New-device notice for ' + userId + ': ' + (err && err.message ? err.message : err))
            } finally { ec.message.clearErrors(); ec.message.popErrors() }
        ]]></script></actions>
    </eeca>
</eecas>
