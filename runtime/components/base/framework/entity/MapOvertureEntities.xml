<!-- Optional Overture data for Maps (plans/archive/Maps-Overture.md §4, stages O1 and O2 of plans/archive/Maps.md §4.3): the themes with
    their licenses, an administrator's regions, the runs that import a theme of a region from a pinned release, and the
    places and address points of each run. An import writes only these, its PMTiles archives and its own map layer: never a Mantle record, a Geo,
    a point or a record's location. The services are service/org/moqui/maps/OvertureServices.xml; the reader is the
    moqui-maps crate, linked under the host's overture feature. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-entity-definition.xsd">

    <!-- A theme imported, seeded: PLACES and BUILDINGS (O1), ADDRESSES (O2). licenses is the source licenses an administrator's
        acknowledgement covers (comma separated SPDX IDs); a run that finds another is held for review (OviReview) until
        it is acknowledged too. -->
    <entity entity-name="OvertureTheme" package="moqui.maps" use="configuration" cache="true">
        <field name="themeId" type="id" is-pk="true"/>
        <field name="themeName" type="text-medium"/>
        <field name="overtureTheme" type="text-short"><description>The catalog's theme (places, buildings)</description></field>
        <field name="overtureType" type="text-short"><description>The collection of the theme (place, building)</description></field>
        <field name="description" type="text-long"/>
        <field name="licenseName" type="text-medium"><description>The theme's license in words</description></field>
        <field name="licenseUrl" type="text-medium"/>
        <field name="attribution" type="text-long"><description>Shown with its layer, its search results and beside its
            data in Configuration</description></field>
        <field name="licenses" type="text-long"><description>The source licenses the acknowledgement covers, comma separated</description></field>
        <field name="obligations" type="text-long"><description>What its license asks of an installation that uses or
            shares the data (ODbL's for a derived database)</description></field>
        <field name="licenseAckUserId" type="id" enable-audit-log="true"/>
        <field name="licenseAckDate" type="date-time" enable-audit-log="true"/>
        <field name="disabled" type="text-indicator"/>
    </entity>

    <!-- An administrator's region: a box of at most maps@overture-max-area km², the release to import (a version of the
        catalog; a run records the one it read) and the profile its Buildings layer is shown in. -->
    <entity entity-name="OvertureRegion" package="moqui.maps" use="configuration" cache="never">
        <field name="regionId" type="id" is-pk="true"/>
        <field name="regionName" type="text-medium"/>
        <field name="west" type="number-float"/>
        <field name="south" type="number-float"/>
        <field name="east" type="number-float"/>
        <field name="north" type="number-float"/>
        <field name="releaseVersion" type="text-short"><description>The release the next import reads; empty for the
            catalog's latest when it starts, recorded on the run</description></field>
        <field name="profileId" type="id"><description>The map profile its Buildings layer is added to when one is
            activated</description></field>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <relationship type="one-nofk" related="moqui.maps.MapProfile" short-alias="profile"/>
    </entity>

    <!-- A theme of a region: its active run and the one before it (kept for rollback), and its layer (Buildings) -->
    <entity entity-name="OvertureRegionTheme" package="moqui.maps" use="configuration" cache="never">
        <field name="regionId" type="id" is-pk="true"/>
        <field name="themeId" type="id" is-pk="true"/>
        <field name="activeImportId" type="id" enable-audit-log="true"/>
        <field name="previousImportId" type="id"/>
        <field name="layerId" type="id"/>
        <relationship type="one" related="moqui.maps.OvertureRegion" short-alias="region"/>
        <relationship type="one" related="moqui.maps.OvertureTheme" short-alias="theme"/>
        <relationship type="one-nofk" title="Active" related="moqui.maps.OvertureImport" short-alias="active">
            <key-map field-name="activeImportId" related="importId"/></relationship>
    </entity>

    <!-- A run: one theme of one region from one release. Staged rows (OverturePlace) and an archive (Buildings) are its own
        until it is activated; a failed, cancelled or removed run's are deleted, and the active run stays as it was. -->
    <entity entity-name="OvertureImport" package="moqui.maps" use="transactional" cache="never">
        <field name="importId" type="id" is-pk="true"/>
        <field name="regionId" type="id"/>
        <field name="themeId" type="id"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="releaseVersion" type="text-short"/>
        <field name="schemaVersion" type="text-short"/>
        <field name="filesRead" type="number-integer"/>
        <field name="rowGroupsRead" type="number-integer"/>
        <field name="rowGroupsSkipped" type="number-integer"/>
        <field name="bytesRead" type="number-integer"/>
        <field name="rowsRead" type="number-integer"/>
        <field name="rowsKept" type="number-integer"/>
        <field name="rowsRejected" type="number-integer"/>
        <field name="licensesJson" type="text-very-long"><description>The rows of each source dataset and license, as
            [{dataset, license, rows}]</description></field>
        <field name="newLicenses" type="text-medium"><description>The licenses found that the theme's acknowledgement
            did not cover: the run waits for review</description></field>
        <field name="rejectionsJson" type="text-very-long"><description>The first rows rejected, each with why</description></field>
        <field name="countryCodes" type="text-short"><description>Addresses: the countries of its rows (ISO alpha-2, comma
            separated), which the local geocoder reads a text as when no country is given</description></field>
        <field name="changesJson" type="text-long"><description>Addresses: what it changed against the run active when it was
            read, by address (country, street, number, unit and postal code; never by GERS ID, which Overture does not keep
            stable for addresses): {comparedWith, added, removed, moved, unchanged}</description></field>
        <field name="archiveLocation" type="text-medium"><description>Buildings: its PMTiles archive</description></field>
        <field name="archiveSize" type="number-integer"/>
        <field name="tileCount" type="number-integer"/>
        <field name="maxZoom" type="number-integer"/>
        <field name="minLongitude" type="number-float"/><field name="minLatitude" type="number-float"/>
        <field name="maxLongitude" type="number-float"/><field name="maxLatitude" type="number-float"/>
        <field name="forced" type="text-indicator"><description>Y: activated with far fewer rows than the run active
            before it</description></field>
        <field name="cancelRequested" type="text-indicator"/>
        <field name="failureText" type="text-long"/>
        <field name="reasonCode" type="text-short"/>
        <field name="jobRunId" type="id"/>
        <field name="userId" type="id"/>
        <field name="startedDate" type="date-time"/>
        <field name="lastProgressDate" type="date-time"/>
        <field name="finishedDate" type="date-time"/>
        <field name="activatedDate" type="date-time"/>
        <!-- no foreign key: a run's row is its history, kept when its region is removed -->
        <relationship type="one-nofk" related="moqui.maps.OvertureRegion" short-alias="region"/>
        <relationship type="one" related="moqui.maps.OvertureTheme" short-alias="theme"/>
        <relationship type="one" title="OvertureImport" related="moqui.basic.StatusItem" short-alias="status"/>
        <relationship type="one-nofk" related="moqui.service.job.ServiceJobRun" short-alias="jobRun"/>
        <relationship type="one-nofk" related="moqui.security.UserAccount"/>
        <index name="MAPS_OVT_IMPORT_RG"><index-field name="regionId"/><index-field name="themeId"/></index>
        <seed-data>
            <moqui.basic.StatusType description="Overture Import" statusTypeId="OvertureImport"/>
            <moqui.basic.StatusItem description="Pending" sequenceNum="1" statusId="OviPending" statusTypeId="OvertureImport"/>
            <moqui.basic.StatusItem description="Reading" sequenceNum="2" statusId="OviRunning" statusTypeId="OvertureImport"/>
            <moqui.basic.StatusItem description="Waiting for license review" sequenceNum="3" statusId="OviReview" statusTypeId="OvertureImport"/>
            <moqui.basic.StatusItem description="Active" sequenceNum="4" statusId="OviActive" statusTypeId="OvertureImport"/>
            <moqui.basic.StatusItem description="Previous (kept for rollback)" sequenceNum="5" statusId="OviPrevious" statusTypeId="OvertureImport"/>
            <moqui.basic.StatusItem description="Rolled back" sequenceNum="6" statusId="OviRolledBack" statusTypeId="OvertureImport"/>
            <moqui.basic.StatusItem description="Superseded" sequenceNum="7" statusId="OviSuperseded" statusTypeId="OvertureImport"/>
            <moqui.basic.StatusItem description="Failed" sequenceNum="8" statusId="OviFailed" statusTypeId="OvertureImport"/>
            <moqui.basic.StatusItem description="Cancelled" sequenceNum="9" statusId="OviCancelled" statusTypeId="OvertureImport"/>
            <moqui.basic.StatusItem description="Removed" sequenceNum="10" statusId="OviRemoved" statusTypeId="OvertureImport"/>
            <moqui.basic.StatusItem description="Discarded" sequenceNum="11" statusId="OviDiscarded" statusTypeId="OvertureImport"/>
        </seed-data>
    </entity>

    <!-- A place of a run. placeId is internal (the run and the row's place in it); gersId with the run's release is the
        external reference, which a later release may change (GERS stability varies). Search reads the places of active
        runs only. -->
    <entity entity-name="OverturePlace" package="moqui.maps" use="transactional" cache="never">
        <field name="placeId" type="id-long" is-pk="true"/>
        <field name="importId" type="id"/>
        <field name="gersId" type="text-short"/>
        <field name="featureVersion" type="number-integer"/>
        <field name="placeName" type="text-medium"/>
        <field name="nameSearch" type="text-medium"><description>placeName in lower case, for search</description></field>
        <field name="basicCategory" type="text-short"/>
        <field name="taxonomyPrimary" type="text-short"/>
        <field name="latitude" type="number-float"/>
        <field name="longitude" type="number-float"/>
        <field name="confidence" type="number-float"/>
        <field name="operatingStatus" type="text-short"/>
        <field name="brandName" type="text-medium"/>
        <field name="addressText" type="text-medium"/>
        <field name="locality" type="text-medium"/>
        <field name="region" type="text-short"/>
        <field name="postcode" type="text-short"/>
        <field name="countryCode" type="text-short"/>
        <field name="sourceDatasets" type="text-medium"/>
        <field name="sourceLicenses" type="text-medium"/>
        <relationship type="one" related="moqui.maps.OvertureImport" short-alias="import"/>
        <index name="MAPS_OVT_PLACE_IMPORT"><index-field name="importId"/><index-field name="nameSearch"/></index>
        <index name="MAPS_OVT_PLACE_GERS"><index-field name="gersId"/></index>
    </entity>

    <!-- An address point of an Addresses run (O2): the local geocoder's index (MPK_GEOCODER_OVERTURE; moqui-maps
        address.rs and address_service.rs). addressId is internal (the run and the row's place in it); gersId with the
        run's release is an external reference only: Overture's address IDs are not stable. The *Norm fields are the
        matching's keys (case, diacritics and the street words of the country's languages folded); the others are as the
        source wrote them. positionKind is what the point stands for when its source says (an entrance, a building or
        parcel centre, a road position): Overture's schema 2.0 says none, so it is empty and a match says the kind is not
        stated. Nothing links to a row across runs, and no record, Geo or point is written from one. -->
    <entity entity-name="OvertureAddress" package="moqui.maps" use="transactional" cache="never">
        <field name="addressId" type="id-long" is-pk="true"/>
        <field name="importId" type="id"/>
        <field name="gersId" type="text-short"/>
        <field name="featureVersion" type="number-integer"/>
        <field name="countryCode" type="text-short"><description>ISO 3166-1 alpha-2</description></field>
        <field name="streetName" type="text-medium"/>
        <field name="streetNorm" type="text-medium"/>
        <field name="houseNumber" type="text-short"/>
        <field name="numberNorm" type="text-short"/>
        <field name="unitText" type="text-short"/>
        <field name="unitNorm" type="text-short"/>
        <field name="postcode" type="text-short"/>
        <field name="postcodeNorm" type="text-short"/>
        <field name="postalCity" type="text-medium"/>
        <field name="locality" type="text-medium"><description>The last (most particular) address level</description></field>
        <field name="region" type="text-short"><description>The first address level, when there are several</description></field>
        <field name="levelsText" type="text-medium"><description>Every address level, the most general first, separated by " | "</description></field>
        <field name="latitude" type="number-float"/>
        <field name="longitude" type="number-float"/>
        <field name="positionKind" type="text-short"/>
        <field name="sourceDatasets" type="text-medium"/>
        <field name="sourceLicenses" type="text-medium"/>
        <relationship type="one" related="moqui.maps.OvertureImport" short-alias="import"/>
        <index name="MAPS_OVT_ADDR_STREET"><index-field name="importId"/><index-field name="streetNorm"/><index-field name="numberNorm"/></index>
    </entity>
</entities>
