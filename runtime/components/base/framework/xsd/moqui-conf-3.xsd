    <xs:element name="media-server">
        <xs:annotation><xs:documentation>Call media (the rtc feature, docs/interfaces/WebRTC.md) and its TURN server (docs/interfaces/TURN.md).</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" name="turn-server"><xs:complexType>
                    <xs:attribute name="port" type="xs:string"/>
                    <xs:attribute name="tls-port" type="xs:string"/>
                    <xs:attribute name="tls443-host" type="xs:string"/>
                    <xs:attribute name="host" type="xs:string"/>
                    <xs:attribute name="public-host" type="xs:string"/>
                    <xs:attribute name="relay-ports" type="xs:string" default="49152-65535"/>
                    <xs:attribute name="credential-hours" type="xs:string" default="4"/>
                    <xs:attribute name="external-urls" type="xs:string"/>
                    <xs:attribute name="max-allocations" type="xs:string" default="1000"/>
                    <xs:attribute name="max-kbps" type="xs:string" default="4000"/>
                    <xs:attribute name="allowed-peers" type="xs:string"/>
                    <xs:attribute name="auth-secret" type="xs:string"><xs:annotation><xs:documentation>A secret.</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
            </xs:sequence>
            <xs:attribute name="port" type="xs:string"/>
            <xs:attribute name="host" type="xs:string" default="127.0.0.1"/>
            <xs:attribute name="tcp-port" type="xs:string"/>
            <xs:attribute name="public-address" type="xs:string"/>
            <xs:attribute name="cascade-enabled" type="xs:string" default="false"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="calls">
        <xs:annotation><xs:documentation>Calls: ringing, transfers, forwards, the queue, recording and captions (docs/interfaces/WebRTC.md).</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" name="captions"><xs:complexType>
                    <xs:attribute name="enabled" type="xs:string" default="false"/>
                    <xs:attribute name="provider" type="xs:string" default="llm"/>
                    <xs:attribute name="chunk-seconds" type="xs:string" default="5"/>
                    <xs:attribute name="queue" type="xs:string" default="6"/>
                    <xs:attribute name="workers" type="xs:string" default="2"/>
                    <xs:attribute name="timeout-seconds" type="xs:string" default="20"/>
                    <xs:attribute name="language" type="xs:string"/>
                    <xs:attribute name="store" type="xs:string" default="false"/>
                    <xs:attribute name="retention-days" type="xs:string" default="30"><xs:annotation><xs:documentation>The days a caption kept by store is kept: expire#Recordings removes older ones; 0 keeps them.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="prompt-audio" type="xs:string"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" name="queue"><xs:complexType>
                    <xs:attribute name="tick-seconds" type="xs:string" default="5"/>
                    <xs:attribute name="prompt-location" type="xs:string"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" name="recording"><xs:complexType>
                    <xs:attribute name="enabled" type="xs:string" default="false"/>
                    <xs:attribute name="ack-required" type="xs:string" default="false"/>
                    <xs:attribute name="policy-revision" type="xs:string" default="1"/>
                    <xs:attribute name="retention-days" type="xs:string" default="90"/>
                    <xs:attribute name="queue-frames" type="xs:string" default="4096"/>
                    <xs:attribute name="segment-mb" type="xs:string" default="64"/>
                    <xs:attribute name="segment-minutes" type="xs:string" default="30"/>
                    <xs:attribute name="max-mb" type="xs:string" default="2048"/>
                    <xs:attribute name="prompt-audio" type="xs:string"/>
                </xs:complexType></xs:element>
            </xs:sequence>
            <xs:attribute name="ring-seconds" type="xs:string" default="45"/>
            <xs:attribute name="guest-joins-per-minute" type="xs:string" default="20"/>
            <xs:attribute name="transfer-ring-seconds" type="xs:string" default="30"/>
            <xs:attribute name="hold-music-location" type="xs:string"/>
            <xs:attribute name="direct-path" type="xs:string" default="true"/>
            <xs:attribute name="forward-ring-seconds" type="xs:string" default="30"/>
            <xs:attribute name="forward-max-hops" type="xs:string" default="5"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="voicemail">
        <xs:annotation><xs:documentation>Voicemail (docs/interfaces/Voicemail.md).</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="max-seconds" type="xs:string" default="120"/>
            <xs:attribute name="prompt-location" type="xs:string"/>
            <xs:attribute name="trash-days" type="xs:string" default="30"/>
            <xs:attribute name="transcribe" type="xs:string" default="false"/>
            <xs:attribute name="transcribe-language" type="xs:string"/>
            <xs:attribute name="pin-min-digits" type="xs:string" default="6"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="pass-authority">
        <xs:annotation><xs:documentation>The PASS authority: its gRPC listener, the service that answers a call, the
            verification template, the SSO flows, and each client by its id.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" name="client"><xs:complexType>
                <xs:attribute name="id" type="xs:string" use="required"/>
                <xs:attribute name="sites" type="xs:string"/>
                <xs:attribute name="callback" type="xs:string"/>
                <xs:attribute name="secret" type="xs:string"><xs:annotation><xs:documentation>A secret.</xs:documentation></xs:annotation></xs:attribute>
            </xs:complexType></xs:element></xs:sequence>
            <xs:attribute name="grpc-enabled" type="xs:string" default="false"/>
            <xs:attribute name="grpc-host" type="xs:string"/>
            <xs:attribute name="grpc-port" type="xs:string" default="4317"/>
            <xs:attribute name="grpc-insecure" type="xs:string" default="false"/>
            <xs:attribute name="service" type="xs:string" default="mantle.pass.PassAuthorityServices.handle#Call"/>
            <xs:attribute name="verification-template" type="xs:string"/>
            <xs:attribute name="sso-flows" type="xs:string"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="database-backup">
        <xs:annotation><xs:documentation>Backups of the embedded database.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="scheduled" type="xs:string"/>
            <xs:attribute name="dir" type="xs:string"/>
            <xs:attribute name="recipient" type="xs:string"><xs:annotation><xs:documentation>An age X25519 recipient
                (age1...) each dump of backup#EmbeddedDatabase is sealed to as it is written, as name.dump.age; empty
                writes them as they are. A recipient that does not parse fails the backup. No Java
                counterpart.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="comms">
        <xs:annotation><xs:documentation>The basic-comms component's settings, set in its MoquiConf.xml.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="app-root" type="xs:string" default="/qapps/BasicComms"><xs:annotation><xs:documentation>Where
                links to the Comms screens go in notifications, mail and push: an app that mounts the BasicComms screens
                under its own root (IronStone BOSS: /qapps/Comms) sets it to that root.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="demo">
        <xs:annotation><xs:documentation>The demo component's settings, set in its MoquiConf.xml.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="shared-user-ids" type="xs:string"><xs:annotation><xs:documentation>The users whose
                password, sign-in factors, username and enabled state cannot be changed, comma separated: the shared
                login of the Login screen's Test Login button.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="test-login" type="xs:string" default="false"><xs:annotation><xs:documentation>Whether the
                Login screen offers the Test Login button, which a production instance otherwise leaves
                out.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="smtp-server">
        <xs:annotation><xs:documentation>The inbound SMTP listener for hosted and shared mail accounts, behind the edge
            gateway (docs/interfaces/Mail-Inbound.md).</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="listen-port" type="xs:string"><xs:annotation><xs:documentation>The port to bind; empty leaves the listener off, 0 binds an ephemeral port.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="listen-host" type="xs:string" default="127.0.0.1"><xs:annotation><xs:documentation>The address to bind.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="allowed-addresses" type="xs:string"><xs:annotation><xs:documentation>The gateway's IPs and CIDRs, comma separated; an empty list does not start the listener, except in internet mode, where it takes any address.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="hostname" type="xs:string"><xs:annotation><xs:documentation>The name in the greeting and the Received field; the webapp host when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="authserv-id" type="xs:string"><xs:annotation><xs:documentation>The authserv-id of the gateway's Authentication-Results; only those are kept.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="proxy-protocol" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Each connection starts with a PROXY v1 or v2 header, whose address must be allowed too.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="spam-headers" type="xs:string" default="X-Spam-Flag,X-Spam-Status,X-Spam"><xs:annotation><xs:documentation>The gateway's spam verdict fields; mail one of them says yes to goes to Junk.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="plus-separator" type="xs:string" default="+"><xs:annotation><xs:documentation>The plus-addressing characters (sales+news@ is sales@); none turns it off.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-message-size" type="non-neg-int-expandable" default="26214400"><xs:annotation><xs:documentation>The largest message, in bytes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-recipients" type="non-neg-int-expandable" default="100"><xs:annotation><xs:documentation>The most recipients of one message.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-connections" type="non-neg-int-expandable" default="20"><xs:annotation><xs:documentation>The most connections at once.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="command-timeout" type="non-neg-int-expandable" default="300"><xs:annotation><xs:documentation>Seconds for each command or data chunk.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="session-timeout" type="non-neg-int-expandable" default="1800"><xs:annotation><xs:documentation>Seconds for a whole session.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="protocol" default="smtp"><xs:annotation><xs:documentation>smtp, or lmtp (RFC 2033): LHLO, and a reply per recipient after the data.</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="smtp"/><xs:enumeration value="lmtp"/></xs:restriction></xs:simpleType></xs:attribute>
            <xs:attribute name="starttls" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Offer STARTTLS (RFC 3207). With no certificate the listener does not start.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="require-tls" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Refuse MAIL before STARTTLS (530); needs starttls.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="tls-cert-file" type="xs:string"><xs:annotation><xs:documentation>The certificate (and chain) PEM file of STARTTLS, absolute or under the runtime directory; empty for runtime/cert by the name asked for or hostname.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="tls-key-file" type="xs:string"><xs:annotation><xs:documentation>The private key PEM file that goes with tls-cert-file.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="chunking" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>CHUNKING (RFC 3030): BDAT.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="dsn" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>DSN (RFC 3461): RET, ENVID, NOTIFY and ORCPT are taken and kept, and NOTIFY=SUCCESS gets a "delivered" report when the sender is authenticated (authserv-id set, and spf=pass or dmarc=pass with header.from aligned with the envelope sender).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="internet" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Take mail from the internet (port 25, the MTA in moqui): no allowed-addresses needed, STARTTLS on by default, per-address limits, and after the data SPF, DKIM, DMARC and ARC checked with an Authentication-Results of its own (forged ones removed), the Rspamd verdict when rspamd-url is set, a DMARC reject policy refused with 550 and quarantine to Junk (RFC 9989: t=y lowers the policy, no pct; a passing ARC seal of arc-trusted-sealers overrides it). Rspamd not reached fails open (logged, not spam); checks that do not finish in 45 seconds answer 451.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-connections-per-ip" type="non-neg-int-expandable" default="5"><xs:annotation><xs:documentation>In internet mode, the most connections at once from one address.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="connections-per-minute" type="non-neg-int-expandable" default="30"><xs:annotation><xs:documentation>In internet mode, the most new connections a minute from one address.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="internet-messages-per-hour" type="non-neg-int-expandable" default="1000"><xs:annotation><xs:documentation>In internet mode, the most messages stored in an hour from one client address (IPv6 by its /64) and from one envelope sender, whichever is reached first; a MAIL past it is answered 451 4.7.1. A message counts once, whatever its recipients.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="internet-bytes-per-hour" type="non-neg-int-expandable" default="1073741824"><xs:annotation><xs:documentation>In internet mode, the most bytes of messages stored in an hour from one client address and from one envelope sender, with a MAIL's SIZE counted; past it a MAIL is answered 451 4.7.1.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="rspamd-url" type="xs:string"><xs:annotation><xs:documentation>In internet mode, Rspamd's HTTP API (http://127.0.0.1:11333); no spam check when empty. Rspamd not reached fails open: the mail is taken as not spam, logged.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="arc-trusted-sealers" type="xs:string"><xs:annotation><xs:documentation>In internet mode, the domains whose passing ARC seal overrides a DMARC reject or quarantine (forwarders and lists this node trusts), comma separated; empty for no ARC exception.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="mail-delivery">
        <xs:annotation><xs:documentation>Mail delivery and DKIM (plans/archive/Edge-Node.md §5.4).</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence><xs:element minOccurs="0" ref="dkim"/></xs:sequence>
            <xs:attribute name="mta" type="xs:string"><xs:annotation><xs:documentation>On an edge node: moqui for the MTA in moqui, empty or postfix for the relay to Postfix at relay-host and relay-port.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="relay-host" type="xs:string" default="127.0.0.1"><xs:annotation><xs:documentation>The Postfix beside an edge node.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="relay-port" type="non-neg-int-expandable" default="10025"/>
            <xs:attribute name="bounce-domain" type="xs:string"><xs:annotation><xs:documentation>On an edge node, the
                domain of the envelope sender of mail it sends out (bounce+item@domain), whose bounces the SMTP listener
                takes back to the message; empty sends from the message's own sender.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="retry-seconds" type="non-neg-int-expandable" default="300"><xs:annotation><xs:documentation>The MTA's first retry wait, doubled each time to 4 hours.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="days" type="non-neg-int-expandable" default="5"><xs:annotation><xs:documentation>When a message not delivered goes back as a bounce.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="mx-require-tls" type="xs:string"><xs:annotation><xs:documentation>The recipient domains whose MX gets mail only over STARTTLS with a certificate valid for the host, comma separated, * for every domain; empty: STARTTLS when offered, any certificate, else clear text.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="mx-override" type="xs:string"><xs:annotation><xs:documentation>Testing and staging only: domain=host:port pairs, * for any, in place of the MX.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="dns-offline" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Testing only: make no DNS query.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="dkim">
        <xs:annotation><xs:documentation>The node's DKIM signing.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="key" type="xs:string"><xs:annotation><xs:documentation>A secret: the private key (base64 PKCS#8 DER, or PEM), made (RSA-2048) into runtime/.env the first time a server needs it.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="selector" type="xs:string" default="moqui"/>
            <xs:attribute name="domains" type="xs:string"><xs:annotation><xs:documentation>The domains signed for, comma separated; empty for the hosted and shared accounts' domains.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="edge">
        <xs:annotation><xs:documentation>How work crosses the edge link between a local node and its edge node
            (plans/archive/Edge-Node.md §5.2), read by both ends. Each child is merged by its key.
        </xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" name="node"><xs:annotation><xs:documentation>A local node's pairing with its
                    edge node, written by pairing (key is a secret) and the Edge Apply wizard.</xs:documentation></xs:annotation>
                    <xs:complexType>
                    <xs:attribute name="url" type="xs:string"/>
                    <xs:attribute name="key" type="xs:string"/>
                    <xs:attribute name="pin" type="xs:string"/>
                    <xs:attribute name="id" type="xs:string"/>
                    <xs:attribute name="pairing" type="xs:string"/>
                    <xs:attribute name="calls-enabled" type="xs:string"/>
                    <xs:attribute name="sip-enabled" type="xs:string"/>
                    <xs:attribute name="pass-client" type="xs:string"/>
                    </xs:complexType></xs:element>
                <xs:element minOccurs="0" name="front-node"><xs:annotation><xs:documentation>A pairing with a front
                    node (plans/Edge-Node2.md §4.7), as node.</xs:documentation></xs:annotation>
                    <xs:complexType>
                    <xs:attribute name="url" type="xs:string"/>
                    <xs:attribute name="key" type="xs:string"/>
                    <xs:attribute name="pin" type="xs:string"/>
                    <xs:attribute name="id" type="xs:string"/>
                    </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="delegate">
                    <xs:annotation><xs:documentation>A service an edge node (moqui_conf__instance__node_role=front_edge) runs on its local node
                        instead of itself, for a synchronous call (an async call or a scheduled job runs where it was
                        queued): the call goes down the link at once and fails with "local node offline" while the link
                        is down. An all-in-one node (moqui_conf__instance__node_role=all-in-one) delegates only a call for a paired node's
                        item, to that node; the same service runs there for the server's own items. With the service's definition on the edge node, its authorization and authenticate are
                        checked there first. The local node runs it as the user _EDGE_, with authorization, and only
                        when its own conf lists it too. Credentials (auth parameters) are never
                        passed.</xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="service" type="xs:string" use="required"/>
                        <xs:attribute name="allow-anonymous" type="boolean" default="false"><xs:annotation>
                            <xs:documentation>When the edge node has no definition of the service, a caller with no user
                            is refused unless this is true (a comms engine's webhook).</xs:documentation>
                        </xs:annotation></xs:attribute>
                        <xs:attribute name="timeout-seconds" type="xs:string"><xs:annotation>
                            <xs:documentation>How long the edge node waits for the local node's answer, when shorter
                            than the link's answer timeout (60 seconds): for a caller that cannot wait that long, such
                            as the SIP engine routing a call while the caller's phone rings. Past it the call fails as
                            the local node not answering in time.</xs:documentation>
                        </xs:annotation></xs:attribute>
        </xs:complexType>
                </xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="queue-kind">
                    <xs:annotation><xs:documentation>The service that applies a queued item of this kind on its
                        receiver, as the user _EDGE_, in the transaction that writes the item's receipt first. A node
                        enqueues only the kinds it lists. A payload is at most 1 MiB, a larger body is its content. It gets kind, conversationKey,
                        idempotencyKey, queueItemId, pairedNodeId, payload and contentLocation (where the receiver
                        kept the item's content); an error it adds fails the item, which is tried again and counted,
                        and a result retryLater (the reason) rolls it back to wait, not counted.</xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                        <xs:attribute name="service" type="xs:string" use="required"/>
                        <xs:attribute name="failed-service" type="xs:string">
                            <xs:annotation><xs:documentation>Called on the sender for an item of this kind that failed
                                for good (its last refusal, the retention period, the size cap, unpairing), with
                                queueItemId, kind, conversationKey, payload and error, so the failure is not
                                silent.</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="replicate">
                    <xs:annotation><xs:documentation>A set of records a local node copies to its edge node, read-only
                        there (moqui.edge.EdgeReplicaValue): each committed change is sent after commit, and the whole
                        set again when the edge node has lost its copy.</xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element minOccurs="1" maxOccurs="unbounded" name="entity">
                                <xs:complexType>
                                    <xs:attribute name="name" type="xs:string" use="required"/>
                                    <xs:attribute name="fields" type="xs:string"><xs:annotation><xs:documentation>The
                                        fields copied besides the primary key, comma separated: only those the edge node
                                        needs.</xs:documentation></xs:annotation></xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="set" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="public-addresses" type="xs:string"><xs:annotation><xs:documentation>An edge node's public
                IP addresses, comma or space separated, which its offer gives the local node for its DNS records (every
                member's on an edge cluster).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="queue-retention-days" type="non-neg-int-expandable" default="14">
                <xs:annotation><xs:documentation>Days a delivered or failed item (from its delivery or failure) and a
                    receipt are kept; an item still waiting after that fails. Both nodes should keep the same period.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="queue-max-megabytes" type="non-neg-int-expandable" default="1024">
                <xs:annotation><xs:documentation>The waiting items' payloads and content at most, for each paired
                    node alone (on a node that takes links, a pairing's EdgeClient.queueMaxMegabytes above 0 in place of
                    it); past it that node's oldest fail. The content a paired node's link sends before its
                    deliveries, kept until each is answered, counts against it too: at it the pairing pauses on an
                    edge node (as at replica-max-rows), and a local node refuses more content from its edge node for
                    now, and tells its administrators (EdgeContentRefused) once until it takes content again.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="queue-max-content-files" type="non-neg-int-expandable" default="10000">
                <xs:annotation><xs:documentation>The content files a paired node's link sends before its deliveries,
                    kept until each is answered, at most for one pairing, whatever their size (an empty one counts):
                    at it the pairing pauses on an edge node, as at queue-max-megabytes, and a local node refuses more
                    from its edge node for now. 0 for no cap.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="link-key" type="xs:string"/>
            <xs:attribute name="link-url" type="xs:string"/>
            <xs:attribute name="offline-page" type="xs:string"/>
            <xs:attribute name="ssh-tunnel-port" type="xs:string"/>
            <xs:attribute name="ssh-tunnel-host" type="xs:string"/>
            <xs:attribute name="smtp-tunnel-host" type="xs:string"/>
            <xs:attribute name="xmpp-port" type="xs:string"/>
            <xs:attribute name="xmpp-tls-port" type="xs:string"/>
            <xs:attribute name="xmpp-host" type="xs:string"/>
            <xs:attribute name="call-legs-per-pairing" type="xs:string"/>
            <xs:attribute name="replica-max-rows" type="non-neg-int-expandable" default="1000000">
                <xs:annotation><xs:documentation>On a node that takes links, the replicated records it keeps for one
                    pairing at most, all its sets together (a pairing's EdgeClient.replicaMaxRows above 0 in place of
                    it). At it the pairing pauses: its Replicate and PutContent calls are refused as "try again
                    later", nothing dropped, and the administrators are told (EdgePairingPaused), until one resumes
                    it or raises its caps (System, Edge Clients).
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="queue-max-attempts" type="non-neg-int-expandable" default="10">
                <xs:annotation><xs:documentation>Refusals by the receiver before an item fails for good.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="queue-retry-seconds" type="xs:string" default="5">
                <xs:annotation><xs:documentation>The wait after the first refusal, doubling up to 10 minutes; a decimal.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="sticky-cookie" type="xs:string" default="moqui.session">
                <xs:annotation><xs:documentation>On a node with the front set, balancing a pool (plans/Edge-Node2.md
                    §4.4): the cookie whose value picks the member for a terminate host's request, by rendezvous hashing
                    over the live members, where the host names none (EdgeHost.stickyCookie). A request without it goes
                    round robin. The session cookie's name by default.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="set-aside-failures" type="non-neg-int-expandable" default="3">
                <xs:annotation><xs:documentation>The requests, calls or tunnel opens in a row that fail or time out
                    before a pool member is set aside: it gets no new work for set-aside-seconds, unless no other member
                    is live, then it is tried again. At least 1.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="set-aside-seconds" type="non-neg-int-expandable" default="30">
                <xs:annotation><xs:documentation>How long a member is set aside before it is tried again.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="forward-idle-seconds" type="non-neg-int-expandable" default="120">
                <xs:annotation><xs:documentation>On a node with the front set, a terminate host's request forwarded down
                    a link: the longest gap in its body as it goes down before it is answered 504. The member taking
                    the request (10 seconds), this gap and forward-head-seconds bound a request with a body, so an
                    upload answered once it is stored (Git LFS, CI artifacts) takes as long as its body takes to send.
                    This node's own request-timeout (web-protection requests) does not apply to a forwarded request:
                    the member applies its own. At least 1, at most 86400.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="forward-head-seconds" type="non-neg-int-expandable" default="3600">
                <xs:annotation><xs:documentation>The longest wait for a forwarded request's answer head once its body is
                    all sent, before it is answered 504; never shorter than forward-idle-seconds after the body last
                    moved. At least 1, at most 86400.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="forward-first-byte-seconds" type="non-neg-int-expandable" default="30">
                <xs:annotation><xs:documentation>The longest wait for the answer head of a forwarded GET or HEAD with
                    no body, at most forward-head-seconds; any other request with no body (a POST, a DELETE) is never
                    sent again and waits forward-head-seconds. Past it the GET or HEAD goes once more to another member
                    and the first member counts a failure toward set-aside-failures, so a hung member is set aside;
                    when it goes to no other member (none, or the second try) the timeout is not counted, since it says
                    only that the answer is slow. A GET whose answer takes longer to start (a slow report) is answered
                    504, so raise it for one. At least 1.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="ssh-tunnels" type="non-neg-int-expandable" default="256">
                <xs:annotation><xs:documentation>SSH connections piped at once by the SSH tunnel port
                    (edge@ssh-tunnel-port), and by each pairing's own SSH port (an EdgePort row); each also counts
                    toward a link's tunnels. At least 1.
                </xs:documentation></xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="logging">
        <xs:annotation><xs:documentation>The log files moqui.log (all events) and moqui-error.log (warn and error),
            and the log on stderr.
        </xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="level" type="xs:string" default="info"><xs:annotation><xs:documentation>The stderr log: trace, debug, info, warn or error. Read before boot from -D and the environment only (moqui_conf__logging__level), then from the conf.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="color" type="xs:string" default="auto"><xs:annotation><xs:documentation>The stderr header color: auto (a terminal, and not NO_COLOR), always or never. Read as level is.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="dir" type="xs:string" default="runtime://log"><xs:annotation><xs:documentation>A path or runtime:// location; empty writes no files.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-size-mb" type="non-neg-int-expandable" default="100"><xs:annotation><xs:documentation>A file rolls over to moqui.yyyy-MM-dd.N.log (UTC) at this size or when the day changes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-files" type="non-neg-int-expandable" default="30"><xs:annotation><xs:documentation>Only this many of the newest rolled files of each kind are kept.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="datasource">
        <xs:complexType>
            <xs:sequence>
                <xs:choice minOccurs="1" maxOccurs="1">
                    <xs:element minOccurs="0" maxOccurs="1" ref="jndi-jdbc"/>
                    <xs:element minOccurs="0" maxOccurs="1" ref="inline-jdbc"/>
                    <xs:element minOccurs="0" maxOccurs="1" ref="inline-other"/>
                </xs:choice>
            </xs:sequence>
            <xs:attribute name="group-name" type="name-segmented" use="required"/>
            <xs:attribute name="database-conf-name" type="xs:string">
                <xs:annotation><xs:documentation>The database-list entry of its server: postgres, mysql or mysql8;
                    embedded, empty or h2 for the embedded Postgres cluster. Only required for JDBC/SQL
                    datasources.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="host" type="xs:string"><xs:annotation><xs:documentation>The server's host name or
                address, or a Unix socket directory for Postgres. For a group other than transactional, empty is the
                transactional datasource's, as are port, user, password, sslmode and sslrootcert. The datasource's own
                inline-jdbc xa-properties or jdbc-uri (a conf from Java) replace these
                attributes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="port" type="xs:string"><xs:annotation><xs:documentation>Empty is the server's
                default port.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="database" type="xs:string"><xs:annotation><xs:documentation>The database on the
                server; for a group other than transactional on the embedded cluster, its database
                there.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="user" type="xs:string"/>
            <xs:attribute name="password" type="xs:string"><xs:annotation><xs:documentation>A secret: set it in
                runtime/.env or the environment (moqui_conf__entity_facade__datasource__TRANSACTIONAL__password).
                </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sslmode" type="xs:string"><xs:annotation><xs:documentation>An external server is
                reached over TLS: disable connects without it, require encrypts without checking the certificate,
                verify-ca checks its authority, and empty or verify-full its authority and
                name.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sslrootcert" type="xs:string"><xs:annotation><xs:documentation>A PEM file of the
                authorities to trust in place of the public ones.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="schema-name" type="xs:string"/>
            <xs:attribute name="startup-add-missing" default="false" type="boolean-expandable"/>
            <xs:attribute name="runtime-add-missing" default="true" type="boolean-expandable"/>
            <xs:attribute name="runtime-add-fks" default="true" type="boolean-expandable"/>
            <xs:attribute name="shared-buffers" type="xs:string">
                <xs:annotation><xs:documentation>The embedded cluster's shared_buffers, a size such as 64MB. Empty keeps
                    the default from code (16MB for the entity cluster). Applies when this process starts the cluster;
                    the cluster takes the transactional datasource's value.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="work-mem" type="xs:string">
                <xs:annotation><xs:documentation>The embedded cluster's work_mem, a size; empty keeps Postgres's
                    default. As shared-buffers.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="maintenance-work-mem" type="xs:string">
                <xs:annotation><xs:documentation>The embedded cluster's maintenance_work_mem, a size; empty keeps
                    Postgres's default. As shared-buffers.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="effective-cache-size" type="xs:string">
                <xs:annotation><xs:documentation>The embedded cluster's effective_cache_size, a size; empty keeps
                    Postgres's default. As shared-buffers.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="pg-stat-statements" default="false" type="boolean-expandable">
                <xs:annotation><xs:documentation>On Postgres, load pg_stat_statements for this datasource's database:
                    the embedded cluster preloads it (shared_preload_libraries, applied when this process starts the
                    cluster) and turns on track_io_timing; an external server must preload it, else a warning says so.
                    CREATE EXTENSION IF NOT EXISTS runs after start; a role that may not create it gets a warning.
                    Ignored on MySQL, whose statement digests are in performance_schema.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="object-factory" type="xs:string" default="org.moqui.impl.entity.EntityDatasourceFactoryImpl">
                <xs:annotation><xs:documentation>The references class must implement the
                    EntityDatasourceFactory interface.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="sequence-primary-use-uuid" type="boolean-expandable" default="false">
                <xs:annotation><xs:documentation>Uses a random UUID as the sequenced ID for all entities in this datasource.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="start-server-args" type="xs:string">
                <xs:annotation><xs:documentation>Currently only for the H2 database. Start a remote access server for
                    the embedded DB using these arguments. See the main() method at
                    http://www.h2database.com/javadoc/org/h2/tools/Server.html for details.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="disabled" default="false" type="boolean-expandable"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="inline-jdbc">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="1" ref="xa-properties"/>
            </xs:sequence>
            <xs:attribute name="jdbc-uri" type="xs:string" use="optional"/>
            <xs:attribute name="jdbc-username" type="xs:string" use="optional"/>
            <xs:attribute name="jdbc-password" type="xs:string" use="optional"/>
            <xs:attribute name="jdbc-driver" type="xs:string" use="optional"/>
            <xs:attribute name="xa-ds-class" type="xs:string" use="optional"/>
            <xs:attribute name="isolation-level" type="isolation-level"/>
            <xs:attribute name="pool-maxsize" type="xs:nonNegativeInteger" default="50"/>
            <xs:attribute name="pool-minsize" type="xs:nonNegativeInteger" default="5"/>
            <xs:attribute name="pool-reserve" type="xs:nonNegativeInteger" default="8">
                <xs:annotation><xs:documentation>Connections inside pool-maxsize that only the framework's own short
                    work takes (sequence banks, sessions, login, hits, job and semaphore records, cluster membership),
                    so a full pool cannot block it.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="read-timeout" type="xs:nonNegativeInteger">
                <xs:annotation><xs:documentation>MySQL: the most time in seconds one read from the database waits, the
                    sign-in's included; 0 waits without a limit. Defaults to 600 seconds.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="pool-time-idle" type="xs:nonNegativeInteger">
                <xs:annotation><xs:documentation>Maximum time in seconds that unused excess connections should stay in
                    the pool. Defaults to 60 seconds.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="pool-time-reap" type="xs:nonNegativeInteger">
                <xs:annotation><xs:documentation>Time in seconds that the connection pool will allow a connection to be
                    in use, before claiming it back. Defaults to no limit.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="pool-time-maint" type="xs:nonNegativeInteger">
                <xs:annotation><xs:documentation>Running interval in seconds for the pool maintenance thread.
                    Defaults to 60 seconds.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="pool-time-wait" type="xs:nonNegativeInteger">
                <xs:annotation><xs:documentation>Sets the maximum amount of time in seconds the pool will block
                    waiting for a connection to become available in the pool when it is empty. Defaults to 30 seconds.
                    Zero means no waiting.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="pool-test-query" type="xs:string"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="jndi-jdbc">
        <xs:complexType>
            <xs:attribute name="jndi-name" type="xs:string" use="required"/>
            <xs:attribute name="isolation-level" type="isolation-level"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="xa-properties">
        <xs:complexType><xs:anyAttribute processContents="skip"/></xs:complexType>
    </xs:element>
    <xs:element name="inline-other">
        <xs:complexType><xs:anyAttribute processContents="skip"/></xs:complexType>
    </xs:element>
    <xs:element name="load-entity">
        <xs:annotation><xs:documentation>Most resources should be loaded by directory convention (convention over
            configuration) within a component so this should only be used rarely. Sometimes that is not possible such
            as remote locations or on a classpath that is inside a war or ear file, or that is from a special
            ClassLoader.</xs:documentation></xs:annotation>
        <xs:complexType><xs:attribute name="location" type="xs:string" use="required"/></xs:complexType>
    </xs:element>
    <xs:element name="load-data">
        <xs:annotation><xs:documentation>Most resources should be loaded by directory convention (convention over
            configuration) within a component so this should only be used rarely. Sometimes that is not possible such
            as remote locations or on a classpath that is inside a war or ear file, or that is from a special
            ClassLoader.</xs:documentation></xs:annotation>
        <xs:complexType><xs:attribute name="location" type="xs:string" use="required"/></xs:complexType>
    </xs:element>

    <!-- ===================== Client Apps (the desktop and mobile apps of a server) ===================== -->
    <xs:element name="client-conf">
        <xs:annotation><xs:documentation>The desktop and mobile apps as clients of a remote server (configuration 3,
            plans/Mobile-Desktop.md §6, MD4): how much of an account's data the app keeps on the device for offline use,
            and for how long. Read by the app from the conf of its bundled runtime (crates/moqui-client conf.rs), so a
            build sets its own in its runtime conf; the server does not read it. A bad value is logged and its default
            used.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="device-mode" default="choose">
                <xs:annotation><xs:documentation>Whose device this is. personal (a person's own phone or desktop): a full
                    mirror within the limits, kept on sign-out and on revocation and deleted only when the account is
                    removed. shared (a hot desk, a packing terminal, a point of sale): what was seen and a small
                    prefetch, deleted on sign-out and on revocation. choose: the sign-in asks, and the answer is kept
                    with the account; an account already personal stays personal.</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="choose"/>
                    <xs:enumeration value="personal"/>
                    <xs:enumeration value="shared"/>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="mirror-days" type="xs:string" default="90"><xs:annotation><xs:documentation>How far
                back a personal device mirrors chat rooms and mail folders, in days; at least 1.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="prefetch-rooms" type="xs:string" default="20"><xs:annotation><xs:documentation>How
                many of the latest chat rooms a shared device reads ahead (each room's latest page); 0 for
                none.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="prefetch-mail" type="xs:string" default="100"><xs:annotation><xs:documentation>How
                many of the inbox's latest threads a shared device reads ahead; 0 for none.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="store-max-mb" type="xs:string" default="512"><xs:annotation><xs:documentation>The
                size cap of an account's store on the device, in MB; past it the least recently read cached data goes
                (never unsent items or drafts). At least 1.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <!-- ====================== Database Conf Root ======================= -->
    <xs:element name="database-list">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="dictionary-type"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="database"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="database">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="database-type"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="name-replace"><xs:complexType>
                    <xs:attribute name="original" type="name-plain" use="required"/>
                    <xs:attribute name="replace" type="name-plain" use="required"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="1" ref="inline-jdbc"/>
            </xs:sequence>

            <xs:attribute name="name" type="name-plain" use="required"/>
            <xs:attribute name="lb-name" type="name-plain"><xs:annotation>
                <xs:documentation>Name of the database for Liquibase, defaults to name attribute, see http://www.liquibase.org/databases.html</xs:documentation></xs:annotation></xs:attribute>

            <!-- TODO use in code -->
            <xs:attribute name="use-schemas" default="true" type="boolean"/>
            <xs:attribute name="use-pk-constraint-names" default="true" type="boolean"/>
            <xs:attribute name="constraint-name-clip-length" default="30" type="xs:nonNegativeInteger"/>
            <!-- TODO use in code -->
            <xs:attribute name="result-fetch-size" default="-1" type="xs:integer"/>
            <xs:attribute name="use-foreign-keys" default="true" type="boolean"/>
            <xs:attribute name="use-foreign-key-indexes" default="true" type="boolean"/>
            <xs:attribute name="fk-style" default="name_constraint">
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="name_constraint"/>
                        <xs:enumeration value="name_fk"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="use-fk-initially-deferred" default="false" type="boolean"/>
            <xs:attribute name="use-indexes" default="true" type="boolean">
                <xs:annotation><xs:documentation>Use manually declared indexes?</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="use-indexes-unique" default="true" type="boolean">
                <xs:annotation><xs:documentation>For manually declared indexes (if used), use the unique constraint?</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="use-indexes-unique-where-not-null" default="false" type="boolean">
                <xs:annotation><xs:documentation>For manually declared indexes (if used), unique constraints should disregard null values?</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="join-style" default="ansi">
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="ansi"/>
                    <xs:enumeration value="ansi-no-parenthesis"/>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="fts-style" default="none">
                <xs:annotation><xs:documentation>
                    How LIKE / NOT LIKE on a text-fts field is evaluated. none keeps SQL LIKE.
                    h2-native, postgres-tsvector, mysql-fulltext, mssql-contains, and oracle-text use that
                    database's full-text index. A missing index falls back to SQL LIKE.
                </xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="h2-native"/>
                    <xs:enumeration value="postgres-tsvector"/>
                    <xs:enumeration value="mysql-fulltext"/>
                    <xs:enumeration value="mssql-contains"/>
                    <xs:enumeration value="oracle-text"/>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="fts-ddl" default="true" type="xs:boolean">
                <xs:annotation><xs:documentation>
                    When false Moqui does not create the generated tsvector column, GIN or FULLTEXT index for text-fts fields.
                    Use it when a DBA manages them, because on PostgreSQL adding the stored column rewrites the table.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="fts-config" default="english" type="xs:token">
                <xs:annotation><xs:documentation>
                    Postgres text search configuration passed to to_tsvector / plainto_tsquery. Other fts-style values ignore it.
                </xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="offset-style" default="fetch">
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="fetch"><xs:annotation>
                        <xs:documentation>Use the SQL:2008 syntax (OFFSET ? ROWS FETCH FIRST ? ROWS ONLY)</xs:documentation>
                    </xs:annotation></xs:enumeration>
                    <xs:enumeration value="limit"><xs:annotation>
                        <xs:documentation>Use the basic limit/offset syntax (LIMIT ? OFFSET ?)</xs:documentation>
                    </xs:annotation></xs:enumeration>
                    <xs:enumeration value="cursor"><xs:annotation>
                        <xs:documentation>Don't use an SQL syntax, use a database cursor through the
                            EntityListIterator.getPartialList() method. Note that there may be different behavior when
                            calling EntityFind.iterator() as it only seeks to the offset but doesn't restrict by the
                            limit.</xs:documentation>
                    </xs:annotation></xs:enumeration>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="from-lateral-style" default="none">
                <xs:annotation><xs:documentation>
                    The SQL style for correlated sub-selects for joins in a FROM clause for sub-select=true; setting this to 'none'
                    results in the same SQL that would be generated for sub-select=non-lateral</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="lateral"><xs:annotation>
                        <xs:documentation>Use the SQL:1999 syntax ([INNER|OUTER LEFT] JOIN LATERAL)</xs:documentation>
                    </xs:annotation></xs:enumeration>
                    <xs:enumeration value="apply"><xs:annotation>
                        <xs:documentation>Use the apply syntax (CROSS APPLY or OUTER APPLY for join-optional=true)</xs:documentation>
                    </xs:annotation></xs:enumeration>
                    <xs:enumeration value="none"><xs:annotation>
                        <xs:documentation>No sort of lateral join supported, use non-correlated sub-selects</xs:documentation>
                    </xs:annotation></xs:enumeration>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="add-unique-as" default="false" type="boolean"/>
            <xs:attribute name="always-use-constraint-keyword" default="false" type="boolean"/>
            <xs:attribute name="use-schema-for-all" default="false" type="boolean">
                <xs:annotation><xs:documentation>Set to true to include the schema name for primary keys, foreign keys, and indexes.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="never-nulls" default="false" type="boolean">
                <xs:annotation><xs:documentation>Never use NULLS FIRST/LAST in ORDER BY clause</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="never-try-insert" default="false" type="boolean">
                <xs:annotation><xs:documentation>Never use try insert feature when storing a record</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="use-binary-type-for-blob" default="false" type="boolean"/>
            <xs:attribute name="table-engine" type="xs:string"/>
            <xs:attribute name="character-set" type="xs:string"/>
            <xs:attribute name="collate" type="xs:string"/>
            <xs:attribute name="default-isolation-level">
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="None"/>
                    <xs:enumeration value="ReadCommitted"/>
                    <xs:enumeration value="ReadUncommitted"/>
                    <xs:enumeration value="RepeatableRead"/>
                    <xs:enumeration value="Serializable"/>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="for-update" type="xs:string" default="FOR UPDATE"/>
            <xs:attribute name="for-no-key-update" type="xs:string">
                <xs:annotation><xs:documentation>MR Moqui: the text a find with for-no-key-update ends with, a row lock that
                does not block another transaction's foreign key check on the row (Postgres FOR NO KEY UPDATE). When not
                set the for-update text is used, so a database without such a lock locks as for update. When set it is used
                as it is: it does not follow an override of this database's for-update.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="use-tm-join" default="true" type="boolean">
                <xs:annotation><xs:documentation>For Bitronix set this to false to not use tm join (for Atomikos this is
                set in the serial_jta_transactions property in jta.properties)</xs:documentation></xs:annotation></xs:attribute>

            <!-- Defaults for inline-jdbc element -->
            <xs:attribute name="default-jdbc-driver" type="xs:string"/>
            <xs:attribute name="default-xa-ds-class" type="xs:string"/>
            <xs:attribute name="default-test-query" type="xs:string"/>

            <!-- Defaults for datasource element -->
            <xs:attribute name="default-startup-add-missing" type="boolean"/>
            <xs:attribute name="default-runtime-add-missing" type="boolean"/>
            <xs:attribute name="default-runtime-add-fks" type="boolean"/>
            <xs:attribute name="default-start-server-args" type="xs:string"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="dictionary-type">
        <xs:complexType>
            <xs:attribute name="type" type="xs:string" use="required"/>
            <xs:attribute name="java-type" type="xs:string" use="required">
                <xs:annotation><xs:documentation>The value type of a field of this type, a simple type name (String,
                    Timestamp, BigDecimal, Long and so on).</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="default-sql-type" type="xs:string"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="database-type">
        <xs:complexType>
            <xs:attribute name="type" type="xs:string" use="required"/>
            <xs:attribute name="sql-type" type="xs:string" use="required"/>
            <xs:attribute name="sql-type-alias" type="xs:string"/>
            <xs:attribute name="java-type" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <!-- ================== Repository (JCR) Conf Root ==================== -->
    <xs:element name="repository-list">
        <xs:complexType><xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" ref="repository"/></xs:sequence></xs:complexType>
    </xs:element>
    <xs:element name="repository">
        <xs:annotation><xs:documentation>Configuration for a JCR Repository retrieved through a
            RepositoryFactory using parameter sub-elements (with name and value attributes), and a
            JCR Session using the workspace, username, and password attributes.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="init-param" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="workspace" type="xs:string">
                <xs:annotation><xs:documentation>Defaults to the repository's default workspace.</xs:documentation></xs:annotation>
            </xs:attribute>

            <xs:attribute name="username" type="xs:string"/>
            <xs:attribute name="password" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="component-deploy">
        <xs:annotation><xs:documentation>Deploying a component on this server (docs/tools/Component-Deploy.md "The
            gate"): the attested deploys a source server's deployments make, and the gate that refuses any other. Read
            once at start: a conf reload or a live override changes none of it until the next start.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="allow" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation><xs:documentation>A component an attested deploy may bring, from one repository URL
                        and branch; an attestation of anything else is refused, and none is taken with no allow
                        entry. A component deployed from git already is updated only from its own URL and
                        branch.</xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="component" type="xs:string" use="required"/>
                        <xs:attribute name="repository-url" type="xs:string" use="required"><xs:annotation><xs:documentation>As
                            the source's environment sends it (its cloneUrl, or the repository's public clone URL);
                            compared without the case of the scheme and host or a trailing slash.</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="branch" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:string"><xs:annotation><xs:documentation>Deploying a component from a git URL needs the sealed COMPONENT_DEPLOY permission, and on a production instance also this set to true. Read at start.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="require-passed-run" type="xs:string" default="false"><xs:annotation><xs:documentation>true:
                deploy#Component, update#Component and load#Component refuse to deploy a commit unless the request
                carries an attestation, signed with attestation-secret, that the commit passed its environment's
                pipeline on the source server; a deploy from this server's own pages is refused, a start writes from
                the database only the commit an attested deploy put in place, and another cluster member applies only
                the commit the last attestation names.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="attestation-secret" type="xs:string"><xs:annotation><xs:documentation>The secret this
                server issued to the source server (its environment's token), at least 32 characters; empty takes no
                attested deploy. Set it in runtime/.env (moqui_conf__component_deploy__attestation_secret).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-age-seconds" type="xs:string" default="300"><xs:annotation><xs:documentation>The
                oldest attestation taken, by the time the source signed it.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="public-urls" type="xs:string"><xs:annotation><xs:documentation>This server's public
                base URLs, separated by spaces or commas: an attestation's audience (the source environment's
                targetUrl) must be one of them. Empty: the webroot webapp's URL when webapp-list/webapp[webroot]@http-host is set; with
                neither, every attestation is refused.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="instance-hosting">
        <xs:annotation><xs:documentation>Hosted instances (System, Instance; org.moqui.dev.InstanceServices): the
            commands that print a registry token for an image pull, by name. An InstanceImage's authTokenCmd names one;
            its text is never run itself. get#RegistryToken runs the command for a holder of INSTANCE_ADMIN, split on
            white space, with no shell, stdin closed, only PATH, HOME, USER, the locale, TZ and TMPDIR of the server's
            environment, and 30 seconds; the first line of its output is the token.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="token-command" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                        <xs:attribute name="command" type="xs:string" use="required"><xs:annotation><xs:documentation>The
                            program and its arguments, separated by white space; ${} names a property.</xs:documentation>
                            </xs:annotation></xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ================= Development ================= -->
    <xs:element name="dev-reload">
        <xs:annotation><xs:documentation>The dev file watcher (plans/design-dev-aide.md 6.3): on a dev instance
            (instance@purpose dev) of a build with the devtools feature (the Dev and Debug packages), every component
            directory is watched, and a changed file reloads what it defines: its services, its screen, the ECA rule
            set of its kind, its REST API or skill; an entity, conf or Rust change logs that it needs a restart or a
            rebuild. On unless enabled is false. Not on any other purpose.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="projects" type="xs:string" default="3"><xs:annotation><xs:documentation>How many projects
                the dev tools' project cache keeps.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="enabled" type="xs:string" default="true"/>
            <xs:attribute name="debounce-ms" type="xs:string" default="300"><xs:annotation><xs:documentation>
                How long after the last change in a burst the reload runs, so an editor's write and rename is one
                change.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="dev-aide">
        <xs:annotation><xs:documentation>The settings of the dev-aide component (Dev AIDE, plans/design-dev-aide.md
            16), in its MoquiConf.xml or a runtime conf; Settings in the app stores some of them over these.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="root" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation><xs:documentation>A directory the Workspace shows besides the repositories and
                        directories of the loaded components.</xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="location" type="xs:string" use="required"/>
                        <xs:attribute name="label" type="xs:string"/>
                    </xs:complexType>
                </xs:element>
                <xs:element name="exclude" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType><xs:attribute name="pattern" type="xs:string" use="required"/></xs:complexType>
                </xs:element>
                <xs:element name="task-app" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation><xs:documentation>An app a task opens in (plans/design-dev-aide.md 14): its paths to a
                        project, a task and a new task with {projectId} and {taskId}, and a base URL when it is another
                        instance.</xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                        <xs:attribute name="title" type="xs:string"/>
                        <xs:attribute name="project-path" type="xs:string"/>
                        <xs:attribute name="task-path" type="xs:string"/>
                        <xs:attribute name="new-task-path" type="xs:string"/>
                        <xs:attribute name="base-url" type="xs:string"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="site-component" type="xs:string"><xs:annotation><xs:documentation>The components the
                site owns, comma separated, the first the default target of an extension. A root with none of them is
                upstream: read only unless a DEV_AIDE user turns on editing upstream components.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="shared" type="xs:string" default="false"><xs:annotation><xs:documentation>A team dev
                server: network git commands are off until an admin enables them.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="allow-upstream-edits" type="xs:string" default="false"/>
            <xs:attribute name="git-command" type="xs:string" default="git"/>
            <xs:attribute name="git-read-timeout" type="xs:string" default="15"><xs:annotation><xs:documentation>Seconds
                a git read may run.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="git-network-timeout" type="xs:string" default="300"/>
            <xs:attribute name="git-write-timeout" type="xs:string" default="120"><xs:annotation><xs:documentation>Seconds a write (which may run hooks) may take.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-edit-bytes" type="xs:string" default="2097152"><xs:annotation><xs:documentation>A
                text over this many bytes opens read only.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <!-- ================= Additional Component Locations ================= -->
    <xs:element name="component-list">
        <xs:annotation><xs:documentation>Use this to specify components to load in addition to those in the
            runtime/components/addon directory. This is useful for components in JCR repositories or wherever.
            The location needs to use a Resource Facade protocol/schema that supports looking at sub-directories, etc
            (like content:, file:, etc).</xs:documentation></xs:annotation>
        <xs:complexType><xs:sequence>
            <xs:choice maxOccurs="unbounded">
                <xs:element ref="component-dir"/>
                <xs:element ref="component"/>
            </xs:choice>
        </xs:sequence></xs:complexType>
    </xs:element>
    <xs:element name="component-dir">
        <xs:complexType>
            <xs:attribute name="location" type="xs:string" use="required"/>
            <xs:attribute name="purpose" type="xs:string" use="optional"><xs:annotation><xs:documentation>
                The instance purposes (instance@purpose) each component in the directory loads on, comma separated, such as dev; empty or
                missing for every purpose. On another purpose each is left out with a WARN naming it. Read
                when the components are discovered: instance@purpose comes from a -D option or the environment
                (moqui_conf__instance__purpose), else runtime/.env, else the runtime conf, never from a component's
                own conf. A component that loads on every purpose may
                not depend on one that loads only on some; it is left out with an error.
            </xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="component">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="depends-on" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" use="optional"/>
            <xs:attribute name="location" type="xs:string" use="optional"><xs:annotation><xs:documentation>
                Required when under component-list (in Moqui Conf XML file or a components.xml file), optional
                when component element is in a component.xml file within a component.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="version" type="xs:string" use="optional"/>
            <xs:attribute name="disabled" type="xs:string" use="optional"><xs:annotation><xs:documentation>
                In a component.xml file: when this expands to true the component is not loaded when a component-dir
                is scanned. A component element under component-list that names the component still loads it. The
                value can use a property, such as ${my_component_disabled ?: 'true'}, so a -D option or environment
                variable can turn it on for a run.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="purpose" type="xs:string" use="optional"><xs:annotation><xs:documentation>
                The instance purposes (instance@purpose) the component (in a component.xml, or on a component element that names it) loads on, comma separated, such as dev; empty or
                missing for every purpose. On another purpose it is left out with a WARN naming it. Read
                when the components are discovered: instance@purpose comes from a -D option or the environment
                (moqui_conf__instance__purpose), else runtime/.env, else the runtime conf, never from a component's
                own conf. A component that loads on every purpose may
                not depend on one that loads only on some; it is left out with an error.
            </xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="depends-on">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="version" type="xs:string" use="optional"/>
        </xs:complexType>
    </xs:element>
</xs:schema>
