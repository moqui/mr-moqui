<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xs:include schemaLocation="common-types-3.xsd"/>
    <xs:include schemaLocation="xml-actions-3.xsd"/>

    <xs:element name="moqui-conf">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" ref="instance"/>
                <xs:element minOccurs="0" ref="comms"/>
                <xs:element minOccurs="0" ref="demo"/>
                <xs:element minOccurs="0" ref="acme"/>
                <xs:element minOccurs="0" ref="client-sync"/>
                <xs:element minOccurs="0" ref="chat"/>
                <xs:element minOccurs="0" ref="channels"/>
                <xs:element minOccurs="0" ref="push"/>
                <xs:element minOccurs="0" ref="load-runner"/>
                <xs:element minOccurs="0" ref="cluster-member"/>
                <xs:element minOccurs="0" ref="xmpp-server"/>
                <xs:element minOccurs="0" ref="sip-server"/>
                <xs:element minOccurs="0" ref="calls"/>
                <xs:element minOccurs="0" ref="media-server"/>
                <xs:element minOccurs="0" ref="voicemail"/>
                <xs:element minOccurs="0" ref="pass-authority"/>
                <xs:element minOccurs="0" ref="database-backup"/>
                <xs:element minOccurs="0" ref="tools"/>
                <xs:element minOccurs="0" ref="cache-list"/>
                <xs:element minOccurs="0" ref="telemetry"/>
                <xs:element minOccurs="0" ref="report"/>
                <xs:element minOccurs="0" ref="resource-watch"/>
                <xs:element minOccurs="0" ref="server-stats"/>
                <xs:element minOccurs="0" ref="webapp-list"/>
                <xs:element minOccurs="0" ref="artifact-execution-facade"/>
                <xs:element minOccurs="0" ref="user-facade"/>
                <xs:element minOccurs="0" ref="transaction-facade"/>
                <xs:element minOccurs="0" ref="resource-facade"/>
                <xs:element minOccurs="0" ref="screen-facade"/>
                <xs:element minOccurs="0" ref="service-facade"/>
                <xs:element minOccurs="0" ref="search-facade"/>
                <xs:element minOccurs="0" ref="llm-facade"/>
                <xs:element minOccurs="0" ref="email-client"/>
                <xs:element minOccurs="0" ref="ssh-server"/>
                <xs:element minOccurs="0" ref="terminal"/>
                <xs:element minOccurs="0" ref="git-server"/>
                <xs:element minOccurs="0" ref="git-ci"/>
                <xs:element minOccurs="0" ref="dav-server"/>
                <xs:element minOccurs="0" ref="smtp-server"/>
                <xs:element minOccurs="0" ref="mail-delivery"/>
                <xs:element minOccurs="0" ref="edge"/>
                <xs:element minOccurs="0" ref="logging"/>
                <xs:element minOccurs="0" ref="client-conf"/>
                <xs:element minOccurs="0" ref="dev-reload"/>
                <xs:element minOccurs="0" ref="dev-aide"/>
                <xs:element minOccurs="0" ref="component-deploy"/>
                <xs:element minOccurs="0" ref="instance-hosting"/>
                <xs:element minOccurs="0" ref="entity-facade"/>
                <xs:element minOccurs="0" ref="database-list"/>
                <xs:element minOccurs="0" ref="repository-list"/>
                <xs:element minOccurs="0" ref="component-list"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="init-param">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="value" type="xs:string"/>
            <xs:attribute name="conf" type="xs:string"><xs:annotation><xs:documentation>A conf attribute by its selector
                (search-facade/cluster@url) whose value the servlet or filter gets when value is empty, a secret one
                too: the server reads it, so a script's handler is given a credential the conf keeps once (plans/archive/Conf-Paths.md
                §1). Read when the webapp's servlets are built.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="tools">
        <xs:complexType>
            <xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" ref="tool-factory"/></xs:sequence>
            <xs:attribute name="empty-db-load" type="xs:string" default="seed"><xs:annotation><xs:documentation>
                Comma-separated list of data file types to load if database is empty (if there are no records in the
                table for moqui.basic.Enumeration). Empty or 'none' means load nothing, use 'all' to load all found
                data files regardless of type.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="on-start-load-types" type="xs:string"><xs:annotation><xs:documentation>
                Comma-separated list of data file types to load on start. Empty or 'none' means load nothing.
                Does not run if empty-db-load runs.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="on-start-load-components" type="xs:string"><xs:annotation><xs:documentation>
                Comma-separated list of component names to load on start, used with on-start-load-types.
                Does not run if empty-db-load runs.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="database-audit-days" type="xs:string" default="90"><xs:annotation><xs:documentation>The
                days the DatabaseAudit rows of the Tools database screens are kept, at least 1.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="external-database-private-network" type="xs:string" default="false"><xs:annotation><xs:documentation>
                True lets a Tools external database connection (DatabaseConnection, DATABASE_EXTERNAL) reach a
                loopback or private address, such as a database beside this server; false, the default, takes only a
                public address. A link-local or cloud metadata address is refused either way.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="worker-queue" type="xs:integer"><xs:annotation><xs:documentation>
                The maximum size of the worker queue.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="worker-pool-core" type="xs:integer"><xs:annotation><xs:documentation>
                The core (minimum) size of the worker thread pool.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="worker-pool-max" type="xs:integer"><xs:annotation><xs:documentation>
                The maximum size of the worker thread pool, 22 by default. Each worker can hold two connections
                (a transaction and a suspended one), so it counts twice in the startup check of the pool size.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="worker-pool-alive" type="xs:integer"><xs:annotation><xs:documentation>
                The amount of time, in seconds, to keep idle worker threads alive (beyond core pool size).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="notification-topic-factory" type="xs:string"><xs:annotation><xs:documentation>
                The ToolFactory to use to get a SimpleTopic for distributed NotificationMessage</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="request-pool-max" type="xs:integer"><xs:annotation><xs:documentation>
                The number of request worker threads, 16 by default.
                Each can hold two connections, so it counts twice in the startup check of the pool size.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="request-queue" type="xs:integer"><xs:annotation><xs:documentation>
                The most requests that wait for a request worker, 64 by default.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="tool-factory">
        <xs:complexType>
            <xs:attribute name="class" type="xs:string" use="required"><xs:annotation><xs:documentation>
                Identifier of a linked native ToolFactory implementation. The component supplies code;
                this declaration selects it. disabled and init-priority control its factory-local lifecycle.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="init-priority" type="xs:integer" default="10"/>
            <xs:attribute name="disabled" type="boolean" default="false"/>
        </xs:complexType>
    </xs:element>
    <!-- ===================== Cache Conf Root ===================== -->
    <xs:element name="cache-list">
        <xs:complexType>
            <xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" ref="cache"/></xs:sequence>
            <xs:attribute name="warm-on-start" type="boolean" default="true"/>
            <xs:attribute name="local-factory" type="xs:string"><xs:annotation><xs:documentation>
                The name of the ToolFactory to use for the local CacheManager implementation.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="distributed-factory" type="xs:string"><xs:annotation><xs:documentation>
                The name of the ToolFactory to use for the distributed CacheManager implementation.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="cache">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="key-type" type="xs:string" default="String"/>
            <xs:attribute name="value-type" type="xs:string" default="Object"/>

            <xs:attribute name="expire-time-idle" type="xs:nonNegativeInteger" use="optional">
                <xs:annotation><xs:documentation>Idle expire time in seconds.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="expire-time-live" type="xs:nonNegativeInteger" use="optional">
                <xs:annotation><xs:documentation>Live expire time in seconds.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-elements" type="xs:nonNegativeInteger" use="optional"/>
            <xs:attribute name="eviction-strategy" default="least-frequently-used">
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="least-recently-used"/>
                        <xs:enumeration value="least-frequently-used"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="type" default="local">
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="local">
                            <xs:annotation><xs:documentation>Local only cache (MCache)</xs:documentation></xs:annotation></xs:enumeration>
                        <xs:enumeration value="distributed">
                            <xs:annotation><xs:documentation>Distributed cache; keys and values must be serializable</xs:documentation></xs:annotation></xs:enumeration>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="telemetry"><xs:complexType>
        <xs:annotation><xs:documentation>Spans, metrics and logs of this server, written to the otel_* search indexes,
            and the OTLP receiver that takes them from other services. Replaces server-stats/artifact-stats.
        </xs:documentation></xs:annotation>
        <xs:sequence><xs:element name="artifact" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
            <xs:annotation><xs:documentation>Per artifact type (AT_SERVICE, AT_XML_SCREEN, AT_ENTITY, ...): whether
                its frames are spans and whether they record the moqui.artifact.duration metric. Both default to true,
                except AT_ENTITY (neither) and AT_XML_SCREEN_CONTENT (metrics only). AT_TRANSACTION is each transaction
                begun (not joined): a span inside a trace, and the moqui.transaction.duration metric in place of
                moqui.artifact.duration.</xs:documentation></xs:annotation>
            <xs:attribute name="type" type="xs:string" use="required"/><xs:attribute name="spans" type="boolean"/>
            <xs:attribute name="metrics" type="boolean"/>
            <xs:attribute name="sample-ratio" type="xs:string"><xs:annotation><xs:documentation>The share of traces,
                0 to 1, in which this type's spans are kept, in place of the telemetry sample-ratio, decided from the
                trace id in the same way: a type at 0.5 under a telemetry ratio of 0.1 keeps its own spans in half the
                traces and the other spans in a tenth. Roots and the tail rule are unchanged. Default: the telemetry
                sample-ratio. A value that is not a number is warned about and ignored.</xs:documentation>
            </xs:annotation></xs:attribute>
        </xs:complexType></xs:element>
        <xs:element name="metric" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
            <xs:annotation><xs:documentation>The attributes one instrument keeps on its points (for example
                http.server.request.duration, moqui.artifact.duration, db.client.operation.duration), in place of the
                global list: moqui.artifact.type, moqui.artifact.name, moqui.artifact.action, moqui.artifact.sub_type,
                http.request.method, http.route, http.response.status_code, db.system.name and outcome. Each kept
                attribute multiplies the instrument's series, which are capped at 20000.</xs:documentation>
            </xs:annotation>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="attributes" type="xs:string"><xs:annotation><xs:documentation>Comma-separated
                attribute names; empty keeps none. Values of names the framework does not set from artifact names and
                routes are redacted as the global list's are.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType></xs:element>
        <xs:element name="operations" minOccurs="0"><xs:complexType>
            <xs:annotation><xs:documentation>Business operations (plans/archive/Monitoring.md, Later: Business operations).
                A service call that owns its transaction (the outermost or a force-new one) is an operation, named by
                the service unless the service declares operation or a rule here names it. Each run counts as
                moqui.operation.runs, and its time as moqui.operation.duration, by moqui.operation.name and outcome:
                commit, rollback, retry (rolled back, and a scheduled job or a SystemMessage retry will run it again)
                or pending (queued for a worker). The service's span carries the name, the outcome and the
                correlation reference (moqui.operation.ref).</xs:documentation></xs:annotation>
            <xs:sequence>
                <xs:element name="operation" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                    <xs:annotation><xs:documentation>A rule for the services whose full names match a pattern; the
                        first rule that matches applies. A component's rule replaces the framework's of the same
                        service pattern.</xs:documentation></xs:annotation>
                    <xs:attribute name="service" type="xs:string" use="required"><xs:annotation><xs:documentation>
                        A regular expression matched against the whole service name.</xs:documentation>
                    </xs:annotation></xs:attribute>
                    <xs:attribute name="name" type="xs:string"><xs:annotation><xs:documentation>The operation name, in
                        place of the service's operation attribute or its name.</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="ref" type="xs:string"><xs:annotation><xs:documentation>The in-parameter whose
                        value is the correlation reference, in place of the service's operation-ref. Name an id,
                        never a parameter that carries document contents.</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="record" type="boolean"><xs:annotation><xs:documentation>false: these services
                        are not operations. Default true.</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
            </xs:sequence>
            <xs:attribute name="record"><xs:annotation><xs:documentation>default: every call that owns its
                transaction, unless a rule says not; declared: only services that declare operation or that a rule
                matches; none: no operations.</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="default"/><xs:enumeration value="declared"/><xs:enumeration value="none"/>
                </xs:restriction></xs:simpleType></xs:attribute>
            <xs:attribute name="max-names" type="xs:positiveInteger"><xs:annotation><xs:documentation>The most
                operation names recorded, to bound the series; later names are recorded as other. Default
                500.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType></xs:element>
        <xs:element name="regressions" minOccurs="0"><xs:complexType>
            <xs:annotation><xs:documentation>The regression detector (plans/archive/Monitoring.md, Later: Regressions and
                incidents), the detect_Regressions_5min job. Each service version with request metrics in the last
                window is compared with its baseline: the previous version over lookback-hours before the release while
                the release is under watch-hours old, else the same version historical-offset-hours earlier. Error rate
                (5xx), p95 request latency and the operation rollback rate are compared; too few samples give no
                verdict, and gaps or lost telemetry mark a verdict degraded, never healthy. A regression at
                incident-severity opens or joins the service's incident.</xs:documentation></xs:annotation>
            <xs:attribute name="enabled" type="boolean"><xs:annotation><xs:documentation>false stops the detector. Default true.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="window-minutes" type="xs:nonNegativeInteger"><xs:annotation><xs:documentation>The candidate window. Default 60.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="watch-hours" type="xs:decimal"><xs:annotation><xs:documentation>How long after a release its version is compared with the previous version. Default 24.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="lookback-hours" type="xs:decimal"><xs:annotation><xs:documentation>The previous version's window before a release, and how long before an onset a change counts as a cause. Default 24.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="historical-offset-hours" type="xs:decimal"><xs:annotation><xs:documentation>How much earlier the historical baseline window is. Default 24.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="min-samples" type="xs:nonNegativeInteger"><xs:annotation><xs:documentation>Requests (or operation runs) each side needs for a verdict. Default 200.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="min-coverage" type="xs:decimal"><xs:annotation><xs:documentation>The share of a window's minutes that must have metrics, below which a verdict is degraded. Default 0.8.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="alpha" type="xs:decimal"><xs:annotation><xs:documentation>The one-sided p-value under which a difference counts. Default 0.01.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="rate-delta" type="xs:decimal"><xs:annotation><xs:documentation>The least rise of a rate that is a regression; 0.01 is one point. Default 0.01.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="latency-ratio" type="xs:decimal"><xs:annotation><xs:documentation>The least p95 ratio that is a regression, when the p95 is in a higher bucket. Default 1.5.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="critical-rate" type="xs:decimal"><xs:annotation><xs:documentation>A rate rise from which a regression is critical. Default 0.10.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="critical-ratio" type="xs:decimal"><xs:annotation><xs:documentation>A p95 ratio from which a regression is critical. Default 3.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="resolve-minutes" type="xs:nonNegativeInteger"><xs:annotation><xs:documentation>How long an incident whose regressions resolved is watched before it is resolved. Default 30.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="incident-severity"><xs:annotation><xs:documentation>The least severity of a regression
                that opens an incident: major (the default) or critical.</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="major"/><xs:enumeration value="critical"/></xs:restriction></xs:simpleType></xs:attribute>
        </xs:complexType></xs:element>
        <xs:element name="recovery" minOccurs="0"><xs:complexType>
            <xs:annotation><xs:documentation>Recovery (plans/archive/Monitoring.md, Later: Recovery): for an open incident, the
                matching RecoveryPolicy picks the least disruptive allowed action of its ladder, which is recorded as a
                decision. Advisory by default: an action runs only with approval (MONITOR_RECOVER) or under an automatic
                policy when allow-automatic is true, through its adapter (in-process, webhook or manual), one active
                action per scope, and is verified against the policy's checks. No action reverses committed business
                transactions.</xs:documentation></xs:annotation>
            <xs:attribute name="properties" type="xs:string"><xs:annotation><xs:documentation>The other process
                properties a recovery adapter may read, secret ones among them, comma separated (one whose name starts
                with recovery_ needs no listing).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="enabled" type="boolean"><xs:annotation><xs:documentation>false stops new decisions. Default true.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="allow-automatic" type="boolean"><xs:annotation><xs:documentation>true lets a policy in automatic mode run its actions without approval. Default false: automatic policies wait for approval as approval policies do.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="verify-minutes" type="xs:nonNegativeInteger"><xs:annotation><xs:documentation>How long after an action takes effect its checks are read before it is verified, when its policy does not say. Default 15.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="deadline-minutes" type="xs:nonNegativeInteger"><xs:annotation><xs:documentation>How long an action may run before it is timed out and escalated, when its policy does not say. Default 30.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType></xs:element>
        <xs:element name="receiver" minOccurs="0"><xs:complexType>
            <xs:annotation><xs:documentation>The OTLP/HTTP receiver at /v1/traces, /v1/logs and /v1/metrics (and
                OTLP/gRPC with grpc-enabled), and the
                deploy markers at /v1/annotations, each authorized by an ingest key. A request refused before it is
                decoded (busy, over the rate, too large) answers an error status and is not counted; each record a
                request rejects, or the queue cannot take, counts as dropped.
            </xs:documentation></xs:annotation>
            <xs:attribute name="enabled" type="boolean"><xs:annotation><xs:documentation>false answers 404 on the
                receiver paths. Default true.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="body-limit" type="xs:positiveInteger"><xs:annotation><xs:documentation>The largest
                request body in bytes, after gzip is undone. Default 4194304 (4 MiB).</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="requests-per-minute" type="xs:positiveInteger"><xs:annotation><xs:documentation>
                Requests each ingest key may make a minute; more answer 429. Default 600.</xs:documentation>
            </xs:annotation></xs:attribute>
            <xs:attribute name="concurrent-requests" type="xs:positiveInteger"><xs:annotation><xs:documentation>
                Requests decoded at once; more answer 503. Default 8.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="grpc-enabled" type="boolean"><xs:annotation><xs:documentation>true opens the
                OTLP/gRPC receiver (the trace, logs and metrics collector services) in a build with the grpc feature.
                It takes the same ingest keys (authorization: Bearer or api_key metadata), limits and queue; refusals
                are gRPC statuses (UNAUTHENTICATED, RESOURCE_EXHAUSTED, UNAVAILABLE, INVALID_ARGUMENT). With the HTTPS
                listener's certificates it is TLS, else plain h2c. Default false.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="grpc-port" type="xs:nonNegativeInteger"><xs:annotation><xs:documentation>The gRPC
                port; 0 is any free port. Default 4317.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="grpc-bind" type="xs:string"><xs:annotation><xs:documentation>The IP address the gRPC
                receiver listens on. Default the HTTP listener's (webapp-list/webapp[webroot]@http-bind).</xs:documentation></xs:annotation>
            </xs:attribute>
        </xs:complexType></xs:element>
        <xs:element name="browser" minOccurs="0"><xs:complexType>
            <xs:annotation><xs:documentation>Real-user monitoring from signed-in qvt pages: a page load span with its web
                vitals, a span per in-app navigation and per request (whose server request joins its trace), and the
                page's JavaScript errors as logs, posted to /rum/traces and /rum/logs with the session's CSRF token. The server replaces the page's identity with the session's user and visit and keeps
                only CLIENT and INTERNAL spans. Anonymous pages send nothing. With replay-enabled, a sample of sessions
                also records an rrweb replay with every input and text masked, viewed on Monitor › Replays by users with
                MONITOR_REPLAY.</xs:documentation></xs:annotation>
            <xs:attribute name="enabled" type="boolean"><xs:annotation><xs:documentation>Default false.
                </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="service-name" type="xs:string"><xs:annotation><xs:documentation>The service.name of
                browser telemetry. Default the server's service name with -browser.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="sample-ratio" type="xs:string"><xs:annotation><xs:documentation>The share of page
                sessions, 0 to 1, that send spans. Default 1.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="error-sample-ratio" type="xs:string"><xs:annotation><xs:documentation>The share of
                page sessions that send JavaScript errors. Default 1.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="body-limit" type="xs:positiveInteger"><xs:annotation><xs:documentation>The largest
                trace/log post in bytes. Default 262144. When explicitly configured, also the replay request cap
                unless replay-body-limit is set.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="replay-body-limit" type="xs:positiveInteger"><xs:annotation><xs:documentation>The
                largest replay JSON post in UTF-8 bytes, including its envelope. Defaults to an explicitly configured
                body-limit, otherwise 1048576. A full snapshot is one event and is never split. The webapp's max-body
                still applies; replay-max-bytes separately limits cumulative event-array bytes.
                </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="requests-per-minute" type="xs:positiveInteger"><xs:annotation><xs:documentation>
                Posts per user and visit a minute. Default 120.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="replay-enabled" type="boolean"><xs:annotation><xs:documentation>Record rrweb session
                replays. Default false.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="replay-sample-ratio" type="xs:string"><xs:annotation><xs:documentation>The share of
                page sessions recorded. Default 0.1.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="replay-max-minutes" type="xs:positiveInteger"><xs:annotation><xs:documentation>
                Minutes one replay may run; the page stops recording then and the server refuses more. Default 30.
                </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="replay-max-bytes" type="xs:positiveInteger"><xs:annotation><xs:documentation>Event
                bytes one replay may hold. Default 5242880.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="replay-user-bytes-per-hour" type="xs:positiveInteger" default="52428800"><xs:annotation><xs:documentation>
                Event bytes one user's replays may send in an hour, on each server, whatever replay ids the page picks.
                Default 52428800.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="replay-block-selector" type="xs:string"><xs:annotation><xs:documentation>A CSS
                selector of elements recorded only as an empty box, besides [data-moqui-block], canvas, video and
                iframe.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="replay-unmask-selector" type="xs:string"><xs:annotation><xs:documentation>A CSS
                selector whose text is recorded as is (menus and labels, say); all other text and every input is
                masked.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType></xs:element></xs:sequence>
        <xs:attribute name="enabled" type="boolean"/>
        <xs:attribute name="sample-ratio" type="xs:string"><xs:annotation><xs:documentation>The share of traces, 0 to
            1, whose spans below the root are kept, decided from the trace id (a client's sampled flag does not change
            it). Every request and job root span is kept whatever the ratio, and the tail rule keeps the whole trace
            of an error or a slow root, so 0 keeps the roots plus the traces worth looking at. A value that is not a
            number is warned about and the default, 0, is used.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="slow-root-ms" type="xs:positiveInteger"><xs:annotation><xs:documentation>A request or job
            root that takes longer than this, in milliseconds, keeps its whole trace (the tail rule), whatever the
            sample ratio. Default 1000. Monitor › Settings can change it for a while.</xs:documentation>
        </xs:annotation></xs:attribute>
        <xs:attribute name="service-name" type="xs:string"/>
        <xs:attribute name="queue-records" type="xs:positiveInteger"><xs:annotation><xs:documentation>Records waiting
            for the exporter; more are dropped and counted. The last 1/16 is kept for request and job roots. The tail
            buffer (spans waiting for their root) shares this bound. Default 8192, at least 64.</xs:documentation>
        </xs:annotation></xs:attribute>
        <xs:attribute name="queue-bytes" type="xs:positiveInteger"><xs:annotation><xs:documentation>Estimated bytes
            waiting for the exporter, with the same 1/16 root reserve, shared by the tail buffer. Default 33554432
            (32 MiB), at least 1048576.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="tail-traces" type="xs:positiveInteger"><xs:annotation><xs:documentation>Traces whose
            unsampled spans wait for the root's tail decision; spans of further traces are dropped. Default 1024.
            </xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="tail-trace-spans" type="xs:positiveInteger"><xs:annotation><xs:documentation>Spans one
            trace may hold while it waits. Default 512.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="interval-seconds" type="xs:positiveInteger"><xs:annotation><xs:documentation>How often
            metrics are collected. Metric documents are minute documents, which the rollups and dashboards assume, so
            anything but 60 is for tests and is warned about.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="span-retention-days" type="xs:nonNegativeInteger"/>
        <xs:attribute name="log-retention-days" type="xs:nonNegativeInteger"/>
        <xs:attribute name="error-retention-days" type="xs:nonNegativeInteger"/>
        <xs:attribute name="annotation-retention-days" type="xs:nonNegativeInteger"/>
        <xs:attribute name="replay-retention-days" type="xs:nonNegativeInteger"/>
        <xs:attribute name="query-values" default="names"><xs:annotation><xs:documentation>What a request span keeps of
            its query and its Referer's query: names, every parameter's name with the value only of pageIndex, pageSize,
            orderByField, renderMode, lastStandalone and _uiType, the others […]; or all, every value, for debugging. A
            secret's value is [REDACTED] either way. Spans go to every SYSTEM_APP reader and to an outside collector
            (otlp-endpoint), and a value is often a search term or a record id (SEC-TLS-18).</xs:documentation></xs:annotation>
            <xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="names"/><xs:enumeration value="all"/></xs:restriction></xs:simpleType>
        </xs:attribute>
        <xs:attribute name="minute-retention-days" type="xs:nonNegativeInteger"/>
        <xs:attribute name="hour-retention-days" type="xs:nonNegativeInteger"/>
        <xs:attribute name="day-retention-days" type="xs:nonNegativeInteger"/>
        <xs:attribute name="otlp-endpoint" type="xs:string"/>
        <xs:attribute name="otlp-headers" type="xs:string"/>
        <xs:attribute name="otlp-compression" type="xs:string"><xs:annotation><xs:documentation>gzip (the default) or none: whether outgoing OTLP request bodies are gzipped (Content-Encoding: gzip).</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="otlp-protocol" type="xs:string"><xs:annotation><xs:documentation>The encoding sent to
            otlp-endpoint: http/protobuf (application/x-protobuf, the OTLP default, used when empty) or http/json
            (application/json). Another value is warned about and http/protobuf is used.</xs:documentation>
            </xs:annotation></xs:attribute>
    </xs:complexType></xs:element>
    <xs:element name="report"><xs:complexType>
        <xs:attribute name="week-start" type="xs:integer"/>
        <xs:attribute name="fiscal-start-month" type="xs:positiveInteger"/>
        <xs:attribute name="fiscal-start-day" type="xs:positiveInteger"/>
        <xs:attribute name="alert-workers" type="xs:string">
            <xs:annotation><xs:documentation>Threads that evaluate alert rules in one pass, default 4, at most 32. The
                calling thread also takes rules.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="save-roots" type="xs:string">
            <xs:annotation><xs:documentation>The locations a scheduled report may save its file under, separated by commas or
                white space (each a directory); empty is dbresource://report/. A saveToLocation outside them, with a ..
                segment, in a component, in a conf directory or a .env file is refused.</xs:documentation></xs:annotation></xs:attribute>
    </xs:complexType></xs:element>
    <xs:element name="resource-watch"><xs:complexType>
        <xs:annotation><xs:documentation>When a reading of the machine or of the server process is a warning or
            critical: the levels of the status map's Resources (ec.factory.getStatusMap), which the System home and
            its attention list show. Values are percentages; a reading at or past a value has that level. An empty
            value turns that level off; an attribute left out, or one that is not a number, keeps its default. Read
            on each use, so a conf reload applies a change.</xs:documentation></xs:annotation>
        <xs:attribute name="disk-warning" type="xs:string"><xs:annotation><xs:documentation>A filesystem's share of its space used, in percent, from which it is a warning. Default 80.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="disk-critical" type="xs:string"><xs:annotation><xs:documentation>A filesystem's share used from which it is critical. Default 90.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="disk-free-critical" type="xs:string"><xs:annotation><xs:documentation>Bytes: a filesystem larger than this with less than this left to write is critical whatever its share. Default 1073741824 (1 GiB).</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="inodes-warning" type="xs:string"><xs:annotation><xs:documentation>A filesystem's share of its file entries (inodes) used. Default 80.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="inodes-critical" type="xs:string"><xs:annotation><xs:documentation>Default 90.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="memory-warning" type="xs:string"><xs:annotation><xs:documentation>The server process's memory as a share of the memory it may use: the container's limit (the cgroup's memory.max) when one is set, else the machine's memory. Default 80.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="memory-critical" type="xs:string"><xs:annotation><xs:documentation>Default 90.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="memory-available-warning" type="xs:string"><xs:annotation><xs:documentation>The machine's available memory as a share of its total: a warning at or below this. Default 10.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="memory-available-critical" type="xs:string"><xs:annotation><xs:documentation>Critical at or below this. Default 5.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="cpu-load-warning" type="xs:string"><xs:annotation><xs:documentation>The 5-minute load average as a share of the processors. Default 80.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="cpu-load-critical" type="xs:string"><xs:annotation><xs:documentation>Default 100.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="open-files-warning" type="xs:string"><xs:annotation><xs:documentation>The process's open files as a share of its soft limit. Default 80.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="open-files-critical" type="xs:string"><xs:annotation><xs:documentation>Default 95.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="swap-warning" type="xs:string"><xs:annotation><xs:documentation>Swap in use as a share of the swap. Default 50.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="swap-critical" type="xs:string"><xs:annotation><xs:documentation>Default empty: swap is never critical.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="certificate-days-warning" type="xs:string"><xs:annotation><xs:documentation>The days until a certificate the HTTPS listener serves expires: a warning at or below this. Default 30.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="certificate-days-critical" type="xs:string"><xs:annotation><xs:documentation>Critical at or below this many days. Default 7.</xs:documentation></xs:annotation></xs:attribute>
    </xs:complexType></xs:element>
    <xs:element name="server-stats">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="artifact-stats"/>
            </xs:sequence>
            <xs:attribute name="bin-length-seconds" type="xs:positiveInteger" default="900">
                <xs:annotation><xs:documentation>Deprecated and ignored: ArtifactHitBin is gone, and artifact metrics
                    are minute documents rolled up to hours and days (see telemetry).</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="visit-enabled" type="boolean" default="true"/>
            <xs:attribute name="visit-ip-info-on-login" type="boolean" default="true"/>
            <xs:attribute name="visitor-enabled" type="boolean" default="true"/>
            <xs:attribute name="stats-skip-condition" type="xs:string">
                <xs:annotation><xs:documentation>Not read; deprecated, and a warning is logged at startup when it is
                    set. Configure artifact telemetry with telemetry/artifact.</xs:documentation></xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="artifact-stats">
        <xs:annotation><xs:documentation>Deprecated: use telemetry/artifact. One left in a conf still applies, with a
            warning at startup: persist-hit turns the type's spans on or off and persist-bin its metrics.
        </xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="type" use="required"><xs:simpleType><xs:restriction base="xs:token">
                <xs:enumeration value="AT_XML_SCREEN"/>
                <xs:enumeration value="AT_XML_SCREEN_CONTENT"/>
                <xs:enumeration value="AT_XML_SCREEN_TRANS"/>
                <xs:enumeration value="AT_SERVICE"/>
                <xs:enumeration value="AT_ENTITY"/>
                <xs:enumeration value="AT_REST_PATH"/>
                <xs:enumeration value="AT_LLM"/>
                <xs:enumeration value="AT_GIT_REPOSITORY"/>
                <xs:enumeration value="AT_OTHER"/>
            </xs:restriction></xs:simpleType></xs:attribute>
            <!-- Removed, note that entity-auto and entity-implicit service calls never have hits persisted and that is
                mainly what this was used for: <xs:attribute name="sub-type" type="xs:string"/> -->
            <xs:attribute name="persist-hit" type="boolean" default="false"/>
            <xs:attribute name="persist-bin" type="boolean" default="false"/>
        </xs:complexType>
    </xs:element>

    <!-- ===================== Webapp Conf Root ===================== -->
    <xs:element name="webapp-list">
        <xs:complexType><xs:sequence><xs:element maxOccurs="unbounded" ref="webapp"/></xs:sequence></xs:complexType>
    </xs:element>
    <xs:element name="webapp">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="root-screen"><xs:complexType>
                    <xs:attribute name="host" type="xs:string" use="required">
                        <xs:annotation><xs:documentation>A pattern to match the host name against (from ServletRequest.getServerName())</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="location" type="xs:string" use="required">
                        <xs:annotation><xs:documentation>The location of the root screen XML file</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="framework-routes">
                        <xs:annotation><xs:documentation>What a host's own root screen serves beside its screens (not in
                            Java; docs/Run-Deploy.md, "Several sites by host name"). Not set: its own screens, and the shared
                            static files (/js, /css, /libs, /images) of the default root (host ".*") when its directory has no
                            such file; the routes outside the screens (token routes, servlets, sockets) answer as on every
                            host. include: its own screens first, then the default root's for a first path name it does not
                            have (the shell, sign-in, the apps, /rest, the error screens). refuse: its own screens and the
                            shared static files only; the token routes, the servlets and the host's own routes (sockets,
                            /dav, /health, /metrics...) are Not Found on the host, but for git (/git/, LFS, and git at a
                            public site's page URL) and the CI runner REST (/ci/runner/), each behind its own
                            authentication.</xs:documentation></xs:annotation>
                        <xs:simpleType><xs:restriction base="xs:token">
                            <xs:enumeration value="include"/>
                            <xs:enumeration value="refuse"/>
                        </xs:restriction></xs:simpleType></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="error-screen"><xs:complexType>
                    <xs:attribute name="error" use="required"><xs:simpleType><xs:restriction base="xs:token">
                        <xs:enumeration value="unauthorized"><xs:annotation><xs:documentation>401 - authentication required</xs:documentation></xs:annotation></xs:enumeration>
                        <xs:enumeration value="forbidden"><xs:annotation><xs:documentation>403 - authorization failed</xs:documentation></xs:annotation></xs:enumeration>
                        <xs:enumeration value="not-found"><xs:annotation><xs:documentation>404 - screen/resource not found</xs:documentation></xs:annotation></xs:enumeration>
                        <xs:enumeration value="too-many"><xs:annotation><xs:documentation>429 - tarpit limit reached</xs:documentation></xs:annotation></xs:enumeration>
                        <xs:enumeration value="internal-error"><xs:annotation><xs:documentation>500 - general error</xs:documentation></xs:annotation></xs:enumeration>
                    </xs:restriction></xs:simpleType></xs:attribute>
                    <xs:attribute name="screen-path" type="xs:string" use="required">
                        <xs:annotation><xs:documentation>The path to the screen to render on error</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="public-site">
                    <xs:complexType><xs:sequence>
                        <xs:element name="mount" minOccurs="1" maxOccurs="unbounded"><xs:complexType>
                            <xs:attribute name="path" type="xs:string" use="required"/>
                            <xs:attribute name="screen" type="xs:string" use="required"/>
                        </xs:complexType></xs:element>
                    </xs:sequence>
                    <xs:attribute name="host" type="xs:string" use="required"/>
                    <xs:attribute name="site-id" type="xs:string" use="required"/>
                    <xs:attribute name="screen-location" type="xs:string" use="required"/>
                    <xs:attribute name="resolver-service" type="xs:string">
                        <xs:annotation><xs:documentation>A service called with siteId, hostname and path for each request
                            under a mount; it answers screenPath, optionally the Forum's topicId, topicSlug and postId, and
                            optionally screenParameters, a Map of named screen parameters (they replace request parameters
                            of the same name; siteId, resolvedSiteId and the Forum's three are bound after them). A mount at
                            "/" claims only this host; a path under any other mount is concealed on hosts no public-site
                            names.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="host-check-service" type="xs:string">
                        <xs:annotation><xs:documentation>A service called with siteId, hostname and path for a request to a
                            framework route on this host (/apps, /qapps, /rest, /Login, the token routes, the servlets...);
                            when it answers restricted true the route is 404 on this host, so nobody signs in to the
                            framework there (a site's theme preview host). The static routes (/js, /css, /libs, /images,
                            /static, /assets) are not checked. A service that fails refuses the route.</xs:documentation></xs:annotation></xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="token-route">
                    <xs:annotation><xs:documentation>An anonymous token route: /name/token renders the screen at
                        screen-location in the public shell (Vue, Quasar, the theme and the m-* components, with no header,
                        drawers or login), /name/token.qvt (or .qvue, .qjs) the screen itself, and /name/token/path what is
                        below it. The token-service runs first, with token and routeName, and answers valid and routeContext;
                        a token it does not accept gets a short "link expired or not found" page and nothing else runs. The
                        screen's context has token and tokenRoute {name, token, basePath, title, context}. A route named as
                        a framework path (apps, qapps, rest, ...) is left out. No Java counterpart.</xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="name" type="xs:string" use="required">
                            <xs:annotation><xs:documentation>The first path segment, for example s, u or call</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="screen-location" type="xs:string" use="required"/>
                        <xs:attribute name="token-service" type="xs:string" use="required"/>
                        <xs:attribute name="title" type="xs:string"/>
                        <xs:attribute name="post-transition" type="xs:string">
                            <xs:annotation><xs:documentation>A transition of the screen that a POST to /name/token itself
                                runs, after the token check, as a POST to /name/token/transition would: an RFC 8058
                                one-click unsubscribe posts to the List-Unsubscribe URL, the page's own. The poster has no
                                session token, so give the transition require-session-token="false". Without it a POST to
                                /name/token is the public shell page.</xs:documentation></xs:annotation></xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="token-path">
                    <xs:annotation><xs:documentation>A path segment that holds a bearer token, served by a component's own
                        screens (a mailed link's /held-mail/token): what the server records of a path or URL (the request
                        log, log lines, a Visit's initialRequest and initialReferrer, browser telemetry) has :token in its
                        place, as for a token-route. It changes nothing of how the path is served. No Java
                        counterpart.</xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="pattern" type="xs:string" use="required">
                            <xs:annotation><xs:documentation>Literal segments, then {token}: /preview/{token} at the root
                                only, /**/held-mail/{token} after any segments (a mount's). The token is a segment of 8 to
                                200 letters, digits, '.', '_', '~' and '-'; what follows it is kept.</xs:documentation></xs:annotation></xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element minOccurs="0" name="first-hit-in-visit"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>
                <xs:element minOccurs="0" name="before-request"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>
                <xs:element minOccurs="0" name="after-request"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>
                <xs:element minOccurs="0" name="after-login"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>
                <xs:element minOccurs="0" name="before-logout"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>
                <xs:element minOccurs="0" name="after-startup"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>
                <xs:element minOccurs="0" name="before-shutdown"><xs:complexType><xs:sequence><xs:element ref="actions"/></xs:sequence></xs:complexType></xs:element>

                <xs:element minOccurs="0" maxOccurs="unbounded" name="context-param"><xs:complexType>
                    <xs:attribute name="name" type="xs:string" use="required"/>
                    <xs:attribute name="value" type="xs:string" use="required"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="filter">
                    <xs:annotation><xs:documentation>
                        A filter on the requests whose path a url-pattern maps (as the Servlet spec has it), run in
                        priority order, then as declared, before the servlet. It is the script at location, whose value is
                        a handler object with doFilter(request, response, chain); chain.doFilter() goes on. Or class, one
                        of the Java classes this server has: org.moqui.impl.webapp.MoquiAuthFilter (the script
                        component://webroot/script/AuthFilter.js) and org.moqui.impl.webapp.ElasticRequestLogFilter
                        (accepted and not run: every request's root span in otel_spans is the request log, written
                        whatever enabled says). See docs/interfaces/Web-Scripts.md.
                    </xs:documentation></xs:annotation>
                    <xs:complexType>
                    <xs:sequence>
                        <xs:element minOccurs="0" maxOccurs="unbounded" ref="init-param"/>
                        <xs:element minOccurs="0" maxOccurs="unbounded" name="url-pattern" type="xs:string"/>
                        <xs:element minOccurs="0" maxOccurs="unbounded" name="dispatcher" type="xs:string"><xs:annotation>
                            <xs:documentation>Only REQUEST: a filter runs once, on the request from the client.</xs:documentation>
                        </xs:annotation></xs:element>
                    </xs:sequence>
                    <xs:attribute name="name" type="xs:string" use="required"/>
                    <xs:attribute name="location" type="xs:string"><xs:annotation><xs:documentation>
                        The script of the filter, such as component://mycomp/script/MyFilter.js. This or class.
                    </xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="class" type="xs:string"/>
                    <xs:attribute name="async-supported" type="boolean" default="false"><xs:annotation><xs:documentation>
                        Not read by this server.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="enabled" type="boolean" default="true"/>
                    <xs:attribute name="priority" type="xs:nonNegativeInteger" default="5"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="listener">
                    <xs:annotation><xs:documentation>
                        The script at location, whose value is a handler object with any of contextInitialized,
                        contextDestroyed, sessionCreated, sessionDestroyed, requestInitialized and requestDestroyed, each
                        taking the event. Or class org.moqui.impl.webapp.MoquiSessionListener, which this server has
                        natively. See docs/interfaces/Web-Scripts.md.
                    </xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="location" type="xs:string"/>
                        <xs:attribute name="class" type="xs:string"/>
                        <xs:attribute name="enabled" type="boolean" default="true"/>
                    </xs:complexType>
                </xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="servlet">
                    <xs:annotation><xs:documentation>
                        What answers the requests whose path a url-pattern maps: an exact path, else the longest /path/*,
                        else *.extension, else the default /. It is the script at location, whose value is a handler object
                        with service(request, response) or doGet, doPost and the other methods. Or class, one of the Java
                        classes this server has: org.moqui.impl.webapp.MoquiServlet (the screens) and
                        org.moqui.impl.webapp.MoquiFopServlet (a screen as PDF). See docs/interfaces/Web-Scripts.md.
                    </xs:documentation></xs:annotation>
                    <xs:complexType>
                    <xs:sequence>
                        <xs:element minOccurs="0" maxOccurs="unbounded" ref="init-param"/>
                        <xs:element minOccurs="1" maxOccurs="unbounded" name="url-pattern" type="xs:string"/>
                    </xs:sequence>
                    <xs:attribute name="name" type="xs:string" use="required"/>
                    <xs:attribute name="location" type="xs:string"><xs:annotation><xs:documentation>
                        The script of the servlet, such as component://mycomp/script/MyServlet.js. This or class.
                    </xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="class" type="xs:string"/>
                    <xs:attribute name="max-body" type="xs:string"><xs:annotation><xs:documentation>
                        The largest request body this servlet takes, such as 100m, in place of the web-protection max-body;
                        for a proxy that passes on a bulk load. Not for a multipart upload, whose limit is max-upload.
                        No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-upload" type="xs:string"><xs:annotation><xs:documentation>
                        The largest multipart/form-data body this servlet takes, such as 10m, in place of the
                        web-protection max-upload; it stops the read, before the file is spooled. No Java counterpart.
                    </xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="load-on-startup" type="xs:nonNegativeInteger" default="1"><xs:annotation>
                        <xs:documentation>Not read by this server.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="async-supported" type="boolean" default="false"><xs:annotation><xs:documentation>
                        Not read by this server.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="enabled" type="boolean" default="true"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" name="session-config"><xs:complexType>
                    <xs:attribute name="timeout" type="non-neg-int-expandable" use="required"><xs:annotation><xs:documentation>
                        Minutes without a request before a web session expires; 0 never expires.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="flush" type="xs:string" default="eventual"><xs:annotation><xs:documentation>
                        eventual writes a changed session after the response; guarantee writes it before. No Java
                        counterpart.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max" type="non-neg-int-expandable" default="10000"><xs:annotation><xs:documentation>
                        Most web sessions kept in memory. Over it, the sessions used longest ago are written and dropped,
                        and reload from HttpSession when they come back. 0 keeps every session. No Java counterpart.
                    </xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="cookie-key" type="xs:string"><xs:annotation><xs:documentation>The HMAC key of the session cookie, 32 random bytes in base64: at CHANGEME generated at the first start into runtime/.env (moqui_conf__webapp_list__webapp__WEBROOT__session_config__cookie_key), and the same on every member of a cluster. A secret, read at boot.</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="endpoint">
                    <xs:annotation><xs:documentation>Add a WebSocket Endpoint</xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="path" type="xs:string" use="required"><xs:annotation><xs:documentation>
                            The path for the endpoint, relative to webapp, must start with forward slash ('/')</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="class" type="xs:string"><xs:annotation><xs:documentation>
                            In Rust the host serves /notws and /termws itself and this is not used. Java: must extend the websocket Endpoint. For Moqui-specific features including setting up an ExecutionContext
                            extend MoquiAbstractEndpoint. Even if not using MoquiAbstractEndpoint it will try
                            to add the following ServerEndpointConfig user properties: handshakeRequest, httpSession,
                            executionContextFactory, and maxIdleTimeout (set to value of @timeout).</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="timeout" type="xs:integer"><xs:annotation><xs:documentation>
                            Milliseconds with nothing from the client before the socket closes.</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="enabled" type="boolean-expandable" default="true"/>
                    </xs:complexType>
                </xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="response-header"><xs:complexType>
                    <xs:attribute name="type" use="required"><xs:simpleType><xs:restriction base="xs:token">
                        <xs:enumeration value="web-resource-inline"/>
                        <xs:enumeration value="screen-resource-binary"/>
                        <xs:enumeration value="screen-resource-text"/>
                        <xs:enumeration value="screen-resource-template"/>
                        <xs:enumeration value="screen-render"/>
                        <xs:enumeration value="screen-secure"/>
                        <xs:enumeration value="screen-server-static"/>
                        <xs:enumeration value="screen-transition"/>
                        <xs:enumeration value="cors-actual"/>
                        <xs:enumeration value="cors-preflight"/>
                    </xs:restriction></xs:simpleType></xs:attribute>
                    <xs:attribute name="name" type="xs:string" use="required"/>
                    <xs:attribute name="value" type="xs:string" use="required"/>
                    <xs:attribute name="add" type="boolean" default="false"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" ref="web-protection"/>
            </xs:sequence>
            <xs:attribute name="name" type="name-plain" use="required"><xs:annotation><xs:documentation>
                Matched against value of a context-param.param-value element in the web.xml file where the param-name is "moqui-name".</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="https-enabled" default="false" type="xs:string"/>
            <xs:attribute name="https-port" type="xs:string"/>
            <xs:attribute name="https-host" type="xs:string"/>
            <xs:attribute name="app-redirect-uris" type="xs:string"><xs:annotation><xs:documentation>The redirect URIs
                the desktop and mobile apps' sign-in may return to, comma or space separated; empty for the apps' own.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="app-loopback-redirect" type="xs:string" default="true"><xs:annotation><xs:documentation>Whether
                an app's sign-in may also return to a loopback address (http://127.0.0.1:port), as a desktop app
                does.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="http-port" type="xs:string"/>
            <xs:attribute name="http-host" type="xs:string"/>
            <xs:attribute name="handle-cors" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>
                Set to false to disable CORS handling globally in MoquiServlet including Origin validation and adding cors-preflight and cors-actual configured response headers
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="allow-origins" type="xs:string"><xs:annotation><xs:documentation>
                Comma separated list of host name or protocol plus host name to match against Origin request header; can be '*' to allow all.
                An entry with a protocol (https://app.example:8443) must match the Origin's scheme, host and port, the port
                defaulted for the scheme; a bare host name (moqui.org) allows that host and its subdomains on any scheme and
                port (moqui.org:8443 on that port only). The request's own origin is always allowed, compared by scheme, host
                and port (stricter than Moqui Java, which compares the host only).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="require-session-token" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>
                If not false (default true) moquiSessionToken (from ec.web.sessionToken) must be passed to all
                screen/transition requests in a session after the first.</xs:documentation></xs:annotation></xs:attribute>
            <!-- Needed? Not yet implemented: <xs:attribute name="cookie-domain" type="xs:string"/> -->
            <xs:attribute name="websocket-timeout" type="xs:integer"><xs:annotation><xs:documentation>
                The default WebSocket session max idle timeout for the whole server.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="upload-executable-allow" type="boolean-expandable" default="false"/>
            <xs:attribute name="client-ip-header" type="xs:string"><xs:annotation><xs:documentation>
                Set this if there is a reverse proxy in front of the Moqui server.

                Using X-Forwarded-For is risky because clients can set a value for the header to spoof a client IP
                address; if the outer-most proxy handles X-Forwarded-For by always setting it to its client IP address
                instead of the common default behavior of appending to an existing X-Forwarded-For header then it is fine,
                but should generally be set to a more reliable header for the reverse-proxy used.

                With trusted-proxies set the header is read only from those proxies, and the address taken is the
                rightmost one that is not itself a trusted proxy, so an appended X-Forwarded-For is safe too.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="trusted-proxies" type="xs:string"><xs:annotation><xs:documentation>
                Comma separated address ranges (10.0.0.0/8, fd00::/8, or one address) of the reverse proxies in front.
                client-ip-header and X-Forwarded-Proto are believed only from these. When one or more are set the
                per-client parts of web-protection are on by default. Empty, the header is believed from any peer
                (first hop), as before. No Java counterpart.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="https-listen-port" type="xs:string"><xs:annotation><xs:documentation>The port the built-in HTTPS listener binds, with certificates from runtime/cert: empty is 8443, off none. https-port is the port clients see in generated URLs, which differs behind a reverse proxy.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="http-bind" type="xs:string"><xs:annotation><xs:documentation>The address the HTTP listener binds, every address when empty; 127.0.0.1 keeps it local.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="allowed-hosts" type="xs:string"><xs:annotation><xs:documentation>The Host names (with the port, as the header gives it: 127.0.0.1:8080) a request straight to a listener must name, comma separated, or it is answered 421; empty takes any.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="csp-append" type="xs:string" default=""><xs:annotation><xs:documentation>Directives added to every screen response's Content-Security-Policy, or the whole policy where none is set; empty adds none (the Desktop app's sidecar: upgrade-insecure-requests).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="http2" type="boolean" default="true"><xs:annotation><xs:documentation>HTTP/2 on the HTTPS listener, chosen by ALPN beside HTTP/1.1: true, or false for HTTP/1.1 only.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="dev-marker-color" type="xs:string"><xs:annotation><xs:documentation>The color of the dev/test instance marker of the Quasar shell, a CSS color; empty turns it off.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="qvt-static-only" type="boolean" default="false"><xs:annotation><xs:documentation>true sends the qvt pages with the Vue build that has no template compiler, for a deployment whose pages are all server-static and whose CSP has no unsafe-eval.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="status-ips" type="xs:string"><xs:annotation><xs:documentation>
                Comma separated addresses that may read /health and /metrics, besides loopback. No Java counterpart.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="transfer-workers" type="non-neg-int-expandable" default="4"><xs:annotation><xs:documentation>
                A file response over 256 KiB streams, read a window at a time as the client takes it; at most this many
                reads of files in the database run at once, each holding a connection of the content pool for one
                window. Fewer run when that pool cannot hold this many beside the request and service workers (a
                warning at startup says so). No Java counterpart.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="socket-room-clients" type="xs:positiveInteger" default="4"><xs:annotation><xs:documentation>
                The clients one notification socket may keep in one CalcGrid room or one co-edited page; a join past it
                is refused (429). Read on each join (webroot webapp).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="socket-awareness-bytes" type="xs:positiveInteger" default="4096"><xs:annotation><xs:documentation>
                The largest co-editing awareness (a join's and an awareness frame's, as JSON) a notification socket may
                send; a larger one is refused (413). Read on each frame (webroot webapp).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="socket-joins-per-minute" type="xs:positiveInteger" default="60"><xs:annotation><xs:documentation>
                The CalcGrid room and co-edited page joins one notification socket may make a minute, given back
                evenly over the minute; more are refused (429). Read on each join (webroot webapp).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="socket-user-joins-per-minute" type="xs:positiveInteger" default="240"><xs:annotation><xs:documentation>
                The joins one user's notification sockets may make a minute together, given back evenly over the
                minute; more are refused (429). Read on each join (webroot webapp).</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="web-protection">
        <xs:annotation><xs:documentation>Load handling and basic WAF features at the edge, checked before a session,
            a request worker or the database is spent, in memory per server. The global limits (connections, requests,
            overload) always apply. The per-client parts (max-per-client, the request methods, rate-limit, ban, and the
            rules) apply when enabled is true, or when it is empty and the webapp has trusted-proxies. Not the
            ArtifactTarpit, which counts a user's use of screens and services for business quotas; both apply, this
            first. Each attribute left out or empty uses its webapp_* property, then the built-in default. No Java
            counterpart.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" name="connections"><xs:complexType>
                    <xs:attribute name="max" type="xs:string"><xs:annotation><xs:documentation>
                        Connections served at once, HTTP and HTTPS together (webapp-list/webapp[webroot]/web-protection/connections@max, 4096). Past it new
                        connections wait until one closes.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-per-client" type="xs:string"><xs:annotation><xs:documentation>
                        Connections from one client address at once (64); past it a new one is closed. Trusted proxies
                        and exempt clients are not counted.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="header-timeout" type="xs:string"><xs:annotation><xs:documentation>
                        Seconds for the request head, the TLS handshake, and an idle kept-alive connection
                        (webapp-list/webapp[webroot]/web-protection/connections@header-timeout, 30); 0 is no limit.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="write-timeout" type="xs:string"><xs:annotation><xs:documentation>
                        Seconds a write to a client may take nothing before the connection, or the WebSocket on it, is
                        closed (webapp-list/webapp[webroot]/web-protection/connections@write-timeout, 60); a write that moves any bytes starts it again. Also the
                        connections' TCP_USER_TIMEOUT on Linux. 0 is no limit.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="shutdown-timeout" type="xs:string"><xs:annotation><xs:documentation>
                        Seconds open connections may take to finish after a stop (webapp-list/webapp[webroot]/web-protection/connections@shutdown-timeout, 30).</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="http2-max-streams" type="xs:string"><xs:annotation><xs:documentation>
                        Requests one HTTP/2 connection of the HTTPS listener may have open at once
                        (webapp-list/webapp[webroot]/web-protection/connections@http2-max-streams, 100). An HTTP/2 connection with no request for header-timeout is
                        closed with a GOAWAY.</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" name="requests"><xs:complexType>
                    <xs:attribute name="methods" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated request methods allowed; another is answered 405. Empty allows any. A per-client
                        rule: it applies when the per-client parts are on.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-uri-length" type="xs:string"><xs:annotation><xs:documentation>
                        Longest path and query (8192); longer is answered 414.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-header-bytes" type="xs:string"><xs:annotation><xs:documentation>
                        Largest request head in bytes (65536, at least 8192); larger is answered 431.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-headers" type="xs:string"><xs:annotation><xs:documentation>
                        Most header fields in a request (100); more is answered 431.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-body" type="xs:string"><xs:annotation><xs:documentation>
                        Largest request body that is not multipart, bytes or with a k, m or g suffix (webapp-list/webapp[webroot]/web-protection/requests@max-body,
                        10m); larger is answered 413. The text fields of a multipart body hold at most this together.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-upload" type="xs:string"><xs:annotation><xs:documentation>
                        Largest multipart/form-data body (webapp-list/webapp[webroot]/web-protection/requests@max-upload, 2g). A request with no user (no session
                        signed in, no api_key or login_key, no Basic credentials that hold) takes max-body instead,
                        unless its path is one of anonymous-upload-paths.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-spool" type="xs:string"><xs:annotation><xs:documentation>The bytes the files of the uploads being read hold together, or with a k, m or g suffix; an upload past it is answered 503. 4 GiB by default.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="anonymous-upload-paths" type="xs:string"><xs:annotation><xs:documentation>
                        Path prefixes, comma separated, of the uploads taken without a user, such as a public share's
                        file drop (webapp-list/webapp[webroot]/web-protection/requests@anonymous-upload-paths, /s/); an upload there may be max-upload with no user.
                    </xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="body-timeout" type="xs:string"><xs:annotation><xs:documentation>
                        Seconds for a whole request body that is not an upload (webapp-list/webapp[webroot]/web-protection/requests@body-timeout, 60); then 408.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="upload-idle-timeout" type="xs:string"><xs:annotation><xs:documentation>
                        Seconds an upload may send nothing (webapp-list/webapp[webroot]/web-protection/requests@upload-idle-timeout, 60); then 408.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="upload-min-rate" type="xs:string"><xs:annotation><xs:documentation>
                        Bytes a second an upload (a multipart body, a DAV PUT) must arrive at on average once body-timeout
                        has passed (webapp-list/webapp[webroot]/web-protection/requests@upload-min-rate, 1024); a slower one
                        is cut off with 408, so slow uploads cannot hold the connections for as long as they like. 0 turns
                        it off.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-uploads" type="xs:string"><xs:annotation><xs:documentation>
                        Uploads arriving at once (webapp-list/webapp[webroot]/web-protection/requests@max-uploads, 1024);
                        another is answered 503, so uploads never take every connection. An upload whose request names no
                        user takes only three quarters of them.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="max-uploads-per-client" type="xs:string"><xs:annotation><xs:documentation>
                        Uploads with no user one client (an IPv6 one by client-ipv6-prefix) has arriving at once
                        (webapp-list/webapp[webroot]/web-protection/requests@max-uploads-per-client, 16), whether or not
                        the per-client parts are on; another is answered 503. Counted only by an address that is the
                        client's: with client-ip-header or trusted-proxies set, or a peer not on loopback or a private
                        network (a reverse proxy or an office NAT in front would otherwise be every client).</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="request-timeout" type="xs:string"><xs:annotation><xs:documentation>
                        Seconds from the request head to the response head (webapp-list/webapp[webroot]/web-protection/requests@request-timeout, 300); then 504.</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" name="overload"><xs:complexType>
                    <xs:attribute name="queue-timeout" type="xs:string"><xs:annotation><xs:documentation>
                        Seconds a request may wait for a request worker (10); one that waited
                        longer is answered 503 instead of run. 0 is no limit.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="retry-after" type="xs:string"><xs:annotation><xs:documentation>
                        The Retry-After seconds of a 503 for a full queue or a busy server (5).</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="rate-limit"><xs:complexType>
                    <xs:annotation><xs:documentation>Per client: requests per seconds sustained and burst at once, over
                        the requests path and methods match (all when left out). Past it the answer is 429 with
                        Retry-After. A request takes a token from every rate-limit that matches it. Merged by name; a
                        component sets enabled="false" to turn one off.</xs:documentation></xs:annotation>
                    <xs:attribute name="name" type="xs:string" use="required"/>
                    <xs:attribute name="requests" type="xs:string"/>
                    <xs:attribute name="seconds" type="xs:string" default="1"/>
                    <xs:attribute name="burst" type="xs:string"><xs:annotation><xs:documentation>
                        Requests allowed at once; requests when left out.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="path" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated url-pattern style globs: * within a segment, ** across segments.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="methods" type="xs:string"/>
                    <xs:attribute name="host" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated host names this one applies to, *.example.com for any name under one; left out, every
                        host. For a site that is stricter than the others (plans/Edge-Node2.md §4.3), on top of the ones
                        without host.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="anonymous" type="xs:string" default="false"><xs:annotation><xs:documentation>
                        true: only requests with no credentials count, those with no Authorization, api_key or login_key
                        header (a session cookie is not looked at). For what anyone may use without signing in, such as
                        git clones of public repositories.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="enabled" type="xs:string" default="true"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="ban"><xs:complexType>
                    <xs:annotation><xs:documentation>Per client: threshold of events within seconds bans the client for
                        duration seconds. A banned client's connections are closed and its requests answered 403. Merged
                        by name. The events of every host count. A ban started on one server is told to the other members
                        of its cluster and to the edge node it is paired with, which ban the client too; one
                        a paired node tells an edge node holds there for that node's hosts only (plans/Edge-Node2.md
                        §4.3).</xs:documentation></xs:annotation>
                    <xs:attribute name="name" type="xs:string" use="required"/>
                    <xs:attribute name="events" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated: auth-failure (credentials that were not valid: a login form, Basic auth, an API
                        or login key, git), rate-limited (a 429), denied (a rule refused the request), ci-token-failure
                        (a well-formed CI job, runner or pool token that was not known).</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="threshold" type="xs:string"/>
                    <xs:attribute name="seconds" type="xs:string"/>
                    <xs:attribute name="duration" type="xs:string"/>
                    <xs:attribute name="enabled" type="xs:string" default="true"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="client-rule"><xs:complexType>
                    <xs:attribute name="name" type="xs:string"><xs:annotation><xs:documentation>
                        A rule with a name merges by it; one without is added.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="enabled" type="xs:string" default="true"/>
                    <xs:attribute name="action"><xs:simpleType><xs:restriction base="xs:token">
                        <xs:enumeration value="deny"><xs:annotation><xs:documentation>Connections closed, requests 403.</xs:documentation></xs:annotation></xs:enumeration>
                        <xs:enumeration value="exempt"><xs:annotation><xs:documentation>No rules, rate limits or bans; the global limits still apply.</xs:documentation></xs:annotation></xs:enumeration>
                    </xs:restriction></xs:simpleType></xs:attribute>
                    <xs:attribute name="cidr" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated address ranges.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="host" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated host names this one applies to, *.example.com for any name under one; left out, every
                        host. For a site that is stricter than the others (plans/Edge-Node2.md §4.3), on top of the ones
                        without host. A connection, before its request names a host, and a ban use only the client rules
                        without host.</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="path-rule"><xs:complexType>
                    <xs:attribute name="name" type="xs:string"><xs:annotation><xs:documentation>
                        A rule with a name merges by it; one without is added.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="enabled" type="xs:string" default="true"/>
                    <xs:attribute name="action"><xs:simpleType><xs:restriction base="xs:token">
                        <xs:enumeration value="deny"><xs:annotation><xs:documentation>Answered 404.</xs:documentation></xs:annotation></xs:enumeration>
                    </xs:restriction></xs:simpleType></xs:attribute>
                    <xs:attribute name="path" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated url-pattern style globs, matched without regard to case against the decoded path.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="host" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated host names this one applies to, *.example.com for any name under one; left out, every
                        host. For a site that is stricter than the others (plans/Edge-Node2.md §4.3), on top of the ones
                        without host.</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="user-agent-rule"><xs:complexType>
                    <xs:attribute name="name" type="xs:string"><xs:annotation><xs:documentation>
                        A rule with a name merges by it; one without is added.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="enabled" type="xs:string" default="true"/>
                    <xs:attribute name="action"><xs:simpleType><xs:restriction base="xs:token">
                        <xs:enumeration value="deny"><xs:annotation><xs:documentation>Answered 403.</xs:documentation></xs:annotation></xs:enumeration>
                    </xs:restriction></xs:simpleType></xs:attribute>
                    <xs:attribute name="contains" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated text; a User-Agent containing one, without regard to case, is denied.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="host" type="xs:string"><xs:annotation><xs:documentation>
                        Comma separated host names this one applies to, *.example.com for any name under one; left out, every
                        host. For a site that is stricter than the others (plans/Edge-Node2.md §4.3), on top of the ones
                        without host.</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
            </xs:sequence>
            <xs:attribute name="enabled" type="xs:string"><xs:annotation><xs:documentation>
                true or false for the per-client parts (webapp-list/webapp[webroot]/web-protection@enabled); empty, on when the webapp has
                trusted-proxies.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="client-ipv6-prefix" type="xs:string" default="64"><xs:annotation><xs:documentation>
                IPv6 clients are counted by this many leading bits of their address.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-tracked-clients" type="xs:string" default="100000"><xs:annotation><xs:documentation>
                Most clients kept in memory; past it new clients are served without per-client limits.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <!-- ====================== Artifact Execution Facade Conf Root ======================= -->
    <xs:element name="artifact-execution-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="artifact-execution"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="artifact-execution">
        <xs:complexType>
            <xs:attribute name="type" use="required">
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="AT_XML_SCREEN"/>
                        <xs:enumeration value="AT_XML_SCREEN_TRANS"/>
                        <xs:enumeration value="AT_SERVICE"/>
                        <xs:enumeration value="AT_ENTITY"/>
                        <xs:enumeration value="AT_REST_PATH"/>
                        <xs:enumeration value="AT_LLM"/>
                        <xs:enumeration value="AT_GIT_REPOSITORY"/>
                        <xs:enumeration value="AT_OTHER"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="authz-enabled" type="boolean" default="true"/>
            <xs:attribute name="tarpit-enabled" type="boolean" default="true"/>
        </xs:complexType>
    </xs:element>

    <!-- ====================== User Facade Conf Root ======================= -->
    <xs:element name="user-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" ref="password"/>
                <xs:element minOccurs="0" ref="login-key"/>
                <xs:element minOccurs="0" ref="login"/>
                <xs:element minOccurs="0" ref="authz"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="authz">
        <xs:annotation><xs:documentation>Grants that only a holder may make. No Java counterpart. The attributes hold the
            framework's lists; a component adds to them with privileged-group and sealed-permission elements, which the
            conf merge adds to the others by name and never replaces. Setting an attribute replaces its list.
        </xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="privileged-group">
                    <xs:annotation><xs:documentation>A UserGroup added to privileged-groups.</xs:documentation></xs:annotation>
                    <xs:complexType><xs:attribute name="name" type="xs:string" use="required"/></xs:complexType>
                </xs:element>
                <xs:element name="sealed-permission">
                    <xs:annotation><xs:documentation>A UserPermission added to sealed-permissions.</xs:documentation></xs:annotation>
                    <xs:complexType><xs:attribute name="name" type="xs:string" use="required"/></xs:complexType>
                </xs:element>
            </xs:choice>
            <xs:attribute name="privileged-groups" type="xs:string" default="ADMIN,ADMIN_ADV,SYSMSG_RECEIVE"><xs:annotation><xs:documentation>
                Comma separated UserGroup IDs. UserGroupMember create, update and delete for these groups is allowed
                only if the caller is already a member (seed/install and disableAuthz skip the check). An administrator
                who is not a member puts a remote system's user in SYSMSG_RECEIVE with a data load, not from a screen.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sealed-permissions" type="xs:string"><xs:annotation><xs:documentation>
                Comma separated UserPermission IDs. UserGroupPermission create, update and delete for these IDs is
                allowed only if the caller already has that permission.
            </xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="password">
        <xs:complexType>
            <xs:attribute name="encrypt-hash-type" default="SHA-256">
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="SHA-256"/>
                    <xs:enumeration value="SHA-384"/>
                    <xs:enumeration value="SHA-512"/>
                    <xs:enumeration value="SHA"/>
                    <xs:enumeration value="MD5"/>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="min-length" type="xs:nonNegativeInteger" default="8">
                <xs:annotation><xs:documentation>Minimum length of password</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="min-digits" type="xs:nonNegativeInteger" default="1">
                <xs:annotation><xs:documentation>Minimum number of digits (numeric characters) in the password</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="min-others" type="xs:nonNegativeInteger" default="1">
                <xs:annotation><xs:documentation>Minimum number of other (non-alpha/numeric, not letters or digits) characters in the password</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="history-limit" type="xs:nonNegativeInteger" default="5">
                <xs:annotation><xs:documentation>Number of old passwords to save that cannot be reused (0 means don't save any history)</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="change-weeks" type="xs:decimal" default="12">
                <xs:annotation><xs:documentation>Require password change after this many months (0 means don't ever require change)</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="email-require-change" type="boolean" default="false">
                <xs:annotation><xs:documentation>Require password change after a password reset email?</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="email-expire-hours" type="xs:nonNegativeInteger" default="48">
                <!-- TODO use in impl -->
                <xs:annotation><xs:documentation>How long will the new password be valid from the password reset email?</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="login-key">
        <xs:complexType>
            <xs:attribute name="encrypt-hash-type" default="SHA-256">
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="SHA-256"/>
                    <xs:enumeration value="SHA-384"/>
                    <xs:enumeration value="SHA-512"/>
                    <xs:enumeration value="SHA"/>
                    <xs:enumeration value="MD5"/>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="expire-hours" type="xs:nonNegativeInteger" default="144">
                <xs:annotation><xs:documentation>Expire key after this many hours</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="device-expire-hours" type="xs:nonNegativeInteger" default="2160">
                <xs:annotation><xs:documentation>Expire a device's key (the REST login with createLoginKey and deviceName, which
                    a desktop or mobile client keeps instead of the password) after this many hours</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="login">
        <xs:complexType>
            <xs:attribute name="max-failures" type="xs:nonNegativeInteger" default="3">
                <xs:annotation><xs:documentation>Account is disabled after max failures</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="disable-minutes" type="xs:nonNegativeInteger" default="30">
                <xs:annotation><xs:documentation>How long to disable the account (0 means no limit, ie forever)</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="history-store" type="boolean" default="true">
                <xs:annotation><xs:documentation>Store records of login attempts?</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="reauth-email-codes-per-hour" type="xs:nonNegativeInteger" default="5">
                <xs:annotation><xs:documentation>The re-authentication codes mailed to an account's verified address
                    (send#ReauthEmailCode, for an account with no password) in an hour, whoever asks; past it one is
                    refused. Each such code is good for ten minutes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="initial-admin-enabled" type="boolean-expandable" default="false">
                <xs:annotation><xs:documentation>The Login page's Create Initial Admin Account form and
                    create#InitialAdminAccount, while no account exists but the seed ones.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="initial-admin-local" default="loopback">
                <xs:annotation><xs:documentation>Who creates the first administrator with no setup secret: a request
                    from this machine (loopback), or only one made in the server's own process (in-process: the Desktop
                    app's node, where any account of the computer reaches the loopback ports).</xs:documentation></xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="loopback"/>
                        <xs:enumeration value="in-process"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="initial-admin-secret" type="xs:string" default="">
                <xs:annotation><xs:documentation>The setup secret the first administrator takes, when the server's starter
                    chooses it and hands it to its own client (the Desktop app for its sidecar): a secret of the conf,
                    never logged; empty, the server makes one at start and writes it to its startup log.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="history-incorrect-password" type="boolean" default="false">
                <xs:annotation><xs:documentation>Ignored: the password a login tried is never stored, as that is too much
                    security risk (UserLoginHistory.passwordUsed is removed). Kept so a Java conf that sets it is still
                    valid.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sso-linked-service" type="xs:string"><xs:annotation><xs:documentation>A service told of
                each real SSO sign-in (an OAuth or OpenID Connect flow, org.moqui.sso.AuthServices.handle#Callback) that
                links or confirms the account's provider id (UserAccount.externalUserId), once the sign-in's transaction
                commits, with authorization disabled: userId, authFlowId, providerHost (the host of the user info
                endpoint), externalUserId, login (the provider's username), email, emailVerified (Boolean) and
                urlsOverridden (Boolean: the flow sets an endpoint or discovery URL of its own). A failure is logged and
                never blocks the sign-in; a write of externalUserId by hand calls nothing. None when empty.
                docs/security/Recent-Auth.md, SSO sign-in hook.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <!-- Future security settings:
    # NOTE: LDAP auth settings

    # - - allow x509 certificate login
    login.cert.allow=true

    # - - HTTP header based ID (for integrations; make sure client can't send this with some sort of filter)
    #login.http.header=REMOTE_USER

    # - - HttpServletRequest.getRemoteUser() based ID (for integration; uncomment to enable)
    # Use for external authentication solutions like CAS which overload the getRemoteUser method.
    #login.http.servlet.getRemoteUser.allow=true
    -->

    <!-- ====================== Transaction Facade Conf Root ======================= -->
    <xs:element name="transaction-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" ref="server-jndi"><xs:annotation><xs:documentation>
                    If not present the default JNDI server will be used.</xs:documentation></xs:annotation></xs:element>
                <xs:choice minOccurs="0">
                    <xs:element minOccurs="0" ref="transaction-jndi"/>
                    <xs:element minOccurs="0" ref="transaction-internal"/>
                </xs:choice>
            </xs:sequence>
            <xs:attribute name="use-transaction-cache" default="true" type="boolean"/>
            <xs:attribute name="use-connection-stash" default="true" type="boolean"/>
            <xs:attribute name="use-lock-track" default="false" type="boolean-expandable">
                <xs:annotation><xs:documentation>If true track locks from create, update, and delete plus FK locks and find for-update,
                    use that data to warn about possible lock conflicts</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="use-statement-timeout" default="false" type="boolean-expandable">
                <xs:annotation><xs:documentation>If true runs all JDBC statements in a separate Thread in order to enforce a timeout,
                    this has significant overhead but protects against long held locks, etc</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="transaction-jndi">
        <xs:complexType>
            <xs:attribute name="user-transaction-jndi-name" type="xs:string" use="required"/>
            <xs:attribute name="transaction-manager-jndi-name" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="transaction-internal">
        <xs:complexType>
            <xs:attribute name="class" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <!-- ====================== Resource Facade Conf Root ================= -->
    <xs:element name="resource-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="resource-reference"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="template-renderer"/>
                <xs:element minOccurs="0" maxOccurs="1" ref="theme-limits"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="script-runner"/>
                <xs:element minOccurs="0" maxOccurs="1" name="drive-share">
                    <xs:annotation><xs:documentation>The limits of a drive's share links (FileServices download#PublicShare,
                        upload#PublicShare; SEC-BOS-83, SEC-FIL-06), per link and per requester. No Java counterpart.</xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="folder-zip-max-bytes" type="non-neg-int-expandable" default="1073741824"><xs:annotation><xs:documentation>The most bytes a folder's zip holds; a larger folder is refused, not cut.</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="folder-zip-max-files" type="non-neg-int-expandable" default="20000"><xs:annotation><xs:documentation>The most files a folder's zip holds; a folder with more is refused.</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="folder-zip-builds-per-link" type="non-neg-int-expandable" default="20"><xs:annotation><xs:documentation>The folder zips made for one link in ten minutes; a zip kept and sent again counts nothing.</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="folder-zip-downloads-per-requester" type="non-neg-int-expandable" default="30"><xs:annotation><xs:documentation>The folder zips one requester asks for in ten minutes.</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="upload-max-files" type="non-neg-int-expandable" default="20"><xs:annotation><xs:documentation>Files in one upload through a link.</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="upload-max-bytes" type="non-neg-int-expandable" default="104857600"><xs:annotation><xs:documentation>Bytes in one upload through a link.</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="upload-link-max-files" type="non-neg-int-expandable" default="1000"><xs:annotation><xs:documentation>Files uploaded through one link in all.</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="upload-link-max-bytes" type="non-neg-int-expandable" default="2147483648"><xs:annotation><xs:documentation>Bytes uploaded through one link in all.</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="upload-calls-per-link" type="non-neg-int-expandable" default="30"><xs:annotation><xs:documentation>Upload calls through one link in an hour.</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="upload-calls-per-requester" type="non-neg-int-expandable" default="60"><xs:annotation><xs:documentation>Upload calls from one requester in an hour.</xs:documentation></xs:annotation></xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element minOccurs="0" maxOccurs="1" name="rich-text-images">
                    <xs:annotation><xs:documentation>The limits of each user's rich-text images (ResourceServices
                        upload#RichTextImage, POST /richTextImage; SEC-CLI-92), counted from the moqui.resource.RichTextImage
                        rows. An upload past either is refused and nothing is stored. No Java counterpart.</xs:documentation></xs:annotation>
                    <xs:complexType>
                        <xs:attribute name="max-per-user" type="non-neg-int-expandable" default="1000"><xs:annotation><xs:documentation>The most rich-text images one user stores; empty or 0 is the default.</xs:documentation></xs:annotation></xs:attribute>
                        <xs:attribute name="max-bytes-per-user" type="non-neg-int-expandable" default="209715200"><xs:annotation><xs:documentation>The most bytes of rich-text images one user stores in all, as stored (after the metadata is taken out); empty or 0 is the default.</xs:documentation></xs:annotation></xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="xml-actions-template-location" type="xs:string"/>
            <xs:attribute name="xsl-fo-handler-factory" type="xs:string"><xs:annotation><xs:documentation>
                Name of the ToolFactory to use for XSL-FO transformation in the ResourceFacade.xslFoTransform() method.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="blob-chunk-size" type="non-neg-int-expandable" default="1048576"><xs:annotation><xs:documentation>Bytes per ContentBlobChunk row of a content blob (moqui.resource.ContentBlob). No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="blob-gc-prune-days" type="non-neg-int-expandable" default="14"><xs:annotation><xs:documentation>How many days a content blob nothing refers to is kept (gc#ContentBlobs). No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="dbresource-blob-threshold" type="non-neg-int-expandable" default="65536"><xs:annotation><xs:documentation>A dbresource file over this many bytes is a content blob (stored once, streamed), not fileData. No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="image-max-concurrent" type="non-neg-int-expandable" default="2"><xs:annotation><xs:documentation>Image conversions (convert#Image) and rich-text image uploads (upload#RichTextImage) that may run at once; a decoded image may take hundreds of MB. No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sftp-max-read" type="non-neg-int-expandable" default="67108864"><xs:annotation><xs:documentation>The largest file, in bytes, the SFTP client (SftpClient getText and getBinary, poll#SystemMessageSftp) reads from a remote server; a larger one is refused. No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="script-module-cache" type="boolean" default="true"><xs:annotation><xs:documentation>A module ec.resource.script loads whose top level only declares gives the same value for the rest of the outermost script run, made once; false makes it again at each load. Read once.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="collab-max-state-bytes" type="xs:positiveInteger" default="8388608"><xs:annotation><xs:documentation>The most bytes a co-edited page's state may take; an update past it is refused (413). The whole state is held in memory and written again at each flush. Read on each update.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="drive-root" type="xs:string" default="dbresource://drive"><xs:annotation><xs:documentation>The location under which a new personal drive (personal/userId) and a new shared folder drive (shared/driveId) are made (FileServices ensure#PersonalDrive, create#Drive). A setting, not a user preference, so a user does not choose where their drive is. No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="script-timeout" type="xs:string"><xs:annotation><xs:documentation>Seconds a script may run when no transaction limits it (a widget condition, a
                transaction="ignore" service), on every thread; a transaction's own timeout replaces it, and 0 is no
                limit. Empty, a script on a request worker is limited to the webapp's request-timeout and one on a
                service, job or scheduler thread is not limited, as in Java.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="resource-reference">
        <xs:annotation><xs:documentation>Maps a scheme to a built-in resource implementation or a linked
            native ResourceProvider identifier. This does not create a service or a tool.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="scheme" type="xs:string" use="required"/>
            <xs:attribute name="class" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="template-renderer">
        <xs:annotation><xs:documentation>Maps an extension to a built-in renderer or linked native
            TemplateRenderer identifier. This does not create a service or a tool.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="extension" type="xs:string" use="required"/>
            <xs:attribute name="class" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="theme-limits">
        <xs:annotation><xs:documentation>The operator's budgets of the theme composition adapter (ec.resource.theme,
            docs/ui/Themes.md). Each lowers its default; a value above the default is ignored. The defaults are 100
            sections a page, 100 blocks a section, depth 8, include depth 8, 2 MiB of output, 1000 ms a render,
            5000 ms a page and 32 MiB of sandbox memory.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="max-sections" type="xs:positiveInteger"/>
            <xs:attribute name="max-blocks" type="xs:positiveInteger"/>
            <xs:attribute name="max-depth" type="xs:positiveInteger"/>
            <xs:attribute name="max-include-depth" type="xs:positiveInteger"/>
            <xs:attribute name="max-output-bytes" type="xs:positiveInteger"/>
            <xs:attribute name="render-time-ms" type="xs:positiveInteger"/>
            <xs:attribute name="page-time-ms" type="xs:positiveInteger"/>
            <xs:attribute name="memory-bytes" type="xs:positiveInteger"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="script-runner">
        <xs:complexType>
            <xs:attribute name="extension" type="xs:string" use="required"/>
            <xs:attribute name="class" type="xs:string" use="optional">
                <xs:annotation><xs:documentation>If specified should point to a class that implements the
                    ScriptRunner interface.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="engine" type="xs:string" use="optional">
                <xs:annotation><xs:documentation>The JSR-223 engine name, i.e. the name passed to the
                    ScriptEngine getEngineByName() method. If you use this attribute do not use the class
                    attribute as that will override this setting.

                    NOTE: If you use a default extension supported in JSR-223 for the desired scripting language you do
                    not need a script-runner element. The ScriptEngine will be looked up using the
                    ScriptEngineManager.getEngineByExtension() method and the script (pre-compiled if supported) will
                    be cached in the "resource.script${extension}.location" cache.
                </xs:documentation></xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <!-- ====================== Screen Facade Conf Root =================== -->
    <xs:element name="screen-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" name="pdf"><xs:complexType>
                    <xs:annotation><xs:documentation>PDF, the html-print render through headless Chromium. No Java
                        counterpart.</xs:documentation></xs:annotation>
                    <xs:attribute name="chromium-path" type="xs:string"><xs:annotation><xs:documentation>
                        The Chromium executable; empty, or a path that names no file, looks in runtime/chromium (from
                        ./moq chromium-download), then for chromium, then chromium-browser, on the PATH.
                    </xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="page-limit" type="non-neg-int-expandable" default="4"><xs:annotation><xs:documentation>
                        The pages that print at once.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="timeout" type="non-neg-int-expandable" default="60"><xs:annotation><xs:documentation>
                        The seconds one document may take.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="preview-max-size" type="non-neg-int-expandable" default="26214400"><xs:annotation><xs:documentation>
                        The largest PDF, in bytes, that gets a preview (its first page and text, through pdf.js in the
                        same browser).</xs:documentation></xs:annotation></xs:attribute>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="screen-text-output"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="screen-output"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="screen"><xs:complexType>
                    <xs:sequence>
                        <xs:element minOccurs="0" maxOccurs="unbounded" name="subscreens-item"><xs:annotation><xs:documentation>
                            See the screen.subscreens.subscreens-item element in xml-screen-{version}.xsd for more details
                        </xs:documentation></xs:annotation><xs:complexType>
                            <xs:attribute name="name" type="name-plain" use="required"/>
                            <xs:attribute name="location" type="xs:string"/>
                            <xs:attribute name="menu-title" type="xs:string"/>
                            <xs:attribute name="menu-index" type="xs:positiveInteger"/>
                            <xs:attribute name="menu-group" type="xs:string"><xs:annotation><xs:documentation>The group the
                                item is in, in the menu of the screen it is mounted in, as the menu-group of a screen's
                                subscreens-item.</xs:documentation></xs:annotation></xs:attribute>
                            <xs:attribute name="menu-include" type="xs:string" default="true">
                                <xs:annotation><xs:documentation>true, false, or an expression evaluated per request</xs:documentation></xs:annotation></xs:attribute>
                            <xs:attribute name="no-sub-path" type="boolean" default="false"/>
                        </xs:complexType></xs:element>
                    </xs:sequence>
                    <xs:attribute name="location" type="xs:string" use="required"/>
                    <xs:attribute name="default-subscreen" type="xs:string"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" name="shell-providers"><xs:complexType>
                    <xs:annotation><xs:documentation>Providers of the hooks the framework asks for whoever acts, the system
                        with no user included, registered by a component apart from any app root (an app root's
                        shell-providers are in xml-screen-3.xsd): asked by call#Providers after the apps' providers, for
                        every caller, with authorization disabled, since this conf names them. Only sms-consent; another
                        element is logged and left out. Merged by hook and name. No Java counterpart.</xs:documentation></xs:annotation>
                    <xs:sequence>
                        <xs:element minOccurs="0" maxOccurs="unbounded" name="sms-consent"><xs:complexType>
                            <xs:annotation><xs:documentation>Whether a promotional text may go from one of our numbers to a
                                number (org.moqui.comms.ProviderInterfaces.sms#Consent): consent true or false; one false
                                refuses it, and with none saying true it is refused. Mantle answers from its consent
                                records.</xs:documentation></xs:annotation>
                            <xs:attribute name="name" type="xs:string" use="required"/>
                            <xs:attribute name="service" type="xs:string" use="required"/>
                            <xs:attribute name="sequence" type="xs:integer"/>
                        </xs:complexType></xs:element>
                    </xs:sequence>
                </xs:complexType></xs:element>
            </xs:sequence>
            <xs:attribute name="boundary-comments" default="false" type="boolean"/>
            <xs:attribute name="default-paginate-rows" type="xs:string" default="20"/>
            <xs:attribute name="default-autocomplete-rows" type="xs:string" default="10"/>
            <xs:attribute name="system-home-dashboard" type="xs:string"><xs:annotation><xs:documentation>The dashboard the System home shows as its Activity strip, by its definition id; empty for the shipped system-home.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="tx-cache" type="boolean" default="true"><xs:annotation><xs:documentation>A screen transition's transaction (and a screen's with begin-transaction) holds its writes in the transaction cache, as a service marked transaction="cache" does; false begins it as transaction="use". Read once.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="stream-threshold" type="xs:string" default="65536"><xs:annotation><xs:documentation>
                The bytes of an html or text screen render (html, html-print, text, csv, xml) kept before its response
                is sent to the client as it is written, as a servlet response commits when its buffer fills. A smaller
                page is sent whole. 0 keeps every response whole. No Java counterpart (the servlet container's buffer
                size).
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="check-interval-ms" type="xs:string"><xs:annotation><xs:documentation>
                How often a screen file is checked for changes, in milliseconds; empty is never when instance@purpose is
                production and two seconds otherwise. No Java counterpart.
            </xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="screen-text-output"><xs:complexType>
        <xs:attribute name="type" type="xs:string" use="required"><xs:annotation>
            <xs:documentation>Can be anything. Default supported values include: text, html, html-print (alias xsl-fo), xml, and csv.</xs:documentation>
        </xs:annotation></xs:attribute>
        <xs:attribute name="mime-type" type="xs:string" use="optional"/>
        <xs:attribute name="always-standalone" type="boolean" default="false"/>
        <xs:attribute name="macro-template-location" type="xs:string" use="required"/>
        <xs:attribute name="output-kind"><xs:annotation><xs:documentation>
            How a failed section is written, and whether the finished level is one JSON document: text and html write
            the escaped message where the section was, vue drops what the section wrote and escapes braces in the
            message, json writes an error node. Empty follows mime-type: application/json is json, text/html is html,
            anything else text. No Java counterpart.</xs:documentation></xs:annotation>
            <xs:simpleType><xs:restriction base="xs:token">
                <xs:enumeration value="text"/><xs:enumeration value="html"/>
                <xs:enumeration value="vue"/><xs:enumeration value="json"/>
            </xs:restriction></xs:simpleType>
        </xs:attribute>
    </xs:complexType></xs:element>
    <xs:element name="screen-output"><xs:complexType>
        <xs:attribute name="type" type="xs:string" use="required"><xs:annotation>
            <xs:documentation>Can be anything. Default supported values include: text, html, html-print (alias xsl-fo), xml, and csv.</xs:documentation>
        </xs:annotation></xs:attribute>
        <xs:attribute name="mime-type" type="xs:string" use="optional"/>
        <xs:attribute name="always-standalone" type="boolean" default="false"/>
        <xs:attribute name="macro-template-location" type="xs:string"><xs:annotation><xs:documentation>
            The JavaScript macro module that fills the document of this binary mode, such as
            framework/template/screen/ScreenXlsx.js for xlsx.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="output-kind"><xs:annotation><xs:documentation>
            How a failed section is written, and whether the finished level is one JSON document: text and html write
            the escaped message where the section was, vue drops what the section wrote and escapes braces in the
            message, json writes an error node. Empty follows mime-type: application/json is json, text/html is html,
            anything else text. No Java counterpart.</xs:documentation></xs:annotation>
            <xs:simpleType><xs:restriction base="xs:token">
                <xs:enumeration value="text"/><xs:enumeration value="html"/>
                <xs:enumeration value="vue"/><xs:enumeration value="json"/>
            </xs:restriction></xs:simpleType>
        </xs:attribute>
        <xs:attribute name="widget-render-class" type="xs:string"><xs:annotation><xs:documentation>
            The Java ScreenWidgetRender class. Read and not used: the type selects the built-in module.</xs:documentation></xs:annotation></xs:attribute>
    </xs:complexType></xs:element>

    <!-- ====================== Service Facade Conf Root ======================= -->
    <xs:element name="service-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="service-location"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="service-type"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="service-file"/>
                <!-- leaving this out for now, not easily supported by Quartz Scheduler: <xs:element minOccurs="0" ref="thread-pool"/> -->
                <!-- TABLED: not to include in 1.0: <xs:element minOccurs="0" maxOccurs="unbounded" ref="jms-service"/> -->
            </xs:sequence>
            <xs:attribute name="distributed-factory" type="xs:string"><xs:annotation><xs:documentation>
                The name of the ToolFactory to use for the distributed async service ExecutorService implementation.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="tx-cache" type="boolean" default="true"><xs:annotation><xs:documentation>A service whose definition has no transaction attribute begins its transaction with the transaction cache, as one marked transaction="cache" does (a service of XML actions or a script); false begins it as transaction="use". Read once.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="scheduled-job-check-time" type="non-neg-int-expandable"><xs:annotation><xs:documentation>
                How often to check for and run scheduled service jobs in seconds. Set to 0 (zero) to disable.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="job-queue-max" type="xs:integer"><xs:annotation><xs:documentation>
                The maximum number of jobs to queue when job-pool-max is reached.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="job-pool-core" type="xs:integer"><xs:annotation><xs:documentation>
                The core (minimum) size of the service job thread pool.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="job-pool-max" type="xs:integer"><xs:annotation><xs:documentation>
                The maximum size of the service job thread pool.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="job-pool-alive" type="xs:integer"><xs:annotation><xs:documentation>
                The amount of time, in seconds, to keep idle worker threads alive (beyond core pool size).</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="service-location">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="location" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="service-type">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="runner-class" type="xs:string" use="required"><xs:annotation><xs:documentation>
                Identifier of a linked native service runner. Service XML defines individual services;
                the runner receives their location and method attributes.
            </xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="service-file">
        <xs:complexType>
            <xs:attribute name="location" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="server-jndi">
        <xs:complexType>
            <xs:attribute name="context-provider-url" type="xs:string"/>
            <xs:attribute name="initial-context-factory" type="xs:string"/>
            <xs:attribute name="url-pkg-prefixes" type="xs:string"/>
            <xs:attribute name="security-principal" type="xs:string"><xs:annotation><xs:documentation>The username</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="security-credentials" type="xs:string"><xs:annotation><xs:documentation>The password</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <!-- ===================== Search Facade Conf Root ===================== -->

    <xs:element name="search-facade"><xs:complexType>
        <xs:annotation><xs:documentation>SearchFacade, data documents searched and aggregated through one backend.
            The postgres backend keeps one table per DataDocument in a search schema; the opensearch backend sends the
            same queries to an OpenSearch or ElasticSearch 7+ cluster, where OpenSearch Dashboards can also read them.
        </xs:documentation></xs:annotation>
        <xs:sequence>
            <xs:element name="postgres" minOccurs="0"><xs:complexType>
                <xs:annotation><xs:documentation>A Postgres for the postgres backend. With no url, search uses the
                    entity Postgres, or a dedicated embedded cluster when the entity database is not Postgres.</xs:documentation></xs:annotation>
                <xs:attribute name="url" type="xs:string"><xs:annotation><xs:documentation>
                    postgresql://host:port/database</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="user" type="xs:string"/>
                <xs:attribute name="password" type="xs:string"/>
                <xs:attribute name="schema" type="xs:string" default="search"/>
                <xs:attribute name="read-url" type="xs:string"><xs:annotation><xs:documentation>
                    postgresql://host:port/database of a physical replica of url. Searches and aggregations run there on a
                    separate read-only pool, with the same user and password; index and schema writes stay on url. A search
                    that asks for read-your-writes waits for the replica to replay the primary, or runs on url.
                </xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="read-statement-timeout" type="xs:positiveInteger" default="30"><xs:annotation><xs:documentation>
                    statement_timeout in seconds on replica sessions, so a long search does not hold back replay.
                </xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="text-config" type="xs:string" default="simple"><xs:annotation><xs:documentation>
                    The Postgres text search configuration. simple (lower case, no stemming, stop words kept) matches
                    Elastic's standard analyzer; change it only with tests on the corpus. A change rebuilds the tables.
                </xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="unaccent" type="boolean" default="false"><xs:annotation><xs:documentation>
                    Fold accents: a copy of text-config with the unaccent extension before its word dictionaries, and
                    folded titles for fuzzy and autocomplete. A change rebuilds the tables.
                </xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="partition-telemetry" type="boolean" default="false"><xs:annotation>
                    <xs:documentation>Day-partition the telemetry tables (otel_spans, otel_logs, otel_metrics by
                    granularity then day, monitor_annotations; not otel_errors) made from now on, so retention drops
                    whole days instead of deleting rows. A table made before stays unpartitioned, with a warning, until
                    org.moqui.monitor.TelemetryServices.partition#TelemetryTables (Monitor › Sources) moves its rows and
                    keeps the old table as &lt;table&gt;_unpartitioned to drop.</xs:documentation>
                </xs:annotation></xs:attribute>
                <xs:attribute name="partition-days-ahead" type="xs:nonNegativeInteger"><xs:annotation>
                    <xs:documentation>Day partitions made ahead of today, at first use and by the daily retention
                    job; a row of a day with no partition goes to the default partition. Default 3.</xs:documentation>
                </xs:annotation></xs:attribute>
            </xs:complexType></xs:element>
            <xs:element name="cluster" minOccurs="0"><xs:complexType>
                <xs:annotation><xs:documentation>The cluster for the opensearch backend.</xs:documentation></xs:annotation>
                <xs:attribute name="url" type="xs:string" use="required"/>
                <xs:attribute name="user" type="xs:string"/>
                <xs:attribute name="password" type="xs:string"/>
                <xs:attribute name="index-prefix" type="xs:string"><xs:annotation><xs:documentation>
                    Prefix added to all index names just before requests.
                    Must follow index name requirements (lower case, etc).
                    No separator character is added, recommend ending with underscore (_).
                </xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="run" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>
                    When the url is this host and nothing answers there, start the install in runtime/opensearch (unless
                    it has a pid file, a node run outside the server) and stop it on shutdown.
                </xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="start-wait" type="non-neg-int-expandable" default="120"><xs:annotation><xs:documentation>
                    How many seconds startup waits for that node to answer.</xs:documentation></xs:annotation></xs:attribute>
            </xs:complexType></xs:element>
            <xs:element name="semantic" minOccurs="0"><xs:complexType>
                <xs:annotation><xs:documentation>Semantic and hybrid retrieval on the postgres backend. Off unless enabled;
                    needs the pgvector extension (not bundled with embedded Postgres) and an embedder. Enabling it
                    rebuilds the search tables. The embed#PendingDocuments service fills the embeddings. The embedder
                    also ranks the texts of a page's semantic find (rank#Texts, docs/ui/Semantic-Find.md), on any
                    backend and without pgvector.</xs:documentation></xs:annotation>
                <xs:attribute name="enabled" type="boolean" default="false"/>
                <xs:attribute name="dimensions" type="xs:positiveInteger" default="1024"><xs:annotation><xs:documentation>
                    The embedder's vector size.</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="representation" default="halfvec"><xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="halfvec"/><xs:enumeration value="vector"/></xs:restriction></xs:simpleType></xs:attribute>
                <xs:attribute name="max-chars" type="xs:positiveInteger" default="2000"><xs:annotation><xs:documentation>
                    Characters of document text, title roles first, an embedding is made from.</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="embedder" type="xs:string"><xs:annotation><xs:documentation>
                    llm calls the /v1/embeddings of the model the llm-facade binds to the embed feature (llm:modelId
                    names a model), a local embedding model being the expected use; its vectors must have dimensions
                    (a model's api-config may ask for them). hash installs a deterministic word-hash embedder for
                    development and tests; it has no semantic quality. With none, an application installs its model on
                    the search facade.</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="query-prefix" type="xs:string"><xs:annotation><xs:documentation>
                    Text put before a query when it is embedded: the instruction the model was trained with ("task:
                    search result | query: " for EmbeddingGemma). Kept as written, with its last space.</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="document-prefix" type="xs:string"><xs:annotation><xs:documentation>
                    Text put before a document, and before a text ec.search.rankTexts ranks, when it is embedded ("title:
                    none | text: " for EmbeddingGemma). Stored documents get it when they are indexed
                    again.</xs:documentation></xs:annotation></xs:attribute>
            </xs:complexType></xs:element>
        </xs:sequence>
        <xs:attribute name="backend" type="xs:string" default="postgres"><xs:annotation><xs:documentation>
            postgres or opensearch.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="query-timeout-seconds" type="xs:positiveInteger" default="10"><xs:annotation><xs:documentation>
            How long one search statement (postgres) or request (opensearch) may run when no report's own limit is
            in force; a search past it fails.</xs:documentation></xs:annotation></xs:attribute>
        <xs:attribute name="query-max-clauses" type="xs:positiveInteger" default="64"><xs:annotation><xs:documentation>
            The most terms (words, phrases and ranges) a query string may hold; a longer one is refused before it
            runs.</xs:documentation></xs:annotation></xs:attribute>
    </xs:complexType></xs:element>

    <!-- ===================== LLM Facade Conf Root ===================== -->

    <xs:element name="llm-facade"><xs:complexType>
        <xs:annotation><xs:documentation>The model endpoints, models and feature bindings of the agents and the LLM
            services (crates/moqui-core/src/llm, plans/LLM-A2A-Assist.md section 6). LlmEndpoint, LlmModel and
            LlmFeatureBinding rows override the entries here with the same id. A component or runtime conf merges by
            endpoint id, model id, bind feature, data-entity package and entity, user-facts service, and ai-task name; limits, content-log, screen-sessions, a2a, mcp and gateway merge
            their attributes.</xs:documentation></xs:annotation>
        <xs:sequence>
            <xs:element name="endpoint" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                <xs:annotation><xs:documentation>A model server. The key is api-key (a secret, set in runtime/.env) or the
                    environment variable api-key-env names; no key sends no auth header (Ollama, LM
                    Studio).</xs:documentation></xs:annotation>
                <xs:sequence>
                    <xs:element name="header" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                        <xs:attribute name="value" type="xs:string" use="required"/>
                    </xs:complexType></xs:element>
                </xs:sequence>
                <xs:attribute name="id" type="xs:string" use="required"/>
                <xs:attribute name="protocol" default="chat-completions">
                    <xs:simpleType><xs:restriction base="xs:token">
                        <xs:enumeration value="chat-completions"/>
                        <xs:enumeration value="responses"/>
                        <xs:enumeration value="anthropic-messages"/>
                        <xs:enumeration value="fake"/>
                    </xs:restriction></xs:simpleType>
                </xs:attribute>
                <xs:attribute name="url" type="xs:string"><xs:annotation><xs:documentation>The base URL, as
                    https://api.openai.com or http://127.0.0.1:1234</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="path" type="xs:string"><xs:annotation><xs:documentation>Empty is the protocol's own:
                    /v1/chat/completions, /v1/responses, /v1/messages</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="api-key" type="xs:string"/>
                <xs:attribute name="api-key-env" type="xs:string"/>
                <xs:attribute name="auth-header" type="xs:string"><xs:annotation><xs:documentation>Empty is
                    Authorization, or x-api-key for anthropic-messages</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="auth-scheme" type="xs:string"><xs:annotation><xs:documentation>The prefix of the key,
                    Bearer by default; none for anthropic-messages</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="connect-timeout" type="xs:string" default="10"/>
            <xs:attribute name="idle-timeout" type="xs:string" default="120"><xs:annotation><xs:documentation>
                    Seconds without a byte of the response before the call fails as retryable.</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="max-concurrent" type="xs:string"/>
                <xs:attribute name="allow-private-network" type="boolean-expandable" default="false"/>
                <xs:attribute name="local" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>
                    Data sent here stays on the site; an agent limited to local endpoints uses only these.</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="disabled" type="boolean-expandable" default="false"/>
            </xs:complexType></xs:element>
            <xs:element name="model" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                <xs:annotation><xs:documentation>A model on an endpoint; name is the provider's name for it. Prices are
                    per million tokens. The behavior attributes are for small models (plan 7.9).</xs:documentation></xs:annotation>
                <xs:sequence>
                    <xs:element name="reasoning" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                        <xs:annotation><xs:documentation>A JSON object deep-merged onto the request body at this
                            reasoning level: nested objects combine, scalars and arrays replace, null removes a key.
                        </xs:documentation></xs:annotation>
                        <xs:simpleContent><xs:extension base="xs:string">
                            <xs:attribute name="level" use="required"><xs:simpleType><xs:restriction base="xs:token">
                                <xs:enumeration value="none"/><xs:enumeration value="low"/><xs:enumeration value="medium"/>
                                <xs:enumeration value="high"/><xs:enumeration value="max"/>
                            </xs:restriction></xs:simpleType></xs:attribute>
                        </xs:extension></xs:simpleContent>
                    </xs:complexType></xs:element>
                    <xs:element name="api-config" type="xs:string" minOccurs="0"><xs:annotation><xs:documentation>A JSON
                        object deep-merged onto every request body before the reasoning patch.</xs:documentation></xs:annotation></xs:element>
                </xs:sequence>
                <xs:attribute name="id" type="xs:string" use="required"/>
                <xs:attribute name="endpoint" type="xs:string" use="required"/>
                <xs:attribute name="name" type="xs:string"/>
                <xs:attribute name="tier" default="balanced"><xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="fast"/><xs:enumeration value="balanced"/><xs:enumeration value="thorough"/>
                </xs:restriction></xs:simpleType></xs:attribute>
                <xs:attribute name="context-window" type="xs:string"/>
                <xs:attribute name="max-output" type="xs:string"/>
                <xs:attribute name="price-input" type="xs:string"/>
                <xs:attribute name="price-cached-input" type="xs:string"/>
                <xs:attribute name="price-cache-write" type="xs:string"/>
                <xs:attribute name="price-output" type="xs:string"/>
                <xs:attribute name="currency" type="xs:string" default="USD"/>
                <xs:attribute name="tool-mode" default="native"><xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="native"/><xs:enumeration value="json"/>
                </xs:restriction></xs:simpleType></xs:attribute>
                <xs:attribute name="parallel-tool-calls" type="boolean-expandable"/>
                <xs:attribute name="prompt-variant" default="standard"><xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="standard"/><xs:enumeration value="small"/>
                </xs:restriction></xs:simpleType></xs:attribute>
                <xs:attribute name="result-cap-chars" type="xs:string"/>
                <xs:attribute name="screen-size" type="xs:string"><xs:annotation><xs:documentation>Columns x rows, as
                    100x30</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="list-limit" type="xs:string"/>
                <xs:attribute name="catalog-size" type="xs:string"/>
                <xs:attribute name="reasoning-replay" default="last"><xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="none"/><xs:enumeration value="last"/><xs:enumeration value="all"/>
                </xs:restriction></xs:simpleType></xs:attribute>
                <xs:attribute name="temperature" type="xs:string"/>
                <xs:attribute name="max-tool-calls" type="xs:string"/>
                <xs:attribute name="compact-high-percent" type="xs:string"/>
                <xs:attribute name="compact-low-percent" type="xs:string"/>
                <xs:attribute name="max-concurrency" type="xs:string"/>
                <xs:attribute name="intent-prefilter" default="none"><xs:annotation><xs:documentation>hint: a tiny
                    pre-call names the likely intent of a message in its context tail (likely: data); the tools never
                    change</xs:documentation></xs:annotation><xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="none"/><xs:enumeration value="hint"/>
                </xs:restriction></xs:simpleType></xs:attribute>
                <xs:attribute name="side-calls" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>
                    false: no calls besides a step's own (no intent hint, the deterministic compaction summary, no schema
                    repair call)</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="chars-per-token" type="xs:string"/>
                <xs:attribute name="disabled" type="boolean-expandable" default="false"/>
            </xs:complexType></xs:element>
            <xs:element name="bind" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                <xs:annotation><xs:documentation>The model of a feature: assist, title, summarize, classify, ai-field,
                    embed, or a component's own; fallback is used when that model is disabled or not configured.
                </xs:documentation></xs:annotation>
                <xs:attribute name="feature" type="xs:string" use="required"/>
                <xs:attribute name="model" type="xs:string"><xs:annotation><xs:documentation>Empty for the llm-facade
                    default-model.</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="fallback" type="xs:string"/>
                <xs:attribute name="reasoning" type="xs:string" default="low"/>
            </xs:complexType></xs:element>
            <xs:element name="limits" minOccurs="0"><xs:complexType>
                <xs:attribute name="max-concurrent-runs" type="xs:string" default="8"/>
                <xs:attribute name="run-queue" type="xs:string" default="64"/>
                <xs:attribute name="max-steps" type="xs:string" default="40"/>
                <xs:attribute name="max-run-seconds" type="xs:string" default="900"/>
                <xs:attribute name="user-daily-tokens" type="xs:string" default="2000000"/>
                <xs:attribute name="user-daily-cost" type="xs:string" default="20"/>
                <xs:attribute name="approval-ttl-minutes" type="xs:string" default="30"/>
                <xs:attribute name="lease-seconds" type="xs:string" default="60"/>
                <xs:attribute name="heartbeat-seconds" type="xs:string" default="15"/>
                <xs:attribute name="event-text-flush-ms" type="xs:string" default="300"/>
            </xs:complexType></xs:element>
            <xs:element name="content-log" minOccurs="0"><xs:complexType>
                <xs:annotation><xs:documentation>Keep the request and response of each call in LlmCall. Off by default;
                    with redact the values of secret-looking keys (and of redact-keys, a comma list) and token-shaped
                    strings are replaced. retention-days clears the content of older calls.</xs:documentation></xs:annotation>
                <xs:attribute name="enabled" type="boolean-expandable" default="false"/>
                <xs:attribute name="redact" type="boolean-expandable" default="true"/>
                <xs:attribute name="redact-keys" type="xs:string"/>
                <xs:attribute name="retention-days" type="xs:string" default="14"/>
            </xs:complexType></xs:element>
            <xs:element name="screen-sessions" minOccurs="0"><xs:complexType>
                <xs:attribute name="max" type="xs:string" default="64"/>
                <xs:attribute name="max-per-user" type="xs:string" default="4"/>
                <xs:attribute name="idle-minutes" type="xs:string" default="30"/>
            </xs:complexType></xs:element>
            <xs:element name="data-entity" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                <xs:annotation><xs:documentation>Entities the data tool reads directly, with artifact authorization off,
                    as Java's allowed-basic-entity: package and entity are regular expressions on the package and the
                    entity name (one left out matches any). With none listed the moqui.basic package is readable.
                    readable="false" turns a pattern off. Merged by package and entity. Warning: authorization is
                    off for these reads, so every user of an agent reads every row of a listed entity. Encrypted fields
                    are never read, and fields named like secrets (password, token, secret, credential, salt, a name
                    ending in key) only with secret-fields="true"; any other plaintext secret is readable. List only
                    entities fit for everyone, such as configuration and type data.</xs:documentation></xs:annotation>
                <xs:attribute name="package" type="xs:string"/>
                <xs:attribute name="entity" type="xs:string"/>
                <xs:attribute name="readable" type="boolean-expandable" default="true"/>
                <xs:attribute name="secret-fields" type="boolean-expandable" default="false"/>
            </xs:complexType></xs:element>
            <xs:element name="user-facts" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                <xs:annotation><xs:documentation>A service that adds facts about the user to the prompt of each new
                    conversation (the active organization, say), after the framework's name, locale and time zone: an
                    implementation of org.moqui.agent.AgentServices.get#UserFacts, called as the user with reads only.
                    One that fails is logged and left out. Merged by service.</xs:documentation></xs:annotation>
                <xs:attribute name="service" type="xs:string" use="required"/>
            </xs:complexType></xs:element>
            <xs:element name="constitution-provider" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                <xs:annotation><xs:documentation>A service that gives the Constitution of a user's internal organization
                    (docs/ai/Constitution.md): an implementation of
                    org.moqui.admin.ConstitutionServices.get#ScopedConstitution, called with reads only. The first that
                    answers for an organization decides; one that fails is logged and the global document is used with
                    a diagnostic. Merged by service.</xs:documentation></xs:annotation>
                <xs:attribute name="service" type="xs:string" use="required"/>
            </xs:complexType></xs:element>
            <xs:element name="ai-task" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                <xs:annotation><xs:documentation>A typed AI task a component adds to the registry of
                    org.moqui.agent.AiTaskServices (beside summarize, classify, extract, translate and generate): the
                    service prepares its call (an implementation of org.moqui.agent.AiTaskServices.prepare#AiTask: in
                    taskType and input, out system, prompt and the JSON schema of the output), and the feature's model
                    runs it. Merged by name.</xs:documentation></xs:annotation>
                <xs:attribute name="name" type="xs:string" use="required"/>
                <xs:attribute name="service" type="xs:string" use="required"/>
                <xs:attribute name="feature" type="xs:string"/>
                <xs:attribute name="description" type="xs:string"/>
            </xs:complexType></xs:element>
            <xs:element name="a2a" minOccurs="0"><xs:complexType>
                <xs:sequence>
                    <xs:element name="push" minOccurs="0"><xs:complexType>
                        <xs:attribute name="allow-http" type="boolean-expandable" default="false"/>
                        <xs:attribute name="allow-hosts" type="xs:string"/>
                        <xs:attribute name="timeout" type="xs:string" default="15"/>
                        <xs:attribute name="max-attempts" type="xs:string" default="6"/>
                    </xs:complexType></xs:element>
                    <xs:element name="security" minOccurs="0"><xs:complexType>
                        <xs:attribute name="api-key" type="boolean-expandable" default="true"/>
                        <xs:attribute name="bearer" type="boolean-expandable" default="true"/>
                        <xs:attribute name="oidc-issuer" type="xs:string"/>
                        <xs:attribute name="oidc-audience" type="xs:string"/>
                    </xs:complexType></xs:element>
                </xs:sequence>
                <xs:attribute name="enabled" type="boolean-expandable" default="false"/>
                <xs:attribute name="public-url" type="xs:string"/>
                <xs:attribute name="default-agent" type="xs:string" default="assist"/>
                <xs:attribute name="blocking-wait" type="xs:string" default="120"/>
                <xs:attribute name="max-part-bytes" type="xs:string" default="65536"/>
                <xs:attribute name="max-parts" type="xs:string" default="32"/>
                <xs:attribute name="trust-forwarded-headers" type="boolean-expandable" default="false"/>
                <xs:attribute name="agent-name" type="xs:string" default="Moqui"><xs:annotation><xs:documentation>The
                    name, description and version in the agent card.</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="agent-description" type="xs:string"/>
                <xs:attribute name="agent-version" type="xs:string" default="1.0.0"/>
                <xs:attribute name="client-enabled" type="boolean-expandable" default="true">
                    <xs:annotation><xs:documentation>The A2A client: delegate tools (a2a__name) to the remote agents of
                        AgentRemoteA2a rows (docs/ai/A2A.md).</xs:documentation></xs:annotation></xs:attribute>
                <xs:attribute name="client-timeout" type="xs:string" default="300">
                    <xs:annotation><xs:documentation>Seconds a delegation waits for the remote task to end or pause; then
                        it is canceled.</xs:documentation></xs:annotation></xs:attribute>
            </xs:complexType></xs:element>
            <xs:element name="mcp" minOccurs="0"><xs:complexType>
                <xs:attribute name="server-enabled" type="boolean-expandable" default="false"/>
                <xs:attribute name="protocol-version" type="xs:string" default="2026-07-28"/>
                <xs:attribute name="tools-ttl-ms" type="xs:string" default="300000"/>
                <xs:attribute name="call-timeout" type="xs:string" default="60"/>
                <xs:attribute name="client-enabled" type="boolean-expandable" default="true"/>
                <xs:attribute name="max-result-bytes" type="xs:string" default="1000000"/>
                <xs:attribute name="agent" type="xs:string" default="mcp"/>
                <xs:attribute name="public-url" type="xs:string"/>
                <xs:attribute name="trust-forwarded-headers" type="boolean-expandable" default="false"/>
                <xs:attribute name="request-state-key" type="xs:string"/>
                <xs:attribute name="approval-wait" type="xs:string" default="20"/>
                <xs:attribute name="max-direct-tools" type="xs:string" default="40"/>
            </xs:complexType></xs:element>
            <xs:element name="gateway" minOccurs="0"><xs:complexType>
                <xs:annotation><xs:documentation>The OpenAI-compatible gateway at /llm/v1 (docs/ai/Gateway.md), off by
                    default. require-client: only a key or app password an LlmApiClient with the gateway scope names may
                    call. timeout: seconds a call may take. A conf that lists aliases replaces the earlier ones.</xs:documentation></xs:annotation>
                <xs:sequence>
                    <xs:element name="alias" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                        <xs:annotation><xs:documentation>A model name the gateway answers to: the model it calls, or the
                            feature whose binding it follows. An LlmModelAlias row of the same name replaces
                            it.</xs:documentation></xs:annotation>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                        <xs:attribute name="model" type="xs:string"/>
                        <xs:attribute name="feature" type="xs:string"/>
                        <xs:attribute name="description" type="xs:string"/>
                    </xs:complexType></xs:element>
                </xs:sequence>
                <xs:attribute name="enabled" type="boolean-expandable" default="false"/>
                <xs:attribute name="require-client" type="boolean-expandable" default="true"/>
                <xs:attribute name="timeout" type="non-neg-int-expandable" default="300"/>
            </xs:complexType></xs:element>
            <xs:element name="assist" minOccurs="0"><xs:complexType>
                <xs:annotation><xs:documentation>The Assist drawer's composer extras and memory (docs/ai/Assist.md): the
                    files a message may carry (bytes, count and media types, type/* allowed), the audio a dictation
                    sends, whether the browser's speech API may stand in when no model is bound to the transcribe
                    feature (it sends the audio to the browser's vendor, so it is off unless the admin turns it on), the
                    longest text of an inline text action, and whether a user who never chose lets the agent make
                    memories.</xs:documentation></xs:annotation>
                <xs:attribute name="max-attachment-bytes" type="non-neg-int-expandable" default="10485760"/>
                <xs:attribute name="max-attachments" type="non-neg-int-expandable" default="5"/>
                <xs:attribute name="attachment-types" type="xs:string"/>
                <xs:attribute name="max-audio-bytes" type="non-neg-int-expandable" default="10485760"/>
                <xs:attribute name="browser-dictation" type="boolean-expandable" default="false"/>
                <xs:attribute name="max-text-action-chars" type="non-neg-int-expandable" default="8000"/>
                <xs:attribute name="memory-default" type="boolean-expandable" default="true"/>
            </xs:complexType></xs:element>
        </xs:sequence>
        <xs:attribute name="enabled" type="boolean-expandable" default="true"/>
        <xs:attribute name="default-model" type="xs:string" default="default"><xs:annotation><xs:documentation>The model
            of a bind that names none.</xs:documentation></xs:annotation></xs:attribute>
    </xs:complexType></xs:element>

    <!-- ===================== Entity Facade Conf Root ===================== -->
    <xs:element name="entity-facade">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="decrypt-alt" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
                    <xs:annotation><xs:documentation>Alternate settings for decryption only; useful for migrating keys, supporting data imported from other systems, etc</xs:documentation></xs:annotation>
                    <xs:attribute name="crypt-pass" type="xs:string"><xs:annotation><xs:documentation>
                        Left out, the entity-facade's crypt-pass, or with old="true" its crypt-pass-old.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="old" default="false" type="boolean"><xs:annotation><xs:documentation>
                        With no crypt-pass of its own, take the entity-facade's crypt-pass-old: for values encrypted
                        under the pass before the current one.</xs:documentation></xs:annotation></xs:attribute>
                    <xs:attribute name="crypt-salt" type="xs:string"/>
                    <xs:attribute name="crypt-iter" type="xs:string"/>
                    <xs:attribute name="crypt-algo" type="xs:string"/>
                </xs:complexType></xs:element>
                <xs:element minOccurs="0" ref="server-jndi">
                    <xs:annotation><xs:documentation>If not present the default JNDI server will be used.</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="datasource"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="load-entity"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="load-data"/>
            </xs:sequence>
            <xs:attribute name="entity-eca-enabled" default="true" type="boolean-expandable"/>
            <xs:attribute name="distributed-cache-invalidate" default="false" type="boolean">
                <xs:annotation><xs:documentation>Enable distributed cache invalidate by distributed Topic</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="dci-topic-factory" type="xs:string">
                <xs:annotation><xs:documentation>Topic factory for distributed cache invalidate</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sequenced-id-prefix" type="xs:string"/>
            <xs:attribute name="disable-fk-create" type="xs:string" default="false"><xs:annotation><xs:documentation>true
                creates no foreign keys when tables are made or checked.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sql-name-style" type="xs:string">
                <xs:annotation><xs:documentation>Rust only: java (default), or legacy to retain pre-compatibility quoted Rust table and column names.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="default-group-name" type="name-plain"/>
            <xs:attribute name="database-time-zone" type="xs:string"/>
            <xs:attribute name="database-locale" type="xs:string"><xs:annotation><xs:documentation>
                Empty is the instance's default locale.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="crypt-pass" type="xs:string"><xs:annotation><xs:documentation>
                The key of encrypted fields; empty turns field encryption off. A value ending in CHANGEME is generated at
                the first start and kept in runtime/.env as moqui_conf__entity_facade__crypt_pass, which must be kept
                with the database's backups.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="crypt-pass-old" type="xs:string"><xs:annotation><xs:documentation>
                The pass before crypt-pass, for the decrypt-alt entries marked old: values encrypted under it still
                read. A secret, never generated.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="crypt-salt" type="xs:string"/>
            <xs:attribute name="crypt-iter" type="xs:string"/>
            <xs:attribute name="crypt-algo" type="xs:string"/>
            <xs:attribute name="crypt-read-plain" default="false" type="boolean-expandable"><xs:annotation><xs:documentation>
                True to read the stored text of an encrypted field that is not ciphertext as its value, each such read
                logged: only for a migration of values stored before their field was encrypted (run
                rewrite#EntityEncryptedFields, then turn it off). False, such text reads as _DECRYPT_FAILED_, so a
                writer of the database cannot set a secret field to a value of their choice. No Java counterpart.
            </xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="query-stats" default="false" type="boolean-expandable"/>
            <xs:attribute name="rest-max-page-size" type="non-neg-int-expandable" default="1000"><xs:annotation><xs:documentation>
                The most rows a page returns: of the entity and service REST APIs, and of a find whose page a request names
                (a screen's pageSize, search-form-inputs). No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="screen-max-rows" type="non-neg-int-expandable" default="100000"><xs:annotation><xs:documentation>
                The most rows of a find made from a request's search parameters with pageNoLimit=true (a screen's CSV,
                XLSX, print or text export): pageNoLimit asks for no page, and gets this many rows at most (SEC-DAT-09).
                No Java counterpart.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <!-- ===================== Server Elements (no Java counterpart) ===================== -->

    <xs:element name="email-client">
        <xs:annotation><xs:documentation>The mail client (org.moqui.mail.EmailClientServices).</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence><xs:element minOccurs="0" maxOccurs="unbounded" ref="oauth-provider"/></xs:sequence>
            <xs:attribute name="contact-service" type="xs:string"><xs:annotation><xs:documentation>The service that
                finds a user's contacts for the mail client's address completion, over the qapps theme's value.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="allowed-hosts" type="xs:string"><xs:annotation><xs:documentation>Comma separated hostnames and IPs poll#EmailServer and send#Email may connect
                to; empty allows any host. smtp.example.com matches example.com; notexample.com does not.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="idle-enabled" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>IMAP IDLE on the Inbox of each active account, so new mail shows at once; false relies on the sync job only.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="idle-max" type="non-neg-int-expandable" default="8"><xs:annotation><xs:documentation>The most IDLE connections (a thread each) in a server.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sync-interval" type="non-neg-int-expandable" default="5"><xs:annotation><xs:documentation>Minutes between syncs of an account with no syncIntervalMinutes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sync-batch" type="non-neg-int-expandable" default="500"><xs:annotation><xs:documentation>The most new messages a folder brings in one sync.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="flag-scan" type="non-neg-int-expandable" default="15"><xs:annotation><xs:documentation>Minutes between reading every message's flags, on a server without CONDSTORE.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sync-push-now" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>Make a local change on the server right after it commits; false waits for the next sync.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-message-size" type="non-neg-int-expandable" default="67108864"><xs:annotation><xs:documentation>The largest message, in bytes, a sync or poll reads from an IMAP or POP3 server; a larger one, by the size the server gives, is skipped, and one answer of a server is at most this (or 8 MiB, when more) and 1 MiB more.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="answer-timeout" type="non-neg-int-expandable" default="660"><xs:annotation><xs:documentation>The seconds one answer of an IMAP or POP3 server may take from its command; past it the connection is closed.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="mailbox-quota" type="non-neg-int-expandable" default="10737418240"><xs:annotation><xs:documentation>The bytes of mail (the sum of its messages' messageSize) a hosted or shared account keeps when its EmailAccount.quotaBytes is empty; once it has that much, the SMTP listener answers its recipients 452 4.2.2.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="autoconfig-urls" type="xs:string"><xs:annotation><xs:documentation>discover#EmailServer's Thunderbird autoconfig URLs, comma separated, with
                {domain} and {email}; empty for autoconfig.{domain}, the domain's .well-known URL and the Thunderbird ISPDB.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="dns-server" type="xs:string"><xs:annotation><xs:documentation>The DNS server (host:port) for discover#EmailServer's SRV lookups; empty for the first in /etc/resolv.conf.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="tls-ca-file" type="xs:string"><xs:annotation><xs:documentation>A PEM file of more certificate authorities to trust, for a mail server with its own.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="oauth-redirect-uri" type="xs:string"><xs:annotation><xs:documentation>The callback the OAuth provider sends the browser back to, exactly as
                registered there; empty for the webroot webapp's URL and /emailOAuth/callback.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="capture-sends" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Keep each send in memory instead of connecting, for specs (the MailCapture tool); ignored outside a moqui test run.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="oauth-provider">
        <xs:annotation><xs:documentation>This deployment's OAuth client at a provider mail accounts sign in with
            (docs/interfaces/Mail-OAuth.md), by the id an EmailOAuthProvider's confProviderId names; a provider without
            both client-id and client-secret is not offered.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="client-id" type="xs:string"/>
            <xs:attribute name="client-secret" type="xs:string"><xs:annotation><xs:documentation>A secret: never written to a log or answered by a service.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="tenant" type="xs:string"><xs:annotation><xs:documentation>Microsoft: common (work, school and personal accounts), organizations, consumers or a tenant id; empty for the provider row's tenant, else common.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="ssh-server">
        <xs:annotation><xs:documentation>The built-in SSH server: the terminal client, SFTP, git and the admin shell.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="enabled" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>False keeps the server off whatever the port, and git clone and sync addresses show no SSH.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="port" type="xs:string"><xs:annotation><xs:documentation>The port to bind; empty leaves the server off, 0 binds an ephemeral port.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="host" type="xs:string" default="127.0.0.1"><xs:annotation><xs:documentation>The address to bind.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="host-key" type="xs:string"><xs:annotation><xs:documentation>The base64 of a 32-byte Ed25519 seed, or an OpenSSH private key.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="public-host" type="xs:string"><xs:annotation><xs:documentation>The SSH host git clone URLs show; the webapp host when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="public-port" type="xs:string"><xs:annotation><xs:documentation>The SSH port git clone URLs show; port when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sftp-root" type="xs:string" default="runtime://sftp"><xs:annotation><xs:documentation>The resource location SFTP serves (runtime, file, component or dbresource).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sftp-max-file" type="non-neg-int-expandable" default="268435456"><xs:annotation><xs:documentation>The largest file SFTP takes, in bytes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-sessions" type="non-neg-int-expandable" default="8"><xs:annotation><xs:documentation>The most connections at once.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-sessions-per-user" type="non-neg-int-expandable" default="4"><xs:annotation><xs:documentation>The most connections at once of one user logged in by key or password; 0 for no share. A cluster peer and a connection in its login dialog are not counted by it.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-sessions-per-source" type="non-neg-int-expandable" default="4"><xs:annotation><xs:documentation>The most connections at once from one address (an IPv6 /64); 0 for no share. A cluster peer is not counted by it.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-dialog-sessions" type="non-neg-int-expandable" default="4"><xs:annotation><xs:documentation>Of max-sessions, the most connections at once let in with no user for the login dialog, so they never fill the sessions a key or password login needs; 0 for no share.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-dialog-sessions-per-source" type="non-neg-int-expandable" default="2"><xs:annotation><xs:documentation>Of max-dialog-sessions, the most from one address (an IPv6 /64); 0 for no share.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="git-password-auth" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Git over SSH on a connection that logged in by password; by key only when false.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="git-any-account" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Git over SSH for any account that logs in by key, without the SSH_GIT permission
                (a public site's accounts); each repository's own check still decides. A password login still needs SSH_GIT and git-password-auth. SFTP and the shell are not opened by it.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="login-dialog" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>A client with no key is let in with no user and gets the terminal client's
                login dialog; when false, such a client logs in by password at the SSH level or not at all.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="terminal">
        <xs:annotation><xs:documentation>The terminal's sessions, over SSH and in the browser together (plans/Terminal-Fancy.md §5.8):
            the apps for every user, and on a dev instance the moqui> command line and programs on the server's operating
            system (host sessions) for a user with the permission.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="host-profile"/>
            </xs:sequence>
            <xs:attribute name="max-sessions" type="non-neg-int-expandable" default="16"><xs:annotation><xs:documentation>The most apps and command sessions at once.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-sessions-per-user" type="non-neg-int-expandable" default="4"><xs:annotation><xs:documentation>The most apps and command sessions of one user; a session in its login dialog counts toward max-sessions only.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="detach-seconds" type="non-neg-int-expandable" default="120"><xs:annotation><xs:documentation>A kept apps session with no window this long ends.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="replay-kb" type="non-neg-int-expandable" default="2048"><xs:annotation><xs:documentation>The output a command or host session keeps for a window that comes back.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="command-line" type="xs:string" default="dev"><xs:annotation><xs:documentation>The moqui> command line in the browser: dev (on a dev instance), true (on for any purpose) or false (off); any other value, empty included, is off and logged as an error.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="host-sessions" type="xs:string" default="dev"><xs:annotation><xs:documentation>Programs on the server's operating system: dev (on a dev instance), true (on for any purpose) or false (off); any other value, empty included, is off and logged as an error.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="remote" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Command and host sessions from anywhere but the server's own machine, over a secure request with a recent sign-in.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="remote-reauth-minutes" type="non-neg-int-expandable" default="60"><xs:annotation><xs:documentation>How recent the sign-in of a remote command or host session must be.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="host-max-sessions" type="non-neg-int-expandable" default="32"><xs:annotation><xs:documentation>The most host sessions at once.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="host-max-sessions-per-user" type="non-neg-int-expandable" default="16"><xs:annotation><xs:documentation>The most host sessions of one user.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="host-detach-hours" type="non-neg-int-expandable" default="72"><xs:annotation><xs:documentation>A command or host session with no window this long ends.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="host-directory" type="xs:string"><xs:annotation><xs:documentation>Where a host session starts when its profile names no directory; else the directory above the runtime.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="host-profile">
        <xs:annotation><xs:documentation>A program a host session runs: never a shell string, an argv. One whose command is not on the
            PATH is not offered. With no command, the server user's shell, as a login shell.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="env">
                    <xs:complexType>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                        <xs:attribute name="value" type="xs:string"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="title" type="xs:string"/>
            <xs:attribute name="command" type="xs:string"/>
            <xs:attribute name="args" type="xs:string"><xs:annotation><xs:documentation>The arguments, separated by spaces; a JSON array of strings for one with spaces in it.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="resume-args" type="xs:string"><xs:annotation><xs:documentation>The arguments in place of args when a session the server ended is started again (an agent's --resume).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="directory" type="xs:string"/>
            <xs:attribute name="login" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Start the command as a login shell.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="integration" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Start bash or zsh with the shell integration script (prompt marks, the directory).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="agent" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>A coding agent: quiet output reads as done.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="git-server">
        <xs:annotation><xs:documentation>The git server, over smart HTTP and SSH, and the storage of db kind
            repositories (docs/interfaces/Git-Hosting.md).</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="public-url" type="xs:string"><xs:annotation><xs:documentation>The base URL clone URLs show; from the webapp host and port when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="shared-storage" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>runtime/git (and every localPath) is on storage every cluster member mounts. A local or remote repository is one directory, so on a cluster member without this a new one is refused (GitNeedsSharedStorage) and the ones there are named in a warning at start; with it the writers of one take its lease (moqui.resource.GitLease) as well as this process's lock, and the pass of mirror fetches runs on one member at a time. db repositories need nothing (docs/interfaces/Git-Hosting.md, Shared storage in a cluster).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="shared-lock-wait-seconds" type="non-neg-int-expandable" default="120"><xs:annotation><xs:documentation>With shared-storage, how long a push or write waits for another member's write to the same repository before it is refused (GitLeaseBusy).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="lfs-token-key" type="xs:string"><xs:annotation><xs:documentation>The key Git LFS action tokens are signed with.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="lfs-token-key-previous" type="xs:string"><xs:annotation><xs:documentation>A key that still reads while lfs-token-key is changed.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-concurrent" type="non-neg-int-expandable" default="4"><xs:annotation><xs:documentation>Clones and pushes that run at once, on threads of their own.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="anonymous-max-concurrent" type="xs:string"><xs:annotation><xs:documentation>Of those, the clones, fetches and LFS downloads that run at once for requests with no credentials (repositories anyone may view); one more is answered 503 with Retry-After. Half of max-concurrent, at least 1, when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-queued" type="non-neg-int-expandable" default="16"><xs:annotation><xs:documentation>Clones and pushes that wait for one of those threads.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-request" type="non-neg-int-expandable" default="67108864"><xs:annotation><xs:documentation>Bytes of an upload-pack request, as sent and, for a gzip body, as inflated; over SSH, of the whole conversation's input. More is refused.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="fetch-max-lines" type="non-neg-int-expandable" default="1000000"><xs:annotation><xs:documentation>The most want, have, shallow, deepen and argument lines of one upload-pack request (a v0 conversation, a v2 command), each capability on a want line counted as a line; more is refused (GitFetchRequestTooLarge).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="fetch-max-request-bytes" type="non-neg-int-expandable" default="67108864"><xs:annotation><xs:documentation>The most bytes of those lines together.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-push-size" type="non-neg-int-expandable" default="2147483648"><xs:annotation><xs:documentation>Bytes of a push, as sent and, for a gzip body, as inflated; over SSH too.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-object-size" type="non-neg-int-expandable" default="536870912"><xs:annotation><xs:documentation>Bytes of one pushed object.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="idle-timeout" type="non-neg-int-expandable" default="120"><xs:annotation><xs:documentation>Seconds of silence in a request body that end it.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="pack-threads" type="xs:string"><xs:annotation><xs:documentation>Threads that compress and index one pack (each push and clone has its own); 2 when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-delta-depth" type="non-neg-int-expandable" default="4095"><xs:annotation><xs:documentation>The most deltas from a pushed or fetched object to a whole one (4095 is the deepest git writes); a deeper chain is refused (GitDeltaTooDeep).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="allow-http" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Take credentials over plain HTTP.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="lfs-max-object-size" type="non-neg-int-expandable" default="5368709120"><xs:annotation><xs:documentation>The largest Git LFS object, in bytes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="lfs-max-locks" type="non-neg-int-expandable" default="1000"><xs:annotation><xs:documentation>The most Git LFS locks a repository has; one more is refused (SEC-GIT-85). 0: no cap.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="lfs-locks-max-page" type="non-neg-int-expandable" default="100"><xs:annotation><xs:documentation>The most Git LFS locks one locks or locks/verify request answers, whatever limit it asks for; 0 (or not a number) is the default, 100, since a page with no ceiling is what the limit is for.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="outbound-check-service" type="xs:string"><xs:annotation><xs:documentation>A service asked before a repository's webhook deliveries are queued and before its push mirror pushes (org.moqui.git.GitServices.check#GitOutbound): allowed false holds them, so an application that hides or suspends a repository stops what it would tell or copy elsewhere. None when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="rest-write-check-service" type="xs:string"><xs:annotation><xs:documentation>A service asked before each write on a repository through the framework's REST (/rest/s1/moqui/git; org.moqui.git.GitServices.check#GitRestWrite): allowed false refuses the write with its message and names the application's own REST (restUrl), so a repository an application keeps is changed only by its rules. None when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="offer-service" type="xs:string"><xs:annotation><xs:documentation>A service that adds to what the server offers its clients (/rest/s1/moqui/hosting/offer; org.moqui.git.GitServices.add#GitHostingOffer): an application's REST, its task source, its forks, its agreement check. None when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="review-thread-service" type="xs:string"><xs:annotation><xs:documentation>A service that keeps the review threads (line comments) of merge requests for the framework's REST (/rest/s1/moqui/git/[repositoryId]/mergeRequests/[n]/threads; org.moqui.git.GitServices.handle#GitReviewThread, operations find, comment and resolve): an application's, such as Mantle's. With none the REST answers no threads and refuses a comment.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="agreement-check-service" type="xs:string"><xs:annotation><xs:documentation>A service that answers whether an author has signed a repository's contributor agreement (org.moqui.git.GitServices.check#GitAuthorSigned), for get#GitAuthorSigned and /rest/s1/moqui/hosting/agreement. With none the answer is that it is not known here.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="lfs-upload-check-service" type="xs:string"><xs:annotation><xs:documentation>A service asked before Git LFS objects new to a repository are accepted (org.moqui.git.GitServices.check#GitLfsUpload), for an application's quota; its errors refuse the upload. None when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="blame-max-bytes" type="non-neg-int-expandable" default="1048576"><xs:annotation><xs:documentation>The largest file get#GitBlame blames, in bytes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="blame-max-lines" type="non-neg-int-expandable" default="50000"><xs:annotation><xs:documentation>The most lines of a file get#GitBlame blames.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="blob-max-bytes" type="non-neg-int-expandable" default="16777216"><xs:annotation><xs:documentation>The largest file get#GitBlob reads (an LFS file's content counted); a larger one is answered with its size and tooLarge only, and is read as a git:// location, which streams it.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="commit-max-diff-files" type="non-neg-int-expandable" default="300"><xs:annotation><xs:documentation>The most files of a commit get#GitCommitDiff and get#GitCommit diff; the rest are listed with tooLarge and no diff, as a comparison's.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="log-max-commits" type="non-neg-int-expandable" default="10000"><xs:annotation><xs:documentation>The most commits one get#GitLog page with a path compares at that path; the page ends there, with hasMore when it found any.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="blame-max-commits" type="non-neg-int-expandable" default="10000"><xs:annotation><xs:documentation>The most commits get#GitBlame reads; a history that needs more is refused.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="blame-max-diffs" type="non-neg-int-expandable" default="2000"><xs:annotation><xs:documentation>The most comparisons of two versions of the file one get#GitBlame makes (each parent of a merge is one); more is refused.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="blame-max-seconds" type="non-neg-int-expandable" default="10"><xs:annotation><xs:documentation>The longest one get#GitBlame runs, in seconds; each comparison is cut off at it and the blame refused.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="archive-max-bytes" type="non-neg-int-expandable" default="268435456"><xs:annotation><xs:documentation>The most bytes of content, before compression, in a get#GitArchive archive.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="archive-max-files" type="non-neg-int-expandable" default="50000"><xs:annotation><xs:documentation>The most entries of a get#GitArchive archive: files, links and directories, each tree counted as it is read.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="archive-max-disk-bytes" type="non-neg-int-expandable" default="2147483648"><xs:annotation><xs:documentation>The most bytes of archive files kept under runtime/tmp/git-archive; a new archive that would pass it is refused until older ones are removed (six hours after their last use).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="archive-max-concurrent" type="non-neg-int-expandable" default="2"><xs:annotation><xs:documentation>The most get#GitArchive calls measuring and writing at once on a node; one more is refused.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="eca-max-commits" type="non-neg-int-expandable" default="10000"><xs:annotation><xs:documentation>The most commits one change raises gitECA commit events for.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="review-push" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>Take pushes to refs/for/[branch], which open or update a merge request, from a user who may view a repository and not push to it too; such a user pushes nothing else. false: a user with no push right is refused before the push, as before.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="review-start-hidden" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>A merge request opened by a push for review or a proposal of commit#GitFiles starts hidden (GitMergeRequest.hiddenDate): its commits are not fetched or read by id until the application shows it (set#MergeRequestHidden), for a site that holds what a new account sends.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="review-ref-retention-days" type="non-neg-int-expandable" default="30"><xs:annotation><xs:documentation>gc#GitRepositories deletes the head ref (refs/merge-requests/[n]/head) of a merge request closed without merging this many days ago, so what was pushed for review and refused does not stay; 0 keeps them.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="review-max-push-bytes" type="non-neg-int-expandable" default="52428800"><xs:annotation><xs:documentation>The largest pack one push for review brings (counted as its objects inflate when that is more), and the most bytes of files one proposal of commit#GitFiles brings, from a user with no push right; 0 for no cap.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="review-max-object-size" type="non-neg-int-expandable" default="33554432"><xs:annotation><xs:documentation>Bytes of one object pushed for review by a user with no push right (max-object-size when that is lower).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="review-max-delta-depth" type="non-neg-int-expandable" default="250"><xs:annotation><xs:documentation>The most deltas from an object pushed for review by a user with no push right to a whole one (max-delta-depth when that is lower).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="review-max-account-bytes" type="non-neg-int-expandable" default="209715200"><xs:annotation><xs:documentation>The most bytes one account with no push right brings for review in a day, over every repository (GitUpdate.packBytes of its pushes for review); 0 for no cap.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="review-max-commands" type="non-neg-int-expandable" default="8"><xs:annotation><xs:documentation>The most commands (refs), the most shallow lines and the most push options (each) of one push from a user with no push right, who pushes for review only; more is refused before the pack is read (GitPushRequestTooLarge).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="review-max-request-bytes" type="non-neg-int-expandable" default="65536"><xs:annotation><xs:documentation>The most bytes of the commands, shallow lines and push options of one push from a user with no push right.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="review-max-built-on" type="non-neg-int-expandable" default="8"><xs:annotation><xs:documentation>The most commits of the repository one push for review from a user with no push right builds on (the parents of its commits that it does not bring); more is refused (GitReviewPushTooWide).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="review-max-trees" type="non-neg-int-expandable" default="20000"><xs:annotation><xs:documentation>The most trees the server reads to check that what a push for review from a user with no push right names without bringing it (unchanged files and directories, delta bases) are files of the branch it is for; a user who may push gets 1,000,000. In a repository with more directories than this such a push may be refused as missing objects.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="review-max-refused" type="non-neg-int-expandable" default="30"><xs:annotation><xs:documentation>After this many pushes for review and proposals of one account with no push right were refused in an hour, on this node, the account's next ones that hour are refused before anything is read (GitReviewRefusals); 0 for no cap.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="push-max-commands" type="non-neg-int-expandable" default="100000"><xs:annotation><xs:documentation>The most commands (refs), the most shallow lines and the most push options (each) of one push from a user who may push.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="push-max-request-bytes" type="non-neg-int-expandable" default="16777216"><xs:annotation><xs:documentation>The most bytes of the commands, shallow lines and push options of one push from a user who may push; the pack is not counted (max-push-size).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="merge-request-url" type="xs:string"><xs:annotation><xs:documentation>The page of a merge request, told to the client of a push for review: {repositoryPath}, {repositoryId}, {mergeRequestNum} and {mergeRequestId} are filled in. A full URL (http:// or https://) is taken as given, so it may name an application's pages on another host or under a mount; anything else is a path that follows public-url. None when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="reach-max-commits" type="non-neg-int-expandable" default="1000000"><xs:annotation><xs:documentation>The most commits of a repository's history kept in memory to answer which commits its refs reach, for reads and fetches by commit id; in a larger history an older commit is not read by its id.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="contains-max-commits" type="non-neg-int-expandable" default="200000"><xs:annotation><xs:documentation>The most commits one get#GitCommitRefs call reads; past it the answer is truncated.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="reserved-status-contexts" type="xs:string" default=""><xs:annotation><xs:documentation>Prefixes of commit status contexts that create#GitCommitStatus takes only with authorization disabled (the system: an agreement check, the CI engine), separated by commas. Empty (the default): none, as an outside CI posts its checks (ci/...) with a user's token; a hosting application that writes checks of its own sets it (agreement/,ci/).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="committer-name" type="xs:string"><xs:annotation><xs:documentation>The committer of a commit#GitFiles commit whose author the application gives; Moqui when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="committer-email" type="xs:string"><xs:annotation><xs:documentation>The address of that committer; moqui@localhost when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-webhooks" type="non-neg-int-expandable" default="20"><xs:annotation><xs:documentation>The most webhooks a repository has; store#GitWebhook refuses one more. 0: no cap.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-mirrors" type="non-neg-int-expandable" default="10"><xs:annotation><xs:documentation>The most push mirrors a repository has; store#GitRepositoryMirror refuses one more. 0: no cap.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="queue-pass-seconds" type="non-neg-int-expandable" default="300"><xs:annotation><xs:documentation>How long one pass of retry#GitWebhookDeliveries or run#GitRepositoryMirrors starts sends; the rest wait for the next run of its job. 0: no bound.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="queue-pass-gap-seconds" type="non-neg-int-expandable" default="300"><xs:annotation><xs:documentation>How long after a pass of retry#GitWebhookDeliveries or run#GitRepositoryMirrors (all due mirrors; a push's own mirror is not held) starts the next pass on the same node may; the job runs each minute and skips a run before then. 0: no gap.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="merge-requests-max-page" type="non-neg-int-expandable" default="100"><xs:annotation><xs:documentation>The most merge requests one page of the REST find#MergeRequests gives.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="merge-requests-max-repositories" type="non-neg-int-expandable" default="500"><xs:annotation><xs:documentation>A REST find#MergeRequests that names no repository looks in the first this many repositories the caller may view, by id.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="webhook-private-network" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Deliver repository webhooks to loopback, private and link-local addresses too (a CI server on the same network). Off by default: a webhook URL is a user's.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="db-delta-depth" type="non-neg-int-expandable" default="50"><xs:annotation><xs:documentation>Deltas at most from an object to a whole one.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="db-delta-max-size" type="non-neg-int-expandable" default="16777216"><xs:annotation><xs:documentation>Objects up to this many bytes may be stored as deltas.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="db-large-object" type="non-neg-int-expandable" default="8388608"><xs:annotation><xs:documentation>An object over this many bytes is a content blob, read and sent a window at a time.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="db-write-format" type="xs:string" default="v2"><xs:annotation><xs:documentation>raw writes new rows uncompressed, as versions before this format read them.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="db-cache-bytes" type="non-neg-int-expandable" default="67108864"><xs:annotation><xs:documentation>Bytes of decoded objects kept in memory for all repositories.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="gc-prune-days" type="non-neg-int-expandable" default="14"><xs:annotation><xs:documentation>gc#GitRepositories deletes unreachable objects not written or referenced in this many days (at least 1).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="gc-reflog-days" type="non-neg-int-expandable" default="30"><xs:annotation><xs:documentation>gc#GitRepositories keeps the commits of this many days of changes, so a force push can be undone.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="gc-max-objects" type="non-neg-int-expandable" default="20000000"><xs:annotation><xs:documentation>gc#GitRepositories passes over a repository of more objects than this.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="git-ci">
        <xs:annotation><xs:documentation>Pipelines: the CI engine over the hosted git repositories
            (docs/interfaces/Pipelines.md).</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="enabled" type="xs:string"><xs:annotation><xs:documentation>true or false; empty: on while there is an enabled GitRunnerPool.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="server-url" type="xs:string"><xs:annotation><xs:documentation>The URL runners reach this server by; the git public URL when empty. A pool may have its own.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="server-id" type="xs:string"><xs:annotation><xs:documentation>The label that tells this server's containers from another's on a shared host; the public URL's host when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="run-check-service" type="xs:string"><xs:annotation><xs:documentation>Asked before a run is queued, and again before a job of an ended run runs again: allow, wait or refuse, trust, owner and pool (org.moqui.git.GitCiServices.check#PipelineRun). A server whose accounts sign themselves up sets it: the application decides whether a public account's own repository runs without approval.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="run-url-service" type="xs:string"><xs:annotation><xs:documentation>Gives the page of a run for its statuses' target (org.moqui.git.GitCiServices.get#PipelineRunUrl).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="run-url" type="xs:string"><xs:annotation><xs:documentation>The page of a run when no service is named: a template with {repositoryId}, {repositoryPath}, {pipelineRunId}, {runNum} and {jobRunId}.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="builtin-enabled" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>A repository with a component.xml and no ci.xml gets the built-in pipeline.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="builtin-image" type="xs:string" default="moqui-build"><xs:annotation><xs:documentation>The image of the built-in pipeline's job; {frameworkVersion} is the version the component names (latest when it names none).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="builtin-pool" type="xs:string"><xs:annotation><xs:documentation>The pool name of the built-in pipeline's job; default when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="builtin-workers" type="non-neg-int-expandable" default="2"><xs:annotation><xs:documentation>The --workers of the built-in pipeline's moqui test.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-file-bytes" type="non-neg-int-expandable" default="262144"><xs:annotation><xs:documentation>Bytes of a ci.xml.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-pipelines" type="non-neg-int-expandable" default="20"><xs:annotation><xs:documentation>Pipelines of a ci.xml.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-jobs" type="non-neg-int-expandable" default="50"><xs:annotation><xs:documentation>Jobs of a pipeline, after its matrices are expanded.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-matrix" type="non-neg-int-expandable" default="20"><xs:annotation><xs:documentation>Combinations of one job's matrix.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-steps" type="non-neg-int-expandable" default="50"><xs:annotation><xs:documentation>Steps of a job.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-services" type="non-neg-int-expandable" default="4"><xs:annotation><xs:documentation>Service containers of a job.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="schedule-min-minutes" type="non-neg-int-expandable" default="15"><xs:annotation><xs:documentation>A scheduled pipeline runs at most once in this many minutes, whatever its cron says.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="pool-token-days" type="non-neg-int-expandable" default="7"><xs:annotation><xs:documentation>How long a registration token of a pool of registered runners registers runners, unless create#RunnerPoolToken says otherwise.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="runner-token-days" type="non-neg-int-expandable" default="90"><xs:annotation><xs:documentation>How long a registered runner's token is good for; the runner rotates it after half that (POST /ci/runner/rotate). 0 is no expiry.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-timeout-minutes" type="non-neg-int-expandable" default="360"><xs:annotation><xs:documentation>The longest time limit a job may ask for.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="default-timeout-minutes" type="non-neg-int-expandable" default="60"><xs:annotation><xs:documentation>The time limit of a job that asks for none.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-fetch-depth" type="non-neg-int-expandable" default="50"><xs:annotation><xs:documentation>The deepest history a job's checkout may fetch with its job token.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-log-bytes" type="non-neg-int-expandable" default="16777216"><xs:annotation><xs:documentation>Bytes of a job's log; the rest is not kept.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-log-batch-bytes" type="non-neg-int-expandable" default="1048576"><xs:annotation><xs:documentation>Bytes of one JSON request of a runner.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-artifact-bytes" type="non-neg-int-expandable" default="1073741824"><xs:annotation><xs:documentation>Bytes of one artifact.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-report-bytes" type="non-neg-int-expandable" default="16777216"><xs:annotation><xs:documentation>Bytes of one report.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-cache-bytes" type="non-neg-int-expandable" default="2147483648"><xs:annotation><xs:documentation>Bytes of one cache archive.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-unpack-bytes" type="non-neg-int-expandable" default="17179869184"><xs:annotation><xs:documentation>Bytes a cache archive unpacks to on a runner (16 GiB; at most a million entries): sent with each job, and a cache past it is not restored (SEC-GIT-95).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-artifacts" type="non-neg-int-expandable" default="100"><xs:annotation><xs:documentation>Uploads of one job: artifacts, reports and caches.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-repository-upload-bytes" type="non-neg-int-expandable" default="10737418240"><xs:annotation><xs:documentation>Bytes of artifacts, reports and caches a repository keeps (10 GiB); an upload past it is refused (GitCiStorageQuota), and one that would pass it cut. 0: no cap.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-untrusted-run-upload-bytes" type="non-neg-int-expandable" default="1073741824"><xs:annotation><xs:documentation>Bytes of artifacts and reports one untrusted run (a fork's, a review push's, an approved run of an account without update) keeps over all its jobs (1 GiB), refused and cut as the repository's cap. 0: no cap.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-owner-upload-bytes" type="non-neg-int-expandable" default="0"><xs:annotation><xs:documentation>The same for the runs' owner (GitPipelineRun.ownerId) over all its repositories. 0: no cap.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="artifact-retention-days" type="non-neg-int-expandable" default="30"><xs:annotation><xs:documentation>How long an artifact is kept when its element names no retention-days.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-artifact-retention-days" type="non-neg-int-expandable" default="365"><xs:annotation><xs:documentation>The longest retention an artifact may ask for.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="log-retention-days" type="non-neg-int-expandable" default="90"><xs:annotation><xs:documentation>How long logs and reports are kept.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="cache-retention-days" type="non-neg-int-expandable" default="30"><xs:annotation><xs:documentation>A cache not restored for this long is removed.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="lost-seconds" type="non-neg-int-expandable" default="180"><xs:annotation><xs:documentation>A running job whose runner has not called for this long is checked on its host, and ended when its container is gone or has exited.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="queue-timeout-minutes" type="non-neg-int-expandable" default="1440"><xs:annotation><xs:documentation>A queued job no runner took in this long is an error.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="runner-max-requests-per-minute" type="non-neg-int-expandable" default="1200"><xs:annotation><xs:documentation>Runner REST requests of one job, or one registered runner, in a minute.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="runner-max-registrations-per-minute" type="non-neg-int-expandable" default="10"><xs:annotation><xs:documentation>Runner registrations of one pool (its pool token found good) in a minute; past it 429. Counted by each cluster member for the requests it serves (in memory), so a cluster of n members allows up to n times it; max-runners-per-pool is the cap across the cluster.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-runners-per-pool" type="non-neg-int-expandable" default="50"><xs:annotation><xs:documentation>The most active runners a pool of registered runners holds; a registration past it is refused (409) until one is revoked, so a pool token that leaked mints only so many runner tokens. Counted under the pool's lease, across the cluster. 0 is no cap.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="runner-command" type="xs:string" default="moqui ci-run"><xs:annotation><xs:documentation>The command of a job's container, split at spaces.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="start-inline" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>Start a run's jobs soon after it is queued; false leaves them to the start job.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="container-user" type="xs:string" default="1000:1000"><xs:annotation><xs:documentation>The user of a job's container and its services; image for the image's own, which is then inspected before the container starts and refused unless its USER is a numeric uid other than 0 (no USER, uid 0, root, or a name, which the image may map to uid 0). Never root.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="container-read-only-root" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>A job's container, and its service containers, have a read-only root with a sized tmpfs at /tmp and the working directory on a sized tmpfs; with the pool's diskMb the working directory is on the root filesystem diskMb sizes, which is then writable.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="container-workdir" type="xs:string" default="/workspace"><xs:annotation><xs:documentation>The working directory of a job's container.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="container-tmp-mb" type="non-neg-int-expandable" default="1024"><xs:annotation><xs:documentation>The size of the tmpfs at /tmp of a job's container and of its service containers.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="container-workspace-mb" type="non-neg-int-expandable" default="4096"><xs:annotation><xs:documentation>The size of the tmpfs of a job's working directory when its pool sets no diskMb; it counts toward the pool's memoryMb.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="deploy-timeout-seconds" type="non-neg-int-expandable" default="600"><xs:annotation><xs:documentation>How long a deployment's target is given to fetch and deploy a commit (docs/interfaces/Pipelines.md "Deployments").</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="deploy-private-network" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>true: a deployment may call a target at a loopback, private or link-local address (an internal staging host, the instance and itself); refused otherwise, as webhooks are.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="dav-server">
        <xs:annotation><xs:documentation>The DAV server at /dav: WebDAV over drives, and CalDAV and CardDAV over the
            calendars and address books of the adapter services named here (docs/interfaces/Sync.md). Devices log in with app
            passwords.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="enabled" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>Serve /dav; when false it answers 404.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="public-url" type="xs:string"><xs:annotation><xs:documentation>The base URL the Sync settings show devices; from the webapp host and port when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="calendar-services" type="xs:string"><xs:annotation><xs:documentation>The service class of the CalDAV adapter (get#DavCollections, get#DavObjects,
                put#DavObject, delete#DavObject); no CalDAV when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="contact-services" type="xs:string"><xs:annotation><xs:documentation>The service class of the CardDAV adapter; no CardDAV when empty.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="account-password" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Take the account password too, for an account with no second factor; app passwords only when false.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="allow-http" type="boolean-expandable" default="false"><xs:annotation><xs:documentation>Take credentials over plain HTTP.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="max-file" type="non-neg-int-expandable" default="268435456"><xs:annotation><xs:documentation>The largest request body, so the largest file a PUT writes, in bytes.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="sftp-drives" type="boolean-expandable" default="true"><xs:annotation><xs:documentation>A user without the SSH_SFTP permission who logs in to the SSH server
                with an app password or a key gets SFTP to the drives they may open, one folder each.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="instance">
        <xs:annotation><xs:documentation>This instance: its purpose, id, node role, and the locale and time zone of a
            session with no user locale or zone.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="purpose" type="xs:string" default="production"><xs:annotation><xs:documentation>production,
                dev or test: what the server varies its behavior by. Set it in the runtime conf or by its environment name
                (moqui_conf__instance__purpose): a component's conf merges after the components are chosen for
                it.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="id" type="xs:string"><xs:annotation><xs:documentation>This server's id; empty for the one a
                cluster member keeps in runtime/db/instance_id.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="node-role" type="xs:string"><xs:annotation><xs:documentation>Empty for a normal node, else
                front, front_edge, edge or all-in-one (plans/Edge-Node2.md §4.3).</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="default-locale" type="xs:string" default="en_US"/>
            <xs:attribute name="default-time-zone" type="xs:string" default="UTC"/>
        </xs:complexType>
    </xs:element>
