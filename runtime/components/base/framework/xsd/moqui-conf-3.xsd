            <xs:attribute name="inbound-media-bytes-per-day" type="non-neg-int-expandable" default="2147483648"><xs:annotation><xs:documentation>The bytes of files a bridge fetches from its network a day (MMS pictures); a file past it is named as not received. 0: no cap.</xs:documentation></xs:annotation></xs:attribute>
