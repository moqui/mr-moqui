                </xs:complexType></xs:element>
                <xs:element minOccurs="0" name="fcm"><xs:complexType>
                    <xs:attribute name="service-account" type="xs:string"><xs:annotation><xs:documentation>A secret: the service account key's JSON file path, or the JSON.</xs:documentation></xs:annotation></xs:attribute>
