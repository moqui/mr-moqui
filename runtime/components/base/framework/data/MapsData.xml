<!-- The registry of Geo data sets (plans/Maps.md §6.4): the sources the importer supports first, their identity, parser,
    license and attribution; where each is downloaded from, its year and its priority are in MapsSetupData.xml
    (seed-initial), which an administrator may change. Nothing here is downloaded or loaded until an administrator
    imports a set from Maps › Configuration › Geo data, after acknowledging its license (licenseAckUserId, which these rows
    leave alone, so loading the seed again keeps an acknowledgement). An administrator adds a row for a mirror or a later
    year, with the same sourceKey. Each set's DataSource is the source of the GeoPoint rows it makes. -->
<entity-facade-xml type="seed">
    <moqui.basic.DataSource dataSourceId="CENSUS_ZCTA" dataSourceTypeEnumId="DST_GEO_DATA_SET" description="US Census Gazetteer: ZCTAs"/>
    <moqui.basic.DataSource dataSourceId="CENSUS_COUNTY" dataSourceTypeEnumId="DST_GEO_DATA_SET" description="US Census Gazetteer: Counties"/>
    <moqui.basic.DataSource dataSourceId="CENSUS_PLACE" dataSourceTypeEnumId="DST_GEO_DATA_SET" description="US Census Gazetteer: Places"/>
    <moqui.basic.DataSource dataSourceId="CENSUS_ZCTA_COUNTY" dataSourceTypeEnumId="DST_GEO_DATA_SET" description="US Census 2020 ZCTA to County relationship"/>
    <moqui.basic.DataSource dataSourceId="GEONAMES_POSTAL" dataSourceTypeEnumId="DST_GEO_DATA_SET" description="GeoNames postal codes"/>
    <moqui.basic.DataSource dataSourceId="GEONAMES_COUNTRY" dataSourceTypeEnumId="DST_GEO_DATA_SET" description="GeoNames country information"/>
    <moqui.basic.DataSource dataSourceId="GEONAMES_ADMIN1" dataSourceTypeEnumId="DST_GEO_DATA_SET" description="GeoNames first-level divisions"/>
    <moqui.basic.DataSource dataSourceId="GEONAMES_ADMIN2" dataSourceTypeEnumId="DST_GEO_DATA_SET" description="GeoNames second-level divisions"/>
    <moqui.basic.DataSource dataSourceId="GEONAMES_CITIES15000" dataSourceTypeEnumId="DST_GEO_DATA_SET" description="GeoNames cities over 15,000 people"/>
    <moqui.basic.DataSource dataSourceId="OPERATOR_CSV" dataSourceTypeEnumId="DST_GEO_DATA_SET" description="An operator's postal code file"/>

    <!-- US Census Gazetteer (public domain): yearly zips of pipe-delimited text with a header line. ZCTA: GEOID, areas,
        INTPTLAT, INTPTLONG, no name or state; a ZCTA approximates a ZIP delivery area and not every ZIP has one. Counties and
        Places: the state's USPS code, FIPS GEOID and NAME. -->
    <moqui.maps.GeoDataSet dataSetId="CENSUS_ZCTA" sourceKey="CENSUS_ZCTA" publisher="US Census Bureau" parserEnumId="GDP_CENSUS" yieldsEnumId="GDY_POSTAL_POINTS"
            description="Gazetteer ZIP Code Tabulation Areas: about 34,000 postal-area points (internal points). A ZCTA approximates a ZIP delivery area for statistics; it is not a USPS ZIP registry."
            coverageGeoId="USA" perCountry="N"
            licenseName="Public domain" attribution="Source: U.S. Census Bureau, Gazetteer Files"
            sourceUrl="https://www.census.gov/geographies/reference-files/time-series/geo/gazetteer-files.html" dataSourceId="CENSUS_ZCTA"/>
    <moqui.maps.GeoDataSet dataSetId="CENSUS_COUNTY" sourceKey="CENSUS_CNTY" publisher="US Census Bureau" parserEnumId="GDP_CENSUS" yieldsEnumId="GDY_COUNTIES"
            description="Gazetteer Counties: county Geos with FIPS codes, names, state and internal points."
            coverageGeoId="USA" perCountry="N"
            licenseName="Public domain" attribution="Source: U.S. Census Bureau, Gazetteer Files"
            sourceUrl="https://www.census.gov/geographies/reference-files/time-series/geo/gazetteer-files.html" dataSourceId="CENSUS_COUNTY"/>
    <moqui.maps.GeoDataSet dataSetId="CENSUS_PLACE" sourceKey="CENSUS_PLC" publisher="US Census Bureau" parserEnumId="GDP_CENSUS" yieldsEnumId="GDY_PLACES"
            description="Gazetteer Places: city and place Geos with FIPS codes, names, state and internal points; imported by choice."
            coverageGeoId="USA" perCountry="N"
            licenseName="Public domain" attribution="Source: U.S. Census Bureau, Gazetteer Files"
            sourceUrl="https://www.census.gov/geographies/reference-files/time-series/geo/gazetteer-files.html" dataSourceId="CENSUS_PLACE"/>
    <!-- Confirmed November 25, 2026: a bare text file (6.5 MB, not zipped), pipe-delimited, a header line that starts with a
        UTF-8 byte order mark; 18 columns, GEOID_ZCTA5_20 second, GEOID_COUNTY_20 tenth, AREALAND_PART seventeenth. A row for
        the part of a county outside every ZCTA has the ZCTA columns empty. The county of a ZCTA is the one with the largest
        AREALAND_PART. -->
    <moqui.maps.GeoDataSet dataSetId="CENSUS_ZCTA_COUNTY" sourceKey="CENSUS_ZCCO" publisher="US Census Bureau" parserEnumId="GDP_CENSUS" yieldsEnumId="GDY_POSTAL_COUNTY"
            description="2020 ZCTA to County relationship file: the county, and through it the state, of each ZCTA (the largest land share where it spans several). Pipe-delimited text with a header, not zipped."
            coverageGeoId="USA" perCountry="N" licenseName="Public domain"
            attribution="Source: U.S. Census Bureau, 2020 ZCTA Relationship Files"
            sourceUrl="https://www.census.gov/programs-surveys/geography/technical-documentation/records-layout/2020-zcta-record-layout.html"
            dataSourceId="CENSUS_ZCTA_COUNTY"/>

    <!-- GeoNames (CC BY 4.0, attribution shown): tab-delimited UTF-8 text, no header. {country} is the ISO alpha-2 code (US). -->
    <moqui.maps.GeoDataSet dataSetId="GEONAMES_POSTAL" sourceKey="GN_POSTAL" publisher="GeoNames" parserEnumId="GDP_GEONAMES" yieldsEnumId="GDY_POSTAL_POINTS"
            description="Postal codes a country at a time (124 countries): code, place name, three levels of admin names and codes, point and accuracy (1 estimated, 4 the place's own, 6 centroid of addresses or shape). Some countries have partial codes or coverage (Chile, China, Ireland, Malta, Argentina, Brazil); Canada, the Netherlands and Great Britain have only the first part of the code here."
            perCountry="Y"
            licenseName="CC BY 4.0" licenseUrl="https://creativecommons.org/licenses/by/4.0/"
            attribution="GeoNames (geonames.org), CC BY 4.0" sourceUrl="https://download.geonames.org/export/zip/readme.txt"
            dataSourceId="GEONAMES_POSTAL"/>
    <moqui.maps.GeoDataSet dataSetId="GEONAMES_COUNTRY" sourceKey="GN_COUNTRY" publisher="GeoNames" parserEnumId="GDP_GEONAMES" yieldsEnumId="GDY_COUNTRIES"
            description="Country information: codes, names, capital, postal code format and regular expression. Comment lines start with #."
            perCountry="N"
            licenseName="CC BY 4.0" licenseUrl="https://creativecommons.org/licenses/by/4.0/"
            attribution="GeoNames (geonames.org), CC BY 4.0" sourceUrl="https://download.geonames.org/export/dump/readme.txt"
            dataSourceId="GEONAMES_COUNTRY"/>
    <moqui.maps.GeoDataSet dataSetId="GEONAMES_ADMIN1" sourceKey="GN_ADMIN1" publisher="GeoNames" parserEnumId="GDP_GEONAMES" yieldsEnumId="GDY_ADMIN1"
            description="First-level divisions (states, provinces). Codes are FIPS except for the US, Switzerland, Belgium and Montenegro, which are ISO; a code is kept as the source's own, never written to an ISO field."
            perCountry="N"
            licenseName="CC BY 4.0" licenseUrl="https://creativecommons.org/licenses/by/4.0/"
            attribution="GeoNames (geonames.org), CC BY 4.0" sourceUrl="https://download.geonames.org/export/dump/readme.txt"
            dataSourceId="GEONAMES_ADMIN1"/>
    <moqui.maps.GeoDataSet dataSetId="GEONAMES_ADMIN2" sourceKey="GN_ADMIN2" publisher="GeoNames" parserEnumId="GDP_GEONAMES" yieldsEnumId="GDY_ADMIN2"
            description="Second-level divisions (counties, districts)."
            perCountry="N"
            licenseName="CC BY 4.0" licenseUrl="https://creativecommons.org/licenses/by/4.0/"
            attribution="GeoNames (geonames.org), CC BY 4.0" sourceUrl="https://download.geonames.org/export/dump/readme.txt"
            dataSourceId="GEONAMES_ADMIN2"/>
    <moqui.maps.GeoDataSet dataSetId="GEONAMES_CITIES15000" sourceKey="GN_CITIES" publisher="GeoNames" parserEnumId="GDP_GEONAMES" yieldsEnumId="GDY_PLACES"
            description="Cities of more than 15,000 people (about 25,000) with points. cities5000, cities1000 and cities500 (about 185,000) are rows of their own an administrator adds."
            perCountry="N"
            licenseName="CC BY 4.0" licenseUrl="https://creativecommons.org/licenses/by/4.0/"
            attribution="GeoNames (geonames.org), CC BY 4.0" sourceUrl="https://download.geonames.org/export/dump/readme.txt"
            dataSourceId="GEONAMES_CITIES15000"/>

    <!-- An operator's file: no download. CSV with a header of our own: country, code, place, admin1, admin2, latitude,
        longitude, precision. Chosen deliberately (a licensed or national set the operator converted), so its point is
        preferred. -->
    <moqui.maps.GeoDataSet dataSetId="OPERATOR_CSV" sourceKey="OPERATOR" publisher="Operator" parserEnumId="GDP_OPERATOR_CSV" yieldsEnumId="GDY_POSTAL_POINTS"
            description="An operator's CSV, from an upload or a resource location: a licensed or national data set the operator converted, or an installation with no outside access. Columns: country, code, place, admin1, admin2, latitude, longitude, precision."
            perCountry="N" licenseName="The operator's" dataSourceId="OPERATOR_CSV"/>
</entity-facade-xml>
