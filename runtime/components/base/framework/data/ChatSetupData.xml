<!-- Chat and presence (framework/entity/ChatEntities.xml, org.moqui.chat.ChatServices): the mention topic, the push
    health permission, the search document of chat messages and the jobs. -->
<entity-facade-xml type="seed-initial">
    <!-- A mention in a chat room (org.moqui.chat.ChatServices.notify#Mention), so a server with only the framework stores
        it in the user's notification list (plans/Comms-Messaging.md §7.3, Topics): roomName, chatRoomId, eventSeq,
        authorUserId, authorName and summary in the message, reason NrMention, the room as its record. Its push goes
        through the chat push worker (chat_push.rs), by the room's notification level, not by this topic's push setting,
        so it is not pushed twice. An app may seed it again with its own values (mr-mantle adds its email). -->
    <moqui.security.user.NotificationTopic topic="ChatMention" inboxEnumId="NinNotifications" description="Mentioned in a Chat Room" typeString="info"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y"
            titleTemplate="${authorName} mentioned you in ${roomName}${summary ? ': ' + summary : ''}" linkTemplate=""/>
    <!-- System, Push Health: every user's push devices with their counts (org.moqui.ui.NotificationServices.find#PushHealth) -->
    <moqui.security.UserPermission userPermissionId="PushHealthAdmin" description="See the push devices of every user and how their pushes go"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="PushHealthAdmin" fromDate="0"/>

    <!-- A chat message in the search index: its room, its sender and its current text. ChatServices indexes it on
        send#Message and edit#Message and deletes it on redact#Message (no DataFeed); search#ChatEvents searches it with
        a filter of the rooms the user may read: the user's rooms and the public ones (roomVisibilityEnumId CrvUsers). -->
    <moqui.entity.document.DataDocument dataDocumentId="MoquiChatEvent" indexName="moqui" documentName="Chat Message"
            primaryEntityName="moqui.chat.ChatEvent" documentTitle="${bodyText}">
        <fields fieldSeqId="01" fieldPath="chatRoomId"/>
        <fields fieldSeqId="02" fieldPath="eventSeq"/>
        <fields fieldSeqId="03" fieldPath="eventTypeEnumId"/>
        <fields fieldSeqId="04" fieldPath="senderUserId"/>
        <fields fieldSeqId="05" fieldPath="sender:userFullName" fieldNameAlias="senderName" searchRole="subtitle"/>
        <fields fieldSeqId="06" fieldPath="sender:username" fieldNameAlias="senderUsername"/>
        <fields fieldSeqId="07" fieldPath="threadRootEventSeq"/>
        <fields fieldSeqId="08" fieldPath="bodyText" searchRole="title" searchWeight="A"/>
        <fields fieldSeqId="09" fieldPath="sentDate" sortable="Y"/>
        <fields fieldSeqId="10" fieldPath="room:roomName" fieldNameAlias="roomName" searchWeight="B"/>
        <fields fieldSeqId="11" fieldPath="room:roomTypeEnumId" fieldNameAlias="roomTypeEnumId" searchRole="category"/>
        <fields fieldSeqId="12" fieldPath="room:visibilityEnumId" fieldNameAlias="roomVisibilityEnumId"/>
        <fields fieldSeqId="13" fieldPath="room:recordEntityName" fieldNameAlias="recordEntityName"/>
        <fields fieldSeqId="14" fieldPath="room:recordId" fieldNameAlias="recordId"/>
        <fields fieldSeqId="15" fieldPath="senderActorId"/>
        <fields fieldSeqId="16" fieldPath="senderActor:externalUser:displayName" fieldNameAlias="senderExternalName"/>
        <conditions conditionSeqId="01" fieldNameAlias="eventTypeEnumId" fieldValue="CetMessage"/>
    </moqui.entity.document.DataDocument>

    <!-- Presence: a clear-at time that has come, a user whose client stopped sending its heartbeat (offline) or who went
        idle (away) is published on the userStatus topic to the user's room members. Each user is on their own.
        A success is not kept: the status is the record. -->
    <moqui.service.job.ServiceJob jobName="expire_UserStatuses_frequent" description="Clear expired user statuses and publish presence changes"
            serviceName="org.moqui.chat.ChatServices.expire#UserStatuses" cronExpression="0 * * * * ?" paused="N"
            errorHistoryOnly="Y"/>
    <!-- Chat files uploaded and never sent with a message, after a day -->
    <moqui.service.job.ServiceJob jobName="clean_ChatAttachments_daily" description="Remove chat files never sent"
            serviceName="org.moqui.chat.ChatServices.clean#PendingAttachments" cronExpression="0 30 3 * * ?" paused="N"/>
    <!-- Retention: the events older than a room's retentionDays. Each room is on its own. -->
    <moqui.service.job.ServiceJob jobName="clean_ChatRetention_daily" description="Delete chat events past their room's retention"
            serviceName="org.moqui.chat.ChatServices.clean#ChatRetention" cronExpression="0 45 3 * * ?" paused="N"/>
    <!-- The changes feeds of users and rooms: changes older than chat@changes-keep-days (30). Each is on its own. -->
    <moqui.service.job.ServiceJob jobName="clean_ChatChanges_daily" description="Remove old chat changes from the users' and rooms' feeds"
            serviceName="org.moqui.chat.ChatServices.clean#ChatChanges" cronExpression="0 50 3 * * ?" paused="N"/>

    <!-- Scheduled sends and reminders (plans/Comms-Messaging.md phase 15; org.moqui.chat.ChatScheduleServices): the messages
        the server holds that are due, sent as their senders, and the reminders due, each on its own; the old rows daily. A
        success is not kept: the message or the reminder is the record. -->
    <moqui.service.job.ServiceJob jobName="send_DueChatMessages_frequent" description="Send the scheduled chat messages that are due"
            serviceName="org.moqui.chat.ChatScheduleServices.send#DueMessages" cronExpression="0 * * * * ?" paused="N"
            errorHistoryOnly="Y"/>
    <moqui.service.job.ServiceJob jobName="send_DueChatReminders_frequent" description="Send the chat message reminders that are due"
            serviceName="org.moqui.chat.ChatScheduleServices.send#DueReminders" cronExpression="0 * * * * ?" paused="N"
            errorHistoryOnly="Y"/>
    <moqui.service.job.ServiceJob jobName="clean_ChatSchedule_daily" description="Remove old scheduled chat messages and reminders"
            serviceName="org.moqui.chat.ChatScheduleServices.clean#ScheduledMessages" cronExpression="0 55 3 * * ?" paused="N"/>
    <!-- A reminder that came (ChatScheduleServices.send#DueReminders): stored and on the socket; its push goes through the
        chat push worker (PUSHED_TOPICS), so it is not pushed twice. A scheduled message that was not sent. -->
    <moqui.security.user.NotificationTopic topic="ChatReminder" inboxEnumId="NinNotifications" description="A chat message reminder" typeString="info"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" titleTemplate="${title}" linkTemplate="${link}"/>
    <moqui.security.user.NotificationTopic topic="ChatScheduleFailed" inboxEnumId="NinNotifications" description="A scheduled chat message was not sent" typeString="warning"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" titleTemplate="${title}" linkTemplate="${link}"/>
</entity-facade-xml>
