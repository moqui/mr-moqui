<!-- Voice (framework/entity/VoiceEntities.xml, org.moqui.call.VoiceServices, plans/archive/Comms-Framework.md §5.2): the kinds and
    states of trunks, numbers and emergency locations, the VoiceAdmin permission, and the topic of the fraud and emergency
    alerts. The fraud policy needs no row: without one the defaults apply (international and premium off). -->
<entity-facade-xml type="seed">
    <moqui.basic.EnumerationType description="Voice Transport" enumTypeId="VoiceTransport"/>
    <moqui.basic.Enumeration description="TLS" enumId="VtrTls" enumCode="tls" enumTypeId="VoiceTransport" sequenceNum="1"/>
    <moqui.basic.Enumeration description="TCP" enumId="VtrTcp" enumCode="tcp" enumTypeId="VoiceTransport" sequenceNum="2"/>
    <moqui.basic.Enumeration description="UDP" enumId="VtrUdp" enumCode="udp" enumTypeId="VoiceTransport" sequenceNum="3"/>

    <moqui.basic.EnumerationType description="Voice Media Encryption" enumTypeId="VoiceMediaEncryption"/>
    <moqui.basic.Enumeration description="SRTP" enumId="VmeSrtp" enumCode="srtp" enumTypeId="VoiceMediaEncryption" sequenceNum="1"/>
    <moqui.basic.Enumeration description="Plain RTP" enumId="VmePlain" enumCode="plain" enumTypeId="VoiceMediaEncryption" sequenceNum="2"/>

    <!-- A provider profile: optionValue Y when it allows UDP or TCP signaling and plain RTP. None is verified by an
        authorized live check yet (docs/interfaces/SIP.md); Voice.js VERIFIED_PROFILES lists those that are. -->
    <moqui.basic.EnumerationType description="Voice Provider Profile" enumTypeId="VoiceProviderProfile"/>
    <moqui.basic.Enumeration description="Telnyx (TLS, SRTP; not yet verified live)" enumId="VppTelnyx" enumCode="telnyx" enumTypeId="VoiceProviderProfile" sequenceNum="1" optionValue="N"/>
    <moqui.basic.Enumeration description="Twilio Elastic SIP (TLS, SRTP; not yet verified live)" enumId="VppTwilio" enumCode="twilio" enumTypeId="VoiceProviderProfile" sequenceNum="2" optionValue="N"/>
    <moqui.basic.Enumeration description="Sinch Elastic SIP Trunking (TLS, SRTP; not yet verified live)" enumId="VppSinch" enumCode="sinch" enumTypeId="VoiceProviderProfile" sequenceNum="3" optionValue="N"/>
    <moqui.basic.Enumeration description="Other provider (TLS, SRTP)" enumId="VppGeneric" enumCode="generic" enumTypeId="VoiceProviderProfile" sequenceNum="8" optionValue="N"/>
    <moqui.basic.Enumeration description="PBX on a private network (UDP or TCP, plain RTP allowed)" enumId="VppPlainLan" enumCode="plainLan" enumTypeId="VoiceProviderProfile" sequenceNum="9" optionValue="Y"/>

    <moqui.basic.StatusType description="Voice Trunk" statusTypeId="VoiceTrunk"/>
    <moqui.basic.StatusItem statusId="VtsUnknown" statusTypeId="VoiceTrunk" sequenceNum="1" description="Not checked yet"/>
    <moqui.basic.StatusItem statusId="VtsRegistered" statusTypeId="VoiceTrunk" sequenceNum="2" description="Registered"/>
    <moqui.basic.StatusItem statusId="VtsOk" statusTypeId="VoiceTrunk" sequenceNum="3" description="Reachable"/>
    <moqui.basic.StatusItem statusId="VtsFailed" statusTypeId="VoiceTrunk" sequenceNum="4" description="Failed"/>
    <moqui.basic.StatusItem statusId="VtsDisabled" statusTypeId="VoiceTrunk" sequenceNum="5" description="Disabled"/>

    <moqui.basic.EnumerationType description="Phone Number Route" enumTypeId="PhoneNumberRoute"/>
    <moqui.basic.Enumeration description="A user" enumId="PnrUser" enumCode="user" enumTypeId="PhoneNumberRoute" sequenceNum="1"/>
    <moqui.basic.Enumeration description="A ring group" enumId="PnrRingGroup" enumCode="ringGroup" enumTypeId="PhoneNumberRoute" sequenceNum="2"/>
    <moqui.basic.Enumeration description="An IVR menu" enumId="PnrIvr" enumCode="ivr" enumTypeId="PhoneNumberRoute" sequenceNum="3"/>
    <moqui.basic.Enumeration description="A queue" enumId="PnrQueue" enumCode="queue" enumTypeId="PhoneNumberRoute" sequenceNum="4"/>
    <moqui.basic.Enumeration description="Voicemail access (V2): a caller enters their box number and PIN" enumId="PnrVoicemail" enumCode="voicemail" enumTypeId="PhoneNumberRoute" sequenceNum="5"/>

    <moqui.basic.StatusType description="Emergency Location Validation" statusTypeId="EmergencyLocationValidation"/>
    <moqui.basic.StatusItem statusId="ElvUnvalidated" statusTypeId="EmergencyLocationValidation" sequenceNum="1" description="Not validated"/>
    <moqui.basic.StatusItem statusId="ElvValidated" statusTypeId="EmergencyLocationValidation" sequenceNum="2" description="Validated"/>
    <moqui.basic.StatusItem statusId="ElvFailed" statusTypeId="EmergencyLocationValidation" sequenceNum="3" description="Validation failed"/>

    <moqui.security.UserPermission userPermissionId="VoiceAdmin" description="Set up phone trunks, numbers, caller IDs, fraud limits and emergency locations"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="VoiceAdmin" fromDate="0"/>

    <moqui.security.user.NotificationTopic topic="VoiceAlert" inboxEnumId="NinUpdates" description="Phone alert: a blocked SIP source or an emergency call"
            typeString="warning" showAlert="Y" persistOnSend="Y"/>

    <!-- V4: desk and soft phones registered with Moqui's registrar (SipDevice, org.moqui.call.SipDeviceServices), and the
        cleanup of the bindings whose engine went away. -->
    <moqui.basic.StatusType description="SIP Device" statusTypeId="SipDevice"/>
    <moqui.basic.StatusItem statusId="SdsActive" statusTypeId="SipDevice" sequenceNum="1" description="Active"/>
    <moqui.basic.StatusItem statusId="SdsRevoked" statusTypeId="SipDevice" sequenceNum="2" description="Revoked"/>
    <moqui.service.job.ServiceJob jobName="expire_SipRegistrations" description="Remove expired phone registrations"
            serviceName="org.moqui.call.SipDeviceServices.expire#SipRegistrations" cronExpression="0 0/5 * * * ?" paused="N"
            errorHistoryOnly="Y"/>

    <!-- The spam filter of texts from outside numbers (SmsSpamServices, plans/Comms-Messaging.md §18.3 phase 11): its rules,
        at the threshold 100 (VoicePolicy.smsSpamThreshold), set in System, Voice, Spam. A first text from an unknown number
        with a shortened link is spam (110), one with a link alone is not (70); a number two people here reported is
        (50 each), or one an admin reported. -->
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_FIRST_CONTACT" ruleTypeEnumId="SsrFirstContact" pattern="" weight="40" description="The first text of a new conversation from a number nobody here knows"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_LINK" ruleTypeEnumId="SsrLink" pattern="" weight="30" description="A link"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_HOST_BIT_LY" ruleTypeEnumId="SsrLinkHost" pattern="bit.ly" weight="40" description="A shortened link"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_HOST_TINYURL_COM" ruleTypeEnumId="SsrLinkHost" pattern="tinyurl.com" weight="40" description="A shortened link"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_HOST_T_CO" ruleTypeEnumId="SsrLinkHost" pattern="t.co" weight="40" description="A shortened link"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_HOST_GOO_GL" ruleTypeEnumId="SsrLinkHost" pattern="goo.gl" weight="40" description="A shortened link"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_HOST_IS_GD" ruleTypeEnumId="SsrLinkHost" pattern="is.gd" weight="40" description="A shortened link"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_HOST_OW_LY" ruleTypeEnumId="SsrLinkHost" pattern="ow.ly" weight="40" description="A shortened link"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_HOST_CUTT_LY" ruleTypeEnumId="SsrLinkHost" pattern="cutt.ly" weight="40" description="A shortened link"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_HOST_RB_GY" ruleTypeEnumId="SsrLinkHost" pattern="rb.gy" weight="40" description="A shortened link"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_HOST_TINY_CC" ruleTypeEnumId="SsrLinkHost" pattern="tiny.cc" weight="40" description="A shortened link"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_HOST_SHORTURL_AT" ruleTypeEnumId="SsrLinkHost" pattern="shorturl.at" weight="40" description="A shortened link"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_WORDS_GIFT_CARD" ruleTypeEnumId="SsrKeyword" pattern="gift card" weight="40" description="Words spam often has"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_WORDS_YOU_HAVE_WON" ruleTypeEnumId="SsrKeyword" pattern="you have won" weight="40" description="Words spam often has"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_WORDS_CLAIM_YOUR_PRIZE" ruleTypeEnumId="SsrKeyword" pattern="claim your prize" weight="40" description="Words spam often has"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_WORDS_VERIFY_YOUR_ACCOUNT" ruleTypeEnumId="SsrKeyword" pattern="verify your account" weight="40" description="Words spam often has"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_WORDS_ACCOUNT_SUSPENDED" ruleTypeEnumId="SsrKeyword" pattern="account suspended" weight="40" description="Words spam often has"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_WORDS_UNUSUAL_ACTIVITY" ruleTypeEnumId="SsrKeyword" pattern="unusual activity" weight="40" description="Words spam often has"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_WORDS_CONFIRM_YOUR_IDENTITY" ruleTypeEnumId="SsrKeyword" pattern="confirm your identity" weight="40" description="Words spam often has"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_WORDS_FINAL_NOTICE" ruleTypeEnumId="SsrKeyword" pattern="final notice" weight="40" description="Words spam often has"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_WORDS_UNPAID_TOLL" ruleTypeEnumId="SsrKeyword" pattern="unpaid toll" weight="40" description="Words spam often has"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_WORDS_DELIVERY_ATTEMPT_FAILED" ruleTypeEnumId="SsrKeyword" pattern="delivery attempt failed" weight="40" description="Words spam often has"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_WORDS_PACKAGE_COULD_NOT_BE_DELIVERED" ruleTypeEnumId="SsrKeyword" pattern="package could not be delivered" weight="40" description="Words spam often has"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_WORDS_LOAN_APPROVED" ruleTypeEnumId="SsrKeyword" pattern="loan approved" weight="40" description="Words spam often has"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_REPORTED" ruleTypeEnumId="SsrReported" pattern="" weight="50" description="Reported as spam here"/>
    <moqui.call.SmsSpamRule smsSpamRuleId="SSR_LINE_NON_FIXED_VOIP" ruleTypeEnumId="SsrLineType" pattern="nonFixedVoip" weight="40" description="A number with no fixed line (the provider's lookup)"/>
</entity-facade-xml>
