    <moqui.service.job.ServiceJob jobName="clean_TerminalSessions_daily" description="Delete terminal session audit rows older than 90 days"
            serviceName="org.moqui.terminal.TerminalServices.clean#TerminalSessions" cronExpression="0 37 4 * * ?" paused="N"
            errorHistoryOnly="Y"/>
</entity-facade-xml>
