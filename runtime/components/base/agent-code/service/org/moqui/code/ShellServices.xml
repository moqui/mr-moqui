<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-service-definition.xsd">

    <service verb="get" noun="ShellSnapshot" type="rust" location="moqui_code::services::get_shell_snapshot"
            transaction="ignore">
        <description>The Agent Code sidebar of the current user (AgentCodeUse): their threads that are not deleted,
            newest first, with pin, settle, snooze, read and tag state, and the change number the snapshot is at. The
            shell stream on /agentws goes on from that number.</description>
        <out-parameters><parameter name="snapshot" type="Map"/></out-parameters>
    </service>

    <service verb="get" noun="Descriptor" type="rust" location="moqui_code::services::get_descriptor"
            transaction="ignore">
        <description>The environment descriptor of GET /.well-known/moqui/agent-code (plans/agent-code/09-Wire-API.md
            section 6): the environment id, label, platform, server version, protocol and capabilities. No user
            data.</description>
        <out-parameters><parameter name="descriptor" type="Map"/></out-parameters>
    </service>
</services>
