<!-- General Guideline Verbs: GET=find, POST=create/do, PUT=store (create or update), PATCH=update, DELETE=delete  -->

<resource xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/rest-api-3.xsd"
        name="moqui" displayName="Moqui Tools REST API" version="${moqui_version}"
        description="Services for various system administration and other tools in Moqui Framework. See more information
            about Moqui Framework at [http://www.moqui.org/framework](http://www.moqui.org/framework/index.html)">

    <resource name="reports" description="Authorized report datasets and queries">
        <resource name="query"><method type="post"><service name="org.moqui.report.ReportServices.run#Query"/></method></resource>
        <resource name="documents"><method type="post"><service name="org.moqui.report.ReportServices.query#Documents"/></method></resource>
        <resource name="datasets"><method type="get"><service name="org.moqui.report.ReportServices.list#Datasets"/></method></resource>
    </resource>
    <resource name="monitor"><resource name="annotations"><method type="post"><service name="org.moqui.report.ReportServices.create#Annotation"/></method></resource></resource>

    <resource name="dataDocuments" description="Data Documents - Database derived JSON documents, feeds">
        <method type="get"><entity name="dataDocuments" operation="list"/></method>
        <method type="post"><entity name="dataDocuments" masterName="default" operation="create"/></method>
        <id name="dataDocumentId">
            <method type="get"><entity name="dataDocuments" masterName="default" operation="one"/></method>
            <method type="put"><entity name="dataDocuments" masterName="default" operation="update"/></method>
            <resource name="clone"><method type="post">
                <service name="org.moqui.impl.EntityServices.clone#DataDocument"/></method></resource>
        </id>
        <resource name="feeds">
            <id name="dataFeedId">
                <resource name="index"><method type="post">
                    <service name="org.moqui.search.SearchServices.index#DataFeedDocuments"/></method></resource>
                <resource name="documents"><method type="get">
                    <service name="org.moqui.impl.EntityServices.get#DataFeedDocuments"/></method></resource>
            </id>
        </resource>
        <resource name="indexes">
            <id name="indexName">
                <resource name="mappings"><method type="post">
                    <service name="org.moqui.search.SearchServices.put#DataDocumentMappings"/></method></resource>
                <resource name="search"><method type="post">
                    <service name="org.moqui.search.SearchServices.search#DataDocuments"/></method></resource>
                <!--
                <resource name="searchCount"><method type="post">
                    <service name="org.moqui.search.SearchServices.search#CountBySource"/></method></resource> -->
            </id>
        </resource>
    </resource>

    <resource name="basic" description="Basic Entities - Enum, Geo, Status, UOM, etc">
        <resource name="enums">
            <method type="get"><entity name="enums" operation="list"/></method>
            <method type="post"><entity name="enums" operation="create"/></method>
            <id name="enumId">
                <method type="get"><entity name="enums" masterName="default" operation="one"/></method>
                <method type="patch"><entity name="enums" operation="update"/></method>
            </id>
        </resource>
        <resource name="enumTypes">
            <method type="get"><entity name="moqui.basic.EnumerationType" operation="list"/></method>
            <id name="enumTypeId">
                <method type="get"><entity name="moqui.basic.EnumerationType" operation="one"/></method>
            </id>
        </resource>
        <resource name="geos">
            <method type="get"><entity name="geos" operation="list"/></method>
            <method type="post"><entity name="geos" operation="create"/></method>
            <id name="geoId">
                <method type="get"><entity name="geos" masterName="default" operation="one"/></method>
                <method type="patch"><entity name="geos" operation="update"/></method>
                <resource name="regions"><method type="get">
                    <service name="org.moqui.impl.BasicServices.get#GeoRegionsForDropDown"/></method></resource>
            </id>
        </resource>
        <resource name="statuses">
            <method type="get"><entity name="statuses" operation="list"/></method>
            <method type="post"><entity name="statuses" operation="create"/></method>
            <id name="statusId">
                <method type="get"><entity name="statuses" masterName="default" operation="one"/></method>
                <method type="patch"><entity name="statuses" operation="update"/></method>
            </id>
        </resource>
        <resource name="uoms">
            <method type="get"><entity name="uoms" operation="list"/></method>
            <method type="post"><entity name="uoms" operation="create"/></method>
            <id name="uomId">
                <method type="get"><entity name="uoms" masterName="default" operation="one"/></method>
                <method type="patch"><entity name="uoms" operation="update"/></method>
            </id>
        </resource>
    </resource>
    <resource name="email" description="Email Services - Messages, Templates, Servers">
        <resource name="messages">
            <method type="get"><entity name="emailMessages" operation="list"/></method>
            <!-- NOTE: for now no create allowed, created when sending or receiving -->
            <!-- <method type="post"><entity name="emailMessages" operation="create"/></method> -->
            <id name="emailMessageId">
                <method type="get"><entity name="emailMessages" masterName="default" operation="one"/></method>
                <method type="patch"><entity name="emailMessages" masterName="default" operation="update"/></method>
            </id>
        </resource>
        <resource name="templates">
            <method type="get"><entity name="emailTemplates" operation="list"/></method>
            <method type="post"><entity name="emailTemplates" operation="create"/></method>
            <id name="emailTemplateId">
                <method type="get"><entity name="emailTemplates" masterName="default" operation="one"/></method>
                <method type="patch"><entity name="emailTemplates" masterName="default" operation="update"/></method>
                <resource name="send"><method type="post">
                    <service name="org.moqui.mail.EmailServices.send#Email"/></method></resource>
            </id>
        </resource>
        <!-- the servers no mail account owns, without their secrets (SEC-MAIL-04): a user's own mailbox server is not
            answered, changed or polled here -->
        <resource name="servers">
            <method type="get"><service name="org.moqui.mail.EmailServices.find#RelayServers"/></method>
            <method type="post"><entity name="moqui.basic.email.EmailServer" operation="create"/></method>
            <id name="emailServerId">
                <method type="get"><service name="org.moqui.mail.EmailServices.get#RelayServer"/></method>
                <method type="patch"><service name="org.moqui.mail.EmailServices.update#RelayServer"/></method>
                <resource name="poll"><method type="post">
                    <service name="org.moqui.mail.EmailServices.poll#EmailServer"/></method></resource>
            </id>
        </resource>
    </resource>
    <resource name="print" description="Print - Network Printers and Jobs">
        <resource name="printers">
            <method type="get"><entity name="moqui.basic.print.NetworkPrinter" operation="list"/></method>
            <!-- a printer is started and changed in Admin's Connections (store#Connection: a new or repointed printer waits
                for a test print, and on production reaches no internal address) or System › Print, not here
                (plans/Security-Review-Medium.md SEC-RTE-83) -->
            <id name="networkPrinterId">
                <method type="get"><entity name="moqui.basic.print.NetworkPrinter" operation="one"/></method>

                <resource name="print">
                    <!-- TODO how to handle InputStream or SerialBlob in parameters? -->
                    <resource name="document"><method type="post">
                        <service name="org.moqui.impl.PrintServices.print#Document"/></method></resource>
                    <resource name="resource"><method type="post">
                        <service name="org.moqui.impl.PrintServices.print#ResourceDocument"/></method></resource>
                    <resource name="screen"><method type="post">
                        <service name="org.moqui.impl.PrintServices.print#ScreenDocument"/></method></resource>
                </resource>
            </id>
        </resource>
        <resource name="jobs">
            <method type="get"><entity name="printJobs" operation="list"/></method>
            <method type="post"><entity name="printJobs" operation="create"/></method>

            <id name="printJobId">
                <method type="get"><entity name="printJobs" masterName="default" operation="one"/></method>
                <method type="patch"><entity name="printJobs" operation="update"/></method>

                <resource name="send"><method type="post">
                    <service name="org.moqui.impl.PrintServices.send#PrintJob"/></method></resource>
                <resource name="serverDetails"><method type="get">
                    <service name="org.moqui.impl.PrintServices.get#PrintJobDetailsFromServer"/></method></resource>
                <resource name="hold"><method type="post">
                    <service name="org.moqui.impl.PrintServices.hold#PrintJob"/></method></resource>
                <resource name="release"><method type="post">
                    <service name="org.moqui.impl.PrintServices.release#PrintJob"/></method></resource>
                <resource name="cancel"><method type="post">
                    <service name="org.moqui.impl.PrintServices.cancel#PrintJob"/></method></resource>
            </id>
        </resource>

        <resource name="server"><method type="get">
            <service name="org.moqui.impl.PrintServices.get#ServerPrinters"/></method></resource>
    </resource>

    <resource name="entity" description="Entity - Sync, etc">
        <resource name="syncs">
            <method type="get"><entity name="entitySyncs" operation="list"/></method>
            <method type="post"><entity name="entitySyncs" masterName="default" operation="create"/></method>

            <id name="entitySyncId">
                <method type="get"><entity name="entitySyncs" masterName="default" operation="one"/></method>
                <method type="patch"><entity name="entitySyncs" masterName="default" operation="update"/></method>

                <resource name="run"><method type="post">
                    <service name="org.moqui.impl.EntitySyncServices.run#EntitySync"/></method></resource>
                <resource name="includeList"><method type="get">
                    <service name="org.moqui.impl.EntitySyncServices.get#EntitySyncIncludeList"/></method></resource>
            </id>
            <resource name="run"><method type="post">
                <service name="org.moqui.impl.EntitySyncServices.run#EntitySyncAll"/></method></resource>
            <resource name="data">
                <resource name="put"><method type="post">
                    <service name="org.moqui.impl.EntitySyncServices.put#EntitySyncData"/></method></resource>
                <resource name="get"><method type="post">
                    <service name="org.moqui.impl.EntitySyncServices.get#EntitySyncData"/></method></resource>
            </resource>
        </resource>
    </resource>

    <resource name="systemMessages" description="System to System Messages - Queue, Send, Receive, Consume, etc">
        <method type="get"><entity name="systemMessages" operation="list"/></method>

        <id name="systemMessageId">
            <method type="get"><entity name="systemMessages" masterName="default" operation="one"/></method>
            <method type="patch"><entity name="systemMessages" operation="update"/></method>

            <resource name="send"><method type="post">
                <service name="org.moqui.impl.SystemMessageServices.send#ProducedSystemMessage"/></method></resource>
            <resource name="consume"><method type="post">
                <service name="org.moqui.impl.SystemMessageServices.consume#ReceivedSystemMessage"/></method></resource>
            <resource name="resetError"><method type="post">
                <service name="org.moqui.impl.SystemMessageServices.reset#SystemMessageInError"/></method></resource>
        </id>

        <resource name="outgoing">
            <resource name="queue"><method type="post">
                <service name="org.moqui.impl.SystemMessageServices.queue#SystemMessage"/></method></resource>
            <resource name="queueAck"><method type="post">
                <service name="org.moqui.impl.SystemMessageServices.queue#AckSystemMessage"/></method></resource>
            <resource name="sendAll"><method type="post">
                <service name="org.moqui.impl.SystemMessageServices.send#AllProducedSystemMessages"/></method></resource>
        </resource>
        <resource name="incoming">
            <resource name="receive"><method type="post">
                <service name="org.moqui.impl.SystemMessageServices.receive#IncomingSystemMessage"/></method></resource>
            <resource name="consumeAll"><method type="post">
                <service name="org.moqui.impl.SystemMessageServices.consume#AllReceivedSystemMessages"/></method></resource>
        </resource>
    </resource>

    <resource name="users" description="User Accounts">
        <method type="get"><entity name="users" operation="list"/></method>
        <method type="post"><service name="org.moqui.impl.UserServices.create#UserAccount"/></method>

        <id name="userId">
            <method type="get"><entity name="users" operation="one"/></method>
            <!-- the service, not the entity update: a change of another account's sign-in fields is refused when that account
                holds access the caller lacks, and an email or provider link change needs a recent sign-in
                (plans/Security-Review-Medium.md SEC-ADM-81) -->
            <method type="patch"><service name="org.moqui.impl.UserServices.update#UserAccount"/></method>

            <resource name="password">
                <resource name="update"><method type="post">
                    <service name="org.moqui.impl.UserServices.update#Password"/></method></resource>
                <resource name="reset"><method type="post">
                    <service name="org.moqui.impl.UserServices.reset#Password"/></method></resource>
            </resource>
        </id>
    </resource>

    <resource name="wiki">
        <!-- TODO add more wiki pages and spaces endpoints (see WikiServices.xml) -->
        <resource name="pages">
            <id name="wikiSpaceId"><id name="pagePathList" allow-extra-path="true"><method type="get">
                <service name="org.moqui.resource.WikiServices.get#PublishedWikiPageText"/></method></id></id>

            <resource name="page">
                <resource name="info">
                    <method type="get"><service name="org.moqui.resource.WikiServices.get#WikiPageInfo"/></method>
                    <id name="wikiPageId"><method type="get">
                        <service name="org.moqui.resource.WikiServices.get#WikiPageInfoById"/></method></id>
                </resource>
            </resource>
        </resource>
    </resource>

    <!-- Hosting (docs/interfaces/Git-Hosting.md, REST; plans/Dogfood.md F9): repositories, merge requests by their
        numbers, reviews and pipeline runs over the framework's services (org.moqui.git.GitRestServices and the
        services they call), and commit statuses from outside CI in GitHub's shape. The paths are open to every user
        (MOQUI_API_GIT in ToolsSecurityData.xml): each service checks the repository's rights (AT_GIT_REPOSITORY), and
        before each write the application that keeps the repository is asked (git-server rest-write-check-service). -->
    <resource name="git" description="Repositories, merge requests, reviews and pipeline runs">
        <id name="repositoryId">
            <method type="get"><service name="org.moqui.git.GitRestServices.get#Repository"/></method>
            <resource name="cloneUrls"><method type="get"><service name="org.moqui.git.GitServices.get#GitCloneUrls"/></method></resource>
            <resource name="refs">
                <method type="get"><service name="org.moqui.git.GitServices.get#GitRefs"/></method>
                <method type="post"><service name="org.moqui.git.GitRestServices.create#Ref"/></method>
                <method type="delete"><service name="org.moqui.git.GitRestServices.delete#Ref"/></method>
            </resource>
            <resource name="branchRules"><method type="get"><service name="org.moqui.git.GitServices.get#GitBranchRules"/></method></resource>
            <resource name="tree"><method type="get"><service name="org.moqui.git.GitServices.get#GitTree"/></method></resource>
            <resource name="blob"><method type="get"><service name="org.moqui.git.GitRestServices.get#Blob"/></method></resource>
            <resource name="compare"><method type="get"><service name="org.moqui.git.GitServices.get#GitCompare"/></method></resource>
            <resource name="commits">
                <method type="get"><service name="org.moqui.git.GitServices.get#GitLog"/></method>
                <id name="commitId">
                    <method type="get"><service name="org.moqui.git.GitServices.get#GitCommit"/></method>
                    <resource name="diff"><method type="get"><service name="org.moqui.git.GitServices.get#GitCommitDiff"/></method></resource>
                    <resource name="refs"><method type="get"><service name="org.moqui.git.GitServices.get#GitCommitRefs"/></method></resource>
                    <resource name="statuses">
                        <method type="post"><service name="org.moqui.git.GitRestServices.create#CommitStatus"/></method>
                        <method type="get"><service name="org.moqui.git.GitServices.get#GitCommitStatuses"/></method>
                    </resource>
                </id>
            </resource>
            <resource name="agreement"><method type="get"><service name="org.moqui.git.GitRestServices.get#AuthorSigned"/></method></resource>
            <resource name="writeCheck"><method type="get"><service name="org.moqui.git.GitRestServices.verify#Write"/></method></resource>
            <resource name="mergeRequests">
                <method type="get"><service name="org.moqui.git.GitRestServices.find#MergeRequests"/></method>
                <method type="post"><service name="org.moqui.git.GitRestServices.create#MergeRequest"/></method>
                <id name="mergeRequestNum">
                    <method type="get"><service name="org.moqui.git.GitRestServices.get#MergeRequest"/></method>
                    <method type="patch"><service name="org.moqui.git.GitRestServices.update#MergeRequest"/></method>
                    <resource name="close"><method type="post"><service name="org.moqui.git.GitRestServices.close#MergeRequest"/></method></resource>
                    <resource name="reopen"><method type="post"><service name="org.moqui.git.GitRestServices.reopen#MergeRequest"/></method></resource>
                    <resource name="reviewers"><method type="put"><service name="org.moqui.git.GitRestServices.set#MergeRequestReviewers"/></method></resource>
                    <resource name="reviews"><method type="post"><service name="org.moqui.git.GitRestServices.submit#MergeRequestReview"/></method></resource>
                    <resource name="approvals"><method type="get"><service name="org.moqui.git.GitRestServices.get#MergeRequestApprovals"/></method></resource>
                    <resource name="diff"><method type="get"><service name="org.moqui.git.GitRestServices.get#MergeRequestDiff"/></method></resource>
                    <resource name="merge"><method type="post"><service name="org.moqui.git.GitRestServices.merge#MergeRequest"/></method></resource>
                    <resource name="threads">
                        <method type="get"><service name="org.moqui.git.GitRestServices.find#ReviewThreads"/></method>
                        <method type="post"><service name="org.moqui.git.GitRestServices.create#ReviewComment"/></method>
                        <id name="threadId">
                            <resource name="resolve"><method type="post"><service name="org.moqui.git.GitRestServices.resolve#ReviewThread"/></method></resource>
                        </id>
                    </resource>
                </id>
            </resource>
            <resource name="pipelines">
                <method type="get"><service name="org.moqui.git.GitCiServices.find#PipelineRuns"/></method>
                <method type="post"><service name="org.moqui.git.GitRestServices.run#Pipeline"/></method>
                <resource name="definitions"><method type="get"><service name="org.moqui.git.GitCiServices.get#PipelineDefinitions"/></method></resource>
                <id name="runNum">
                    <method type="get"><service name="org.moqui.git.GitCiServices.get#PipelineRun"/></method>
                    <resource name="rerun"><method type="post"><service name="org.moqui.git.GitRestServices.rerun#PipelineRun"/></method></resource>
                    <resource name="cancel"><method type="post"><service name="org.moqui.git.GitRestServices.cancel#PipelineRun"/></method></resource>
                    <resource name="approve"><method type="post"><service name="org.moqui.git.GitRestServices.approve#PipelineRun"/></method></resource>
                </id>
            </resource>
            <resource name="jobs">
                <id name="jobRunId">
                    <method type="get"><service name="org.moqui.git.GitCiServices.get#JobRun"/></method>
                    <resource name="log"><method type="get"><service name="org.moqui.git.GitCiServices.get#JobLog"/></method></resource>
                    <resource name="retry"><method type="post"><service name="org.moqui.git.GitRestServices.retry#JobRun"/></method></resource>
                </id>
            </resource>
            <resource name="artifacts">
                <id name="artifactId"><method type="get"><service name="org.moqui.git.GitRestServices.get#RunArtifact"/></method></id>
            </resource>
        </id>
    </resource>
    <!-- What a client asks before it knows a repository (plans/design-dev-aide.md F18): what the server offers (open to
        a caller with no credentials), the repository behind a clone or page URL, and the merge requests of every
        repository the caller may view (MOQUI_API_HOSTING in ToolsSecurityData.xml). -->
    <resource name="hosting" description="What the server offers, and the repository behind a URL">
        <resource name="offer" require-authentication="anonymous-view">
            <method type="get" require-authentication="anonymous-view"><service name="org.moqui.git.GitRestServices.get#HostingOffer"/></method>
        </resource>
        <resource name="repository"><method type="get"><service name="org.moqui.git.GitRestServices.resolve#RepositoryUrl"/></method></resource>
        <resource name="mergeRequests"><method type="get"><service name="org.moqui.git.GitRestServices.find#MergeRequests"/></method></resource>
        <resource name="agreement"><method type="get"><service name="org.moqui.git.GitRestServices.get#AuthorSigned"/></method></resource>
        <!-- a client's own keys (plans/design-dev-aide.md 21.2): a key for the LLM gateway alone, and the end of a key it
            holds, when it is let go -->
        <resource name="gatewayKey"><method type="post"><service name="org.moqui.impl.UserServices.create#UserScopedKey"/></method></resource>
        <resource name="keyRevoke"><method type="post"><service name="org.moqui.impl.UserServices.revoke#UserHeldKey"/></method></resource>
    </resource>

    <!-- A source server's deploy step (docs/tools/Component-Deploy.md "The gate"): no session; the attestation, signed
        with the secret this server issued, is checked by the service itself. -->
    <resource name="components" description="Attested component deploys">
        <resource name="deploy" require-authentication="false">
            <method type="post" require-authentication="false"><service name="org.moqui.dev.ComponentServices.deploy#AttestedComponent"/></method>
        </resource>
    </resource>

    <!-- The artifact index of a project an admin allowed (DevArtifactProject), read only, on any instance
        (plans/design-dev-aide.md 7.4): for the AIDE_READ permission (AIDE_READ_API in the framework's
        DevToolsSecurityData.xml). Each answer has the index's indexStamp. Rebuilding stays on dev instances. -->
    <resource name="aide" description="The artifact index of allowed projects, read only">
        <resource name="projects">
            <id name="projectId">
                <resource name="artifacts">
                    <method type="get"><service name="org.moqui.dev.DevToolsServices.find#Artifacts"/></method>
                </resource>
                <resource name="artifact">
                    <method type="get"><service name="org.moqui.dev.DevToolsServices.get#Artifact"/></method>
                </resource>
                <resource name="refs">
                    <method type="get"><service name="org.moqui.dev.DevToolsServices.get#ArtifactRefs"/></method>
                </resource>
                <resource name="bindings">
                    <method type="get"><service name="org.moqui.dev.DevToolsServices.get#ArtifactBindings"/></method>
                </resource>
                <resource name="at">
                    <method type="get"><service name="org.moqui.dev.DevToolsServices.get#ArtifactAt"/></method>
                </resource>
                <resource name="extensions">
                    <method type="get"><service name="org.moqui.dev.DevToolsServices.get#ArtifactExtensions"/></method>
                </resource>
            </id>
        </resource>
    </resource>

    <!-- TODO: caches, TODO will need services implemented as uses API directly for most ops -->
</resource>
