<!-- Saved views (plans/Maps.md §3.1): the user's own saved map views and, beside them, those others shared, over
    org.moqui.maps.MapServices find#SavedViews, store#SavedView and delete#SavedView, which act on the signed-in user's own
    views only (another's is read, never changed). Each shows its place, its owner and whether all its layers are still
    available (a layer that is not is left out of what is drawn, and said here); its name opens it in Browse, and View map
    shows its place in the local-map dialog (LocalMap), as an app opens it beside an address. Views are saved from
    Browse. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Saved views" default-menu-index="2" menu-image="sym_o_bookmarks" menu-image-type="icon">

    <transition name="deleteView">
        <service-call name="org.moqui.maps.MapServices.delete#SavedView" in-map="{savedViewId:savedViewId}" out-map="deleted"/>
        <actions>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(deleted.applied ? ec.l10n.localize('Saved view deleted') : deleted.reason, deleted.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="shareView">
        <service-call name="org.moqui.maps.MapServices.store#SavedView" in-map="{savedViewId:savedViewId, isShared:isShared}" out-map="stored"/>
        <actions>
            <if condition="!ec.message.hasError()">
                <script>ec.message.addMessage(stored.applied ? (isShared === 'Y' ? ec.l10n.localize('The view is shared: every Maps user sees it beside their own')
                    : ec.l10n.localize('The view is yours alone again')) : stored.reason, stored.applied ? 'success' : 'warning')</script>
            </if>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <service-call name="org.moqui.maps.MapServices.find#SavedViews" out-map="found" transaction="force-new" ignore-error="true"/>
        <set field="available" from="!!found?.savedViewList"/>
        <set field="viewRows" from="Array.from(found?.savedViewList || []).map(row =&gt; {
                const view = row.view || {}
                const middle = Array.isArray(view.center) ? view.center : Array.isArray(view.extent)
                    ? [(Number(view.extent[0]) + Number(view.extent[2])) / 2, (Number(view.extent[1]) + Number(view.extent[3])) / 2] : null
                const place = Array.isArray(view.center) ? Number(view.center[1]).toFixed(4) + ', ' + Number(view.center[0]).toFixed(4) + (view.zoom != null ? ' · zoom ' + view.zoom : '')
                    : Array.isArray(view.extent) ? view.extent.map(value =&gt; Number(value).toFixed(2)).join(', ') : ''
                return {savedViewId: row.savedViewId, description: row.description, isOwn: row.isOwn, isShared: row.isShared,
                    ownerText: row.isOwn ? (row.isShared ? ec.l10n.localize('Yours, shared') : ec.l10n.localize('Yours')) : ec.l10n.localize('Shared by') + ' ' + (row.ownerName || ''),
                    placeText: place, longitude: middle ? String(middle[0]) : '', latitude: middle ? String(middle[1]) : '', layersText: (view.layers || []).length ? (view.layers || []).join(', ') : ec.l10n.localize('The profile\'s'),
                    statusText: row.explanation || ec.l10n.localize('All its layers are available'), statusColor: row.explanation ? 'warning' : 'positive'}
            })"/>
    </actions>
    <widgets>
        <label text="Saved views" type="h5"/>
        <label type="p" style="text-caption m-muted"
                text="Your saved views, and beside them those other Maps users shared. A view is saved from Browse with Save view; only its owner changes or deletes it."/>
        <label type="p" style="text-negative" condition="!available" text="Saved views are not available to you."/>
        <label type="p" style="m-muted" condition="available &amp;&amp; !viewRows.length" text="No saved view yet. Open Browse, move the map where you want it and choose Save view."/>
        <section name="ViewSection" condition="viewRows.length">
            <widgets>
                <form-list name="SavedViewList" list="viewRows" skip-form="true" paginate="false">
                    <field name="description">
                        <default-field title="View">
                            <link url="../Browse" text="${description}" link-type="anchor" parameter-map="{savedViewId:savedViewId}"/>
                        </default-field>
                    </field>
                    <field name="ownerText"><default-field title="Owner"><display/></default-field></field>
                    <field name="placeText"><default-field title="Place"><display/></default-field></field>
                    <field name="layersText"><default-field title="Layers"><display/></default-field></field>
                    <field name="statusText">
                        <default-field title="Sources">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${html(statusColor)}">${html(statusText)}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: statusText})}]]></text>
                                <text type="html">${html(statusText)}</text>
                                <text type="text,csv">${statusText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="actions">
                        <default-field title="">
                            <!-- the local-map dialog, as any app opens it beside a place: the view's middle as a plain point -->
                            <dynamic-dialog id="ViewMap_${savedViewId}" button-text="View map" icon="sym_o_map" title="${description}"
                                    transition="../LocalMap" condition="longitude" parameter-map="{longitude:longitude, latitude:latitude, label:description, dialogId:'ViewMap_' + savedViewId}"/>
                            <link url="shareView" text="Share" icon="sym_o_share" link-type="hidden-form-link" condition="isOwn &amp;&amp; !isShared"
                                    confirmation="Share ${description}? Every Maps user sees it beside their own views."
                                    parameter-map="{savedViewId:savedViewId, isShared:'Y'}"/>
                            <link url="shareView" text="Stop sharing" icon="sym_o_lock" link-type="hidden-form-link" condition="isOwn &amp;&amp; isShared"
                                    parameter-map="{savedViewId:savedViewId, isShared:'N'}"/>
                            <link url="deleteView" text="Delete" btn-type="danger" icon="sym_o_delete" link-type="hidden-form-link" condition="isOwn"
                                    confirmation="Delete the saved view ${description}? It cannot be brought back."
                                    parameter-map="{savedViewId:savedViewId}"/>
                        </default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="description"/><field-ref name="ownerText"/></column>
                        <column><field-ref name="statusText"/><field-ref name="actions"/></column>
                    </columns>
                </form-list>
            </widgets>
        </section>
    </widgets>
</screen>
