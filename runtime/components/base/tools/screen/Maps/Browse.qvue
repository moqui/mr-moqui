along with this software (see the LICENSE.md file). If not, see
<http://creativecommons.org/publicdomain/zero/1.0/>.
-->
<!-- Maps › Browse (Browse.xml; plans/archive/Maps.md §3.1): m-map filling the space below the shell's header, over the effective
    configuration this component asks getConfig for and hands to m-map as an object (so a layer shown or hidden, a basemap
    chosen, a saved view or a result gone to draws again where the map was). Beside it, one panel at a time: Search (saved
    views and places, permitted records and postal codes, a postal area shown by its broad extent, and the configured
    geocoder's candidates with their source, precision and ambiguity when one is enabled), Layers (the basemap, the
    overlays and record layers, the user's own and shared overlays with Add overlay and Remove, each layer that is not
    shown named with Retry, and a cut feature list said), Saved views (Save view saves where the map is) and the selected
    feature's details (a place's or a record's, or an overlay's feature with its label and plain-text description and its
    overlay; the record's links a registered route resolves; Save place, Remove place). Add overlay takes an upload or a file
    chosen with the drive picker (pickerData, pickerFolder, pickerSearch: the formats an overlay reads only). Edit, on one of
    the user's own overlays drawn whole (their places among them), opens the Edit panel: m-map's editing (editCommand,
    edit-change: draw points, lines and areas, move the selected feature's vertices, delete it, give it a label and
    description as plain text; from the keyboard a vertex at the map's center), saved through saveOverlayEdit as a new version
    of the file (or of name.edited.geojson beside a file of another format), refused when the file changed since it was
    opened. A Cloud Optimized GeoTIFF layer has Bands under Layers (P4c): which bands as red, green and blue or one band
    through a colormap, the stretch's minimum and maximum and a no-data value, drawn at once and kept as the user's own
    (rasterBands; a saved view keeps them too). Below 600 px the panel is a bottom sheet over the map. Full screen is the browser's, on request. The last view
    is posted (rememberView) only when the user turned Restore my last view on. Brand color names and Quasar classes
    only.
    Live location (plans/Location-Sharing.md §3.3): the configuration's locationShares, drawn by m-map's live layer (which
    follows each share's topic and tells this screen what it holds by live-change); the Live location panel with Shared with
    me (each person, the age, Show on map, Directions: geo: in the Android app, OpenStreetMap elsewhere) and Who sees my
    location (each share of the user's own with its audience and end: Stop, Extend (the new end alone, never the audience
    again), Delete trail, a person or group taken out, and Add the group again, the one act that sends a group to
    update#Share again); the Share my location dialog (people, groups, XMPP contacts when the server has XMPP, a guest link
    whose token is shown once, until, exact or approximate, a trail); and a banner above the map for each active share of
    the user's own and each share this page sends, with Stop. While this page is open it sends the shares it started (kept
    in this tab's session storage under the account, forgotten at a sign-out) by
    watchPosition through reportPosition, at most one a share's reportIntervalSeconds, and handles its statuses (429 waits,
    410 and 404 stop sending, 409 STALE is passed over and CLOCK_AHEAD sends with the server's time); the page closed, the
    share stays active and its audience sees its position age. On every screen the app bar's "Sharing location" chip (a
    shell indicator of the framework's live-location provider) opens My location shares (MyShares.xml), whose Open in
    Maps opens this screen's Live location panel (panel=live); while this page sends, it notes "sending here" on that
    chip. In the Android app (plans/Location-Sharing.md §3.4, LL3; moquiDesktop.location) Share asks for the location
    permission first, with the app's reason, and the app's foreground service sends the share from the phone, also with
    the app in the background, under its notification (this page sends it only when the app could not start that); a
    share is sent from one device or page at a time, and Send from here (Send from this device in the app) takes it over
    on the server (sendFromHere), the one that sent it being refused as another device's (409 OTHER_DEVICE) and
    stopping. -->
<template><div ref="frame" class="m-maps-browse column no-wrap" :class="fullscreen ? ($q.dark.isActive ? 'bg-dark' : 'bg-white') : ''">
    <div class="row items-center no-wrap q-gutter-x-xs q-px-sm q-py-xs">
        <div class="col" style="max-width:420px">
            <m-text-line v-model="query" name="mapsSearch" id="MapsSearch" :label="t('Search places, records and postal codes')" @keyup.enter="runSearch"></m-text-line>
        </div>
        <q-select v-if="postalCountries.length" v-model="postalCountry" :options="postalCountries" option-value="geoId" option-label="name" emit-value map-options
                dense outlined clearable style="min-width:120px" :label="t('Postal country')" id="MapsPostalCountry"></q-select>
        <q-btn id="MapsSearchButton" dense flat no-caps icon="sym_o_search" :label="phone ? '' : t('Search')" :aria-label="t('Search')" @click="runSearch"></q-btn>
        <q-space></q-space>
        <q-btn v-if="editing" dense flat no-caps icon="sym_o_edit" :label="phone ? '' : t('Editing')" :aria-label="t('Editing') + ': ' + editing.label"
                :class="panel === 'edit' ? 'm-tonal text-primary' : 'text-positive'" :aria-pressed="panel === 'edit' ? 'true' : 'false'" @click="togglePanel('edit')"
                id="MapsEditingButton"></q-btn>
        <q-btn dense flat no-caps icon="sym_o_layers" :label="phone ? '' : t('Layers')" :aria-label="t('Layers')" :class="panel === 'layers' ? 'm-tonal text-primary' : ''"
                :aria-pressed="panel === 'layers' ? 'true' : 'false'" @click="togglePanel('layers')">
            <q-badge v-if="problemCount" floating color="warning" rounded>{{problemCount}}</q-badge>
        </q-btn>
        <q-btn dense flat no-caps icon="sym_o_bookmarks" :label="phone ? '' : t('Saved views')" :aria-label="t('Saved views')"
                :class="panel === 'views' ? 'm-tonal text-primary' : ''" :aria-pressed="panel === 'views' ? 'true' : 'false'" @click="togglePanel('views')"></q-btn>
        <q-btn dense flat no-caps icon="sym_o_share_location" :label="phone ? '' : t('Live location')" :aria-label="t('Live location')" id="MapsLiveButton"
                :class="panel === 'live' ? 'm-tonal text-primary' : ''" :aria-pressed="panel === 'live' ? 'true' : 'false'" @click="togglePanel('live')">
            <q-badge v-if="sharedWithMe.length" floating color="primary" rounded>{{sharedWithMe.length}}</q-badge>
        </q-btn>
        <q-btn dense unelevated no-caps class="m-btn-tonal" icon="sym_o_bookmark_add" :label="phone ? '' : t('Save view')" :aria-label="t('Save view')"
                :disable="!lastView" @click="openSave"></q-btn>
        <q-btn v-if="fullscreenAvailable" dense flat :icon="fullscreen ? 'fullscreen_exit' : 'fullscreen'"
                :aria-label="fullscreen ? t('Leave full screen') : t('Full screen')" @click="toggleFullscreen">
            <q-tooltip>{{fullscreen ? t('Leave full screen') : t('Full screen')}}</q-tooltip>
        </q-btn>
    </div>
    <div v-if="error" class="text-negative q-px-sm" role="alert">{{error}}</div>
    <!-- each active share of the user's own, always in sight here (plans/Location-Sharing.md §1, "Visible to everyone it
        concerns"), with Stop; while this page sends it, it says so -->
    <div v-for="share in banners" :key="'banner' + share.shareId" class="m-maps-sharing row items-center no-wrap q-px-sm q-py-xs m-tonal" role="status"
            :data-maps-sharing="share.shareId">
        <q-icon :name="sentHere(share.shareId) ? 'sym_o_share_location' : 'sym_o_location_off'" :color="sentHere(share.shareId) ? 'positive' : 'warning'"
                class="q-mr-sm"></q-icon>
        <div class="col text-body2">
            <span>{{t('Sharing your location with')}} {{audienceText(share)}} {{t('until')}} {{untilText(share.thruDate)}}</span>
            <span class="text-caption m-muted"> · {{sentFromText(share)}}</span>
            <span v-if="sendNotes[share.shareId]" class="text-caption text-warning"> · {{sendNotes[share.shareId]}}</span>
        </div>
        <q-btn v-if="!sentHere(share.shareId)" dense flat no-caps size="sm" :label="nativeLocation() ? t('Send from this device') : t('Send from here')"
                @click="sendFromHere(share)" :data-maps-send-here="share.shareId"></q-btn>
        <q-btn dense flat no-caps size="sm" color="negative" icon="sym_o_location_off" :label="t('Stop')" :aria-label="t('Stop sharing') + ': ' + audienceText(share)"
                @click="stopShare(share)" :data-maps-stop="share.shareId"></q-btn>
    </div>
    <div v-if="geoError && sending.length" class="text-warning text-caption q-px-sm" role="alert">{{geoError}}</div>
    <div v-if="sendError" class="text-warning text-caption q-px-sm" role="alert">{{sendError}}</div>
    <div v-if="sharesNotice" class="text-warning text-caption q-px-sm" role="alert" id="MapsSharesNotice">{{sharesNotice}}</div>

    <div class="row no-wrap">
        <component :is="phone ? 'q-card' : 'div'" v-if="panel" :flat="phone ? true : undefined" :bordered="phone ? true : undefined"
                :class="phone ? 'm-maps-sheet scroll q-pa-sm' : 'm-maps-panel col-auto scroll q-pa-sm'"
                :style="phone ? sheetStyle : {width: '320px', height: mapPx + 'px'}" role="region" :aria-label="panelTitle">
            <div class="row items-center no-wrap q-mb-xs">
                <div class="text-subtitle2 col">{{panelTitle}}</div>
                <q-btn dense flat round icon="close" :aria-label="t('Close')" @click="panel = ''"></q-btn>
            </div>

            <template v-if="panel === 'search'">
                <div v-if="searching" class="m-muted">{{t('Searching…')}}</div>
                <div v-else-if="!results.length" class="m-muted">{{t('No saved place, record or postal code matches.')}}</div>
                <div v-if="!searching && postalNote" class="text-caption text-warning q-mb-xs" id="MapsPostalNote">{{postalNote}}</div>
                <div v-if="!searching && geocoder && geocoder.reason" class="text-caption text-warning q-mb-xs" id="MapsGeocoderNote">{{geocoder.reason}}</div>
                <div v-if="!searching && geocoder && geocoder.ambiguous" class="text-caption m-muted q-mb-xs">{{t('More than one address or place matches: choose one.')}}</div>
                <q-list dense separator>
                    <q-item v-for="result in results" :key="result.id" clickable @click="goToResult(result)" :data-maps-result="result.id">
                        <q-item-section avatar><q-icon :name="resultIcon(result)"></q-icon></q-item-section>
                        <q-item-section>
                            <q-item-label>{{result.label}}</q-item-label>
                            <q-item-label caption>{{[result.sourceText, result.precisionText || precisionText(result.precisionEnumId)].filter(Boolean).join(' · ')}}</q-item-label>
                        </q-item-section>
                    </q-item>
                </q-list>
                <div class="text-caption m-muted q-mt-sm">{{t('Saved views and places, the records of the layers shown in the view on screen and the postal codes of the imported Geo data are searched. Going to a result changes nothing in its record.')}}</div>
                <div v-if="overture" class="text-caption m-muted q-mt-xs" id="MapsOvertureSource">{{t('Places from Overture Maps Foundation, imported on this server')}}{{overture.attribution ? ': ' + overture.attribution : ''}}.</div>
                <div v-if="geocoder" class="text-caption m-muted q-mt-xs" id="MapsGeocoderSource">{{t('Addresses and places were also asked of')}} {{geocoder.providerName}}{{geocoder.attribution ? ' (' + attributionText(geocoder.attribution) + ')' : ''}}.</div>
            </template>

            <template v-if="panel === 'layers'">
                <template v-if="basemaps.length > 1">
                    <div class="text-caption m-muted q-mt-xs">{{t('Basemap')}}</div>
                    <q-list dense>
                        <q-item v-for="basemap in basemaps" :key="basemap.id" clickable @click="chooseBasemap(basemap.id)" :aria-pressed="basemap.id === basemapId ? 'true' : 'false'">
                            <q-item-section avatar><q-icon :name="basemap.id === basemapId ? 'radio_button_checked' : 'radio_button_unchecked'"></q-icon></q-item-section>
                            <q-item-section>{{basemap.label}}</q-item-section>
                        </q-item>
                    </q-list>
                </template>
                <div v-else class="text-caption m-muted q-mt-xs">{{t('Basemap')}}: {{(basemaps[0] || {}).label || t('Country outlines')}}</div>
                <template v-if="profileOverlays.length || recordLayers.length">
                    <div class="text-caption m-muted q-mt-sm">{{t('Layers')}}</div>
                    <q-list dense>
                        <q-item v-for="layer in profileOverlays.concat(recordLayers)" :key="layer.id" clickable @click="toggleLayer(layer)"
                                :aria-pressed="layerShown(layer) ? 'true' : 'false'" :data-maps-layer="layer.id">
                            <q-item-section avatar><q-icon :name="layerShown(layer) ? 'check_box' : 'check_box_outline_blank'"></q-icon></q-item-section>
                            <q-item-section>
                                <q-item-label>{{layer.label}}</q-item-label>
                                <q-item-label v-if="layer.adapterKey" caption>{{t('Records')}}</q-item-label>
                                <q-item-label v-if="layer.kind === 'cog' && layer.raster" caption>{{rasterCaption(layer)}}</q-item-label>
                            </q-item-section>
                            <q-item-section v-if="layer.kind === 'cog' && layer.raster" side>
                                <q-btn dense flat round size="sm" icon="sym_o_tune" :aria-label="t('Bands of') + ' ' + layer.label" :data-maps-bands="layer.id"
                                        :aria-pressed="bandLayerId === layer.id ? 'true' : 'false'" @click.stop="openBands(layer)"></q-btn>
                            </q-item-section>
                        </q-item>
                    </q-list>
                    <div v-if="bandLayer" class="q-mt-sm q-pa-sm m-tonal rounded-borders" data-maps-band-form :aria-label="t('Bands of') + ' ' + bandLayer.label" role="group">
                        <div class="text-caption">{{t('Bands of')}} {{bandLayer.label}}: {{rasterCaption(bandLayer)}}</div>
                        <q-option-group v-model="bandForm.mode" inline dense :options="[{ label: t('Red, green and blue'), value: 'rgb' }, { label: t('One band'), value: 'single' }]"></q-option-group>
                        <div v-if="bandForm.mode === 'rgb'" class="row q-gutter-xs">
                            <q-select v-for="(color, index) in [t('Red'), t('Green'), t('Blue')]" :key="index" v-model="bandForm.rgb[index]" :options="bandOptions"
                                    emit-value map-options dense outlined class="col" :label="color"></q-select>
                        </div>
                        <div v-else class="row q-gutter-xs">
                            <q-select v-model="bandForm.band" :options="bandOptions" emit-value map-options dense outlined class="col" :label="t('Band')"></q-select>
                            <q-select v-model="bandForm.colormap" :options="colormapOptions" emit-value map-options dense outlined class="col" :label="t('Colors')"></q-select>
                        </div>
                        <div class="row q-gutter-xs q-mt-xs">
                            <q-input v-model="bandForm.min" type="number" dense outlined class="col" :label="t('Minimum')"></q-input>
                            <q-input v-model="bandForm.max" type="number" dense outlined class="col" :label="t('Maximum')"></q-input>
                            <q-input v-model="bandForm.nodata" type="number" dense outlined class="col" :label="t('No data')"></q-input>
                        </div>
                        <div v-if="bandError" class="text-negative text-caption q-mt-xs" role="alert">{{bandError}}</div>
                        <div class="row justify-end q-gutter-xs q-mt-xs">
                            <q-btn dense flat no-caps :label="t('Its defaults')" :disable="bandSaving" @click="resetBands"></q-btn>
                            <q-btn dense unelevated no-caps color="primary" :label="t('Apply')" :loading="bandSaving" @click="applyBands"></q-btn>
                        </div>
                    </div>
                </template>
                <div v-else class="text-caption m-muted q-mt-sm">{{t('This map profile has no layers over its basemap.')}}</div>
                <div class="row items-center no-wrap q-mt-sm">
                    <div class="text-caption m-muted col">{{t('Your overlays and places')}}</div>
                    <q-btn dense flat no-caps size="sm" icon="sym_o_add" :label="t('Add overlay')" id="MapsAddOverlay" @click="openAddOverlay"></q-btn>
                </div>
                <q-list dense v-if="personalOverlays.length">
                    <q-item v-for="layer in personalOverlays" :key="layer.id" :data-maps-overlay="layer.overlayId">
                        <q-item-section avatar class="cursor-pointer" @click="toggleLayer(layer)" :aria-pressed="layerShown(layer) ? 'true' : 'false'" role="button">
                            <q-icon :name="layerShown(layer) ? 'check_box' : 'check_box_outline_blank'"></q-icon>
                        </q-item-section>
                        <q-item-section>
                            <q-item-label>{{layer.label}}</q-item-label>
                            <q-item-label caption>{{overlayCaption(layer)}}</q-item-label>
                            <q-item-label v-if="layer.rejectedCount" caption class="text-warning">{{layer.rejectedCount}} {{t('features left out: their geometry is not valid')}}</q-item-label>
                        </q-item-section>
                        <q-item-section side v-if="canEdit(layer)">
                            <q-btn dense flat round size="sm" icon="sym_o_edit" :aria-label="t('Edit') + ' ' + layer.label" @click="startEdit(layer)"
                                    :data-maps-edit="layer.overlayId" :disable="editLoading">
                                <q-tooltip>{{t('Edit on the map')}}</q-tooltip>
                            </q-btn>
                        </q-item-section>
                        <q-item-section side v-if="layer.isOwn && tilesBusy(layer)">
                            <q-btn dense flat round size="sm" icon="sym_o_cancel" :aria-label="t('Stop simplifying')" @click="cancelTiles(layer)" data-maps-cancel-tiles="true">
                                <q-tooltip>{{t('Stop simplifying')}}</q-tooltip>
                            </q-btn>
                        </q-item-section>
                        <q-item-section side v-if="layer.isOwn">
                            <q-btn dense flat round size="sm" icon="sym_o_delete" :aria-label="t('Remove from the map')" @click="removeOverlay(layer)">
                                <q-tooltip>{{t('Remove from the map (the file stays in your files)')}}</q-tooltip>
                            </q-btn>
                        </q-item-section>
                    </q-item>
                </q-list>
                <div v-else class="text-caption m-muted">{{t('Add a GeoJSON, KML, GPX, shapefile or other geographic file. Share its file in Files to show it to others.')}}</div>
                <div v-if="layerErrors.length" class="q-mt-sm m-maps-layer-errors">
                    <div class="text-caption m-muted">{{t('Not shown')}}</div>
                    <div v-for="layerError in layerErrors" :key="layerError.id" class="row items-start no-wrap q-py-xs" :data-maps-layer-error="layerError.id">
                        <q-icon name="sym_o_error" color="warning" class="q-mr-xs q-mt-xs"></q-icon>
                        <div class="col">
                            <div class="text-body2">{{layerError.label}}</div>
                            <div class="text-caption m-muted">{{layerError.message}}</div>
                        </div>
                        <q-btn dense flat no-caps size="sm" :label="t('Retry')" @click="retry"></q-btn>
                    </div>
                </div>
                <div v-if="effective && effective.featuresTruncated" class="text-caption text-warning q-mt-sm m-maps-truncated">
                    {{t('Only some of the records are shown: zoom in or search to narrow them.')}}
                </div>
                <div v-if="effective && effective.profile && effective.profile.profileName" class="text-caption m-muted q-mt-sm">
                    {{t('Map profile')}}: {{effective.profile.profileName}}
                </div>
            </template>

            <template v-if="panel === 'views'">
                <div v-if="!savedViews.length" class="m-muted">{{t('No saved view yet. Move the map where you want it and choose Save view.')}}</div>
                <q-list dense separator>
                    <q-item v-for="view in savedViews" :key="view.savedViewId" clickable @click="applyView(view)" :data-maps-view="view.savedViewId">
                        <q-item-section avatar><q-icon :name="view.isOwn ? 'sym_o_bookmark' : 'sym_o_group'"></q-icon></q-item-section>
                        <q-item-section>
                            <q-item-label>{{view.description}}</q-item-label>
                            <q-item-label caption>{{view.isOwn ? (view.isShared ? t('Yours, shared') : t('Yours')) : t('Shared by') + ' ' + (view.ownerName || '')}}</q-item-label>
                            <q-item-label v-if="view.explanation" caption class="text-warning">{{view.explanation}}</q-item-label>
                        </q-item-section>
                    </q-item>
                </q-list>
                <a class="text-caption q-mt-sm block" :href="siblingUrl('Views')" @click.prevent="$root.setUrl(siblingUrl('Views'))">{{t('Manage saved views')}}</a>
            </template>

            <template v-if="panel === 'live'">
                <q-btn dense unelevated no-caps color="primary" icon="sym_o_share_location" :label="t('Share my location')" id="MapsShareLocation"
                        @click="openShare"></q-btn>
                <div class="text-caption m-muted q-mt-md">{{t('Shared with me')}}</div>
                <div v-if="!sharedWithMe.length" class="text-caption m-muted" id="MapsSharedNone">{{t('Nobody shares their location with you now.')}}</div>
                <q-list dense separator>
                    <q-item v-for="share in sharedWithMe" :key="share.shareId" :data-maps-shared="share.shareId" :active="liveSelected === share.shareId"
                            active-class="m-tonal">
                        <q-item-section>
                            <q-item-label>{{share.label}}</q-item-label>
                            <q-item-label caption>{{[ageWords(share), t('until') + ' ' + untilText(share.thruDate), share.approximate ? t('approximate, about 1 km') : '']
                                .filter(Boolean).join(' · ')}}</q-item-label>
                            <q-item-label v-if="share.purposeText" caption>{{share.purposeText}}</q-item-label>
                        </q-item-section>
                        <q-item-section side>
                            <div class="row no-wrap">
                                <q-btn dense flat round size="sm" icon="sym_o_my_location" :disable="!share.position" :aria-label="t('Show on map') + ': ' + share.label"
                                        @click="showShare(share)" data-maps-show="true"><q-tooltip>{{t('Show on map')}}</q-tooltip></q-btn>
                                <q-btn v-if="directionsShown" dense flat round size="sm" :icon="phoneApp ? 'sym_o_directions' : 'sym_o_open_in_new'" :disable="!share.position"
                                        :aria-label="(phoneApp ? t('Directions') : t('Open in OpenStreetMap')) + ': ' + share.label" @click="directions(share)" data-maps-directions="true">
                                    <q-tooltip>{{phoneApp ? t('Directions in your maps app') : t('Open in OpenStreetMap: the place goes to openstreetmap.org')}}</q-tooltip></q-btn>
                            </div>
                        </q-item-section>
                    </q-item>
                </q-list>
                <div class="text-caption m-muted q-mt-md">{{t('Who sees my location')}}</div>
                <div v-if="!myShares.length" class="text-caption m-muted" id="MapsMineNone">{{t('You share your location with nobody now.')}}</div>
                <q-card v-for="share in myShares" :key="share.shareId" flat bordered class="q-pa-sm q-mt-xs" :data-maps-mine="share.shareId">
                    <div class="text-body2">{{share.label}}</div>
                    <div class="text-caption m-muted">{{[t('until') + ' ' + untilText(share.thruDate), share.approximate ? t('approximate, about 1 km') : t('exact'),
                        share.keepTrail ? t('trail kept') + ' (' + (share.trailCount || 0) + ' ' + t('points') + ')' : t('no trail kept')].join(' · ')}}</div>
                    <div class="text-caption m-muted">{{t('Last position')}}: {{ageWords(share)}}</div>
                    <q-list dense>
                        <q-item v-for="entry in share.audience" :key="entry.audienceSeqId" class="q-px-none" :data-maps-audience="entry.audienceSeqId">
                            <q-item-section avatar style="min-width:28px"><q-icon :name="audienceIcon(entry)" size="xs"></q-icon></q-item-section>
                            <q-item-section>{{entry.name}}</q-item-section>
                            <q-item-section side>
                                <div class="row no-wrap items-center">
                                    <q-btn v-if="entry.audienceTypeEnumId === 'LsaUserGroup'" dense flat no-caps size="sm" :label="t('Add the group again')"
                                            @click="addGroupAgain(share, entry)" data-maps-readd="true">
                                        <q-tooltip>{{t('Lets in who joined the group since, and leaves out who left it')}}</q-tooltip></q-btn>
                                    <q-btn dense flat round size="sm" icon="close" :aria-label="t('Stop sharing with') + ' ' + entry.name" @click="revokeAudience(share, entry)"></q-btn>
                                </div>
                            </q-item-section>
                        </q-item>
                    </q-list>
                    <div class="row q-gutter-xs q-mt-xs">
                        <q-btn-dropdown dense flat no-caps size="sm" icon="sym_o_more_time" :label="t('Extend')" data-maps-extend="true">
                            <q-list dense>
                                <q-item v-for="option in untilOptions" :key="option.value" clickable v-close-popup @click="extendShare(share, option.value)">
                                    <q-item-section>{{option.label}} {{t('from now')}}</q-item-section>
                                </q-item>
                            </q-list>
                        </q-btn-dropdown>
                        <q-btn v-if="share.keepTrail && share.trailCount" dense flat no-caps size="sm" icon="sym_o_delete" :label="t('Delete trail')" @click="deleteTrail(share)"></q-btn>
                        <q-space></q-space>
                        <q-btn dense flat no-caps size="sm" color="negative" icon="sym_o_location_off" :label="t('Stop')" @click="stopShare(share)"></q-btn>
                    </div>
                </q-card>
                <div class="text-caption m-muted q-mt-sm">{{t('Only you and the people you share with see these: no administrator reads them. A share ends at its time; the server keeps its latest position only, and a trail only when you keep one.')}}</div>
            </template>

            <template v-if="panel === 'edit' && editing">
                <div class="text-body1 text-weight-medium">{{editing.label}}</div>
                <div class="text-caption m-muted" id="MapsEditWhere">{{editing.inPlace
                    ? t('Saving writes a new version of its file; the earlier ones stay in its versions.')
                    : t('Saving writes') + ' ' + editing.editPath + ' ' + t('beside its file, which stays as it is, and the overlay draws that from then on.')}}</div>
                <div class="text-caption m-muted q-mt-sm">{{t('Draw')}}</div>
                <q-btn-toggle v-model="editing.drawType" dense no-caps unelevated toggle-color="primary" :options="drawOptions" @update:model-value="setDraw"
                        id="MapsEditDraw"></q-btn-toggle>
                <div class="text-caption m-muted q-mt-xs">{{editing.drawType
                    ? t('Click the map to place each vertex; a double click ends a line or an area. From the keyboard: Enter on the map adds a vertex at its center.')
                    : t('Click a feature to select it, then drag its vertices to move them (they snap to the other features). From the keyboard: Enter on the map selects the feature at its center, Delete removes it.')}}</div>
                <div v-if="editing.drawType" class="row q-gutter-xs q-mt-xs">
                    <q-btn dense flat no-caps icon="sym_o_add_location" :label="editing.drawType === 'Point' ? t('Add a point at the center') : t('Add a vertex at the center')"
                            @click="editCommand('enter')"></q-btn>
                    <q-btn v-if="editing.drawType !== 'Point'" dense flat no-caps icon="sym_o_done" :label="t('Finish the shape')" :disable="!editState.sketch"
                            @click="editCommand('finish')"></q-btn>
                </div>
                <div v-if="editState.selected" class="q-mt-sm m-tonal q-pa-sm" id="MapsEditSelected">
                    <m-text-line v-model="editLabel" name="editLabel" id="MapsEditLabel" :label="t('Name')" @update:model-value="applyDetails"></m-text-line>
                    <q-input v-model="editDescription" type="textarea" dense outlined autogrow :label="t('Description')" class="q-mt-xs" id="MapsEditDescription"
                            @update:model-value="applyDetails"></q-input>
                    <div class="text-caption m-muted">{{t('Plain text: markup is not kept.')}}</div>
                    <q-btn dense flat no-caps icon="sym_o_delete" :label="t('Delete this feature')" class="q-mt-xs" @click="editCommand('delete')"></q-btn>
                </div>
                <div class="text-caption q-mt-sm">{{editState.count}} {{t('features')}}<span v-if="editState.dirty" class="text-warning"> · {{t('Not saved')}}</span></div>
                <ul v-if="editNotes.length" class="text-caption text-negative q-my-xs q-pl-md" id="MapsEditNotes"><li v-for="note in editNotes" :key="note">{{note}}</li></ul>
                <div class="row justify-end q-mt-sm q-gutter-sm">
                    <q-btn v-if="editStale" dense flat no-caps :label="t('Open it again')" @click="reopenEdit"></q-btn>
                    <q-btn dense flat no-caps :label="t('Close')" @click="stopEdit()"></q-btn>
                    <q-btn dense unelevated no-caps color="primary" :label="t('Save')" :loading="editSaving" :disable="!editState.dirty" @click="saveEdit" id="MapsEditSave"></q-btn>
                </div>
            </template>

            <template v-if="panel === 'details' && selected">
                <div class="text-body1 text-weight-medium">{{selected.label || t('Place')}}</div>
                <div class="text-caption m-muted" v-if="selectedLayerLabel">{{selectedLayerLabel}}</div>
                <div v-if="selected.description" class="text-body2 q-mt-xs m-maps-description" style="white-space:pre-line;overflow-wrap:anywhere">{{selected.description}}</div>
                <div class="q-mt-xs" style="font-family:var(--m-font-mono)">{{coordinates(selected)}}</div>
                <div class="text-caption m-muted" v-if="selected.precision">{{selected.precision}}</div>
                <div class="text-caption m-muted" v-if="selected.source">{{selected.source}}</div>
                <div v-if="selectedLinks.length" class="column items-start q-mt-xs m-maps-record-links">
                    <a v-for="link in selectedLinks" :key="link.url" :href="link.url" class="text-primary">{{link.label}}</a>
                </div>
                <q-btn dense flat no-caps icon="sym_o_content_copy" :label="t('Copy coordinates')" class="q-mt-sm" @click="copy(selected)"></q-btn>
                <q-btn v-if="!selected.placeId" dense flat no-caps icon="sym_o_star" :label="t('Save place')" class="q-mt-sm" id="MapsSavePlace" @click="openSavePlace"></q-btn>
                <q-btn v-if="selected.placeId && selected.isOwn" dense flat no-caps icon="sym_o_delete" :label="t('Remove place')" class="q-mt-sm" @click="removePlace(selected)"></q-btn>
            </template>
        </component>

        <div class="col" ref="mapHolder" style="min-width:0">
            <m-map v-if="mapConfig" ref="map" id="MapsBrowseMap" :config="mapConfig" :height="mapPx + 'px'" @select="onSelect" @view-change="onViewChange"
                    @edit-change="onEditChange" @live-change="onLiveChange"></m-map>
            <div v-else class="flex flex-center" :style="{height: mapPx + 'px'}"><q-spinner size="2em"></q-spinner></div>
        </div>
    </div>

    <m-dialog v-model="saveShown" :title="t('Save view')" width="440">
        <div>
            <m-text-line v-model="saveName" name="description" id="MapsSaveName" :label="t('Name')"></m-text-line>
            <div class="q-mt-sm">
                <q-btn-toggle v-model="saveShared" dense no-caps unelevated toggle-color="primary"
                        :options="[{label: t('Only me'), value: 'N'}, {label: t('Every Maps user'), value: 'Y'}]"></q-btn-toggle>
            </div>
            <div class="text-caption m-muted q-mt-xs">{{t('The view keeps where the map is, its basemap and the layers shown.')}}</div>
            <div class="row justify-end q-mt-md q-gutter-sm">
                <q-btn flat dense no-caps :label="t('Cancel')" @click="saveShown = false"></q-btn>
                <q-btn dense unelevated no-caps color="primary" :label="t('Save view')" :loading="saving" :disable="!saveName.trim()" @click="saveView"></q-btn>
            </div>
        </div>
    </m-dialog>

    <m-dialog v-model="addShown" :title="t('Add overlay')" width="480">
        <div>
            <div class="text-caption m-muted">{{t('A GeoJSON, TopoJSON, EsriJSON, GPX, KML, GML, WKT, WKB or CSV file, or a shapefile zipped with its .dbf and .prj, of at most 10 MB, in WGS84, Web Mercator or a registered projection (UTM, the British National Grid and others an administrator adds), converted to WGS84. It is kept in Maps/overlays of your files, checked, and drawn only by this server: links, icons and scripts in it are not followed.')}}</div>
            <q-file v-model="addFile" dense outlined clearable :accept="OVERLAY_ACCEPT" :label="t('Upload a file')" class="q-mt-sm" id="MapsOverlayFile" @update:model-value="addOffer = false"></q-file>
            <div v-if="picker.drives.length" class="q-mt-sm" id="MapsOverlayPicker">
                <div class="text-caption m-muted">{{t('Or a file of a drive you may open')}}</div>
                <div class="row items-center q-gutter-xs">
                    <q-chip v-for="drive in picker.drives" :key="drive.driveId" dense square clickable
                            :class="picker.driveId === drive.driveId && !picker.searching ? 'm-tonal text-primary' : ''"
                            :aria-pressed="picker.driveId === drive.driveId && !picker.searching ? 'true' : 'false'"
                            @click="pickerOpen(drive.driveId, '')">{{drive.driveName}}</q-chip>
                </div>
                <div class="q-mt-xs" @keydown.enter.prevent="pickerSearch"><m-text-line v-model="picker.text" name="pickerText" id="MapsOverlayPickerText" :label="t('Search files')"></m-text-line></div>
                <div v-if="!picker.searching" class="row items-center no-wrap q-mt-xs" style="overflow:hidden">
                    <template v-for="(crumb, index) in picker.crumbs" :key="index">
                        <q-icon v-if="index" name="chevron_right" size="xs" class="m-muted"></q-icon>
                        <q-btn flat dense no-caps size="sm" @click="pickerOpen(picker.driveId, crumb.path)">{{crumb.name}}</q-btn>
                    </template>
                </div>
                <div v-else class="text-caption m-muted q-mt-xs">{{picker.text ? t('Found') : t('Recent files')}}</div>
                <q-list dense bordered separator style="max-height:200px" class="scroll">
                    <q-item v-if="picker.loading"><q-item-section class="text-center"><q-spinner></q-spinner></q-item-section></q-item>
                    <q-item v-for="row in picker.rows" :key="pickerKey(row)" clickable @click="pickerClick(row)"
                            :active="!row.isDirectory && addPick && pickerKey(addPick) === pickerKey(row)" active-class="m-tonal text-primary"
                            :data-maps-pick="row.path">
                        <q-item-section avatar><q-icon :name="row.icon || (row.isDirectory ? 'sym_o_folder' : 'sym_o_draft')"></q-icon></q-item-section>
                        <q-item-section>
                            <q-item-label class="ellipsis">{{row.name}}</q-item-label>
                            <q-item-label caption class="ellipsis" v-if="pickerCaption(row)">{{pickerCaption(row)}}</q-item-label>
                        </q-item-section>
                    </q-item>
                    <q-item v-if="!picker.loading && !picker.rows.length"><q-item-section class="text-caption m-muted">{{t('No geographic file here')}}</q-item-section></q-item>
                </q-list>
            </div>
            <m-text-line v-model="addLabel" name="label" id="MapsOverlayLabel" :label="t('Name (the file name when empty)')" class="q-mt-sm"></m-text-line>
            <div v-if="addOffer" class="q-mt-sm m-tonal q-pa-sm" id="MapsOverlayGeneralizeOffer">
                <div class="text-caption">{{t('This file has more than a map draws at once. This server can simplify it for each zoom into a tiled copy kept beside the file, drawn in its place; the file itself is not changed.')}}</div>
                <q-btn dense unelevated no-caps color="primary" class="q-mt-xs" :label="t('Simplify on the server')" :loading="adding" id="MapsOverlayGeneralize" @click="addOverlay(true)"></q-btn>
            </div>
            <div class="row justify-end q-mt-md q-gutter-sm">
                <q-btn flat dense no-caps :label="t('Cancel')" @click="addShown = false"></q-btn>
                <q-btn dense unelevated no-caps color="primary" :label="t('Add overlay')" :loading="adding" :disable="!addFile && !addPick" @click="addOverlay"></q-btn>
            </div>
        </div>
    </m-dialog>

    <m-dialog v-model="placeShown" :title="t('Save place')" width="440">
        <div>
            <m-text-line v-model="placeName" name="placeName" id="MapsPlaceName" :label="t('Name')"></m-text-line>
            <div class="text-caption m-muted q-mt-xs">{{t('Your places are a file of your files, Maps/places.geojson: private until you share it there.')}}</div>
            <div class="row justify-end q-mt-md q-gutter-sm">
                <q-btn flat dense no-caps :label="t('Cancel')" @click="placeShown = false"></q-btn>
                <q-btn dense unelevated no-caps color="primary" :label="t('Save place')" :loading="saving" :disable="!placeName.trim()" @click="savePlace"></q-btn>
            </div>
        </div>
    </m-dialog>

    <!-- Share my location (plans/Location-Sharing.md §3.3): who sees it, until when, exact or approximate, a trail or not;
        started only by this act, sent from this page while it is open; a guest link (its page's link, the secret in the fragment) shown once -->
    <m-dialog v-model="shareShown" :title="t('Share my location')" width="480">
        <div id="MapsShareDialog">
            <template v-if="shareMade">
                <div class="text-body2">{{t('Your location is shared until')}} {{untilText(shareMade.thruDate)}}. {{t('This page sends it while it is open; close it and the people you chose see how old the last position is.')}}</div>
                <div v-if="shareMade.linkUrl" class="q-mt-sm m-tonal q-pa-sm" id="MapsShareLinkToken">
                    <div class="text-caption">{{t('The guest link, shown this once: send it now to whom it is for. Anyone with it sees where you are until the share ends.')}}</div>
                    <div class="row items-center no-wrap q-mt-xs">
                        <code class="col" style="overflow-wrap:anywhere">{{shareMade.linkUrl}}</code>
                        <q-btn dense flat round icon="sym_o_content_copy" :aria-label="t('Copy')" @click="copyText(shareMade.linkUrl)"></q-btn>
                    </div>
                </div>
                <div class="row justify-end q-mt-md"><q-btn dense unelevated no-caps color="primary" :label="t('Done')" @click="shareShown = false"></q-btn></div>
            </template>
            <template v-else>
                <q-select v-model="shareForm.users" multiple use-input use-chips dense outlined :options="shareUserOptions" @filter="filterShareUsers"
                        :label="t('People')" input-debounce="250" id="MapsShareUsers">
                    <template v-slot:no-option><q-item><q-item-section class="text-caption m-muted">{{t('Type a name')}}</q-item-section></q-item></template>
                </q-select>
                <q-select v-if="shareTargets.groups.length" v-model="shareForm.groups" multiple use-chips dense outlined emit-value map-options class="q-mt-sm"
                        :options="shareTargets.groups" option-value="userGroupId" option-label="label" :label="t('Groups you are in')" id="MapsShareGroups"></q-select>
                <div v-if="shareForm.groups.length" class="text-caption m-muted">{{t('A group is seen by its members now; someone who joins later sees it once you add the group again.')}}</div>
                <q-select v-if="shareTargets.xmpp" v-model="shareForm.jids" multiple use-chips dense outlined emit-value map-options class="q-mt-sm"
                        :options="shareTargets.contacts" option-value="jid" option-label="label" :label="t('XMPP contacts')" id="MapsShareJids"></q-select>
                <q-toggle v-model="shareForm.link" dense :label="t('A guest link (its token is shown once)')" class="q-mt-sm" id="MapsShareLink"></q-toggle>
                <div class="text-caption m-muted q-mt-sm">{{t('Until')}}</div>
                <q-btn-toggle v-model="shareForm.hours" dense no-caps unelevated toggle-color="primary" :options="untilOptions" id="MapsShareUntil"></q-btn-toggle>
                <div class="text-caption m-muted q-mt-sm">{{t('Where you are')}}</div>
                <q-btn-toggle v-model="shareForm.precision" dense no-caps unelevated toggle-color="primary" id="MapsSharePrecision"
                        :options="[{label: t('Exact'), value: 'LspExact'}, {label: t('Approximate, about 1 km'), value: 'LspApproximate'}]"></q-btn-toggle>
                <q-toggle v-model="shareForm.keepTrail" dense class="q-mt-sm" id="MapsShareTrail"
                        :label="t('Keep a trail') + ' (' + t('up to') + ' ' + shareTargets.trailMaxDays + ' ' + t('days after it ends; you can delete it') + ')'"></q-toggle>
                <m-text-line v-model="shareForm.label" name="shareLabel" id="MapsShareLabel" :label="t('Name they see (your name when empty)')" class="q-mt-sm"></m-text-line>
                <div v-if="shareError" class="text-negative text-caption q-mt-xs" role="alert">{{shareError}}</div>
                <div class="text-caption m-muted q-mt-sm">{{t('Each person is told that you share with them and until when. Nothing else starts a share, and you can stop it at once.')}}</div>
                <div class="row justify-end q-mt-md q-gutter-sm">
                    <q-btn flat dense no-caps :label="t('Cancel')" @click="shareShown = false"></q-btn>
                    <q-btn dense unelevated no-caps color="primary" icon="sym_o_share_location" :label="t('Share')" :loading="shareSaving" :disable="!shareAudience.length"
                            @click="createShare" id="MapsShareCreate"></q-btn>
                </div>
            </template>
        </div>
    </m-dialog>
</div></template>

<script>
const t = (text) => (moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text);
const OVERLAY_ACCEPT = '.geojson,.json,.topojson,.esrijson,.gpx,.kml,.gml,.wkt,.wkb,.csv,.tsv,.zip';
// the shares of the user's own that this tab sends while their page is open (a per-tab convenience: the share itself is
// the server's), in session storage under a key of the account (moqui.scopedKey: the desktop client's account too)
const SENDING_PREFIX = 'moqui.maps.sendingShares.';
// the session the stored list belongs to: the page's session token, which a sign-in anew changes
// stored as its SHA-256 (crypto.subtle; none in an insecure context, where nothing is stored), never the token itself
const sessionToken = () => String((moqui.webrootVue && moqui.webrootVue.moquiSessionToken) || moqui.sessionToken || '');
const sessionDigest = () => {
    const subtle = window.crypto && window.crypto.subtle;
    const token = sessionToken();
    if (!subtle || !token || !window.TextEncoder) return Promise.resolve(null);
    return subtle.digest('SHA-256', new TextEncoder().encode(token)).then((bytes) => Array.from(new Uint8Array(bytes))
        .map((byte) => byte.toString(16).padStart(2, '0')).join(''), () => null);
};
// the key of the live-location indicator in the shell's app bar (LocationShares.js indicator, the framework's provider)
const INDICATOR_KEY = 'locationSharing';
const sendingKey = () => {
    const userId = moqui.webrootVue && moqui.webrootVue.userId;
    return userId ? moqui.scopedKey(SENDING_PREFIX + userId) : null;
};
// the shell's before-logout hook (moqui.beforeLogoutHooks): every account's list of this tab forgotten at a sign-out
const forgetSending = () => {
    try {
        const prefix = moqui.scopedKey(SENDING_PREFIX);
        Object.keys(window.sessionStorage).filter((key) => key.startsWith(prefix)).forEach((key) => window.sessionStorage.removeItem(key));
    } catch (err) { /* no storage */ }
};
const PRECISION = { GPP_USER_CONFIRMED: 'User-confirmed point', GPP_ADDRESS_MATCH: 'Address match', GPP_STREET_RANGE: 'Street-range interpolation',
    GPP_POSTAL_AREA: 'Postal-area representative point', GPP_PLACE_ESTIMATE: 'Place estimate' };

module.exports = {
    name: 'MapsBrowse',
    inject: { mScreen: { default: null } },
    data() {
        return { effective: null, error: '', panel: '', query: '', results: [], postalCountries: [], postalCountry: null, postalNote: '', searching: false, savedViews: [], hidden: {}, basemapId: '',
            view: null, lastView: null, marker: null, selected: null, mapPx: 480, phone: false, fullscreen: false, saveShown: false,
            saveName: '', saveShared: 'N', saving: false, restoreLastView: false, geocoder: null, overture: null, addShown: false, addFile: null, addPick: null,
            addLabel: '', adding: false, addOffer: false, placeShown: false, placeName: '', OVERLAY_ACCEPT,
            editing: null, editState: { count: 0, dirty: false, selected: null, sketch: 0 }, editLabel: '', editDescription: '', editNotes: [],
            editSaving: false, editLoading: false, editStale: false,
            rasters: {}, bandLayerId: '', bandForm: { mode: 'rgb', rgb: [1, 2, 3], band: 1, colormap: 'grey', min: '', max: '', nodata: '' }, bandError: '', bandSaving: false,
            picker: { drives: [], driveId: null, crumbs: [], rows: [], loading: false, text: '', searching: false },
            // live location (plans/Location-Sharing.md §3.3): m-map's shares as it holds them (live-change), the page's clock for
            // ages, the shares this page sends and the newest position the browser gave
            live: null, liveGone: [], liveSelected: '', sharesNotice: '', sessionHash: null, now: Date.now(), sending: [], sendInfo: {}, sendNotes: {}, geoError: '', sendError: '',
            // the shares the Android app's location service sends from this phone (plans/Location-Sharing.md §3.4)
            nativeSending: [],
            shareShown: false, shareSaving: false, shareError: '', shareMade: null, shareUserOptions: [],
            shareForm: { users: [], groups: [], jids: [], link: false, hours: 1, precision: 'LspExact', keepTrail: false, label: '' },
            shareTargets: { loaded: false, groups: [], xmpp: false, contacts: [], maxShareHours: 24, trailMaxDays: 30,
                minIntervalSeconds: 5, approximateIntervalSeconds: 60 } };
    },
    computed: {
        screenPath() { return this.mScreen ? this.mScreen.path : this.$root.basePath + '/' + this.$root.currentPathList.join('/'); },
        parameters() { return this.$root.currentParameters || {}; },
        fullscreenAvailable() { return !!document.fullscreenEnabled; },
        basemaps() { return this.effective && this.effective.profile ? this.effective.profile.basemaps || [] : []; },
        overlays() { return this.effective ? (this.effective.layers || []).filter((layer) => layer && typeof layer === 'object') : []; },
        recordLayers() { return this.effective ? this.effective.recordLayers || [] : []; },
        // the user's own and shared overlays (find#Overlays, after the profile's layers), apart from the profile's
        personalOverlays() { return this.overlays.filter((layer) => layer.overlayId); },
        profileOverlays() { return this.overlays.filter((layer) => !layer.overlayId); },
        layerErrors() { return this.effective ? this.effective.layerErrors || [] : []; },
        // the COG layer whose bands are being chosen, and its choices
        bandLayer() { return this.bandLayerId ? this.overlays.find((layer) => layer.id === this.bandLayerId && layer.kind === 'cog' && layer.raster) || null : null; },
        bandOptions() {
            const count = this.bandLayer ? Number(this.bandLayer.raster.bands) || 1 : 1;
            return Array.from({ length: Math.min(count, 64) }, (unused, index) => ({ label: t('Band') + ' ' + (index + 1), value: index + 1 }));
        },
        colormapOptions() { return [{ label: t('Grey'), value: 'grey' }, { label: 'Viridis', value: 'viridis' }, { label: t('Terrain'), value: 'terrain' }, { label: 'Magma', value: 'magma' }]; },
        problemCount() { return this.layerErrors.length + (this.effective && this.effective.featuresTruncated ? 1 : 0); },
        panelTitle() {
            return { search: t('Search results'), layers: t('Layers'), views: t('Saved views'), details: t('Selected'), edit: t('Edit'), live: t('Live location') }[this.panel] || '';
        },
        // the configuration's shares (getConfig, locationShares) with what m-map holds of each since (its pushes: a newer
        // position, a new end; one it took off, ended or revoked, is gone here too), and none past its end
        locationShares() {
            const given = this.effective ? this.effective.locationShares || [] : [];
            const live = this.live || [];
            return given.map((share) => {
                const held = live.find((one) => one.shareId === share.shareId) || null;
                if (this.liveGone.includes(share.shareId)) return null;
                const latest = share.latest || null;
                const position = held && held.latest ? { lat: held.latest.lat, lon: held.latest.lon }
                    : latest && latest.latitude !== null && latest.latitude !== undefined ? { lat: Number(latest.latitude), lon: Number(latest.longitude) } : null;
                const seenAt = held ? held.seenAt : latest && typeof latest.seenAt === 'number' ? latest.seenAt : null;
                return Object.assign({}, share, { position, seenAt, thruDate: held && held.thruDate ? held.thruDate : share.thruDate });
            }).filter((share) => share && (!share.thruDate || share.thruDate > this.now));
        },
        myShares() { return this.locationShares.filter((share) => share.role === 'owner'); },
        // a banner for each active share of the user's own, and for each share this page sends whatever the last read said
        // (one just started, before its read; one a failed read left out)
        banners() {
            const listed = this.myShares.map((share) => share.shareId);
            return this.myShares.concat(this.sending.filter((id) => !listed.includes(id)).map((id) => Object.assign({ shareId: id, position: null, seenAt: null },
                this.sendInfo[id] || {})));
        },
        // the Android app, whose openExternal hands a geo: link to the phone's maps app (as Chat's Open in maps tells it)
        phoneApp() {
            const desktop = window.moquiDesktop;
            return !!(desktop && typeof desktop.openExternal === 'function' && (typeof desktop.dialAccount === 'function' || !!desktop.location));
        },
        // OpenStreetMap is offered only while this server lets a page reach outside hosts (maps@external-requests)
        outsideAllowed() { return !(this.effective && this.effective.externalRequests === false); },
        directionsShown() { return this.phoneApp || this.outsideAllowed; },
        sharedWithMe() { return this.locationShares.filter((share) => share.role !== 'owner'); },
        // the ends offered, within location@max-share-hours
        untilOptions() {
            return [0.25, 1, 2, 8, 24].filter((hours) => hours <= this.shareTargets.maxShareHours)
                .map((hours) => ({ label: hours < 1 ? Math.round(hours * 60) + ' ' + t('min') : hours + ' ' + t('h'), value: hours }));
        },
        // the audience the dialog sends: people, groups, XMPP contacts and a link, as create#Share takes them
        shareAudience() {
            const form = this.shareForm;
            return form.users.map((user) => ({ audienceTypeEnumId: 'LsaUser', userId: user.value }))
                .concat(form.groups.map((userGroupId) => ({ audienceTypeEnumId: 'LsaUserGroup', userGroupId })))
                .concat(form.jids.map((jid) => ({ audienceTypeEnumId: 'LsaXmpp', jid })))
                .concat(form.link ? [{ audienceTypeEnumId: 'LsaLink' }] : []);
        },
        // a saved place is a point: its file draws nothing else
        drawOptions() {
            const none = { label: t('Select'), value: '' };
            const point = { label: t('Point'), value: 'Point' };
            return this.editing && this.editing.isPlaces ? [none, point] : [none, point, { label: t('Line'), value: 'LineString' }, { label: t('Area'), value: 'Polygon' }];
        },
        sheetStyle() { return { position: 'fixed', left: '0', right: '0', bottom: '0', maxHeight: '55vh', zIndex: 2000 }; },
        // the record's links a registered route resolved to a screen the user may open (get#EffectiveConfig), on its place
        selectedLinks() {
            return this.selected && this.selected.isRecord === true && this.effective && this.effective.record ? this.effective.record.resolvedLinks || [] : [];
        },
        selectedLayerLabel() {
            if (!this.selected || !this.selected.layerId) return '';
            const layer = this.recordLayers.concat(this.overlays).find((one) => one.id === this.selected.layerId);
            return layer ? layer.label : '';
        },
        // what m-map draws: the effective configuration with the layers shown or hidden here, the basemap chosen, the view
        // last gone to and a result's marker; the layer errors and a cut list are this panel's, not the map's
        mapConfig() {
            const config = this.effective;
            if (!config) return null;
            const out = Object.assign({}, config, { layerErrors: [], featuresTruncated: false });
            out.profile = Object.assign({}, config.profile || {}, this.basemapId ? { basemap: this.basemapId } : {});
            out.layers = this.overlays.map((layer) => Object.assign({}, layer, { visible: this.layerShown(layer) },
                layer.kind === 'cog' && layer.raster && this.rasters[layer.id] ? { raster: Object.assign({}, layer.raster, { style: this.rasters[layer.id] }) } : {}));
            if (config.features && Array.isArray(config.features.features)) {
                out.features = Object.assign({}, config.features, { features: config.features.features.filter((feature) =>
                    !(feature.properties && feature.properties.layerId && this.hidden[feature.properties.layerId])) });
            }
            out.points = (config.points || []).concat(this.marker ? [this.marker] : []);
            if (this.view) {
                delete out.center; delete out.zoom; delete out.extent;
                Object.assign(out, this.view);
            }
            return out;
        }
    },
    watch: {
        // another record or place: the layer choices start again from the profile's
        parameters: { deep: true, handler(value, before) { if (JSON.stringify(value) !== JSON.stringify(before)) { this.hidden = {}; this.load(); } } },
        // a share of the user's own that ended (stopped, past its end, or ended elsewhere) is no longer sent; the banners
        // above the map change its height
        banners(value, before) { if (value.length !== (before || []).length) this.$nextTick(() => this.measure()); },
        myShares(value, before) {
            if (this.mineReadFailed) return;
            const ids = value.map((share) => share.shareId);
            const had = (before || []).map((share) => share.shareId);
            this.sending.filter((id) => had.includes(id) && !ids.includes(id)).forEach((id) => this.stopSending(id));
            this.nativeSending.filter((id) => had.includes(id) && !ids.includes(id)).forEach((id) => this.stopNative(id));
        }
    },
    methods: {
        t,
        // the extent parameter (a dashboard geomap's country): "west,south,east,north" in WGS84 degrees, each longitude
        // within -180 to 180 and west greater than east across the antimeridian, south at most north; null otherwise
        extentParameter(text) {
            const box = String(text ?? '').split(',').map((value) => value.trim() === '' ? NaN : Number(value));
            const lonOk = (lon) => lon >= -180 && lon <= 180;
            return box.length === 4 && box.every(Number.isFinite) && lonOk(box[0]) && lonOk(box[2]) && box[1] >= -90 && box[3] <= 90
                && box[1] <= box[3] ? box : null;
        },
        siblingUrl(name) { return this.screenPath.replace(/\/[^/]*$/, '/' + name); },
        request(name, options) {
            return moqui.request(this.screenPath + '/' + name, options || {}).then((result) => {
                const json = result.json || {};
                if (json.errors) throw new Error(json.errors);
                return json;
            });
        },
        precisionText(id) { return PRECISION[id] ? t(PRECISION[id]) : ''; },
        resultIcon(result) {
            return { savedView: 'sym_o_bookmark', postal: 'sym_o_markunread_mailbox', postalPlace: 'sym_o_markunread_mailbox', place: 'sym_o_star',
                geocoder: 'sym_o_travel_explore', overture: 'sym_o_storefront' }[result.kind] || 'sym_o_location_on';
        },
        attributionText(value) { return String(value || '').split(/\s*\n\s*/).filter(Boolean).join(', '); },
        overlayCaption(layer) {
            const owner = layer.isOwn ? (layer.isPlaces ? t('Your places') : t('Yours')) : t('Shared by') + ' ' + (layer.ownerName || '');
            const tiles = !layer.tilesStatus ? null : this.tilesBusy(layer) ? t('Simplifying on the server') + ' ' + (layer.tilesProgress || 0) + '%'
                : layer.tilesStatus === 'ready' ? t('Simplified for drawing') : layer.tilesStatus === 'cancelled' ? t('Simplifying cancelled')
                : t('Not simplified') + (layer.tilesNote ? ': ' + layer.tilesNote : '');
            return [owner, layer.featureCount + ' ' + t('features'), tiles].filter(Boolean).join(' · ');
        },
        coordinates(place) { return Number(place.lat).toFixed(5) + ', ' + Number(place.lon).toFixed(5); },
        // ---- a COG layer's bands (P4c) ----
        rasterStyle(layer) { return this.rasters[layer.id] || (layer.raster && layer.raster.style) || null; },
        rasterCaption(layer) {
            const style = this.rasterStyle(layer);
            const what = !style ? '' : style.rgb ? t('bands') + ' ' + style.rgb.join(', ') + ' ' + t('as red, green, blue')
                : t('band') + ' ' + style.band + ' · ' + style.colormap;
            return [layer.raster.bands + ' ' + t('bands of') + ' ' + (layer.raster.sampleType || '?'), what].filter(Boolean).join(' · ');
        },
        openBands(layer) {
            if (this.bandLayerId === layer.id) { this.bandLayerId = ''; return; }
            const style = this.rasterStyle(layer) || {};
            const count = Number(layer.raster.bands) || 1;
            this.bandForm = { mode: style.rgb ? 'rgb' : 'single', rgb: style.rgb ? style.rgb.slice() : [1, Math.min(2, count), Math.min(3, count)],
                band: style.band || 1, colormap: style.colormap || 'grey', min: style.min !== undefined ? String(style.min) : '',
                max: style.max !== undefined ? String(style.max) : '', nodata: style.nodata !== undefined && style.nodata !== null ? String(style.nodata) : '' };
            this.bandError = '';
            this.bandLayerId = layer.id;
        },
        // the settings drawn at once and kept as the user's own; refused ones say why and change nothing
        applyBands() {
            const layer = this.bandLayer;
            if (!layer) return;
            const form = this.bandForm;
            const min = Number(form.min), max = Number(form.max);
            if (String(form.min).trim() === '' || String(form.max).trim() === '' || !Number.isFinite(min) || !Number.isFinite(max) || !(min < max)) {
                this.bandError = t('Give a minimum below the maximum');
                return;
            }
            const style = form.mode === 'rgb' ? { rgb: form.rgb.map(Number), min, max } : { band: Number(form.band), colormap: form.colormap, min, max };
            if (String(form.nodata).trim() !== '') {
                const nodata = Number(form.nodata);
                if (!Number.isFinite(nodata)) { this.bandError = t('The no-data value is a number'); return; }
                style.nodata = nodata;
            }
            this.storeBands(layer, style);
        },
        resetBands() { if (this.bandLayer) this.storeBands(this.bandLayer, null); },
        storeBands(layer, style) {
            this.bandError = '';
            this.bandSaving = true;
            this.request('rasterBands', { method: 'POST', params: { layerId: layer.id, bands: JSON.stringify(style) } }).then((json) => {
                if (json.applied === false) { this.bandError = json.reason || t('The band settings were not kept'); return; }
                this.keepView();
                const next = Object.assign({}, this.rasters);
                if (style) next[layer.id] = style;
                else delete next[layer.id];
                this.rasters = next;
                // back to its defaults: the configuration's style is the user's no longer
                if (!style) this.load();
                this.bandLayerId = '';
            }, (err) => { this.bandError = String(err && err.message || err); }).then(() => { this.bandSaving = false; });
        },
        layerShown(layer) { return this.hidden[layer.id] !== undefined ? !this.hidden[layer.id] : layer.visible !== false; },
        // the parameters a configuration is asked with: the page's record, and the layers to show (a hidden record layer's
        // adapter was not asked, so showing one asks for the configuration again with it)
        configParameters(extraLayerId) {
            const p = this.parameters;
            const out = {};
            ['profileId', 'adapterKey', 'recordKey', 'addressPurpose', 'routeApp'].forEach((key) => { if (p[key]) out[key] = p[key]; });
            if (extraLayerId) {
                // a user's overlay is not the profile's layer: getConfig lists it itself
                const shown = this.profileOverlays.concat(this.recordLayers).filter((layer) => this.layerShown(layer)).map((layer) => layer.id);
                out.layerIds = shown.concat([extraLayerId]).join(',');
            }
            return out;
        },
        load(extraLayerId) {
            this.error = '';
            const asked = typeof extraLayerId === 'string' ? extraLayerId : '';
            const readAt = Date.now();
            return this.request('getConfig', { params: this.configParameters(asked) }).then((config) => {
                if (this.closed) return;
                const mineFailed = config.locationSharesMineFailed === true;
                this.sharesReadFailed(mineFailed);
                config.locationShares = this.mergeRead(this.stampShares(config.locationShares, Date.now()), mineFailed, config.locationSharesTheirsFailed === true);
                this.mineReadFailed = mineFailed;
                this.effective = config;
                // a failed read of the user's own shares neither stops nor resumes sending: the next good read decides
                if (!mineFailed) {
                    this.pruneSending(config.locationShares, readAt);
                    this.restoreSending();
                }
                // panel=live (the app bar's "Sharing location" chip): Who sees my location, once for each time it is asked
                if (this.parameters.panel !== this.panelAsked) {
                    this.panelAsked = this.parameters.panel;
                    if (this.parameters.panel === 'live') this.panel = 'live';
                }
                this.watchTiles();
                const p = this.parameters;
                const lon = Number(p.longitude), lat = Number(p.latitude);
                if (p.longitude !== undefined && p.latitude !== undefined && String(p.longitude).trim() && String(p.latitude).trim()
                        && lon >= -180 && lon <= 180 && lat >= -90 && lat <= 90 && !this.marker) {
                    this.marker = { id: 'given', lon, lat, label: String(p.label || '') };
                    this.view = { center: [lon, lat], zoom: 14 };
                }
                // an area to open on (a dashboard geomap's country): west,south,east,north, with no marker; west greater than
                // east crosses the antimeridian (Russia), as m-map fits it. Checked here, not by moqui.map: WebrootMap.js
                // loads only as m-map mounts, after this first view is set
                const box = this.extentParameter(p.extent);
                if (!this.view && !this.marker && box) this.view = { extent: box };
            }, (err) => { this.error = t('The map settings did not load') + ': ' + (err && err.message || err); });
        },
        loadViews() {
            return this.request('savedViews').then((json) => {
                this.savedViews = json.savedViewList || [];
                const wanted = this.parameters.savedViewId;
                if (wanted) {
                    const view = this.savedViews.find((one) => String(one.savedViewId) === String(wanted));
                    if (view) this.applyView(view);
                }
            }, () => { this.savedViews = []; });
        },
        loadPreferences() {
            this.request('preferences').then((json) => { this.restoreLastView = !!json.restoreLastView; }, () => { this.restoreLastView = false; });
        },
        togglePanel(name) { this.panel = this.panel === name ? '' : name; },
        // a layer that was not shown, asked for again: the layers shown or hidden here, and the view, stay as they are
        retry() {
            this.keepView();
            this.load();
        },
        shownLayerIds() { return this.overlays.concat(this.recordLayers).filter((layer) => this.layerShown(layer)).map((layer) => layer.id); },
        runSearch() {
            const query = (this.query || '').trim();
            if (!query) return;
            this.panel = 'search';
            this.searching = true;
            // the layers shown and the view on screen bound the records searched
            const params = { q: query };
            if (this.parameters.profileId) params.profileId = this.parameters.profileId;
            const shown = this.shownLayerIds().filter((id) => !id.startsWith('overlay:'));
            if (shown.length) params.layerIds = shown.join(',');
            if (this.lastView && Array.isArray(this.lastView.extent)) params.extent = this.lastView.extent.join(',');
            if (this.postalCountry) params.country = this.postalCountry;
            this.request('search', { params }).then((json) => {
                this.results = json.results || [];
                this.postalCountries = json.countries || [];
                // the country searched, shown in the selector unless the code was found in more than one
                if (!this.postalCountry && json.countryGeoId && !json.ambiguous && this.postalCountries.some((one) => one.geoId === json.countryGeoId)) this.postalCountry = json.countryGeoId;
                this.postalNote = json.reason || '';
                this.geocoder = json.geocoder || null;
                this.overture = json.overture || null;
            }, (err) => {
                this.results = [];
                this.error = t('The search did not run') + ': ' + (err && err.message || err);
            }).then(() => { this.searching = false; });
        },
        goToResult(result) {
            if (result.kind === 'savedView') { this.applyView({ view: result.view }); return; }
            if (result.lon === null || result.lon === undefined) return;
            this.marker = { id: 'result', lon: Number(result.lon), lat: Number(result.lat), label: result.label };
            // an approximate place (a postal area) shows its broad extent, never a close zoom on a point it does not know
            this.view = Array.isArray(result.extent) ? { extent: result.extent } : { center: [Number(result.lon), Number(result.lat)], zoom: 14 };
            this.selected = { label: result.label, lon: Number(result.lon), lat: Number(result.lat), layerId: result.layerId,
                precision: result.precisionText || this.precisionText(result.precisionEnumId), source: result.sourceText,
                placeId: result.placeId || null, isOwn: !!result.isOwn };
            this.panel = 'details';
        },
        applyView(row) {
            const view = row.view || {};
            if (Array.isArray(view.extent)) this.view = { extent: view.extent };
            else if (Array.isArray(view.center)) this.view = Object.assign({ center: view.center }, view.zoom !== undefined && view.zoom !== null ? { zoom: view.zoom } : {});
            if (view.basemap && this.basemaps.some((basemap) => basemap.id === view.basemap)) this.basemapId = view.basemap;
            // its COG layers' band settings, for this session (each still checked against the layer's bands when drawn)
            if (view.rasters && typeof view.rasters === 'object') this.rasters = Object.assign({}, this.rasters, view.rasters);
            if (Array.isArray(view.layers) && view.layers.length) {
                const wanted = new Set(view.layers);
                const hidden = {};
                this.overlays.concat(this.recordLayers).forEach((layer) => { hidden[layer.id] = !wanted.has(layer.id); });
                this.hidden = hidden;
                const missing = this.recordLayers.find((layer) => wanted.has(layer.id) && layer.visible === false);
                if (missing) this.load(missing.id);
            }
            if (this.phone) this.panel = '';
        },
        // the view stays where it is when the map draws again
        keepView() { if (this.lastView) this.view = { center: this.lastView.center, zoom: this.lastView.zoom }; },
        chooseBasemap(id) { this.keepView(); this.basemapId = id; },
        toggleLayer(layer) {
            this.keepView();
            const shown = this.layerShown(layer);
            this.hidden = Object.assign({}, this.hidden, { [layer.id]: shown });
            // a record layer that was hidden when the configuration was read has no features yet: ask for them
            if (!shown && layer.adapterKey && layer.visible === false && !(this.effective.features && (this.effective.features.features || [])
                    .some((feature) => feature.properties && feature.properties.layerId === layer.id))) this.load(layer.id);
        },
        onSelect(place) {
            // a live share's marker: the Live location panel, with that share marked
            if (place.kind === 'liveShare') { this.liveSelected = place.shareId; this.panel = 'live'; return; }
            // an overlay's feature: its label and description (plain text, shown as text), its overlay and where it is; a
            // place of the user's own places file can be removed
            if (place.kind === 'overlay') {
                const layer = this.overlays.find((one) => one.id === place.layerId) || {};
                this.selected = { id: place.id, label: place.label, lon: place.lon, lat: place.lat, layerId: place.layerId, description: place.description || '',
                    source: layer.overlayId ? (layer.isOwn ? (layer.isPlaces ? t('Your saved place') : t('Your overlay')) : t('Shared by') + ' ' + (layer.ownerName || '')) : '',
                    precision: layer.isPlaces ? t('User-confirmed point') : '', placeId: layer.isPlaces && layer.isOwn && place.id ? place.id : null,
                    isOwn: !!layer.isOwn };
                this.panel = 'details';
                return;
            }
            const point = (this.mapConfig.points || []).find((one) => one.id === place.id) || {};
            // the record's own place: the configuration's point or area record, not an overlay's or a layer's feature of that id
            const recordArea = ((this.effective && this.effective.features && this.effective.features.features) || []).some((feature) => feature && feature.id === 'record');
            this.selected = Object.assign({}, place, { precision: this.precisionText(point.precisionEnumId) || point.precision || '', source: point.source || point.sourceText || '',
                isRecord: !place.kind && !place.layerId && place.id === 'record' && (point.id === 'record' || recordArea) });
            this.panel = 'details';
        },
        onViewChange(change) {
            this.lastView = { center: change.center, zoom: change.zoom, extent: change.extent };
            if (!this.restoreLastView) return;
            clearTimeout(this.rememberTimer);
            this.rememberTimer = setTimeout(() => {
                moqui.request(this.screenPath + '/rememberView', { method: 'POST',
                    params: { lastView: JSON.stringify({ center: this.lastView.center, zoom: Math.round((this.lastView.zoom || 0) * 100) / 100 }) } })
                    .catch((err) => console.warn('Maps: the last view was not kept', err));
            }, 2000);
        },
        openSave() { this.saveName = ''; this.saveShared = 'N'; this.saveShown = true; },
        saveView() {
            if (!this.lastView || this.saving) return;
            this.saving = true;
            const view = { center: this.lastView.center, zoom: Math.round((this.lastView.zoom || 0) * 100) / 100,
                layers: this.overlays.concat(this.recordLayers).filter((layer) => this.layerShown(layer)).map((layer) => layer.id) };
            if (this.basemapId) view.basemap = this.basemapId;
            // the band settings of the COG layers shown
            const rasters = {};
            this.overlays.filter((layer) => layer.kind === 'cog' && layer.raster && this.layerShown(layer)).forEach((layer) => {
                const style = this.rasterStyle(layer);
                if (style) rasters[layer.id] = style;
            });
            if (Object.keys(rasters).length) view.rasters = rasters;
            const params = { description: this.saveName.trim(), isShared: this.saveShared, view: JSON.stringify(view) };
            if (this.effective && this.effective.profileId) params.profileId = this.effective.profileId;
            this.request('saveView', { method: 'POST', params }).then((json) => {
                if (json.applied) {
                    this.saveShown = false;
                    moqui.notifyMessages([{ type: 'success', message: t('View saved') }], null);
                    this.loadViews();
                } else moqui.notifyMessages(null, [json.reason || t('The view was not saved')]);
            }, (err) => moqui.notifyMessages(null, [String(err && err.message || err)])).then(() => { this.saving = false; });
        },
        // Add overlay: an upload, or a file chosen with the drive picker (pickerData, pickerFolder, pickerSearch: the drives the
        // user may open, their folders and files by name, only GeoJSON, GPX and KML files listed)
        openAddOverlay() {
            this.addFile = null; this.addPick = null; this.addLabel = ''; this.addOffer = false; this.addShown = true;
            this.picker = { drives: [], driveId: null, crumbs: [], rows: [], loading: true, text: '', searching: true };
            this.request('pickerData').then((json) => {
                this.picker.drives = json.driveList || [];
                this.picker.rows = json.recentList || [];
                this.picker.loading = false;
                if (json.personalDriveId && !this.picker.rows.length) this.pickerOpen(json.personalDriveId, '');
            }, () => { this.picker.loading = false; this.picker.drives = []; });
        },
        pickerOpen(driveId, path) {
            Object.assign(this.picker, { driveId, searching: false, loading: true });
            this.request('pickerFolder', { params: { driveId, path: path || '' } }).then((json) => {
                this.picker.rows = (json.fileList || []).map((row) => Object.assign({ driveId }, row));
                this.picker.crumbs = json.breadcrumbList || [];
                this.picker.loading = false;
            }, () => { this.picker.loading = false; this.picker.rows = []; });
        },
        pickerSearch() {
            const text = String(this.picker.text || '').trim();
            if (!text) return;
            Object.assign(this.picker, { searching: true, loading: true });
            this.request('pickerSearch', { params: { text } }).then((json) => {
                this.picker.rows = json.fileList || [];
                this.picker.loading = false;
            }, () => { this.picker.loading = false; this.picker.rows = []; });
        },
        pickerKey(row) { return (row.driveId || this.picker.driveId) + '\n' + row.path; },
        pickerCaption(row) {
            if (row.isDirectory) return '';
            return this.picker.searching && row.driveName ? row.driveName + (row.folderPath ? ' / ' + row.folderPath : '') : '';
        },
        pickerClick(row) {
            if (row.isDirectory) this.pickerOpen(row.driveId || this.picker.driveId, row.path);
            else { this.addPick = Object.assign({ driveId: this.picker.driveId }, row); this.addFile = null; this.addOffer = false; }
        },
        // the file is read on the server first: one that cannot be drawn is refused with its reason, nothing kept
        // a file too large to draw whole is refused with canGeneralize: the dialog then offers simplifying it on the server
        addOverlay(generalize) {
            if (this.adding) return;
            this.adding = true;
            const body = new FormData();
            if (this.addFile) body.append('overlayFile', this.addFile, this.addFile.name);
            else if (this.addPick) { body.append('driveId', this.addPick.driveId); body.append('path', this.addPick.path); }
            if (this.addLabel.trim()) body.append('label', this.addLabel.trim());
            if (generalize === true) body.append('generalize', 'true');
            this.request('addOverlay', { method: 'POST', params: body }).then((json) => {
                if (json.applied) {
                    this.addShown = false;
                    this.addOffer = false;
                    const left = json.rejectedCount ? ' ' + json.rejectedCount + ' ' + t('features left out: their geometry is not valid') : '';
                    const message = json.generalizing ? t('Overlay added: it is drawn once this server has simplified it') + ' (' + json.featureCount + ' ' + t('features') + ').'
                        : t('Overlay added') + ': ' + json.featureCount + ' ' + t('features') + '.';
                    moqui.notifyMessages([{ type: left ? 'warning' : 'success', message: message + left }], null);
                    this.keepView();
                    this.load();
                } else {
                    this.addOffer = !!json.canGeneralize;
                    moqui.notifyMessages(null, [json.reason || t('The overlay was not added')]);
                }
            }, (err) => moqui.notifyMessages(null, [String(err && err.message || err)])).then(() => { this.adding = false; });
        },
        tilesBusy(layer) { return layer.tilesStatus === 'pending' || layer.tilesStatus === 'running'; },
        cancelTiles(layer) {
            this.request('cancelOverlayTiles', { method: 'POST', params: { overlayId: layer.overlayId } }).then((json) => {
                if (!json.applied) moqui.notifyMessages(null, [json.reason || t('The simplifying was not stopped')]);
                this.keepView();
                this.load();
            }, (err) => moqui.notifyMessages(null, [String(err && err.message || err)]));
        },
        // while an overlay of the user's is being simplified, its progress is asked for (a light call, waiting twice as
        // long each time up to a minute, and not while the page is hidden); the layers are loaded again once it ends
        watchTiles() {
            clearTimeout(this.tilesTimer);
            const busy = this.personalOverlays.filter((layer) => layer.isOwn && this.tilesBusy(layer)).map((layer) => layer.overlayId);
            if (!busy.length) { this.tilesDelay = 0; return; }
            this.tilesDelay = Math.min((this.tilesDelay || 2500) * 2, 60000);
            this.tilesTimer = setTimeout(() => this.pollTiles(busy), this.tilesDelay);
        },
        pollTiles(ids) {
            if (document.hidden) { this.tilesTimer = setTimeout(() => this.pollTiles(ids), this.tilesDelay || 5000); return; }
            this.request('overlayTilesStatus', { params: { overlayIds: ids.join(',') } }).then((json) => {
                const list = json.statusList || [];
                const ended = ids.some((id) => { const row = list.find((one) => one.overlayId === id); return !row || !this.tilesBusy(row); });
                if (ended) { this.tilesDelay = 0; this.keepView(); this.load(); return; }
                list.forEach((row) => { const layer = this.personalOverlays.find((one) => one.overlayId === row.overlayId); if (layer) layer.tilesProgress = row.tilesProgress; });
                this.watchTiles();
            }, () => this.watchTiles());
        },
        // ---- editing one's own overlay (m-map's editCommand; MapOverlays.js editOverlay and saveEdit) ----
        canEdit(layer) { return !!(moqui.map && moqui.map.canEditOverlay ? moqui.map.canEditOverlay(layer) : layer.isOwn && !layer.tilesStatus && layer.kind === 'geojson'); },
        editCommand(name, value) { return this.$refs.map && this.$refs.map.editCommand ? this.$refs.map.editCommand(name, value) : null; },
        startEdit(layer) {
            if (this.editing && !this.stopEdit()) return;
            this.editLoading = true;
            this.request('overlayEdit', { params: { overlayId: layer.overlayId } }).then((json) => {
                if (!json.applied) { moqui.notifyMessages(null, [json.reason || t('The overlay cannot be edited')]); return; }
                let collection = null;
                try { collection = JSON.parse(json.geojson); } catch (err) { collection = null; }
                if (!collection) { moqui.notifyMessages(null, [t('The overlay cannot be edited')]); return; }
                this.editing = { overlayId: json.overlayId, layerId: layer.id, label: layer.label, version: json.version, isPlaces: json.isPlaces,
                    editPath: json.editPath, inPlace: json.inPlace, drawType: '' };
                this.editNotes = [];
                this.editStale = false;
                this.editState = { count: collection.features.length, dirty: false, selected: null, sketch: 0 };
                // the overlay is shown, so its features are there to edit (m-map hides it while its copy is edited)
                if (!this.layerShown(layer)) { this.keepView(); this.hidden = Object.assign({}, this.hidden, { [layer.id]: false }); }
                this.editCommand('start', { layerId: layer.id, collection, pointsOnly: json.isPlaces });
                this.panel = 'edit';
            }, (err) => moqui.notifyMessages(null, [String(err && err.message || err)])).then(() => { this.editLoading = false; });
        },
        setDraw(type) { this.editCommand('draw', type || ''); },
        onEditChange(state) {
            if (!state) return;
            const before = this.editState.selected;
            this.editState = state;
            if (this.editing && state.drawType !== undefined) this.editing.drawType = state.drawType;
            // the fields follow the selection, not each change they make themselves
            if (state.selected && (!before || before.id !== state.selected.id)) { this.editLabel = state.selected.label || ''; this.editDescription = state.selected.description || ''; }
        },
        applyDetails() { this.editCommand('details', { label: this.editLabel, description: this.editDescription }); },
        saveEdit() {
            if (!this.editing || this.editSaving) return;
            const collection = this.editCommand('collection');
            if (!collection) return;
            this.editSaving = true;
            this.editNotes = [];
            const params = { overlayId: this.editing.overlayId, geojson: JSON.stringify(collection), baseVersion: this.editing.version };
            this.request('saveOverlayEdit', { method: 'POST', params }).then((json) => {
                if (json.applied) {
                    this.editing.version = json.version;
                    this.editing.editPath = json.path;
                    this.editing.inPlace = true;
                    this.editCommand('saved');
                    moqui.notifyMessages([{ type: 'success', message: t('Overlay saved') + ': ' + json.featureCount + ' ' + t('features') + '.' }], null);
                } else {
                    this.editNotes = json.notes || [];
                    this.editStale = json.reasonCode === 'STALE_VERSION';
                    moqui.notifyMessages(null, [json.reason || t('The overlay was not saved')]);
                }
            }, (err) => moqui.notifyMessages(null, [String(err && err.message || err)])).then(() => { this.editSaving = false; });
        },
        // ends the editing (asking first when there are changes not saved); false when the user keeps editing
        stopEdit(force) {
            if (!this.editing) return true;
            if (!force && this.editState.dirty && !window.confirm(t('Close without saving your changes?'))) return false;
            this.editCommand('stop');
            this.editing = null;
            this.editState = { count: 0, dirty: false, selected: null, sketch: 0 };
            if (this.panel === 'edit') this.panel = 'layers';
            this.keepView();
            this.load();
            return true;
        },
        // the file changed meanwhile: what is being edited is let go and the file's version now opened
        reopenEdit() {
            const layer = this.overlays.find((one) => this.editing && one.id === this.editing.layerId);
            this.stopEdit(true);
            if (layer) this.startEdit(layer);
        },
        removeOverlay(layer) {
            this.request('removeOverlay', { method: 'POST', params: { overlayId: layer.overlayId } }).then((json) => {
                if (!json.applied) { moqui.notifyMessages(null, [json.reason || t('The overlay was not removed')]); return; }
                this.keepView();
                this.load();
            }, (err) => moqui.notifyMessages(null, [String(err && err.message || err)]));
        },
        openSavePlace() { this.placeName = this.selected && this.selected.label || ''; this.placeShown = true; },
        savePlace() {
            if (!this.selected || this.saving) return;
            this.saving = true;
            const params = { label: this.placeName.trim(), longitude: String(this.selected.lon), latitude: String(this.selected.lat) };
            this.request('savePlace', { method: 'POST', params }).then((json) => {
                if (json.applied) {
                    this.placeShown = false;
                    moqui.notifyMessages([{ type: 'success', message: t('Place saved') }], null);
                    this.selected = Object.assign({}, this.selected, { placeId: json.placeId, isOwn: true, label: params.label });
                    this.keepView();
                    this.load();
                } else moqui.notifyMessages(null, [json.reason || t('The place was not saved')]);
            }, (err) => moqui.notifyMessages(null, [String(err && err.message || err)])).then(() => { this.saving = false; });
        },
        removePlace(place) {
            this.request('removePlace', { method: 'POST', params: { placeId: place.placeId } }).then((json) => {
                if (!json.applied) { moqui.notifyMessages(null, [json.reason || t('The place was not removed')]); return; }
                this.selected = Object.assign({}, this.selected, { placeId: null, isOwn: false });
                this.keepView();
                this.load();
            }, (err) => moqui.notifyMessages(null, [String(err && err.message || err)]));
        },
        copy(place) {
            const text = this.coordinates(place);
            const clipboard = navigator.clipboard;
            if (!clipboard) return;
            clipboard.writeText(text).then(() => moqui.notifyMessages([{ type: 'success', message: t('Copied') + ': ' + text }], null),
                (err) => console.warn('Maps: the coordinates were not copied', err));
        },
        // ---- live location (plans/Location-Sharing.md §3.3; the transitions are Browse.xml's, over LocationServices) ----
        // m-map's shares after a change: one an ended push (or a revoked one, to a viewer) took off is gone from the panels
        // too, for as long as the page is open; one a read no longer lists comes back with the next read that does
        onLiveChange(change) {
            const shares = change && Array.isArray(change.shares) ? change.shares : [];
            const gone = (change && Array.isArray(change.removed) ? change.removed : []).filter((id) => !this.liveGone.includes(id));
            if (gone.length) this.liveGone = this.liveGone.concat(gone);
            this.live = shares;
        },
        // the shares read again after a change of the user's own; m-map takes them without drawing the map again
        refreshShares() {
            const readAt = Date.now();
            return this.request('locationShares').then((json) => {
                if (!this.effective || this.closed) return;
                const mineFailed = json.mineFailed === true;
                this.sharesReadFailed(mineFailed);
                const shares = this.mergeRead(this.stampShares(json.locationShares, Date.now()), mineFailed, json.theirsFailed === true);
                this.mineReadFailed = mineFailed;
                this.effective = Object.assign({}, this.effective, { locationShares: shares });
                if (!mineFailed) this.pruneSending(shares, readAt);
            }, (err) => {
                console.warn('Maps: the location shares were not read again', err);
                // a read that did not answer is said as a failed one: read once more, then the notice to reload
                if (!this.closed) this.sharesReadFailed(true);
            });
        },
        // a failed read of the user's own shares said above the map, and read again once after 5 s; a good read clears it
        sharesReadFailed(failed) {
            if (!failed) { this.sharesNotice = ''; return; }
            if (this.sharesRetried) { this.sharesNotice = t('Your location shares could not be read: reload the page to see them'); return; }
            this.sharesRetried = true;
            this.sharesNotice = t('Your location shares were not read: trying again');
            clearTimeout(this.sharesRetryTimer);
            this.sharesRetryTimer = setTimeout(() => { if (!this.closed) this.refreshShares(); }, 5000);
        },
        // a read's shares, with the rows the page had for a half whose read failed (the user's own, those shared with them),
        // so a failed read hides nothing
        mergeRead(list, mineFailed, theirsFailed) {
            const before = this.effective ? this.effective.locationShares || [] : [];
            const own = (share) => share && share.role === 'owner';
            return (mineFailed ? before.filter(own) : list.filter(own)).concat(theirsFailed ? before.filter((share) => !own(share)) : list.filter((share) => !own(share)));
        },
        // each latest position given this page's clock at the read (seenAt: when the server's ageSeconds says it was taken),
        // once: a configuration drawn or normalized again later keeps it, so a share that stopped reporting goes stale
        stampShares(list, receivedAt) {
            return (Array.isArray(list) ? list : []).map((share) => {
                const latest = share && share.latest;
                if (!latest || typeof latest.seenAt === 'number') return share;
                const age = Number(latest.ageSeconds);
                return Object.assign({}, share, { latest: Object.assign({}, latest, { seenAt: receivedAt - (Number.isFinite(age) ? Math.max(0, age) : 0) * 1000 }) });
            });
        },
        // after a read that did not fail: a share this page sends that the read does not list as the user's own (ended,
        // stopped elsewhere) is no longer sent; one started after the read was asked waits for the next read
        pruneSending(list, readAt) {
            const mine = (Array.isArray(list) ? list : []).filter((share) => share && share.role === 'owner').map((share) => share.shareId);
            this.sending.filter((id) => !mine.includes(id) && (this.sendInfo[id] || {}).startedAt < readAt).forEach((id) => this.stopSending(id));
            this.readNativeSending();
        },
        untilText(millis) {
            if (!millis) return '';
            const at = new Date(Number(millis));
            const time = at.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            return at.toDateString() === new Date(this.now).toDateString() ? time : at.toLocaleDateString([], { weekday: 'short' }) + ' ' + time;
        },
        ageWords(share) {
            if (!share.position || share.seenAt === null || share.seenAt === undefined) return t('No position yet');
            const seconds = Math.max(0, Math.round((this.now - share.seenAt) / 1000));
            const words = seconds < 60 ? t('just now') : seconds < 3600 ? Math.floor(seconds / 60) + ' ' + t('min ago')
                : seconds < 86400 ? Math.floor(seconds / 3600) + ' ' + t('h ago') : Math.floor(seconds / 86400) + ' ' + t('d ago');
            return seconds > 300 ? words + ' (' + t('stale') + ')' : words;
        },
        // whom an own share is with: "Sam, Pat and 2 others"
        audienceText(share) {
            // a share just started, not read yet: the people the dialog named
            if (!share.audience && share.whomText) return share.whomText;
            const names = (share.audience || []).map((entry) => entry.name).filter(Boolean);
            if (!names.length) return t('nobody now');
            return names.length <= 2 ? names.join(' ' + t('and') + ' ') : names.slice(0, 2).join(', ') + ' ' + t('and') + ' ' + (names.length - 2) + ' ' + t('others');
        },
        audienceIcon(entry) {
            return { LsaUser: 'sym_o_person', LsaUserGroup: 'sym_o_group', LsaXmpp: 'sym_o_forum', LsaLink: 'sym_o_link' }[entry.audienceTypeEnumId] || 'sym_o_person';
        },
        showShare(share) {
            if (!share.position) return;
            this.liveSelected = share.shareId;
            this.view = { center: [share.position.lon, share.position.lat], zoom: 15 };
            if (this.phone) this.panel = '';
        },
        // the geo: URI the phone's maps app opens for directions (RFC 5870 with Android's q and the label), as Chat's Open in maps
        geoUri(share) {
            const at = Number(share.position.lat).toFixed(6) + ',' + Number(share.position.lon).toFixed(6);
            return 'geo:' + at + '?q=' + at + (share.label ? '(' + encodeURIComponent(share.label) + ')' : '');
        },
        osmUrl(share) {
            const lat = Number(share.position.lat).toFixed(6), lon = Number(share.position.lon).toFixed(6);
            return 'https://www.openstreetmap.org/?mlat=' + lat + '&mlon=' + lon + '#map=17/' + lat + '/' + lon;
        },
        // Directions: in the Android app the phone's maps app (geo:, which its openExternal hands to the system); elsewhere
        // Open in OpenStreetMap, the place in a new window at openstreetmap.org (offered only while outside requests are on):
        // the position leaves this server only by this act
        directions(share) {
            if (!share.position) return;
            const desktop = window.moquiDesktop;
            if (this.phoneApp) {
                // the phone's maps app; OpenStreetMap only as its fallback and only while outside requests are on
                Promise.resolve(desktop.openExternal(this.geoUri(share))).catch(() => { if (this.outsideAllowed) window.open(this.osmUrl(share), '_blank', 'noopener'); });
                return;
            }
            if (!this.directionsShown) return;
            if (desktop && typeof desktop.openExternal === 'function') { Promise.resolve(desktop.openExternal(this.osmUrl(share))).catch(() => {}); return; }
            window.open(this.osmUrl(share), '_blank', 'noopener');
        },
        loadShareTargets() {
            if (this.shareTargets.loaded) return Promise.resolve();
            return this.request('shareTargets').then((json) => {
                this.shareTargets = { loaded: true, groups: json.groups || [], xmpp: !!json.xmpp, contacts: json.contacts || [],
                    maxShareHours: Number(json.maxShareHours) || 24, trailMaxDays: Number(json.trailMaxDays) || 30,
                    minIntervalSeconds: Number(json.minIntervalSeconds) || 5, approximateIntervalSeconds: Number(json.approximateIntervalSeconds) || 60 };
            }, (err) => console.warn('Maps: the share choices were not read', err));
        },
        openShare() {
            this.shareForm = { users: [], groups: [], jids: [], link: false, hours: 1, precision: 'LspExact', keepTrail: false, label: '' };
            this.shareError = '';
            this.shareMade = null;
            this.shareShown = true;
            this.loadShareTargets();
        },
        filterShareUsers(text, update) {
            const term = String(text || '').trim();
            if (term.length < 2) { update(() => { this.shareUserOptions = []; }); return; }
            this.request('shareUsers', { params: { term } }).then((list) => {
                update(() => { this.shareUserOptions = Array.isArray(list) ? list : []; });
            }, () => update(() => { this.shareUserOptions = []; }));
        },
        createShare() {
            if (this.shareSaving || !this.shareAudience.length) return Promise.resolve(null);
            this.shareSaving = true;
            this.shareError = '';
            const params = { audience: JSON.stringify(this.shareAudience), thruDate: String(Date.now() + this.shareForm.hours * 3600000),
                precisionEnumId: this.shareForm.precision, keepTrail: this.shareForm.keepTrail ? 'true' : 'false', label: this.shareForm.label.trim() };
            // in the Android app, the location permission first, after the app's dialog that says why (LL3): no share is
            // started that this phone could not send
            const native = this.nativeLocation();
            const allowed = native ? Promise.resolve(native.allow(params.precisionEnumId !== 'LspApproximate')) : Promise.resolve(true);
            return allowed.then((ok) => (ok ? null : t('Allow the app to use this phone\'s location to share it, then try again'))).then((refused) => {
                if (refused) { this.shareError = refused; return null; }
                return this.postShare(params);
            }, () => null).then((shareId) => { this.shareSaving = false; return shareId; });
        },
        postShare(params) {
            return this.request('createShare', { method: 'POST', params }).then((json) => {
                if (!json.applied) { this.shareError = json.reason || t('Your location was not shared'); return null; }
                this.shareMade = { shareId: json.shareId, thruDate: json.thruDate, linkUrl: json.linkUrl || null };
                // shared by this page from now on, while it is open, at the share's precision and interval
                const approximate = params.precisionEnumId === 'LspApproximate';
                const form = this.shareForm;
                const whom = form.users.map((user) => user.label).concat(this.shareTargets.groups.filter((group) => form.groups.includes(group.userGroupId))
                    .map((group) => group.label), this.shareTargets.contacts.filter((contact) => form.jids.includes(contact.jid)).map((contact) => contact.label),
                    form.link ? [t('a guest link')] : []);
                if (!json.linkUrl) this.shareShown = false;
                // shared once it is sent: in the app only after the person's Send in its own dialog
                return this.sendShare(json.shareId, { approximate, thruDate: json.thruDate, whomText: whom.join(', '), fresh: true, created: true, audienceVersion: 1,
                    intervalSeconds: approximate ? this.shareTargets.approximateIntervalSeconds : this.shareTargets.minIntervalSeconds })
                    .then(() => {
                        // the app bar's chip at once, before the share's started push
                        if (this.$root && this.$root.loadShellIndicators) this.$root.loadShellIndicators();
                        return this.refreshShares();
                    }).then(() => json.shareId);
            }, (err) => { this.shareError = String(err && err.message || err); return null; });
        },
        // ---- the Android app (plans/Location-Sharing.md §3.4, LL3): its location service sends a share from this phone, also
        // with the app in the background, with its notification for as long as it does (moquiDesktop.location, a server
        // page's); with none (a browser, the desktop app) or when the app could not start it, this page sends while open ----
        nativeLocation() {
            const desktop = window.moquiDesktop;
            const native = desktop && desktop.location;
            return native && typeof native.start === 'function' ? native : null;
        },
        // a share started here or taken over: sent by the app's service once the person says Send in the app's own dialog
        // (whose words are the server's), else by this page; the person's Not now there sends it from nowhere: a share just
        // started (created) is stopped, one taken over is left with this device and not sent from it
        sendShare(shareId, info) {
            const native = this.nativeLocation();
            const shared = () => {
                if (info.thruDate) moqui.notifyMessages([{ type: 'success', message: t('Your location is shared until') + ' ' + this.untilText(info.thruDate) }], null);
            };
            const onPage = () => { this.startSending(shareId, info); shared(); return false; };
            if (!native) return Promise.resolve(onPage());
            return Promise.resolve(native.start({ shareId })).then((answer) => {
                if (answer === 'started') {
                    this.stopSending(shareId);
                    if (!this.nativeSending.includes(shareId)) this.nativeSending = this.nativeSending.concat([shareId]);
                    this.noteSending();
                    shared();
                    return true;
                }
                if (answer === 'declined') {
                    // the person's Not now: a share just made is stopped; one taken over stays this device's, and nothing
                    // sends it (its audience sees its last position grow old), which the person is told plainly
                    if (info.created) {
                        this.shareAction('stopShare', { shareId });
                        moqui.notifyMessages(null, [t('Your location was not shared')]);
                    } else moqui.notifyMessages(null, [t('Nothing sends this share now: its audience sees your last position until you send it again or stop it')]);
                    return false;
                }
                return onPage();
            }, onPage);
        },
        // what the app's service sends now, read when the shares are (it stops a share by itself at its end, a 410, another
        // device's takeover, a sign-out, its notification's Stop or the permission taken away)
        readNativeSending() {
            const native = this.nativeLocation();
            if (!native || typeof native.status !== 'function') return Promise.resolve();
            return Promise.resolve(native.status()).then((list) => {
                this.nativeSending = Array.isArray(list) ? list.map(String) : [];
                this.noteSending();
            }, () => {});
        },
        sentHere(shareId) { return this.sending.includes(shareId) || this.nativeSending.includes(shareId); },
        // where an own share is sent from, for its banner
        sentFromText(share) {
            if (this.nativeSending.includes(share.shareId)) return t('sent from this phone, also while the app is in the background');
            if (this.sending.includes(share.shareId)) return t('sent from this page while it is open');
            const from = share.sentFromDevice ? (share.deviceName ? t('sent from') + ' ' + share.deviceName : t('sent from another device')) : t('not sent from this page');
            return from + ': ' + this.ageWords(share);
        },
        // an action on a share of the user's own, then the shares read again
        shareAction(name, params, done) {
            return this.request(name, { method: 'POST', params }).then((json) => {
                if (!json.applied) { moqui.notifyMessages(null, [json.reason || t('That did not change the share')]); return; }
                if (done) done(json);
                this.refreshShares();
            }, (err) => moqui.notifyMessages(null, [String(err && err.message || err)]));
        },
        stopShare(share) {
            this.stopSending(share.shareId);
            this.stopNative(share.shareId);
            this.shareAction('stopShare', { shareId: share.shareId }, () => moqui.notifyMessages([{ type: 'success', message: t('Sharing stopped') }], null));
        },
        // Extend sends the new end alone, never the audience again
        extendShare(share, hours) {
            this.shareAction('extendShare', { shareId: share.shareId, thruDate: String(Date.now() + hours * 3600000) },
                (json) => moqui.notifyMessages([{ type: 'success', message: t('Shared until') + ' ' + this.untilText(json.thruDate) }], null));
        },
        addGroupAgain(share, entry) {
            this.shareAction('addGroupAgain', { shareId: share.shareId, userGroupId: entry.userGroupId }, (json) => {
                const added = (json.addedUserList || []).map((user) => user.userName).filter(Boolean);
                moqui.notifyMessages([{ type: 'success', message: added.length ? t('Now also shared with') + ' ' + added.join(', ') : t('The group was added again: nobody new') }], null);
            });
        },
        revokeAudience(share, entry) { this.shareAction('revokeAudience', { shareId: share.shareId, audienceSeqId: entry.audienceSeqId }); },
        deleteTrail(share) {
            if (!window.confirm(t('Delete the trail of this share now?'))) return;
            this.shareAction('deleteTrail', { shareId: share.shareId });
        },
        copyText(value) {
            const clipboard = navigator.clipboard;
            if (clipboard) clipboard.writeText(String(value)).then(() => moqui.notifyMessages([{ type: 'success', message: t('Copied') }], null), () => {});
        },
        // ---- sending from this page: watchPosition while a share of the user's own that this page started (or was asked to
        // send) is active and the page is open; the page closed, the share stays active and goes stale. The shares sent are
        // kept in this tab's session storage, by account (sendingKey), so a reload of the page goes on sending them; a
        // sign-out forgets them (forgetSending, a before-logout hook of the shell). ----
        // the list as stored with the session it was stored in (the hash of its session token, sessionDigest): one of another
        // session (a sign-in again in this tab) is not resumed
        storedSending() {
            const key = sendingKey();
            if (!key) return [];
            try {
                const value = JSON.parse(window.sessionStorage.getItem(key) || 'null');
                return this.sessionHash && value && value.session === this.sessionHash && Array.isArray(value.shareIds) ? value.shareIds.map(String) : [];
            } catch (err) { return []; }
        },
        storeSending() {
            const key = sendingKey();
            if (!key) return;
            try {
                if (this.sending.length && this.sessionHash) window.sessionStorage.setItem(key, JSON.stringify({ session: this.sessionHash, shareIds: this.sending }));
                else window.sessionStorage.removeItem(key);
            } catch (err) { /* sending goes on for this page alone */ }
        },
        // the shares this tab sent before a reload, those still the user's own and active; the rest are dropped from storage
        restoreSending() {
            if (this.closed) return;
            // the session's hash first: a restore asked before it is made waits for it
            if (!this.sessionHash) { if (this.hashing) this.hashing.then(() => { if (this.sessionHash) this.restoreSending(); }); return; }
            const mine = this.myShares;
            const stored = this.storedSending();
            const kept = stored.filter((id) => mine.some((share) => share.shareId === id));
            kept.filter((id) => !this.sending.includes(id)).forEach((id) => this.sendFromHere(mine.find((share) => share.shareId === id), true));
            if (kept.length !== stored.length) this.storeSending();
        },
        // a listed share of the user's own sent from here, at its precision and interval. The user's Send from here (Send from
        // this device in the app) takes it over on the server first (sendFromHere), so the device that sent it is told
        // another one does now and stops; a reload goes on sending what this tab sent, as it was
        sendFromHere(share, restored) {
            if (!share) return Promise.resolve();
            const info = { approximate: !!share.approximate, intervalSeconds: share.reportIntervalSeconds, thruDate: share.thruDate,
                whomText: this.audienceText(share), restored: !!restored, fresh: !restored };
            if (restored) { this.startSending(share.shareId, info); return Promise.resolve(); }
            const native = this.nativeLocation();
            const allowed = native ? Promise.resolve(native.allow(!share.approximate)) : Promise.resolve(true);
            return allowed.then((ok) => {
                if (!ok) { moqui.notifyMessages(null, [t('Allow the app to use this phone\'s location to share it, then try again')]); return null; }
                return this.request('sendFromHere', { method: 'POST', params: { shareId: share.shareId } }).then((json) => {
                    if (!json.applied) { moqui.notifyMessages(null, [json.reason || t('That did not change the share')]); return null; }
                    return this.sendShare(share.shareId, info).then(() => this.refreshShares());
                });
            }).catch((err) => moqui.notifyMessages(null, [String(err && err.message || err)]));
        },
        // the app's service no longer sends a share (its Stop here, or it ended)
        stopNative(shareId) {
            const native = this.nativeLocation();
            if (!this.nativeSending.includes(shareId)) return;
            this.nativeSending = this.nativeSending.filter((id) => id !== shareId);
            if (native && typeof native.stop === 'function') Promise.resolve(native.stop(shareId)).catch(() => {});
            this.noteSending();
        },
        // info: approximate, intervalSeconds (the share's report interval), thruDate and whomText (for its banner before the
        // share is read), fresh (a share just started: no fix taken before it is sent), restored (after a reload)
        startSending(shareId, info) {
            if (this.closed) return;
            const given = info || {};
            if (!this.sending.includes(shareId)) this.sending = this.sending.concat([shareId]);
            this.sendInfo = Object.assign({}, this.sendInfo, { [shareId]: { approximate: !!given.approximate, intervalSeconds: Number(given.intervalSeconds) || 0,
                audienceVersion: Number(given.audienceVersion) || 0,
                thruDate: given.thruDate || null, whomText: given.whomText || '', startedAt: Date.now() } });
            this.storeSending();
            this.sendError = '';
            this.noteSending();
            if (moqui.beforeLogoutHooks) moqui.beforeLogoutHooks.add(forgetSending);
            this.sendState = this.sendState || {};
            // a fix taken before the share began is refused (BEFORE_SHARE): a new share waits for one taken from now
            this.sendState[shareId] = { nextAt: 0, sentAt: 0, inFlight: false, serverTime: false, notBefore: given.fresh ? Date.now() - 1000 : 0 };
            this.watchFixes();
            if (given.fresh) this.freshFix();
        },
        stopSending(shareId) {
            if (!this.sending.includes(shareId)) return;
            this.sending = this.sending.filter((id) => id !== shareId);
            this.storeSending();
            if (this.sendState) delete this.sendState[shareId];
            const notes = Object.assign({}, this.sendNotes);
            delete notes[shareId];
            this.sendNotes = notes;
            if (!this.sending.length) this.unwatchFixes();
            else this.watchFixes();
            this.noteSending();
        },
        // the app bar's "Sharing location" chip (the shell's indicator of the framework's live-location shell-indicator provider) says "sending here"
        // while this page sends a share, and "sending from this phone" while the Android app's location service does, which
        // goes on after this page closes (plans/Location-Sharing.md §3.4), so that note stays when it does
        noteSending(off) {
            if (!moqui.shellIndicators) return;
            const here = !off && !this.closed && this.sending.length > 0;
            moqui.shellIndicators.noteFrom(INDICATOR_KEY, 'maps', this.nativeSending.length ? t('sending from this phone') : here ? t('sending here') : null);
        },
        note(shareId, text) { this.sendNotes = Object.assign({}, this.sendNotes, { [shareId]: text }); },
        // a share's report interval in milliseconds: its own, else the listed share's, else location@min-interval-seconds' default
        intervalOf(shareId) {
            const share = this.myShares.find((one) => one.shareId === shareId);
            const info = this.sendInfo[shareId] || {};
            return Math.max(1, Number(info.intervalSeconds) || Number(share && share.reportIntervalSeconds) || (info.approximate ? 60 : 5)) * 1000;
        },
        // the accuracy asked of the browser: high while any share sent is exact
        exactNeeded() {
            return this.sending.some((id) => {
                const share = this.myShares.find((one) => one.shareId === id);
                const info = this.sendInfo[id];
                return !(info ? info.approximate : share && share.approximate);
            });
        },
        onFix(position) {
            if (this.closed) return;
            this.geoError = '';
            const c = position.coords;
            this.fix = { latitude: c.latitude, longitude: c.longitude, accuracy: c.accuracy, heading: c.heading, speed: c.speed, timestamp: position.timestamp || Date.now() };
            this.fixAt = Date.now();
            this.pumpReports();
        },
        onFixError(error) {
            this.geoError = t('The browser did not give its location, so the people you share with see your last one') + (error && error.message ? ': ' + error.message : '');
        },
        // the watch, at the accuracy the shares sent need (started again when that changes), and the pump that sends
        watchFixes() {
            if (this.closed) return;
            const geo = navigator.geolocation;
            if (!geo) { this.geoError = t('This browser cannot give its location, so nothing is sent from here'); return; }
            const exact = this.exactNeeded();
            if (this.watchId !== undefined && this.watchId !== null && this.watchExact !== exact) { geo.clearWatch(this.watchId); this.watchId = null; }
            if (this.watchId === undefined || this.watchId === null) {
                this.watchExact = exact;
                this.watchId = geo.watchPosition((position) => this.onFix(position), (error) => this.onFixError(error),
                    { enableHighAccuracy: exact, maximumAge: 5000, timeout: 60000 });
            }
            if (!this.pumpTimer) this.pumpTimer = setInterval(() => this.pumpReports(), 1000);
        },
        // a fix taken now (a share just started; and as a keep-alive, since a watch gives nothing while the device is still)
        // an answer that comes after the fixes were let go (the page closed, nothing sent any more) is dropped: its generation
        // is not the current one
        freshFix() {
            const geo = navigator.geolocation;
            if (!geo || this.closed || this.fixAsked) return;
            const generation = this.fixGeneration || 0;
            this.fixAsked = this.lastFixAsk = Date.now();
            const current = () => !this.closed && generation === (this.fixGeneration || 0);
            geo.getCurrentPosition((position) => { if (current()) { this.fixAsked = 0; this.onFix(position); } },
                (error) => { if (current()) { this.fixAsked = 0; this.onFixError(error); } },
                { enableHighAccuracy: this.exactNeeded(), maximumAge: 0, timeout: 30000 });
        },
        unwatchFixes() {
            if (this.watchId !== undefined && this.watchId !== null && navigator.geolocation) navigator.geolocation.clearWatch(this.watchId);
            this.watchId = null;
            clearInterval(this.pumpTimer);
            this.pumpTimer = null;
            this.fix = null;
            this.fixAsked = 0;
            this.fixGeneration = (this.fixGeneration || 0) + 1;
        },
        // the newest fix to each share sent, at most one a share's interval, none taken before a new share began; with no fix
        // for three of the shortest intervals (at least 15 s), one is asked for, at most one a 30 s (lastFixAsk) and never
        // while one is asked
        pumpReports() {
            if (this.closed) return;
            const now = Date.now();
            if (this.sending.length) {
                const shortest = Math.min(...this.sending.map((id) => this.intervalOf(id)));
                if (now - (this.fixAt || 0) > Math.max(15000, 3 * shortest) && now - (this.lastFixAsk || 0) > 30000) this.freshFix();
            }
            const fix = this.fix;
            if (!fix) return;
            this.sending.forEach((shareId) => {
                const state = this.sendState && this.sendState[shareId];
                if (!state || state.inFlight || now < state.nextAt || fix.timestamp <= state.sentAt || fix.timestamp < state.notBefore) return;
                this.report(shareId, state, fix);
            });
        },
        // report#Position's outcome, statusCode in the answer: 200 taken (the latest as its audience reads it shown on this
        // map); 429 too soon, sent again after retryAfterSeconds; 410 ended or 404 not the user's, no longer sent; 409 STALE
        // passed over; 409 CLOCK_AHEAD and 400 BEFORE_SHARE (the device's clock is off) sent from then on with the server's
        // time; another 400 a value refused, passed over. A sign-in lost (401, 403) or an answer that is not this
        // transition's JSON (a login page) stops sending; a network failure tries again at the next interval.
        report(shareId, state, fix) {
            if (this.closed) return;
            const interval = this.intervalOf(shareId);
            const num = (value) => (value === null || value === undefined || !Number.isFinite(Number(value)) ? '' : String(value));
            // the audience version this page read (a share sent from a device, the app's page, takes reports of the version
            // its audience is at; one the page has not read since is refused and read again)
            const share = this.myShares.find((one) => one.shareId === shareId);
            const version = share && share.audienceVersion != null ? share.audienceVersion : (this.sendInfo[shareId] || {}).audienceVersion;
            const params = { shareId, audienceVersion: version != null ? String(version) : '', latitude: num(fix.latitude), longitude: num(fix.longitude), accuracy: num(fix.accuracy), heading: num(fix.heading), speed: num(fix.speed),
                observedDate: state.serverTime ? '' : String(fix.timestamp) };
            state.inFlight = true;
            const signedOut = () => {
                this.sending.slice().forEach((id) => this.stopSending(id));
                this.sendError = t('Your location is no longer sent from this page: sign in again, then choose Send from here');
            };
            this.request('reportPosition', { method: 'POST', params }).then((json) => {
                const status = Number(json.statusCode);
                const now = Date.now();
                if (!Number.isFinite(status)) signedOut();
                else if (status === 200) {
                    state.sentAt = fix.timestamp;
                    state.nextAt = now + interval;
                    if (this.sendNotes[shareId] && !state.serverTime) this.note(shareId, '');
                    if (json.latest) this.showOwnLatest(shareId, json.latest);
                } else if (status === 429) state.nextAt = now + Math.max(1, Number(json.retryAfterSeconds) || 1) * 1000;
                else if (status === 410 || status === 404) {
                    this.stopSending(shareId);
                    this.refreshShares();
                } else if (status === 409 && json.reasonCode === 'AUDIENCE_CHANGED') {
                    // the audience changed since this page read it: read again (the banner shows whom it reaches now), then on
                    state.nextAt = now + interval;
                    this.refreshShares();
                } else if (status === 409 && json.reasonCode === 'OTHER_DEVICE') {
                    // another device of the user's sends it now (its Send from here): this page stops, and offers it back
                    this.stopSending(shareId);
                    this.refreshShares();
                } else if ((status === 409 && json.reasonCode === 'CLOCK_AHEAD') || (status === 400 && json.reasonCode === 'BEFORE_SHARE')) {
                    state.serverTime = true;
                    state.nextAt = now;
                    this.note(shareId, t('this device\'s clock is off from the server\'s, so its positions are timed by the server'));
                } else if (status === 409 || status === 400) {
                    state.sentAt = fix.timestamp;
                    state.nextAt = now + interval;
                    if (status === 400) this.note(shareId, t('a position was refused'));
                } else state.nextAt = now + interval;
            }, (err) => {
                if (err && (err.status === 401 || err.status === 403)) signedOut();
                else state.nextAt = Date.now() + interval;
            }).then(() => { state.inFlight = false; });
        },
        // the user's own latest, as the audience reads it, put on this map without drawing it again
        showOwnLatest(shareId, latest) {
            if (!this.effective) return;
            const shares = (this.effective.locationShares || []).map((share) => (share.shareId === shareId ? this.stampShares([Object.assign({}, share, { latest })], Date.now())[0] : share));
            this.effective = Object.assign({}, this.effective, { locationShares: shares });
        },
        toggleFullscreen() {
            if (document.fullscreenElement) document.exitFullscreen();
            else if (this.$refs.frame && this.$refs.frame.requestFullscreen) this.$refs.frame.requestFullscreen();
        },
        measure() {
            this.phone = window.innerWidth < 600;
            const holder = this.$refs.mapHolder;
            const top = holder ? holder.getBoundingClientRect().top : 120;
            // the shell's footer, when it is fixed over the page, is not the map's
            const footer = !this.fullscreen && document.querySelector('.q-footer');
            const below = footer ? footer.offsetHeight : 0;
            this.mapPx = Math.max(240, Math.floor(window.innerHeight - top - below - 8));
        },
        onFullscreen() {
            this.fullscreen = document.fullscreenElement === this.$refs.frame;
            this.keepView();
            this.$nextTick(() => this.measure());
        }
    },
    mounted() {
        this.measure();
        this.onResize = () => this.measure();
        window.addEventListener('resize', this.onResize);
        this.onFullscreenChange = () => this.onFullscreen();
        document.addEventListener('fullscreenchange', this.onFullscreenChange);
        this.load();
        this.loadViews();
        this.loadPreferences();
        // a sign-out forgets the shares this tab sends (forgetSending); the session they are kept with, as its hash
        if (moqui.beforeLogoutHooks) moqui.beforeLogoutHooks.add(forgetSending);
        this.hashing = sessionDigest().then((hash) => { this.sessionHash = hash; });
        // a sign-in again in this page is a new session: its hash made again, and what this page sends kept under it
        this.$watch(() => this.$root && this.$root.moquiSessionToken, () => {
            this.hashing = sessionDigest().then((hash) => {
                if (this.closed) return;
                this.sessionHash = hash;
                this.storeSending();
            });
        });
        // the ages of the live shares move on with the clock
        this.nowTimer = setInterval(() => { this.now = Date.now(); }, 30000);
    },
    beforeUnmount() {
        // the page closing stops what it sends, and drops a position asked for and not yet given; its shares stay active
        // and go stale
        this.closed = true;
        clearTimeout(this.sharesRetryTimer);
        this.unwatchFixes();
        this.noteSending(true);
        clearInterval(this.nowTimer);
        if (this.editing) this.editCommand('stop');
        window.removeEventListener('resize', this.onResize);
        document.removeEventListener('fullscreenchange', this.onFullscreenChange);
        clearTimeout(this.rememberTimer);
        clearTimeout(this.tilesTimer);
    }
};
</script>
