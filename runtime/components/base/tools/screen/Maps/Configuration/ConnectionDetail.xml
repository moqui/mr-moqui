<!-- A map provider's page (plans/archive/Maps.md §4.2): one connection of the mapProvider kind, read from
    org.moqui.admin.ConfigurationServices.get#Connection and changed through store#Connection and test#Connection, through
    the shared parts of template/ConnectionParts.xml (README, "Mounting the administration screens"): its settings and its
    key (write-only: a provider with a key is offered to a browser only through this server, Through this server, whose
    proxy adds it), a test (one request with no credentials, or as the proxy asks for a proxied provider, which enables it
    when it passes) and Enable and Disable. Only map providers: adapterKey is mapProvider whatever a
    request says, so no other kind of connection is reached here. Reading needs ADMIN_CONNECTION_VIEW and a change or a test
    ADMIN_CONNECTION_MANAGE, checked by the services. Named as System › Integrations' detail is (the sibling names an app
    that shows these screens uses). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Map provider" default-menu-include="false">
    <parameter name="adapterKey"/>
    <parameter name="connectionKey" required="true"/>

    <always-actions>
        <set field="adapterKey" value="mapProvider"/>
    </always-actions>

    <transition-include name="storeConnection" location="component://tools/template/ConnectionParts.xml"/>
    <transition-include name="testConnection" location="component://tools/template/ConnectionParts.xml"/>
    <transition-include name="setEnabled" location="component://tools/template/ConnectionParts.xml"/>

    <actions>
        <set field="kindTitle" value="Map provider"/>
        <set field="listPath" value="../Settings"/>
        <set field="listTitle" value="Maps configuration"/>
        <set field="detailPath" value="."/>
    </actions>
    <widgets>
        <section-include name="ConnectionPrepare" location="component://tools/template/ConnectionParts.xml"/>
        <section-include name="ConnectionUnavailable" location="component://tools/template/ConnectionParts.xml"/>
        <section-include name="ConnectionHeader" location="component://tools/template/ConnectionParts.xml"/>
        <section-include name="NativeConnectionBox" location="component://tools/template/ConnectionParts.xml"/>
        <section-include name="ConnectionChecksBox" location="component://tools/template/ConnectionParts.xml"/>
        <section-include name="ConnectionConsumersBox" location="component://tools/template/ConnectionParts.xml"/>
    </widgets>
</screen>
