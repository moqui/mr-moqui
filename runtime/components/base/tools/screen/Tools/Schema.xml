<!-- The entities and their tables: definitions, columns, and the table check. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Schema" default-menu-index="4" menu-image="sym_o_schema" menu-image-type="icon">
    <always-actions>
        <!-- the database: db, else the last choice, else the default group's (template/DatabaseParts.xml) -->
        <!-- the databases of get#DatabaseList, the entity groups' only -->
        <set field="databaseList" from="((ec.service.sync().name('org.moqui.dev.DatabaseServices.get#DatabaseList').parameters({includeExternal: false}).call() || {}).databases || []).map((database) =&gt; Object.assign({}, database, {groupNames: database.groupNames || [], label: database.external ? (database.description || database.db) + ' (external)' : (database.groupNames || []).join(', ') + ' (' + database.databaseConf + ')'}))"/>
        <set field="db" from="[db, ec.user.getPreference('database.selected')].find((name) =&gt; databaseList.some((database) =&gt; database.db == name)) || databaseList[0]?.db"/>
        <set field="selectedDatabase" from="databaseList.find((database) =&gt; database.db == db)"/>
    </always-actions>
    <subscreens default-item="Entities"/>
    <widgets>
        <subscreens-panel id="schema-panel" type="popup"/>
    </widgets>
</screen>
