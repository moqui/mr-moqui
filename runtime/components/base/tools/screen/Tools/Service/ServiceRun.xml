<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Service Run" default-menu-index="2">

    <parameter name="serviceName"/>

    <transition name="run" begin-transaction="false" authz-action="all">
        <actions>
            <script><![CDATA[
                ec.web.sessionAttributes.remove('toolsServiceRunResults')
                serviceResults = ec.service.sync().name(serviceName).parameters(context).call()
                if (serviceResults && !ec.message.hasError()) {
                    let resultsText = "Service Run Results:\n"
                    for (const [key, value] of Object.entries(serviceResults)) resultsText += `==> ${key}: ${value?.toString()}\n`
                    ec.logger.info(resultsText)

                    // Keep the output separately from the request inputs across the redirect. The session stores text,
                    // and the service has already run: output that is not JSON is a message, not a failed request.
                    try {
                        ec.web.sessionAttributes.toolsServiceRunResults = JSON.stringify({serviceName, results: serviceResults})
                    } catch (e) {
                        ec.message.addMessage(`The service ran; its output cannot be shown here (${e.message}). See the server log.`, "warning")
                    }
                }
            ]]></script>
        </actions>
        <default-response url="." save-parameters="true"><parameter name="doingRun" value="Y"/></default-response>
        <error-response url="." save-parameters="true"/>
    </transition>
    <transition name="runJson" begin-transaction="false" authz-action="all">
        <!-- Because the run transition doesn't actually return json and make things confusing when calling via rest -->
        <actions>
            <script>
                serviceResults = ec.service.sync().name(serviceName).parameters(context).call()
                if (serviceResults) {
                    ec.web.sendJsonResponse(serviceResults)
                }
            </script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <script><![CDATA[
            // Match service-call aliases and retain implicit entity services as valid selections.
            const selectedService = serviceName && (String(serviceName).includes('#')
                ? serviceName : String(serviceName).replace(/^(create|update|store|delete)-/, '$1#'))
            serviceExists = !!(selectedService && ec.service.getServiceDefinition(selectedService))
            serviceResults = null
            // The output is shown once: the next visit, a Back or a refresh does not show it again, and it does not stay in the session.
            const kept = ec.web.sessionAttributes.toolsServiceRunResults
            if (kept) ec.web.sessionAttributes.remove('toolsServiceRunResults')
            if (doingRun === 'Y' && kept) {
                const completed = JSON.parse(kept)
                if (completed.serviceName === serviceName) serviceResults = completed.results
            }
        ]]></script>
    </actions>
    <widgets>
        <form-single name="SelectServiceInput" transition=".">
            <field name="serviceName"><default-field title="Service Name (path.verb#noun)">
                <text-line size="80"/></default-field></field>
            <field name="submitButton"><default-field title="Select Service"><submit/></default-field></field>
            <field-layout><field-row-big><field-ref name="serviceName"/><field-ref name="submitButton"/></field-row-big></field-layout>
        </form-single>
        <section name="ServiceNotFoundSection" condition="serviceName &amp;&amp; !serviceExists"><widgets>
            <container-box><box-header><label type="h5" text="Service not found"/></box-header><box-body>
                <label type="p" text="No service named ${serviceName} is available. Check the name above or choose a service from the list." encode="true"/>
                <link url="../ServiceReference" text="Browse Service List"/>
            </box-body></container-box>
        </widgets></section>
        <section name="ServiceResultsSection" condition="serviceExists &amp;&amp; serviceResults != null">
            <widgets>
                <label text="Results for Service: ${serviceName}" type="h3"/>
                <form-single name="ServiceResults" dynamic="true" map="serviceResults">
                    <auto-fields-service service-name="${serviceName}" field-type="display" include="out"/>
                    <field name="serviceName"><default-field><hidden/></default-field></field>
                </form-single>
            </widgets>
        </section>
        <section name="ServiceParametersSection" condition="serviceExists"><widgets>
            <label text="Run Service: ${serviceName}" type="h3"/>
            <form-single name="ServiceParameters" transition="run" dynamic="true">
                <field name="serviceName"><default-field><hidden/></default-field></field>
                <auto-fields-service service-name="${serviceName}" include="in" field-type="edit"/>
                <field name="submitButton"><default-field title="Run Service"><submit/></default-field></field>

                <!-- no longer supported, has not been supported since Quartz Scheduler was removed in 2016
                <field name="cronString"><default-field tooltip="Enter a cron string to schedule instead of running immediately">
                    <text-line size="20"/></default-field></field>
                -->
            </form-single>
        </widgets></section>
    </widgets>
</screen>
