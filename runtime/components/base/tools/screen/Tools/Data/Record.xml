<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Record" default-menu-include="false">

    <parameter name="selectedEntity" required="true"/>
    <!-- gridFilters (not a declared parameter, so links to another record do not take it): the Grid's header filters as
        JSON, from its Record cell, kept through Update and the levels form and handed back by Back to Find -->

    <transition name="list"><default-response url="../../Schema/Entities"/></transition>
    <transition name="find"><default-response url="../Grid"/></transition>
    <transition name="edit"><default-response url="."/></transition>
    <transition name="update">
        <actions>
            <set field="entityName" from="selectedEntity"/><if condition="WebUtilities.isGenericWriteRefused(selectedEntity)"><message error="true">Entity ${entityName} is not available through this tool</message><return/></if>
            <script><![CDATA[
                // the entity's fields from the request but those no generic write takes (UserAccount's password and identity
                // fields), which keep their stored values and are named in a warning (plans/Security-Review.md SEC-TLS-81)
                writeMap = {}
                const leftFields = []
                for (const name of ec.entity.getEntityDefinition(selectedEntity).getAllFieldNames()) {
                    if (!context.containsKey(name)) continue
                    if (!WebUtilities.isGenericWriteRefused(selectedEntity, name)) writeMap[name] = context[name]
                    else if (context[name] != null && String(context[name]) !== '') leftFields.push(name)
                }
                if (leftFields.length) ec.message.addMessage(`Fields ${leftFields.join(', ')} of ${selectedEntity} are not available through this tool and were not written`, 'warning')
            ]]></script>
            <service-call name="update#${selectedEntity}" in-map="writeMap"/></actions>
        <default-response url="." parameter-map="Object.assign(ec.entity.getEntityDefinition(selectedEntity).getPrimaryKeys(context), gridFilters ? {gridFilters} : {})"/>
    </transition>

    <actions>
        <set field="entityName" from="selectedEntity"/><if condition="WebUtilities.isRestrictedGenericEntity(selectedEntity)"><message error="true">Entity ${entityName} is not available through this tool</message><return/></if>
        <set field="entityDefinition" from="ec.entity.getEntityDefinition(selectedEntity)"/>

        <set field="dependentLevels" from="parseInt(dependentLevels || '0', 10)"/>
        <set field="findParameters" from="gridFilters ? {selectedEntity, gridFilters} : {selectedEntity}"/>
        <entity-find-one entity-name="${selectedEntity}" value-field="entityValue"/>
        <set field="relationshipInfoList" from="ec.entity.getEntityDefinition(selectedEntity).getRelationshipsInfo(false)"/>
        <script>
            if (entityValue) {
                const plainMap = entityValue.getPlainValueMap(dependentLevels)
                plainJsonStr = JSON.stringify(plainMap, null, 2)
            }
        </script>
    </actions>
    <widgets>
        <container>
            <link url="list" text="Entity List"/>
            <link url="find" text="Back to Find" parameter-map="findParameters"/>
        </container>
        <container><label text="Edit '${selectedEntity}' Entity Value" type="h3"/></container>
        <render-mode><text type="qvt,html,html-print" template="false"><![CDATA[<div style="width:100%;max-width:960px">]]></text>
            <text type="tui" template="false">[]</text></render-mode>
        <form-single name="UpdateEntityValue" map="entityValue" transition="update" dynamic="true">
            <auto-fields-entity entity-name="${selectedEntity}" include="pk" field-type="display"/>
            <auto-fields-entity entity-name="${selectedEntity}" include="nonpk" field-type="edit"/>
            <field name="selectedEntity" from="selectedEntity"><default-field title="Entity Name"><hidden/></default-field></field>
            <field name="gridFilters" from="gridFilters"><default-field><hidden/></default-field></field>
            <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
        </form-single>
        <render-mode><text type="qvt,html,html-print" template="false"><![CDATA[</div>]]></text>
            <text type="tui" template="false">[]</text></render-mode>
        <form-list name="RelatedEntities" list="relationshipInfoList" list-entry="relInfo">
            <row-actions><set field="targetParameterMap" from="relInfo.getTargetParameterMap(entityValue)"/></row-actions>
            <field name="title"><default-field><display/></default-field></field>
            <field name="relatedEntityName"><default-field><display/></default-field></field>
            <field name="type"><default-field><display/></default-field></field>
            <field name="targetParameterMap">
                <default-field title="ID Map"><display/></default-field></field>
            <field name="link">
                <conditional-field condition="relInfo.type == 'many' &amp;&amp; targetParameterMap &amp;&amp; Object.keys(targetParameterMap).length">
                    <link text="Find" url="find" parameter-map="targetParameterMap">
                        <parameter name="selectedEntity" from="relInfo.relatedEntityName"/>
                    </link>
                </conditional-field>
                <conditional-field condition="targetParameterMap &amp;&amp; Object.keys(targetParameterMap).length">
                    <link text="Edit" url="edit" parameter-map="targetParameterMap">
                        <parameter name="selectedEntity" from="relInfo.relatedEntityName"/>
                    </link>
                </conditional-field>
                <default-field><display text=" "/></default-field>
            </field>
        </form-list>
        <label text="JSON with Dependents" type="h5"/>
        <form-single name="LevelsForm" transition="." dynamic="true">
            <auto-fields-entity entity-name="${selectedEntity}" field-type="hidden" include="pk"/>
            <field name="selectedEntity"><default-field title="Entity Name"><hidden/></default-field></field>
            <field name="gridFilters" from="gridFilters"><default-field><hidden/></default-field></field>
            <field name="dependentLevels"><default-field><text-line size="5"/></default-field></field>
            <field name="submitButton"><default-field title="Submit"><submit/></default-field></field>
            <field-layout><field-row-big><field-ref name="dependentLevels"/><field-ref name="submitButton"/></field-row-big></field-layout>
        </form-single>
        <label text="${plainJsonStr}" type="pre" encode="true" style="pre-plain"/>
    </widgets>
</screen>
