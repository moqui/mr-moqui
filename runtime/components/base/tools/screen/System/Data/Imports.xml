<!-- Imports (plans/archive/Admin-Screens-Down.md; first IronStone Admin's, mr-boss design-admin §11 Imports): the import runs of
    every registered target, newest first, from org.moqui.admin.DataTransferServices.find#ImportRuns. ImportFind: target,
    state and a bounded range of dates. ImportList: each run with its target and owner, the file's label, what it was
    for, the state and the rows applied, in need of attention and skipped. A run whose batch is read through the import
    contract (kept by the framework, or its owner's) opens ImportDetail; an owner wizard's run is what its owner answers
    for this user, by the owner's own permission and scope, and opens the owner's place: never a row of it here.
    ImportTargets: the registered targets, each started in the import wizard or opened in its owner's own wizard; one
    that keeps no runs says so. An owner's place and the wizard are the mount's routes (template/AdminMount.js): the
    registration's ownerRoute with the run's own parameters, and dataImport, the wizard an app mounts for the targets
    started here; a key with no route is no link, so with no mount a target started in a wizard is only named. Reading
    needs ADMIN_TRANSFER_VIEW or ADMIN_TRANSFER_RUN, checked by the service; a refusal is shown as its reason.
    The screen has no transition and no part for the instance administrator. An app that narrows the runs by data of its
    own (an organization) has a screen of its own: it reads found (find#ImportRuns, with its scopeKey) in its actions,
    includes ImportsPrepare, ImportsHeader, ImportNotes and ImportTargetsBox and extends ImportFind and ImportList
    (README, "Mounting the administration screens"). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Imports" default-menu-index="1" menu-image="sym_o_upload_file" menu-image-type="icon">
    <parameter name="targetId"/>
    <parameter name="state"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <parameter name="pageIndex"/>

    <actions>
        <!-- a refusal is shown as its reason (AdminCalls.read; ignore-error would clear it) -->
        <set field="called" from="ec.resource.script('component://framework/service/org/moqui/admin/AdminCalls.js').read('org.moqui.admin.DataTransferServices.find#ImportRuns',
                {targetId:(targetId || null), state:(state || null), fromDate:(fromDate || null), thruDate:(thruDate || null),
                    pageIndex:Math.max(Number(pageIndex) || 0, 0)}, 'they could not be read')"/>
        <set field="found" from="called.out"/>
        <set field="failure" from="called.failure"/>
        <set field="findValues" from="{targetId:targetId, state:state, fromDate:fromDate, thruDate:thruDate}"/>
    </actions>
    <widgets>
        <!-- what the parts below show of found (find#ImportRuns' answer) and failure; a section's actions, so a screen of an
            app's own shares them. A link to another screen carries what its target declares of the linking screen's
            context, so the find values of the screen showing the list (findValues, an app's own among them) and its
            page are sent empty with it -->
        <section name="ImportsPrepare">
            <actions>
                <script><![CDATA[
                    available = !!found?.transferList
                    const mountLib = ec.resource.script('component://tools/template/AdminMount.js')
                    const routes = mountLib.state().routes
                    const ownEmpty = Object.assign({targetId: '', state: '', fromDate: '', thruDate: '', pageIndex: ''},
                        Object.fromEntries(Object.keys(findValues || {}).map(name => [name, ''])))
                    // a route's link as a row's fields: a plain route by its href, a screen path by its url and parameters
                    const linkFields = (prefix, link) => ({[prefix + 'Href']: link?.plain ? link.href : '', [prefix + 'Url']: link && !link.plain ? link.url : '',
                        [prefix + 'Parameters']: link && !link.plain ? Object.assign({}, ownEmpty, link.parameters || {}) : {}})
                    const colors = {complete: 'positive', partial: 'deep-orange', failed: 'negative', applying: 'info', running: 'info', open: 'info'}
                    // a run read here opens ImportDetail; an owner's opens its owner's place, with the parameters its owner gave
                    runs = Array.from(found?.transferList || []).map(row => Object.assign({}, row,
                        linkFields('owner', row.detail || !row.ownerRoute ? null : mountLib.link(routes, row.ownerRoute, null, row.ownerParameters)), {
                        stateColor: colors[row.state] || 'grey-7',
                        targetText: row.targetTitle + (row.ownerApp ? ' · ' + row.ownerApp : ''),
                        ownerText: 'Open in ' + (row.ownerApp || 'its app')}))
                    runsCount = Number(found?.transferCount || 0)
                    runsPageIndex = Number(found?.pageIndex || 0)
                    runsPageSize = Number(found?.pageSize || 50)
                    runsPageMaxIndex = Math.max(Math.ceil(runsCount / runsPageSize) - 1, 0)
                    runsPageRangeLow = runsCount ? runsPageIndex * runsPageSize + 1 : 0
                    runsPageRangeHigh = Math.min((runsPageIndex + 1) * runsPageSize, runsCount)
                    // a target started here opens the wizard the mount gives (dataImport); an owner's wizard its owner's place
                    targets = Array.from(found?.targetList || []).map(target => {
                        const wizard = target.wizardHere ? mountLib.link(routes, 'dataImport', target.targetId) : null
                        const owner = !target.wizardHere && target.ownerRoute ? mountLib.link(routes, target.ownerRoute) : null
                        return Object.assign({}, target, linkFields('wizard', wizard), linkFields('owner', owner), {
                            startHere: !!wizard && !!found.canRun && target.importAllowed,
                            howText: target.wizardHere
                                ? (target.importAllowed ? (found.canRun ? 'The import wizard' : 'The import wizard, with ADMIN_TRANSFER_RUN') : 'The import wizard, with ' + (target.importPermission || 'its owner\'s permission').split(',').join(' and '))
                                    + (wizard ? '' : ', in an app that has it')
                                : (target.ownerApp || 'Its owner') + '\'s own wizard',
                            runsText: target.runsKept ? 'Listed here' : 'Keeps no runs yet'})
                    })
                    targetOptions = targets.map(target => ({value: target.targetId, label: target.title}))
                    stateOptions = Array.from(found?.stateList || []).map(row => ({value: row.state, label: row.text}))
                    unansweredText = Array.from(found?.unansweredTargetList || []).map(target => target.title + (target.ownerApp ? ' (' + target.ownerApp + ')' : '')).join(', ')
                ]]></script>
            </actions>
            <widgets/>
        </section>
        <section name="ImportsHeader">
            <widgets>
                <label text="Imports" type="h5"/>
                <label text="What each import came to, for every registered target. An owner's own imports are listed as far as you may read them in its app, and open there. Times are in ${found?.timeZone || 'the server time zone'}."
                        type="p" style="text-caption m-muted q-mb-none"/>
                <label type="p" style="text-negative" condition="!available" text="Imports are not available to you: ${failure || 'they could not be read'}."/>
            </widgets>
        </section>
        <section name="ImportsSection" condition="available">
            <widgets>
                <form-single name="ImportFind" transition="." map="findValues">
                    <field name="targetId">
                        <default-field title="Target"><drop-down allow-empty="true"><list-options list="targetOptions" key="${value}" text="${label}"/></drop-down></default-field>
                    </field>
                    <field name="state">
                        <default-field title="State"><drop-down allow-empty="true"><list-options list="stateOptions" key="${value}" text="${label}"/></drop-down></default-field>
                    </field>
                    <field name="fromDate"><default-field title="From" tooltip="Empty shows the last ${found.defaultDays} days; at most ${found.rangeDays} days at a time"><date-time type="date"/></default-field></field>
                    <field name="thruDate"><default-field title="Before"><date-time type="date"/></default-field></field>
                    <field name="submitButton"><default-field title="Find"><submit/></default-field></field>
                    <field-layout>
                        <field-row-big><field-ref name="targetId"/><field-ref name="state"/><field-ref name="fromDate"/><field-ref name="thruDate"/><field-ref name="submitButton"/></field-row-big>
                    </field-layout>
                </form-single>
                <section name="ImportNotes">
                    <widgets>
                        <label type="p" style="text-warning" condition="!!unansweredText" text="Not answered just now, so their imports are not listed: ${unansweredText}."/>
                        <label type="p" style="m-muted" condition="!runs.length" text="No import matches."/>
                    </widgets>
                </section>
                <form-list name="ImportList" list="runs" skip-form="true" paginate="true">
                    <field name="startedText"><default-field title="Started"><display/></default-field></field>
                    <field name="targetText"><default-field title="Target"><display/></default-field></field>
                    <field name="fileLabel">
                        <conditional-field condition="detail" title="Import">
                            <!-- the list's page is not the import's: sent empty -->
                            <link url="../ImportDetail" text="${fileLabel || runId}" link-type="anchor" parameter-map="{targetId:targetId, operationKey:runId, pageIndex:''}"/>
                        </conditional-field>
                        <default-field title="Import"><display/></default-field>
                    </field>
                    <field name="scopeTitle"><default-field title="For"><display/></default-field></field>
                    <field name="stateText">
                        <default-field title="State">
                            <render-mode>
                                <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${stateText}</q-chip>]]></text>
                                <text type="tui"><![CDATA[${JSON.stringify({t: "text", text: stateText})}]]></text>
                                <text type="html">${stateText}</text>
                            </render-mode>
                        </default-field>
                    </field>
                    <field name="countText"><default-field title="Rows"><display/></default-field></field>
                    <field name="userName"><default-field title="By"><display/></default-field></field>
                    <field name="ownerText">
                        <conditional-field condition="!!ownerHref" title="Owner">
                            <link url="${ownerHref}" url-type="plain" text="${ownerText}" link-type="anchor" icon="sym_o_open_in_new"/>
                        </conditional-field>
                        <conditional-field condition="!!ownerUrl" title="Owner">
                            <link url="${ownerUrl}" text="${ownerText}" link-type="anchor" icon="sym_o_open_in_new" parameter-map="ownerParameters"/>
                        </conditional-field>
                        <default-field title="Owner"><display text=""/></default-field>
                    </field>
                    <columns type="mobile">
                        <column><field-ref name="startedText"/><field-ref name="targetText"/><field-ref name="fileLabel"/></column>
                        <column><field-ref name="stateText"/><field-ref name="countText"/><field-ref name="ownerText"/></column>
                    </columns>
                </form-list>
                <section name="ImportTargetsBox">
                    <widgets>
                        <container-box>
                            <box-header title="Import targets"/>
                            <box-body>
                                <label type="p" style="text-caption m-muted" text="What can be imported, each by its owner's own rules. One imported in a wizard is started from here where this app has the wizard; an owner's own wizard opens in its app."/>
                                <form-list name="ImportTargets" list="targets" skip-form="true" paginate="false">
                                    <field name="title">
                                        <conditional-field condition="startHere &amp;&amp; !!wizardHref" title="Target">
                                            <link url="${wizardHref}" url-type="plain" text="${title}" link-type="anchor" icon="sym_o_upload_file"/>
                                        </conditional-field>
                                        <conditional-field condition="startHere &amp;&amp; !!wizardUrl" title="Target">
                                            <link url="${wizardUrl}" text="${title}" link-type="anchor" icon="sym_o_upload_file" parameter-map="wizardParameters"/>
                                        </conditional-field>
                                        <conditional-field condition="!!ownerHref" title="Target">
                                            <link url="${ownerHref}" url-type="plain" text="${title}" link-type="anchor" icon="sym_o_open_in_new"/>
                                        </conditional-field>
                                        <conditional-field condition="!!ownerUrl" title="Target">
                                            <link url="${ownerUrl}" text="${title}" link-type="anchor" icon="sym_o_open_in_new" parameter-map="ownerParameters"/>
                                        </conditional-field>
                                        <default-field title="Target"><display/></default-field>
                                    </field>
                                    <field name="ownerApp"><default-field title="Owner"><display/></default-field></field>
                                    <field name="description"><default-field title="What it imports"><display/></default-field></field>
                                    <field name="effectsNote"><default-field title="What applying it does"><display/></default-field></field>
                                    <field name="howText"><default-field title="Imported in"><display/></default-field></field>
                                    <field name="runsText"><default-field title="Runs"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="title"/><field-ref name="ownerApp"/></column>
                                        <column><field-ref name="howText"/><field-ref name="runsText"/></column>
                                    </columns>
                                </form-list>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
