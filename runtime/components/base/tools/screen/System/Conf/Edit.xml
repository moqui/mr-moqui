<!-- Conf › Edit (guide docs/tools/Component-Deploy.md, "Viewing and editing the conf"): one conf file at a time, by its
    place in the merge (fileIndex), in the XML code editor of Edit.qvue: completion from moqui-conf-3.xsd, each element's
    class (live, apply, restart) in the gutter, the default conf's comments above the elements they describe, and the
    problems and the changes that would wait for a restart as the text changes (check#ConfFile). Review and save shows the
    diff and the changes a reload makes; saving writes the file and reloads the conf (save#ConfFile). The default conf
    opens read only: its settings are overridden in the runtime conf. Reading and saving need the sealed CONF_EDIT
    permission, which the services check. The terminal edits the file as a form (EditTui). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Edit" default-menu-index="2" render-modes="vue,qvue,tui" server-static="vue,qvue">
    <parameter name="fileIndex"/>
    <parameter name="line"/>

    <transition name="file" method="get" read-only="true">
        <actions>
            <service-call name="org.moqui.dev.ComponentServices.get#ConfFile" in-map="{fileIndex:fileIndex}" out-map="fileOut"/>
            <script><![CDATA[
                const errors = ec.message.hasError() ? ec.message.errorsString : null
                ec.message.clearErrors()
                ec.web.sendJsonResponse(errors ? {errors} : fileOut)
            ]]></script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="check" method="post">
        <actions>
            <service-call name="org.moqui.dev.ComponentServices.check#ConfFile" in-map="{fileIndex:fileIndex, text:fileText}" out-map="checkOut"/>
            <script><![CDATA[
                const errors = ec.message.hasError() ? ec.message.errorsString : null
                ec.message.clearErrors()
                ec.web.sendJsonResponse(errors ? {errors} : checkOut)
            ]]></script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="save" method="post">
        <actions>
            <service-call name="org.moqui.dev.ComponentServices.save#ConfFile" out-map="saveOut"
                    in-map="{fileIndex:fileIndex, text:fileText, expectedHash:expectedHash}"/>
            <script><![CDATA[
                const errors = ec.message.hasError() ? ec.message.errorsString : null
                ec.message.clearErrors()
                ec.web.sendJsonResponse(errors ? {errors, problems: saveOut?.problems} : saveOut)
            ]]></script>
        </actions>
        <default-response type="none"/>
    </transition>

    <widgets>
        <render-mode>
            <text type="qvue" location="component://tools/screen/System/Conf/Edit.qvue" template="false"/>
            <text type="tui"><![CDATA[${JSON.stringify([{t: 'dynamicContainer', id: 'ConfEditTui', url: sri.buildUrl('../EditTui')
                .addParameters({fileIndex: fileIndex || null}).getUrlWithParams()}])}]]></text>
            <text type="html,qvt"><![CDATA[<p><a href="EditTui${fileIndex ? '?fileIndex=' + fileIndex : ''}">Edit the conf file as a form</a></p>]]></text>
        </render-mode>
    </widgets>
</screen>
