<!-- Security (plans/archive/Admin-Screens-Down.md): the user accounts (UserAccount/: System's own account administration, with the
    Verify screens of a user's own factors, which other apps mount by location) and, over org.moqui.admin
    ConfigurationServices, AccessServices and IdentityServices, which check their permissions themselves, the sign-in
    policy with the groups' sign-in rules (SignInPolicy), the sign-in providers (IdentityProviders, a provider:
    IdentityProviderDetail) and the sessions of every account (Sessions). The last four have the sibling names an app that
    shows them under its own root uses (README, "Mounting the administration screens"), so their links to each other are
    relative. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-index="4" default-menu-group="Administration" menu-image="sym_o_security" menu-image-type="icon">
    <subscreens default-item="UserAccount"/>
    <widgets>
        <subscreens-panel id="SecurityPanel" type="popup"/>
    </widgets>
</screen>
