<!-- Database servers not managed here (store#DatabaseHost), each served by its kind's create#Database. The admin login is
    the database-credential item DatabaseHost:<id>:admin of its vault, leased by the provision that makes a database on
    it. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Database Hosts" default-menu-index="5">

    <transition name="storeDatabaseHost" method="post"><service-call name="org.moqui.dev.InstanceServices.store#DatabaseHost"/>
        <default-response url="."/></transition>

    <actions>
        <entity-find entity-name="moqui.server.instance.DatabaseHost" list="databaseHostList">
            <order-by field-name="databaseHostId"/></entity-find>
    </actions>
    <widgets>
        <container-dialog id="StoreDatabaseHostDialog" button-text="New database host">
            <form-single name="StoreDatabaseHost" transition="storeDatabaseHost">
                <field name="databaseHostId"><default-field title="Id"><text-line size="30"/></default-field></field>
                <field name="instanceKindId"><default-field title="Kind">
                    <drop-down><option key="postgres" text="Postgres"/><option key="mysql" text="MySQL"/></drop-down></default-field></field>
                <field name="hostAddress"><default-field title="Address"><text-line size="40"/></default-field></field>
                <field name="hostPort"><default-field title="Port"><text-line size="6"/></default-field></field>
                <field name="instanceAddress"><default-field title="Address instances use" tooltip="When they reach it by another name">
                    <text-line size="40"/></default-field></field>
                <field name="vaultId"><default-field title="Vault of its admin login" tooltip="The environment's when empty"><text-line size="30"/></default-field></field>
                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
            </form-single>
        </container-dialog>

        <form-list name="DatabaseHostList" list="databaseHostList" skip-form="true">
            <field name="databaseHostId"><default-field title="Id"><display/></default-field></field>
            <field name="instanceKindId"><default-field title="Kind"><display/></default-field></field>
            <field name="hostAddress"><default-field title="Address"><display/></default-field></field>
            <field name="hostPort"><default-field title="Port"><display/></default-field></field>
            <field name="adminBinding"><default-field title="Admin login"><display text="DatabaseHost:${databaseHostId}:admin"/></default-field></field>
        </form-list>
    </widgets>
</screen>
