<!-- An instance (plans/archive/Vault-Instances.md §5): its state (desired, observed, seal and link), version, dependencies, settings,
    secret bindings (never a value), volumes, actions, and what a provision would make with the lease it needs
    (preview#AppInstanceProvision). Provision, Start, Stop, Restart and Remove post request#InstanceAction: it runs now
    when the action opens no vault item or the environment has machine access, else it asks for the lease and this page
    goes to the lease dialog (System › Vaults › Lease); the action runs once an approver opens it. The page reads rows
    only; nothing here reaches a host as it renders. The manager link (§4.4, M2): the link as this manager holds it
    (get#InstanceLink, from memory and the row), and for an instance this manager did not make, a pairing code
    (create#InstancePairingCode) shown once after the redirect with this manager's address and link key fingerprint;
    Revoke unpins the instance's link key and closes its link. Deploys (§4.6, M3): Deploy posts request#InstanceDeploy
    with a new image or a component's commit (refused without a passed run of the environment's required pipeline for
    the commit), and Roll back on a done deploy action goes back to the versions it recorded (refused across a schema
    change); each runs now or goes to the lease dialog, as the actions do. Rotate on a secret binding (§4.7, M5) posts
    request#InstanceRotation: a new value at its source, on each instance that uses it, then the item's next revision; it
    runs now or goes to the lease dialog, and one the manager cannot change is refused with what to do by hand. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Instance" default-menu-include="false">

    <parameter name="appInstanceId" required="true"/>

    <transition name="requestInstanceAction" method="post"><service-call name="org.moqui.dev.InstanceServices.request#InstanceAction"/>
        <conditional-response url="../../Vaults/Lease"><condition><expression>leaseId</expression></condition>
            <parameter name="leaseId"/></conditional-response>
        <default-response url="."/></transition>
    <transition name="instanceDetail"><default-response url="."/></transition>
    <transition name="requestDeploy" method="post"><service-call name="org.moqui.dev.InstanceServices.request#InstanceDeploy"/>
        <conditional-response url="../../Vaults/Lease"><condition><expression>leaseId</expression></condition>
            <parameter name="leaseId"/></conditional-response>
        <default-response url="."/><error-response url="."/></transition>
    <transition name="approveDeploy" method="post">
        <service-call name="org.moqui.dev.InstanceServices.approve#InstanceDeploy" in-map="{instanceActionId:instanceActionId}"/>
        <default-response url="."/><error-response url="."/></transition>
    <transition name="rollbackDeploy" method="post">
        <service-call name="org.moqui.dev.InstanceServices.request#InstanceDeploy"
                in-map="{appInstanceId:appInstanceId, rollbackOfActionId:rollbackOfActionId}"/>
        <conditional-response url="../../Vaults/Lease"><condition><expression>leaseId</expression></condition>
            <parameter name="leaseId"/></conditional-response>
        <default-response url="."/><error-response url="."/></transition>
    <transition name="makePairingCode" method="post">
        <service-call name="org.moqui.dev.InstanceLinkServices.create#InstancePairingCode" in-map="{appInstanceId:appInstanceId}" out-map="codeOut"/>
        <actions><!-- shown once, after the redirect; only its hash is kept -->
            <script>if (!ec.message.hasError()) { ec.web.sessionAttributes.newInstancePairing = codeOut }</script></actions>
        <default-response url="."/><error-response url="."/>
    </transition>
    <transition name="confirmLinkAddress" method="post">
        <service-call name="org.moqui.dev.InstanceLinkServices.confirm#InstanceLinkAddress" in-map="{appInstanceId:appInstanceId}"/>
        <default-response url="."/><error-response url="."/>
    </transition>
    <transition name="requestRotation" method="post">
        <service-call name="org.moqui.dev.InstanceServices.request#InstanceRotation"
                in-map="{appInstanceId:appInstanceId, bindingKey:bindingKey}"/>
        <conditional-response url="../../Vaults/Lease"><condition><expression>leaseId</expression></condition>
            <parameter name="leaseId"/></conditional-response>
        <default-response url="."/><error-response url="."/>
    </transition>
    <transition name="revokeLink" method="post">
        <service-call name="org.moqui.dev.InstanceLinkServices.revoke#InstanceLink" in-map="{appInstanceId:appInstanceId}"/>
        <default-response url="."/><error-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="moqui.server.instance.AppInstance" value-field="appInstance"/>
        <set field="recordFound" from="appInstance != null"/>
        <entity-find entity-name="moqui.server.instance.AppInstanceDependency" list="dependencyList">
            <econdition field-name="appInstanceId"/></entity-find>
        <entity-find entity-name="moqui.server.instance.AppInstanceSecret" list="secretList">
            <econdition field-name="appInstanceId"/><order-by field-name="secretName"/></entity-find>
        <entity-find entity-name="moqui.server.instance.AppInstanceEnv" list="envList">
            <econdition field-name="appInstanceId"/><order-by field-name="envName"/></entity-find>
        <entity-find entity-name="moqui.server.instance.AppInstanceVolume" list="volumeList">
            <econdition field-name="appInstanceId"/></entity-find>
        <entity-find entity-name="moqui.server.instance.InstanceAction" list="actionList" limit="20">
            <econdition field-name="appInstanceId"/><order-by field-name="-startDate"/></entity-find>
        <!-- the preview, only for INSTANCE_ADMIN (the service asks it) and only before the container is made -->
        <set field="preview" from="null"/>
        <if condition="recordFound &amp;&amp; !appInstance.instanceUuid &amp;&amp; ec.user.hasPermission('INSTANCE_ADMIN')">
            <service-call name="org.moqui.dev.InstanceServices.preview#AppInstanceProvision" in-map="{appInstanceId:appInstanceId}"
                    out-map="previewOut" ignore-error="true" transaction="force-new"/>
            <set field="preview" from="previewOut?.preview"/>
            <set field="previewError" from="ec.message.hasError() ? ec.message.getErrorsString() : null"/>
            <script>ec.message.clearErrors()</script>
        </if>
        <set field="made" from="recordFound &amp;&amp; !!appInstance.instanceUuid"/>
        <!-- the manager link: what this manager holds of it now, for INSTANCE_ADMIN (the service asks it) -->
        <set field="newPairing" from="ec.web?.sessionAttributes?.remove('newInstancePairing') || null"/>
        <set field="link" from="null"/>
        <if condition="recordFound &amp;&amp; ec.user.hasPermission('INSTANCE_ADMIN')">
            <service-call name="org.moqui.dev.InstanceLinkServices.get#InstanceLink" in-map="{appInstanceId:appInstanceId}"
                    out-map="link" ignore-error="true" transaction="force-new"/>
            <set field="linkError" from="ec.message.hasError() ? ec.message.getErrorsString() : null"/>
            <script>ec.message.clearErrors()</script>
        </if>
    </actions>
    <widgets>
        <section name="NotFound" condition="!recordFound"><widgets>
            <label text="Not available" type="h4"/>
            <link url="../InstanceList" text="Instances"/>
        </widgets></section>
        <section name="Found" condition="recordFound"><widgets>
            <container-box><box-header title="Instance ${appInstanceId}"/><box-toolbar>
                <section name="NotMadeActions" condition="!made"><widgets>
                <form-single name="Provision" transition="requestInstanceAction">
                    <field name="appInstanceId"><default-field><hidden/></default-field></field>
                    <field name="actionEnumId"><default-field><hidden default-value="IatProvision"/></default-field></field>
                    <field name="submitButton"><default-field title="Provision"><submit/></default-field></field>
                </form-single>
                </widgets></section>
                <section name="MadeActions" condition="made"><widgets>
                <form-single name="Start" transition="requestInstanceAction">
                    <field name="appInstanceId"><default-field><hidden/></default-field></field>
                    <field name="actionEnumId"><default-field><hidden default-value="IatStart"/></default-field></field>
                    <field name="submitButton"><default-field title="Start"><submit/></default-field></field>
                </form-single>
                <form-single name="Stop" transition="requestInstanceAction">
                    <field name="appInstanceId"><default-field><hidden/></default-field></field>
                    <field name="actionEnumId"><default-field><hidden default-value="IatStop"/></default-field></field>
                    <field name="submitButton"><default-field title="Stop"><submit/></default-field></field>
                </form-single>
                <form-single name="Restart" transition="requestInstanceAction">
                    <field name="appInstanceId"><default-field><hidden/></default-field></field>
                    <field name="actionEnumId"><default-field><hidden default-value="IatRestart"/></default-field></field>
                    <field name="submitButton"><default-field title="Restart"><submit/></default-field></field>
                </form-single>
                <container-dialog id="DeployDialog" button-text="Deploy" type="primary">
                    <label type="p" text="A new image of its kind, or a component's commit over its link. Only a commit the environment's required pipeline passed is deployed; a change that touches its database backs it up first, and a deploy that opens vault items asks for its lease."/>
                    <form-single name="Deploy" transition="requestDeploy">
                        <field name="appInstanceId"><default-field><hidden/></default-field></field>
                        <field name="instanceImageId"><default-field title="New image">
                            <drop-down allow-empty="true"><entity-options key="${instanceImageId}" text="${instanceImageId}: ${imageName}">
                                <entity-find entity-name="moqui.server.instance.InstanceImage">
                                    <econdition field-name="instanceKindId" from="appInstance?.instanceKindId"/>
                                    <order-by field-name="instanceImageId"/></entity-find></entity-options></drop-down>
                        </default-field></field>
                        <field name="componentName"><default-field title="Or a component"><text-line size="30"/></default-field></field>
                        <field name="repositoryId"><default-field title="Its repository" tooltip="A repository whose CI environment deploys to this environment: its pipeline must have passed for the commit, and the instance fetches from that environment's clone URL"><text-line size="30"/></default-field></field>
                        <field name="refName"><default-field title="Its branch"><text-line size="20" default-value="main"/></default-field></field>
                        <field name="commitId"><default-field title="Commit" tooltip="The component's commit, which its pipeline passed; an image is gated on the revision its row records"><text-line size="42"/></default-field></field>
                        <field name="submitButton"><default-field title="Deploy"><submit confirmation="Deploy to ${appInstanceId}?"/></default-field></field>
                    </form-single>
                </container-dialog>
                <form-single name="Remove" transition="requestInstanceAction">
                    <field name="appInstanceId"><default-field><hidden/></default-field></field>
                    <field name="actionEnumId"><default-field><hidden default-value="IatRemove"/></default-field></field>
                    <field name="removeVolumes"><default-field title="Remove its volumes (its data)"><check><option key="true" text=" "/></check></default-field></field>
                    <field name="submitButton"><default-field title="Remove"><submit confirmation="Remove the container of ${appInstanceId}?"/></default-field></field>
                </form-single>
                </widgets></section>
            </box-toolbar><box-body>
                <form-single name="InstanceState" map="appInstance" skip-start="true" skip-end="true">
                    <field name="instanceKindId"><default-field title="Kind"><display/></default-field></field>
                    <field name="environmentId"><default-field title="Environment"><display/></default-field></field>
                    <field name="clusterId"><default-field title="Cluster"><display/></default-field></field>
                    <field name="instanceHostId"><default-field title="Host"><display/></default-field></field>
                    <field name="instanceImageId"><default-field title="Image"><display/></default-field></field>
                    <field name="instanceName"><default-field title="Container"><display/></default-field></field>
                    <field name="hostName"><default-field><display/></default-field></field>
                    <field name="hostPort"><default-field><display/></default-field></field>
                    <field name="desiredStateEnumId"><default-field title="Desired state">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/></default-field></field>
                    <field name="observedState"><default-field title="Observed"><display/></default-field></field>
                    <field name="observedHealth"><default-field title="Health"><display/></default-field></field>
                    <field name="observedDate"><default-field title="Seen"><display format="yyyy-MM-dd HH:mm"/></default-field></field>
                    <field name="sealState"><default-field title="Seal"><display/></default-field></field>
                    <field name="linkState"><default-field title="Link"><display/></default-field></field>
                    <field name="imageDigest"><default-field title="Image digest"><display/></default-field></field>
                </form-single>
            </box-body></container-box>

            <section name="NewPairingCode" condition="newPairing"><widgets>
                <container-box type="success"><box-header title="Pairing code"/><box-body>
                    <label type="p" text="Enter it on the instance with this manager's address and link key fingerprint (pair#Manager). It pairs this instance, once, within ${newPairing.expiresMinutes} minutes. It is shown only this once; make another if you lose it."/>
                    <label type="pre" text="${newPairing.code}" style="text-h6"/>
                    <label type="div" text="Manager: ${newPairing.managerUrl || '(manage@link-url is not set: give the address the instance reaches this server at)'}"/>
                    <label type="div" text="Manager link key: ${newPairing.managerFingerprint}"/>
                </box-body></container-box>
            </widgets></section>

            <container-box condition="link || linkError"><box-header title="Manager link"/><box-toolbar>
                <form-single name="PairingCode" transition="makePairingCode">
                    <field name="appInstanceId"><default-field><hidden/></default-field></field>
                    <field name="submitButton"><default-field title="Make a pairing code"><submit/></default-field></field>
                </form-single>
                <form-single name="ConfirmLinkAddress" transition="confirmLinkAddress">
                    <field name="appInstanceId"><default-field><hidden/></default-field></field>
                    <field name="submitButton"><default-field title="Allow a new address"><submit confirmation="Let the next link of ${appInstanceId} come from another address? A holder of its stolen link key could take its place."/></default-field></field>
                </form-single>
                <form-single name="RevokeLink" transition="revokeLink">
                    <field name="appInstanceId"><default-field><hidden/></default-field></field>
                    <field name="submitButton"><default-field title="Revoke"><submit confirmation="Unpin the link key of ${appInstanceId} and close its link? It pairs again only with a new code."/></default-field></field>
                </form-single>
            </box-toolbar><box-body>
                <label text="${linkError}" type="div" style="text-danger" condition="linkError"/>
                <label text="${link?.linked ? 'Linked (generation ' + link.generation + ', from ' + link.remote + '), ' + (link.sealState || 'state not reported') + (link.serving ? ', taking commands' : '') : 'Not linked: ' + (link?.linkState || 'never paired')}" type="div" condition="link"/>
                <label text="Health ${link?.health}, version ${link?.binaryVersion}, schema ${link?.schemaHash || '(sealed)'}, members ${link?.clusterMembers || '-'}" type="div" condition="link?.linked"/>
                <label text="Its link key: ${link?.linkKeyFingerprint || '(not paired)'}" type="div" condition="link"/>
                <label text="Paired ${appInstance.linkPairedDate ? ec.l10n.format(appInstance.linkPairedDate, 'yyyy-MM-dd HH:mm') : '-'}; bootstrap bundle taken ${appInstance.bootstrapDate ? ec.l10n.format(appInstance.bootstrapDate, 'yyyy-MM-dd HH:mm') : '-'}; last from ${appInstance.linkAddress || '-'}" type="div" condition="link"/>
                <label text="This manager's link key: ${link?.managerFingerprint || '(the listener takes no manager links)'}${link?.managerUrl ? ', dialed at ' + link.managerUrl : ''}" type="div" condition="link"/>
            </box-body></container-box>

            <container-box condition="preview || previewError"><box-header title="Provision preview"/><box-body>
                <label text="${previewError}" type="div" style="text-danger" condition="previewError"/>
                <label text="Containers: ${(preview?.containers || []).map(c => c.name + ' (' + c.image + ' on ' + c.instanceHostId + ')').join(', ')}" type="div" condition="preview"/>
                <label text="Volumes: ${(preview?.volumes || []).join(', ')}" type="div" condition="preview"/>
                <label text="Networks: ${(preview?.networks || []).join(', ')}" type="div" condition="preview"/>
                <label text="Databases: ${(preview?.databases || []).map(d => d.database + ' and user ' + d.user + ' on ' + d.on).join(', ')}" type="div" condition="preview"/>
                <label text="Deposited into vault ${preview?.vaultId}: ${(preview?.deposits || []).map(d => d.bindingKey).join(', ')}" type="div" condition="preview"/>
                <label text="Host names: ${(preview?.hostNames || []).join(', ')}" type="div" condition="preview"/>
                <label text="${(preview?.leaseBindings || []).length ? 'The lease it needs, and where each login goes: ' + preview.destinations.join(', ') + (preview.machineAccess ? ' (the environment has machine access)' : '') : 'It opens no vault item: it needs no lease'}" type="div" condition="preview"/>
            </box-body></container-box>

            <container-box><box-header title="Dependencies"/><box-body>
                <form-list name="DependencyList" list="dependencyList" skip-form="true">
                    <field name="dependencyRole"><default-field title="Role"><display/></default-field></field>
                    <field name="dependsOnInstanceId"><default-field title="Instance">
                        <link url="instanceDetail" text="${dependsOnInstanceId || ''}" parameter-map="{appInstanceId:dependsOnInstanceId}" link-type="anchor" condition="dependsOnInstanceId"/></default-field></field>
                    <field name="databaseHostId"><default-field title="Database host"><display/></default-field></field>
                </form-list>
            </box-body></container-box>

            <container-box><box-header title="Secret bindings"/><box-body>
                <label text="Each is a vault item of the environment's vault, by its binding; no value is shown here or kept on these rows." type="p"/>
                <form-list name="SecretList" list="secretList" skip-form="true">
                    <field name="secretName"><default-field title="Secret"><display/></default-field></field>
                    <field name="bindingKey"><default-field title="Binding"><display/></default-field></field>
                    <field name="vaultItemTypeId"><default-field title="Item type"><display/></default-field></field>
                    <field name="fileName"><default-field title="File"><display text="${fileName ? '/run/secrets/' + fileName : ''}"/></default-field></field>
                    <field name="envName"><default-field title="Named by"><display/></default-field></field>
                    <field name="generated"><default-field title="Made here"><display/></default-field></field>
                    <field name="depositedDate"><default-field title="Deposited"><display format="yyyy-MM-dd HH:mm"/></default-field></field>
                    <field name="rotate"><default-field title="">
                        <link url="requestRotation" text="Rotate" link-type="hidden-form" parameter-map="{appInstanceId:appInstanceId, bindingKey:bindingKey}"
                                condition="made" confirmation="Set a new ${secretName} at its source, put it on the instances that use it and write it to the vault?"/>
                    </default-field></field>
                </form-list>
            </box-body></container-box>

            <container-box><box-header title="Settings and volumes"/><box-body>
                <form-list name="EnvList" list="envList" skip-form="true">
                    <field name="envName"><default-field title="Setting"><display/></default-field></field>
                    <field name="envValue"><default-field title="Value"><display/></default-field></field>
                </form-list>
                <form-list name="VolumeList" list="volumeList" skip-form="true">
                    <field name="mountPoint"><default-field><display/></default-field></field>
                    <field name="volumeName"><default-field title="Volume"><display/></default-field></field>
                </form-list>
            </box-body></container-box>

            <container-box><box-header title="Actions"/><box-body>
                <form-list name="ActionList" list="actionList" skip-form="true">
                    <field name="startDate"><default-field title="Started"><display format="yyyy-MM-dd HH:mm:ss"/></default-field></field>
                    <field name="actionEnumId"><default-field title="Action">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/></default-field></field>
                    <field name="statusEnumId"><default-field title="State">
                        <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/></default-field></field>
                    <field name="leaseId"><default-field title="Lease">
                        <link url="../../Vaults/Lease" text="${leaseId || ''}" parameter-map="{leaseId:leaseId}" link-type="anchor" condition="leaseId"/></default-field></field>
                    <field name="machineAccess"><default-field title="Machine"><display/></default-field></field>
                    <field name="userId"><default-field title="By"><display/></default-field></field>
                    <field name="versionBefore"><default-field title="Before"><display/></default-field></field>
                    <field name="versionAfter"><default-field title="After"><display/></default-field></field>
                    <field name="schemaHashAfter"><default-field title="Schema">
                        <display text="${schemaHashBefore &amp;&amp; schemaHashAfter &amp;&amp; schemaHashBefore != schemaHashAfter ? 'changed' : ''}"/></default-field></field>
                    <field name="gitDeploymentId"><default-field title="Deployment"><display/></default-field></field>
                    <field name="report"><default-field><display/></default-field></field>
                    <field name="approve"><default-field title="">
                        <link url="approveDeploy" text="Approve" link-type="hidden-form"
                                parameter-map="{appInstanceId:appInstanceId, instanceActionId:instanceActionId}"
                                confirmation="Approve the deploy of action ${instanceActionId}? It runs now, as it was asked."
                                condition="statusEnumId == 'IasWaiting' &amp;&amp; !leaseId &amp;&amp; (actionEnumId == 'IatDeploy' || actionEnumId == 'IatRollback')"/>
                    </default-field></field>
                    <field name="rollback"><default-field title="">
                        <link url="rollbackDeploy" text="Roll back" link-type="hidden-form" btn-type="danger"
                                parameter-map="{appInstanceId:appInstanceId, rollbackOfActionId:instanceActionId}"
                                confirmation="Roll ${appInstanceId} back to the versions before action ${instanceActionId}?"
                                condition="(actionEnumId == 'IatDeploy' || actionEnumId == 'IatRollback') &amp;&amp; statusEnumId == 'IasDone'"/>
                    </default-field></field>
                </form-list>
            </box-body></container-box>
        </widgets></section>
    </widgets>
</screen>
