<!-- Rotation (plans/Vault-Instances.md §4.7, M5; docs/Run-Deploy.md "Rotation"): an environment's operational items with
    their age, rotation age and whether each is due (get#InstanceRotations: rows only, no value). The manager rotates an
    item whose kind has a rotate service; another shows what to do by hand. Rotate due and Rotate all (after an incident,
    Sealed-Secrets §3.12) post request#InstanceRotation: under the environment's machine access it runs now, else it asks
    for one lease of the items and this page goes to the lease dialog. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Rotation" default-menu-index="7">

    <parameter name="environmentId"/>

    <transition name="requestRotation" method="post">
        <service-call name="org.moqui.dev.InstanceServices.request#InstanceRotation"
                in-map="{environmentId:environmentId, bindingKey:bindingKey, all:all, dueOnly:dueOnly}"/>
        <conditional-response url="../../Vaults/Lease"><condition><expression>leaseId</expression></condition>
            <parameter name="leaseId"/></conditional-response>
        <default-response url="."/><error-response url="."/>
    </transition>
    <transition name="instanceDetail"><default-response url="../InstanceDetail"/></transition>

    <actions>
        <set field="itemList" from="[]"/>
        <set field="dueCount" from="0"/>
        <if condition="environmentId &amp;&amp; ec.user.hasPermission('INSTANCE_ADMIN')">
            <service-call name="org.moqui.dev.InstanceServices.get#InstanceRotations" in-map="{environmentId:environmentId}"
                    out-map="rotationsOut" ignore-error="true" transaction="force-new"/>
            <set field="itemList" from="rotationsOut?.itemList || []"/>
            <set field="dueCount" from="rotationsOut?.dueCount || 0"/>
        </if>
    </actions>
    <widgets>
        <label text="Managed instances need the INSTANCE_ADMIN permission." type="p" condition="!ec.user.hasPermission('INSTANCE_ADMIN')"/>
        <form-single name="ChooseEnvironment" transition=".">
            <field name="environmentId"><default-field title="Environment">
                <drop-down allow-empty="true"><entity-options key="${environmentId}" text="${environmentName || environmentId}">
                    <entity-find entity-name="moqui.server.instance.InstanceEnvironment"><order-by field-name="environmentId"/></entity-find>
                </entity-options></drop-down>
            </default-field></field>
            <field name="submitButton"><default-field title="Show"><submit/></default-field></field>
        </form-single>
        <section name="EnvironmentRotation" condition="environmentId"><widgets>
            <container-box><box-header title="Items of environment ${environmentId}: ${dueCount} due"/><box-toolbar>
                <link url="requestRotation" text="Rotate due" link-type="hidden-form" btn-type="primary"
                        parameter-map="{environmentId:environmentId, dueOnly:'Y'}" condition="dueCount"
                        confirmation="Rotate each item of ${environmentId} past its age that the manager can change?"/>
                <link url="requestRotation" text="Rotate all" link-type="hidden-form" btn-type="danger"
                        parameter-map="{environmentId:environmentId, all:'Y'}"
                        confirmation="Rotate every item of ${environmentId} that the manager can change, as after an incident? Each is set at its source and on the instances that use it."/>
            </box-toolbar><box-body>
                <label text="An item the manager rotates is changed at its source, then on the instances that use it, then written as its next revision, which a member takes in when they next open the vault. An item it cannot change says what to do by hand: write the new value to the item in your vault client, marked rotated." type="p"/>
                <form-list name="RotationList" list="itemList" skip-form="true" paginate="false">
                    <field name="bindingKey"><default-field title="Item">
                        <display text="${itemName ? itemName + ' (' + bindingKey + ')' : bindingKey}"/></default-field></field>
                    <field name="appInstanceId"><default-field title="Instance">
                        <link url="instanceDetail" text="${appInstanceId}" link-type="anchor" parameter-map="{appInstanceId:appInstanceId}" condition="appInstanceId"/>
                    </default-field></field>
                    <field name="vaultItemTypeId"><default-field title="Type"><display/></default-field></field>
                    <field name="ageDays"><default-field title="Age (days)"><display/></default-field></field>
                    <field name="rotationDays"><default-field title="Rotation age"><display text="${rotationDays || 'none'}"/></default-field></field>
                    <field name="due"><default-field title="Due"><display text="${due ? 'Yes' : 'No'}"/></default-field></field>
                    <field name="how"><default-field title="How">
                        <display text="${rotatable ? (deposited ? 'By the manager, once a member takes it in' : 'By the manager') : byHand}"/>
                    </default-field></field>
                    <field name="rotate"><default-field title="">
                        <link url="requestRotation" text="Rotate" link-type="hidden-form"
                                parameter-map="{environmentId:environmentId, bindingKey:bindingKey}" condition="rotatable &amp;&amp; !deposited"
                                confirmation="Set a new value of ${bindingKey} at its source, put it on the instances that use it and write it to the vault?"/>
                    </default-field></field>
                    <columns type="mobile">
                        <column><field-ref name="bindingKey"/><field-ref name="how"/></column>
                        <column><field-ref name="due"/><field-ref name="rotate"/></column>
                    </columns>
                </form-list>
            </box-body></container-box>
        </widgets></section>
    </widgets>
</screen>
