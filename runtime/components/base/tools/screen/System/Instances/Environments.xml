<!-- The environments (plans/Vault-Instances.md §4.1): production, staging, demo; each with its operational vault, approvers,
    required pipeline, machine access, unseal policy, transport and lease limit (store#InstanceEnvironment). Machine access
    here lets the environment's operations use the items the vault gave it (System › Vaults) with no approver: those
    items are then as strong as this server's own keys. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Environments" default-menu-index="2">

    <transition name="storeEnvironment" method="post"><service-call name="org.moqui.dev.InstanceServices.store#InstanceEnvironment"/>
        <default-response url="."/></transition>

    <actions>
        <entity-find entity-name="moqui.server.instance.InstanceEnvironment" list="environmentList">
            <order-by field-name="environmentId"/></entity-find>
    </actions>
    <widgets>
        <container-dialog id="StoreEnvironmentDialog" button-text="New environment">
            <form-single name="StoreEnvironment" transition="storeEnvironment">
                <field name="environmentId"><default-field title="Id"><text-line size="30"/></default-field></field>
                <field name="environmentName"><default-field title="Name"><text-line size="40"/></default-field></field>
                <field name="environmentTypeEnumId"><default-field title="Type">
                    <drop-down><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration"><econdition field-name="enumTypeId" value="InstanceEnvironmentType"/>
                            <order-by field-name="sequenceNum"/></entity-find></entity-options></drop-down>
                </default-field></field>
                <field name="vaultId"><default-field title="Operational vault">
                    <drop-down allow-empty="true"><entity-options key="${vaultId}" text="${vaultName || vaultId}">
                        <entity-find entity-name="moqui.security.vault.Vault"><econdition field-name="vaultKindEnumId" value="VkOperational"/>
                            <order-by field-name="vaultName"/></entity-find></entity-options></drop-down>
                </default-field></field>
                <field name="approverUserGroupId"><default-field title="Approver group"><text-line size="30"/></default-field></field>
                <field name="requiredPipeline"><default-field title="Required pipeline"><text-line size="30"/></default-field></field>
                <field name="machineAccess"><default-field title="Machine access" tooltip="Its operations use the items the vault gave it, with no approver">
                    <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field></field>
                <field name="automaticRecovery"><default-field title="Automatic recovery" tooltip="An automatic Monitor recovery policy may act on its instances with no approver; needs machine access too">
                    <drop-down><option key="N" text="No"/><option key="Y" text="Yes"/></drop-down></default-field></field>
                <field name="unsealPolicyEnumId"><default-field title="Unseal policy">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration"><econdition field-name="enumTypeId" value="InstanceUnsealPolicy"/>
                            <order-by field-name="sequenceNum"/></entity-find></entity-options></drop-down>
                </default-field></field>
                <field name="unsealMethod"><default-field title="Unseal method">
                    <drop-down allow-empty="true"><option key="transit"/><option key="tpm"/><option key="passphrase"/><option key="shamir"/></drop-down>
                </default-field></field>
                <field name="transportEnumId"><default-field title="Transport">
                    <drop-down allow-empty="true"><entity-options key="${enumId}" text="${description}">
                        <entity-find entity-name="moqui.basic.Enumeration"><econdition field-name="enumTypeId" value="InstanceTransport"/>
                            <order-by field-name="sequenceNum"/></entity-find></entity-options></drop-down>
                </default-field></field>
                <field name="leaseLimitMinutes"><default-field title="Lease limit (minutes)"><text-line size="6"/></default-field></field>
                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
            </form-single>
        </container-dialog>

        <form-list name="EnvironmentList" list="environmentList" skip-form="true">
            <field name="environmentId"><default-field title="Id"><display/></default-field></field>
            <field name="environmentName"><default-field title="Name"><display/></default-field></field>
            <field name="environmentTypeEnumId"><default-field title="Type">
                <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/></default-field></field>
            <field name="vaultId"><default-field title="Vault"><display/></default-field></field>
            <field name="machineAccess"><default-field title="Machine access"><display/></default-field></field>
            <field name="requiredPipeline"><default-field title="Pipeline"><display/></default-field></field>
            <field name="leaseLimitMinutes"><default-field title="Lease limit"><display/></default-field></field>
        </form-list>
    </widgets>
</screen>
