<!-- The kinds (seed data, framework/data/InstanceTypeData.xml): what each needs from a vault (its secrets: made and deposited
    by a provision, or leased; each given to its container as a file) and what it depends on. Read only. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Kinds" default-menu-index="6">

    <actions>
        <entity-find entity-name="moqui.server.instance.InstanceKind" list="kindList"><order-by field-name="instanceKindId"/></entity-find>
        <entity-find entity-name="moqui.server.instance.InstanceKindSecret" list="secretList">
            <order-by field-name="instanceKindId,secretName"/></entity-find>
        <entity-find entity-name="moqui.server.instance.InstanceKindDependency" list="dependencyList">
            <order-by field-name="instanceKindId,dependencyRole"/></entity-find>
    </actions>
    <widgets>
        <form-list name="KindList" list="kindList" skip-form="true">
            <field name="instanceKindId"><default-field title="Kind"><display/></default-field></field>
            <field name="description"><default-field><display/></default-field></field>
            <field name="containerPort"><default-field title="Port"><display/></default-field></field>
            <field name="confName"><default-field title="Database"><display/></default-field></field>
        </form-list>
        <label text="Secrets" type="h5"/>
        <form-list name="KindSecretList" list="secretList" skip-form="true">
            <field name="instanceKindId"><default-field title="Kind"><display/></default-field></field>
            <field name="secretName"><default-field title="Secret"><display/></default-field></field>
            <field name="bindingPattern"><default-field title="Binding"><display/></default-field></field>
            <field name="vaultItemTypeId"><default-field title="Item type"><display/></default-field></field>
            <field name="fileName"><default-field title="File"><display/></default-field></field>
            <field name="envName"><default-field title="Named by"><display/></default-field></field>
            <field name="generated"><default-field title="Made here"><display/></default-field></field>
        </form-list>
        <label text="Dependencies" type="h5"/>
        <form-list name="KindDependencyList" list="dependencyList" skip-form="true">
            <field name="instanceKindId"><default-field title="Kind"><display/></default-field></field>
            <field name="dependencyRole"><default-field title="Role"><display/></default-field></field>
            <field name="allowedKindId"><default-field title="Served by"><display/></default-field></field>
            <field name="optional"><default-field><display/></default-field></field>
        </form-list>
    </widgets>
</screen>
