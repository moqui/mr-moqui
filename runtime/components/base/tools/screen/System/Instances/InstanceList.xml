<!-- The fleet: each instance with its kind, environment, host, desired state and what its host last said (the reconcile
    job writes it); a new instance from an image's kind (create#AppInstance makes rows only, nothing on a host). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Instances" default-menu-index="1">

    <transition name="instanceDetail"><default-response url="../InstanceDetail"/></transition>
    <transition name="createAppInstance" method="post"><service-call name="org.moqui.dev.InstanceServices.create#AppInstance"/>
        <default-response url="../InstanceDetail"/></transition>
    <!-- the actions of an instance, as its page posts them: request#InstanceAction runs it, or asks for its lease -->
    <transition name="requestInstanceAction" method="post"><service-call name="org.moqui.dev.InstanceServices.request#InstanceAction"/>
        <conditional-response url="../../Vaults/Lease"><condition><expression>leaseId</expression></condition>
            <parameter name="leaseId"/></conditional-response>
        <default-response url="."/></transition>

    <actions>
        <entity-find entity-name="moqui.server.instance.AppInstance" list="instanceList">
            <search-form-inputs default-order-by="environmentId,instanceName"/>
        </entity-find>
    </actions>
    <widgets>
        <container-dialog id="CreateInstanceDialog" button-text="New instance">
            <form-single name="CreateInstance" transition="createAppInstance">
                <field name="instanceName"><default-field tooltip="Its container's name; its volumes' names start with it">
                    <text-line size="40"/></default-field></field>
                <field name="instanceImageId"><default-field title="Image">
                    <drop-down>
                        <entity-options key="${instanceImageId}" text="${imageName} (${kindDescription})">
                            <entity-find entity-name="moqui.server.instance.InstanceImageDetail"><order-by field-name="imageName"/></entity-find>
                        </entity-options>
                    </drop-down>
                </default-field></field>
                <field name="environmentId"><default-field title="Environment">
                    <drop-down>
                        <entity-options key="${environmentId}" text="${environmentName || environmentId}">
                            <entity-find entity-name="moqui.server.instance.InstanceEnvironment"><order-by field-name="environmentId"/></entity-find>
                        </entity-options>
                    </drop-down>
                </default-field></field>
                <field name="instanceHostId"><default-field title="Host">
                    <drop-down>
                        <entity-options key="${instanceHostId}" text="${instanceHostId}: ${typeDescription} ${hostAddress}">
                            <entity-find entity-name="moqui.server.instance.InstanceHostDetail"><order-by field-name="instanceHostId"/></entity-find>
                        </entity-options>
                    </drop-down>
                </default-field></field>
                <field name="hostName"><default-field tooltip="The name it is reached by, when it serves the web"><text-line size="40"/></default-field></field>
                <field name="hostPort"><default-field tooltip="The host's port its service is published on, on the host's loopback only (a proxy on the host reaches it)">
                    <text-line size="8"/></default-field></field>
                <field name="databaseInstanceId"><default-field title="Database instance">
                    <drop-down allow-empty="true">
                        <entity-options key="${appInstanceId}" text="${instanceName} (${instanceKindId})">
                            <entity-find entity-name="moqui.server.instance.AppInstance">
                                <econdition field-name="instanceKindId" operator="in" value="postgres,mysql"/>
                                <order-by field-name="instanceName"/></entity-find>
                        </entity-options>
                    </drop-down>
                </default-field></field>
                <field name="databaseHostId"><default-field title="Or database host">
                    <drop-down allow-empty="true">
                        <entity-options key="${databaseHostId}" text="${databaseHostId}: ${hostAddress}">
                            <entity-find entity-name="moqui.server.instance.DatabaseHost"><order-by field-name="databaseHostId"/></entity-find>
                        </entity-options>
                    </drop-down>
                </default-field></field>
                <field name="searchInstanceId"><default-field title="Search instance">
                    <drop-down allow-empty="true">
                        <entity-options key="${appInstanceId}" text="${instanceName}">
                            <entity-find entity-name="moqui.server.instance.AppInstance">
                                <econdition field-name="instanceKindId" value="opensearch"/>
                                <order-by field-name="instanceName"/></entity-find>
                        </entity-options>
                    </drop-down>
                </default-field></field>
                <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
            </form-single>
        </container-dialog>

        <form-list name="InstanceList" list="instanceList" skip-form="true">
            <field name="appInstanceId"><default-field title="Instance"><link url="instanceDetail" text="${appInstanceId}" link-type="anchor"/></default-field></field>
            <field name="instanceKindId"><default-field title="Kind"><display/></default-field></field>
            <field name="environmentId"><default-field title="Environment"><display/></default-field></field>
            <field name="instanceHostId"><default-field title="Host"><display/></default-field></field>
            <field name="desiredStateEnumId"><default-field title="Desired">
                <display-entity entity-name="moqui.basic.Enumeration" key-field-name="enumId" text="${description}"/></default-field></field>
            <field name="observedState"><default-field title="Observed"><display/></default-field></field>
            <field name="observedDate"><default-field title="Seen"><display format="yyyy-MM-dd HH:mm"/></default-field></field>
            <field name="hostName"><default-field><display/></default-field></field>
        </form-list>
    </widgets>
</screen>
