<!-- Settings (plans/archive/Admin-Screens-Down.md): the instance's registered settings with where each value comes from
    (InstanceSettings) and the translations of messages and of registered labels (Localization), over
    org.moqui.admin.ConfigurationServices, which check ADMIN_SETTINGS_VIEW and ADMIN_SETTINGS_MANAGE themselves; and the
    settings index (SettingsHome), each owner's registered settings landing the viewer may open, over
    org.moqui.admin.ReadinessServices.find#Settings. Its
    screens are the files of Settings/, with the sibling names an app that shows them under its own root uses (README,
    "Mounting the administration screens"), so their links to each other are relative. The conf files themselves are
    Configuration (Conf/), System's own. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Settings" default-menu-index="5" default-menu-group="Administration" menu-image="sym_o_settings" menu-image-type="icon">
    <subscreens default-item="InstanceSettings"/>
    <widgets>
        <subscreens-panel id="SystemSettingsPanel" type="tab"/>
    </widgets>
</screen>
