<!-- One remote MCP server: its URL, agents, limits and credential (set, never shown); the tools rows allow, each with
    its classification; and a test that lists the server's tools now, with Allow for each. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="MCP Server" default-menu-index="4" default-menu-include="false">

    <parameter name="mcpServerId" required="true"/>
    <parameter name="listNow"/>

    <transition name="storeServer"><service-call name="org.moqui.agent.RemoteAgentServices.store#AgentMcpServer"/>
        <default-response url="." parameter-map="{mcpServerId:mcpServerId}"/></transition>
    <transition name="setCredential"><service-call name="org.moqui.agent.RemoteAgentServices.store#AgentMcpServer"
            in-map="{mcpServerId:mcpServerId, authKind:authKind, authSecret:authSecret, authUsername:authUsername, authHeader:authHeader}"/>
        <default-response url="." parameter-map="{mcpServerId:mcpServerId}"/></transition>
    <transition name="storeTool"><service-call name="org.moqui.agent.RemoteAgentServices.store#AgentMcpServerTool"/>
        <default-response url="." parameter-map="{mcpServerId:mcpServerId}"/></transition>
    <transition name="listTools"><default-response url="." parameter-map="{mcpServerId:mcpServerId, listNow:'Y'}"/></transition>

    <actions>
        <entity-find-one entity-name="moqui.agent.AgentMcpServer" value-field="server"/>
        <set field="remoteToolList" from="[]"/>
        <entity-find entity-name="moqui.agent.AgentMcpServerTool" list="toolList">
            <econdition field-name="mcpServerId"/><order-by field-name="toolName"/></entity-find>
        <if condition="listNow == 'Y'">
            <service-call name="org.moqui.agent.RemoteAgentServices.test#AgentMcpServer" in-map="{mcpServerId:mcpServerId}"
                out-map="listed"/>
            <message>${listed?.ok == 'Y' ? 'Listed: ' + listed.message + ' (' + listed.protocol + ')' : 'Not listed: ' + listed?.message}</message>
            <set field="remoteToolList" from="listed?.toolList ?? []"/>
        </if>
    </actions>
    <widgets>
        <container-box><box-header title="MCP Server ${mcpServerId}"/><box-toolbar>
            <link url="listTools" text="List Tools Now"/></box-toolbar><box-body>
            <form-single name="EditServer" map="server" transition="storeServer">
                <field name="mcpServerId"><default-field><display/></default-field></field>
                <field name="serverName"><default-field title="Name"><text-line size="40"/></default-field></field>
                <field name="description"><default-field><text-area rows="3" cols="80"/></default-field></field>
                <field name="url"><default-field title="URL" tooltip="https, never an internal address unless Allow Private Network"><text-line size="80"/></default-field></field>
                <field name="perUserAuth"><default-field title="Per User Token" tooltip="Each user calls with a token of their own"><drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></default-field></field>
                <field name="allowedAgents"><default-field title="Allowed Agents" tooltip="Comma separated agent ids, * for all, empty for none"><text-line size="60"/></default-field></field>
                <field name="allowPrivateNetwork"><default-field title="Allow Private Network" tooltip="Loopback or LAN addresses, and http"><drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></default-field></field>
                <field name="timeoutSeconds"><default-field title="Timeout Seconds" tooltip="Else the conf's mcp call-timeout"><text-line size="6"/></default-field></field>
                <field name="disabled"><default-field><drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></default-field></field>
                <field name="credential"><default-field title="Credential">
                    <display text="${server?.authJson ? 'set' : 'none'}"/></default-field></field>
                <field name="authJson"><default-field><ignored/></default-field></field>
                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
            </form-single>
        </box-body></container-box>
        <container-box><box-header title="Credential"/><box-body>
            <form-single name="SetCredential" transition="setCredential">
                <field name="mcpServerId"><default-field><hidden/></default-field></field>
                <field name="authKind"><default-field title="Kind"><drop-down><option key="bearer"/><option key="basic"/>
                    <option key="header"/><option key="none"/></drop-down></default-field></field>
                <field name="authUsername"><default-field title="Username" tooltip="For basic"><text-line size="30"/></default-field></field>
                <field name="authHeader"><default-field title="Header Name" tooltip="For header"><text-line size="30"/></default-field></field>
                <field name="authSecret"><default-field title="Secret" tooltip="The key, password or header value; kept encrypted, never shown"><password size="40"/></default-field></field>
                <field name="submitButton"><default-field title="Set"><submit/></default-field></field>
            </form-single>
        </box-body></container-box>
        <container-box><box-header title="Allowed Tools"/><box-body>
            <form-list name="ToolList" list="toolList" transition="storeTool">
                <field name="mcpServerId"><default-field><hidden/></default-field></field>
                <field name="toolName"><header-field title="Tool"/><default-field><display/></default-field></field>
                <field name="classificationEnumId"><header-field title="Class" tooltip="Empty is EXTERNAL: each call asks for approval"/>
                    <default-field><drop-down allow-empty="true">
                        <entity-options key="${enumId}" text="${description}"><entity-find entity-name="moqui.basic.Enumeration">
                            <econdition field-name="enumTypeId" value="AgentClassification"/></entity-find></entity-options>
                    </drop-down></default-field></field>
                <field name="description"><header-field title="Description" tooltip="Replaces the server's own"/><default-field><text-line size="50"/></default-field></field>
                <field name="disabled"><default-field><drop-down allow-empty="true"><option key="Y"/><option key="N"/></drop-down></default-field></field>
                <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
            </form-list>
            <form-single name="AllowTool" transition="storeTool">
                <field name="mcpServerId"><default-field><hidden/></default-field></field>
                <field name="toolName"><default-field title="Allow Tool" tooltip="The server's own name of the tool"><text-line size="40"/></default-field></field>
                <field name="submitButton"><default-field title="Allow"><submit/></default-field></field>
            </form-single>
        </box-body></container-box>
        <section name="ListedSection" condition="remoteToolList"><widgets>
            <container-box><box-header title="Tools the Server Lists"/><box-body>
                <form-list name="RemoteToolList" list="remoteToolList" skip-form="true">
                    <field name="toolName"><header-field title="Tool"/><default-field><display/></default-field></field>
                    <field name="title"><default-field><display/></default-field></field>
                    <field name="description"><default-field><display/></default-field></field>
                    <field name="allowed"><header-field title="Allowed"/><default-field><display/></default-field></field>
                    <field name="allow"><header-field title=" "/><conditional-field condition="allowed != 'Y'">
                        <link url="storeTool" text="Allow" parameter-map="{mcpServerId:mcpServerId, toolName:toolName, disabled:'N'}"/></conditional-field>
                        <default-field><display text=" "/></default-field></field>
                </form-list>
            </box-body></container-box>
        </widgets></section>
    </widgets>
</screen>
