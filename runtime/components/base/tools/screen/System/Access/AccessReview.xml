<!-- AccessReview (plans/archive/Admin-Screens-Down.md; first IronStone Admin's, mr-boss design-admin §16 "Access/grant review"):
    the access and grant review of the groups chosen in Capabilities or of one group from GroupDetail, as of a date and
    time: each group's permission grants, app gates with their row rules, and members, every one named. One projection
    (org.moqui.admin.AccessServices.get#GrantReview, ADMIN_ACCESS_VIEW, made into rows by template/AccessReview.js) for the
    screen, its print (this screen in html-print) and its CSV (the list's export). Sealed permissions are left out and
    counted; allowed IPs, preference values and filter expressions are never in it.
    An app that names only some members (those of the organizations a user administers) has a screen of its own: it sets
    review (the rows of template/AccessReview.js with the users it names, the others counted), failure and
    emptyReviewText in its actions and includes ReviewPrepare and ReviewPage (README, "Mounting the administration
    screens"). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Access review" default-menu-include="false">
    <parameter name="groups"/>
    <parameter name="appName"/>
    <parameter name="asOfDate"/>

    <actions>
        <set field="groupsParameter" from="typeof groups === 'string' ? groups : Array.from(groups || []).join(',')"/>
        <set field="chosen" from="!!(groupsParameter || appName)"/>
        <if condition="chosen">
            <set field="groupIds" from="groupsParameter.split(',').map(id => id.trim()).filter(Boolean)"/>
            <!-- get#GrantReview's bound, answered here as a reason: a refusal is shown as its reason, anything else as unavailable
                (AdminCalls.read; ignore-error would clear it) -->
            <if condition="groupIds.length &gt; 60">
                <set field="failure" value="Review at most 60 groups at a time"/>
                <else>
                    <set field="called" from="ec.resource.script('component://framework/service/org/moqui/admin/AdminCalls.js').read('org.moqui.admin.AccessServices.get#GrantReview', {userGroupIdList:groupIds, appName:(appName || null), asOfDate:(asOfDate || null)}, 'The access review is not available')"/>
                    <set field="failure" from="called.failure"/>
                    <set field="review" from="called.out ? ec.resource.script('component://tools/template/AccessReview.js').view(called.out) : null"/>
                </else>
            </if>
        </if>
    </actions>
    <widgets>
        <!-- what the page below shows of review; a section's actions, so a screen of an app's own shares them -->
        <section name="ReviewPrepare">
            <actions>
                <set field="reviewRows" from="review?.reviewRows || []"/>
                <set field="groupRows" from="review?.groupRows || []"/>
                <set field="printing" from="sri.getRenderMode() === 'html-print'"/>
                <set field="reviewValues" from="{groups:(review?.groups || groupsParameter), appName:appName, asOfDate:asOfDate}"/>
                <set field="notes" from="groupRows.filter(row => row.noteText).map(row => row.groupDescription + ': ' + row.noteText)"/>
            </actions>
            <widgets/>
        </section>
        <section name="ReviewPage">
            <widgets>
                <container style="row items-center q-col-gutter-sm q-mb-sm">
                    <container style="col">
                        <label text="Access review" type="h5"/>
                        <label type="p" style="text-caption m-muted q-mb-none" condition="review"
                                text="${groupRows.length} group(s) as of ${review?.asOfText}; prepared ${ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd HH:mm')} by ${ec.user.username}. App gates are shown as they are now."/>
                    </container>
                    <container style="col-auto">
                        <link url="." text="Print" icon="sym_o_print" target-window="_blank" condition="!!review &amp;&amp; !printing"
                                parameter-map="Object.assign({}, reviewValues, {renderMode:'html-print'})"/>
                        <link url="../Capabilities" text="Capabilities" icon="sym_o_rule" link-type="anchor" condition="!printing"
                                parameter-map="{groups:reviewValues.groups, appName:appName}"/>
                    </container>
                </container>
                <section name="ReviewOptions" condition="!printing">
                    <widgets>
                        <form-single name="ReviewDate" transition="." map="reviewValues">
                            <field name="groups"><default-field><hidden/></default-field></field>
                            <field name="appName"><default-field><hidden/></default-field></field>
                            <field name="asOfDate"><default-field title="As of" tooltip="Empty reviews access as it is now"><date-time/></default-field></field>
                            <field name="submitButton"><default-field title="Show"><submit/></default-field></field>
                            <field-layout><field-row-big><field-ref name="asOfDate"/><field-ref name="submitButton"/></field-row-big></field-layout>
                        </form-single>
                    </widgets>
                </section>
                <label type="p" style="text-negative" condition="failure" text="${failure}"/>
                <label type="p" style="q-pa-md m-muted" condition="!chosen" text="Choose groups or an app in Capabilities, or open a group, to review its access."/>
                <section name="Review" condition="review">
                    <widgets>
                        <label type="p" style="text-caption" condition="notes.length" text="${notes.join(' · ')}"/>
                        <container-box>
                            <box-body-nopad>
                                <form-list name="AccessReviewList" list="reviewRows" skip-form="true" paginate="false" select-columns="true"
                                        show-csv-button="true">
                                    <field name="groupDescription"><default-field title="Group"><display/></default-field></field>
                                    <field name="userGroupId"><default-field title="Group ID"><display style="text-mono"/></default-field></field>
                                    <field name="entryText"><default-field title="Entry"><display/></default-field></field>
                                    <field name="name"><default-field title="Permission, app gate or member"><display/></default-field></field>
                                    <field name="detail"><default-field title="Description"><display/></default-field></field>
                                    <field name="kindLabel"><default-field title="Kind"><display/></default-field></field>
                                    <field name="fromText"><default-field title="From"><display/></default-field></field>
                                    <field name="thruText"><default-field title="Until"><display/></default-field></field>
                                    <field name="scope"><default-field title="Scope"><display/></default-field></field>
                                    <columns type="mobile">
                                        <column><field-ref name="name"/><field-ref name="groupDescription"/></column>
                                        <column><field-ref name="entryText"/><field-ref name="kindLabel"/></column>
                                    </columns>
                                </form-list>
                                <label type="p" style="q-pa-md m-muted" condition="!reviewRows.length" text="${emptyReviewText || 'These groups grant nothing and have no members.'}"/>
                            </box-body-nopad>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
