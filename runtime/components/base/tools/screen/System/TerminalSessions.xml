<!-- Terminal sessions (plans/archive/Terminal-Fancy.md §5.2, P9): every user's browser terminal sessions on this
    server, the apps, the moqui> command line and programs on the operating system, with their state and when they last
    wrote; never what they show. End ends one (org.moqui.terminal.TerminalServices.end#TerminalSessionOf), and another
    user's is an audit row. The opening and the end of each command line and host session are also in the audit
    entity moqui.terminal.TerminalSession. Recordings (plans/Terminal-Fancy2.md §4.5) are listed and deleted here, never
    played: only their owner plays one, in the Terminal. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-index="24" default-menu-group="Server" default-menu-title="Terminal Sessions" menu-image="sym_o_terminal" menu-image-type="icon">

    <transition name="endSession">
        <service-call name="org.moqui.terminal.TerminalServices.end#TerminalSessionOf" in-map="{sessionId:sessionId, reason:reason}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">The session was ended</message></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <transition name="storeOsAccount">
        <service-call name="org.moqui.terminal.TerminalServices.store#TerminalOsAccount" in-map="{username:username, osUsername:osUsername}"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="expireOsAccount">
        <service-call name="org.moqui.terminal.TerminalServices.expire#TerminalOsAccount" in-map="{username:username}"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="deleteRecording">
        <service-call name="org.moqui.terminal.TerminalServices.delete#TerminalRecording" in-map="{recordingId:recordingId}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">The recording was deleted</message></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions><script><![CDATA[
        // the OS accounts of run-as="person" (plans/Terminal-Fancy2.md §4.6), for an administrator with TERMINAL_HOST
        osAccountList = []
        runAsPerson = ec.factory.getConfValue('terminal@run-as') === 'person'
        if (runAsPerson && ec.user.hasPermission('TERMINAL_HOST')) {
            try {
                osAccountList = (ec.service.sync().name('org.moqui.terminal.TerminalServices.find#TerminalOsAccounts').call() || {}).accounts || []
            } catch (e) {
                osAccountList = []
            }
            ec.message.clearErrors()
        }
        mayKeepAccounts = runAsPerson && ec.user.hasPermission('TERMINAL_HOST')
        // the recordings, in a build that records (one without host sessions has none)
        recordingList = []
        try {
            const recorded = ec.service.sync().name('org.moqui.terminal.TerminalServices.find#AllTerminalRecordings').call() || {}
            recordingList = (recorded.recordings || []).map((recording) => Object.assign({}, recording, {
                sizeText: recording.bytes != null ? Math.ceil(Number(recording.bytes) / 1024) + ' KB' : '',
                forcedText: recording.forced ? ec.l10n.localize('Yes') : ''
            }))
        } catch (e) {
            recordingList = []
        }
        ec.message.clearErrors()
        const out = ec.service.sync().name('org.moqui.terminal.TerminalServices.find#AllTerminalSessions').call() || {}
        const when = (millis) => millis ? ec.l10n.format(new Date(Number(millis)), null) : ''
        sessionList = (out.sessions || []).map((session) => Object.assign({}, session, {
            startedText: when(session.started), lastOutputText: when(session.lastOutput),
            stateText: session.state === 'ended' ? ec.l10n.localize('Ended') + (session.exitStatus != null ? ' (' + session.exitStatus + ')' : '')
                : (session.attached ? ec.l10n.localize('Shown') : ec.l10n.localize('Running')),
            sizeText: session.cols + ' × ' + session.rows, heldText: session.held ? ec.l10n.localize('Yes') : ''
        }))
    ]]></script></actions>
    <widgets>
        <label text="The terminal sessions of every user on this server: the apps, the command line and programs on the operating system. What a session shows is never here." type="p" style="m-muted"/>
        <section name="NoSessions" condition="!sessionList.length"><widgets>
            <label text="No terminal sessions" type="p"/>
        </widgets></section>
        <section name="TerminalSessionListSection" condition="sessionList.length">
            <widgets>
                <form-list name="TerminalSessionList" list="sessionList" skip-form="true" paginate="false">
                    <field name="username"><default-field title="User"><display/></default-field></field>
                    <field name="kind"><default-field><display/></default-field></field>
                    <field name="title"><default-field><display/></default-field></field>
                    <field name="profile"><default-field><display/></default-field></field>
                    <field name="cwd"><default-field title="Directory"><display/></default-field></field>
                    <field name="stateText"><default-field title="State"><display/></default-field></field>
                    <field name="status"><default-field><display/></default-field></field>
                    <field name="sizeText"><default-field title="Size"><display/></default-field></field>
                    <field name="heldText"><default-field title="Outlives a restart"><display/></default-field></field>
                    <field name="startedText"><default-field title="Started"><display/></default-field></field>
                    <field name="lastOutputText"><default-field title="Last output"><display/></default-field></field>
                    <field name="end"><default-field title="">
                        <container-dialog id="EndSessionDialog" button-text="End" condition="state != 'ended'">
                            <form-single name="EndSession" transition="endSession">
                                <field name="sessionId"><default-field><hidden/></default-field></field>
                                <field name="reason"><default-field title="Reason"><text-line/></default-field></field>
                                <field name="submitButton"><default-field title="End the session"><submit confirmation="End this session? Its program stops."/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </default-field></field>
                </form-list>
            </widgets>
        </section>
        <section name="TerminalOsAccountSection" condition="mayKeepAccounts">
            <widgets>
                <label text="Accounts" type="h6"/>
                <label text="The operating system account each user's host sessions run as. The server may start programs only as the accounts /etc/moqui/run-as.conf allows (moqui term-exec --print-setup)." type="p" style="m-muted"/>
                <form-single name="StoreOsAccount" transition="storeOsAccount">
                    <field name="username"><default-field title="User"><text-line size="20"/></default-field></field>
                    <field name="osUsername"><default-field title="OS account"><text-line size="20"/></default-field></field>
                    <field name="submitButton"><default-field title="Set"><submit/></default-field></field>
                    <field-layout><field-row-big><field-ref name="username"/><field-ref name="osUsername"/><field-ref name="submitButton"/></field-row-big></field-layout>
                </form-single>
                <form-list name="TerminalOsAccountList" list="osAccountList" skip-form="true" paginate="false">
                    <field name="username"><default-field title="User"><display/></default-field></field>
                    <field name="osUsername"><default-field title="OS account"><display/></default-field></field>
                    <field name="fromDate"><default-field title="From"><display/></default-field></field>
                    <field name="expire"><default-field title="">
                        <link url="expireOsAccount" text="Remove" parameter-map="{username: username}" confirmation="This user's host sessions are refused from now on. Remove?"/>
                    </default-field></field>
                </form-list>
            </widgets>
        </section>
        <section name="TerminalRecordingListSection" condition="recordingList.length">
            <widgets>
                <label text="Recordings" type="h6"/>
                <label text="What recorded sessions showed: only each one's owner plays it, in the Terminal." type="p" style="m-muted"/>
                <form-list name="TerminalRecordingList" list="recordingList" skip-form="true" paginate="false">
                    <field name="username"><default-field title="User"><display/></default-field></field>
                    <field name="title"><default-field><display/></default-field></field>
                    <field name="fromDate"><default-field title="From"><display/></default-field></field>
                    <field name="thruDate"><default-field title="Thru"><display/></default-field></field>
                    <field name="sizeText"><default-field title="Size"><display/></default-field></field>
                    <field name="forcedText"><default-field title="Forced"><display/></default-field></field>
                    <field name="delete"><default-field title="">
                        <link url="deleteRecording" text="Delete" parameter-map="{recordingId: recordingId}"
                                confirmation="Delete this recording? Its file is removed."/>
                    </default-field></field>
                </form-list>
            </widgets>
        </section>
    </widgets>
</screen>
