<!-- Terminal sessions (plans/Terminal-Fancy.md §5.2, P9): every user's browser terminal sessions on this server, the apps,
    the moqui> command line and programs on the operating system, with their state and when they last wrote; never what
    they show. End ends one (org.moqui.terminal.TerminalServices.end#TerminalSessionOf), and another user's is an audit row.
    The opening and the end of each command line and host session are also in the audit entity moqui.terminal.TerminalSession. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-index="24" default-menu-group="Server" default-menu-title="Terminal Sessions" menu-image="sym_o_terminal" menu-image-type="icon">

    <transition name="endSession">
        <service-call name="org.moqui.terminal.TerminalServices.end#TerminalSessionOf" in-map="{sessionId:sessionId, reason:reason}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">The session was ended</message></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions><script><![CDATA[
        const out = ec.service.sync().name('org.moqui.terminal.TerminalServices.find#AllTerminalSessions').call() || {}
        const when = (millis) => millis ? ec.l10n.format(new Date(Number(millis)), null) : ''
        sessionList = (out.sessions || []).map((session) => Object.assign({}, session, {
            startedText: when(session.started), lastOutputText: when(session.lastOutput),
            stateText: session.state === 'ended' ? ec.l10n.localize('Ended') + (session.exitStatus != null ? ' (' + session.exitStatus + ')' : '')
                : (session.attached ? ec.l10n.localize('Shown') : ec.l10n.localize('Running')),
            sizeText: session.cols + ' × ' + session.rows, heldText: session.held ? ec.l10n.localize('Yes') : ''
        }))
    ]]></script></actions>
    <widgets>
        <label text="The terminal sessions of every user on this server: the apps, the command line and programs on the operating system. What a session shows is never here." type="p" style="m-muted"/>
        <section name="NoSessions" condition="!sessionList.length"><widgets>
            <label text="No terminal sessions" type="p"/>
        </widgets></section>
        <form-list name="TerminalSessionList" list="sessionList" skip-form="true" paginate="false" condition="sessionList.length">
            <field name="username"><default-field title="User"><display/></default-field></field>
            <field name="kind"><default-field><display/></default-field></field>
            <field name="title"><default-field><display/></default-field></field>
            <field name="profile"><default-field><display/></default-field></field>
            <field name="cwd"><default-field title="Directory"><display/></default-field></field>
            <field name="stateText"><default-field title="State"><display/></default-field></field>
            <field name="status"><default-field><display/></default-field></field>
            <field name="sizeText"><default-field title="Size"><display/></default-field></field>
            <field name="heldText"><default-field title="Outlives a restart"><display/></default-field></field>
            <field name="startedText"><default-field title="Started"><display/></default-field></field>
            <field name="lastOutputText"><default-field title="Last output"><display/></default-field></field>
            <field name="end"><default-field title="">
                <container-dialog id="EndSessionDialog" button-text="End" condition="state != 'ended'">
                    <form-single name="EndSession" transition="endSession">
                        <field name="sessionId"><default-field><hidden/></default-field></field>
                        <field name="reason"><default-field title="Reason"><text-line/></default-field></field>
                        <field name="submitButton"><default-field title="End the session"><submit confirmation="End this session? Its program stops."/></default-field></field>
                    </form-single>
                </container-dialog>
            </default-field></field>
        </form-list>
    </widgets>
</screen>
