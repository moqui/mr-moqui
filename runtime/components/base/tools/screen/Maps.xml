<!-- Maps (plans/Maps.md §3.1; docs/tools/Maps.md): the framework's map app, beside Dashboards, System and Tools. Browse (the
    full-screen map), Views (saved views), Preferences (the user's own defaults), Offline (the user's offline map packages,
    plans/Maps-Offline.md), Configuration (providers, profiles, layers,
    the outside-request policy and readiness: MAPS_ADMIN, by the user's own grant) and LocalMap, the record dialog any app
    opens (MAPS_DIALOG, every signed-in user, default-menu-include false). The root is MAPS_APP's (MAPS_USERS and ADMIN, data/MapsSecurityData.xml).
    No always-actions: a render of LocalMap runs the always-actions of the screens above it without their own check
    (docs/security/Attack-Surface-Web.md "Parent frames"), so this screen reads nothing. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Maps" menu-image="sym_o_map" menu-image-type="icon">
    <subscreens default-item="Browse">
        <!-- shown only to a user whose own grants open it: Configuration refuses anyone else, whatever reaches Maps.xml -->
        <subscreens-item name="Configuration" location="component://tools/screen/Maps/Configuration.xml" menu-index="9"
                menu-include="ec.artifactExecution.isPermittedOwn('component://tools/screen/Maps/Configuration.xml', 'AT_XML_SCREEN', 'view')"/>
    </subscreens>
    <widgets>
        <subscreens-panel id="maps-panel" type="popup"/>
    </widgets>
</screen>
