<!-- The load wrap of Data › Load and Data › Snapshots (service/moqui/tools/DatabaseLoadServices.xml): the ServiceJob that
    runs it, its notification, and its authorization, which the job runs under (the Tools app's own, for ADMIN; the
    database jobs it runs check DATABASE_ADMIN). -->
<entity-facade-xml type="seed">
    <moqui.security.user.NotificationTopic topic="DatabaseLoadWrap" inboxEnumId="NinUpdates" description="Data load with foreign keys dropped and made again"
            typeString="success" showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${results.outcome}" errorTitleTemplate="Data load with the foreign keys dropped: ${results.outcome || 'see the job run'}"
            linkTemplate="/apps/tools/Database/Jobs"/>
    <moqui.service.job.ServiceJob jobName="DatabaseLoadWrap" description="Data load with the foreign keys dropped and made again"
            serviceName="moqui.tools.DatabaseLoadServices.run#LoadWrap" topic="DatabaseLoadWrap" transactionTimeout="7200"/>
    <artifactGroups artifactGroupId="TOOLS_DATABASE_LOAD" description="Tools database load wrap service">
        <artifacts artifactName="moqui.tools.DatabaseLoadServices.run#LoadWrap" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"/>
        <authz artifactAuthzId="TOOLS_DATABASE_LOAD_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
</entity-facade-xml>
