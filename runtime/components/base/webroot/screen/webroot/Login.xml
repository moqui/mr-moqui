<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-include="false" require-authentication="false" history="false">

    <parameter name="initialTab"/>
    <parameter name="returnTo"/>

    <!-- partial list of scenarios:
      x basic login
        - login username + password success
        - next screen 2nd factor
      x login with password change required
        - login username + password but require password change
        - next screen change password
          - go to directly with anchor in URL or something
          - if password was correct and authc code required for user allow instead of pw on change password
          - login after change password, don't require login again
      x cold change password
        - start on change password tab, enter username, password, new password + confirm
        - if 2nd factor required go to SecondFactor screen - instead go back to Login#change and get code + new password/verify
      - reset password
        - given username send email to UserAccount.emailAddress with separate reset password
        - in email link to change password tab on login screen with username and reset password filled in
        - if 2nd factor required for user also require
      - change user after pre-auth
    -->

    <transition name="login" require-session-token="false">
        <!-- Optional for second-factor continuation, where the username is already in the session. -->
        <parameter name="username"/>
        <parameter name="password"/>
        <parameter name="code"/>
        <actions>
            <if condition="ec.web?.sessionAttributes?.moquiPreAuthcUsername"><then>
                <!-- already pre-auth'ed, verify code below -->
                <set field="username" from="ec.web?.sessionAttributes?.moquiPreAuthcUsername"/>
            </then><else>
                <!-- no pre-auth, try logging in (pre-auth if 2nd factor required) -->
                <set field="loggedIn" from="ec.user.loginUser(username, password)"/>
            </else></if>

            <if condition="ec.web.sessionAttributes.moquiAuthcFactorRequired">
                <if condition="code"><then>
                    <service-call name="org.moqui.impl.UserServices.validate#ExternalUserAuthcCode"
                            in-map="{code:code}" out-map="validateOut"/>
                    <if condition="validateOut.verified"><then>
                        <script>ec.user.internalLoginUser(validateOut.username)</script>
                        <return/>
                    </then><else>
                        <message error="true" public="true">Authentication code is not valid</message>
                    </else></if>
                </then><else>
                    <message error="true" public="true">Authentication code required for user ${username}</message>
                </else></if>
            </if>
        </actions>
        <!-- no longer using SecondFactor screen, now built into Login screen to better support more scenarios:
        <conditional-response url="../SecondFactor"><condition>
            <expression>ec.web.sessionAttributes.moquiAuthcFactorRequired</expression></condition></conditional-response>
        -->
        <default-response type="screen-last"/>
        <error-response url="."/>
    </transition>
    <transition name="logout">
        <actions>
            <!-- after an SSO login, logout#User also ends the session at the identity provider and redirects -->
            <set field="moquiAuthFlowExternalLogout" from="ec.web.sessionAttributes.moquiAuthFlowExternalLogout"/>
            <if condition="moquiAuthFlowExternalLogout"><then>
                <service-call name="org.moqui.sso.AuthServices.logout#User"/>
            </then><else>
                <script>ec.user.logoutUser()</script>
            </else></if>
        </actions>
        <conditional-response type="none"><condition><expression>moquiAuthFlowExternalLogout</expression></condition></conditional-response>
        <default-response url="/"/>
        <error-response url="."/>
    </transition>
    <transition name="removePreAuth">
        <actions><script>
            ec.web.sessionAttributes.remove("moquiPreAuthcUsername")
            ec.web.sessionAttributes.remove("moquiAuthcFactorRequired")
            ec.web.sessionAttributes.remove("moquiPasswordChangeRequired")
            ec.web.sessionAttributes.remove("moquiExpiredCredentials")
        </script></actions>
        <default-response url="."/>
    </transition>
    <transition name="resetPassword">
        <parameter name="username" from="ec.web?.sessionAttributes?.moquiPreAuthcUsername || username"/>
        <service-call name="org.moqui.impl.UserServices.reset#Password" in-map="{username:username}"/>
        <default-response url="."/>
    </transition>
    <transition name="changePassword">
        <parameter name="username" from="ec.web?.sessionAttributes?.moquiPreAuthcUsername || username"/>
        <service-call name="org.moqui.impl.UserServices.update#Password"/>
        <actions>
            <!-- password change success, login the user -->
            <if condition="updateSuccessful">
                <set field="loginSuccess" from="ec.user.internalLoginUser(username)"/></if>
        </actions>
        <conditional-response type="screen-last"><condition><expression>updateSuccessful</expression></condition></conditional-response>
        <default-response url="." parameter-map="{initialTab:'#change'}"/>
    </transition>
    <transition name="createInitialAdminAccount">
        <service-call name="org.moqui.impl.UserServices.create#InitialAdminAccount"/>
        <default-response url="../Login"/>
        <error-response url="."/>
    </transition>
    <!-- For a client with no page (the terminal's login dialog over moqui tui server): whether the first administrator
        is to be created, with the password rules and the session token to post createInitialAdminAccount with. Once any
        account exists it answers needed false and nothing else, and sends no session. -->
    <transition name="initialAdminNeeded" read-only="true" require-session-token="false">
        <actions>
            <service-call name="org.moqui.impl.UserServices.get#InitialAdminNeeded" out-map="adminNeeded"/>
            <script>
                if (adminNeeded.needed) {
                    ec.web.sendJsonResponse({needed: true, minLength: adminNeeded.minLength, minDigits: adminNeeded.minDigits,
                        minOthers: adminNeeded.minOthers, secretRequired: !ec.user.initialAdminLocal, sessionToken: ec.web.sessionToken})
                } else {
                    ec.web.declineSession()
                    ec.web.sendJsonResponse({needed: false})
                }
            </script>
        </actions>
        <default-response type="none"/>
    </transition>
    <transition name="sendOtp">
        <service-call name="org.moqui.impl.UserServices.send#ExternalAuthcCode" in-map="{factorId:factorId}"/>
        <default-response url="."/>
    </transition>

    <pre-actions><script>
        // if user already logged in redirect to root
        if (ec.user.userId) sri.sendRedirectAndStopRender('/')

    </script></pre-actions>
    <actions>
        <!-- handle returnTo parameter. The pages the user got are on the screen history, so a Login reached directly
            goes back to the page before it without any more here. -->
        <if condition="returnTo"><then>
            <!-- The host is the webapp http-host, not the request Host header. A client can set Host to
                 the host of an off-site returnTo, and that must not count as this site. -->
            <if condition="WebUtilities.isSameOriginRedirect(returnTo)"><then>
                <script>ec.web.saveScreenLastInfo(returnTo.replace(/^https?:\/\/[^\/]+/, ''), null)</script>
            </then><else>
                <log level="warn" message="Ignoring off-site returnTo [${returnTo}]"/>
            </else></if>
        </then></if>

        <!-- the SSO tab: the AuthFlow logins, read with authorization off as anonymous users see them -->
        <script>
            authFlowList = ec.entity.find("moqui.security.sso.AuthFlow").disableAuthz().orderBy("sequenceNum").list()
                .filter((flow) => flow.inbound != 'Y' &amp;&amp; flow.disabled != 'Y')
        </script>

        <set field="passwordChangeRequired" from="ec.web.sessionAttributes.moquiPasswordChangeRequired || 'false'" type="Boolean"/>
        <set field="expiredCredentials" from="ec.web.sessionAttributes.moquiExpiredCredentials || 'false'" type="Boolean"/>
        <if condition="passwordChangeRequired || expiredCredentials">
            <set field="initialTab" value="#change"/></if>
        <if condition="initialTab &amp;&amp; !initialTab.startsWith('#')"><set field="initialTab" from="'#' + initialTab"/></if>

        <set field="secondFactorRequired" from="false"/>
        <if condition="ec.web.sessionAttributes.moquiPreAuthcUsername"><then>
            <set field="username" from="ec.web.sessionAttributes.moquiPreAuthcUsername"/>
            <service-call name="org.moqui.impl.UserServices.get#ExternalUserAuthcFactorInfo" out-map="context"/>
        </then><else>
            <set field="username" from="ec.web.errorParameters?.username || ''"/>
        </else></if>

        <set field="minLength" from="ec.user.passwordRules.minLength"/>
        <set field="minDigits" from="ec.user.passwordRules.minDigits"/>
        <set field="minOthers" from="ec.user.passwordRules.minOthers"/>

        <!-- the account checks the sections show by, read here so the widgets read flags; the seed accounts nobody logs
            in as do not count, as create#InitialAdminAccount counts (get#InitialAdminNeeded) -->
        <service-call name="org.moqui.impl.UserServices.get#InitialAdminNeeded" out-map="adminNeeded"/>
        <set field="hasUserAccounts" from="!adminNeeded.needed"/>
        <!-- from another machine the first administrator takes the setup secret of the startup log (SEC-WEB-08) -->
        <set field="setupSecretRequired" from="adminNeeded.needed &amp;&amp; !ec.user.initialAdminLocal"/>
        <!-- no account yet, but initial_admin_enabled is off: the login form, with a line on how to turn the setup on -->
        <set field="initialAdminDisabled" from="adminNeeded.disabled === true"/>
        <set field="advancedNote" value="Administrators - Advanced may log in as another user and use the SQL runner, the SSH admin shell and host terminal, conf editing, component deploy, load testing and hosted instances: they run code or reach data outside the apps. Leave it off unless this account needs them. Only a member of ADMIN_ADV can add a member later; with none, it takes a data load (moqui load)."/>
        <set field="disabledNote" value="No user account exists yet. To create the first administrator, set initial_admin_enabled=true (in .env) and restart the server."/>
        <!-- the Test Login button: on a dev or test instance or a demo (demo_test_login), while the test user's password is
            still 'moqui' (SEC-RTE-17; the check is cached a minute) -->
        <service-call name="org.moqui.impl.UserServices.get#TestLoginOffered" out-map="testLoginOut"/>
        <set field="hasTestLogin" from="testLoginOut.offered === true"/>
    </actions>
    <widgets>
        <!-- NOTE: this screen is not under the apps screen, but uses similar header/footer/etc -->
        <container id="content" style="Login"><container style="inner">
            <!-- the terminal shows the messages on its own message line -->
            <render-mode><text type="html" location="component://webroot/screen/includes/Messages.html.fancy"/>
                <text type="tui" template="false">[]</text></render-mode>

            <section name="NeedsSetupSection" condition="hasUserAccounts"><widgets>
                <!-- primary scenario, main login screen -->
                <render-mode><text type="html" location="component://webroot/screen/webroot/Login.html.fancy"/></render-mode>
                <section name="InitialAdminDisabledSection" condition="initialAdminDisabled"><widgets>
                    <render-mode><text type="html"><![CDATA[<p class="muted center" id="InitialAdminDisabled">${html(disabledNote)}</p>]]></text>
                        <text type="tui"><![CDATA[[{"t":"text","id":"InitialAdminDisabled","style":"quote","text":${JSON.stringify(disabledNote)}}]]]></text></render-mode>
                </widgets></section>
            </widgets><fail-widgets>
                <!-- if there are no user accounts, other than the _NA_ UserAccount which is in seed data, show form to create admin account -->
                <render-mode><text type="html"><![CDATA[
    <div class="center">
        <h3>Welcome to your new system</h3>
        <form method="post" action="${sri.buildUrl("createInitialAdminAccount").url}" class="form-signin" id="InitialAdminForm">
            <p class="muted">There are no user accounts, get started by creating an initial administrator account</p>
            <input type="hidden" name="moquiSessionToken" value="${ec.web.sessionToken}">
            <input type="text" name="username" value="${html(ec.web.errorParameters.username || "")}" placeholder="Username" required autofocus>
            <input type="password" name="newPassword" placeholder="New Password" required autocomplete="new-password">
            <input type="password" name="newPasswordVerify" placeholder="New Password Verify" required autocomplete="new-password">
            <input type="text" name="userFullName" value="${html(ec.web.errorParameters.userFullName || "")}" placeholder="User Full Name" required>
            <input type="text" name="emailAddress" value="${html(ec.web.errorParameters.emailAddress || "")}" placeholder="Email Address" required>
            ${setupSecretRequired ? '<input type="password" name="setupSecret" placeholder="Setup Secret" required autocomplete="off">'
                + '<p class="muted">From another machine the setup secret is needed: the server wrote it to its startup log (moqui.log), in the line that begins "No user account exists yet".</p>' : ''}
            <label class="muted" style="display:block;text-align:left;margin:8px 0"><input type="checkbox" name="joinAdvanced" value="true"${ec.web.errorParameters.joinAdvanced == "true" ? " checked" : ""}>
                Also join Administrators - Advanced (ADMIN_ADV)</label>
            <p class="muted" id="InitialAdminAdvancedNote">${html(advancedNote)}</p>
            <button data-btn="primary" data-size="lg" type="submit">Create Initial Admin Account</button>
        </form>
    </div>
                ]]></text>
                <!-- the same form in the terminal (GET /Login?renderMode=tui, a snapshot, an agent); the terminal's own
                    sign-in is its login dialog, which has this setup too (docs/ui/TUI.md, "The login dialog") -->
                <text type="tui"><![CDATA[[
    {"t":"text","id":"InitialAdminTitle","style":"h3","text":"Welcome to your new system"},
    {"t":"text","id":"InitialAdminIntro","text":"There are no user accounts, get started by creating an initial administrator account"},
    {"t":"form","id":"InitialAdminForm","name":"InitialAdminForm","kind":"single","method":"post","writes":true,
        "transitionUrl":${JSON.stringify(sri.buildUrl("createInitialAdminAccount").url)},
        "hidden":[{"name":"moquiSessionToken","value":${JSON.stringify(ec.web.sessionToken || "")}}],"c":[
        {"t":"field","id":"InitialAdminForm.username","name":"username","title":"Username","required":true,
            "w":{"kind":"textLine","value":${JSON.stringify(ec.web.errorParameters?.username || "")}}},
        {"t":"field","id":"InitialAdminForm.newPassword","name":"newPassword","title":"New Password","required":true,
            "w":{"kind":"password"}},
        {"t":"field","id":"InitialAdminForm.newPasswordVerify","name":"newPasswordVerify","title":"New Password Verify",
            "required":true,"w":{"kind":"password"}},
        {"t":"field","id":"InitialAdminForm.userFullName","name":"userFullName","title":"User Full Name","required":true,
            "w":{"kind":"textLine","value":${JSON.stringify(ec.web.errorParameters?.userFullName || "")}}},
        {"t":"field","id":"InitialAdminForm.emailAddress","name":"emailAddress","title":"Email Address","required":true,
            "w":{"kind":"textLine","value":${JSON.stringify(ec.web.errorParameters?.emailAddress || "")}}},
        ${setupSecretRequired ? '{"t":"field","id":"InitialAdminForm.setupSecret","name":"setupSecret","title":"Setup Secret","required":true,"w":{"kind":"password"}},' : ''}
        {"t":"field","id":"InitialAdminForm.joinAdvanced","name":"joinAdvanced","title":"Advanced",
            "w":{"kind":"check","value":${JSON.stringify(ec.web.errorParameters?.joinAdvanced == "true" ? '["true"]' : '[]')},
                "options":[{"value":"true","label":"Also join Administrators - Advanced (ADMIN_ADV)"}]}},
        {"t":"field","id":"InitialAdminForm.submitButton","name":"submitButton","title":"Create Initial Admin Account",
            "w":{"kind":"submit","text":"Create Initial Admin Account"}}
    ]},
    {"t":"text","id":"InitialAdminRules","style":"quote","text":${JSON.stringify("The password: at least " + minLength
        + " characters, " + minDigits + (minDigits == 1 ? " digit, " : " digits, ") + minOthers + (minOthers == 1 ? " other" : " others"))}}${setupSecretRequired
        ? ',{"t":"text","id":"InitialAdminSecretHint","style":"quote","text":' + JSON.stringify('The setup secret is in the startup log of the server (moqui.log), in the line that begins "No user account exists yet".') + '}' : ''},
    {"t":"text","id":"InitialAdminAdvancedNote","style":"quote","text":${JSON.stringify(advancedNote)}}
]]]></text></render-mode>
            </fail-widgets></section>

            <!-- only on a dev or test instance, or a demo that sets demo_test_login (get#TestLoginOffered) -->
            <section name="TestLoginSection">
                <condition><expression>hasTestLogin</expression></condition>
                <widgets><render-mode><text type="html"><![CDATA[
                <form method="post" action="${sri.buildUrl("login").url}" id="TestLoginLink">
                    <input type="hidden" name="username" value="john.doe">
                    <input type="hidden" name="password" value="moqui">
                    <button data-btn="primary" type="submit" id="TestLoginLink_button" autofocus>Test Login (John Doe)</button>
                </form>
                ]]></text>
                <!-- the terminal signs in through its login dialog -->
                <text type="tui" template="false">[]</text></render-mode></widgets>
            </section>
        </container></container>
    </widgets>
</screen>
