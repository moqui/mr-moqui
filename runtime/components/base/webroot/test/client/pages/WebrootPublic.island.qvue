<template>
    <div class="island-fixture">
        <p class="island-title">{{ title }}</p>
        <ul><li v-for="item in items" :key="item">{{ item }}</li></ul>
        <button type="button" class="island-add" @click="count++">Added {{ count }}</button>
        <island-note :text="$root.context.note"></island-note>
    </div>
</template>
<script>
module.exports = {
    name: 'IslandFixture',
    components: {
        'island-note': { props: ['text'], template: '<small class="island-note">{{ text }}</small>' },
    },
    data() {
        return { title: 'Bundled island', items: ['one', 'two'], count: 0 }
    },
}
</script>
<style>
.island-fixture .island-note { font-style: italic; }
