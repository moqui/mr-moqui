<?xml version="1.0" encoding="UTF-8" ?>
<!-- No copyright or license for configuration file, details here are not considered a creative work. -->
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <!-- Where links to the Comms screens go in notifications, mail and push: an app that mounts the BasicComms screens under its
        own root (IronStone BOSS: /qapps/Comms) sets it to that root. -->
    <comms app-root="/qapps/BasicComms"/>
    <!-- A call link (plans/archive/Comms-Framework.md W3, D-A5): /call/<token>, the guest page screen/CallGuest.xml in the public shell,
        after org.moqui.call.CallServices.check#CallLinkToken; a guest joins with their name (a few a minute from a client). -->
    <webapp-list>
        <webapp name="webroot">
            <token-route name="call" screen-location="component://basic-comms/screen/CallGuest.xml"
                    token-service="org.moqui.call.CallServices.check#CallLinkToken" title="Call"/>
            <!-- a room's invite link (plans/Comms-Messaging.md §18.3 phase 17): /join/<token>, screen/ChatJoin.xml in the public
                shell after org.moqui.chat.ChatInviteServices.check#InviteToken; a signed-in person joins or asks to -->
            <token-route name="join" screen-location="component://basic-comms/screen/ChatJoin.xml"
                    token-service="org.moqui.chat.ChatInviteServices.check#InviteToken" title="Join a room"/>
            <web-protection>
                <rate-limit name="call-guest" path="/call/*/joinGuest" methods="POST" requests="10" seconds="60" burst="5"/>
                <rate-limit name="chat-join" path="/join/*/join" methods="POST" requests="10" seconds="60" burst="5"/>
                <rate-limit name="chat-join-sign-in" path="/join/*/signIn" methods="POST" requests="10" seconds="60" burst="5"/>
            </web-protection>
        </webapp>
    </webapp-list>
    <screen-facade>
        <screen location="component://webroot/screen/webroot/apps.xml">
            <subscreens-item name="BasicComms" menu-title="Comms" menu-index="22" location="component://basic-comms/screen/BasicComms.xml"/>
        </screen>
        <!-- Admin: Voice (plans/archive/Comms-Framework.md §5.5, D-A6): trunks, numbers, caller IDs, fraud limits and emergency setup, in
            the tools System app, with the files here -->
        <screen location="component://tools/screen/System.xml">
            <subscreens-item name="Voice" menu-title="Voice" menu-index="17" menu-group="Integration" location="component://basic-comms/screen/System/Voice.xml"/>
            <subscreens-item name="ChatBridges" menu-title="Chat Bridges" menu-index="18" menu-group="Integration" location="component://basic-comms/screen/System/ChatBridges.xml"/>
            <!-- every user's push devices and how their pushes go (plans/Comms-Messaging.md §7.3, Health) -->
            <subscreens-item name="PushHealth" menu-title="Push Health" menu-index="19" menu-group="Integration" location="component://basic-comms/screen/System/PushHealth.xml"/>
            <!-- the server's chat sticker packs (plans/Comms-Messaging.md §18.3 phase 20) -->
            <subscreens-item name="ChatStickers" menu-title="Chat Stickers" menu-index="20" menu-group="Integration" location="component://basic-comms/screen/System/ChatStickers.xml"/>
        </screen>
    </screen-facade>
</moqui-conf>
