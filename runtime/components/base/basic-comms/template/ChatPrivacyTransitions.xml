<!-- The transitions of one-time codes and screen security (plans/Comms-Messaging.md §18.3 phase 21;
    org.moqui.chat.ChatPrivacyServices): in Chat.xml keepCode (a code's message kept past its day) and roomScreenSecure (the
    member's own Block screenshots here); in Settings/Chat.xml savePrivacy (the two settings). -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <transition name="keepCode">
        <actions><script><![CDATA[
            const out = ec.service.sync().name('org.moqui.chat.ChatPrivacyServices.keep#CodeMessage').parameters({chatRoomId: chatRoomId || '',
                eventSeq: Number(eventSeq || 0)}).call() || {}
            ec.web.sendJsonResponse(ec.message.hasError() ? {reasonCode: out.reasonCode || null} : {kept: out.kept === true})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="roomScreenSecure">
        <actions><script><![CDATA[
            const out = ec.service.sync().name('org.moqui.chat.ChatPrivacyServices.set#RoomScreenSecure').parameters({chatRoomId: chatRoomId || '',
                on: String(on) === 'true'}).call() || {}
            ec.web.sendJsonResponse(ec.message.hasError() ? {reasonCode: out.reasonCode || null} : {screenSecure: out.screenSecure === true})
        ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="savePrivacy">
        <service-call name="org.moqui.chat.ChatPrivacyServices.store#ChatPrivacyPrefs" in-map="{screenSecurity: screenSecurity, otpDelete: otpDelete, fromForm: true}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Privacy settings saved</message></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
</screen>
