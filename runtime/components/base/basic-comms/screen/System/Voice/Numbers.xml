<!-- Voice, Numbers (plans/archive/Comms-Framework.md §5.2, §5.4): the phone numbers the trunks bring, in E.164, each with its trunk, the
    user, ring group (V3), IVR menu or queue (V5) a call to it goes to, the emergency location its calls report, and its
    messaging (C4-SMS: the SMS bridge its texts go through, which needs no trunk).
    org.moqui.call.VoiceServices find#, store# and delete#PhoneNumber. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Numbers" default-menu-index="3">

    <transition-include name="searchUsers" location="component://basic-comms/template/VoiceTransitions.xml"/>
    <transition name="storeNumber">
        <service-call name="org.moqui.call.VoiceServices.store#PhoneNumber" in-map="{phoneNumber:phoneNumber, voiceTrunkId:voiceTrunkId || null,
                routeTypeEnumId:routeTypeEnumId || 'PnrUser',
                routeId:(routeTypeEnumId == 'PnrRingGroup' ? ringGroupId : routeTypeEnumId == 'PnrIvr' ? ivrMenuId : routeTypeEnumId == 'PnrQueue' ? callQueueId
                    : routeTypeEnumId == 'PnrVoicemail' ? null : routeId) || null, emergencyLocationId:emergencyLocationId || null, description:description || null,
                messagingBridgeId:messagingBridgeId || ''}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Number saved</message></if></actions>
        <default-response url="."/>
    </transition>
    <transition name="deleteNumber">
        <service-call name="org.moqui.call.VoiceServices.delete#PhoneNumber" in-map="{phoneNumber:phoneNumber}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Number removed</message></if></actions>
        <default-response url="."/>
    </transition>

    <actions><script><![CDATA[
        const call = (name) => ec.service.sync().name('org.moqui.call.VoiceServices.' + name).requireNewTransaction(true).disableAuthz().call() || {}
        numberList = Array.from(call('find#PhoneNumbers').numberList || [])
        trunkOptions = Array.from(call('find#VoiceTrunks').trunkList || []).map((t) => ({key: t.voiceTrunkId, text: t.name}))
        locationOptions = Array.from(call('find#EmergencyLocations').locationList || []).map((l) => ({key: l.emergencyLocationId, text: l.name || l.emergencyLocationId}))
        // V3: a number rings a user or a ring group, or is the voicemail access number
        const groups = ec.service.sync().name('org.moqui.call.CallHandlingServices.find#RingGroups').requireNewTransaction(true).disableAuthz().call() || {}
        groupOptions = Array.from(groups.groupList || []).map((g) => ({key: g.ringGroupId, text: g.name}))
        // V5: or an IVR menu, or a queue
        menuOptions = Array.from((ec.service.sync().name('org.moqui.call.IvrServices.find#IvrMenus').requireNewTransaction(true).disableAuthz().call() || {}).menuList || [])
            .map((m) => ({key: m.ivrMenuId, text: m.name}))
        queueOptions = Array.from((ec.service.sync().name('org.moqui.call.CallQueueServices.find#CallQueues').requireNewTransaction(true).disableAuthz().call() || {}).queueList || [])
            .map((q) => ({key: q.callQueueId, text: q.name}))
        // C4-SMS: the SMS bridges a number's texts can go through
        const bridges = ec.service.sync().name('org.moqui.chat.ChatBridgeServices.find#Bridges').requireNewTransaction(true).disableAuthz().call() || {}
        messagingOptions = Array.from(bridges.bridgeList || []).filter((b) => b.typeEnumId === 'CbtSms').map((b) => ({key: b.chatBridgeId, text: b.name || b.chatBridgeId}))
        routeOptions = [{key: 'PnrUser', text: ec.l10n.localize('A user')}, {key: 'PnrRingGroup', text: ec.l10n.localize('A ring group')},
            {key: 'PnrIvr', text: ec.l10n.localize('An IVR menu')}, {key: 'PnrQueue', text: ec.l10n.localize('A queue')},
            {key: 'PnrVoicemail', text: ec.l10n.localize('Voicemail access')}]
        numberList = numberList.map((n) => Object.assign({}, n, {ringGroupId: n.routeTypeEnumId === 'PnrRingGroup' ? n.routeId : null,
            ivrMenuId: n.routeTypeEnumId === 'PnrIvr' ? n.routeId : null, callQueueId: n.routeTypeEnumId === 'PnrQueue' ? n.routeId : null}))
        ec.message.clearErrors()
        newNumber = {routeTypeEnumId: 'PnrUser'}
    ]]></script></actions>
    <widgets>
        <container style="row items-center q-mb-sm">
            <label type="h6" text="Numbers" style="q-my-none"/>
            <container style="col"/>
            <container-dialog id="NewNumberDialog" button-text="Add a number" icon="sym_o_add" width="640" title="Add a number" type="primary">
                <form-single name="NewNumber" transition="storeNumber" map="newNumber" focus-field="phoneNumber">
                    <field name="phoneNumber"><default-field title="Number" tooltip="With its country code, such as +15551234567"><text-line size="20"/></default-field></field>
                    <field name="voiceTrunkId"><default-field title="Trunk"><drop-down allow-empty="true"><list-options list="trunkOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                    <field name="routeTypeEnumId"><default-field title="Routes to"><drop-down><list-options list="routeOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                    <field name="routeId"><default-field title="Rings">
                        <drop-down allow-empty="true"><dynamic-options transition="searchUsers" server-search="true" min-length="0"/></drop-down></default-field></field>
                    <field name="ringGroupId"><default-field title="Ring group"><drop-down allow-empty="true"><list-options list="groupOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                    <field name="ivrMenuId"><default-field title="IVR menu"><drop-down allow-empty="true"><list-options list="menuOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                    <field name="callQueueId"><default-field title="Queue"><drop-down allow-empty="true"><list-options list="queueOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                    <field name="emergencyLocationId"><default-field title="Emergency location"><drop-down allow-empty="true"><list-options list="locationOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                    <field name="messagingBridgeId"><default-field title="Texts through" tooltip="The SMS bridge its texts go through (System, Chat Bridges); empty for none">
                        <drop-down allow-empty="true"><list-options list="messagingOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                    <field name="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                    <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                </form-single>
            </container-dialog>
        </container>
        <container-box><box-body-nopad>
            <form-list name="NumberList" list="numberList" skip-form="true" paginate="false">
                <field name="phoneNumber"><default-field title="Number"><display style="text-weight-medium"/></default-field></field>
                <field name="trunkName"><default-field title="Trunk"><display/></default-field></field>
                <field name="routeName"><default-field title="Rings"><display/></default-field></field>
                <field name="locationName"><default-field title="Emergency location"><display/></default-field></field>
                <field name="messagingName"><default-field title="Texts"><display/></default-field></field>
                <field name="description"><default-field title="Description"><display style="text-caption"/></default-field></field>
                <field name="tools" align="right"><default-field title="">
                    <container-dialog id="EditNumberDialog_${phoneNumber}" button-text="Edit" icon="sym_o_edit" width="640" title="${ec.l10n.localize('Edit')} ${phoneNumber}">
                        <form-single name="EditNumber" transition="storeNumber">
                            <field name="phoneNumber" from="phoneNumber"><default-field><hidden/></default-field></field>
                            <field name="voiceTrunkId" from="voiceTrunkId"><default-field title="Trunk"><drop-down allow-empty="true"><list-options list="trunkOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                            <field name="routeTypeEnumId" from="routeTypeEnumId"><default-field title="Routes to"><drop-down><list-options list="routeOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                            <field name="routeId" from="routeTypeEnumId == 'PnrUser' ? routeId : null"><default-field title="Rings">
                                <drop-down allow-empty="true"><dynamic-options transition="searchUsers" server-search="true" min-length="0"/></drop-down></default-field></field>
                            <field name="ringGroupId" from="ringGroupId"><default-field title="Ring group"><drop-down allow-empty="true"><list-options list="groupOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                            <field name="ivrMenuId" from="ivrMenuId"><default-field title="IVR menu"><drop-down allow-empty="true"><list-options list="menuOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                            <field name="callQueueId" from="callQueueId"><default-field title="Queue"><drop-down allow-empty="true"><list-options list="queueOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                            <field name="emergencyLocationId" from="emergencyLocationId"><default-field title="Emergency location"><drop-down allow-empty="true"><list-options list="locationOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                            <field name="messagingBridgeId" from="messagingBridgeId"><default-field title="Texts through">
                                <drop-down allow-empty="true"><list-options list="messagingOptions" key="${key}" text="${text}"/></drop-down></default-field></field>
                            <field name="description" from="description"><default-field title="Description"><text-line size="40"/></default-field></field>
                            <field name="submitButton"><default-field title="Save"><submit/></default-field></field>
                        </form-single>
                    </container-dialog>
                    <link url="deleteNumber" link-type="hidden-form-link" icon="sym_o_delete" text="" tooltip="Remove" style="m-btn-flat" btn-type="danger"
                            confirmation="Remove the number ${phoneNumber} and who may call from it?" parameter-map="{phoneNumber:phoneNumber}"/>
                </default-field></field>
                <columns type="mobile">
                    <column><field-ref name="phoneNumber"/><field-ref name="routeName"/></column>
                    <column><field-ref name="trunkName"/><field-ref name="tools"/></column>
                </columns>
            </form-list>
            <section name="NoNumbers" condition="!numberList.length"><widgets>
                <label type="p" text="No numbers yet. Add the numbers your trunk provider gave you, and the user each one rings." style="m-muted q-pa-sm q-mb-none"/>
            </widgets></section>
        </box-body-nopad></container-box>
    </widgets>
</screen>
