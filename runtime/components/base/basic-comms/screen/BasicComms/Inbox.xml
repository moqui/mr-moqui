<!-- Comms Inbox (design-drawers-commons.md §12; impl-drawers-commons.md M5b, M5c): the mail client over the user's mail
    accounts and internal messages. The client itself is the default subscreen Inbox/Mail (Mail.xml serving Mail.qvue), so
    Inbox and Inbox?view=internal (the header's Mail and Messages counts, STRT_MAIL_SCREEN and
    STRT_MESSAGES_SCREEN) are the client, and its siblings Compose (the composer as a page) and MessageDetail (one message
    with its source) show in its place: the client loads each screen of the path on its own, and a .qvue screen cannot hold
    the subscreens of its own path. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Inbox" default-menu-index="2" menu-image="sym_o_mail" menu-image-type="icon">
    <subscreens default-item="Mail"/>
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
