<!-- Wrapper for the Comms tab of the tray panel (design-drawers-commons.md §1.4): Chat. The framework frame (m-shell-tray)
    loads the tab by its path (the theme value STRT_TRAY_CHAT, Comms/Panel/Chat, in its best client mode: qvue) into an
    m-dynamic-container with the id m-tray-chat. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Panel" default-menu-include="false" server-static="qvt">
    <widgets>
        <subscreens-active/>
    </widgets>
</screen>
