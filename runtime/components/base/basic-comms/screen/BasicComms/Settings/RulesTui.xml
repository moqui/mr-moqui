<!-- The terminal twin of Rules (style-guide §4.8): Rules.tui.json is a dynamic container of this screen. The user's mail rules
    in order, each with its conditions and actions in words, its account and how often it matched, from the same
    org.moqui.comms.MailSettingsServices.get#RulesView the Rules.qvue client calls; Turn on or off and Delete through the framework's
    update and delete#EmailRule, which check that the user may change the rule; and the blocked senders with Unblock. Writing a
    rule's conditions and actions, the order, Test and Run now are the browser's. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Rules" default-menu-include="false">

    <transition name="setEnabled">
        <actions><script><![CDATA[
            ec.service.sync().name('org.moqui.mail.EmailClientServices.update#EmailRule').parameters({emailRuleId: emailRuleId || '',
                enabled: enabled === 'Y' ? 'Y' : 'N'}).call()
            if (!ec.message.hasError()) ec.message.addMessage(ec.l10n.localize(enabled === 'Y' ? 'Rule turned on' : 'Rule turned off'), 'success')
        ]]></script></actions>
        <default-response url="../Rules"/>
    </transition>
    <transition name="deleteRule">
        <actions><script><![CDATA[
            ec.service.sync().name('org.moqui.mail.EmailClientServices.delete#EmailRule').parameter('emailRuleId', emailRuleId || '').call()
            if (!ec.message.hasError()) ec.message.addMessage(ec.l10n.localize(String(unblock) === 'true' ? 'Unblocked' : 'Rule deleted'), 'success')
        ]]></script></actions>
        <default-response url="../Rules"/>
    </transition>

    <actions>
        <script><![CDATA[
            const out = ec.service.sync().name('org.moqui.comms.MailSettingsServices.get#RulesView').call()
            const failed = ec.message.hasError()
            ruleList = failed ? [] : Array.from(out.ruleList || []).map((rule) => ({emailRuleId: rule.emailRuleId, ruleName: rule.ruleName || rule.emailRuleId,
                accountName: rule.accountName || '', enabled: rule.enabled === true, enabledText: ec.l10n.localize(rule.enabled ? 'On' : 'Off'),
                summary: (rule.conditionText || '') + (rule.actionText ? ' → ' + rule.actionText : ''), matchedCount: String(rule.matchedCount || 0)}))
            blockedList = failed ? [] : Array.from(out.blockedList || []).map((item) => ({emailRuleId: item.emailRuleId, emailAddress: item.emailAddress || '',
                accountName: item.accountName || '', matchedCount: String(item.matchedCount || 0)}))
        ]]></script>
    </actions>
    <widgets>
        <label type="h5" text="Rules"/>
        <label type="p" text="Rules sort new Inbox mail as it arrives, in this order. Write or change a rule's conditions and actions in a browser." style="m-muted"/>
        <form-list name="RulesTuiList" list="ruleList" skip-form="true" paginate="false">
            <field name="ruleName"><default-field title="Rule"><display style="text-weight-medium"/></default-field></field>
            <field name="summary"><default-field title="When and what"><display/></default-field></field>
            <field name="accountName"><default-field title="Account"><display style="text-caption"/></default-field></field>
            <field name="matchedCount"><default-field title="Matched"><display/></default-field></field>
            <field name="enabledText"><default-field title="On"><display/></default-field></field>
            <field name="tools" align="right"><default-field title="">
                <link url="setEnabled" link-type="hidden-form-link" text="${enabled ? 'Turn off' : 'Turn on'}"
                        parameter-map="{emailRuleId:emailRuleId, enabled:(enabled ? 'N' : 'Y')}"/>
                <link url="deleteRule" link-type="hidden-form-link" text="Delete" confirmation="Delete the rule ${ruleName}?"
                        parameter-map="{emailRuleId:emailRuleId}"/>
            </default-field></field>
        </form-list>
        <section name="RulesTuiNone" condition="!ruleList.length"><widgets>
            <label type="p" text="No rules yet" style="m-muted"/>
        </widgets></section>

        <label type="h6" text="Blocked senders"/>
        <form-list name="RulesTuiBlocked" list="blockedList" skip-form="true" paginate="false">
            <field name="emailAddress"><default-field title="Sender"><display/></default-field></field>
            <field name="accountName"><default-field title="Account"><display style="text-caption"/></default-field></field>
            <field name="matchedCount"><default-field title="Matched"><display/></default-field></field>
            <field name="tools" align="right"><default-field title="">
                <link url="deleteRule" link-type="hidden-form-link" text="Unblock" confirmation="Unblock ${emailAddress}?"
                        parameter-map="{emailRuleId:emailRuleId, unblock:'true'}"/>
            </default-field></field>
        </form-list>
        <section name="RulesTuiNoBlocked" condition="!blockedList.length"><widgets>
            <label type="p" text="No one is blocked" style="m-muted"/>
        </widgets></section>
    </widgets>
</screen>
