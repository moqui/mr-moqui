<!-- The sign-in button of a mail account (SignIn.xml): its query comes from mScreen (the dynamic-container that loaded it).
    The click opens the popup at once (moqui.oauthPopup, so no popup blocker stops it), then asks startSignIn for the
    provider's address, and signInStatus while the sign-in runs. In the wizard a new account is made by the framework when
    the sign-in succeeds (its id comes with the outcome, or from signInStatus), and the wizard goes on to its next step with
    it (mWizard); the account page shows the account again with its connection tested. A sign-in as another address asks
    the user ($q.dialog) and signs in again with their yes; a sign-in that did not finish says why under the button (no
    account was made for it). While the window is open Cancel ends the wait (the popup promise's
    cancel()): a provider's page may cut the window off from this one (Google's does), and then its closing is not seen here.
    In the wizard (offerPop) the user chooses IMAP or POP first: POP reads the Inbox from the provider's POP server, and the
    sign-in asks to allow POP too. -->
<template><div class="m-mail-sign-in">
    <div v-if="offerPop" class="q-mb-sm">
        <q-option-group v-model="storeKind" :options="kindOptions" type="radio" inline dense :disable="busy"></q-option-group>
        <div v-if="storeKind === 'pop'" class="text-caption m-muted q-mt-xs">{{popNote}}</div>
    </div>
    <div class="row items-center">
        <q-btn unelevated no-caps :color="secondary ? undefined : 'primary'" :class="secondary ? 'm-btn-tonal text-primary' : ''" icon="sym_o_login"
                :label="label" :loading="busy" :disable="busy" @click="signIn(false, null)"></q-btn>
        <template v-if="busy">
            <span class="text-body2 m-muted q-ml-md">{{t('Finish the sign-in in the window that opened.')}}</span>
            <q-btn flat dense no-caps color="primary" class="q-ml-sm" :label="t('Cancel')" @click="cancel"></q-btn>
        </template>
    </div>
    <div v-if="error" class="text-negative text-body2 q-mt-sm m-mail-sign-in-error" role="alert">{{error}}</div>
</div></template>

<script>
const t = (text) => (moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text);
const fill = (text, values) => String(text).replace(/\{(\w+)\}/g, (match, key) => (values[key] == null ? '' : String(values[key])));

module.exports = {
    name: 'MailSignIn',
    inject: { mScreen: { default: null }, mWizard: { default: null } },
    data() {
        const query = this.mScreen ? this.mScreen.parameters : {};
        return { busy: false, error: null, popup: null, storeKind: query.storeKind === 'pop' ? 'pop' : 'imap' };
    },
    computed: {
        query() { return this.mScreen ? this.mScreen.parameters : {}; },
        mode() { return this.query.mode === 'wizard' ? 'wizard' : 'account'; },
        providerLabel() { return this.query.providerLabel || t('your provider'); },
        label() { return this.query.buttonText || fill(t('Sign in with {name}'), { name: this.providerLabel }); },
        secondary() { return this.query.secondary === 'Y'; },
        offerPop() { return this.mode === 'wizard' && this.query.offerPop === 'Y'; },
        kindOptions() {
            return [{ value: 'imap', label: t('IMAP (recommended: folders and read mail stay in step everywhere)') },
                { value: 'pop', label: t('POP (downloads the Inbox only)') }];
        },
        popNote() {
            const provider = this.query.oauthProviderEnumId;
            if (provider === 'EopMicrosoft') return t('With POP, Microsoft asks you to allow POP access to your mailbox too.');
            if (provider === 'EopGoogle') return t('With POP, turn POP on in your Gmail settings (Forwarding and POP/IMAP) first.');
            return fill(t('With POP, {name} may ask you to allow POP access too.'), { name: this.providerLabel });
        },
        base() { return this.mScreen ? this.mScreen.path : this.$root.basePath + '/BasicComms/Settings/MailAccounts/SignIn'; }
    },
    methods: {
        t,
        url(name) { return this.base + '/' + name; },
        errorText(err) {
            const json = err && err.json;
            return (json && (json.errors || json.message)) || t('The sign-in could not start.');
        },
        // in the click: the window opens before any request (moqui.oauthPopup); accountId and allowChange for the second
        // sign-in after the user said the other address is fine
        signIn(allowChange, accountId) {
            if (this.busy) return;
            this.busy = true;
            this.error = null;
            const query = this.query;
            const params = { mode: accountId ? 'account' : this.mode, allowAddressChange: allowChange ? 'true' : 'false' };
            if (this.offerPop && !accountId) params.storeKind = this.storeKind;
            const fields = accountId ? { emailAccountId: accountId, oauthProviderEnumId: query.oauthProviderEnumId }
                : { emailAccountId: query.emailAccountId, emailAddress: query.emailAddress, displayName: query.displayName,
                    accountKindEnumId: query.accountKindEnumId, oauthProviderEnumId: query.oauthProviderEnumId };
            Object.keys(fields).forEach((name) => { if (fields[name]) params[name] = fields[name]; });
            let started = null;
            const start = () => moqui.request(this.url('startSignIn'), { method: 'POST', params }).then((result) => {
                started = result.json || {};
                return started;
            }, (err) => ({ errors: this.errorText(err) }));
            const status = (signInId) => moqui.request(this.url('signInStatus'), { params: { signInId } }).then((result) => result.json || {}, () => ({}));
            // the popup's promise (its cancel() is Cancel's)
            this.popup = moqui.oauthPopup(start, status);
            this.popup.then((result) => {
                this.busy = false;
                this.popup = null;
                // a new account (IMAP or POP) is made only when the sign-in succeeds
                const id = result.emailAccountId || (started && started.emailAccountId) || accountId || null;
                if (result.status === 'success') { this.signedIn(id, result, status); return; }
                if (result.errorCode === 'addressMismatch') { this.askAddress(result, id); return; }
                this.notDone(result);
            });
        },
        // the account the sign-in made or signed in: from its outcome, else asked by its signInId
        signedIn(accountId, result, status) {
            if (!accountId && result.signInId) {
                status(result.signInId).then((json) => { if (json.emailAccountId) this.signedIn(json.emailAccountId, result, status); else this.notDone(result); });
                return;
            }
            if (result.message) moqui.notifyMessages([{ type: 'success', message: result.message }]);
            if (this.mode === 'wizard' && this.mWizard) {
                this.mWizard.goTo(this.mWizard.activeIndex + 1, { emailAccountId: accountId, emailAddress: result.emailAddress || undefined });
                return;
            }
            const accounts = this.base.replace(/\/SignIn$/, '');
            this.$root.setUrl(this.$root.getLinkPath(accounts + '/Account?' + moqui.objToSearch({ emailAccountId: accountId, runTest: 'Y' })));
        },
        // signed in as another address than the account's (or the address typed in the wizard): the account takes it only
        // with the user's yes, then a new sign-in (the OK is a click, so its window may open)
        askAddress(result, accountId) {
            this.$q.dialog({ title: t('Another address'), message: fill(t('You signed in as {got}, but the account is {expected}. Make the account {got}?'),
                { got: result.emailAddress || '', expected: result.expectedAddress || '' }),
                ok: { label: fill(t('Use {got}'), { got: result.emailAddress || '' }), color: 'primary', unelevated: true, noCaps: true },
                cancel: { label: t('Cancel'), flat: true, noCaps: true } })
                .onOk(() => this.signIn(true, accountId))
                .onCancel(() => this.notDone({ status: 'cancelled', message: fill(t('Sign in as {expected} to connect this account.'), { expected: result.expectedAddress || '' }) }));
        },
        // a sign-in that did not finish: the reason shows under the button
        notDone(result) {
            this.error = result.status === 'cancelled' && !result.message ? t('The sign-in was not finished.') : (result.message || t('The sign-in did not work.'));
        },
        // the user stops waiting for the window (the popup's cancel() closes it and answers cancelled)
        cancel() { if (this.popup && this.popup.cancel) this.popup.cancel(); }
    },
    beforeUnmount() { this.cancel(); }
};
</script>
