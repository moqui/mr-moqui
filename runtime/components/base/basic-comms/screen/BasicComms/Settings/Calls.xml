<!-- Settings, Calls (plans/archive/Comms-Framework.md §5.5): the microphone, camera and speaker a call uses, a ringtone, and whether a
    call starts muted or with the camera off. These are kept in this browser only (each device has its own), by the page's
    call store (webroot js/WebrootCall.js); the component is Calls.qvue next to this file. In the terminal there are no
    devices: the twin says so. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Calls" default-menu-index="7" menu-image="sym_o_call" menu-image-type="icon"
        render-modes="vue,qvue,tui" server-static="vue,qvue">
    <widgets>
        <render-mode><text type="qvue" location="component://basic-comms/screen/BasicComms/Settings/Calls.qvue" template="false"/>
            <text type="tui" location="component://basic-comms/screen/BasicComms/Settings/Calls.tui.json" template="false"/></render-mode>
    </widgets>
</screen>
