<!-- ChatSettings (design-drawers-commons.md §17 ChatSettings; style-guide §3.9 Settings; impl-drawers-commons.md M10): the
    user's chat preferences (org.moqui.comms.ChatScreenServices get#ChatPrefs and store#ChatPrefs): the notification level the
    rooms the user makes or joins start with (CHAT_NOTIFY_DEFAULT, which the framework's ChatServices read: all, mentions or
    nothing; Apply to my rooms sets it on every room but the direct ones), whether a mention's notification shows the message
    (CHAT_NOTIFY_PREVIEW), sounds, whether Enter sends, read receipts (CHAT_READ_RECEIPTS: off, the framework neither pushes
    nor shows the user's read marker), typing, and the link previews of the user's messages (CHAT_LINK_PREVIEWS: off, the
    framework fetches none); when the user shows as away
    (CHAT_AUTO_AWAY_MINUTES, which the framework's presence reads); the do not disturb hours (apply#DndHours puts an online user
    on do not disturb in them); and the status presets (CHAT_STATUS_PRESETS) the Chat rail's status menu and the account menu's
    status dialog offer (Use sets one now). The Chat screens read these when they open. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Chat" default-menu-index="6" server-static="qvt" menu-image="sym_o_chat" menu-image-type="icon">

    <transition name="savePreferences">
        <service-call name="org.moqui.comms.ChatScreenServices.store#ChatPrefs" in-map="{enterSends:enterSends, sounds:sounds, readReceipts:readReceipts, typing:typing,
                linkPreviews:linkPreviews, notifyPreview:notifyPreview, notifyDefault:(notifyDefault ?? ''), autoAwayMinutes:autoAwayMinutes, saveFlags:true}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Chat preferences saved</message></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="saveDndHours">
        <service-call name="org.moqui.comms.ChatScreenServices.store#ChatPrefs" in-map="{dndFrom:dndFrom, dndTo:dndTo, saveDnd:true}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Do not disturb hours saved</message></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="clearDndHours">
        <service-call name="org.moqui.comms.ChatScreenServices.store#ChatPrefs" in-map="{dndFrom:'', dndTo:'', saveDnd:true}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">No do not disturb hours</message></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="applyNotifyDefault">
        <service-call name="org.moqui.comms.ChatScreenServices.apply#NotifyDefault" out-map="applyOut"/>
        <actions><if condition="!ec.message.hasError()"><script><![CDATA[
            ec.message.addMessage(ec.resource.expand(applyOut.failedCount ? '${updatedCount} rooms set, ${failedCount} could not be' : '${updatedCount} rooms set', '',
                {updatedCount: applyOut.updatedCount, failedCount: applyOut.failedCount}), applyOut.failedCount ? 'warning' : 'success')
        ]]></script></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="addPreset">
        <service-call name="org.moqui.comms.ChatScreenServices.store#StatusPreset" in-map="{action:'add', emoji:emoji, text:text, clearAfter:clearAfter}"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="removePreset">
        <service-call name="org.moqui.comms.ChatScreenServices.store#StatusPreset" in-map="{action:'remove', index:index}"/>
        <default-response url="."/>
        <error-response url="."/>
    </transition>
    <transition name="usePreset">
        <service-call name="org.moqui.comms.ChatScreenServices.use#StatusPreset" in-map="{index:index}"/>
        <actions><if condition="!ec.message.hasError()"><message type="success">Status set</message></if></actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <service-call name="org.moqui.comms.ChatScreenServices.get#ChatPrefs" out-map="prefsOut"/>
        <script><![CDATA[
            const L = (text) => ec.l10n.localize(text)
            const prefs = prefsOut.prefs
            const yn = (flag) => (flag ? 'Y' : 'N')
            chatPrefs = {notifyDefault: prefs.notifyDefault || '', notifyPreview: yn(prefs.notifyPreview), sounds: yn(prefs.sounds), enterSends: yn(prefs.enterSends), readReceipts: yn(prefs.readReceipts),
                typing: yn(prefs.typing), linkPreviews: yn(prefs.linkPreviews), autoAwayMinutes: String(prefs.autoAwayMinutes)}
            dndPrefs = {dndFrom: prefs.dndFrom || '', dndTo: prefs.dndTo || ''}
            hasDnd = !!(prefs.dndFrom && prefs.dndTo)
            dndText = hasDnd ? ec.resource.expand('Every day from ${from} to ${to}, in your time zone (${zone}).', '', {from: prefs.dndFrom, to: prefs.dndTo,
                zone: ec.user.timeZone || 'UTC'}) : L('None set')
            const clears = {'0': "Don't clear", '30': 'After 30 minutes', '60': 'After an hour', '240': 'After 4 hours', today: 'At the end of today', week: 'At the end of the week'}
            presetList = Array.from(prefs.statusPresets || []).map((preset, index) => ({index: index, emoji: preset.emoji || '', text: preset.text || '',
                clearText: L(clears[preset.clearAfter] || clears['0'])}))
            canAddPreset = presetList.length < 12
            addPreset = {emoji: '', text: '', clearAfter: '0'}
        ]]></script>
    </actions>

    <widgets>
        <label type="h5" text="Chat" style="q-mt-none q-mb-sm"/>
        <container-row>
            <row-col lg="6" md="6">
                <container-box><box-header title="Notifications and composing"/><box-body>
                    <form-single name="ChatPreferences" transition="savePreferences" map="chatPrefs">
                        <field name="notifyDefault"><default-field title="Rooms I make or join notify me of">
                            <radio><option key="" text="The room's default: all messages, mentions in a public room"/><option key="all" text="All messages"/>
                                <option key="mentions" text="Mentions only"/><option key="none" text="Nothing (they still count in the rail)"/></radio></default-field></field>
                        <field name="notifyPreview"><default-field title="Previews"><check><option key="Y" text="Show message previews in notifications"/></check></default-field></field>
                        <field name="sounds"><default-field title="Sounds"><check><option key="Y" text="Play a sound for a new message (not on do not disturb)"/></check></default-field></field>
                        <field name="enterSends"><default-field title="Enter key">
                            <radio><option key="Y" text="Enter sends, Shift+Enter is a new line"/><option key="N" text="Enter is a new line, Ctrl+Enter sends"/></radio></default-field></field>
                        <field name="readReceipts"><default-field title="Read receipts"><check><option key="Y" text="Show who has read a message, and let others see what I have read"/></check></default-field></field>
                        <field name="typing"><default-field title="Typing"><check><option key="Y" text="Show when others are typing, and tell them when I am"/></check></default-field></field>
                        <field name="linkPreviews"><default-field title="Link previews"><check><option key="Y" text="Show a preview of the links I send: the page's title and summary, no pictures"/></check></default-field></field>
                        <field name="autoAwayMinutes"><default-field title="Show me as away after">
                            <drop-down><option key="5" text="5 minutes without input"/><option key="10" text="10 minutes without input"/>
                                <option key="15" text="15 minutes without input"/><option key="30" text="30 minutes without input"/>
                                <option key="60" text="An hour without input"/></drop-down></default-field></field>
                        <field name="saveButton"><default-field title="Save"><submit/></default-field></field>
                    </form-single>
                    <container style="row items-center q-gutter-x-sm q-mt-sm">
                        <link url="applyNotifyDefault" link-type="hidden-form-link" text="Apply to my rooms now" icon="sym_o_done_all" condition="chatPrefs.notifyDefault"
                                confirmation="Set every room you are in, but the direct messages, to this notification level?"/>
                        <label type="span" text="Each room's own level stays as you set it in the room's menu; this sets them all." style="text-caption m-muted"/>
                    </container>
                </box-body></container-box>
            </row-col>
            <row-col lg="6" md="6">
                <container-box><box-header title="Do not disturb hours"/><box-body>
                    <label type="p" text="${dndText}" style="text-body2"/>
                    <form-single name="DndHours" transition="saveDndHours" map="dndPrefs">
                        <field name="dndFrom"><default-field title="From"><date-time type="time" format="HH:mm"/></default-field></field>
                        <field name="dndTo"><default-field title="To"><date-time type="time" format="HH:mm"/></default-field></field>
                        <field name="saveButton"><default-field title="Save"><submit/></default-field></field>
                        <field-layout>
                            <field-row><field-ref name="dndFrom"/><field-ref name="dndTo"/></field-row>
                            <field-ref name="saveButton"/>
                        </field-layout>
                    </form-single>
                    <section name="DndClear" condition="hasDnd"><widgets>
                        <link url="clearDndHours" link-type="hidden-form-link" text="No do not disturb hours" icon="sym_o_close"/>
                    </widgets></section>
                    <label type="p" text="In these hours you show as do not disturb when you are online: no sounds or pop-ups, and others see it. Your status comes back when they end, unless you changed it. Hours from 22:00 to 07:00 run over midnight."
                            style="text-caption m-muted q-mb-none q-mt-sm"/>
                </box-body></container-box>
                <container-box><box-header title="Status presets"/><box-body-nopad>
                    <label type="p" text="The statuses the Chat status menu offers, with when each clears." style="text-caption m-muted q-pa-sm q-mb-none"/>
                    <form-list name="StatusPresets" list="presetList" paginate="false" skip-form="true">
                        <field name="emoji"><default-field title=""><display/></default-field></field>
                        <field name="text"><default-field title="Status"><display/></default-field></field>
                        <field name="clearText"><default-field title="Clears"><display/></default-field></field>
                        <field name="useLink"><default-field title="">
                            <link url="usePreset" link-type="hidden-form-link" text="Use" parameter-map="{index:index}"/></default-field></field>
                        <field name="removeLink"><default-field title="">
                            <link url="removePreset" link-type="hidden-form-link" icon="sym_o_delete" text="" tooltip="Remove" style="m-btn-flat" parameter-map="{index:index}"
                                    confirmation="Remove the preset ${text}?"/></default-field></field>
                    </form-list>
                    <section name="AddPresetSection" condition="canAddPreset"><widgets>
                        <container style="q-pa-sm">
                            <form-single name="AddPreset" transition="addPreset" map="addPreset">
                                <field name="emoji"><default-field title="Emoji"><text-line size="4" maxlength="16"/></default-field></field>
                                <field name="text"><default-field title="Status"><text-line size="30" maxlength="100"/></default-field></field>
                                <field name="clearAfter"><default-field title="Clears">
                                    <drop-down><option key="0" text="Don't clear"/><option key="30" text="After 30 minutes"/><option key="60" text="After an hour"/>
                                        <option key="240" text="After 4 hours"/><option key="today" text="At the end of today"/><option key="week" text="At the end of the week"/></drop-down>
                                </default-field></field>
                                <field name="submitButton"><default-field title="Add"><submit/></default-field></field>
                                <field-layout>
                                    <field-row><field-ref name="emoji"/><field-ref name="text"/><field-ref name="clearAfter"/></field-row>
                                    <field-ref name="submitButton"/>
                                </field-layout>
                            </form-single>
                        </container>
                    </widgets></section>
                </box-body-nopad></container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
