<!-- The terminal twin of Recordings (style-guide §4.8): the call recordings the user may read
    (org.moqui.call.CallRecordingServices find#Recordings): when, who was in the call, its state and length, with Delete for
    the one who recorded it. There is no player in the terminal: a recording plays in the browser. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Recordings" default-menu-include="false">

    <parameter name="callSessionId"/>

    <transition name="delete">
        <actions><script><![CDATA[
            ec.service.sync().name('org.moqui.call.CallRecordingServices.delete#Recording').parameter('callRecordingId', callRecordingId || '')
                .requireNewTransaction(true).disableAuthz().call()
            if (!ec.message.hasError()) ec.message.addMessage(ec.l10n.localize('Recording deleted'), 'success')
        ]]></script></actions>
        <default-response url="."><parameter name="callSessionId"/></default-response>
        <error-response url="."><parameter name="callSessionId"/></error-response>
    </transition>

    <actions><script><![CDATA[
        const L = (text) => ec.l10n.localize(text)
        const out = ec.service.sync().name('org.moqui.call.CallRecordingServices.find#Recordings').parameters({callSessionId: callSessionId || null,
            pageSize: 50}).requireNewTransaction(true).disableAuthz().call() || {}
        ec.message.clearErrors()
        const STATES = {recording: L('Recording'), paused: L('Paused'), stopped: L('Done'), failed: L('Failed')}
        const length = (millis) => { const s = Math.round(Number(millis || 0) / 1000); return !s ? '' : s < 60 ? s + ' s' : Math.floor(s / 60) + ' min ' + (s % 60) + ' s' }
        recordingList = Array.from(out.recordingList || []).map((r) => ({callRecordingId: r.callRecordingId,
            whenText: r.startedDate ? ec.l10n.format(new Date(Number(r.startedDate)), 'MMM d, h:mm a') : '',
            who: Array.from(r.people || []).join(', '), stateText: (STATES[r.state] || r.state) + (r.lastErrorText ? ' (' + r.lastErrorText + ')' : ''),
            lengthText: length(r.durationMs), byText: r.ownerName || '', canDelete: !!r.canDelete}))
    ]]></script></actions>

    <widgets>
        <label type="p" text="Call recordings you may play: yours, and those of calls you host. They play in the browser." style="m-muted"/>
        <section name="NoRecordings" condition="!recordingList.length"><widgets><label type="p" text="No recordings yet."/></widgets></section>
        <form-list name="RecordingList" list="recordingList" skip-form="true">
            <field name="whenText"><default-field title="When"><display/></default-field></field>
            <field name="who"><default-field title="With"><display/></default-field></field>
            <field name="stateText"><default-field title="State"><display/></default-field></field>
            <field name="lengthText"><default-field title="Length"><display/></default-field></field>
            <field name="byText"><default-field title="Recorded by"><display/></default-field></field>
            <field name="actions"><default-field title="">
                <link url="delete" text="Delete" icon="sym_o_delete" condition="canDelete" confirmation="Delete this recording and its files?">
                    <parameter name="callRecordingId"/><parameter name="callSessionId"/></link>
            </default-field></field>
        </form-list>
    </widgets>
</screen>
