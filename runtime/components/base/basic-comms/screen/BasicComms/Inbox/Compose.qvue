<!-- The composer (design-drawers-commons.md §12 Compose), the component Compose.xml serves in the qvue render mode. Its query
    (mScreen: the URL its m-dynamic-container loaded, or the page's) says what it writes: a draft
    (emailMessageId), a reply or forward (replyToEmailMessageId with replyAll, forwardEmailMessageId; replyToCommEventId with
    replyToSender for an internal message or a mailbox post), a post to a mailbox (contactListId), mailto-style to, cc, bcc,
    subject and body, and the record chip (recordEntity, recordId). mode is dock (a card of the Inbox, which provides
    mComposeHost to minimize, pop out, close and hear of the send), embedded (quick create, Chatter's dialog: mSubmitHide
    closes it after the send) or the page. From is an identity of a mail account the user may send from, or the Internal
    identity; the recipients are chips (addresses for email, people and mailboxes for an internal message); the body is
    m-rich-text with the plain-text toggle, the signature of the identity, the quoted message apart, text blocks (the button,
    or / at the start of a word), files (drop or pick, or Attach from Files: the drive picker, copies attached, a link put in
    the message for a file over 25 MB or a folder), Send (Ctrl+Enter) with the undo hold, Schedule send, Send and
    archive, Discard. Email drafts save on the server every few seconds; an internal message keeps its draft in this browser
    until it is sent. In the desktop client with its server out of reach a banner says that an email waits in the outbox and
    an internal message as a draft (or in the outbox too, where the server takes its send once: the app's
    outbox.kinds().internalSend); with nothing kept to start from, a new email (still answering the message of a reply or
    forward). A queued send carries baseStamp, the server's draft as this composer saw it, so a draft changed elsewhere is
    a conflict: the app keeps the user's version as a copy, which copyRef opens here as a new draft. Brand color names
    and Quasar classes only (style-guide §4.8, §5). -->
<template><div class="m-compose">
    <compose-shell :layout="layout" :title="title" :minimized="minimized" :phone="isPhone" @minimize="minimize" @popout="popOut" @popin="popIn" @close="close">
        <div class="column no-wrap" :class="layout === 'dock' ? 'col' : ''" style="min-height:0" @dragover.prevent="dragOver = true" @dragleave.self="dragOver = false"
                @drop.prevent="onDrop" @keydown="onKeydown">
            <div v-if="state === 'loading'" class="q-pa-md">
                <q-skeleton type="text" width="50%"></q-skeleton><q-skeleton type="text"></q-skeleton><q-skeleton type="rect" height="140px" class="q-mt-sm"></q-skeleton>
            </div>
            <div v-else-if="state === 'failed'" class="q-pa-md">
                <div class="text-negative">{{error || t('This message cannot be written here')}}</div>
                <q-btn flat dense no-caps color="primary" class="q-mt-sm" :label="t('Close')" @click="close"></q-btn>
            </div>
            <template v-else>
                <!-- the desktop client with its server out of reach (never on the web) -->
                <q-banner v-if="noConnection" dense rounded class="q-mx-md q-mt-sm m-tonal text-caption m-compose-offline">
                    <template v-slot:avatar><q-icon name="sym_o_cloud_off" color="warning"></q-icon></template>
                    {{mode === 'internal' ? (internalSend ? t('Offline: this message waits in the outbox and goes when the server can be reached; files need a connection.')
                        : t('Offline: an internal message needs a connection to send; it is kept here as a draft until then.'))
                        : t('Offline: this email waits in the outbox, with its files, and goes when the server can be reached.')}}
                    <div v-if="offlineNote">{{offlineNote}}</div></q-banner>
                <!-- the desktop client: the user's version of a draft that changed elsewhere, kept as a copy (MD5) -->
                <q-banner v-if="copyOf" dense rounded class="q-mx-md q-mt-sm m-tonal text-caption m-compose-copy">
                    <template v-slot:avatar><q-icon name="sym_o_file_copy" color="warning"></q-icon></template>
                    {{t('Your version, kept as a copy: the draft was changed elsewhere, and that one stays as it is. This is a new draft.')}}</q-banner>
                <div v-else-if="offlineNote && !noConnection" class="q-mx-md q-mt-sm text-caption text-warning">{{offlineNote}}</div>
                <q-banner v-if="noFrom && !noConnection" dense rounded role="status" class="q-mx-md q-mt-sm m-tonal m-compose-no-from">
                    {{fromMessage}}
                    <div class="text-caption">{{t('Keep this message open while you set up an account. Return here and refresh sending identities to continue.')}}</div>
                    <div v-if="identityError" role="alert" class="text-negative text-caption">{{identityError}}</div>
                    <template v-slot:action>
                        <q-btn flat dense no-caps color="primary" :href="appLink() + 'Settings/MailAccounts'" target="_blank" rel="noopener"
                                :label="t('Mail accounts (new tab)')"></q-btn>
                        <q-btn flat dense no-caps color="primary" :label="t('Refresh sending identities')" :loading="refreshingIdentities" @click="refreshIdentities"></q-btn>
                    </template>
                </q-banner>
                <q-banner v-if="saveError" dense rounded role="alert" class="q-mx-md q-mt-sm m-tonal text-negative m-compose-save-error">
                    {{t('Your changes have not been saved. Keep this message open and try again.')}}
                    <div class="text-caption">{{saveError}}</div>
                    <template v-slot:action><q-btn flat dense no-caps color="primary" :label="t('Retry save')" :loading="saving" @click="save(true)"></q-btn></template>
                </q-banner>
                <!-- the fields -->
                <div class="q-px-md q-pt-sm">
                    <div class="row items-center no-wrap">
                        <span class="text-caption m-muted" style="width:52px">{{t('From')}}</span>
                        <div class="col"><m-drop-down v-if="identityOptions.length" v-model="draft.fromValue" name="fromValue" :options="identityOptions" :disable="identityOptions.length < 2"></m-drop-down>
                            <span v-else class="text-caption m-muted">{{t('No sending identity available')}}</span></div>
                    </div>
                    <div v-for="field in recipientFields" :key="field.name" class="row items-start no-wrap q-mt-xs">
                        <span class="text-caption m-muted q-pt-sm" style="width:52px">{{field.label}}</span>
                        <div class="col row items-center" style="min-width:0">
                            <q-chip v-for="chip in draft[field.name]" :key="chip.value" dense square :removable="!chip.locked" :icon="chipIcon(chip)" class="q-ml-none q-mr-xs"
                                    :class="chipClass(chip)" @remove="removeChip(field.name, chip)">{{chip.label}}<q-tooltip v-if="chip.kind === 'mailbox'">{{t('A mailbox: its members get the post')}}</q-tooltip></q-chip>
                            <div class="col" style="min-width:150px">
                                <m-drop-down :ref="'add_' + field.name" :model-value="adding[field.name]" @update:model-value="addChip(field.name, $event)" :name="'add_' + field.name"
                                        server-search combo :server-min-length="mode === 'internal' ? 0 : 1" :options-url="url('recipients')" :options-parameters="{mode: mode}"
                                        :label="draft[field.name].length ? '' : field.placeholder"></m-drop-down>
                            </div>
                        </div>
                        <div v-if="field.name === 'to'" class="row no-wrap q-pt-xs">
                            <q-btn v-if="!showCc" flat dense no-caps size="sm" :label="t('Cc')" @click="showCc = true"></q-btn>
                            <q-btn v-if="!showBcc && mode === 'email'" flat dense no-caps size="sm" :label="t('Bcc')" @click="showBcc = true"></q-btn>
                        </div>
                    </div>
                    <m-text-line v-model="draft.subject" name="subject" :label="t('Subject')" class="q-mt-xs"></m-text-line>
                    <div v-if="draft.record || draft.contactListName" class="row items-center q-mt-xs q-gutter-xs">
                        <q-chip v-if="draft.record" dense square removable :icon="draft.record.icon || 'sym_o_link'" class="m-tonal text-primary q-ml-none" @remove="draft.record = null">
                            {{t('File on')}} {{(draft.record.typeLabel ? draft.record.typeLabel + ' ' : '') + draft.record.title}}
                            <q-tooltip>{{t('The sent message shows in this record\'s Chatter')}}</q-tooltip></q-chip>
                        <span v-if="mode === 'internal' && draft.parentCommEventId && !draft.contactListId" class="text-caption m-muted">{{t('The thread\'s people get the reply; add more if you like')}}</span>
                    </div>
                </div>

                <!-- the body, the quoted message, the files -->
                <div class="q-px-md q-pt-xs" :class="layout === 'dock' ? 'col scroll' : ''" style="min-height:0">
                    <div @keyup="onEditorKeyup">
                        <m-rich-text ref="editor" v-model="draft.body" v-model:plain="draft.plain" name="body" :rows="layout === 'dock' ? 7 : 14"
                                :placeholder="t('Write your message… (/ for text blocks)')" @submit="send()"></m-rich-text>
                    </div>
                    <div v-if="draft.quoteHtml" class="q-mt-xs">
                        <q-btn flat dense size="sm" icon="sym_o_more_horiz" :aria-label="showQuote ? t('Hide the quoted text') : t('Show the quoted text')" @click="showQuote = !showQuote">
                            <q-tooltip>{{showQuote ? t('Hide the quoted text') : t('Show the quoted text')}}</q-tooltip></q-btn>
                        <template v-if="showQuote">
                            <m-html-view :html="draft.quoteHtml" :collapse-quotes="false" :images-bar="false" title="Quoted text"></m-html-view>
                            <q-btn flat dense no-caps size="sm" color="negative" :label="t('Remove the quoted text')" @click="removeQuote"></q-btn>
                        </template>
                    </div>
                    <m-html-view v-if="belowSignature" :html="signatureBlock(belowSignature)" :collapse-quotes="false" :images-bar="false" title="Signature" class="q-mt-xs"></m-html-view>
                    <div v-if="draft.attachments.length || draft.uploads.length || queued.length || uploading" class="row q-gutter-xs q-mt-xs">
                        <q-chip v-for="file in draft.attachments" :key="'a' + file.id" dense square removable icon="sym_o_attach_file" class="m-tonal q-ml-none"
                                @remove="removeAttachment(file)">{{file.name}}<span v-if="file.size" class="m-muted q-ml-xs">{{sizeText(file.size)}}</span></q-chip>
                        <q-chip v-for="file in draft.uploads" :key="'u' + file.location" dense square removable icon="sym_o_attach_file" class="m-tonal q-ml-none"
                                @remove="removeUpload(file)">{{file.name}}<span v-if="file.size" class="m-muted q-ml-xs">{{sizeText(file.size)}}</span></q-chip>
                        <q-chip v-for="file in queued" :key="'q' + file.file" dense square removable icon="sym_o_schedule" class="m-tonal q-ml-none"
                                @remove="removeQueued(file)">{{file.name}}<span v-if="file.size" class="m-muted q-ml-xs">{{sizeText(file.size)}}</span></q-chip>
                        <q-chip v-if="uploading" dense square class="q-ml-none"><q-spinner size="14px" class="q-mr-xs"></q-spinner>{{t('Uploading…')}}</q-chip>
                    </div>
                    <div v-if="dragOver" class="q-pa-lg q-mt-xs text-center text-primary rounded-borders" style="border:2px dashed">{{t('Drop files to attach them')}}</div>
                </div>

                <!-- the send row -->
                <div class="row items-center no-wrap q-px-sm q-py-xs q-gutter-x-xs">
                    <q-btn-dropdown split unelevated no-caps color="primary" icon="sym_o_send" :label="t('Send')" :loading="sending" :disable="sending || uploading || noFrom" @click="send()">
                        <q-list dense style="min-width:200px">
                            <q-item clickable v-close-popup @click="scheduleOpen = true"><q-item-section avatar><q-icon name="sym_o_schedule_send"></q-icon></q-item-section>
                                <q-item-section>{{t('Schedule send…')}}</q-item-section></q-item>
                            <q-item v-if="draft.threadId" clickable v-close-popup @click="send({ archive: true })"><q-item-section avatar><q-icon name="sym_o_archive"></q-icon></q-item-section>
                                <q-item-section>{{t('Send and archive')}}</q-item-section></q-item>
                        </q-list>
                    </q-btn-dropdown>
                    <q-btn flat round dense icon="sym_o_attach_file" :aria-label="t('Attach files')" @click="pickFiles"><q-tooltip>{{t('Attach files')}}</q-tooltip></q-btn>
                    <q-btn v-if="hasDrive" flat round dense icon="sym_o_add_to_drive" :aria-label="t('Attach from Files')" @click="openPicker"><q-tooltip>{{t('Attach from Files')}}</q-tooltip></q-btn>
                    <q-btn flat round dense icon="sym_o_text_snippet" :aria-label="t('Text blocks')"><q-tooltip>{{t('Text blocks')}} (/)</q-tooltip>
                        <q-menu v-model="blocksOpen" @before-show="loadBlocks" anchor="top left" self="bottom left">
                            <div class="q-pa-sm" style="width:320px;max-width:90vw">
                                <m-text-line v-model="blockSearch" name="blockSearch" :label="t('Find a text block')"></m-text-line>
                                <q-list dense class="q-mt-xs" style="max-height:240px;overflow:auto">
                                    <q-item v-for="block in shownBlocks" :key="block.emailTextBlockId" clickable v-close-popup @click="insertBlock(block)">
                                        <q-item-section><q-item-label>{{block.title}}</q-item-label>
                                            <q-item-label caption class="ellipsis">{{blockText(block)}}</q-item-label></q-item-section>
                                        <q-item-section v-if="block.shortcut" side class="text-caption">{{block.shortcut}}</q-item-section>
                                    </q-item>
                                    <q-item v-if="!shownBlocks.length"><q-item-section class="m-muted">{{blocks.length ? t('No text blocks match') : t('No text blocks yet')}}</q-item-section></q-item>
                                </q-list>
                                <q-btn flat dense no-caps size="sm" color="primary" :label="t('Manage text blocks')" @click="go(appLink() + 'Settings/TextBlocks')"></q-btn>
                            </div>
                        </q-menu>
                    </q-btn>
                    <div class="hidden"><m-file ref="picker" v-model="picked" name="contentFile" multiple @update:model-value="onPicked"></m-file></div>
                    <q-space></q-space>
                    <span class="text-caption m-muted ellipsis gt-xs">{{savedText}}</span>
                    <q-btn flat round dense icon="sym_o_delete" :aria-label="t('Discard')" @click="discard"><q-tooltip>{{t('Discard')}}</q-tooltip></q-btn>
                </div>
            </template>
        </div>
    </compose-shell>

    <!-- ScheduleSend -->
    <m-dialog v-model="scheduleOpen" :title="t('Schedule send')" width="400">
        <q-list dense>
            <q-item v-for="option in scheduleOptions" :key="option.key" clickable @click="schedule(option.at)">
                <q-item-section avatar><q-icon :name="option.icon"></q-icon></q-item-section>
                <q-item-section>{{option.label}}</q-item-section>
                <q-item-section side class="text-caption">{{whenText(option.at)}}</q-item-section>
            </q-item>
        </q-list>
        <q-separator class="q-my-sm"></q-separator>
        <div class="row items-end q-gutter-sm">
            <div class="col"><m-date-time v-model="scheduleCustom" name="scheduleAt" type="date-time" :label="t('Pick a date and time')"></m-date-time></div>
            <q-btn unelevated no-caps color="primary" :label="t('Schedule')" :disable="!scheduleCustom" @click="schedule(parseDateTime(scheduleCustom))"></q-btn>
        </div>
    </m-dialog>

    <!-- AttachFromFiles: the drives, a folder or a search, the files to attach -->
    <m-dialog v-model="picker.open" :title="t('Attach from Files')" width="640">
        <div class="row items-center q-gutter-xs">
            <q-chip v-for="drive in picker.drives" :key="drive.driveId" dense square clickable :class="picker.driveId === drive.driveId && !picker.searching ? 'm-tonal text-primary' : ''"
                    @click="pickerOpen(drive.driveId, '')">{{drive.driveName}}</q-chip>
        </div>
        <div class="q-mt-xs" @keydown.enter.prevent="pickerSearch"><m-text-line v-model="picker.text" name="pickerText" :label="t('Search files')"></m-text-line></div>
        <div v-if="!picker.searching" class="row items-center no-wrap q-mt-xs" style="overflow:hidden">
            <template v-for="(crumb, index) in picker.crumbs" :key="index">
                <q-icon v-if="index" name="sym_o_chevron_right" size="16px" class="m-muted"></q-icon>
                <q-btn flat dense no-caps size="sm" @click="pickerOpen(picker.driveId, crumb.path)">{{crumb.name}}</q-btn>
            </template>
        </div>
        <div v-else class="text-caption m-muted q-mt-xs">{{picker.text ? t('Found') : t('Recent files')}}</div>
        <q-list dense bordered separator class="q-mt-xs rounded-borders" style="max-height:320px;overflow:auto">
            <q-item v-if="picker.loading"><q-item-section class="text-center"><q-spinner></q-spinner></q-item-section></q-item>
            <q-item v-for="row in picker.rows" :key="pickerKey(row)" clickable @click="pickerClick(row)">
                <q-item-section side @click.stop><q-checkbox v-if="!row.isDirectory || row.path" dense size="sm" :model-value="!!picker.chosen[pickerKey(row)]"
                        @update:model-value="pickerToggle(row)"></q-checkbox></q-item-section>
                <q-item-section avatar style="min-width:30px"><q-icon :name="row.icon || (row.isDirectory ? 'sym_o_folder' : 'sym_o_draft')" size="20px"></q-icon></q-item-section>
                <q-item-section><q-item-label class="ellipsis">{{row.recordTitle || row.name}}</q-item-label>
                    <q-item-label caption class="ellipsis">{{pickerCaption(row)}}</q-item-label></q-item-section>
                <q-item-section v-if="row.isDirectory" side><q-icon name="sym_o_chevron_right" size="18px"></q-icon></q-item-section>
            </q-item>
            <q-item v-if="!picker.loading && !picker.rows.length"><q-item-section class="text-caption m-muted">{{t('No files here')}}</q-item-section></q-item>
        </q-list>
        <div class="row items-center q-mt-md q-gutter-sm">
            <q-btn unelevated no-caps color="primary" icon="sym_o_attach_file" :label="pickerCount ? t('Attach') + ' ' + pickerCount : t('Attach')" :disable="!pickerCount"
                    :loading="picker.saving" @click="pickerAttach"></q-btn>
            <q-btn flat no-caps :label="t('Cancel')" @click="picker.open = false"></q-btn>
            <span class="text-caption m-muted">{{t('Over 25 MB, or a folder: a link to it goes in the message')}}</span>
        </div>
    </m-dialog>

</div></template>

<script>
const t = (text) => (moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text);
let composeCount = 0;
// whether the user has a drive for Attach from Files, asked once per transition URL (pickerData checkOnly)
const driveChecks = {};
// the chrome of each layout around the one form (its slot): the dock card, the pop-out dialog, the page's box, nothing
const shellTemplate = '' +
    '<q-card v-if="layout === \'dock\'" flat bordered class="column no-wrap shadow-10" :style="dockStyle">' +
        '<div class="row items-center no-wrap q-pl-md q-pr-xs bg-primary text-white cursor-pointer" style="min-height:40px" @click="minimized ? $emit(\'minimize\', false) : null">' +
            '<div class="col ellipsis text-subtitle2">{{title}}</div>' +
            '<q-btn flat round dense size="sm" :icon="minimized ? \'sym_o_expand_less\' : \'sym_o_minimize\'" :aria-label="minimized ? t(\'Open\') : t(\'Minimize\')" @click.stop="$emit(\'minimize\', !minimized)"></q-btn>' +
            '<q-btn v-if="!phone" flat round dense size="sm" icon="sym_o_open_in_full" :aria-label="t(\'Pop out\')" @click.stop="$emit(\'popout\')"><q-tooltip>{{t(\'Pop out\')}}</q-tooltip></q-btn>' +
            '<q-btn flat round dense size="sm" icon="sym_o_close" :aria-label="t(\'Close\')" @click.stop="$emit(\'close\')"><q-tooltip>{{t(\'Save and close\')}}</q-tooltip></q-btn>' +
        '</div>' +
        '<div v-show="!minimized" class="col column no-wrap" style="min-height:0"><slot></slot></div>' +
    '</q-card>' +
    '<m-dialog v-else-if="layout === \'dialog\'" :model-value="true" @update:model-value="$emit(\'popin\')" :title="title" width="900"><slot></slot></m-dialog>' +
    '<div v-else-if="layout === \'page\'" class="q-pa-sm" style="max-width:980px;margin:0 auto"><m-container-box :title="title"><slot></slot></m-container-box></div>' +
    '<div v-else><slot></slot></div>';

module.exports = {
    name: 'MailCompose',
    inject: { mComposeHost: { default: null }, mSubmitHide: { default: null }, mScreen: { default: null } },
    components: {
        'compose-shell': {
            props: { layout: String, title: String, minimized: Boolean, phone: Boolean },
            emits: ['minimize', 'popout', 'popin', 'close'],
            computed: {
                dockStyle() {
                    if (this.phone) return { width: '100vw', height: this.minimized ? 'auto' : '100vh' };
                    return this.minimized ? { width: '280px' } : { width: '540px', height: 'min(600px, 82vh)' };
                }
            },
            methods: { t },
            template: shellTemplate
        }
    },
    data() {
        composeCount += 1;
        return {
            uid: composeCount, query: {}, state: 'loading', error: null, draft: this.emptyDraft(), identities: [], me: {}, undoSeconds: 10, kind: 'new',
            adding: { to: null, cc: null, bcc: null }, showCc: false, showBcc: false, showQuote: false, dragOver: false, uploading: false, picked: null,
            sending: false, sent: false, savedAt: null, saving: false, saveError: null, dirty: false, saveTimer: null, scheduleOpen: false, scheduleCustom: '',
            blocksOpen: false, blocks: [], blockSearch: '', slashPending: false, signature: null, signaturePlacement: 'above', belowSignature: null,
            loadedOnce: false, pageLayoutOverride: null, hasDrive: false,
            // the desktop client offline (MD4): the files kept by the app until the message is sent from its outbox, the
            // message's clientRef, and whether the email's draft is kept here, not yet on the server
            queued: [], clientRef: null, offlineDraft: false, localEmailKey: null, offlineNote: null, refreshingIdentities: false, identityError: null,
            // MD5: the server's draftStamp of the draft as this composer last saw it (a queued send's baseStamp), whether the
            // app's outbox takes an internal message's send (its kinds().internalSend), and the conflict this copy was kept from
            draftStamp: null, internalSend: false, copyOf: null,
            picker: { open: false, drives: [], driveId: null, path: '', crumbs: [], rows: [], loading: false, text: '', searching: false, chosen: {}, saving: false }
        };
    },
    computed: {
        isPhone() { return this.$q.screen.lt.sm; },
        dockKey() { return this.query.dockKey || null; },
        hostDock() { return this.mComposeHost && this.dockKey ? this.mComposeHost.get(this.dockKey) : null; },
        layout() {
            if (this.query.mode === 'dock' && this.mComposeHost) return this.hostDock && this.hostDock.layout === 'dialog' ? 'dialog' : 'dock';
            if (this.query.mode === 'embedded' || this.mSubmitHide) return 'embedded';
            return 'page';
        },
        minimized() { return !!(this.hostDock && this.hostDock.minimized); },
        // the desktop client's server out of reach (moqui.connection; never on the web)
        noConnection() { return !!(moqui.connection && moqui.connection.offline); },
        noFrom() { return this.state === 'ready' && !this.identityOptions.some((identity) => identity.value === this.draft.fromValue); },
        fromMessage() {
            if (this.noConnection) return t('No mail account is known on this computer yet: send it once the server can be reached');
            return this.identityOptions.length ? t('Choose a sending identity in From before saving or sending this message.')
                : t('No sending identity is available. Add a mail account or ask its owner for sending access before saving or sending email.');
        },
        mode() { return this.draft.fromValue === 'internal' ? 'internal' : 'email'; },
        draftId() { return this.draft.emailMessageId || null; },
        title() {
            if (this.draft.subject) return this.draft.subject;
            const kinds = { reply: t('Reply'), replyAll: t('Reply all'), replySender: t('Reply to sender'), forward: t('Forward'), draft: t('Draft') };
            return kinds[this.kind] || t('New message');
        },
        identityOptions() {
            let list = this.identities;
            if (this.draft.parentEmailMessageId || this.kind === 'forward') list = list.filter((item) => !item.isInternal);
            if (this.draft.parentCommEventId || this.draft.contactListId) list = list.filter((item) => item.isInternal);
            return list.map((item) => ({ value: item.value, label: item.label }));
        },
        recipientFields() {
            const fields = [{ name: 'to', label: t('To'), placeholder: this.mode === 'internal' ? t('People or mailboxes') : t('Recipients') }];
            if (this.showCc || this.draft.cc.length) fields.push({ name: 'cc', label: t('Cc'), placeholder: '' });
            if ((this.showBcc || this.draft.bcc.length) && this.mode === 'email') fields.push({ name: 'bcc', label: t('Bcc'), placeholder: '' });
            return fields;
        },
        isEmpty() {
            const d = this.draft;
            const text = String(d.body || '').replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').trim();
            return !d.to.length && !d.cc.length && !d.bcc.length && !String(d.subject || '').trim() && !text && !d.attachments.length && !d.uploads.length;
        },
        savedText() {
            if (this.saving) return t('Saving…');
            if (this.saveError) return t('Not saved');
            if (this.dirty) return t('Unsaved changes');
            if (this.mode === 'internal') return this.dirty ? '' : (this.savedAt ? t('Kept in this browser') : '');
            if (this.offlineDraft && this.savedAt) return t('Kept on this computer');
            return this.savedAt ? t('Saved') + ' ' + moqui.l10n.formatZoned(this.savedAt, { hour: 'numeric', minute: '2-digit' }) : '';
        },
        shownBlocks() {
            const term = String(this.blockSearch || '').toLowerCase();
            return this.blocks.filter((block) => !term || String(block.title || '').toLowerCase().includes(term) || String(block.shortcut || '').toLowerCase().includes(term));
        },
        scheduleOptions() {
            const now = new Date();
            const at = (days, hour) => new Date(now.getFullYear(), now.getMonth(), now.getDate() + days, hour, 0, 0).getTime();
            const toMonday = (8 - now.getDay()) % 7 || 7;
            return [{ key: 'tomorrowAm', label: t('Tomorrow morning'), icon: 'sym_o_wb_sunny', at: at(1, 8) },
                { key: 'tomorrowPm', label: t('Tomorrow afternoon'), icon: 'sym_o_light_mode', at: at(1, 13) },
                { key: 'monday', label: t('Monday morning'), icon: 'sym_o_next_week', at: at(toMonday, 8) }];
        },
        pickerCount() { return Object.keys(this.picker.chosen).filter((key) => this.picker.chosen[key]).length; },
        // under the storage scope (moqui.drafts), or in the desktop client's store
        draftSlot() { return this.dockKey || ('page.' + (this.query.contactListId || this.query.replyToCommEventId || 'new')); },
        draftStorageKey() { return 'ironstone.compose.' + this.draftSlot; },
        // the desktop client: an email kept offline, by its message (the server's draft, else its clientRef), and for a new
        // one the clientRef this composer's slot last kept, so it opens again here
        emailLocalKey() { return 'ironstone.compose.email.' + (this.draft.emailMessageId || this.clientRef); },
        emailRefKey() { return 'ironstone.compose.emailRef.' + this.draftSlot; }
    },
    watch: {
        draft: { handler() { this.onChange(); }, deep: true },
        title(value) { if (this.mComposeHost && this.dockKey) this.mComposeHost.retitle(this.dockKey, value); },
        'draft.fromValue'(value, old) { if (this.state === 'ready' && !this.refreshingIdentities && old && value !== old) this.swapSignature(old, value); },
        // the page: a new query is a new message
        'mScreen.parameters': { handler() { if (this.layout === 'page' && this.loadedOnce && this.queryChanged()) this.start(); }, deep: true }
    },
    methods: {
        t,
        emptyDraft() {
            return { fromValue: null, to: [], cc: [], bcc: [], subject: '', body: '', plain: false, quoteHtml: null, emailMessageId: null, parentEmailMessageId: null,
                isForward: false, parentCommEventId: null, replyToSenderOnly: false, contactListId: null, contactListName: null, record: null, attachments: [],
                uploads: [], threadStore: null, threadId: null };
        },
        // the query this composer was loaded with and its own path (mScreen: its container's URL, or the page's)
        readQuery() { return Object.assign({}, this.mScreen ? this.mScreen.parameters : this.$root.currentParameters); },
        queryChanged() {
            const next = this.readQuery();
            return JSON.stringify(next) !== JSON.stringify(this.query);
        },
        base() { return this.mScreen ? this.mScreen.path : this.$root.basePath + '/BasicComms/Inbox/Compose'; },
        // a link under the app that mounts Compose (BasicComms, or an app's own Comms), ending in /
        appLink() {
            const base = this.base().replace(/\/Inbox\/Compose$/, '/');
            const root = this.$root;
            return base.indexOf(root.basePath + '/') === 0 ? root.linkBasePath + base.slice(root.basePath.length) : base;
        },
        url(name) { return this.base() + '/' + name; },
        go(target) { if (target) this.$root.setUrl(target); },
        refreshIdentities() {
            if (this.refreshingIdentities) return;
            this.refreshingIdentities = true;
            this.identityError = null;
            // No draft/reply/forward parameters: read the available identities without reinitializing this message.
            return moqui.request(this.url('composeData')).then((result) => {
                const compose = result.json && result.json.compose;
                if (!compose || !Array.isArray(compose.identityList)) throw new Error('No identities in compose data');
                this.identities = compose.identityList;
                if (!this.identityOptions.some((identity) => identity.value === this.draft.fromValue)) {
                    this.draft.fromValue = (this.identityOptions.find((identity) => identity.value === compose.fromValue) || this.identityOptions[0] || {}).value || null;
                }
                if (!this.noFrom) this.saveError = null;
            }).catch(() => {
                this.identityError = t('Sending identities could not be refreshed. Check your connection and try again.');
            }).finally(() => { this.refreshingIdentities = false; });
        },
        start() {
            this.query = this.readQuery();
            this.state = 'loading';
            this.error = null;
            this.saveError = null;
            this.queued = [];
            this.offlineDraft = false;
            this.localEmailKey = null;
            this.offlineNote = null;
            this.draftStamp = null;
            this.copyOf = null;
            const host = moqui.hostOutbox();
            this.clientRef = host ? 'm' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10) : null;
            if (host && typeof host.kinds === 'function') {
                Promise.resolve(host.kinds()).then((kinds) => { this.internalSend = !!(kinds && kinds.internalSend); }, () => { this.internalSend = false; });
            }
            const q = this.query;
            const params = {};
            ['emailMessageId', 'replyToEmailMessageId', 'forwardEmailMessageId', 'replyAll', 'replyToCommEventId', 'replyToSender', 'contactListId', 'to', 'cc',
                'bcc', 'subject', 'body', 'recordEntity', 'recordId'].forEach((name) => { if (q[name] != null && q[name] !== '') params[name] = q[name]; });
            moqui.request(this.url('composeData'), { params }).then((result) => {
                const json = result.json || {};
                if (!json.compose) { this.state = 'failed'; return; }
                // the desktop client's answer from its store (offline.rs compose_json): the message answered is not kept there,
                // or a forward's files, which only the server copies, are left out
                const hint = json.offline || {};
                if (hint.messageMissing) this.offlineNote = t('The message this answers is not kept on this computer: add its recipients.');
                else if (hint.forwardFilesMissing) this.offlineNote = t('Its {count} files are not attached: forward it again when the server can be reached, or attach them.')
                    .replace('{count}', String(hint.forwardFilesMissing));
                this.startWith(json.compose);
            }, (err) => {
                // the desktop client with its server out of reach and nothing kept to start from: a new email, which waits in
                // the outbox; still a reply or forward of the message, so it threads. A draft, an internal reply and a mailbox
                // post need the server. Never on the web.
                if (moqui.hostOutbox() && this.unreachable(err)) {
                    if (!q.emailMessageId && !q.replyToCommEventId && !q.contactListId) {
                        const parent = q.replyToEmailMessageId || q.forwardEmailMessageId || null;
                        const forward = !q.replyToEmailMessageId && !!parent;
                        // no composeData was ever kept here, so no mail account is known to send from (noFrom)
                        this.offlineNote = (parent ? t('The message this answers is not kept on this computer: add its recipients.') + ' ' : '') +
                            t('No mail account is known on this computer yet: write it now and send it once the server can be reached.');
                        this.startWith({ kind: parent ? (forward ? 'forward' : (String(q.replyAll) === 'true' ? 'replyAll' : 'reply')) : 'new',
                            parentEmailMessageId: parent, isForward: forward });
                        return;
                    }
                    this.state = 'failed';
                    this.error = t('This needs a connection to the server; open it again when the server can be reached.');
                    return;
                }
                this.state = 'failed';
                this.error = (err && err.json && err.json.errors) || t('This message cannot be written here');
            });
        },
        startWith(compose) {
            this.apply(compose);
            this.restoreLocal();
            this.loadedOnce = true;
            this.$nextTick(() => { this.state = 'ready'; this.dirty = false; this.focusFirst(); });
        },
        apply(compose) {
            this.identities = compose.identityList || [];
            this.me = compose.me || {};
            this.undoSeconds = compose.undoSeconds != null ? Number(compose.undoSeconds) : 10;
            this.signaturePlacement = compose.signaturePlacement === 'below' ? 'below' : 'above';
            this.belowSignature = null;
            this.kind = compose.kind || 'new';
            const draft = this.emptyDraft();
            Object.assign(draft, { fromValue: compose.fromValue, to: compose.to || [], cc: compose.cc || [], bcc: compose.bcc || [], subject: compose.subject || '',
                body: compose.body || '', quoteHtml: compose.quoteHtml || null, emailMessageId: compose.emailMessageId || null,
                parentEmailMessageId: compose.parentEmailMessageId || null, isForward: !!compose.isForward, parentCommEventId: compose.parentCommEventId || null,
                replyToSenderOnly: !!compose.replyToSenderOnly, contactListId: compose.contactListId || null, contactListName: compose.contactListName || null,
                record: compose.record || null, attachments: compose.attachmentList || [], threadStore: compose.threadStore || null, threadId: compose.threadId || null });
            if (!draft.fromValue && this.identities.length) draft.fromValue = this.identities[0].value;
            // the identity's signature, on a new message, a forward, or a reply when the identity says so.
            // Below the quote it stays out of the body and is sent after the quoted text; with no quote it goes in the body.
            const identity = this.identities.find((item) => item.value === draft.fromValue);
            if (identity && identity.signatureHtml && this.kind !== 'draft' && (['new', 'forward'].includes(this.kind) || identity.useForReplies)) {
                if (this.signaturePlacement === 'below' && draft.quoteHtml) this.belowSignature = identity.signatureHtml;
                else draft.body = (draft.body || '<p></p>') + this.signatureBlock(identity.signatureHtml);
                this.signature = identity.value;
            }
            this.showCc = draft.cc.length > 0;
            this.showBcc = draft.bcc.length > 0;
            this.showQuote = this.kind === 'forward';
            this.draft = draft;
            // the server's draft has its clientRef: a send queued offline is taken once by it
            if (this.clientRef && compose.clientRef) this.clientRef = compose.clientRef;
            this.draftStamp = compose.draftStamp != null ? compose.draftStamp : null;
            if (draft.emailMessageId) { this.savedAt = Date.now(); if (this.mComposeHost && this.dockKey) this.mComposeHost.draftSaved(this.dockKey, draft.emailMessageId); }
        },
        signatureBlock(html) { return '<p></p><p>-- </p>' + html; },
        wantsSignature(identity) { return !!(identity && identity.signatureHtml && (['new', 'forward'].includes(this.kind) || identity.useForReplies)); },
        removeQuote() {
            this.draft.quoteHtml = null;
            if (this.belowSignature) {
                this.draft.body = (this.draft.body || '<p></p>') + this.signatureBlock(this.belowSignature);
                this.belowSignature = null;
            }
        },
        swapSignature(oldValue, newValue) {
            const before = this.identities.find((item) => item.value === oldValue);
            const after = this.identities.find((item) => item.value === newValue);
            if (this.belowSignature) {
                this.belowSignature = this.wantsSignature(after) ? after.signatureHtml : null;
                if (newValue === 'internal') { this.draft.bcc = []; this.showBcc = false; }
                return;
            }
            let body = String(this.draft.body || '');
            if (before && before.signatureHtml) {
                const block = this.signatureBlock(before.signatureHtml);
                if (body.endsWith(block)) body = body.substring(0, body.length - block.length);
            }
            if (this.wantsSignature(after)) {
                if (this.signaturePlacement === 'below' && this.draft.quoteHtml) this.belowSignature = after.signatureHtml;
                else body = (body || '<p></p>') + this.signatureBlock(after.signatureHtml);
            }
            this.draft.body = body;
            // an internal message has no Bcc
            if (newValue === 'internal') { this.draft.bcc = []; this.showBcc = false; }
        },
        focusFirst() {
            if (this.layout === 'dock' && this.minimized) return;
            const el = this.$el && this.$el.querySelector && (this.draft.to.length ? null : this.$el.querySelector('input[name="add_to"]'));
            if (el && el.focus) { el.focus(); return; }
            const editor = this.$refs.editor && this.$refs.editor.editor;
            if (editor && editor.commands) editor.commands.focus('start');
        },

        // ---- recipients ----
        chipIcon(chip) {
            if (chip.kind === 'mailbox') return 'sym_o_forum';
            if (chip.kind === 'group') return 'sym_o_group';
            if (chip.kind === 'party') return 'sym_o_person';
            return undefined;
        },
        chipClass(chip) {
            if (chip.kind === 'address' && this.mode === 'internal') return 'text-warning';
            if (chip.kind === 'mailbox' && this.mode === 'email') return 'text-negative';
            return '';
        },
        optionLabel(field, value) {
            const ref = this.$refs['add_' + field];
            const dropDown = Array.isArray(ref) ? ref[0] : ref;
            const options = (dropDown && (dropDown.curOptions || dropDown.allOptions)) || [];
            const found = options.find((option) => option.value === value);
            return found ? found : null;
        },
        addChip(field, value) {
            this.adding[field] = null;
            if (value == null || value === '') return;
            const option = this.optionLabel(field, value);
            const entries = option ? [{ value: option.value, label: option.label || option.value, kind: option.kind || this.kindOf(option.value) }]
                : String(value).split(/[,;\n]+/).map((part) => part.trim()).filter((part) => part).map((part) => ({ value: part, label: part, kind: this.kindOf(part) }));
            const list = this.draft[field];
            entries.forEach((entry) => { if (!list.some((chip) => chip.value.toLowerCase() === entry.value.toLowerCase())) list.push(Object.assign({ locked: false }, entry)); });
            this.$nextTick(() => {
                const ref = this.$refs['add_' + field];
                const dropDown = Array.isArray(ref) ? ref[0] : ref;
                const input = dropDown && dropDown.$el && dropDown.$el.querySelector('input');
                if (input) { input.value = ''; input.focus(); }
            });
        },
        kindOf(value) {
            const text = String(value);
            if (text.startsWith('party:')) return 'party';
            if (text.startsWith('list:')) return 'mailbox';
            if (text.startsWith('group:')) return 'group';
            return 'address';
        },
        removeChip(field, chip) { this.draft[field] = this.draft[field].filter((item) => item !== chip); },
        // what is typed in a recipient field and not added yet (an address, then a comma or a send)
        collectPending() {
            ['to', 'cc', 'bcc'].forEach((field) => {
                const ref = this.$refs['add_' + field];
                const dropDown = Array.isArray(ref) ? ref[0] : ref;
                const input = dropDown && dropDown.$el && dropDown.$el.querySelector('input');
                const text = input ? String(input.value || '').trim() : '';
                if (text && (text.includes('@') || this.mode === 'internal')) { this.addChip(field, text); if (input) input.value = ''; }
            });
        },

        // ---- saving ----
        onChange() {
            if (this.state !== 'ready' || this.sent) return;
            this.dirty = true;
            if (this.saveTimer) clearTimeout(this.saveTimer);
            this.saveTimer = setTimeout(() => { this.saveTimer = null; this.save(); }, this.mode === 'internal' ? 800 : 3000);
        },
        draftContent() {
            const draft = Object.assign({}, this.draft);
            // A first save assigns this id; it does not change the content the user wrote.
            delete draft.emailMessageId;
            return JSON.stringify([draft, this.belowSignature, this.queued]);
        },
        acknowledgeSave(content) {
            // Flush the deep draft watcher, including the server-assigned id, before acknowledging this snapshot.
            return this.$nextTick().then(() => {
                this.dirty = this.draftContent() !== content;
                if (!this.dirty && this.saveTimer) { clearTimeout(this.saveTimer); this.saveTimer = null; }
            });
        },
        chipsJson(field) { return JSON.stringify(this.draft[field].map((chip) => ({ value: chip.value, label: chip.label }))); },
        draftParams() {
            const d = this.draft;
            // the editor keeps HTML in the model while the plain-text toggle is on, so body stays that HTML
            let body = d.body || '';
            let quote = d.quoteHtml || '';
            // a signature kept below the quote is sent after it; with the quote gone it is already in the body
            if (this.belowSignature) quote = quote + this.signatureBlock(this.belowSignature);
            const params = { fromValue: d.fromValue, toJson: this.chipsJson('to'), ccJson: this.chipsJson('cc'), bccJson: this.chipsJson('bcc'), subject: d.subject || '',
                body: body, quoteHtml: quote };
            if (d.plain) {
                const editor = this.$refs.editor;
                params.bodyText = editor && editor.plainValue ? editor.plainValue() : moqui.richText.toPlain(body);
            }
            if (d.emailMessageId) params.emailMessageId = d.emailMessageId;
            else if (d.parentEmailMessageId) { params.parentEmailMessageId = d.parentEmailMessageId; params.isForward = d.isForward ? 'true' : 'false'; }
            // the desktop client: the draft's first save is taken once by its clientRef (one written offline, saved later)
            if (this.clientRef && !d.emailMessageId) params.clientRef = this.clientRef;
            return params;
        },
        save(force) {
            if (this.sent) return Promise.resolve(true);
            if (this.saving) return this.savePromise || Promise.resolve(false);
            if (this.mode !== 'internal' && !force && this.isEmpty && !this.draftId && !this.offlineDraft) return Promise.resolve(true);
            if (this.saveTimer) { clearTimeout(this.saveTimer); this.saveTimer = null; }
            // A connected email needs an identity to save. Offline desktop drafts retain their existing local fallback.
            if (this.mode !== 'internal' && this.noFrom && !this.noConnection) return Promise.resolve(this.saveFailed({message: this.fromMessage}));
            this.saving = true;
            const content = this.draftContent();
            const persisted = this.mode === 'internal' ? this.saveLocal() : moqui.request(this.url('saveDraft'), { method: 'POST', params: this.draftParams() }).then((result) => {
                const json = result.json || {};
                if (json.errors || json.conflict || !json.emailMessageId) {
                    throw { json, message: json.conflict ? t('This draft changed elsewhere. Your changes are still open here.') : null };
                }
                if (json.emailMessageId && !this.draft.emailMessageId) {
                    this.draft.emailMessageId = json.emailMessageId;
                    if (this.mComposeHost && this.dockKey) this.mComposeHost.draftSaved(this.dockKey, json.emailMessageId);
                }
                this.savedAt = Date.now();
                if (json.draftStamp != null) this.draftStamp = json.draftStamp;
                return this.acknowledgeSave(content).then(() => {
                    // Keep the local recovery copy until the server has the current content, not an older snapshot.
                    if (this.offlineDraft && json.emailMessageId && !this.dirty) {
                        this.offlineDraft = false;
                        if (this.queued.length) return this.saveLocal();
                        this.clearLocal();
                    }
                });
            }, (err) => {
                // the desktop client with no server: kept in the app, and saved on the server once it is back
                if (this.unreachable(err)) return this.saveLocal();
                throw err;
            });
            this.savePromise = persisted.then((saved) => {
                this.saving = false;
                if (saved === false) return false;
                this.saveError = null;
                if (this.dirty) return this.save(force);
                return true;
            }, (err) => {
                this.saving = false;
                return this.saveFailed(err);
            });
            return this.savePromise;
        },
        saveFailed(err) {
            this.dirty = true;
            this.saveError = String((err && err.json && err.json.errors) || (err && err.message) || t('The draft could not be saved.'));
            return false;
        },
        // an internal message's draft, kept in this browser (moqui.drafts); in the desktop client also an email's written
        // offline, with its clientRef and the files kept for it
        saveLocal() {
            const content = this.draftContent();
            const email = this.mode === 'email' && !!this.clientRef;
            const value = { at: Date.now(), draft: Object.assign({}, this.draft, { attachments: [] }) };
            let key = this.draftStorageKey;
            if (email) {
                Object.assign(value, { email: true, clientRef: this.clientRef, queued: this.queued });
                // a conflict's copy until the server has it as a draft of its own
                if (this.copyOf && !this.draft.emailMessageId) value.conflictOf = this.copyOf;
                key = this.emailLocalKey;
            }
            const requireSaved = (saved) => { if (saved === false) throw new Error(t('This device could not keep the draft. Check available storage and try again.')); };
            return moqui.drafts.put(key, JSON.stringify(value), this.queued.map((file) => file.file)).then((saved) => {
                requireSaved(saved);
                // A new offline email needs its pointer too before the composer may close.
                if (email && !this.draft.emailMessageId) return moqui.drafts.put(this.emailRefKey, JSON.stringify({ clientRef: this.clientRef })).then(requireSaved);
            }).then(() => {
                if (email) {
                    this.offlineDraft = true;
                    // Keep the old copy until the replacement is persisted.
                    if (this.localEmailKey && this.localEmailKey !== key) moqui.drafts.remove(this.localEmailKey);
                    this.localEmailKey = key;
                }
                this.savedAt = Date.now();
                return this.acknowledgeSave(content).then(() => true);
            }, (err) => this.saveFailed(err));
        },
        restoreLocal() {
            // what Undo send gave back, an internal message's draft from this browser, or an email's kept offline in the desktop client
            let saved = null;
            try { if (this.query.restoreKey) saved = JSON.parse(sessionStorage.getItem(this.query.restoreKey) || 'null'); } catch (err) { saved = null; }
            if (saved || this.query.restoreKey) { this.applyLocal(saved); return; }
            if (this.query.copyRef && this.clientRef) { this.restoreCopy(String(this.query.copyRef)); return; }
            if (this.mode === 'internal' ? this.draft.emailMessageId : !this.clientRef) return;
            const parse = (key) => { try { return JSON.parse(moqui.drafts.get(key) || 'null'); } catch (err) { return null; } };
            const read = () => {
                if (this.mode === 'internal') return parse(this.draftStorageKey);
                const pointer = this.draft.emailMessageId ? null : parse(this.emailRefKey);
                const key = 'ironstone.compose.email.' + (this.draft.emailMessageId || (pointer && pointer.clientRef) || this.clientRef);
                const saved = parse(key);
                if (saved) this.localEmailKey = key;
                return saved;
            };
            const local = read();
            if (local) this.applyLocal(local);
            else moqui.drafts.ready().then(() => { const later = read(); if (later && !this.dirty) this.applyLocal(later); });
        },
        // The desktop client: the user's own version of a mail whose draft changed elsewhere, which the app kept as a copy
        // (its outbox's conflict, current.copyRef): a new email draft under its own clientRef, opened by copyRef. It is saved
        // on the server as a new draft once it can be; the server's draft stays as it is.
        restoreCopy(ref) {
            const gone = () => { this.offlineNote = t('This copy is no longer kept on this computer.'); };
            // a clientRef, never a message's id: only a copy the app kept is opened, and nothing else is touched
            if (!/^[A-Za-z0-9_.:-]{1,64}$/.test(ref)) { gone(); return; }
            const key = 'ironstone.compose.email.' + ref;
            moqui.drafts.fetch(key).then((text) => {
                let saved = null;
                try { saved = JSON.parse(text || 'null'); } catch (err) { saved = null; }
                // a conflict's copy: an email of its own clientRef, not on the server (a draft of the server's kept offline is not one)
                if (!saved || !saved.draft || !saved.email || !saved.conflictOf || saved.draft.emailMessageId || saved.clientRef !== ref) { gone(); return; }
                // the email it was: its identity and the message it answers
                const kept = saved.draft;
                if (kept.fromValue) this.draft.fromValue = kept.fromValue;
                if (kept.parentEmailMessageId) { this.draft.parentEmailMessageId = kept.parentEmailMessageId; this.draft.isForward = String(kept.isForward) === 'true'; }
                this.copyOf = saved.conflictOf || { clientRef: null };
                this.localEmailKey = key;
                // after the identity's signature swap, so the copy's body is taken as it was written
                this.$nextTick(() => this.applyLocal(saved));
            }, () => { this.offlineNote = t('This copy is no longer kept on this computer.'); });
        },
        applyLocal(saved) {
            if (!saved || !saved.draft) return;
            if (!this.query.restoreKey && !!saved.email !== (this.mode === 'email')) return;
            // an email's: of this draft (a new one, or the server's draft edited offline)
            if (saved.email && !this.query.restoreKey && (saved.draft.emailMessageId || null) !== (this.draft.emailMessageId || null)) return;
            const kept = saved.draft;
            ['to', 'cc', 'subject', 'body', 'uploads', 'record'].forEach((name) => { if (kept[name] != null && (!Array.isArray(kept[name]) || kept[name].length)) this.draft[name] = kept[name]; });
            if (kept.cc && kept.cc.length) this.showCc = true;
            if (saved.email && !this.query.restoreKey) {
                ['bcc', 'quoteHtml'].forEach((name) => { if (kept[name] != null) this.draft[name] = kept[name]; });
                if (kept.bcc && kept.bcc.length) this.showBcc = true;
                this.clientRef = saved.clientRef || this.clientRef;
                this.queued = Array.isArray(saved.queued) ? saved.queued : [];
                this.offlineDraft = true;
                // on the server now if it can be reached
                this.$nextTick(() => this.save());
            }
        },
        clearLocal() {
            moqui.drafts.remove(this.draftStorageKey);
            if (this.clientRef) {
                [this.localEmailKey, this.emailLocalKey].forEach((key) => { if (key) moqui.drafts.remove(key); });
                const pointer = moqui.drafts.get(this.emailRefKey);
                if (pointer && pointer.indexOf(JSON.stringify(this.clientRef)) >= 0) moqui.drafts.remove(this.emailRefKey);
                this.localEmailKey = null;
            }
            try { if (this.query.restoreKey) sessionStorage.removeItem(this.query.restoreKey); } catch (err) { /* no storage */ }
        },
        // an answer that says the server cannot be reached in the desktop client, whose outbox and drafts keep the message
        unreachable(err) { return !!(moqui.unreachable && moqui.unreachable(err)); },
        // files kept by the app for a send from its outbox (offline): each a {file, name, size, contentType}
        keepFiles(files) {
            return Promise.all(files.map((file) => moqui.drafts.saveFile(file).then((name) => (name ? { file: name, name: file.name, size: file.size,
                contentType: file.type || 'application/octet-stream' } : null)))).then((kept) => {
                this.queued = this.queued.concat(kept.filter((file) => file));
                return this.saveLocal();
            }, (err) => moqui.notifyMessages(null, (err && err.message) || t('The files could not be kept')));
        },
        removeQueued(file) {
            this.queued = this.queued.filter((item) => item !== file);
            this.saveLocal();
        },
        // Send from the app's outbox (the desktop client): the draft saved, its files uploaded and sent once the server can be
        // reached, each taken once by the clientRef; Undo is not offered, as it goes later.
        queueSend(params) {
            const fields = Object.assign({}, params);
            delete fields.holdSeconds;
            delete fields.clientRef;
            if (this.draft.emailMessageId) fields.emailMessageId = this.draft.emailMessageId;
            // the server's draft as this composer saw it: one saved elsewhere since is a conflict, not overwritten (MD5)
            if (this.mode === 'email' && this.draft.emailMessageId && this.draftStamp != null) fields.baseStamp = String(this.draftStamp);
            const files = this.queued.map((file) => ({ file: file.file, name: file.name, contentType: file.contentType }));
            return moqui.hostOutbox().add('mail-send', { clientRef: this.clientRef, fields, files }, files.map((file) => file.file)).then(() => {
                this.sending = false;
                this.sent = true;
                this.clearLocal();
                this.afterSend({ mode: 'queued', holdSeconds: 0, message: t('Waiting to send: it goes when the server can be reached') });
            }, (err) => {
                this.sending = false;
                moqui.notifyMessages(null, (err && err.message) || t('This message cannot wait to be sent'));
            });
        },

        // ---- files ----
        pickFiles() {
            const input = this.$refs.picker && this.$refs.picker.$el && this.$refs.picker.$el.querySelector('input[type=file]');
            if (input) input.click();
        },
        onPicked(files) {
            const list = Array.isArray(files) ? files : (files ? [files] : []);
            this.picked = null;
            if (list.length) this.upload(list);
        },
        onDrop(event) {
            this.dragOver = false;
            const files = Array.from((event.dataTransfer && event.dataTransfer.files) || []);
            if (files.length) this.upload(files);
        },
        upload(files) {
            const run = () => {
                const form = new FormData();
                if (this.mode === 'email' && this.draft.emailMessageId) form.append('emailMessageId', this.draft.emailMessageId);
                files.forEach((file) => form.append('contentFile', file, file.name));
                if (moqui.sessionToken) form.append('moquiSessionToken', moqui.sessionToken);
                this.uploading = true;
                return moqui.request(this.url('upload'), { method: 'POST', params: form }).then((result) => {
                    this.uploading = false;
                    const json = result.json || {};
                    if (this.mode === 'email') this.draft.attachments = json.attachmentList || this.draft.attachments;
                    else this.draft.uploads = this.draft.uploads.concat(json.uploadList || []);
                }, (err) => {
                    this.uploading = false;
                    // the desktop client with no server: the app keeps them for the send
                    if (this.unreachable(err) && this.mode === 'email') return this.keepFiles(files);
                    if (this.unreachable(err)) { moqui.notifyMessages(null, t('Attaching files to an internal message needs a connection')); return; }
                    moqui.handleAjaxError(err);
                });
            };
            if (this.mode === 'email' && !this.draft.emailMessageId) {
                // a draft first, so the files have their message (kept by the app when the draft is kept offline)
                return this.save(true).then(() => {
                    if (this.draft.emailMessageId) return run();
                    if (this.offlineDraft) return this.keepFiles(files);
                    return null;
                });
            }
            return run();
        },
        removeAttachment(file) {
            moqui.request(this.url('removeAttachment'), { method: 'POST', params: { emailMessageId: this.draft.emailMessageId, emailMessageAttachmentId: file.id } }).then((result) => {
                this.draft.attachments = (result.json || {}).attachmentList || this.draft.attachments.filter((item) => item !== file);
            }, moqui.handleAjaxError);
        },
        removeUpload(file) { this.draft.uploads = this.draft.uploads.filter((item) => item !== file); },

        // ---- Attach from Files ----
        // the button only when the user has a drive at all
        checkDrive() {
            const url = this.url('pickerData');
            if (!driveChecks[url]) driveChecks[url] = moqui.request(url, { params: { checkOnly: 'true' } }).then((result) => !!(result.json || {}).hasDrive, () => false);
            driveChecks[url].then((has) => { this.hasDrive = has; });
        },
        openPicker() {
            // the drive needs the server (the desktop client offline; never on the web)
            if (this.noConnection) { moqui.notifyMessages([{ type: 'info', message: t('Attach from Files needs a connection to the server') }]); return; }
            this.picker = { open: true, drives: [], driveId: null, path: '', crumbs: [], rows: [], loading: true, text: '', searching: true, chosen: {}, saving: false };
            moqui.request(this.url('pickerData')).then((result) => {
                const json = result.json || {};
                this.picker.drives = json.driveList || [];
                this.picker.rows = json.recentList || [];
                this.picker.loading = false;
                if (json.personalDriveId && !this.picker.rows.length) this.pickerOpen(json.personalDriveId, '');
            }, () => { this.picker.loading = false; });
        },
        pickerOpen(driveId, path) {
            Object.assign(this.picker, { driveId, path: path || '', searching: false, loading: true });
            moqui.request(this.url('pickerFolder'), { params: { driveId, path: path || '' } }).then((result) => {
                const json = result.json || {};
                this.picker.rows = (json.fileList || []).map((row) => Object.assign({ driveId }, row));
                this.picker.crumbs = (json.breadcrumbList || []).filter((crumb) => !crumb.view);
                this.picker.loading = false;
            }, () => { this.picker.loading = false; this.picker.rows = []; });
        },
        pickerSearch() {
            const text = String(this.picker.text || '').trim();
            if (!text) return;
            Object.assign(this.picker, { searching: true, loading: true });
            moqui.request(this.url('pickerSearch'), { params: { text } }).then((result) => {
                this.picker.rows = (result.json || {}).fileList || [];
                this.picker.loading = false;
            }, () => { this.picker.loading = false; });
        },
        pickerKey(row) { return (row.driveId || this.picker.driveId) + '\n' + row.path; },
        pickerCaption(row) {
            if (row.isDirectory) return t('Folder: sent as a link');
            const parts = [];
            if (this.picker.searching && row.driveName) parts.push(row.driveName + (row.folderPath ? ' / ' + row.folderPath : ''));
            if (row.size != null) parts.push(this.sizeText(row.size));
            return parts.join(' · ');
        },
        pickerToggle(row) { const key = this.pickerKey(row); this.picker.chosen = Object.assign({}, this.picker.chosen, { [key]: !this.picker.chosen[key] }); },
        pickerClick(row) { if (row.isDirectory) this.pickerOpen(row.driveId || this.picker.driveId, row.path); else this.pickerToggle(row); },
        pickerAttach() {
            const items = Object.keys(this.picker.chosen).filter((key) => this.picker.chosen[key]).map((key) => {
                const at = key.indexOf('\n');
                return { driveId: key.slice(0, at), path: key.slice(at + 1) };
            });
            if (!items.length) return;
            const run = () => {
                this.picker.saving = true;
                const params = { itemsJson: JSON.stringify(items) };
                if (this.mode === 'email' && this.draft.emailMessageId) params.emailMessageId = this.draft.emailMessageId;
                return moqui.request(this.url('attachFromFiles'), { method: 'POST', params }).then((result) => {
                    const json = result.json || {};
                    this.picker.saving = false;
                    this.picker.open = false;
                    if (json.messageInfos && json.messageInfos.length) moqui.notifyMessages(json.messageInfos, json.errors);
                    if (this.mode === 'email' && json.attachmentList) this.draft.attachments = json.attachmentList;
                    if (this.mode !== 'email') this.draft.uploads = this.draft.uploads.concat(json.uploadList || []);
                    this.insertLinks(json.linkList || []);
                }, (err) => { this.picker.saving = false; moqui.handleAjaxError(err); });
            };
            // an email draft first, so the files have their message
            if (this.mode === 'email' && !this.draft.emailMessageId) return this.save(true).then(() => { if (this.draft.emailMessageId) return run(); });
            return run();
        },
        // the links of what was too large to attach, at the end of the body
        insertLinks(links) {
            if (!links.length) return;
            const origin = window.location.origin;
            const escape = (text) => String(text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            if (this.draft.plain) {
                this.draft.body = String(this.draft.body || '') + '\n\n' + links.map((link) => link.name + ': ' + origin + link.linkPath).join('\n');
                return;
            }
            const html = '<p>' + links.map((link) => '<a href="' + escape(origin + link.linkPath) + '">' + escape(link.name) + '</a>').join('<br>') + '</p>';
            const editor = this.$refs.editor && this.$refs.editor.editor;
            if (editor && editor.chain) editor.chain().focus('end').insertContent(html).run();
            else this.draft.body = String(this.draft.body || '') + html;
        },
        sizeText(size) {
            const n = Number(size) || 0;
            if (n >= 1048576) return (n / 1048576).toFixed(1) + ' MB';
            if (n >= 1024) return Math.round(n / 1024) + ' KB';
            return n + ' B';
        },

        // ---- text blocks ----
        loadBlocks() {
            if (this.blocksLoaded) return;
            moqui.request(this.url('textBlocks')).then((result) => { this.blocks = (result.json || {}).textBlockList || []; this.blocksLoaded = true; }, () => {});
        },
        blockText(block) { return String(block.bodyHtml || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().substring(0, 80); },
        insertBlock(block) {
            const editor = this.$refs.editor && this.$refs.editor.editor;
            const html = block.bodyHtml || '';
            if (editor && editor.chain && !this.draft.plain) {
                let chain = editor.chain().focus();
                if (this.slashPending) {
                    const at = editor.state.selection.from;
                    const before = editor.state.doc.textBetween(Math.max(0, at - 1), at, '\n', '\n');
                    if (before === '/') chain = chain.deleteRange({ from: at - 1, to: at });
                }
                chain.insertContent(html).run();
            } else {
                const text = this.blockText({ bodyHtml: html });
                this.draft.body = this.draft.plain ? String(this.draft.body || '').replace(/\/$/, '') + text : String(this.draft.body || '') + html;
            }
            this.slashPending = false;
        },
        // "/" at the start of a word opens the text blocks
        onEditorKeyup(event) {
            if (event.key !== '/' || this.draft.plain) return;
            const editor = this.$refs.editor && this.$refs.editor.editor;
            if (!editor || !editor.state) return;
            const at = editor.state.selection.from;
            const before = editor.state.doc.textBetween(Math.max(0, at - 2), at, '\n', '\n');
            if (before === '/' || /[\s\n]\/$/.test(before)) { this.slashPending = true; this.blockSearch = ''; this.blocksOpen = true; this.loadBlocks(); }
        },
        onKeydown(event) {
            if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') { event.preventDefault(); this.send(); }
        },

        // ---- sending ----
        send(options) {
            const opts = options || {};
            if (this.sending) return;
            if (this.noFrom) { moqui.notifyMessages(null, this.fromMessage); return; }
            this.collectPending();
            const d = this.draft;
            if (!d.to.length && !d.cc.length && !d.bcc.length) { moqui.notifyMessages(null, t('Add a recipient in To')); return; }
            if (this.uploading) { moqui.notifyMessages(null, t('Wait for the files to finish uploading')); return; }
            if (this.saveTimer) { clearTimeout(this.saveTimer); this.saveTimer = null; }
            const params = Object.assign(this.draftParams(), {});
            if (d.parentEmailMessageId && !d.emailMessageId) { params.parentEmailMessageId = d.parentEmailMessageId; params.isForward = d.isForward ? 'true' : 'false'; }
            if (d.parentCommEventId) { params.parentCommEventId = d.parentCommEventId; params.replyToSenderOnly = d.replyToSenderOnly ? 'true' : 'false'; }
            if (d.uploads.length) params.uploadsJson = JSON.stringify(d.uploads);
            if (d.record) { params.recordEntity = d.record.recordEntityName; params.recordId = d.record.recordId; }
            if (opts.at) params.scheduledSendDate = String(opts.at);
            else if (this.mode === 'email') params.holdSeconds = String(Math.max(0, Math.min(this.undoSeconds || 0, 300)));
            if (opts.archive && d.threadStore && d.threadId) { params.archiveThread = 'true'; params.threadStore = d.threadStore; params.threadId = d.threadId; }
            this.sending = true;
            // files kept by the app offline go with the send from its outbox (MD4)
            if (this.queued.length && moqui.hostOutbox() && this.mode === 'email') {
                const queue = () => this.queueSend(params);
                if (this.saving && this.savePromise) this.savePromise.then(queue, queue); else queue();
                return;
            }
            const go = () => moqui.request(this.url('send'), { method: 'POST', params }).then((result) => {
                this.sending = false;
                const json = result.json || {};
                this.sent = true;
                let restoreKey = null;
                if (json.mode === 'internal') {
                    restoreKey = 'ironstone.compose.undo.' + Date.now().toString(36);
                    try { sessionStorage.setItem(restoreKey, JSON.stringify({ draft: Object.assign({}, this.draft) })); } catch (err) { restoreKey = null; }
                }
                this.clearLocal();
                const info = Object.assign({}, json, { holdSeconds: params.holdSeconds ? Number(params.holdSeconds) : 0, restoreKey });
                this.afterSend(info);
            }, (err) => {
                // the desktop client with no server: sent from the app's outbox when it is back
                // (an internal message too where the server takes its send once by its clientRef: the app's kinds().internalSend)
                if (this.unreachable(err) && this.clientRef && (this.mode === 'email' || this.internalSend)) { this.queueSend(params); return; }
                // a server that does not take an internal message's send once: kept here as a draft, to send online
                if (this.unreachable(err) && this.mode === 'internal') {
                    this.sending = false;
                    this.saveLocal();
                    moqui.notifyMessages(null, t('An internal message needs a connection to send; it is kept as a draft'));
                    return;
                }
                this.sending = false;
                moqui.handleAjaxError(err);
            });
            // a save that is running finishes first, so the send has the draft's id
            if (this.saving && this.savePromise) this.savePromise.then(() => { if (this.draft.emailMessageId) params.emailMessageId = this.draft.emailMessageId; go(); });
            else go();
        },
        schedule(at) {
            if (!at || at <= Date.now()) { moqui.notifyMessages(null, t('Pick a time in the future')); return; }
            this.scheduleOpen = false;
            if (this.mode === 'internal') { moqui.notifyMessages(null, t('Internal messages are sent now; schedule is for email')); return; }
            this.send({ at });
        },
        afterSend(info) {
            // a held message goes as soon as its hold ends, unless Undo took it back to Drafts
            if (info.mode === 'email' && info.statusId === 'ES_SCHEDULED' && info.holdSeconds > 0 && info.emailMessageId) {
                const dueUrl = this.url('sendDue');
                setTimeout(() => moqui.request(dueUrl, { method: 'POST', params: { emailMessageId: info.emailMessageId } }).catch(() => {}), info.holdSeconds * 1000 + 600);
            }
            if (this.mComposeHost && this.dockKey) { this.mComposeHost.sent(this.dockKey, info); return; }
            // embedded or the page: the toast with Undo here
            const held = info.mode === 'email' && info.statusId === 'ES_SCHEDULED' && info.holdSeconds > 0;
            const scheduled = info.mode === 'email' && info.statusId === 'ES_SCHEDULED' && !held;
            const message = held ? t('Sending…') : (scheduled ? t('Scheduled') + ' ' + this.whenText(info.scheduledSendDate) : (info.message || t('Sent')));
            const undo = () => {
                const params = info.mode === 'email' ? { emailMessageId: info.emailMessageId } : { communicationEventIdsJson: JSON.stringify(info.communicationEventIdList || []) };
                moqui.request(this.url('cancelSend'), { method: 'POST', params }).then(() => {
                    moqui.notifyMessages([{ type: 'info', message: info.mode === 'email' ? t('Back in Drafts') : t('Withdrawn'),
                        link: info.mode === 'email' ? this.appLink() + 'Inbox/Compose?emailMessageId=' + encodeURIComponent(info.emailMessageId) : null, linkText: t('Open the draft') }]);
                }, moqui.handleAjaxError);
            };
            const canUndo = held || scheduled || (info.mode === 'internal' && (info.communicationEventIdList || []).length);
            if (this.$q.notify) this.$q.notify({ message, timeout: held ? Math.max(4000, info.holdSeconds * 1000) : 8000, position: 'bottom-left', group: false,
                actions: canUndo ? [{ label: t('Undo'), color: 'yellow', handler: undo }] : [] });
            if (this.mSubmitHide && this.mSubmitHide.hide) { this.mSubmitHide.hide(info); return; }
            if (this.layout === 'page') this.$root.setUrl(this.appLink() + 'Inbox' + (info.mode === 'internal' ? '?view=internalSent' : '?view=sent'));
        },

        // ---- the chrome ----
        minimize(flag) { if (this.mComposeHost && this.dockKey) { if (!flag) this.save(); this.mComposeHost.minimize(this.dockKey, flag); } },
        popOut() { if (this.mComposeHost && this.dockKey) this.mComposeHost.popOut(this.dockKey, true); },
        popIn() {
            if (this.mComposeHost && this.dockKey) this.mComposeHost.popOut(this.dockKey, false);
            else this.close();
        },
        close() {
            // closing keeps the draft (it is saved first); Discard deletes it
            const finish = () => {
                if (this.mComposeHost && this.dockKey) this.mComposeHost.close(this.dockKey);
                else if (this.mSubmitHide && this.mSubmitHide.hide) this.mSubmitHide.hide();
                else if (this.layout === 'page') this.$root.setUrl(this.appLink() + 'Inbox');
            };
            if (this.state === 'ready' && !this.sent && (this.dirty || this.saving)) {
                return this.save().then((saved) => { if (saved) finish(); });
            }
            finish();
        },
        // Discard: asked first when there is something to lose
        discard() {
            if (this.isEmpty && !this.draftId) { this.discardNow(); return; }
            this.$q.dialog({ title: t('Discard this message?'), message: this.draftId ? t('The draft is deleted.') : t('What you wrote is lost.'),
                ok: { label: t('Discard'), color: 'negative', unelevated: true, noCaps: true }, cancel: { label: t('Keep writing'), flat: true, noCaps: true } })
                .onOk(() => this.discardNow());
        },
        discardNow() {
            this.sent = true;
            if (this.saveTimer) { clearTimeout(this.saveTimer); this.saveTimer = null; }
            this.clearLocal();
            const finish = () => {
                if (this.mComposeHost && this.dockKey) this.mComposeHost.close(this.dockKey);
                else if (this.mSubmitHide && this.mSubmitHide.hide) this.mSubmitHide.hide();
                else if (this.layout === 'page') this.$root.setUrl(this.appLink() + 'Inbox');
            };
            if (this.draftId) {
                moqui.request(this.url('discard'), { method: 'POST', params: { emailMessageId: this.draftId } }).then(() => {
                    moqui.notifyMessages([{ type: 'info', message: t('Draft discarded') }]);
                    finish();
                }, (err) => { moqui.handleAjaxError(err); finish(); });
            } else finish();
        },
        whenText(millis) {
            if (!millis) return '';
            const d = new Date(Number(millis));
            return d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' }) + ' ' + d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
        },
        parseDateTime(text) {
            const match = /^(\d{4})-(\d{2})-(\d{2})(?:[ T](\d{1,2}):(\d{2}))?/.exec(String(text || ''));
            if (!match) return null;
            return new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]), Number(match[4] || 8), Number(match[5] || 0)).getTime();
        }
    },
    mounted() { this.start(); this.checkDrive(); },
    beforeUnmount() {
        // a dock closed or a page left: what was written is kept
        if (this.saveTimer) { clearTimeout(this.saveTimer); this.saveTimer = null; if (!this.sent && this.state === 'ready') this.save(); }
    }
};
</script>
