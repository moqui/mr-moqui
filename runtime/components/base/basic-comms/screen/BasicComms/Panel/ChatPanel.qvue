<!-- ChatPanel (design-drawers-commons.md §4 ChatPanel), the component Panel/Chat.xml serves in the qvue render mode: the Chat
    tab of the tray panel, and the + menu's Chat message (in the quick-create dialog it opens on New message). One pane with
    two modes: the rooms, those with mentions or unread messages first, each with its avatar and presence dot, last message,
    time and badges, with New message (people, one or several), Mark all read and Open in Comms; and a room opened in place,
    which is Chat.qvue's chat-room component at 400 px (compact: its side panes and threads open over the timeline), loaded
    the first time a room opens, with a back arrow and Open in Chat.

    The transitions are those of Comms/Chat. The panel listens to the page's chat store (moqui.chat.on), so a chat push updates
    the rooms instead of reloading the tab; the tray's refresh of the tab (the shell's shellCounts push and its poll) calls
    shellRefresh(), which refreshes the rooms in place, and the open room and the rooms are kept for the page, so the tab comes
    back as it was. -->
<template><div class="m-chat-panel column no-wrap" :style="{height: height + 'px'}">
    <template v-if="!roomId">
        <div class="row items-center no-wrap q-pb-xs">
            <div class="text-subtitle2 col ellipsis">{{t('Chat')}}<span v-if="unreadTotal" class="text-caption m-muted"> · {{fill(t('{count} unread'), {count: unreadTotal})}}</span></div>
            <q-btn flat round dense icon="sym_o_edit_square" color="primary" :aria-label="t('New message')" @click="toggleNew"><q-tooltip>{{t('New message')}}</q-tooltip></q-btn>
            <q-btn flat round dense icon="sym_o_done_all" :disable="!unreadTotal" :aria-label="t('Mark all read')" @click="markAllRead"><q-tooltip>{{t('Mark all read')}}</q-tooltip></q-btn>
            <q-btn flat dense no-caps size="sm" color="primary" icon="sym_o_open_in_new" :label="t('Open in Comms')" @click="go(linkBase)"></q-btn>
        </div>
        <div v-if="newOpen" class="q-pb-sm">
            <m-drop-down v-model="newUserIds" name="panelDirectUserIds" multiple server-search :options-url="url('searchUsers')" :label="t('To: one person or several')"></m-drop-down>
            <div class="row q-gutter-x-sm q-mt-xs">
                <q-btn dense unelevated no-caps color="primary" icon="sym_o_chat" :label="t('Start')" :disable="!(newUserIds || []).length" :loading="busy" @click="startDirect"></q-btn>
                <q-btn dense flat no-caps :label="t('Cancel')" @click="newOpen = false"></q-btn>
            </div>
        </div>
        <q-separator></q-separator>
        <div class="col scroll" style="min-height:0">
            <div v-if="!loaded" class="q-pa-xs">
                <div v-for="n in 6" :key="n" class="row items-center no-wrap q-py-sm q-gutter-x-sm">
                    <q-skeleton type="QAvatar" size="32px"></q-skeleton>
                    <div class="col"><q-skeleton type="text" width="45%"></q-skeleton><q-skeleton type="text"></q-skeleton></div>
                </div>
            </div>
            <q-list v-else dense>
                <q-item v-for="room in shownRooms" :key="room.chatRoomId" clickable class="q-px-xs q-py-xs" :data-room="room.chatRoomId" @click="openRoom(room.chatRoomId)">
                    <q-item-section avatar style="min-width:40px">
                        <m-avatar v-if="room.roomTypeEnumId === 'CrtDirect' && room.otherUserId" :name="room.displayName" :user-id="room.otherUserId" size="32px"></m-avatar>
                        <q-avatar v-else size="32px" rounded class="m-tonal text-primary" :icon="roomIcon(room)"></q-avatar>
                    </q-item-section>
                    <q-item-section style="min-width:0">
                        <q-item-label class="row no-wrap items-center">
                            <span class="ellipsis" :class="countsOf(room).unread || countsOf(room).mentions ? 'text-weight-bold' : ''">{{room.displayName}}</span>
                            <q-space></q-space>
                            <span class="text-caption m-muted text-no-wrap q-ml-xs">{{shortWhen(room.lastMessage ? room.lastMessage.sentDate : room.lastEventDate)}}</span>
                        </q-item-label>
                        <q-item-label caption class="row no-wrap items-center">
                            <span class="ellipsis col">{{snippetOf(room)}}</span>
                            <q-badge v-if="countsOf(room).mentions" color="negative" rounded class="q-ml-xs">@{{countsOf(room).mentions}}</q-badge>
                            <q-badge v-else-if="countsOf(room).unread" :color="room.isMuted || room.notificationLevelEnumId !== 'CnlAll' ? 'grey-6' : 'primary'" rounded
                                    class="q-ml-xs">{{countsOf(room).unread}}</q-badge>
                        </q-item-label>
                    </q-item-section>
                </q-item>
            </q-list>
            <div v-if="loaded && !rooms.length" class="column items-center q-pa-lg text-center">
                <q-icon name="sym_o_forum" size="40px" class="m-muted"></q-icon>
                <div class="text-subtitle2 q-mt-sm">{{t('No conversations yet')}}</div>
                <div class="text-caption m-muted q-mb-sm">{{t('Message a colleague: one person, or several for a group.')}}</div>
                <q-btn unelevated no-caps color="primary" icon="sym_o_person_add" :label="t('New message')" @click="newOpen = true"></q-btn>
            </div>
            <div v-if="loaded && rooms.length > shownRooms.length" class="text-center q-py-sm">
                <q-btn flat dense no-caps size="sm" color="primary" :label="t('All conversations')" @click="go(linkBase)"></q-btn></div>
        </div>
    </template>
    <template v-else>
        <component v-if="roomComponent" :is="roomComponent" :key="roomId" :base="base" :room-id="roomId" :me="me" :prefs="prefs" compact can-go-back
                :link-base="linkBase" @back="closeRoom" @left="onLeft" @changed="scheduleRooms" @read="onRoomRead"></component>
        <div v-else class="q-pa-sm">
            <div class="row items-center no-wrap q-mb-md"><q-btn flat round dense icon="sym_o_arrow_back" :aria-label="t('Back')" @click="closeRoom"></q-btn>
                <q-skeleton type="text" width="50%" class="q-ml-sm"></q-skeleton></div>
            <div v-for="n in 5" :key="n" class="row no-wrap q-gutter-x-sm q-mb-md">
                <q-skeleton type="QAvatar" size="28px"></q-skeleton>
                <div class="col"><q-skeleton type="text" width="35%"></q-skeleton><q-skeleton type="text"></q-skeleton></div>
            </div>
        </div>
    </template>
</div></template>

<script>
const t = (text) => (moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text);
const DAY = 86400000;
const ROOM_ICONS = { CrtDirect: 'sym_o_group', CrtPrivate: 'sym_o_lock', CrtPublic: 'sym_o_tag', CrtRecord: 'sym_o_description' };
const fill = (text, values) => String(text).replace(/\{(\w+)\}/g, (match, key) => (values[key] == null ? '' : String(values[key])));
const timeText = (millis) => (millis ? new Date(Number(millis)).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' }) : '');
const shortWhen = (millis) => {
    if (!millis) return '';
    const d = new Date(Number(millis));
    const now = new Date();
    if (d.toDateString() === now.toDateString()) return timeText(millis);
    if (now.getTime() - d.getTime() < 6 * DAY) return d.toLocaleDateString(undefined, { weekday: 'short' });
    return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
};
// kept for the page: the tray mounts this component again when it reloads the tab, and a reopened tab shows what it had
const memo = { roomId: null, rooms: null, me: null, prefs: null, roomComponent: null, loading: null };
const MAX_SHOWN = 30;

module.exports = {
    name: 'ChatPanel',
    inject: { mScreen: { default: null } },
    data() {
        return { loaded: !!memo.rooms, rooms: memo.rooms || [], me: memo.me || {}, prefs: memo.prefs || {}, roomId: null, componentVersion: 0,
            height: 520, newOpen: false, newUserIds: [], busy: false };
    },
    computed: {
        // Qvue screens have no container ID wrapper; the loader supplies its identity before mount or measurement.
        inDialog() { return !!this.mScreen && this.mScreen.containerId === 'm-quick-create-body'; },
        // the Chat screen beside this panel's (.../Panel/Chat), under whichever app mounts it
        base() { const path = (this.mScreen && this.mScreen.path) || (this.$root.basePath + '/BasicComms/Panel/Chat'); return path.replace(/\/Panel\/Chat$/, '/Chat'); },
        linkBase() { const base = this.base; const root = this.$root; return base.indexOf(root.basePath + '/') === 0 ? root.linkBasePath + base.slice(root.basePath.length) : base; },
        roomComponent() { void this.componentVersion; return memo.roomComponent; },
        // mentions and unread first, then the latest
        shownRooms() {
            const rank = (room) => (this.countsOf(room).mentions ? 2 : (this.countsOf(room).unread ? 1 : 0));
            return this.rooms.filter((room) => room.isMember).slice().sort((left, right) => {
                const byRank = rank(right) - rank(left);
                if (byRank !== 0) return byRank;
                return (right.lastEventDate || 0) - (left.lastEventDate || 0);
            }).slice(0, MAX_SHOWN);
        },
        unreadTotal() { return this.rooms.reduce((sum, room) => sum + (this.countsOf(room).unread || 0), 0); }
    },
    methods: {
        t,
        fill,
        shortWhen,
        url(name) { return this.base + '/' + name; },
        go(target) { if (target) this.$root.setUrl(target); },
        post(name, params) {
            // the desktop client with its server out of reach (moqui.connection; never on the web): said, and not asked
            if (moqui.connection && moqui.connection.offline) { this.needsConnection(); return Promise.reject({ status: 0, offline: true }); }
            return moqui.request(this.url(name), { method: 'POST', params: params || {} }).then((result) => {
                const json = result.json || {};
                if (json.messageInfos && json.messageInfos.length) moqui.notifyMessages(json.messageInfos, json.errors);
                return json;
            }, (err) => { if (moqui.unreachable && moqui.unreachable(err)) this.needsConnection(); else moqui.handleAjaxError(err); throw err; });
        },
        needsConnection() { moqui.notifyMessages([{ type: 'info', message: t('This needs a connection to the server: try again when it is back') }]); },
        roomIcon(room) { return (room.record && room.record.icon) || ROOM_ICONS[room.roomTypeEnumId] || 'sym_o_chat'; },
        countsOf(room) {
            if (!room.isMember) return { unread: 0, mentions: 0 };
            if (moqui.chat && moqui.chat.state.unread[room.chatRoomId]) return moqui.chat.unreadOf(moqui.chat.state, room.chatRoomId);
            return { unread: room.unreadCount || 0, mentions: room.mentionCount || 0 };
        },
        snippetOf(room) {
            const last = room.lastMessage;
            if (!last) return room.topic || t('No messages yet');
            const text = last.encrypted ? t('Encrypted message') : last.redacted || !last.snippet ? t('Message removed') : last.snippet;
            if (last.senderUserId === this.me.userId) return t('You') + ': ' + text;
            if (room.roomTypeEnumId === 'CrtDirect' && room.otherUserId) return text;
            return String(last.senderName || '').split(' ')[0] + ': ' + text;
        },
        // the rooms, few and light: the panel is a glance (Open in Comms has them all)
        refresh() {
            return moqui.request(this.url('chatData'), { params: { limit: 40 } }).then((result) => {
                const json = result.json || {};
                this.me = memo.me = json.me || {};
                this.prefs = memo.prefs = json.prefs || {};
                this.rooms = memo.rooms = json.roomList || [];
                if (moqui.chat) this.rooms.forEach((room) => {
                    if (room.isMember && room.chatRoomId !== this.roomId) moqui.chat.state.unread[room.chatRoomId] = { unread: room.unreadCount || 0, mentions: room.mentionCount || 0 };
                });
                this.loaded = true;
            }, (err) => { this.loaded = true; console.info('Chat panel: the rooms could not be read', err && err.status); });
        },
        scheduleRooms() { clearTimeout(this.roomsTimer); this.roomsTimer = setTimeout(() => this.refresh(), 400); },
        // the tray's refresh of this tab (m-dynamic-container.shellRefresh): the rooms in place, the open room stays
        shellRefresh() { this.refresh(); },
        // the room view is Chat.qvue's chat-room, loaded once for the page the first time a room opens here
        roomView() {
            if (memo.roomComponent) return Promise.resolve(memo.roomComponent);
            if (!memo.loading) memo.loading = new Promise((resolve) => {
                moqui.loadComponent(this.base + '.qvue', (comp) => {
                    const room = comp && comp.components ? comp.components['chat-room'] : null;
                    if (room) memo.roomComponent = window.Vue && window.Vue.markRaw ? window.Vue.markRaw(room) : room;
                    else console.info('Chat panel: the room view did not load; the room opens in Chat');
                    memo.loading = null;
                    resolve(memo.roomComponent);
                });
            });
            return memo.loading;
        },
        openRoom(id) {
            if (!id) return;
            if (this.inDialog) { this.go(this.linkBase + '?chatRoomId=' + encodeURIComponent(id)); return; }
            this.roomId = memo.roomId = id;
            this.roomView().then((comp) => {
                if (!comp) { this.closeRoom(); this.go(this.linkBase + '?chatRoomId=' + encodeURIComponent(id)); return; }
                this.componentVersion++;
            });
        },
        closeRoom() { this.roomId = memo.roomId = null; this.refresh(); },
        onLeft(id) { if (this.roomId === id) this.closeRoom(); else this.scheduleRooms(); },
        onRoomRead(id) {
            if (moqui.chat) moqui.chat.state.unread[id] = { unread: 0, mentions: 0 };
            const room = this.rooms.find((item) => item.chatRoomId === id);
            if (room) { room.unreadCount = 0; room.mentionCount = 0; }
        },
        toggleNew() { this.newOpen = !this.newOpen; this.newUserIds = []; },
        startDirect() {
            const ids = this.newUserIds || [];
            if (!ids.length) return;
            this.busy = true;
            this.post('createDirect', { userIds: ids.join(',') }).then((json) => {
                this.busy = false;
                this.newOpen = false;
                this.newUserIds = [];
                this.scheduleRooms();
                this.openRoom(json.chatRoomId);
            }, () => { this.busy = false; });
        },
        markAllRead() {
            this.post('markAllRead', {}).then(() => {
                if (moqui.chat) Object.keys(moqui.chat.state.unread).forEach((id) => { moqui.chat.state.unread[id] = { unread: 0, mentions: 0 }; });
                this.rooms.forEach((room) => { room.unreadCount = 0; room.mentionCount = 0; });
            }, () => {});
        },
        onEvent(payload) {
            const event = payload && payload.event;
            if (!event) return;
            const room = this.rooms.find((item) => item.chatRoomId === payload.chatRoomId);
            if (!room) { this.scheduleRooms(); return; }
            room.lastEventSeq = Math.max(Number(room.lastEventSeq || 0), Number(event.eventSeq));
            if (event.type === 'message' && event.threadRootEventSeq == null) {
                const text = String(event.bodyText || '').replace(/\s+/g, ' ').trim();
                room.lastMessage = { eventSeq: event.eventSeq, senderUserId: event.senderUserId, senderName: event.senderName, sentDate: event.sentDate,
                    snippet: event.encrypted ? null : (text.length > 140 ? text.slice(0, 139) + '…' : text) || (event.attachments || []).map((file) => '📎 ' + file.fileName).join(', '),
                    redacted: false, encrypted: !!event.encrypted };
                room.lastEventDate = event.sentDate;
            } else if (event.type === 'redaction' || event.type === 'membership' || event.type === 'system') this.scheduleRooms();
        },
        measure() {
            const parent = this.$el && this.$el.parentElement;
            if (!parent) return;
            if (this.inDialog) { this.height = Math.min(560, Math.max(360, window.innerHeight - 200)); return; }
            const style = window.getComputedStyle ? window.getComputedStyle(parent) : null;
            const padding = style ? (parseFloat(style.paddingTop) || 0) + (parseFloat(style.paddingBottom) || 0) : 16;
            const available = parent.clientHeight - padding;
            if (available > 200) this.height = available;
        }
    },
    mounted() {
        this.measure();
        if (this.inDialog) this.newOpen = true;
        else if (memo.roomId) this.openRoom(memo.roomId);
        if (window.ResizeObserver && this.$el.parentElement) {
            this.resizer = new window.ResizeObserver(() => this.measure());
            this.resizer.observe(this.$el.parentElement);
        }
        this.unsubscribe = [];
        if (moqui.chat) {
            this.unsubscribe.push(moqui.chat.on('event', (payload) => this.onEvent(payload)));
            this.unsubscribe.push(moqui.chat.on('room', () => this.scheduleRooms()));
        }
        this.refresh();
    },
    beforeUnmount() {
        if (this.resizer) this.resizer.disconnect();
        (this.unsubscribe || []).forEach((off) => off());
        clearTimeout(this.roomsTimer);
    }
};
</script>
