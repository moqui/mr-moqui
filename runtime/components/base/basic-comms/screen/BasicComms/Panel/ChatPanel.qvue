<!-- ChatPanel (design-drawers-commons.md §4 ChatPanel), the component Panel/Chat.xml serves in the qvue render mode: the Chat
    tab of the tray panel, and the + menu's Chat message (in the quick-create dialog it opens on New message). One pane with
    two modes: the rooms, those with mentions or unread messages first, each with its avatar and presence dot, last message,
    time and badges, with New message (people, one or several; with several, a name makes a private room; a phone number,
    for a user with a number that texts, opens its room), Mark all read and Open in Comms; and a room opened in place,
    which is Chat.qvue's chat-room component at 400 px (compact: its side panes and threads open over the timeline), loaded
    the first time a room opens, with a back arrow and Open in Chat. The room, the picker, a room's actions and the archive
    are back layers (moqui.back), so Back closes them one at a time. A person's direct chat has their latest mail thread as a
    line, which opens in the Inbox and says that email is not end-to-end encrypted (Chat's mailLines; Comms-Messaging §3);
    the phone home has All and Phone (the phone-number rooms) when there is one.

    The transitions are those of Comms/Chat. The panel listens to the page's chat store (moqui.chat.on), so a chat push updates
    the rooms instead of reloading the tab; the tray's refresh of the tab (the shell's shellCounts push and its poll) calls
    shellRefresh(), which refreshes the rooms in place, and the open room and the rooms are kept for the page, so the tab comes
    back as it was. -->
<template><div class="m-chat-panel column no-wrap relative-position" :class="home ? 'm-chat-home' : ''" :style="{height: height + 'px'}">
    <template v-if="!roomId">
        <div v-if="archivedView" class="row items-center no-wrap q-pb-xs">
            <q-btn flat round dense icon="sym_o_arrow_back" :aria-label="t('Back to chats')" @click="archivedView = false"></q-btn>
            <div class="col ellipsis text-h6 q-pl-sm">{{t('Archived')}}</div>
        </div>
        <div v-else class="row items-center no-wrap q-pb-xs">
            <div class="col ellipsis" :class="home ? 'text-h6 q-pl-sm' : 'text-subtitle2'">{{t('Chat')}}<span v-if="unreadTotal" class="text-caption m-muted"> · {{fill(t('{count} unread'), {count: unreadTotal})}}</span></div>
            <q-btn v-if="!home" flat round dense icon="sym_o_edit_square" color="primary" :aria-label="t('New message')" @click="toggleNew"><q-tooltip>{{t('New message')}}</q-tooltip></q-btn>
            <q-btn flat round dense icon="sym_o_done_all" :disable="!unreadTotal" :aria-label="t('Mark all read')" @click="markAllRead"><q-tooltip>{{t('Mark all read')}}</q-tooltip></q-btn>
            <q-btn flat dense no-caps size="sm" color="primary" icon="sym_o_open_in_new" :label="home ? undefined : t('Open in Comms')" :aria-label="t('Open in Comms')"
                    @click="go(linkBase)"><q-tooltip v-if="home">{{t('Open in Comms')}}</q-tooltip></q-btn>
        </div>
        <q-input v-if="home && rooms.length > 6" v-model="filter" dense outlined rounded clearable class="q-px-sm q-pb-sm m-chat-home-search" :placeholder="t('Search conversations')">
            <template #prepend><q-icon name="sym_o_search"></q-icon></template></q-input>
        <!-- the phone layout's phone filter (Comms-Messaging §9.1): the rooms of a phone number alone -->
        <div v-if="home && !archivedView && hasPhoneRooms" class="row q-px-sm q-pb-xs m-chat-home-filters">
            <q-chip dense clickable :outline="phoneOnly" :color="phoneOnly ? undefined : 'primary'" :text-color="phoneOnly ? undefined : 'white'" class="q-ml-none"
                    data-filter="all" @click="phoneOnly = false">{{t('All')}}</q-chip>
            <q-chip dense clickable :outline="!phoneOnly" :color="phoneOnly ? 'primary' : undefined" :text-color="phoneOnly ? 'white' : undefined" icon="sym_o_sms"
                    data-filter="phone" @click="phoneOnly = true">{{t('Phone')}}</q-chip>
        </div>
        <div v-if="newOpen && !home" class="q-pb-sm">
            <m-drop-down v-model="newUserIds" name="panelDirectUserIds" multiple server-search :options-url="url('searchUsers')" :options-parameters="pickParameters" :options-extra="contactOptions" :label="toLabel"></m-drop-down>
            <m-text-line v-if="pickKind === 'group'" v-model="newName" name="panelRoomName" :label="t('Name (optional): makes a room')" class="q-mt-xs"></m-text-line>
            <m-drop-down v-if="(pickKind === 'number' || pickKind === 'numbers') && numbers.length > 1" v-model="fromNumber" name="panelFromNumber" :options="numbers" :label="t('From')" class="q-mt-xs"></m-drop-down>
            <div v-if="pickKind === 'mixed'" class="text-caption text-negative q-mt-xs">{{pickHint}}</div>
            <div class="row q-gutter-x-sm q-mt-xs">
                <q-btn dense unelevated no-caps color="primary" icon="sym_o_chat" :label="t('Start')" :disable="pickKind === 'none' || pickKind === 'mixed'" :loading="busy" @click="startDirect"></q-btn>
                <q-btn dense flat no-caps :label="t('Cancel')" @click="newOpen = false"></q-btn>
            </div>
        </div>
        <q-separator></q-separator>
        <div class="col scroll" style="min-height:0">
            <div v-if="!loaded" class="q-pa-xs">
                <div v-for="n in 6" :key="n" class="row items-center no-wrap q-py-sm q-gutter-x-sm">
                    <q-skeleton type="QAvatar" size="32px"></q-skeleton>
                    <div class="col"><q-skeleton type="text" width="45%"></q-skeleton><q-skeleton type="text"></q-skeleton></div>
                </div>
            </div>
            <q-list v-else :dense="!home">
                <!-- on the home: a swipe right pins (or unpins), a swipe left archives (or brings back); a long press opens the room's actions -->
                <q-slide-item v-for="room in shownRooms" :key="room.chatRoomId" left-color="primary" right-color="positive"
                        @left="({reset}) => swiped(room, 'pin', reset)" @right="({reset}) => swiped(room, 'archive', reset)">
                <template v-if="home" #left><div class="row items-center no-wrap"><q-icon :name="room.isPinned ? 'sym_o_keep_off' : 'sym_o_keep'" class="q-mr-sm"></q-icon>{{room.isPinned ? t('Unpin') : t('Pin')}}</div></template>
                <template v-if="home" #right><div class="row items-center no-wrap">{{isArchived(room) ? t('Unarchive') : t('Archive')}}<q-icon :name="isArchived(room) ? 'sym_o_unarchive' : 'sym_o_archive'" class="q-ml-sm"></q-icon></div></template>
                <q-item clickable :class="home ? 'q-px-sm q-py-sm m-chat-home-row' : 'q-px-xs q-py-xs'" :data-room="room.chatRoomId" @click="openRoom(room.chatRoomId)"
                        @touchstart.passive="holdStart(room, $event)" @touchmove.passive="holdCancel()" @touchend="holdEnd($event)" @contextmenu="contextMenu(room, $event)">
                    <q-item-section avatar :style="{minWidth: home ? '56px' : '40px'}">
                        <m-avatar v-if="room.roomTypeEnumId === 'CrtDirect' && room.otherUserId" :name="room.displayName" :user-id="room.otherUserId" :size="avatarSize"></m-avatar>
                        <q-avatar v-else :size="avatarSize" rounded class="m-tonal text-primary" :icon="roomIcon(room)"></q-avatar>
                    </q-item-section>
                    <q-item-section style="min-width:0">
                        <q-item-label class="row no-wrap items-center">
                            <span class="ellipsis" :class="countsOf(room).unread || countsOf(room).mentions ? 'text-weight-bold' : ''">{{room.displayName}}</span>
                            <q-icon v-if="labelOf(room).lock" name="sym_o_lock" size="14px" class="text-positive q-ml-xs m-chat-e2ee-lock" :data-e2ee="room.chatRoomId"
                                    :aria-label="labelOf(room).text"></q-icon>
                            <q-icon v-if="room.isMuted" name="sym_o_notifications_off" size="14px" class="m-muted q-ml-xs" :aria-label="t('Muted')"></q-icon>
                            <q-icon v-if="room.isPinned && home" name="sym_o_keep" size="14px" class="m-muted q-ml-xs" :aria-label="t('Pinned')"></q-icon>
                            <q-space></q-space>
                            <span class="text-caption m-muted text-no-wrap q-ml-xs">{{shortWhen(room.lastMessage ? room.lastMessage.sentDate : room.lastEventDate)}}</span>
                        </q-item-label>
                        <q-item-label caption class="row no-wrap items-center">
                            <span class="ellipsis col">{{snippetOf(room)}}</span>
                            <q-badge v-if="countsOf(room).mentions" color="negative" rounded class="q-ml-xs">@{{countsOf(room).mentions}}</q-badge>
                            <q-badge v-else-if="countsOf(room).unread" :color="room.isMuted || room.notificationLevelEnumId !== 'CnlAll' ? 'grey-6' : 'primary'" rounded
                                    class="q-ml-xs">{{countsOf(room).unread}}</q-badge>
                        </q-item-label>
                        <!-- the person's latest mail thread, opening in the Inbox; email is never end-to-end encrypted (§6.1 rule 7) -->
                        <q-item-label v-if="mailOf(room)" caption class="row no-wrap items-center m-chat-mail-line" :data-mail="room.chatRoomId" role="link" tabindex="0"
                                :aria-label="mailText(mailOf(room)) + '. ' + mailLabel.text" @click.stop="go(mailOf(room).url)"
                                @keydown.enter.stop.prevent="go(mailOf(room).url)" @keydown.space.stop.prevent="go(mailOf(room).url)">
                            <q-icon name="sym_o_mail" size="12px" class="m-muted q-mr-xs"></q-icon>
                            <span class="ellipsis col m-muted">{{mailText(mailOf(room))}}<span class="m-chat-mail-label"> · {{mailLabel.text}}</span></span>
                        </q-item-label>
                    </q-item-section>
                </q-item>
                </q-slide-item>
                <q-item v-if="home && !archivedView && !filter && archivedCount" clickable class="q-px-sm m-chat-archived-row" @click="archivedView = true">
                    <q-item-section avatar style="min-width:56px"><q-avatar size="48px" class="m-tonal" icon="sym_o_archive"></q-avatar></q-item-section>
                    <q-item-section>{{t('Archived')}}</q-item-section>
                    <q-item-section side>{{archivedCount}}</q-item-section>
                </q-item>
            </q-list>
            <div v-if="loaded && archivedView && !shownRooms.length" class="text-center m-muted q-pa-lg">{{t('No archived conversations')}}</div>
            <div v-if="loaded && filter && rooms.length && !shownRooms.length" class="text-center m-muted q-pa-lg">{{t('No conversation matches')}}</div>
            <div v-if="loaded && !rooms.length" class="column items-center q-pa-lg text-center">
                <q-icon name="sym_o_forum" size="40px" class="m-muted"></q-icon>
                <div class="text-subtitle2 q-mt-sm">{{t('No conversations yet')}}</div>
                <div class="text-caption m-muted q-mb-sm">{{t('Message a colleague: one person, or several for a group.')}}</div>
                <q-btn v-if="!home" unelevated no-caps color="primary" icon="sym_o_person_add" :label="t('New message')" @click="openNew"></q-btn>
            </div>
            <div v-if="loaded && !home && rooms.length > shownRooms.length" class="text-center q-py-sm">
                <q-btn flat dense no-caps size="sm" color="primary" :label="t('All conversations')" @click="go(linkBase)"></q-btn></div>
        </div>
        <!-- the phone home: Start chat floats over the list and opens the full-screen picker -->
        <q-btn v-if="home" fab no-caps color="primary" icon="sym_o_edit_square" :label="t('Start chat')" class="m-chat-start" @click="openNew"></q-btn>
        <q-dialog v-if="home" v-model="newOpen" maximized transition-show="slide-up" transition-hide="slide-down">
            <q-card class="column no-wrap m-chat-new">
                <div class="row items-center no-wrap q-pa-sm">
                    <q-btn flat round dense icon="sym_o_arrow_back" :aria-label="t('Back to chats')" v-close-popup></q-btn>
                    <div class="text-h6 q-ml-sm col">{{t('New conversation')}}</div>
                </div>
                <div class="q-px-md">
                    <m-drop-down v-model="newUserIds" name="panelDirectUserIds" multiple server-search :options-url="url('searchUsers')" :options-parameters="pickParameters" :options-extra="contactOptions" :label="toLabel"></m-drop-down>
                    <m-text-line v-if="pickKind === 'group'" v-model="newName" name="panelRoomName" :label="t('Name (optional): makes a room')" class="q-mt-sm"></m-text-line>
                    <m-drop-down v-if="(pickKind === 'number' || pickKind === 'numbers') && numbers.length > 1" v-model="fromNumber" name="panelFromNumber" :options="numbers" :label="t('From')" class="q-mt-sm"></m-drop-down>
                    <div class="text-caption q-mt-sm m-chat-new-hint" :class="pickKind === 'mixed' ? 'text-negative' : 'm-muted'">{{pickHint}}</div>
                </div>
                <q-space></q-space>
                <div class="q-pa-md"><q-btn unelevated no-caps color="primary" class="full-width m-chat-new-start" size="lg" icon="sym_o_chat" :label="t('Start')"
                        :disable="pickKind === 'none' || pickKind === 'mixed'" :loading="busy" @click="startDirect"></q-btn></div>
            </q-card>
        </q-dialog>
        <q-dialog v-model="roomSheet.open" position="bottom" @hide="roomSheet.room = null">
            <q-card v-if="roomSheet.room" class="m-chat-room-sheet" style="width:100%;max-width:560px;border-radius:16px 16px 0 0">
                <div class="text-subtitle1 ellipsis q-px-md q-pt-md q-pb-xs">{{roomSheet.room.displayName}}</div>
                <q-list class="q-pb-sm">
                    <q-item clickable @click="roomAction(roomSheet.room, 'pin')"><q-item-section avatar><q-icon :name="roomSheet.room.isPinned ? 'sym_o_keep_off' : 'sym_o_keep'"></q-icon></q-item-section>
                        <q-item-section>{{roomSheet.room.isPinned ? t('Unpin') : t('Pin to the top')}}</q-item-section></q-item>
                    <q-item clickable @click="roomAction(roomSheet.room, 'mute')"><q-item-section avatar><q-icon :name="roomSheet.room.isMuted ? 'sym_o_notifications' : 'sym_o_notifications_off'"></q-icon></q-item-section>
                        <q-item-section>{{roomSheet.room.isMuted ? t('Unmute') : t('Mute')}}</q-item-section></q-item>
                    <q-item v-if="countsOf(roomSheet.room).unread || countsOf(roomSheet.room).mentions" clickable @click="roomAction(roomSheet.room, 'read')">
                        <q-item-section avatar><q-icon name="sym_o_mark_chat_read"></q-icon></q-item-section><q-item-section>{{t('Mark as read')}}</q-item-section></q-item>
                    <q-item v-else-if="roomSheet.room.lastMessage" clickable @click="roomAction(roomSheet.room, 'unread')">
                        <q-item-section avatar><q-icon name="sym_o_mark_chat_unread"></q-icon></q-item-section><q-item-section>{{t('Mark as unread')}}</q-item-section></q-item>
                    <q-item clickable @click="roomAction(roomSheet.room, 'archive')"><q-item-section avatar><q-icon :name="isArchived(roomSheet.room) ? 'sym_o_unarchive' : 'sym_o_archive'"></q-icon></q-item-section>
                        <q-item-section>{{isArchived(roomSheet.room) ? t('Unarchive') : t('Archive')}}</q-item-section></q-item>
                </q-list>
            </q-card>
        </q-dialog>
    </template>
    <template v-else>
        <component v-if="roomComponent" :is="roomComponent" :key="roomId" :base="base" :room-id="roomId" :me="me" :prefs="prefs" compact can-go-back :bubbles="home"
                :link-base="linkBase" @back="closeRoom" @left="onLeft" @changed="scheduleRooms" @read="onRoomRead"></component>
        <div v-else class="q-pa-sm">
            <div class="row items-center no-wrap q-mb-md"><q-btn flat round dense icon="sym_o_arrow_back" :aria-label="t('Back')" @click="closeRoom"></q-btn>
                <q-skeleton type="text" width="50%" class="q-ml-sm"></q-skeleton></div>
            <div v-for="n in 5" :key="n" class="row no-wrap q-gutter-x-sm q-mb-md">
                <q-skeleton type="QAvatar" size="28px"></q-skeleton>
                <div class="col"><q-skeleton type="text" width="35%"></q-skeleton><q-skeleton type="text"></q-skeleton></div>
            </div>
        </div>
    </template>
</div></template>

<script>
const t = (text) => (moqui.l10n && moqui.l10n.localize ? moqui.l10n.localize(text) : text);
const fill = (text, values) => String(text).replace(/\{(\w+)\}/g, (match, key) => (values[key] == null ? '' : String(values[key])));
// the list's time in the user's zone, by calendar day, as in Chat (moqui.chat, WebrootChat.js; COM-UI-007)
const shortWhen = (millis) => moqui.chat.shortWhen(millis);
// kept for the page: the tray mounts this component again when it reloads the tab, and a reopened tab shows what it had
const memo = { roomId: null, rooms: null, me: null, prefs: null, roomComponent: null, loading: null, mailLines: null };
const MAX_SHOWN = 30;

module.exports = {
    name: 'ChatPanel',
    // home: the phone shell's start screen (Root.qvue): the whole screen, every room, a search, Start chat and bubbles
    props: { home: Boolean },
    emits: ['room'],
    inject: { mScreen: { default: null } },
    data() {
        return { loaded: !!memo.rooms, rooms: memo.rooms || [], me: memo.me || {}, prefs: memo.prefs || {}, roomId: null, componentVersion: 0,
            height: 520, newOpen: false, newUserIds: [], newName: '', fromNumber: '', numbers: [], busy: false, filter: '', archivedView: false,
            roomSheet: { open: false, room: null }, mailLines: memo.mailLines || {}, phoneOnly: false };
    },
    computed: {
        // Qvue screens have no container ID wrapper; the loader supplies its identity before mount or measurement.
        inDialog() { return !!this.mScreen && this.mScreen.containerId === 'm-quick-create-body'; },
        // the Chat screen beside this panel's (.../Panel/Chat), under whichever app mounts it
        base() { const path = (this.mScreen && this.mScreen.path) || (this.$root.basePath + '/BasicComms/Panel/Chat'); return path.replace(/\/Panel\/Chat$/, '/Chat'); },
        linkBase() { const base = this.base; const root = this.$root; return base.indexOf(root.basePath + '/') === 0 ? root.linkBasePath + base.slice(root.basePath.length) : base; },
        roomComponent() { void this.componentVersion; return memo.roomComponent; },
        avatarSize() { return this.home ? '48px' : '32px'; },
        // mentions and unread first, then the latest (the tray: a glance at the first 30; the home: all, by the filter)
        shownRooms() {
            const words = this.home && this.filter ? String(this.filter).toLowerCase().split(/\s+/).filter(Boolean) : [];
            const rank = (room) => (this.countsOf(room).mentions ? 2 : (this.countsOf(room).unread ? 1 : 0));
            const matches = (room) => { const text = (room.displayName + ' ' + this.snippetOf(room)).toLowerCase(); return words.every((word) => text.indexOf(word) >= 0); };
            // the home is the phone's list: pinned first, then the latest; the archive is apart (a search finds both)
            const archived = (room) => this.isArchived(room);
            const phone = this.home && this.phoneOnly && this.hasPhoneRooms && !this.archivedView;
            const list = this.rooms.filter((room) => room.isMember && (!phone || room.roomTypeEnumId === 'CrtExternal')
                    && (!words.length ? (this.archivedView ? archived(room) : !archived(room)) : matches(room))).sort((left, right) => {
                if (this.home && left.isPinned !== right.isPinned) return left.isPinned ? -1 : 1;
                const byRank = this.home ? 0 : rank(right) - rank(left);
                if (byRank !== 0) return byRank;
                return (right.lastEventDate || 0) - (left.lastEventDate || 0);
            });
            return this.home ? list : list.slice(0, MAX_SHOWN);
        },
        // the new-chat picker: what is picked (moqui.chat.pickKind), and phone numbers offered when the user has one that texts
        pickKind() { return moqui.chat.pickKind(this.newUserIds); },
        pickParameters() { return { numbers: this.numbers.length ? 'true' : '' }; },
        // the phone's own contacts with a number, as the picker's extra options (the mobile app only)
        contactOptions() { return this.numbers.length && moqui.chat && moqui.chat.contactOptions ? moqui.chat.contactOptions : null; },
        toLabel() { return this.numbers.length ? t('To: people or a phone number') : t('To: one person or several'); },
        pickHint() {
            const kind = this.pickKind;
            if (kind === 'number') return t('A text from your number: the conversation with this number opens.');
            if (kind === 'numbers') return t('A group text from your number: one conversation with these numbers.');
            if (kind === 'mixed') return t('A text goes to phone numbers only: start it without the people.');
            if (kind === 'group') return t('A group chat; with a name it is a room, which can take more people later.');
            return this.numbers.length ? t('Pick one person for a direct chat, several for a group, or type a phone number to text it.')
                : t('Pick one person for a direct chat, or several for a group.');
        },
        archivedCount() { return this.rooms.filter((room) => room.isMember && this.isArchived(room)).length; },
        hasPhoneRooms() { return this.rooms.some((room) => room.isMember && room.roomTypeEnumId === 'CrtExternal'); },
        mailLabel() { return moqui.chat.e2eeLabel({ mail: true }); },
        unreadTotal() { return this.rooms.reduce((sum, room) => sum + (this.countsOf(room).unread || 0), 0); }
    },
    methods: {
        t,
        fill,
        shortWhen,
        url(name) { return this.base + '/' + name; },
        go(target) { if (target) this.$root.setUrl(target); },
        post(name, params) {
            // the desktop client with its server out of reach (moqui.connection; never on the web): said, and not asked
            if (moqui.connection && moqui.connection.offline) { this.needsConnection(); return Promise.reject({ status: 0, offline: true }); }
            return moqui.request(this.url(name), { method: 'POST', params: params || {} }).then((result) => {
                const json = result.json || {};
                if (json.messageInfos && json.messageInfos.length) moqui.notifyMessages(json.messageInfos, json.errors);
                return json;
            }, (err) => { if (moqui.unreachable && moqui.unreachable(err)) this.needsConnection(); else moqui.handleAjaxError(err); throw err; });
        },
        needsConnection() { moqui.notifyMessages([{ type: 'info', message: t('This needs a connection to the server: try again when it is back') }]); },
        // archived by me, until a message after the archive (ChatRoomMember.archivedEventSeq)
        isArchived(room) { return moqui.chat.isArchived(room); },
        holdStart(room, event) {
            this.holdCancel();
            if (!this.home || (event.touches && event.touches.length > 1)) return;
            this.holdTimer = setTimeout(() => { this.holdTimer = null; this.held = true; this.openRoomSheet(room); }, 450);
        },
        holdCancel() { if (this.holdTimer) { clearTimeout(this.holdTimer); this.holdTimer = null; } },
        holdEnd(event) { this.holdCancel(); if (this.held) { this.held = false; if (event.cancelable) event.preventDefault(); } },
        contextMenu(room, event) { if (!this.home) return; event.preventDefault(); this.openRoomSheet(room); },
        openRoomSheet(room) {
            this.roomSheet = { open: true, room };
            if (navigator.vibrate) { try { navigator.vibrate(10); } catch (e) { /* no vibration here */ } }
        },
        swiped(room, action, reset) { this.roomAction(room, action); setTimeout(reset, 300); },
        // a room's own settings (pin, mute, archive: setNotification) and its read marker (markRead), changed here at once
        roomAction(room, action) {
            this.roomSheet.open = false;
            if (action === 'pin' || action === 'mute' || action === 'archive') {
                const key = action === 'pin' ? 'isPinned' : action === 'mute' ? 'isMuted' : 'archived';
                const value = action === 'archive' ? !this.isArchived(room) : !room[key];
                const before = { isPinned: room.isPinned, isMuted: room.isMuted, archivedEventSeq: room.archivedEventSeq };
                if (action === 'archive') room.archivedEventSeq = value ? Number(room.lastEventSeq || (room.lastMessage && room.lastMessage.eventSeq) || 0) : null;
                else room[key] = value;
                this.post('setNotification', { chatRoomId: room.chatRoomId, [key]: value ? 'true' : 'false' }).then((json) => {
                    if (json && json.archivedEventSeq !== undefined) room.archivedEventSeq = json.archivedEventSeq;
                }, () => Object.assign(room, before));
                if (action === 'archive') moqui.notifyMessages([{ type: 'info', message: value ? t('Conversation archived') : t('Conversation back in the list') }]);
                return;
            }
            if (action === 'read') {
                this.post('markRead', { chatRoomId: room.chatRoomId }).then(() => this.onRoomRead(room.chatRoomId), () => {});
            } else if (action === 'unread' && room.lastMessage) {
                this.post('markRead', { chatRoomId: room.chatRoomId, eventSeq: room.lastMessage.eventSeq, markUnread: 'true' }).then(() => {
                    if (moqui.chat) moqui.chat.state.unread[room.chatRoomId] = { unread: 1, mentions: 0 };
                    room.unreadCount = Math.max(1, room.unreadCount || 0);
                }, () => {});
            }
        },
        // the type icon (a phone number's room too), counts and snippet as Chat shows them (moqui.chat)
        roomIcon(room) { return moqui.chat.roomIcon(room); },
        // the room's E2EE label (moqui.chat.e2eeLabel): a row shows its lock when it is end to end only (COM-UI-001)
        labelOf(room) { return moqui.chat.e2eeLabel(room); },
        countsOf(room) { return moqui.chat.countsOf(room); },
        snippetOf(room) { return moqui.chat.roomSnippet(room, this.me.userId); },
        // the rooms, few and light: the panel is a glance (Open in Comms has them all)
        refresh() {
            return moqui.request(this.url('chatData'), { params: { limit: this.home ? 200 : 40 } }).then((result) => {
                const json = result.json || {};
                this.me = memo.me = json.me || {};
                this.prefs = memo.prefs = json.prefs || {};
                this.rooms = memo.rooms = json.roomList || [];
                // a phone room's numbers by their names (plans/Comms-Messaging.md §9)
                if (moqui.chat && moqui.chat.nameRooms) moqui.chat.nameRooms(this.rooms);
                // a person's own name across their rooms (Comms-Messaging §11.1): read once for the page, applied with the names
                if (moqui.chat && moqui.chat.people && !(moqui.connection && moqui.connection.offline)) moqui.chat.people(this.url('people'));
                if (moqui.chat) this.rooms.forEach((room) => {
                    if (room.isMember && room.chatRoomId !== this.roomId) moqui.chat.state.unread[room.chatRoomId] = { unread: room.unreadCount || 0, mentions: room.mentionCount || 0 };
                });
                this.loaded = true;
                // the people's mail lines: one request for the page, shared with Chat (moqui.chat.mailLines)
                if (this.rooms.some((room) => room.roomTypeEnumId === 'CrtDirect' || room.roomTypeEnumId === 'CrtExternal' || room.bridged)) this.loadMail();
            }, (err) => { this.loaded = true; console.info('Chat panel: the rooms could not be read', err && err.status); });
        },
        // the mail line of a person's direct chat (Comms-Messaging §3): the Chat screen's mailLines (find#DirectChatMail)
        loadMail() {
            if (moqui.connection && moqui.connection.offline) return;
            moqui.chat.mailLines(this.url('mailLines')).then((lines) => { this.mailLines = memo.mailLines = lines; });
        },
        // a person's room: a direct chat, a phone room, a bridged direct conversation (Comms-Messaging §11.1)
        mailOf(room) { return room ? this.mailLines[room.chatRoomId] || null : null; },
        mailText(mail) { return fill(t('Email: {subject}'), { subject: mail.subject || t('(no subject)') }); },
        scheduleRooms() { clearTimeout(this.roomsTimer); this.roomsTimer = setTimeout(() => this.refresh(), 400); },
        // the tray's refresh of this tab (m-dynamic-container.shellRefresh): the rooms in place, the open room stays
        shellRefresh() { this.refresh(); },
        // the room view is Chat.qvue's chat-room, loaded once for the page the first time a room opens here
        roomView() {
            if (memo.roomComponent) return Promise.resolve(memo.roomComponent);
            if (!memo.loading) memo.loading = new Promise((resolve) => {
                moqui.loadComponent(this.base + '.qvue', (comp) => {
                    const room = comp && comp.components ? comp.components['chat-room'] : null;
                    if (room) memo.roomComponent = window.Vue && window.Vue.markRaw ? window.Vue.markRaw(room) : room;
                    else console.info('Chat panel: the room view did not load; the room opens in Chat');
                    memo.loading = null;
                    resolve(memo.roomComponent);
                });
            });
            return memo.loading;
        },
        openRoom(id) {
            if (!id) return;
            if (this.inDialog) { this.go(this.linkBase + '?chatRoomId=' + encodeURIComponent(id)); return; }
            this.roomId = memo.roomId = id;
            this.$emit('room', id);
            this.roomView().then((comp) => {
                if (!comp) { this.closeRoom(); this.go(this.linkBase + '?chatRoomId=' + encodeURIComponent(id)); return; }
                this.componentVersion++;
            });
        },
        closeRoom() { this.roomId = memo.roomId = null; this.$emit('room', null); this.refresh(); },
        onLeft(id) { if (this.roomId === id) this.closeRoom(); else this.scheduleRooms(); },
        onRoomRead(id) {
            if (moqui.chat) moqui.chat.state.unread[id] = { unread: 0, mentions: 0 };
            const room = this.rooms.find((item) => item.chatRoomId === id);
            if (room) { room.unreadCount = 0; room.mentionCount = 0; }
        },
        toggleNew() { if (this.newOpen) this.newOpen = false; else this.openNew(); },
        openNew() {
            this.newUserIds = [];
            this.newName = '';
            this.newOpen = true;
            // the numbers the user may text from, read again each time (none offline: the picker is people only)
            moqui.request(this.url('textNumbers')).then((result) => {
                this.numbers = moqui.chat.numberOptions(((result && result.json) || {}).numberList);
                if (!this.numbers.some((number) => number.value === this.fromNumber)) this.fromNumber = this.numbers.length ? this.numbers[0].value : '';
            }, () => {});
        },
        // Start: the number's room, a named room, or the direct or group chat (moqui.chat.startChat)
        startDirect() {
            const pick = { values: this.newUserIds || [], name: this.newName, fromNumber: this.fromNumber };
            // one Start at a time: a second would race the first to make the same room
            if (moqui.chat.pickKind(pick.values) === 'none' || this.busy) return;
            this.busy = true;
            moqui.chat.startChat((name, params) => this.post(name, params), pick).then((json) => {
                this.busy = false;
                if (!json || !json.chatRoomId) return;
                this.newOpen = false;
                this.newUserIds = [];
                this.newName = '';
                this.scheduleRooms();
                this.openRoom(json.chatRoomId);
            }, () => { this.busy = false; });
        },
        markAllRead() {
            this.post('markAllRead', {}).then(() => {
                if (moqui.chat) Object.keys(moqui.chat.state.unread).forEach((id) => { moqui.chat.state.unread[id] = { unread: 0, mentions: 0 }; });
                this.rooms.forEach((room) => { room.unreadCount = 0; room.mentionCount = 0; });
            }, () => {});
        },
        onEvent(payload) {
            const event = payload && payload.event;
            if (!event) return;
            const room = this.rooms.find((item) => item.chatRoomId === payload.chatRoomId);
            if (!room) { this.scheduleRooms(); return; }
            room.lastEventSeq = Math.max(Number(room.lastEventSeq || 0), Number(event.eventSeq));
            if (event.type === 'message' && event.threadRootEventSeq == null) {
                const text = String(event.bodyText || '').replace(/\s+/g, ' ').trim();
                room.lastMessage = { eventSeq: event.eventSeq, senderUserId: event.senderUserId, senderName: event.senderName, sentDate: event.sentDate,
                    snippet: event.encrypted ? null : (text.length > 140 ? text.slice(0, 139) + '…' : text) || (event.attachments || []).map((file) => '📎 ' + file.fileName).join(', '),
                    redacted: false, encrypted: !!event.encrypted };
                room.lastEventDate = event.sentDate;
            } else if (event.type === 'redaction' || event.type === 'membership' || event.type === 'system') this.scheduleRooms();
        },
        measure() {
            const parent = this.$el && this.$el.parentElement;
            if (!parent) return;
            if (this.inDialog) { this.height = Math.min(560, Math.max(360, window.innerHeight - 200)); return; }
            const style = window.getComputedStyle ? window.getComputedStyle(parent) : null;
            const padding = style ? (parseFloat(style.paddingTop) || 0) + (parseFloat(style.paddingBottom) || 0) : 16;
            const available = parent.clientHeight - padding;
            if (available > 200) this.height = available;
            else if (this.home) this.height = Math.max(360, window.innerHeight - (this.$el.getBoundingClientRect().top || 0));
        }
    },
    mounted() {
        // what Back closes (moqui.back): the room opened here, the picker, a room's actions, the archive
        this.backOff = moqui.back ? [moqui.back.track(this, () => this.roomId, () => this.closeRoom()), moqui.back.track(this, () => this.archivedView, () => { this.archivedView = false; }),
            moqui.back.track(this, () => this.newOpen, () => { this.newOpen = false; }), moqui.back.track(this, () => this.roomSheet.open, () => { this.roomSheet.open = false; })] : [];
        this.measure();
        if (this.inDialog) this.newOpen = true;
        else if (memo.roomId) this.openRoom(memo.roomId);
        if (window.ResizeObserver && this.$el.parentElement) {
            this.resizer = new window.ResizeObserver(() => this.measure());
            this.resizer.observe(this.$el.parentElement);
        }
        this.unsubscribe = [];
        if (moqui.chat) {
            this.unsubscribe.push(moqui.chat.on('event', (payload) => this.onEvent(payload)));
            this.unsubscribe.push(moqui.chat.on('room', () => this.scheduleRooms()));
        }
        this.refresh();
    },
    beforeUnmount() {
        (this.backOff || []).forEach((off) => off());
        if (this.resizer) this.resizer.disconnect();
        this.holdCancel();
        (this.unsubscribe || []).forEach((off) => off());
        clearTimeout(this.roomsTimer);
    }
};
</script>
