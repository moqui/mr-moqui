<!-- ChatPanel (design-drawers-commons.md §4 ChatPanel; style-guide §3.14 Panel; impl-drawers-commons.md M10): the Chat tab of
    the tray panel (the theme value STRT_TRAY_CHAT names Comms/Panel/Chat, which the tray loads in its best client mode,
    qvue) and the + menu's Chat message. The component is ChatPanel.qvue next to this file: one pane with two modes, the recent rooms with their unread and mention counts and a
    new message to people, and a room opened in place (the room view of Comms/Chat, Chat.qvue's chat-room, at 400 px) with a
    back arrow and Open in Chat. It calls the transitions of Comms/Chat and listens to the page's chat store, so a chat push
    updates it rather than reloading the tab. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Chat" default-menu-include="false" render-modes="vue,qvue,tui" server-static="vue,qvue">
    <widgets>
        <render-mode><text type="qvue" location="component://basic-comms/screen/BasicComms/Panel/ChatPanel.qvue" template="false"/>
            <!-- the terminal twin (style-guide 4.8): the short room list of ChatTui, each room opening in Chat -->
            <text type="tui" location="component://basic-comms/screen/BasicComms/Panel/Chat.tui.json" template="fancy"/></render-mode>
    </widgets>
</screen>
