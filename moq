#!/usr/bin/env bash
# moq: MR Moqui tasks, the replacement for the Java Moqui Gradle tasks. moq-completion-protocol-1
#
# Run ./moq with no arguments for the task list, and ./moq help <task> for one task. This file holds the task table and
# finds the repository; the tasks are in scripts/moq/, one file an area, each with its tasks, their help and helpers
# (a new task: a row in TASKS below, task_<name> and help_<name> in its area's file). Written for bash 3.2 (macOS /bin/bash),
# Git Bash on Windows, and the BSD and GNU userlands: no associative arrays, ${x,,}, mapfile, sed -i, readlink -f, or tail --pid.
# MOQ_DRY_RUN=1 prints each command that changes something, instead of running it.

set -o pipefail

# ========== globals ==========

MOQ_UNAME=$(uname -s)

# Git Bash (MINGW, MSYS, CYGWIN) is the Windows shell. cargo.exe and moqui.exe need Windows
# paths; this script keeps MSYS paths until it starts them.
moq_on_windows() {
    case $MOQ_UNAME in
        MINGW*|MSYS*|CYGWIN*) return 0 ;;
        *) return 1 ;;
    esac
}

# .cargo/config.toml keeps the dev profile's debug info unpacked in the object files, which is not a Windows option,
# and cargo has no per-target profile: on Windows the dev profile takes the compiler default, a PDB beside the binary.
if moq_on_windows; then
    : "${CARGO_PROFILE_DEV_SPLIT_DEBUGINFO:=packed}"
    export CARGO_PROFILE_DEV_SPLIT_DEBUGINFO
fi

MOQ_CWD=$(pwd)

moq_script=$0
# moq.cmd passes a drive-letter path. Git Bash's dirname does not treat `\` as a separator.
if moq_on_windows && command -v cygpath >/dev/null 2>&1; then
    case $moq_script in
        [A-Za-z]:*) moq_script=$(cygpath -u "$moq_script") ;;
    esac
fi
while [ -h "$moq_script" ]; do
    moq_link_dir=$(cd -P "$(dirname "$moq_script")" && pwd)
    moq_script=$(readlink "$moq_script")
    case $moq_script in /*) ;; *) moq_script=$moq_link_dir/$moq_script ;; esac
done
ROOT=$(cd -P "$(dirname "$moq_script")" && pwd)
MOQ="$ROOT/$(basename "$moq_script")"

# Absolute: a Unix path, a drive letter (`C:\`, `C:/`), or a UNC path (`\\server\share`).
is_abs_path() {
    case $1 in
        /*|[A-Za-z]:*) return 0 ;;
    esac
    [ "${1:0:2}" = '\\' ]
}

abs_path() {
    if is_abs_path "$1"; then
        printf '%s\n' "$1"
    else
        printf '%s\n' "$MOQ_CWD/$1"
    fi
}

# A path a Windows program can open. Git Bash keeps MSYS paths (`/d/...`) in this shell.
win_path() {
    if moq_on_windows && command -v cygpath >/dev/null 2>&1; then
        cygpath -w "$1"
    else
        printf '%s\n' "$1"
    fi
}

# An argument for moqui.exe. Git Bash converts a bare absolute path when it starts a program, and
# leaves `location=/d/...` alone because the argument does not start with `/`.
win_arg() {
    case $1 in
        /*) win_path "$1" ;;
        *=/*)
            printf '%s=%s\n' "${1%%=*}" "$(win_path "${1#*=}")"
            ;;
        *) printf '%s\n' "$1" ;;
    esac
}

# The child reads the runtime. On Windows those variables are Windows paths; this shell keeps its own.
apply_win_env() {
    MOQUI_RUNTIME=$(win_path "$RUNTIME_DIR")
    export MOQUI_RUNTIME
    if [ -n "${MOQUI_FRAMEWORK:-}" ]; then
        MOQUI_FRAMEWORK=$(win_path "$MOQUI_FRAMEWORK")
        export MOQUI_FRAMEWORK
    fi
    if [ -n "${MOQUI_CONF:-}" ]; then
        MOQUI_CONF=$(win_path "$MOQUI_CONF")
        export MOQUI_CONF
    fi
}

# The binary reads MOQUI_RUNTIME and MOQUI_FRAMEWORK relative to its working directory, which is ROOT here.
if [ -n "${MOQUI_RUNTIME:-}" ]; then
    MOQUI_RUNTIME=$(abs_path "$MOQUI_RUNTIME")
    export MOQUI_RUNTIME
    RUNTIME_DIR=$MOQUI_RUNTIME
else
    RUNTIME_DIR=$ROOT/runtime
fi
# The runtime's component sets, relative to the runtime, in load order (plans/archive/Components-Dir.md; the Rust side
# is crates/moqui-core/src/context/layout.rs). Each task names a set by these, so a change of layout is made here.
BASE_SET=components/base
ADDON_SET=components/addon
DEV_SET=components/dev
TEST_SET=components/test
COMPONENT_SETS=("$BASE_SET" "$ADDON_SET" "$DEV_SET" "$TEST_SET")
if [ -n "${MOQUI_FRAMEWORK:-}" ]; then
    MOQUI_FRAMEWORK=$(abs_path "$MOQUI_FRAMEWORK")
    export MOQUI_FRAMEWORK
fi
CLUSTER_DIR=$RUNTIME_DIR/db/embedded
SAVE_DIR=$RUNTIME_DIR/save
OS_DIR=$RUNTIME_DIR/opensearch
CHROMIUM_DIR=$RUNTIME_DIR/chromium
ADDONS=$ROOT/addons.xml
MYADDONS=$ROOT/myaddons.xml
# The files components and repositories are looked up in, in order: myaddons.xml, the addons.xml files of the servers
# it names (served_addons_load), then addons.xml.
ADDONS_FILES=("$MYADDONS" "$ADDONS")
# The OpenSearch version, which an embed-opensearch build embeds too: .cargo/config.toml has it.
OPENSEARCH_VERSION=$(sed -n 's/^MOQUI_OPENSEARCH_VERSION = { value = "\([0-9.]*\)".*/\1/p' "$ROOT/.cargo/config.toml" 2>/dev/null)
[ -n "$OPENSEARCH_VERSION" ] || OPENSEARCH_VERSION=3.4.0
CHROMIUM_SNAPSHOTS=https://commondatastorage.googleapis.com/chromium-browser-snapshots
PRODUCTION_CONF=conf/MoquiProductionConf.xml

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
    BOLD=$'\033[1m'
    PLAIN=$'\033[0m'
else
    BOLD=
    PLAIN=
fi

# name|group|arguments|description. Drives the task list, matching, and completion.
TASKS='build|Run|[--lite/--debug/--release/--enterprise] [cargo args...]|Build the Maximal package with the dev tools (target/release/moqui), or Lite, Debug or Enterprise
run|Run|[opts] [moqui-args...]|Run the binary with the dev conf
run-production|Run|[opts] [moqui-args...]|Run the binary with the production conf
load|Run|[types] [name=value] [opts]|Load data, all types by default, with the dev conf
load-production|Run|[types] [name=value] [opts]|Load data with the production conf
test|Run|[component...] [test opts]|Run component tests (moqui test) with the dev conf
test-client|Run|[component...] [-p N] [opts]|Run component client tests (moqui test-client) against a running server
test-load|Run|[component] [--script Name] [-p N] [opts]|Run a component load script (moqui test-load) against a running server
test-apps|Run|[--lite/--debug/--release/--enterprise] [--nobuild]|Run the application tests: moqui test and test-client --serve over runtime/components/addon
test-framework|Run|[--lite/--debug/--release/--enterprise] [--nobuild]|Run the framework tests: cargo, moq, and the specs of components/base and components/dev
test-all|Run|[--lite/--debug/--release/--enterprise] [--nobuild]|Run the whole regression suite: test-framework, then test-apps
accept|Run|[component...] [--spec Name] [--junit dir] [opts]|Run the acceptance suite (test/acceptance/) of the components, or of all
accept-all|Run|[--junit dir] [opts]|Run every acceptance test: the specs of test/acceptance/ and the Rust opt-in and ignored tests
autodoc|Run|[--out dir] [--kinds k,...] [opts]|Markdown docs of the artifacts with Mermaid diagrams, into ./autodoc (moqui autodoc)
load-save|Run|[-n name] [load args...]|clean-all, load, then save-db
save-db|Database|[name]|Save the embedded database and OpenSearch data to runtime/save/<name>
reload-save|Database|[name]|clean-db, then restore a save-db copy
clean-db|Database||Delete the embedded database, txlog, and OpenSearch data
clean-log|Database||Delete the files in runtime/log
clean-all|Database||clean-db, clean-log, runtime/tmp, and tidy-cargo (old artifacts; the latest build stays)
tidy-cargo|Database||Delete old cargo artifacts in target/, keeping the latest build
opensearch-download|OpenSearch|[version] [-f] [--cache-only]|Download OpenSearch into runtime/opensearch and the embed cache
opensearch-start|OpenSearch||Start runtime/opensearch as a daemon with a pid file
opensearch-stop|OpenSearch||Stop the runtime/opensearch daemon
chromium-download|Chromium|[revision] [--latest] [--cache-only]|Download Chromium into runtime/chromium (PDF, browser tests) and the embed cache
git|Git|<git args...>|Run a git command in the root repo and each component repo
git-status|Git|[-s]|Branch, tracking, ahead/behind, and changes in each repo
git-pull|Git|[git pull args...]|Pull each repo and list the new commits
component-get|Components|[name...] [-t type] [-r repo]|Get components or component-sets and the components they depend on
component-depends|Components|[-t type] [-r repo]|Get missing depends-on components for runtime/components/addon
component-create|Components|<name> [opts]|Create a component from the component template
component-zip|Components|[name...]|Zip components in runtime/components/addon
archive|Package|[file] [opts]|Zip (or --tgz) runtime with the binary and MoquiConf.xml, or --binary: the binary alone with the runtime built in
desktop|Package|[dev or build] [--release] [cargo args...]|Run or bundle the desktop app: the node in a Tauri window (crates/moqui-desktop)
android|Package|[emulator, init, dev or build] [--release] [--window] [args...]|Run or build the Android app, or start its emulator (crates/moqui-mobile)
completion|Setup|[bash or zsh] [--install]|Print or install shell completion
help|Setup|[task]|Show the task list or help for one task'

# Gradle task names (normalized) and other old names: alias|task [args]. These resolve only on an exact match.
ALIASES='moqui|run
moqui-production|run-production
load-seed|load-production seed
load-seed-initial|load-production seed seed-initial
start-elastic-search|opensearch-start
stop-elastic-search|opensearch-stop
start-open-search|opensearch-start
stop-open-search|opensearch-stop
start-opensearch|opensearch-start
stop-opensearch|opensearch-stop
download-open-search|opensearch-download
download-opensearch|opensearch-download
download-chromium|chromium-download
git-pull-all|git-pull
git-status-all|git-status
git-checkout-all|git checkout
git-upstream-all|git pull upstream master
git-tag-all|git tag
git-merge-all|git merge
git-diff-tags-all|git log --oneline
get-component|component-get
get-defaults|component-get
get-git|component-get -t git
get-current|component-get -t current
get-release|component-get -t release
get-binary|component-get -t binary
get-depends|component-depends
get-component-set|component-get
create-component|component-create
zip-component|component-zip
zip-components|component-zip
add-runtime|archive'

# The tasks, one file an area, in scripts/moq/ (each with its tasks, their help and their helpers).
for moq_part in core build run test desktop database opensearch chromium git components archive completion harness; do
    # shellcheck source=/dev/null
    . "$ROOT/scripts/moq/$moq_part.sh" || { printf 'moq: could not read scripts/moq/%s.sh\n' "$moq_part" >&2; exit 1; }
done
unset moq_part

# ========== main ==========

main() {
    if [ $# -eq 0 ]; then
        usage
        exit 1
    fi
    case $1 in
        __complete)
            shift
            complete_main "$@"
            exit 0
            ;;
        -h | --help)
            usage
            exit 0
            ;;
    esac
    local input=$1 status
    shift
    resolve_task "$input"
    status=$?
    if [ $status -eq 2 ]; then
        printf 'moq: %s is ambiguous: %s\n' "$input" "$RESOLVED_CANDIDATES" >&2
        exit 2
    elif [ $status -ne 0 ]; then
        local near
        near=$(suggest_tasks "$input")
        if [ -n "$near" ]; then
            printf 'moq: no task %s; did you mean: %s\n' "$input" "$near" >&2
        else
            printf 'moq: no task %s; tasks: %s\n' "$input" "$(task_names | tr '\n' ' ')" >&2
        fi
        exit 1
    fi
    case ${1:-} in
        -h | --help)
            help_task "$RESOLVED_TASK"
            exit 0
            ;;
    esac
    if [ "$RESOLVED_TASK" = help ]; then
        if [ $# -eq 0 ]; then
            usage
            exit 0
        fi
        resolve_task "$1"
        status=$?
        [ $status -ne 2 ] || die "$1 is ambiguous: $RESOLVED_CANDIDATES"
        [ $status -eq 0 ] || die "no task $1"
        help_task "$RESOLVED_TASK"
        exit 0
    fi
    cd "$ROOT" || die "could not cd to $ROOT"
    # Alias arguments are fixed words from ALIASES, so splitting them is safe.
    # shellcheck disable=SC2086
    "task_${RESOLVED_TASK//-/_}" $RESOLVED_ARGS "$@"
}

main "$@"
