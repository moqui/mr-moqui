# ========== binary, conf, and properties ==========

# Set by parse_run_opts.
OPT_PROFILE=
OPT_CONF=
OPT_BUILD=
OPT_LOCATION=
OPT_PROPS=()
OPT_REST=()

valid_property() {
    case $1 in
        '' | [0-9]* | *[!A-Za-z0-9_]*) return 1 ;;
    esac
    return 0
}

add_property() {
    local name=${1%%=*}
    case $1 in *=*) ;; *) die "-D needs name=value, not '$1'" ;; esac
    if ! valid_property "$name"; then
        case $name in
            *.*) die "-D $name: use the underscore form of the property name ($(printf '%s' "$name" | tr . _))" ;;
            *) die "-D $name: not a valid property name" ;;
        esac
    fi
    OPT_PROPS+=("$1")
}

# $1 is "run" (the first word that is not an option starts the binary's arguments), "load" (options anywhere), or
# "test" (like load, but options moq does not know go to the binary, as moqui test's own --spec, --db, ...).
# Everything else lands in OPT_REST.
parse_run_opts() {
    local mode=$1 arg
    shift
    OPT_PROFILE=
    OPT_CONF=
    OPT_BUILD=
    OPT_LOCATION=
    OPT_PROPS=()
    OPT_REST=()
    while [ $# -gt 0 ]; do
        arg=$1
        case $arg in
            --debug) OPT_PROFILE=debug ;;
            -c | --conf)
                [ $# -ge 2 ] || die "$arg needs a file"
                OPT_CONF=$2
                shift
                ;;
            --conf=*) OPT_CONF=${arg#--conf=} ;;
            -p | --port | --port=*)
                local port
                if [ "$arg" = "${arg#--port=}" ]; then
                    [ $# -ge 2 ] || die "$arg needs a port number"
                    port=$2
                    shift
                else
                    port=${arg#--port=}
                fi
                case $port in '' | *[!0-9]*) die "port '$port' is not a number" ;; esac
                OPT_PROPS+=("webapp_http_port=$port")
                ;;
            --https-port | --https-port=*)
                local https_port
                if [ "$arg" = "${arg#--https-port=}" ]; then
                    [ $# -ge 2 ] || die "$arg needs a port number or off"
                    https_port=$2
                    shift
                else
                    https_port=${arg#--https-port=}
                fi
                case $https_port in off) ;; '' | *[!0-9]*) die "https port '$https_port' is not a number or off" ;; esac
                OPT_PROPS+=("webapp_https_listen_port=$https_port")
                ;;
            -D)
                [ $# -ge 2 ] || die "-D needs name=value"
                add_property "$2"
                shift
                ;;
            -D?*) add_property "${arg#-D}" ;;
            --build) OPT_BUILD=1 ;;
            -l | --location)
                [ "$mode" = load ] || die "unknown option $arg"
                [ $# -ge 2 ] || die "$arg needs a file"
                OPT_LOCATION=$2
                shift
                ;;
            --location=*)
                [ "$mode" = load ] || die "unknown option $arg"
                OPT_LOCATION=${arg#--location=}
                ;;
            --)
                shift
                OPT_REST+=("$@")
                return 0
                ;;
            -*)
                if [ "$mode" = test ]; then
                    OPT_REST+=("$arg")
                    shift
                    continue
                fi
                if [ "$mode" = run ]; then
                    die "unknown option $arg (moqui's own arguments go after its command, or after --)"
                fi
                die "unknown option $arg"
                ;;
            *)
                if [ "$mode" = run ]; then
                    OPT_REST+=("$@")
                    return 0
                fi
                OPT_REST+=("$arg")
                ;;
        esac
        shift
    done
}

binary_path() {
    if [ -n "${CARGO_TARGET_DIR:-}" ]; then
        printf '%s/target/moq-bin/%s/moqui\n' "$ROOT" "$1"
    else
        printf '%s\n' "$ROOT/target/$1/moqui"
    fi
}

cargo_build() {
    local profile=$1
    shift
    if [ -n "${CARGO_TARGET_DIR:-}" ]; then
        need_tool python3
        run_cmd python3 "$ROOT/scripts/cargo_cache.py" "$(binary_path "$profile")" cargo build "$@"
    else
        run_cmd env -u CARGO_TARGET_DIR cargo build "$@"
    fi
}

# cargo build for a profile ($1: release or debug), with any more cargo arguments after it. With component crates in
# runtime/component (a Cargo.toml beside a component.xml) the binary is the generated crate in target/moqui-app, which
# links them with the framework; without, it is crates/moqui. Shared-cache builds copy the result to binary_path.
build_binary() {
    local profile=$1
    shift
    need_tool cargo
    local -a release_arg
    release_arg=()
    [ "$profile" = release ] && release_arg=(--release)
    local -a addons
    mapfile -t addons < <(component_crate_dirs "$RUNTIME_DIR/component" "$RUNTIME_DIR/ecomponent")
    if [ ${#addons[@]} -eq 0 ]; then
        cargo_build "$profile" "${release_arg[@]}" -p moqui "$@" >&2 || die "cargo build failed"
        return
    fi
    local app=$ROOT/target/moqui-app
    write_app_crate "$app" "${addons[@]}"
    cargo_build "$profile" "${release_arg[@]}" --manifest-path "$app/Cargo.toml" --target-dir "${CARGO_TARGET_DIR:-$ROOT/target}" "$@" >&2 \
        || die "cargo build failed"
}

# The component directories under each of $@ that have a Rust crate: a Cargo.toml beside the component.xml.
component_crate_dirs() {
    local base dir
    for base in "$@"; do
        [ -d "$base" ] || continue
        for dir in "$base"/*/; do
            dir=${dir%/}
            [ -f "$dir/component.xml" ] && [ -f "$dir/Cargo.toml" ] && printf '%s\n' "$dir"
        done
    done
}

# The [package] name in the Cargo.toml in $1.
crate_package_name() {
    sed -n '/^\[package\]/,/^\[/s/^name[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$1/Cargo.toml" | head -n 1
}

# Write $2 to the file $1 when its content differs, so cargo sees no change on a build with the same components.
write_if_changed() {
    if [ -f "$1" ] && [ "$(cat "$1")" = "$2" ]; then
        return 0
    fi
    if dry_run; then
        show_cmd write "$1"
        return 0
    fi
    printf '%s\n' "$2" >"$1" || die "could not write $1"
}

# Generate the crate in $1 that links the component crates in $2... with the framework: the base-component crates that
# crates/moqui links, then the add-on ones. Its Cargo.lock starts from the repository's, so the reviewed versions stay
# and only the component crates' own dependencies are added.
write_app_crate() {
    local app=$1 dir package deps="" uses="" unoptimized="" crate
    shift
    local -a dirs
    mapfile -t dirs < <(component_crate_dirs "$ROOT/runtime/base-component")
    dirs+=("$@")
    for dir in "${dirs[@]}"; do
        package=$(crate_package_name "$dir")
        [ -n "$package" ] || die "$(rel "$dir")/Cargo.toml has no [package] name"
        deps+="$package = { path = \"$dir\" }"$'\n'
        unoptimized+=$'\n'"[profile.dev.package.$package]"$'\n'"opt-level = 0"$'\n'
        uses+="use ${package//-/_} as _;"$'\n'
        info "Linking component crate $package ($(rel "$dir"))" >&2
    done
    if ! dry_run; then
        mkdir -p "$app/src" || die "could not create $(rel "$app")"
    fi
    for crate in moqui-lib moqui-db moqui-core moqui-host; do
        unoptimized+=$'\n'"[profile.dev.package.$crate]"$'\n'"opt-level = 0"$'\n'
    done
    write_if_changed "$app/Cargo.toml" "# Generated by ./moq build from the component crates in runtime. Written again on each build; do not edit.
# The moqui binary of crates/moqui, with the add-on component crates linked too.

[package]
name = \"moqui-app\"
version = \"0.1.0\"
edition = \"2021\"
publish = false

[[bin]]
name = \"moqui\"
path = \"src/main.rs\"

[dependencies]
moqui-host = { path = \"$ROOT/crates/moqui-host\" }
moqui-core = { path = \"$ROOT/crates/moqui-core\", default-features = false }
${deps}
# Its own workspace: not a member of the repository's.
[workspace]

# As in the repository's workspace, a debug build leaves the framework and component crates at opt-level 0 and
# optimizes the other dependencies (.cargo/config.toml). Here they are not workspace members, so they are named.
${unoptimized}"
    write_if_changed "$app/src/main.rs" "// Generated by ./moq build. Written again on each build; do not edit. The same as crates/moqui/src/main.rs with
// the add-on component crates named too. Naming each keeps its submit_component! entry in the binary.

${uses}
fn main() {
    moqui_host::main();
}"
    if [ ! -f "$app/Cargo.lock" ] || [ "$ROOT/Cargo.lock" -nt "$app/Cargo.lock" ]; then
        run_cmd cp "$ROOT/Cargo.lock" "$app/Cargo.lock" || die "could not copy Cargo.lock"
    fi
}

# Shared targets may contain another checkout's binary: let cargo check freshness before using it.
# Local targets retain the existing explicit --build / missing-binary behavior.
moqui_binary() {
    local profile=$1 bin
    bin=$(binary_path "$profile")
    if [ -n "$OPT_BUILD" ] || [ -n "${CARGO_TARGET_DIR:-}" ]; then
        build_binary "$profile"
    elif [ ! -x "$bin" ]; then
        info "$(rel "$bin") is not built, building it" >&2
        build_binary "$profile"
    fi
    if [ ! -x "$bin" ] && ! dry_run; then
        die "$(rel "$bin") is not there after the build"
    fi
    printf '%s\n' "$bin"
}

# The binary for the profile asked for (--debug), else release.
any_binary() {
    moqui_binary "${OPT_PROFILE:-release}"
}

# MOQUI_CONF as an absolute path. A relative name is tried in the runtime directory, then from the caller's directory.
resolve_conf() {
    local conf=$1
    case $conf in
        /*) [ -f "$conf" ] || die "conf file $conf not found" ;;
        *)
            if [ -f "$RUNTIME_DIR/$conf" ]; then
                conf=$RUNTIME_DIR/$conf
            elif [ -f "$MOQ_CWD/$conf" ]; then
                conf=$MOQ_CWD/$conf
            else
                die "conf file $conf not found in $(rel "$RUNTIME_DIR") or $(rel "$MOQ_CWD")"
            fi
            ;;
    esac
    printf '%s\n' "$conf"
}

# Exports the conf and properties from parse_run_opts. $1 is the default conf, or empty for the binary's default.
apply_run_env() {
    local conf=${OPT_CONF:-$1} prop
    if [ -n "$conf" ]; then
        conf=$(resolve_conf "$conf") || exit 1
        export_var MOQUI_CONF "$conf"
    fi
    for prop in "${OPT_PROPS[@]}"; do
        export_var "${prop%%=*}" "${prop#*=}"
    done
}

# ========== run tasks ==========

task_build() {
    local profile=release
    local -a cargo_args
    cargo_args=()
    while [ $# -gt 0 ]; do
        case $1 in
            --debug) profile=debug ;;
            --)
                shift
                cargo_args+=("$@")
                break
                ;;
            *) cargo_args+=("$1") ;;
        esac
        shift
    done
    build_binary "$profile" "${cargo_args[@]}"
}

task_run() {
    parse_run_opts run "$@"
    local bin
    bin=$(moqui_binary "${OPT_PROFILE:-release}") || exit 1
    apply_run_env ""
    exec_cmd "$bin" "${OPT_REST[@]}"
}

task_run_production() {
    parse_run_opts run "$@"
    local bin
    bin=$(moqui_binary "${OPT_PROFILE:-release}") || exit 1
    apply_run_env "$PRODUCTION_CONF"
    exec_cmd "$bin" "${OPT_REST[@]}"
}

task_test() {
    parse_run_opts test "$@"
    local bin
    bin=$(moqui_binary "${OPT_PROFILE:-release}") || exit 1
    apply_run_env ""
    exec_cmd "$bin" test "${OPT_REST[@]}"
}

# $1 profile, $2 conf, $3 default types ("" for moqui's default), then the load arguments.
run_load() {
    local profile=$1 conf=$2 default_types=$3 bin word types='' has_types=''
    local -a flags
    shift 3
    parse_run_opts load "$@"
    flags=()
    for word in "${OPT_REST[@]}"; do
        case $word in
            types=*)
                has_types=1
                flags+=("$word")
                ;;
            location=*) flags+=("location=$(abs_path "${word#location=}")") ;;
            *=*) flags+=("$word") ;;
            *) types="${types:+$types,}$word" ;;
        esac
    done
    if [ -n "$types" ]; then
        [ -z "$has_types" ] || die "give data types as words or as types=, not both"
        flags=("types=$types" "${flags[@]}")
    elif [ -z "$has_types" ] && [ -n "$default_types" ]; then
        flags=("types=$default_types" "${flags[@]}")
    fi
    if [ -n "$OPT_LOCATION" ]; then
        local location
        location=$(abs_path "$OPT_LOCATION")
        [ -f "$location" ] || die "data file $OPT_LOCATION not found"
        flags+=("location=$location")
    fi
    bin=$(moqui_binary "${OPT_PROFILE:-$profile}") || exit 1
    apply_run_env "$conf"
    exec_cmd "$bin" load "${flags[@]}"
}

task_load() {
    run_load release "" all "$@"
}

task_load_production() {
    run_load release "$PRODUCTION_CONF" "" "$@"
}

task_load_save() {
    local name=default
    local -a load_args
    load_args=()
    while [ $# -gt 0 ]; do
        case $1 in
            -n | --name)
                [ $# -ge 2 ] || die "$1 needs a name"
                name=$2
                shift
                ;;
            --name=*) name=${1#--name=} ;;
            *) load_args+=("$1") ;;
        esac
        shift
    done
    valid_name "$name" || die "save name '$name' may use only letters, digits, '.', '_' and '-'"
    clean_all
    (task_load "${load_args[@]}") || die "load failed; nothing was saved"
    task_save_db "$name"
}

# ========== OpenSearch ==========

opensearch_pid() {
    live_pid "$OS_DIR/pid"
}

opensearch_start() {
    local pid
    [ -x "$OS_DIR/bin/opensearch" ] || die "no OpenSearch in $(rel "$OS_DIR"); get one with ./moq opensearch-download"
    if pid=$(opensearch_pid); then
        info "OpenSearch is already running in $(rel "$OS_DIR") (pid $pid)"
        return 0
    fi
    if [ -f "$OS_DIR/pid" ]; then
        info "Removing the stale pid file $(rel "$OS_DIR/pid")"
        run_cmd rm -f "$OS_DIR/pid"
    fi
    run_cmd mkdir -p "$OS_DIR/logs"
    info "Starting OpenSearch in $(rel "$OS_DIR")"
    if dry_run; then
        show_cmd cd "$OS_DIR"
        show_cmd ./bin/opensearch -d -p pid
        return 0
    fi
    (cd "$OS_DIR" && ./bin/opensearch -d -p pid) || die "OpenSearch did not start; see $(rel "$OS_DIR/logs")"
    if pid=$(opensearch_pid); then
        info "OpenSearch started (pid $pid)"
    fi
}

opensearch_stop() {
    local pid waited=0
    if ! pid=$(opensearch_pid); then
        if [ -f "$OS_DIR/pid" ]; then
            info "Removing the stale pid file $(rel "$OS_DIR/pid")"
            run_cmd rm -f "$OS_DIR/pid"
        else
            info "OpenSearch in $(rel "$OS_DIR") is not running (no pid file)"
        fi
        return 0
    fi
    info "Stopping OpenSearch (pid $pid)"
    run_cmd kill "$pid" || die "could not signal pid $pid"
    dry_run && return 0
    while pid_alive "$pid"; do
        if [ "$waited" -ge 120 ]; then
            die "OpenSearch (pid $pid) did not exit within 120 seconds"
        fi
        sleep 1
        waited=$((waited + 1))
    done
    rm -f "$OS_DIR/pid"
    info "OpenSearch stopped"
}

# Stop a pid-file daemon around changes to its data. OS_PAUSED says whether to start it again.
OS_PAUSED=
opensearch_pause() {
    OS_PAUSED=
    if opensearch_pid >/dev/null; then
        opensearch_stop
        OS_PAUSED=1
    elif server_pid >/dev/null && [ -x "$OS_DIR/bin/opensearch" ] && [ -d "$OS_DIR/data" ]; then
        warn "the server is running and may have started OpenSearch itself; its data may change while this runs"
    fi
}

opensearch_resume() {
    if [ -n "$OS_PAUSED" ]; then
        opensearch_start
    fi
    OS_PAUSED=
}

# Delete OpenSearch data and logs, keeping the install.
clean_opensearch_data() {
    [ -d "$OS_DIR/data" ] || [ -d "$OS_DIR/logs" ] || return 0
    local f
    rm_path "$OS_DIR/data"
    if [ -d "$OS_DIR/logs" ]; then
        for f in "$OS_DIR"/logs/* "$OS_DIR"/logs/.[!.]*; do
            if [ -e "$f" ]; then
                rm_path "$f"
            fi
        done
    fi
}

task_opensearch_start() {
    [ $# -eq 0 ] || die "opensearch-start takes no arguments"
    opensearch_start
}

task_opensearch_stop() {
    [ $# -eq 0 ] || die "opensearch-stop takes no arguments"
    opensearch_stop
}

task_opensearch_download() {
    local version=$OPENSEARCH_VERSION force='' arch name url archive work top pid
    while [ $# -gt 0 ]; do
        case $1 in
            -f | --force) force=1 ;;
            -*) die "unknown option $1" ;;
            *) version=$1 ;;
        esac
        shift
    done
    case $(uname -s) in
        Linux) ;;
        Darwin) die "OpenSearch publishes no macOS tarball; run it another way (Docker, Homebrew) and set elasticsearch_url" ;;
        *) die "opensearch-download supports Linux only" ;;
    esac
    case $(uname -m) in
        x86_64 | amd64) arch=x64 ;;
        aarch64 | arm64) arch=arm64 ;;
        *) die "no OpenSearch tarball for $(uname -m)" ;;
    esac
    if [ -e "$OS_DIR" ]; then
        if pid=$(opensearch_pid); then
            die "OpenSearch is running in $(rel "$OS_DIR") (pid $pid); ./moq opensearch-stop first"
        fi
        [ -n "$force" ] || die "$(rel "$OS_DIR") exists; add --force to replace it, which deletes its data"
    fi
    need_tool curl tar
    name=opensearch-min-$version-linux-$arch.tar.gz
    url=https://artifacts.opensearch.org/releases/core/opensearch/$version/$name
    archive=$RUNTIME_DIR/$name
    if [ -f "$archive" ]; then
        info "Using $(rel "$archive")"
    else
        info "Downloading $url"
        run_cmd curl -fL --progress-bar -o "$archive.part" "$url" || die "download failed"
        run_cmd mv "$archive.part" "$archive"
    fi
    rm_path "$OS_DIR"
    if dry_run; then
        show_cmd tar -xzf "$archive" -C "<temp>"
        show_cmd mv "<temp>/opensearch-$version" "$OS_DIR"
    else
        work=$(mktemp -d "$RUNTIME_DIR/.moq-opensearch.XXXXXX") || die "could not make a temp directory"
        if ! tar -xzf "$archive" -C "$work"; then
            rm -rf "$work"
            die "could not unpack $(rel "$archive")"
        fi
        top=$(ls "$work")
        case $top in
            '' | *[[:space:]]*)
                rm -rf "$work"
                die "unexpected layout in $(rel "$archive")"
                ;;
        esac
        if ! mv "$work/$top" "$OS_DIR"; then
            die "could not move OpenSearch into $(rel "$OS_DIR")"
        fi
        rmdir "$work"
        mkdir -p "$OS_DIR/logs"
    fi
    rm_path "$archive"
    info "OpenSearch $version is in $(rel "$OS_DIR")"
}

