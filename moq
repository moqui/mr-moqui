# stdin: one path per line. stdout: mtime, a tab, the path. GNU stat, else BSD stat.
tidy_batch_stat() {
    local line
    local -a batch
    batch=()
    while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        batch+=("$line")
        if [ "${#batch[@]}" -ge 200 ]; then
            tidy_stat_batch "${batch[@]}" || return 1
            batch=()
        fi
    done
    [ "${#batch[@]}" -eq 0 ] || tidy_stat_batch "${batch[@]}"
}

tidy_stat_batch() {
    if [ "$TIDY_STAT_GNU" = 1 ]; then
        stat -c $'%Y\t%n' "$@"
    else
        stat -f $'%m\t%N' "$@"
    fi
}

tidy_write_manifest_awk() {
    cat >"$TIDY_TMP/manifest.awk" <<'EOF'
function base(path) {
    sub(/.*\//, "", path)
    return path
}

function dir_hash(name) {
    if (match(name, /-[0-9a-f]{16}$/)) return substr(name, RSTART + 1, 16)
    return ""
}

function file_hash(name) {
    if (match(name, /-[0-9a-f]{16}(\.[^.]*)?$/)) return substr(name, RSTART + 1, 16)
    return ""
}

function file_stem(name,    stem) {
    if (file_hash(name) == "") return ""
    stem = name
    sub(/-[0-9a-f]{16}(\.[^.]*)?$/, "", stem)
    if (name ~ /\.(rlib|rmeta|so|dylib|a|dll)$/ && stem ~ /^lib./) sub(/^lib/, "", stem)
    return stem
}

function incr_stem(name,    stem) {
    stem = name
    sub(/-[^-]*$/, "", stem)
    if (stem == name) return ""
    return stem
}

BEGIN { FS = "\t" }

{
    mtime = $1 + 0
    path = $2
    name = base(path)
    parent = path
    sub(/\/[^\/]+$/, "", parent)
    parent_name = base(parent)
    grand = parent
    sub(/\/[^\/]+$/, "", grand)

    if (parent_name == ".fingerprint") {
        unit[path] = name
    } else if (base(grand) == ".fingerprint" && name == "invoked.timestamp") {
        stamp[parent] = mtime
    } else if (base(grand) == ".fingerprint" && name ~ /\.json$/) {
        json_n++
        json_path[json_n] = path
        json_dir[json_n] = parent
        json_name[json_n] = name
        json_m[json_n] = mtime
        has_json[parent] = 1
    } else if (parent_name == "deps") {
        dep_n++
        dep_path[dep_n] = path
        dep_m[dep_n] = mtime
    } else if (parent_name == "build") {
        build_n++
        build_path[build_n] = path
        build_name[build_n] = name
    } else if (parent_name == "incremental") {
        inc_n++
        inc_path[inc_n] = path
        inc_name[inc_n] = name
        inc_m[inc_n] = mtime
    }
}

END {
    for (path in unit) {
        hash = dir_hash(unit[path])
        if (hash == "") continue
        printf "P\t%s\t%s\n", path, hash
        if (!has_json[path]) printf "K\t%s\n", hash
    }
    for (i = 1; i <= json_n; i++) {
        dir = json_dir[i]
        hash = dir_hash(base(dir))
        if (hash == "") continue
        pkg = base(dir)
        sub(/-[0-9a-f]{16}$/, "", pkg)
        kind = json_name[i]
        sub(/\.json$/, "", kind)
        m = (dir in stamp) ? stamp[dir] : json_m[i]
        printf "F\t%s\t%.0f\t%s\t%s\t%s\n", hash, m, pkg, kind, json_path[i]
    }
    for (i = 1; i <= dep_n; i++) {
        name = base(dep_path[i])
        hash = file_hash(name)
        if (hash == "") continue
        printf "D\t%s\t%s\t%s\t%.0f\n", dep_path[i], hash, file_stem(name), dep_m[i]
    }
    for (i = 1; i <= build_n; i++) {
        hash = dir_hash(build_name[i])
        if (hash == "") continue
        printf "B\t%s\t%s\n", build_path[i], hash
    }
    for (i = 1; i <= inc_n; i++) {
        stem = incr_stem(inc_name[i])
        if (stem == "") continue
        printf "I\t%s\t%s\t%.0f\n", inc_path[i], stem, inc_m[i]
    }
}
EOF
}

# One manifest line per fingerprint json, deps file, build dir, incremental dir, and fingerprint dir.
tidy_manifest_profile() {
    local profile=$1 fp=$profile/.fingerprint
    [ -d "$fp" ] || return 0
    {
        find "$fp" -mindepth 1 -maxdepth 1 -type d -print
        find "$fp" -mindepth 2 -maxdepth 2 \( -name '*.json' -o -name 'invoked.timestamp' \) -print
        if [ -d "$profile/deps" ]; then
            find "$profile/deps" -maxdepth 1 -type f -print
        fi
        if [ -d "$profile/build" ]; then
            find "$profile/build" -mindepth 1 -maxdepth 1 -type d -print
        fi
        if [ -d "$profile/incremental" ]; then
            find "$profile/incremental" -mindepth 1 -maxdepth 1 -type d -print
        fi
    } | tidy_batch_stat | awk -f "$TIDY_TMP/manifest.awk"
}

# Refuse anything that is not one artifact file or directory under target/.
tidy_check_build_path() {
    local rest parent leaf
    case $1 in
        "$ROOT/target/moqui-app" | "$ROOT/target/moqui-app"/*)
            die "refusing to delete $(rel "$1")"
            ;;
        "$ROOT"/target/*) ;;
        *) die "refusing to delete $(rel "$1"), which is not under target/" ;;
    esac
    rest=${1#"$ROOT/target/"}
    leaf=${rest##*/}
    parent=${rest%/*}
    case $leaf in
        "" | .* | */*) die "refusing to delete $(rel "$1")" ;;
    esac
    case $parent in
        */.fingerprint | .fingerprint | */deps | deps | */build | build | */incremental | incremental) ;;
        *) die "refusing to delete $(rel "$1")" ;;
    esac
}

tidy_du_kb() {
    local list=$1 path kb s=0
    [ -s "$list" ] || {
        echo 0
        return 0
    }
    if du --files0-from=/dev/null -sk >/dev/null 2>&1; then
        tr '\n' '\0' <"$list" >"$TIDY_TMP/delete0"
        du --files0-from="$TIDY_TMP/delete0" -sk | awk '{s += $1} END {print s + 0}'
        return 0
    fi
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        kb=$(du -sk "$path" | awk '{print $1}')
        s=$((s + kb))
    done <"$list"
    echo "$s"
}

tidy_human_kb() {
    awk -v k="$1" 'BEGIN {
        if (k < 1024) printf "%dK", k + 0
        else if (k < 1048576) printf "%.1fM", k / 1024
        else printf "%.1fG", k / 1048576
    }'
}

# Sets SAVE_NAME and SKIP_OPENSEARCH, and OPT_PACKAGE for any_binary.
parse_save_args() {
    local task=$1
    shift
    SAVE_NAME=default
    SKIP_OPENSEARCH=
    OPT_PACKAGE=
    OPT_NOBUILD=
    local named=''
    while [ $# -gt 0 ]; do
        case $1 in
            --debug) set_package debug ;;
            --release) set_package release ;;
            --enterprise) set_package enterprise ;;
            --skip-opensearch) SKIP_OPENSEARCH=1 ;;
            --nobuild) OPT_NOBUILD=1 ;;
            -*) die "unknown option $1" ;;
            *)
                [ -z "$named" ] || die "$task takes one save name"
                SAVE_NAME=$1
                named=1
                ;;
        esac
        shift
    done
    valid_name "$SAVE_NAME" || die "save name '$SAVE_NAME' may use only letters, digits, '.', '_' and '-'"
}

task_save_db() {
    local bin dir
    parse_save_args save-db "$@"
    if [ ! -d "$CLUSTER_DIR/data" ]; then
        dry_run || die "no embedded database in $(rel "$CLUSTER_DIR"); load data first"
        warn "no embedded database in $(rel "$CLUSTER_DIR") yet"
    fi
    bin=$(any_binary) || exit 1
    dir=$SAVE_DIR/$SAVE_NAME
    run_cmd mkdir -p "$dir" || die "could not make $(rel "$dir")"
    info "Saving the embedded database to $(rel "$dir/moqui.dump")"
    run_cmd "$bin" save-db "$CLUSTER_DIR" "$dir/moqui.dump.part" || die "save-db failed"
    run_cmd mv "$dir/moqui.dump.part" "$dir/moqui.dump"
    if [ -z "$SKIP_OPENSEARCH" ] && [ -d "$OS_DIR/data" ]; then
        info "Saving OpenSearch data to $(rel "$dir/opensearch-data.tar.gz")"
        opensearch_pause
        if run_cmd tar -czf "$dir/opensearch-data.tar.gz.part" -C "$OS_DIR" data; then
            run_cmd mv "$dir/opensearch-data.tar.gz.part" "$dir/opensearch-data.tar.gz"
        else
            run_cmd rm -f "$dir/opensearch-data.tar.gz.part"
            warn "the OpenSearch data was not saved"
        fi
        opensearch_resume
    elif [ -f "$dir/opensearch-data.tar.gz" ]; then
        # An older copy would not match this database.
        run_cmd rm -f "$dir/opensearch-data.tar.gz"
    fi
    info "Saved $(rel "$dir")"
}

task_reload_save() {
    local bin dir
    parse_save_args reload-save "$@"
    dir=$SAVE_DIR/$SAVE_NAME
    [ -f "$dir/moqui.dump" ] || die "no save named $SAVE_NAME (no $(rel "$dir/moqui.dump"))"
    require_server_stopped reload-save
    bin=$(any_binary) || exit 1
    rm_path "$CLUSTER_DIR"
    rm_path "$RUNTIME_DIR/txlog"
    info "Restoring the embedded database from $(rel "$dir/moqui.dump")"
    run_cmd "$bin" load-save "$CLUSTER_DIR" "$dir/moqui.dump" || die "load-save failed"
    if [ -z "$SKIP_OPENSEARCH" ] && { [ -d "$OS_DIR/data" ] || [ -f "$dir/opensearch-data.tar.gz" ]; }; then
        opensearch_pause
        clean_opensearch_data
        if [ -f "$dir/opensearch-data.tar.gz" ] && [ -d "$OS_DIR" ]; then
            info "Restoring OpenSearch data from $(rel "$dir/opensearch-data.tar.gz")"
            run_cmd tar -xzf "$dir/opensearch-data.tar.gz" -C "$OS_DIR" || warn "the OpenSearch data was not restored"
        fi
        opensearch_resume
    fi
    info "Restored $SAVE_NAME"
}

# ========== git ==========

# The root repo, runtime/ when it is its own repo, then component repos, one per line.
git_repos() {
    local dir
    [ -e "$ROOT/.git" ] && printf '%s\n' "$ROOT"
    if [ -e "$RUNTIME_DIR/.git" ] && [ "$RUNTIME_DIR" != "$ROOT" ]; then
        printf '%s\n' "$RUNTIME_DIR"
    fi
    for dir in "$RUNTIME_DIR"/base-component/* "$RUNTIME_DIR"/component/*; do
        if [ -d "$dir" ] && [ -e "$dir/.git" ]; then
            printf '%s\n' "$dir"
        fi
    done
}

# git_repos into the REPOS array.
load_repos() {
    local repo
    REPOS=()
    while IFS= read -r repo; do
        REPOS+=("$repo")
    done < <(git_repos)
    [ ${#REPOS[@]} -gt 0 ] || die "no git repos found"
}

git_branch_label() {
    git -C "$1" symbolic-ref --short -q HEAD 2>/dev/null ||
        printf 'detached at %s\n' "$(git -C "$1" rev-parse --short HEAD 2>/dev/null)"
}

task_git() {
    [ $# -gt 0 ] || die "git needs arguments, like: ./moq git status"
    need_tool git
    local repo failed='' first=1
    load_repos
    for repo in "${REPOS[@]}"; do
        [ -n "$first" ] || echo
        first=
        heading "== $(rel "$repo") ($(git_branch_label "$repo"))"
        if ! run_cmd git --no-pager -C "$repo" "$@"; then
            failed="$failed $(rel "$repo")"
        fi
    done
    if [ -n "$failed" ]; then
        echo
        die "git failed in:$failed"
    fi
}

task_git_status() {
    local short='' repo branch upstream counts behind ahead changes unpushed remote_ref base lines
    while [ $# -gt 0 ]; do
        case $1 in
            -s | --short) short=1 ;;
            *) die "unknown argument $1" ;;
        esac
        shift
    done
    need_tool git
    load_repos
    for repo in "${REPOS[@]}"; do
        branch=$(git_branch_label "$repo")
        upstream=$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
        behind=0
        ahead=0
        unpushed=
        if [ -n "$upstream" ]; then
            counts=$(git -C "$repo" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null)
            behind=${counts%%[[:space:]]*}
            ahead=${counts##*[[:space:]]}
            if [ "${ahead:-0}" -gt 0 ]; then
                unpushed=$(git -C "$repo" log --oneline --no-decorate -n 20 '@{u}..HEAD')
            fi
        fi
        changes=$(git -C "$repo" status --short 2>/dev/null)
        if [ -n "$short" ] && [ -z "$changes" ] && [ "${ahead:-0}" -eq 0 ] && [ "${behind:-0}" -eq 0 ]; then
            continue
        fi
        lines="$branch"
        if [ -n "$upstream" ]; then
            lines="$lines -> $upstream"
            if [ "${ahead:-0}" -gt 0 ] || [ "${behind:-0}" -gt 0 ]; then
                lines="$lines [ahead $ahead, behind $behind]"
            fi
        else
            lines="$lines (no tracking branch)"
        fi
        heading "== $(rel "$repo")  $lines"
        if git -C "$repo" remote 2>/dev/null | grep -qx upstream; then
            base=${upstream#*/}
            for remote_ref in "$base" master main; do
                [ -n "$remote_ref" ] || continue
                if git -C "$repo" rev-parse -q --verify "refs/remotes/upstream/$remote_ref" >/dev/null; then
                    counts=$(git -C "$repo" rev-list --left-right --count "upstream/$remote_ref...HEAD")
                    info "   upstream/$remote_ref: ahead ${counts##*[[:space:]]}, behind ${counts%%[[:space:]]*}"
                    break
                fi
            done
        fi
        if [ -n "$unpushed" ]; then
            info "   unpushed:"
            printf '%s\n' "$unpushed" | sed 's/^/     /'
            [ "$ahead" -le 20 ] || info "     ... and $((ahead - 20)) more"
        fi
        if [ -n "$changes" ]; then
            printf '%s\n' "$changes" | sed 's/^/   /'
        else
            info "   clean"
        fi
    done
}

task_git_pull() {
    need_tool git
    local repo before after failed='' first=1
    load_repos
    for repo in "${REPOS[@]}"; do
        [ -n "$first" ] || echo
        first=
        heading "== $(rel "$repo") ($(git_branch_label "$repo"))"
        before=$(git -C "$repo" rev-parse -q HEAD 2>/dev/null)
        if ! run_cmd git --no-pager -C "$repo" pull "$@"; then
            failed="$failed $(rel "$repo")"
            continue
        fi
        dry_run && continue
        after=$(git -C "$repo" rev-parse -q HEAD 2>/dev/null)
        if [ -n "$before" ] && [ "$before" != "$after" ]; then
            info "New commits:"
            git -C "$repo" log --no-decorate --format='  %h %<(16,trunc)%an %s' "$before..$after"
        fi
    done
    if [ -n "$failed" ]; then
        echo
        die "git pull failed in:$failed"
    fi
}

# ========== components (addons.xml, myaddons.xml, component.xml) ==========

# The file without <!-- --> comments (including ones spanning lines), and with a tag that spans lines joined onto one.
xml_strip_comments() {
    [ -f "$1" ] || return 0
    awk '
        function last(s, c,    i, n) { n = 0; for (i = 1; i <= length(s); i++) if (substr(s, i, 1) == c) n = i; return n }
        {
            line = $0; out = ""
            while (1) {
                if (incomment) {
                    i = index(line, "-->")
                    if (i == 0) { line = ""; break }
                    line = substr(line, i + 3); incomment = 0
                }
                i = index(line, "<!--")
                if (i == 0) { out = out line; break }
                out = out substr(line, 1, i - 1); line = substr(line, i + 4); incomment = 1
            }
            buf = (pending ? buf " " out : out)
            pending = (last(buf, "<") > last(buf, ">"))
            if (!pending) print buf
        }
        END { if (pending) print buf }' "$1"
}

# Lines of file $1 holding element $2. These files keep one element per line, once tags are joined.
xml_elements() {
    xml_strip_comments "$1" | grep "<$2[[:space:]/>]"
}

xml_attr() {
    printf '%s\n' "$1" | sed -n "s/.*[[:space:]]$2=\"\\([^\"]*\\)\".*/\\1/p" | head -n 1
}

# The element of type $1 with name $2, from myaddons.xml first, then addons.xml.
addons_find() {
    local file line
    for file in "$MYADDONS" "$ADDONS"; do
        while IFS= read -r line; do
            if [ "$(xml_attr "$line" name)" = "$2" ]; then
                printf '%s\n' "$line"
                return 0
            fi
        done < <(xml_elements "$file" "$1")
    done
    return 1
}

addons_names() {
    local file line
    for file in "$MYADDONS" "$ADDONS"; do
        while IFS= read -r line; do
            xml_attr "$line" name
        done < <(xml_elements "$file" "$1")
    done | sort -u
}

addons_root_attr() {
    local line
    line=$(xml_elements "$1" addons | head -n 1)
    [ -n "$line" ] && xml_attr "$line" "$2"
}

# The url template of location type $2 in repository $1, from myaddons.xml first, then addons.xml.
addons_location() {
    local file url
    for file in "$MYADDONS" "$ADDONS"; do
        url=$(xml_strip_comments "$file" | awk -v repo="$1" -v type="$2" '
            /<repository[[:space:]]/ {
                inrepo = (match($0, "[[:space:]]name=\"" repo "\"") > 0)
            }
            /<\/repository>/ { inrepo = 0 }
            inrepo && /<location[[:space:]]/ && match($0, "[[:space:]]type=\"" type "\"") {
                if (match($0, /url="[^"]*"/)) { print substr($0, RSTART + 5, RLENGTH - 6); exit }
            }')
        if [ -n "$url" ]; then
            printf '%s\n' "$url"
            return 0
        fi
        # A repository found in myaddons.xml without this type does not fall through to addons.xml.
        if xml_elements "$file" repository | grep -q "[[:space:]]name=\"$1\""; then
            return 1
        fi
    done
    return 1
}

# Fill ${group} style placeholders, and the Groovy ${component.'@group'} ones a Java myaddons.xml uses, from element $2.
expand_url() {
    local url=$1 element=$2 attr value
    for attr in group name branch version token; do
        value=$(xml_attr "$element" "$attr")
        url=${url//"\${$attr}"/"$value"}
        url=${url//"\${component.'@$attr'}"/"$value"}
    done
    printf '%s\n' "$url"
}

default_location_type() {
    if [ -e "$ROOT/.git" ]; then echo git; else echo current; fi
}

# Set by parse_component_args or component-create from -r; empty means fall back to the element and the defaults.
REPOSITORY=

# The default repository when neither -r, the component element, nor default-repository says one: github for an
# https clone of this repo, github-ssh for a git@ or ssh:// one, and github when there is no origin to ask.
DEFAULT_REPOSITORY=
default_repository() {
    if [ -z "$DEFAULT_REPOSITORY" ]; then
        local url=
        if command -v git >/dev/null 2>&1; then
            url=$(git -C "$ROOT" remote get-url origin 2>/dev/null) || url=
        fi
        case $url in
            git@* | ssh://*) DEFAULT_REPOSITORY=github-ssh ;;
            *) DEFAULT_REPOSITORY=github ;;
        esac
    fi
    printf '%s\n' "$DEFAULT_REPOSITORY"
}

check_location_type() {
    case $1 in
        git | current | release | binary) ;;
        *) die "location type '$1' is not git, current, release, or binary" ;;
    esac
}

# Download component $1 (addons element $3) by type $2 into $4.
download_component() {
    local name=$1 type=$2 element=$3 target=$4 version branch repository url work top
    version=$(xml_attr "$element" version)
    branch=$(xml_attr "$element" branch)
    case $type in release | binary) [ -n "$version" ] || type=current ;; esac
    # -r wins, then the element's repository attribute, then default-repository, then the detected default.
    if [ -n "$REPOSITORY" ]; then
        repository=$REPOSITORY
    else
        repository=$(xml_attr "$element" repository)
        [ -n "$repository" ] || repository=$(addons_root_attr "$MYADDONS" default-repository)
        [ -n "$repository" ] || repository=$(addons_root_attr "$ADDONS" default-repository)
        [ -n "$repository" ] || repository=$(default_repository)
    fi
    url=$(addons_location "$repository" "$type") || die "repository $repository has no $type location in myaddons.xml or addons.xml"
    url=$(expand_url "$url" "$element")
    info "Getting $name ($type) from $url${branch:+ at $branch} to $(rel "$target")"
    if [ "$type" = git ]; then
        need_tool git
        if [ -n "$branch" ]; then
            run_cmd git clone -b "$branch" "$url" "$target" || die "git clone of $name failed"
        else
            run_cmd git clone "$url" "$target" || die "git clone of $name failed"
        fi
        return 0
    fi
    need_tool curl unzip
    if dry_run; then
        show_cmd curl -fL -o "$target.zip" "$url"
        show_cmd unzip -q "$target.zip" -d "<temp>"
        show_cmd mv "<temp>/<top>" "$target"
        return 0
    fi
    curl -fL --progress-bar -o "$target.zip" "$url" || {
        rm -f "$target.zip"
        die "download of $name failed"
    }
    work=$(mktemp -d "$(dirname "$target")/.moq-get.XXXXXX") || die "could not make a temp directory"
    if ! unzip -q "$target.zip" -d "$work"; then
        rm -rf "$work" "$target.zip"
        die "could not unpack the $name archive"
    fi
    rm -f "$target.zip"
    # Archives hold one top directory (name-branch or name-version); move its contents up a level as Gradle did.
    top=$(ls -A "$work")
    if [ -n "$top" ] && [ "$(printf '%s\n' "$top" | wc -l)" -eq 1 ] && [ -d "$work/$top" ]; then
        mv "$work/$top" "$target" && rmdir "$work"
    else
        mv "$work" "$target"
    fi || die "could not move $name into $(rel "$target")"
    info "Downloaded $name to $(rel "$target")"
}

# Component names already checked in this run, space separated.
COMPONENTS_CHECKED=' '

# The myaddons.xml or addons.xml component that $1 names: the one of that name, else the one whose component-name is $1,
# a fork whose repository and directory are named apart from its component.xml name (mr-mantle-usl is mantle-usl).
addons_name_for() {
    local file line
    if addons_find component "$1" >/dev/null; then
        printf '%s\n' "$1"
        return 0
    fi
    for file in "$MYADDONS" "$ADDONS"; do
        while IFS= read -r line; do
            if [ "$(xml_attr "$line" component-name)" = "$1" ]; then
                xml_attr "$line" name
                return 0
            fi
        done < <(xml_elements "$file" component)
    done
    printf '%s\n' "$1"
}

# The component.xml name of the component in directory $1, else the directory name.
component_name_of() {
    local name
    name=$(xml_attr "$(xml_elements "$1/component.xml" component | head -n 1)" name)
    printf '%s\n' "${name:-$(basename "$1")}"
}

# The directory in runtime/component of the component a depends-on of $1 means: the directory of that name, else the
# one whose component.xml has that name.
component_dir_named() {
    local dir
    if [ -e "$RUNTIME_DIR/component/$1" ]; then
        printf '%s\n' "$RUNTIME_DIR/component/$1"
        return 0
    fi
    for dir in "$RUNTIME_DIR"/component/*; do
        if [ -f "$dir/component.xml" ] && [ "$(component_name_of "$dir")" = "$1" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
    done
    return 1
}

component_get_one() {
    local name type=$2 element target
    name=$(addons_name_for "$1")
    case $COMPONENTS_CHECKED in *" $name "*) return 0 ;; esac
    element=$(addons_find component "$name") || die "component $name is not in myaddons.xml or addons.xml"
    if [ "$(xml_attr "$element" skip-get)" = true ]; then
        info "Skipping $name (skip-get=true)"
        COMPONENTS_CHECKED="$COMPONENTS_CHECKED$name "
        return 0
    fi
    target=$RUNTIME_DIR/component/$name
    if [ -e "$target" ]; then
        info "$name is already in $(rel "$target")"
    else
        download_component "$name" "$type" "$element" "$target"
    fi
    component_check_depends "$name" "$type"
}

# A depends-on names a component by its component.xml name, which for a fork is not its directory (MrSimpleScreens
# depends on mantle-usl, in mr-mantle-usl).
component_check_depends() {
    local name=$1 type=$2 dir dep dep_dir line
    case $COMPONENTS_CHECKED in *" $name "*) return 0 ;; esac
    COMPONENTS_CHECKED="$COMPONENTS_CHECKED$name "
    dir=$RUNTIME_DIR/component/$name
    [ -f "$dir/component.xml" ] || return 0
    local -a deps
    deps=()
    while IFS= read -r line; do
        dep=$(xml_attr "$line" name)
        [ -z "$dep" ] || deps+=("$dep")
    done < <(xml_elements "$dir/component.xml" depends-on)
    for dep in "${deps[@]}"; do
        if dep_dir=$(component_dir_named "$dep"); then
            component_check_depends "$(basename "$dep_dir")" "$type"
        else
            info "$name depends on $dep"
            component_get_one "$dep" "$type"
        fi
    done
}

components_checked_summary() {
    local list
    list=$(printf '%s' "$COMPONENTS_CHECKED" | tr -s ' ' | sed 's/^ //;s/ $//;s/ /, /g')
    [ -z "$list" ] || info "Checked: $list"
}

# Sets REPOSITORY and LOCATION_TYPE from -r and -t, and COMPONENT_ARGS from the other words.
parse_component_args() {
    LOCATION_TYPE=$(default_location_type)
    REPOSITORY=
    COMPONENT_ARGS=()
    while [ $# -gt 0 ]; do
        case $1 in
            -t | --type)
                [ $# -ge 2 ] || die "$1 needs a type"
                LOCATION_TYPE=$2
                shift
                ;;
            --type=*) LOCATION_TYPE=${1#--type=} ;;
            -r | --repo)
                [ $# -ge 2 ] || die "$1 needs a repository"
                REPOSITORY=$2
                shift
                ;;
            --repo=*) REPOSITORY=${1#--repo=} ;;
            -*) die "unknown option $1" ;;
            *) COMPONENT_ARGS+=("$1") ;;
        esac
        shift
    done
    check_location_type "$LOCATION_TYPE"
}

require_addons() {
    [ -f "$ADDONS" ] || [ -f "$MYADDONS" ] || die "no addons.xml or myaddons.xml in $(rel "$ROOT")"
}

task_component_get() {
    local name defaults
    parse_component_args "$@"
    require_addons
    if [ ${#COMPONENT_ARGS[@]} -eq 0 ]; then
        defaults=$(addons_root_attr "$MYADDONS" default)
        [ -n "$defaults" ] || die "give component names, or set default=\"a,b\" on the myaddons.xml root element"
        COMPONENT_ARGS=()
        for name in $(printf '%s\n' "$defaults" | tr ',' ' '); do
            COMPONENT_ARGS+=("$name")
        done
    fi
    run_cmd mkdir -p "$RUNTIME_DIR/component"
    for name in "${COMPONENT_ARGS[@]}"; do
        component_get_one "$name" "$LOCATION_TYPE"
    done
    components_checked_summary
}

component_set_get() {
    local set=$1 type=$2 element name
    element=$(addons_find component-set "$set") || die "component-set $set is not in myaddons.xml or addons.xml"
    for name in $(xml_attr "$element" components | tr ',' ' '); do
        component_get_one "$name" "$type"
    done
    for name in $(xml_attr "$element" sets | tr ',' ' '); do
        component_set_get "$name" "$type"
    done
}

task_component_set() {
    local set
    parse_component_args "$@"
    require_addons
    [ ${#COMPONENT_ARGS[@]} -gt 0 ] || die "component-set needs a set name: $(addons_names component-set | tr '\n' ' ')"
    run_cmd mkdir -p "$RUNTIME_DIR/component"
    for set in "${COMPONENT_ARGS[@]}"; do
        component_set_get "$set" "$LOCATION_TYPE"
    done
    components_checked_summary
}

component_dirs() {
    local dir
    for dir in "$RUNTIME_DIR"/component/*; do
        if [ -f "$dir/component.xml" ]; then
            printf '%s\n' "$dir"
        fi
    done
}

task_component_depends() {
    local dir
    local -a dirs
    parse_component_args "$@"
    [ ${#COMPONENT_ARGS[@]} -eq 0 ] || die "component-depends takes no component names"
    require_addons
    dirs=()
    while IFS= read -r dir; do
        dirs+=("$dir")
    done < <(component_dirs)
    for dir in "${dirs[@]}"; do
        component_check_depends "$(basename "$dir")" "$LOCATION_TYPE"
    done
    components_checked_summary
}

# A sed regex matching $1 literally, and a replacement inserting $1 literally.
sed_regex_escape() {
    printf '%s\n' "$1" | sed 's/[]\/$*.^[]/\\&/g'
}

sed_replacement_escape() {
    printf '%s\n' "$1" | sed 's/[\/&]/\\&/g'
}

task_component_create() {
    local name='' from=start part='' remote='' no_git='' group='' element target file base new from_re name_rep branch
    LOCATION_TYPE=$(default_location_type)
    REPOSITORY=
    while [ $# -gt 0 ]; do
        case $1 in
            --from)
                [ $# -ge 2 ] || die "--from needs a component name"
                from=$2
                shift
                ;;
            --rest) part=rest ;;
            --screens) part=screens ;;
            -r | --repo)
                [ $# -ge 2 ] || die "$1 needs a repository"
                REPOSITORY=$2
                shift
                ;;
            --repo=*) REPOSITORY=${1#--repo=} ;;
            --git-remote)
                [ $# -ge 2 ] || die "--git-remote needs a URL"
                remote=$2
                shift
                ;;
            --no-git) no_git=1 ;;
            --myaddons)
                [ $# -ge 2 ] || die "--myaddons needs a git group"
                group=$2
                shift
                ;;
            -t | --type)
                [ $# -ge 2 ] || die "$1 needs a type"
                LOCATION_TYPE=$2
                shift
                ;;
            -*) die "unknown option $1" ;;
            *)
                [ -z "$name" ] || die "component-create takes one component name"
                name=$1
                ;;
        esac
        shift
    done
    [ -n "$name" ] || die "component-create needs a component name"
    valid_name "$name" || die "component name '$name' may use only letters, digits, '.', '_' and '-'"
    [ -z "$remote" ] || [ -z "$no_git" ] || die "--git-remote and --no-git do not go together"
    check_location_type "$LOCATION_TYPE"
    require_addons
    target=$RUNTIME_DIR/component/$name
    [ ! -e "$target" ] || die "$(rel "$target") already exists"
    element=$(addons_find component "$from") || die "template component $from is not in myaddons.xml or addons.xml"
    run_cmd mkdir -p "$RUNTIME_DIR/component"
    download_component "$from" "$LOCATION_TYPE" "$element" "$target"
    if dry_run; then
        info "(dry run: renaming $from to $name in $(rel "$target") is skipped)"
        return 0
    fi
    rm -rf "$target/.git" "$target/src" "$target/build.gradle"

    # Files named <from>*, deepest first so a renamed directory does not move a file still to be renamed.
    while IFS= read -r file; do
        base=$(basename "$file")
        new=$(dirname "$file")/$name${base#"$from"}
        mv "$file" "$new"
    done < <(find "$target" -depth -type f -name "$from*")
    from_re=$(sed_regex_escape "$from")
    name_rep=$(sed_replacement_escape "$name")
    while IFS= read -r file; do
        sed "s/$from_re/$name_rep/g" "$file" >"$file.moq-tmp" && cat "$file.moq-tmp" >"$file"
        rm -f "$file.moq-tmp"
    done < <(grep -rlIF -- "$from" "$target")

    case $part in
        rest)
            rm -rf "$target/screen" "$target/template" "$target/data/AppSeedData.xml"
            cat >"$target/MoquiConf.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8" ?>
<!-- No copyright or license for configuration file, details here are not considered a creative work. -->
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
</moqui-conf>
EOF
            info "REST API only: removed screen/, template/, and data/AppSeedData.xml"
            ;;
        screens)
            rm -f "$target/services/$name.rest.xml" "$target/data/ApiSeedData.xml"
            info "Screens only: removed services/$name.rest.xml and data/ApiSeedData.xml"
            ;;
    esac

    branch=master
    if [ -z "$no_git" ]; then
        need_tool git
        if ! git -C "$target" init -q || ! git -C "$target" add .; then
            die "git init failed in $(rel "$target")"
        fi
        branch=$(git -C "$target" symbolic-ref --short HEAD 2>/dev/null || echo master)
        if [ -n "$remote" ]; then
            git -C "$target" remote add origin "$remote"
        fi
    fi
    if [ -n "$group" ]; then
        add_to_myaddons "$name" "$group" "$branch"
    fi
    info "Created $(rel "$target") from $from"
    if [ -z "$no_git" ]; then
        info "Next: cd $(rel "$target") && git commit -m 'Initial commit'${remote:+ && git push -u origin $branch}"
    fi
}

add_to_myaddons() {
    local name=$1 group=$2 branch=$3 line
    line="    <component name=\"$name\" group=\"$group\" branch=\"$branch\"/>"
    if [ ! -f "$MYADDONS" ]; then
        printf '<addons>\n%s\n</addons>\n' "$line" >"$MYADDONS"
        info "Created myaddons.xml with $name"
        return 0
    fi
    grep -q '</addons>' "$MYADDONS" || die "myaddons.xml has no </addons> to add $name before"
    awk -v line="$line" '
        { lines[NR] = $0; if (index($0, "</addons>")) last = NR }
        END { for (i = 1; i <= NR; i++) { if (i == last) print line; print lines[i] } }
    ' "$MYADDONS" >"$MYADDONS.moq-tmp" && cat "$MYADDONS.moq-tmp" >"$MYADDONS"
    rm -f "$MYADDONS.moq-tmp"
    info "Added $name to myaddons.xml"
}

task_component_zip() {
    local dir name element cname version zip
    local -a dirs
    dirs=()
    need_tool zip
    if [ $# -eq 0 ]; then
        while IFS= read -r dir; do
            dirs+=("$dir")
        done < <(component_dirs)
        [ ${#dirs[@]} -gt 0 ] || die "no components with a component.xml in $(rel "$RUNTIME_DIR/component")"
    else
        for name in "$@"; do
            dir=$RUNTIME_DIR/component/$name
            [ -f "$dir/component.xml" ] || die "no component.xml in $(rel "$dir")"
            dirs+=("$dir")
        done
    fi
    for dir in "${dirs[@]}"; do
        name=$(basename "$dir")
        element=$(xml_elements "$dir/component.xml" component | head -n 1)
        cname=$(xml_attr "$element" name)
        version=$(xml_attr "$element" version)
        zip=$RUNTIME_DIR/component/${cname:-$name}${version:+-$version}.zip
        if [ -e "$zip" ]; then
            rm_path "$zip"
        fi
        if dry_run; then
            show_cmd cd "$RUNTIME_DIR/component"
        fi
        # A Rust component (a Cargo.toml) ships its source, which the binary is built from; a Java one leaves it out.
        local -a leave_out
        if [ -f "$dir/Cargo.toml" ]; then
            leave_out=("$name/target/*" "$name/Cargo.lock")
        else
            leave_out=("$name/src/*")
        fi
        (cd "$RUNTIME_DIR/component" && run_cmd zip -qr "$zip" "$name" \
            -x "$name/.git" "$name/.git/*" "$name/build/*" "${leave_out[@]}" "$name/librepo/*" "$name/build.gradle" \
            "*/.DS_Store" "*~") || die "zip failed for $name"
        info "Created $(rel "$zip")"
    done
}

# ========== archive ==========

# The archive for a file name ($1, may be empty) and default extension ($2, .zip or .tgz): relative to the caller's
# directory, the extension added unless it has one, and the default name inside a directory.
archive_path() {
    local file=$1 default
    default=mr-moqui-$(date +%Y%m%d)$2
    if [ -z "$file" ]; then
        abs_path "$default"
        return
    fi
    file=$(abs_path "$file")
    case $file in
        */)
            printf '%s\n' "$file$default"
            return
            ;;
    esac
    if [ -d "$file" ]; then
        printf '%s/%s\n' "$file" "$default"
        return
    fi
    case $file in *.zip | *.tgz | *.tar.gz) ;; *) file=$file$2 ;; esac
    printf '%s\n' "$file"
}

package_name() {
    case $1 in
        default) echo Default ;;
        debug) echo Debug ;;
        release) echo Maximal ;;
        enterprise) echo Enterprise ;;
    esac
}

# README.txt of an archive. $1 file, $2 directory name, $3 binary, $4 package, $5 conf, then the runtime entries.
archive_readme() {
    local file=$1 name=$2 bin=$3 package=$4 conf=$5 commit version entry list='' secrets=''
    shift 5
    for entry in "$@"; do
        list="$list ${entry#"$name"/}"
        [ "$entry" != "$name/.env" ] || secrets=1
    done
    commit=$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null) || commit=
    if [ -n "$commit" ] && [ -n "$(git -C "$ROOT" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
        commit="$commit, with local changes"
    fi
    version=$("$bin" version 2>/dev/null) || version=
    {
        printf '%s\n\n' "$name"
        printf 'MR Moqui, from ./moq archive on %s%s.\n' "$(date +%Y-%m-%d)" "${commit:+ (commit $commit)}"
        printf 'The %s package, built for %s.\n' "$(package_name "$package")" "$(uname -sm)"
        [ -z "$version" ] || printf '%s\n' "$version" | sed 's/^/  /'
        cat <<EOF

Run
  $name/moqui starts the server (HTTP on 8080, HTTPS on 8443) from any directory: this
  directory is its runtime. $name/moqui help lists its other commands and options.

  MoquiConf.xml is this instance's conf, merged over the framework defaults, a copy of
  $(rel "$conf").
  Edit it for this host, or choose another conf with --conf or MOQUI_CONF.

  With the embedded Postgres, the first start unpacks it from the binary into install/postgres/.

Contents
  moqui, MoquiConf.xml, README.txt, LICENSE.md, and from the runtime:$list
  Left out: log, tmp, save, install, db/install, .git, component target/ directories, OpenSearch
  logs and pid files.
EOF
        if [ -n "$secrets" ]; then
            cat <<EOF

  .env holds the generated secrets of this instance, among them the key of the database's
  encrypted fields. Keep it with the database, and keep this archive private.
EOF
        fi
    } >"$file"
}

task_archive() {
    local file='' conf=$PRODUCTION_CONF force='' with_save='' no_data='' named='' tgz=''
    OPT_PACKAGE=
    OPT_NOBUILD=
    while [ $# -gt 0 ]; do
        case $1 in
            --debug) set_package debug ;;
            --release) set_package release ;;
            --enterprise) set_package enterprise ;;
            --nobuild) OPT_NOBUILD=1 ;;
            -c | --conf)
                [ $# -ge 2 ] || die "$1 needs a file"
                conf=$2
                shift
                ;;
            --conf=*) conf=${1#--conf=} ;;
            --tgz) tgz=1 ;;
            --with-save) with_save=1 ;;
            --no-data) no_data=1 ;;
            -f | --force) force=1 ;;
            -*) die "unknown option $1" ;;
            *)
                [ -z "$named" ] || die "archive takes one file name"
                file=$1
                named=1
                ;;
        esac
        shift
    done
    local out name
    if [ -n "$tgz" ]; then
        out=$(archive_path "$file" .tgz)
    else
        out=$(archive_path "$file" .zip)
    fi
    case $out in
        *.tar.gz)
            name=$(basename "$out" .tar.gz)
            tgz=1
            ;;
        *.tgz)
            name=$(basename "$out" .tgz)
            tgz=1
            ;;
        *)
            [ -z "$tgz" ] || die "--tgz writes a .tgz or .tar.gz, not $(basename "$out")"
            name=$(basename "$out" .zip)
            ;;
    esac
    if [ -n "$tgz" ]; then
        need_tool tar gzip
        if tar --help 2>&1 | grep -q BusyBox; then
            die "--tgz needs GNU or BSD tar; BusyBox tar takes only one -C"
        fi
    else
        need_tool zip
    fi
    valid_name "$name" || die "archive name '$name' may use only letters, digits, '.', '_' and '-'"
    [ -d "$(dirname "$out")" ] || die "no directory $(rel "$(dirname "$out")") for $(basename "$out")"
    case $out in
        "$RUNTIME_DIR"/*) die "$(rel "$out") is inside $(rel "$RUNTIME_DIR"), which the archive holds" ;;
    esac
    if [ -e "$out" ] && [ -z "$force" ]; then
        die "$(rel "$out") is there already; -f replaces it"
    fi
    conf=$(resolve_conf "$conf") || exit 1
    [ -n "$no_data" ] || require_server_stopped archive
    local bin
    bin=$(moqui_binary "${OPT_PACKAGE:-default}") || exit 1

    # The archive's own files take the place of runtime entries with their names.
    local entry base
    local -a entries excludes
    entries=()
    for entry in "$RUNTIME_DIR"/* "$RUNTIME_DIR"/.[!.]*; do
        [ -e "$entry" ] || [ -h "$entry" ] || continue
        base=${entry##*/}
        case $base in
            log | tmp | install | .git | moqui | MoquiConf.xml | README.txt | LICENSE.md) continue ;;
            save) [ -n "$with_save" ] || continue ;;
            db | txlog | .env | cert) [ -z "$no_data" ] || continue ;;
        esac
        entries+=("$name/$base")
    done
    excludes=("$name/db/install" "$name/db/install/*" "$name/opensearch/logs/*" "$name/opensearch/pid"
        "*/postmaster.pid" "*/.git" "*/.git/*" "$name/component/*/target/*" "$name/ecomponent/*/target/*" "*/.venv/*"
        "*/__pycache__/*" "*/.DS_Store" "*~")
    [ -z "$no_data" ] || excludes+=("$name/opensearch/data/*")

    # Beside the archive, so the binary is linked or copied onto the disk the archive goes to.
    local stage
    stage=$(mktemp -d "$(dirname "$out")/.moq-archive.XXXXXX") || die "could not make a temp directory"
    (
        trap 'rm -rf "$stage"' EXIT
        archive_write "$stage" "$out" "$name" "$bin" "$conf" "$no_data" "$tgz" "${#entries[@]}" "${entries[@]}" \
            "${excludes[@]}"
    ) || exit $?
    dry_run && return 0
    info "Created $(rel "$out") ($(tidy_human_kb "$(du -sk "$out" | awk '{print $1}')")), which expands to $name/"
    if [ -z "$no_data" ] && { [ -e "$RUNTIME_DIR/.env" ] || [ -d "$RUNTIME_DIR/cert" ]; }; then
        warn "the archive holds .env and cert/, the secrets of this instance; keep it private"
    fi
}

# Stage the archive's top directory in $1 and write it to $2. Then: name, binary, conf, no_data, tgz, the number of
# runtime entries, the entries, and the exclude patterns. The archive's own files are in $1/top/<name>; the runtime
# entries are read through $1/rt/<name>, a link to the runtime, so the archive holds the links inside it as links.
archive_write() {
    local stage=$1 out=$2 name=$3 bin=$4 conf=$5 no_data=$6 tgz=$7 count=$8 status
    shift 8
    local -a entries excludes top
    entries=("${@:1:count}")
    excludes=("${@:count+1}")
    local dir=$stage/top/$name
    mkdir -p "$dir" "$stage/rt" || die "could not stage $name"
    ln "$bin" "$dir/moqui" 2>/dev/null || run_cmd cp -p "$bin" "$dir/moqui" || die "could not stage $name/moqui"
    cp "$conf" "$dir/MoquiConf.xml" && ln -s "$RUNTIME_DIR" "$stage/rt/$name" || die "could not stage $name"
    top=("$name/moqui" "$name/MoquiConf.xml" "$name/README.txt")
    if [ -f "$ROOT/LICENSE.md" ]; then
        cp "$ROOT/LICENSE.md" "$dir/LICENSE.md" || die "could not stage $name"
        top+=("$name/LICENSE.md")
    fi
    archive_readme "$dir/README.txt" "$name" "$bin" "${OPT_PACKAGE:-default}" "$conf" "${entries[@]}"
    local part=$out.part
    rm -f -- "$part"
    if [ -e "$out" ]; then
        run_cmd rm -f -- "$out" || die "could not replace $(rel "$out")"
    fi
    info "Writing $(rel "$out")"
    if [ -z "$no_data" ] && [ -d "$OS_DIR/data" ]; then
        opensearch_pause
    fi
    if [ -n "$tgz" ]; then
        local pattern
        local -a tar_excludes
        tar_excludes=()
        for pattern in "${excludes[@]}"; do
            tar_excludes+=("--exclude=$pattern")
        done
        # The exclusions go before the files, as GNU tar wants them.
        run_cmd tar -czf "$part" "${tar_excludes[@]}" -C "$stage/top" "${top[@]}" -C "$stage/rt" "${entries[@]}"
        status=$?
    else
        if dry_run; then
            show_cmd cd "$stage/top"
        fi
        (cd "$stage/top" && run_cmd zip -q "$part" "${top[@]}")
        status=$?
        if [ "$status" -eq 0 ]; then
            if dry_run; then
                show_cmd cd "$stage/rt"
            fi
            # -y keeps the links inside the runtime as links; the rt/<name> link is only a directory on the way in.
            (cd "$stage/rt" && run_cmd zip -qry "$part" "${entries[@]}" -x "${excludes[@]}")
            status=$?
        fi
    fi
    opensearch_resume
    case $tgz:$status in
        *:0) ;;
        :18) warn "zip could not read some files, and the archive leaves them out" ;;
        *)
            rm -f -- "$part"
            die "writing $(basename "$out") failed (exit $status)"
            ;;
    esac
    run_cmd mv -- "$part" "$out" || die "could not move $(rel "$part") to $(rel "$out")"
}

# ========== completion ==========

completion_bash() {
    cat <<'EOF'
# bash completion for moq (MR Moqui). Load with: eval "$(/path/to/moq completion bash)"
_moq_complete() {
    local cmd=${COMP_WORDS[0]} cur=${COMP_WORDS[COMP_CWORD]} out line
    case $cmd in
        "~/"*) cmd=$HOME/${cmd#"~/"} ;;
        */*) ;;
        *) cmd=$(type -P "$cmd") || return 0 ;;
    esac
    [ -f "$cmd" ] && head -n 3 "$cmd" 2>/dev/null | grep -q moq-completion-protocol-1 || return 0
    out=$("$cmd" __complete "$COMP_CWORD" "${COMP_WORDS[@]:1}" 2>/dev/null) || return 0
    COMPREPLY=()
    case $out in
        @files*)
            while IFS= read -r line; do COMPREPLY+=("$line"); done < <(compgen -f -- "$cur")
            type compopt >/dev/null 2>&1 && compopt -o filenames
            ;;
        @dirs)
            while IFS= read -r line; do COMPREPLY+=("$line"); done < <(compgen -d -- "$cur")
            type compopt >/dev/null 2>&1 && compopt -o filenames
            ;;
        *)
            while IFS= read -r line; do [ -n "$line" ] && COMPREPLY+=("$line"); done <<<"$out"
            if [ ${#COMPREPLY[@]} -eq 1 ]; then
                case ${COMPREPLY[0]} in *= | */) type compopt >/dev/null 2>&1 && compopt -o nospace ;; esac
            fi
            ;;
    esac
    return 0
}
complete -F _moq_complete moq
EOF
}

completion_zsh() {
    cat <<'EOF'
# zsh completion for moq (MR Moqui). Load with: eval "$(/path/to/moq completion zsh)"
_moq_complete() {
    local cmd=${words[1]} out
    local -a cands
    cmd=${~cmd}
    [[ $cmd == */* ]] || cmd=${commands[$cmd]}
    [[ -f $cmd ]] && head -n 3 -- "$cmd" 2>/dev/null | grep -q moq-completion-protocol-1 || return 1
    out=$("$cmd" __complete $((CURRENT - 1)) "${(@)words[2,-1]}" 2>/dev/null) || return 1
    cands=("${(@f)out}")
    case ${cands[1]} in
        @files*) _files ;;
        @dirs) _files -/ ;;
        *)
            [[ -n ${cands[1]} ]] || return 1
            if [[ ${#cands} -eq 1 && ${cands[1]} == *= ]]; then
                compadd -U -S '' -- "${cands[@]}"
            else
                compadd -U -- "${cands[@]}"
            fi
            ;;
    esac
}
if ! (( $+functions[compdef] )); then
    autoload -Uz compinit && compinit
fi
compdef _moq_complete moq
EOF
}

task_completion() {
    local shell='' install='' rc line
    while [ $# -gt 0 ]; do
        case $1 in
            bash | zsh) shell=$1 ;;
            --install) install=1 ;;
            *) die "completion takes bash or zsh, and --install" ;;
        esac
        shift
    done
    if [ -z "$shell" ]; then
        case ${SHELL:-} in
            */zsh) shell=zsh ;;
            *) shell=bash ;;
        esac
    fi
    if [ -z "$install" ]; then
        "completion_$shell"
        return 0
    fi
    case $shell in
        zsh) rc=$HOME/.zshrc ;;
        bash) rc=$HOME/.bashrc ;;
    esac
    line="eval \"\$($(printf '%q' "$MOQ") completion $shell)\""
    if [ -f "$rc" ] && grep -qF -- "$line" "$rc"; then
        info "$rc already loads moq completion"
        return 0
    fi
    if dry_run; then
        show_cmd append "$rc" "$line"
        return 0
    fi
    printf '\n# moq (MR Moqui) tab completion\n%s\n' "$line" >>"$rc" || die "could not write $rc"
    info "Added to $rc: $line"
    info "Open a new shell, or run that line, to use it."
    if [ "$shell" = bash ] && [ "$(uname -s)" = Darwin ]; then
        info "On macOS a login shell reads ~/.bash_profile; source ~/.bashrc from there if it does not already."
    fi
}

conf_names() {
    local f
    for f in "$RUNTIME_DIR"/conf/*.xml; do
        [ -f "$f" ] && printf 'conf/%s\n' "$(basename "$f")"
    done
}

data_types() {
    local framework=${MOQUI_FRAMEWORK:-$RUNTIME_DIR/base-component/framework}
    {
        echo all
        find "$framework/data" "$RUNTIME_DIR"/base-component/*/data "$RUNTIME_DIR"/component/*/data \
            -name '*.xml' -type f -exec grep -hoE '<entity-facade-xml[^>]*type="[^"]*"' {} + 2>/dev/null |
            sed -E 's/.*type="([^"]*)".*/\1/' | tr ',' '\n' | sed 's/^ *//;s/ *$//'
    } | grep -v '^$' | sort -u
}

property_names() {
    local framework=${MOQUI_FRAMEWORK:-$RUNTIME_DIR/base-component/framework}
    grep -ho '<default-property name="[^"]*"' "$framework/conf/MoquiDefaultConf.xml" 2>/dev/null |
        sed 's/.*name="\([^"]*\)"/\1=/' | sort -u
}

save_names() {
    local d
    for d in "$SAVE_DIR"/*; do
        [ -f "$d/moqui.dump" ] && basename "$d"
    done
}

# Names (from component.xml) of the components that have test/*.spec.js files.
test_components() {
    local d
    for d in "$RUNTIME_DIR"/component/*/; do
        compgen -G "${d}test/*.spec.js" >/dev/null || continue
        sed -n 's/.*<component [^>]*name="\([^"]*\)".*/\1/p' "${d}component.xml" 2>/dev/null | head -1
    done
}

component_names_local() {
    local d
    while IFS= read -r d; do
        basename "$d"
    done < <(component_dirs)
}

git_refs() {
    git -C "$ROOT" for-each-ref --format='%(refname:short)' refs/heads refs/tags refs/remotes 2>/dev/null
}

# Candidate lists below come from $(...) and are split on purpose: names hold no spaces or glob characters.
# shellcheck disable=SC2046
complete_run_like() {
    local cur=$1 prev=$2 positional=$3
    case $prev in
        -c | --conf)
            local confs
            confs=$(filter_prefix "$cur" $(conf_names))
            if [ -n "$confs" ]; then printf '%s\n' "$confs"; else echo @files; fi
            return
            ;;
        -l | --location) echo @files; return ;;
        -D) filter_prefix "$cur" $(property_names); return ;;
        -p | --port | -n | --name) return ;;
        --https-port) filter_prefix "$cur" off; return ;;
    esac
    case $cur in
        -*) filter_prefix "$cur" --debug --release --enterprise -c --conf -p --port --https-port -D --nobuild --; return ;;
    esac
    printf '%s\n' "$positional"
}

# shellcheck disable=SC2046
complete_task() {
    local task=$1 cur=$2 prev=$3 nargs=$4 first_arg=$5
    case $task in
        build) filter_prefix "$cur" --debug --release --enterprise ;;
        run | run-production)
            local out
            out=$(complete_run_like "$cur" "$prev" @binary)
            if [ "$out" = @binary ]; then
                filter_prefix "$cur" lint types convert load save-db load-save
            else
                printf '%s\n' "$out"
            fi
            ;;
        test)
            local out
            out=$(complete_run_like "$cur" "$prev" @binary)
            if [ "$out" = @binary ]; then
                filter_prefix "$cur" $(test_components) --spec --feature --db --junit --keep --log-level
            else
                printf '%s\n' "$out"
            fi
            ;;
        load | load-production | load-save)
            local out
            if [ "$task" = load-save ]; then
                case $prev in
                    -n | --name) filter_prefix "$cur" $(save_names); return ;;
                esac
            fi
            out=$(complete_run_like "$cur" "$prev" @types)
            case $out in
                @types)
                    filter_prefix "$cur" $(data_types) components= timeout= raw= disableEntityEca= disableAuditLog= \
                        disableFkCreate= disableDataFeed=
                    ;;
                *)
                    case $cur in
                        -*)
                            filter_prefix "$cur" -l --location
                            [ "$task" != load-save ] || filter_prefix "$cur" -n --name
                            ;;
                    esac
                    printf '%s\n' "$out"
                    ;;
            esac
            ;;
        save-db | reload-save)
            case $cur in
                -*) filter_prefix "$cur" --debug --release --enterprise --nobuild --skip-opensearch ;;
                *) filter_prefix "$cur" $(save_names) ;;
            esac
            ;;
        opensearch-download) filter_prefix "$cur" -f --force "$OPENSEARCH_VERSION" ;;
        chromium-download) filter_prefix "$cur" --latest ;;
        git)
            if [ "$nargs" -eq 1 ]; then
                filter_prefix "$cur" status pull fetch checkout switch branch tag log diff merge push stash reset rebase \
                    remote show
            else
                case $first_arg in
                    checkout | switch | merge | rebase | log | diff | branch | tag | push | reset | show)
                        filter_prefix "$cur" $(git_refs)
                        ;;
                    *) echo @files ;;
                esac
            fi
            ;;
        git-status) filter_prefix "$cur" -s --short ;;
        git-pull) filter_prefix "$cur" --rebase --ff-only --no-rebase ;;
        component-get | component-set | component-depends | component-create)
            case $prev in
                -t | --type) filter_prefix "$cur" git current release binary; return ;;
                -r | --repo) filter_prefix "$cur" $(addons_names repository); return ;;
                --from) filter_prefix "$cur" $(addons_names component); return ;;
                --git-remote | --myaddons) return ;;
            esac
            case $cur in
                -*)
                    if [ "$task" = component-create ]; then
                        filter_prefix "$cur" -t --type -r --repo --from --rest --screens --git-remote --no-git \
                            --myaddons
                    else
                        filter_prefix "$cur" -t --type -r --repo
                    fi
                    ;;
                *)
                    case $task in
                        component-get) filter_prefix "$cur" $(addons_names component) ;;
                        component-set) filter_prefix "$cur" $(addons_names component-set) ;;
                    esac
                    ;;
            esac
            ;;
        component-zip) filter_prefix "$cur" $(component_names_local) ;;
        archive)
            case $prev in
                -c | --conf)
                    filter_prefix "$cur" $(conf_names)
                    return
                    ;;
            esac
            case $cur in
                -*)
                    filter_prefix "$cur" --debug --release --enterprise --nobuild -c --conf --tgz --with-save \
                        --no-data -f --force
                    ;;
                *) echo @files ;;
            esac
            ;;
        completion) filter_prefix "$cur" bash zsh --install ;;
        help) filter_prefix "$cur" $(task_names) ;;
    esac
}

# __complete <cword> <words after moq...>: candidates for the word at cword (1 is the task name), one per line,
# already filtered, or @files / @dirs for the shell's own file completion.
complete_main() {
    local cword=$1 cur prev name found=''
    shift
    local -a words
    words=("$@")
    cur=${words[cword - 1]}
    if [ "$cword" -le 1 ]; then
        for name in $(task_names); do
            case $name in "$cur"*) found="$found $name" ;; esac
        done
        if [ -z "$found" ] && [ -n "$cur" ]; then
            local want
            want=$(normalize_name "$cur")
            for name in $(task_names); do
                if segment_match "$want" "$name"; then found="$found $name"; fi
            done
        fi
        for name in $found; do printf '%s\n' "$name"; done
        return 0
    fi
    resolve_task "${words[0]}" || return 0
    prev=${words[cword - 2]}
    # An alias that carries arguments (git-checkout-all -> git checkout) counts them as typed.
    local first_arg=${words[1]} nargs=$((cword - 1))
    if [ -n "$RESOLVED_ARGS" ]; then
        # shellcheck disable=SC2086
        set -- $RESOLVED_ARGS
        nargs=$((nargs + $#))
        first_arg=$1
        [ "$cword" -gt 2 ] || prev=$1
    fi
    complete_task "$RESOLVED_TASK" "$cur" "$prev" "$nargs" "$first_arg"
}

# ========== main ==========

main() {
    if [ $# -eq 0 ]; then
        usage
        exit 1
    fi
    case $1 in
        __complete)
            shift
            complete_main "$@"
            exit 0
            ;;
        -h | --help)
            usage
            exit 0
            ;;
    esac
    local input=$1 status
    shift
    resolve_task "$input"
    status=$?
    if [ $status -eq 2 ]; then
        printf 'moq: %s is ambiguous: %s\n' "$input" "$RESOLVED_CANDIDATES" >&2
        exit 2
    elif [ $status -ne 0 ]; then
        local near
        near=$(suggest_tasks "$input")
        if [ -n "$near" ]; then
            printf 'moq: no task %s; did you mean: %s\n' "$input" "$near" >&2
        else
            printf 'moq: no task %s; tasks: %s\n' "$input" "$(task_names | tr '\n' ' ')" >&2
        fi
        exit 1
    fi
    case ${1:-} in
        -h | --help)
            help_task "$RESOLVED_TASK"
            exit 0
            ;;
    esac
    if [ "$RESOLVED_TASK" = help ]; then
        if [ $# -eq 0 ]; then
            usage
            exit 0
        fi
        resolve_task "$1"
        status=$?
        [ $status -ne 2 ] || die "$1 is ambiguous: $RESOLVED_CANDIDATES"
        [ $status -eq 0 ] || die "no task $1"
        help_task "$RESOLVED_TASK"
        exit 0
    fi
    cd "$ROOT" || die "could not cd to $ROOT"
    # Alias arguments are fixed words from ALIASES, so splitting them is safe.
    # shellcheck disable=SC2086
    "task_${RESOLVED_TASK//-/_}" $RESOLVED_ARGS "$@"
}

main "$@"
