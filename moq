#!/usr/bin/env bash
# moq: MR Moqui tasks, the replacement for the Java Moqui Gradle tasks. moq-completion-protocol-1
#
# Run ./moq with no arguments for the task list, and ./moq help <task> for one task. Written for bash 3.2 (macOS /bin/bash)
# and the BSD and GNU userlands: no associative arrays, ${x,,}, mapfile, sed -i, readlink -f, or tail --pid.
# MOQ_DRY_RUN=1 prints each command that changes something, instead of running it.

set -o pipefail

# ========== globals ==========

MOQ_CWD=$(pwd)
# An explicitly empty CARGO_TARGET_DIR opts out of shared builds.
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR-${XDG_CACHE_HOME:-$HOME/.cache}/moqui/target}"

moq_script=$0
while [ -h "$moq_script" ]; do
    moq_link_dir=$(cd -P "$(dirname "$moq_script")" && pwd)
    moq_script=$(readlink "$moq_script")
    case $moq_script in /*) ;; *) moq_script=$moq_link_dir/$moq_script ;; esac
done
ROOT=$(cd -P "$(dirname "$moq_script")" && pwd)
MOQ="$ROOT/$(basename "$moq_script")"

abs_path() {
    case $1 in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s\n' "$MOQ_CWD/$1" ;;
    esac
}

# The binary reads MOQUI_RUNTIME and MOQUI_FRAMEWORK relative to its working directory, which is ROOT here.
if [ -n "${MOQUI_RUNTIME:-}" ]; then
    MOQUI_RUNTIME=$(abs_path "$MOQUI_RUNTIME")
    export MOQUI_RUNTIME
    RUNTIME_DIR=$MOQUI_RUNTIME
else
    RUNTIME_DIR=$ROOT/runtime
fi
if [ -n "${MOQUI_FRAMEWORK:-}" ]; then
    MOQUI_FRAMEWORK=$(abs_path "$MOQUI_FRAMEWORK")
    export MOQUI_FRAMEWORK
fi
CLUSTER_DIR=$RUNTIME_DIR/db/embedded
SAVE_DIR=$RUNTIME_DIR/save
OS_DIR=$RUNTIME_DIR/opensearch
ADDONS=$ROOT/addons.xml
MYADDONS=$ROOT/myaddons.xml
OPENSEARCH_VERSION=3.4.0
PRODUCTION_CONF=conf/MoquiProductionConf.xml

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
    BOLD=$'\033[1m'
    PLAIN=$'\033[0m'
else
    BOLD=
    PLAIN=
fi

# name|group|arguments|description. Drives the task list, matching, and completion.
TASKS='build|Run|[--debug] [cargo args...]|Build the release binary (cargo build --release -p moqui), or the debug binary with --debug
run|Run|[opts] [moqui-args...]|Run the release binary with the dev conf
run-production|Run|[opts] [moqui-args...]|Run the release binary with the production conf
load|Run|[types] [name=value] [opts]|Load data, all types by default, with the dev conf
load-production|Run|[types] [name=value] [opts]|Load data with the release binary and production conf
test|Run|[component...] [test opts]|Run component tests (moqui test) with the release binary and the dev conf
load-save|Run|[-n name] [load args...]|clean-all, load, then save-db
save-db|Database|[name]|Save the embedded database and OpenSearch data to runtime/save/<name>
reload-save|Database|[name]|clean-db, then restore a save-db copy
clean-db|Database||Delete the embedded database, txlog, and OpenSearch data
clean-log|Database||Delete the files in runtime/log
clean-all|Database||clean-db, clean-log, runtime/tmp, and tidy-cargo (old artifacts; the latest build stays)
tidy-cargo|Database||Delete old cargo artifacts in target/, keeping the latest build
opensearch-download|OpenSearch|[version] [-f]|Download OpenSearch into runtime/opensearch
opensearch-start|OpenSearch||Start runtime/opensearch as a daemon with a pid file
opensearch-stop|OpenSearch||Stop the runtime/opensearch daemon
git|Git|<git args...>|Run a git command in the root repo and each component repo
git-status|Git|[-s]|Branch, tracking, ahead/behind, and changes in each repo
git-pull|Git|[git pull args...]|Pull each repo and list the new commits
component-get|Components|[name...] [-t type]|Get components and the components they depend on
component-set|Components|<set...> [-t type]|Get the components in a component-set
component-depends|Components|[-t type]|Get missing depends-on components for runtime/component
component-create|Components|<name> [opts]|Create a component from the start component
component-zip|Components|[name...]|Zip components in runtime/component
completion|Setup|[bash or zsh] [--install]|Print or install shell completion
help|Setup|[task]|Show the task list or help for one task'

# Gradle task names (normalized) and other old names: alias|task [args]. These resolve only on an exact match.
ALIASES='moqui|run
moqui-production|run-production
load-seed|load-production seed
load-seed-initial|load-production seed seed-initial
start-elastic-search|opensearch-start
stop-elastic-search|opensearch-stop
start-open-search|opensearch-start
stop-open-search|opensearch-stop
start-opensearch|opensearch-start
stop-opensearch|opensearch-stop
download-open-search|opensearch-download
download-opensearch|opensearch-download
git-pull-all|git-pull
git-status-all|git-status
git-checkout-all|git checkout
git-upstream-all|git pull upstream master
git-tag-all|git tag
git-merge-all|git merge
git-diff-tags-all|git log --oneline
get-component|component-get
get-defaults|component-get
get-git|component-get -t git
get-current|component-get -t current
get-release|component-get -t release
get-binary|component-get -t binary
get-depends|component-depends
get-component-set|component-set
create-component|component-create
zip-component|component-zip
zip-components|component-zip'

# ========== utilities ==========

die() {
    printf 'moq: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'moq: %s\n' "$*" >&2
}

info() {
    printf '%s\n' "$*"
}

heading() {
    printf '%s%s%s\n' "$BOLD" "$*" "$PLAIN"
}

dry_run() {
    [ "${MOQ_DRY_RUN:-}" = 1 ]
}

# The command as a shell would read it, on stderr.
show_cmd() {
    local out='+' arg
    for arg in "$@"; do
        out="$out $(printf '%q' "$arg")"
    done
    printf '%s\n' "$out" >&2
}

run_cmd() {
    if dry_run; then
        show_cmd "$@"
        return 0
    fi
    "$@"
}

exec_cmd() {
    if dry_run; then
        show_cmd exec "$@"
        exit 0
    fi
    exec "$@"
}

export_var() {
    if dry_run; then
        show_cmd export "$1=$2"
    fi
    export "$1=$2"
}

# Paths as the user sees them: relative to the repo root when inside it.
rel() {
    case $1 in
        "$ROOT") printf '.\n' ;;
        "$ROOT"/*) printf '%s\n' "${1#"$ROOT"/}" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

# Delete a path under the runtime directory or the component directory, and refuse anything else.
rm_path() {
    case $1 in
        "$RUNTIME_DIR"/?*) ;;
        *) die "refusing to delete $1, which is not under $(rel "$RUNTIME_DIR")" ;;
    esac
    [ -e "$1" ] || [ -h "$1" ] || return 0
    info "Deleting $(rel "$1")"
    run_cmd rm -rf -- "$1"
}

need_tool() {
    local tool
    for tool in "$@"; do
        command -v "$tool" >/dev/null 2>&1 || die "this task needs '$tool', which is not on the PATH"
    done
}

# kill -0 fails for another user's live process, which ps -p sees (busybox ps has no -p, but kill -0 covers our own).
pid_alive() {
    kill -0 "$1" 2>/dev/null || ps -p "$1" >/dev/null 2>&1
}

# A pid from a pid file when that process is alive.
live_pid() {
    local pid
    [ -f "$1" ] || return 1
    pid=$(head -n 1 "$1" 2>/dev/null | tr -cd '0-9')
    [ -n "$pid" ] || return 1
    pid_alive "$pid" || return 1
    printf '%s\n' "$pid"
}

server_pid() {
    live_pid "$CLUSTER_DIR/data/postmaster.pid"
}

require_server_stopped() {
    local pid
    if pid=$(server_pid); then
        die "$1: the embedded Postgres in $(rel "$CLUSTER_DIR") is running (pid $pid); stop the server first"
    fi
}

valid_name() {
    case $1 in
        '' | .* | *[!A-Za-z0-9._-]*) return 1 ;;
    esac
    return 0
}

# Lines of $1 that start with $2, for completion.
filter_prefix() {
    local cur=$1 line
    shift
    for line in "$@"; do
        case $line in "$cur"*) printf '%s\n' "$line" ;; esac
    done
}

# ========== task names and matching ==========

task_names() {
    printf '%s\n' "$TASKS" | cut -d'|' -f1
}

task_field() {
    printf '%s\n' "$TASKS" | awk -F'|' -v name="$1" -v field="$2" '$1 == name { print $field }'
}

# runProduction -> run-production, gPA -> g-p-a, RUN -> run, clean_db -> clean-db.
normalize_name() {
    case $1 in
        *[[:lower:]]*)
            printf '%s\n' "$1" | sed -e 's/\([^-]\)\([[:upper:]]\)/\1-\2/g' -e 's/\([^-]\)\([[:upper:]]\)/\1-\2/g' |
                tr '[:upper:]_' '[:lower:]-'
            ;;
        *) printf '%s\n' "$1" | tr '[:upper:]_' '[:lower:]-' ;;
    esac
}

# Each dash-separated part of $1 is a prefix of the same part of $2, and $1 may have fewer parts.
segment_match() {
    local i
    local -a want have
    IFS=- read -r -a want <<<"$1"
    IFS=- read -r -a have <<<"$2"
    [ "${#want[@]}" -le "${#have[@]}" ] || return 1
    for ((i = 0; i < ${#want[@]}; i++)); do
        case ${have[i]} in "${want[i]}"*) ;; *) return 1 ;; esac
    done
    return 0
}

# Sets RESOLVED_TASK and RESOLVED_ARGS (an alias's arguments). Returns 1 for no match and 2 for several, with the
# candidates in RESOLVED_CANDIDATES.
resolve_task() {
    local want name line
    RESOLVED_TASK=
    RESOLVED_ARGS=
    RESOLVED_CANDIDATES=
    want=$(normalize_name "$1")
    [ -n "$want" ] || return 1
    for name in $(task_names); do
        if [ "$name" = "$want" ]; then
            RESOLVED_TASK=$name
            return 0
        fi
    done
    while IFS= read -r line; do
        if [ "${line%%|*}" = "$want" ]; then
            line=${line#*|}
            RESOLVED_TASK=${line%% *}
            case $line in *' '*) RESOLVED_ARGS=${line#* } ;; esac
            return 0
        fi
    done <<<"$ALIASES"
    for name in $(task_names); do
        if segment_match "$want" "$name"; then
            RESOLVED_CANDIDATES="$RESOLVED_CANDIDATES $name"
        fi
    done
    RESOLVED_CANDIDATES=${RESOLVED_CANDIDATES# }
    case $RESOLVED_CANDIDATES in
        '') ;;
        *' '*) return 2 ;;
        *)
            RESOLVED_TASK=$RESOLVED_CANDIDATES
            return 0
            ;;
    esac
    # Then old names abbreviated the Gradle way (gPA is gitPullAll), when every match leads to the same task.
    local target='' targets='' same=1
    while IFS= read -r line; do
        if segment_match "$want" "${line%%|*}"; then
            RESOLVED_CANDIDATES="$RESOLVED_CANDIDATES ${line%%|*}"
            [ -z "$targets" ] || [ "$targets" = "${line#*|}" ] || same=
            targets=${line#*|}
        fi
    done <<<"$ALIASES"
    RESOLVED_CANDIDATES=${RESOLVED_CANDIDATES# }
    [ -n "$targets" ] || return 1
    [ -n "$same" ] || return 2
    target=$targets
    RESOLVED_TASK=${target%% *}
    case $target in *' '*) RESOLVED_ARGS=${target#* } ;; esac
    return 0
}

# Task names for an unknown input: those containing it, else those containing a part of it (two letters or more).
suggest_tasks() {
    local want name part found=''
    local -a parts
    want=$(normalize_name "$1")
    for name in $(task_names); do
        case $name in *"$want"*) found="$found $name" ;; esac
    done
    if [ -z "$found" ]; then
        IFS=- read -r -a parts <<<"$want"
        for name in $(task_names); do
            for part in "${parts[@]}"; do
                [ ${#part} -ge 2 ] || continue
                case $name in
                    *"$part"*)
                        found="$found $name"
                        break
                        ;;
                esac
            done
        done
    fi
    printf '%s\n' "${found# }"
}

# ========== help ==========

usage() {
    local group last='' name args desc
    cat <<EOF
${BOLD}moq${PLAIN}: MR Moqui tasks (the Java Moqui Gradle tasks, with real arguments)

Usage: ./moq <task> [args...]      ./moq help <task>      ./moq <task> --help

A task name matches by a prefix of each dash-separated part, ignoring case,
so r-p and runProduction both mean run-production, and c-g is component-get.
EOF
    while IFS='|' read -r name group args desc; do
        if [ "$group" != "$last" ]; then
            printf '\n%s%s%s\n' "$BOLD" "$group" "$PLAIN"
            last=$group
        fi
        printf '  %-20s %-30s %s\n' "$name" "$args" "$desc"
    done <<<"$TASKS"
    cat <<EOF

Tab completion: ./moq completion --install, or add this to ~/.bashrc or ~/.zshrc:
  eval "\$($(printf '%q' "$MOQ") completion bash)"     (zsh: completion zsh)
EOF
}

help_task() {
    local name=$1 fn
    fn="help_${name//-/_}"
    printf '%s./moq %s %s%s\n    %s\n\n' "$BOLD" "$name" "$(task_field "$name" 3)" "$PLAIN" "$(task_field "$name" 4)"
    if declare -f "$fn" >/dev/null; then
        "$fn"
    fi
}

